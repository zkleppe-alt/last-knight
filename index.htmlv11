// ── UPGRADED NPC + DEMON SPRITES (knight treatment: outlines, shading, facing) ──
function _shadeHex(h,f){ const n=parseInt(h.slice(1),16);
  const r=Math.min(255,Math.round(((n>>16)&255)*f)), g=Math.min(255,Math.round(((n>>8)&255)*f)), b=Math.min(255,Math.round((n&255)*f));
  return '#'+((1<<24)|(r<<16)|(g<<8)|b).toString(16).slice(1); }
const HAT_STYLE = { soldier:'helm', guard:'helm', sailor:'cap', hunter:'hood', monk:'hood',
  guest:'cap', merchant:'cap', caravanM:'hood', shadeTr:'hood', qmaster:'helm' };
// interior-cast wardrobe (rollout): palettes feed the shared villager body.
Object.assign(OUTFITS, {
  innkeep:  { skin:'#e0b080', hair:'#5a3a2a', top:'#8a4a3a', bottom:'#4a3a32', apron:'#e8e0d0' },
  patronA:  { skin:'#d8a878', hair:'#6a4a2a', top:'#6a6a4a', bottom:'#4a4a3a' },
  patronB:  { skin:'#cf9a68', hair:'#8a8a8a', top:'#5a4a6a', bottom:'#3a3a4a' },
  guest:    { skin:'#e0b080', hair:'#3a2a1a', top:'#4a6a5a', bottom:'#5a4a32', hat:'#6f5436' },
  merchant: { skin:'#e0b080', hair:'#4a3a2a', top:'#7a3a8a', bottom:'#3a2a44', hat:'#c8a038' },
  fishmong: { skin:'#dca878', hair:'#5a4a2a', top:'#3a8a9a', bottom:'#2a4a5a', apron:'#9ab8c0' },
  caravanM: { skin:'#c08858', hair:'#2a1a0a', top:'#c8a05a', bottom:'#8a6a3a', hat:'#e8d0a0' },
  shadeTr:  { skin:'#d0c8d0', hair:'#44444e', top:'#5a4a6a', bottom:'#3a3344', hat:'#43384e' },
  qmaster:  { skin:'#d8a878', hair:'#7a7a7a', top:'#5a6a8a', bottom:'#3a4a5a', hat:'#9aa0b0', apron:'#7a5c3a' },
});

function drawPriest(x,y,n){  // 16x16 — animated: gentle breathing + a periodic blessing hand
  const T=performance.now()/1000, ph=(x*0.13+y*0.07);
  const bob=Math.sin(T*1.6+ph)>0.55?-1:0;                        // slow breath
  const bless=Math.sin(T*0.6+ph)>0.82;                            // occasional raised hand
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,5,2,0,0,7); ctx.fill();
  px(x+4,y+bob+1,8,2,'#8a8a92');
  px(x+4,y+bob+2,1,2,'#8a8a92');
  px(x+11,y+bob+2,1,2,'#8a8a92');
  px(x+5,y+bob+2,6,4,'#e8b88a');
  px(x+6,y+bob+3,1,1,'#2a221c');
  px(x+9,y+bob+3,1,1,'#2a221c');
  px(x+7,y+bob+5,2,1,'#c88a6a');
  px(x+4,y+bob+6,8,8,'#efe9da');
  px(x+4,y+bob+6,1,8,'#f8f4ea');
  px(x+11,y+bob+6,1,8,'#d8d2c0');
  px(x+5,y+bob+6,2,7,'#6a3a8a');
  px(x+9,y+bob+6,2,7,'#6a3a8a');
  px(x+7,y+bob+8,1,3,'#f2c14e');
  px(x+6,y+bob+9,3,1,'#f2c14e');
  px(x+5,y+bob+14,2,2,'#5b3a1f');
  px(x+9,y+bob+14,2,2,'#5b3a1f');
  // arms: folded at rest, one lifts in blessing
  if(bless){ px(x+11,y+6+bob,1,3,'#efe9da'); px(x+11,y+5+bob,2,1,'#e8b88a'); }   // right hand raised
  else { px(x+4,y+9+bob,1,3,'#efe9da'); px(x+11,y+9+bob,1,3,'#efe9da'); }         // hands at sides
}
// ══════════════════════════════════════════════════════════════════════
//  THE FALLEN GENERAL — slumped against the sanctum wall, spent and bound.
//  Replaces the 🙏 emoji placeholder on dungeon tile 7.
//
//  Two states, driven by whether the guardian boss still stands:
//    bound  — head down, chains across the chest, colour drained out of the
//             tabard, his own sword broken on the floor beside him.
//    freed  — the boss is dead. The chains are gone, his head has lifted,
//             the town's colour has come back into the cloth, and a faint
//             warm light gathers around him. He is waiting to bless you.
//
//  Drawn in the same idiom as drawRGeneral: px() rects, town tint, #141c2e
//  outline. Seated, so the silhouette reads distinctly from a standing NPC.
// ══════════════════════════════════════════════════════════════════════
function _fgDrain(hex, k){          // pull a colour toward cold grey by k (0..1)
  const v = parseInt(hex.slice(1),16);
  const r=(v>>16)&255, g=(v>>8)&255, b=v&255;
  const L = r*0.299 + g*0.587 + b*0.114;
  const m = ch => Math.max(0, Math.min(255, Math.round(ch*(1-k) + L*k*0.55 + 16*k)));
  return '#' + ((m(r)<<16)|(m(g)<<8)|m(b)).toString(16).padStart(6,'0');
}
function _fgShade(hex, f){
  const v = parseInt(hex.slice(1),16);
  const c = k => Math.max(0, Math.min(255, Math.floor(k*f)));   // clamp: f may exceed 1
  return '#' + ((c(v>>16)<<16)|(c((v>>8)&255)<<8)|c(v&255)).toString(16).padStart(6,'0');
}

// ── ELDAN THE SAGE — the old man of the glade. Drawn in the same idiom as the
//    hermit monk he shares a tile type with, so the two read as kin: robed,
//    bearded, lit from within. He stands where the monk kneels, and leans on a
//    staff whose head still holds a little of the green light of the wood.
function drawSage(sx, sy){
  const t = Date.now();
  const bob = Math.sin(t/900) > 0.55 ? 1 : 0;         // slow, patient breathing
  const oy = sy + bob;
  const ROBE='#4a6a52', ROBE_L='#5f8468', ROBE_D='#35503c', HOOD='#2e4534';
  const SKIN='#e8c9a0', BEARD='#eceae0', BEARD_D='#c4c2b6';
  const WOOD='#7a5636', WOOD_D='#553a24', GLOW='#8fd4a8';

  // the wood's own light gathers around him
  const gx=sx+TILE/2, gy=oy+TILE/2;
  const g=ctx.createRadialGradient(gx,gy,0,gx,gy,13);
  g.addColorStop(0,   'rgba(143,212,168,0.26)');
  g.addColorStop(0.55,'rgba(143,212,168,0.10)');
  g.addColorStop(1,   'rgba(143,212,168,0)');
  ctx.fillStyle=g; ctx.fillRect(sx-8, oy-8, TILE+16, TILE+16);

  ctx.fillStyle='rgba(0,0,0,.22)';
  ctx.beginPath(); ctx.ellipse(sx+TILE/2, sy+TILE-1, 5, 2, 0, 0, 7); ctx.fill();

  // ── staff, planted, with a lit head ──
  px(sx+12, oy+2,  1, 13, WOOD);
  px(sx+12, oy+2,  1, 6,  WOOD_D);
  px(sx+11, oy+1,  3, 1,  WOOD);                       // gnarled crook
  px(sx+13, oy,    1, 2,  GLOW);
  px(sx+11, oy,    1, 1,  WOOD_D);

  // ── robe: narrow at the shoulder, pooling wide at the hem ──
  px(sx+4,  oy+11, 8, 3, ROBE);
  px(sx+3,  oy+13, 10,2, ROBE_D);                      // hem on the ground
  px(sx+5,  oy+6,  6, 6, ROBE);
  px(sx+5,  oy+6,  2, 6, ROBE_L);                      // lit down one side
  px(sx+10, oy+6,  1, 6, ROBE_D);
  px(sx+4,  oy+11, 1, 3, ROBE_L);

  // sleeves, hands folded at the waist
  px(sx+4,  oy+8,  2, 3, ROBE_D);
  px(sx+10, oy+8,  2, 3, ROBE_D);
  px(sx+6,  oy+10, 4, 1, SKIN);

  // ── hood and face ──
  px(sx+5,  oy+1,  6, 5, HOOD);
  px(sx+5,  oy+1,  6, 1, ROBE_D);
  px(sx+4,  oy+2,  1, 4, HOOD);
  px(sx+11, oy+2,  1, 4, HOOD);
  px(sx+6,  oy+4,  4, 3, SKIN);
  px(sx+6,  oy+5,  1, 1, '#3a2a1a');                   // eyes
  px(sx+9,  oy+5,  1, 1, '#3a2a1a');
  px(sx+5,  oy+3,  6, 1, ROBE_D);                      // brow of the hood

  // ── the long white beard — the thing that says OLD at this size ──
  px(sx+6,  oy+7,  4, 4, BEARD);
  px(sx+6,  oy+7,  1, 4, BEARD_D);
  px(sx+7,  oy+11, 2, 1, BEARD);
  px(sx+7,  oy+11, 1, 1, BEARD_D);
}

function drawFallenGeneral(x, y, town, freed){
  const OL='#141c2e';
  const RAW = (GENERAL_TINTS && GENERAL_TINTS[town]) || '#a02030';
  const TINT   = _fgDrain(RAW, freed ? 0.18 : 0.74);
  const TINT_D = _fgShade(TINT, 0.62);
  // his plate is tarnished while bound, and only partly recovers when freed
  const PL   = freed ? '#b9bec9' : '#7e838e';
  const PL_H = freed ? '#dfe3ea' : '#989da8';
  const PL_D = freed ? '#8d929d' : '#585d68';
  const GOLD = freed ? '#e8b93a' : '#8a7434';
  const GOLD_H=freed ? '#fff0b0' : '#a89050';

  const T = performance.now()/1000;
  // slow, shallow breathing — he is spent, not dead
  const breath = Math.sin(T*0.9 + x*0.07) > 0.55 ? 1 : 0;
  // bound: head hangs. freed: it has come up, and lifts a little as he breathes.
  const bow = freed ? (breath ? 0 : 1) : 2;

  // faint gathered light once the guardian falls
  if(freed){
    const gx=x+TILE/2, gy=y+TILE/2;
    const g=ctx.createRadialGradient(gx,gy,0,gx,gy,11);
    g.addColorStop(0,'rgba(255,230,150,0.26)');
    g.addColorStop(0.5,'rgba(250,204,21,0.10)');
    g.addColorStop(1,'rgba(250,204,21,0)');
    ctx.fillStyle=g; ctx.fillRect(x-6,y-6,TILE+12,TILE+12);
  }

  ctx.fillStyle='rgba(0,0,0,.26)';
  ctx.beginPath(); ctx.ellipse(x+TILE/2, y+TILE-2, 6, 2, 0, 0, 7); ctx.fill();

  // ── legs, folded out in front of him ──
  px(x+3, y+12, 4,3, PL_D);  px(x+3, y+14, 4,1, OL);
  px(x+8, y+12, 4,3, PL_D);  px(x+8, y+14, 4,1, OL);
  px(x+3, y+12, 4,1, PL);    px(x+8, y+12, 4,1, PL);

  // ── torso, slumped and leaning back against the wall ──
  px(x+3, y+7, 9,6, PL);
  px(x+3, y+7, 1,6, PL_H);
  px(x+11,y+7, 1,6, PL_D);
  px(x+2, y+7, 1,6, OL);
  px(x+12,y+7, 1,6, OL);
  px(x+3, y+13,9,1, OL);
  // tabard down the middle — the town's colour, drained while he is bound
  px(x+6, y+7, 4,6, TINT);
  px(x+6, y+12,4,1, TINT_D);
  px(x+5, y+10,6,1, GOLD);                       // belt
  px(x+7, y+10,1,1, GOLD_H);
  // battle damage in the plate
  px(x+4, y+9, 1,3, '#2a2f3a');
  px(x+10,y+8, 1,2, '#2a2f3a');

  // ── arms: one hangs limp, the other props him up against the wall ──
  px(x+1, y+8, 2,5, PL_D); px(x+1, y+12,2,1, OL); px(x+1, y+8, 1,5, PL);
  px(x+12,y+8, 2,4, PL_D); px(x+12,y+11,2,1, OL);

  // ── head, bowed ──
  const hy = y + 3 + bow;
  px(x+5, hy,   6,4, PL);
  px(x+5, hy,   6,1, PL_H);
  px(x+10,hy,   1,4, PL_D);
  px(x+4, hy,   1,4, OL);
  px(x+11,hy,   1,4, OL);
  px(x+5, hy-1, 6,1, OL);
  px(x+6, hy+2, 4,2, '#0e1626');                 // visor, dark and empty
  if(freed) px(x+6, hy+2, 4,1, '#243247');       // a little light behind it again
  px(x+9, hy,   1,2, '#3a3f4a');                 // dent in the helm
  // crest: snapped off short while bound, standing again once freed
  if(freed){ px(x+7, hy-3, 2,3, TINT); px(x+7, hy-3, 1,3, _fgShade(TINT,1.25)); }
  else { px(x+7, hy-2, 2,2, TINT_D); px(x+9, hy-1, 1,1, TINT_D); }

  // ── his own sword, broken on the floor beside him ──
  px(x+13, y+13, 3,1, '#8f8578');
  px(x+13, y+13, 1,1, '#b6ab99');
  px(x+12, y+14, 2,1, '#5a4028');                // hilt
  if(!freed) px(x+15, y+12, 1,1, '#6f6658');     // the snapped-off tip, thrown clear

  // ── chains, only while he is still bound ──
  if(!freed){
    px(x+3, y+8, 9,1, '#5a606c');
    px(x+4, y+8, 1,1, '#868c98');
    px(x+7, y+8, 1,1, '#868c98');
    px(x+10,y+8, 1,1, '#868c98');
    px(x+3, y+11,9,1, '#4e535e');
    px(x+6, y+11,1,1, '#7a808c');
    px(x+9, y+11,1,1, '#7a808c');
  }
}

function drawRGeneral(x,y,n){  // seated redeemed general — Aldric-style, town-tinted, slow reverent nod
  const TINT=GENERAL_TINTS[n.town]||'#a02030';
  const sh=c=>{ const v=parseInt(c.slice(1),16); const f=k=>Math.max(0,Math.floor(k*0.62)); return '#'+((f(v>>16)<<16)|(f((v>>8)&255)<<8)|f(v&255)).toString(16).padStart(6,'0'); };
  const T=performance.now()/1000, ph=(x*0.11+y*0.05);
  const bob=Math.sin(T*1.2+ph)>0.4?1:0;                          // seated: head dips in prayer, not a full-body bob
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-2,5,2,0,0,7); ctx.fill();
  px(x+4,y+1,7,4,'#d8dce4');
  px(x+4,y+1,7,1,'#f4f6fa');
  px(x+10,y+1,1,4,'#a8aeba');
  px(x+3,y+1,1,4,'#141c2e');
  px(x+11,y+1,1,4,'#141c2e');
  px(x+4,y+0,7,1,'#141c2e');
  px(x+4,y+2,7,1,'#e8b93a');
  px(x+4,y+3,2,2,'#1a2740');
  px(x+9,y+3,2,2,'#1a2740');
  px(x+6,y+0,3,1,'#e8b93a');
  px(x+3,y+5,3,2,'#e8b93a');
  px(x+3,y+5,3,1,'#fff0b0');
  px(x+10,y+5,3,2,'#e8b93a');
  px(x+10,y+5,3,1,'#fff0b0');
  px(x+4,y+6,8,6,'#ece8dc');
  px(x+4,y+6,1,6,'#fffdf4');
  px(x+11,y+6,1,6,'#c8c2b0');
  px(x+2,y+6,2,6,TINT);
  px(x+12,y+6,2,6,TINT);
  px(x+2,y+11,2,1,sh(TINT));
  px(x+12,y+11,2,1,sh(TINT));
  px(x+5,y+9,6,1,'#e8b93a');
  px(x+7,y+7,2,2,TINT);
  // only the helm/head nods (rows 0-5 get +bob); body already drawn above at rest
  if(bob){ px(x+4,y+1,7,1,'#141c2e'); px(x+4,y+2,7,1,TINT); }   // tiny nod accent line
}

function drawAldric(x,y,v){
  const f=v.moving?v.frame:0, bob=(f===1?-1:f===3?1:0);
  const OL='#141c2e', TUN='#ece8dc', TUN_L='#fffdf4', TUN_D='#c8c2b0';
  const GOLD='#e8b93a', GOLD_L='#fff0b0', HELM='#d8dce4', HELM_HI='#f4f6fa', HELM_D='#a8aeba';
  const CAPE='#a02030', CAPE_D='#701622', LEG='#8a8474';
  const side=v.dir==='left'||v.dir==='right';
  const P=(lx,ly,w,h,c)=>{ if(v.dir==='right') px(x+(16-lx-w),y+ly,w,h,c); else px(x+lx,y+ly,w,h,c); };
  ctx.fillStyle='rgba(0,0,0,.24)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,5,2,0,0,7); ctx.fill();
  if(side){
    P(9,5+bob,4,8,CAPE); P(11,5+bob,2,8,CAPE_D); P(9,12+bob,4,1,CAPE_D);   // cape trails behind
    P(5,12+bob,3,3,LEG); P(5,14+bob,3,1,OL); P(8,12+bob,3,3,LEG); P(8,14+bob,3,1,OL);
    P(4,5+bob,7,7,TUN); P(4,5+bob,2,7,TUN_L); P(9,5+bob,2,7,TUN_D);
    P(3,5+bob,1,7,OL); P(11,5+bob,1,7,OL); P(5,9+bob,4,1,GOLD);
    P(3,5+bob,3,2,GOLD); P(3,5+bob,3,1,GOLD_L);                             // gold pauldron
    P(4,1+bob,7,4,HELM); P(4,1+bob,7,1,HELM_HI); P(10,1+bob,1,4,HELM_D);
    P(3,1+bob,1,4,OL); P(11,1+bob,1,4,OL); P(4,0+bob,7,1,OL);
    P(3,3+bob,2,2,'#1a2740'); P(4,2+bob,7,1,GOLD);                          // visor + gold band
    P(5,-1+bob,2,2,GOLD_L); P(7,-1+bob,3,1,GOLD); P(9,0+bob,3,1,GOLD); P(11,1+bob,1,1,'#b8902a'); // tall gold crest
    P(1,7+bob,2,6,GOLD); P(1,7+bob,1,6,GOLD_L);                             // gilded blade at side
  } else {
    if(v.dir==='down'){ px(x+2,y+6+bob,2,8,CAPE); px(x+12,y+6+bob,2,8,CAPE); px(x+2,y+13+bob,2,1,CAPE_D); px(x+12,y+13+bob,2,1,CAPE_D); }
    px(x+4,y+12+bob,3,3,LEG); px(x+4,y+14+bob,3,1,OL); px(x+9,y+12+bob,3,3,LEG); px(x+9,y+14+bob,3,1,OL);
    if(v.dir==='up'){ px(x+3,y+5+bob,10,9,CAPE); px(x+3,y+5+bob,10,1,'#c03a4a'); px(x+3,y+13+bob,10,1,CAPE_D); }
    px(x+4,y+5+bob,8,7,TUN); px(x+4,y+5+bob,2,7,TUN_L); px(x+10,y+5+bob,2,7,TUN_D);
    px(x+3,y+5+bob,1,7,OL); px(x+12,y+5+bob,1,7,OL);
    px(x+6,y+9+bob,4,1,GOLD); px(x+7,y+9+bob,2,1,GOLD_L);
    px(x+3,y+5+bob,3,2,GOLD); px(x+10,y+5+bob,3,2,GOLD); px(x+3,y+5+bob,3,1,GOLD_L); px(x+10,y+5+bob,3,1,GOLD_L);
    px(x+4,y+1+bob,8,4,HELM); px(x+4,y+1+bob,8,1,HELM_HI); px(x+11,y+1+bob,1,4,HELM_D);
    px(x+3,y+1+bob,1,4,OL); px(x+12,y+1+bob,1,4,OL); px(x+4,y+0+bob,8,1,OL);
    px(x+4,y+2+bob,8,1,GOLD);
    if(v.dir!=='up') px(x+5,y+3+bob,6,2,'#1a2740');
    px(x+6,y-2+bob,2,2,GOLD_L); px(x+7,y-1+bob,3,1,GOLD); px(x+9,y-1+bob,3,1,GOLD); // tall crest
  }
}

function drawVillager(x,y,v){
  if(v.look && v.look!=='vill'){ drawLookNpc(x,y,v); return; }
  if(v.aldric){ drawAldric(x,y,v); return; }
  if(v.priest){ drawPriest(x,y,v); return; }
  if(v.rgeneral){ drawRGeneral(x,y,v); return; }
  const o=OUTFITS[v.outfit]||OUTFITS.peasant;
  const small=v.outfit==='child'||v._kid;
  const sc=small?2:0;
  const f=v.moving?v.frame:0; const bob=(f===1?-1:f===3?1:0);
  const OL='#1a141c';
  const top=o.top, topL=_shadeHex(top,1.28), topD=_shadeHex(top,0.72);
  const bot=o.bottom, botD=_shadeHex(bot,0.7);
  const skin=o.skin, skinD=_shadeHex(skin,0.8);
  const hair=o.hair, hairL=_shadeHex(hair,1.3);
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,4,2,0,0,7); ctx.fill();
  const side = v.dir==='left'||v.dir==='right';
  const P=(lx,ly,w,h,c)=>{ if(v.dir==='right') px(x+(16-lx-w),y+ly,w,h,c); else px(x+lx,y+ly,w,h,c); };
  if(side){
    if(f===1){ P(4,12+bob,3,4,bot); P(4,15+bob,3,1,OL); P(8,12+bob,3,2,bot); P(8,13+bob,3,1,OL); }
    else if(f===3){ P(5,12+bob,3,2,bot); P(5,13+bob,3,1,OL); P(8,12+bob,3,4,bot); P(8,15+bob,3,1,OL); }
    else { P(5,12+bob,3,3,bot); P(5,14+bob,3,1,OL); P(8,12+bob,3,3,bot); P(8,14+bob,3,1,OL); }
    P(4,6+sc+bob,7,6-sc,top); P(4,6+sc+bob,2,6-sc,topL); P(9,6+sc+bob,2,6-sc,topD);
    P(3,6+sc+bob,1,6-sc,OL); P(11,6+sc+bob,1,6-sc,OL);
    if(o.apron) P(5,7+bob,3,5-sc,o.apron);
    P(3,7+sc+bob,2,3,top); P(3,7+sc+bob,1,3,topL);
    P(5,2+sc+bob,6,5,skin); P(9,2+sc+bob,2,5,skinD);
    P(5,2+sc+bob,6,2,hair); P(5,2+sc+bob,2,1,hairL); P(9,2+sc+bob,2,3,hair);
    P(4,2+sc+bob,1,5,OL); P(11,2+sc+bob,1,5,OL); P(5,1+sc+bob,6,1,OL);
    P(5,4+sc+bob,1,1,'#2a1c10');
    if(o.hat){ const hs=HAT_STYLE[v.outfit];
      if(hs==='hood'){ P(4,1+sc+bob,7,3,o.hat); P(4,3+sc+bob,2,3,o.hat); P(4,1+sc+bob,7,1,_shadeHex(o.hat,1.25)); }
      else { P(2,1+sc+bob,11,2,o.hat); P(2,1+sc+bob,11,1,_shadeHex(o.hat,1.25)); P(4,-1+sc+bob,7,2,o.hat); P(2,3+sc+bob,11,1,'#00000030'); } }
  } else {
    if(f===1){ px(x+4,y+12+bob,3,4,bot); px(x+4,y+15+bob,3,1,OL); px(x+9,y+12+bob,3,2,bot); px(x+9,y+13+bob,3,1,OL); }
    else if(f===3){ px(x+4,y+12+bob,3,2,bot); px(x+4,y+13+bob,3,1,OL); px(x+9,y+12+bob,3,4,bot); px(x+9,y+15+bob,3,1,OL); }
    else { px(x+4,y+12+bob,3,3,bot); px(x+4,y+14+bob,3,1,OL); px(x+9,y+12+bob,3,3,bot); px(x+9,y+14+bob,3,1,OL); }
    px(x+4,y+12+bob,1,3,botD); px(x+9,y+12+bob,1,3,botD);
    px(x+4,y+6+sc+bob,8,6-sc,top); px(x+4,y+6+sc+bob,2,6-sc,topL); px(x+10,y+6+sc+bob,2,6-sc,topD);
    px(x+4,y+6+sc+bob,8,1,_shadeHex(top,1.4));
    px(x+3,y+6+sc+bob,1,6-sc,OL); px(x+12,y+6+sc+bob,1,6-sc,OL);
    if(o.apron){ px(x+6,y+7+bob,4,5-sc,o.apron); px(x+6,y+7+bob,1,5-sc,_shadeHex(o.apron,0.82)); }
    px(x+5,y+2+sc+bob,6,5,skin); px(x+5,y+2+sc+bob,1,5,_shadeHex(skin,1.12)); px(x+10,y+2+sc+bob,1,5,skinD);
    if(v.dir==='up'){ px(x+5,y+2+sc+bob,6,5,hair); px(x+5,y+2+sc+bob,6,1,hairL); }
    else {
      px(x+5,y+2+sc+bob,6,2,hair); px(x+5,y+2+sc+bob,2,1,hairL);
      px(x+6,y+4+sc+bob,1,1,'#2a1c10'); px(x+9,y+4+sc+bob,1,1,'#2a1c10');
      px(x+7,y+6+sc+bob,2,1,_shadeHex(skin,0.86));
    }
    px(x+4,y+2+sc+bob,1,5,OL); px(x+11,y+2+sc+bob,1,5,OL); px(x+5,y+1+sc+bob,6,1,OL);
    if(o.hat){ const hs=HAT_STYLE[v.outfit];
      if(hs==='helm'){ px(x+4,y+1+sc+bob,8,3,o.hat); px(x+4,y+1+sc+bob,8,1,_shadeHex(o.hat,1.3)); px(x+4,y+3+sc+bob,8,1,'#00000028'); px(x+7,y+0+sc+bob,2,1,'#c0392e'); }
      else if(hs==='cap'){ px(x+4,y+1+sc+bob,8,2,o.hat); px(x+4,y+0+sc+bob,6,1,o.hat); px(x+4,y+2+sc+bob,8,1,_shadeHex(o.hat,0.75)); }
      else if(hs==='hood'){ px(x+4,y+1+sc+bob,8,3,o.hat); px(x+3,y+3+sc+bob,2,4,o.hat); px(x+11,y+3+sc+bob,2,4,o.hat); px(x+4,y+1+sc+bob,8,1,_shadeHex(o.hat,1.25)); }
      else { px(x+2,y+1+sc+bob,12,2,o.hat); px(x+2,y+1+sc+bob,12,1,_shadeHex(o.hat,1.25)); px(x+4,y-1+sc+bob,8,2,o.hat); px(x+2,y+3+sc+bob,12,1,'#00000030'); } }
  }
}

// ── PASTORAL LIFE (Mistral): a robed shepherd with a crook, and sheep in four
//    wool variants. Both are ambient — they graze/stroll and (later) scatter when
//    a village is overrun. Drawn in the portalworld depth-sort block. ──
// ── the village chapel: a small 3D stone chapel with a steeple + cross. ox,oy is
//    the screen px of the structure's bottom-center tile; it rises upward from there.
//    `overrun` (village not yet cleansed) renders it cold, dark, and aura'd. ──
// ── draw the throne hall. Corrupted (cold, sickly) during the fight; warm and
//    purified after the Pretender flees. Called per-tile from the interior renderer. ──
// draw the fighting Pretender: telegraph tells, projectiles, the king sprite, HP bar. ──
// Princess Madison, chained beside the usurped throne — visible for the whole fight,
// so the escape has something to take. ──
// the steward's cage against the west wall — iron bars, a hunched figure within. ──
// the steward mid-escape: the open cage behind him, the man on his feet. ──
function drawStewardRelease(camX,camY){
  const r=mistThrone.release; if(!r) return;
  // the empty cage with its door swung wide
  const cx=Math.round(2*TILE-camX), cy=Math.round(6*TILE-camY);
  const bar='#6a6478', barL='#8a8498';
  px(cx+1,cy+2,14,14,'#241f2e');
  for(let bx=cx+1;bx<cx+15;bx+=3) px(bx,cy+2,1,14,bar);
  px(cx,cy+1,16,2,barL); px(cx,cy+15,16,2,bar); px(cx,cy+1,2,15,bar);
  px(cx+15,cy+3,2,12,barL);   // the door, hanging open
  // the man himself
  const x=Math.round(r.x-camX), y=Math.round(r.y-camY);
  const robe='#a89e86', robeL='#c4baa0', skin='#e8c0a0';
  const step=(r.phase==='stepout') ? Math.round(Math.sin(r.t*0.3)) : 0;
  px(x+4,y+7,8,9,robe); px(x+4,y+7,3,9,robeL);
  px(x+5,y+2,6,5,'#6a5a4a'); px(x+5,y+4,6,4,skin); px(x+5,y+3,6,1,'#6a5a4a');
  px(x+6,y+6,1,1,'#2a2018'); px(x+9,y+6,1,1,'#2a2018');
  px(x+3,y+9,2,5,skin); px(x+11,y+9,2,5,skin);
  px(x+5,y+15+step,2,2,'#4a3a2a'); px(x+9,y+15-step,2,2,'#4a3a2a');
  px(x+11,y+10,3,2,'#c9a44a');   // the keys at his belt
}
function drawStewardCage(camX,camY){
  const x=Math.round(2*TILE-camX), y=Math.round(6*TILE-camY);
  const bar='#6a6478', barL='#8a8498', dark='#241f2e';
  px(x+1,y+2,14,14,dark);                                  // cage interior
  // the man inside
  const robe=mistThrone.purified?'#c9bfa4':'#8a8272', skin='#e8c0a0';
  px(x+5,y+8,6,7,robe); px(x+6,y+4,4,4,skin); px(x+6,y+3,4,1,'#6a5a4a');
  px(x+6,y+6,1,1,'#2a2018'); px(x+9,y+6,1,1,'#2a2018');
  // bars in front
  for(let bx=x+1;bx<x+15;bx+=3) px(bx,y+2,1,14,bar);
  px(x,y+1,16,2,barL); px(x,y+15,16,2,bar);
  px(x,y+1,2,15,bar); px(x+14,y+1,2,15,bar);
  // a hint marker while he can be freed
  if(mistThrone.freeable){ const by=Math.round(Math.sin(Date.now()*0.006)*2);
    px(x+6,y-8+by,4,2,'#ffe04a'); px(x+7,y-6+by,2,4,'#ffe04a'); }
}
function drawChainedMadison(camX,camY){
  const mx=Math.round(9*TILE-camX), my=Math.round(2*TILE-camY);
  const gown='#c86a9a', gownL='#e08ab4', hair='#6a4a2a', skin='#e8c0a0';
  // chain running to the wall ring
  const rx=Math.round(11*TILE-camX), ry=my+6;
  ctx.strokeStyle='#8a8296'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(mx+10,my+8); ctx.lineTo(rx,ry); ctx.stroke();
  px(rx-1,ry-2,3,4,'#6a6478');
  // figure
  px(mx+2,my+6,9,10,gown); px(mx+2,my+6,3,10,gownL);
  px(mx+3,my+1,7,6,hair); px(mx+4,my+3,5,4,skin); px(mx+4,my+2,5,1,hair);
  px(mx+5,my+5,1,1,'#3a2a1a'); px(mx+8,my+5,1,1,'#3a2a1a');
  px(mx+1,my+9,2,4,skin); px(mx+10,my+9,2,4,skin);   // arms
  px(mx+9,my+11,4,2,'#9a94a8');                       // manacle
}
// the defeat cinematic: the fallen/staggering king and his escape portal. ──
function drawThroneCine(camX,camY){
  const c=mistThrone.cine; if(!c) return;
  const x=Math.round(c.x-camX), y=Math.round(c.y-camY);
  if(c.portal>0){ const px0=Math.round(7*TILE-camX)+8, py0=Math.round(1*TILE-camY)+8;
    const r=c.portal*22; const g=ctx.createRadialGradient(px0,py0,1,px0,py0,Math.max(1,r));
    g.addColorStop(0,'rgba(220,180,255,0.95)'); g.addColorStop(0.6,'rgba(140,90,220,0.65)'); g.addColorStop(1,'rgba(90,40,160,0)');
    ctx.fillStyle=g; ctx.beginPath(); ctx.ellipse(px0,py0,r*0.6,r,0,0,7); ctx.fill(); }
  // the dragged princess, chain taut between them
  if(c.seized && c.mad && c.alpha>0){ const mx=Math.round(c.mad.x-camX), my=Math.round(c.mad.y-camY);
    ctx.globalAlpha=Math.max(0,c.alpha);
    ctx.strokeStyle='#9a94a8'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(x+10,y+10); ctx.lineTo(mx+6,my+10); ctx.stroke();
    const gown='#c86a9a', gownL='#e08ab4', hair='#6a4a2a', skin='#e8c0a0';
    px(mx+2,my+6,9,10,gown); px(mx+2,my+6,3,10,gownL);
    px(mx+3,my+1,7,6,hair); px(mx+4,my+3,5,4,skin); px(mx+4,my+2,5,1,hair);
    px(mx+1,my+9,2,4,skin); px(mx+10,my+9,2,4,skin); px(mx,my+11,4,2,'#9a94a8');
    ctx.globalAlpha=1; }
  if(c.alpha<=0) return;
  ctx.globalAlpha=Math.max(0,c.alpha);
  if(c.phase==='fall'){ // crumpled: draw him low and squashed
    ctx.save(); ctx.translate(x+8,y+16); ctx.rotate(-0.5); ctx.translate(-8,-16);
    if(typeof drawDemonKing==='function') drawDemonKing(0,4); ctx.restore(); }
  else if(c.phase==='rise'){ const lift=Math.min(1,c.t/24);
    ctx.save(); ctx.translate(x+8,y+16); ctx.rotate(-0.5*(1-lift)); ctx.translate(-8,-16);
    if(typeof drawDemonKing==='function') drawDemonKing(0,4*(1-lift)); ctx.restore(); }
  else { const list=Math.sin(c.t*0.25)*1.5;   // limping list
    if(typeof drawDemonKing==='function') drawDemonKing(x-2+list, y-8); }
  ctx.globalAlpha=1;
}
function drawThroneBoss(camX,camY){
  const b=mistThrone.boss; if(!b) return; const bx=Math.round(b.x-camX), by=Math.round(b.y-camY);
  const bcx=bx+TILE/2, bcy=by+TILE/2;
  // telegraph tells
  if(b.state==='telegraph'){ const a=1-(b.telegraph/b.telMax); ctx.globalAlpha=0.35+0.4*a; ctx.strokeStyle='#ffca5a'; ctx.lineWidth=2;
    if(b.kind==='charge'){ ctx.beginPath(); ctx.moveTo(bcx,bcy); ctx.lineTo(bcx+b.aimx*TILE*10,bcy+b.aimy*TILE*10); ctx.stroke(); }
    else if(b.kind==='slam'){ ctx.beginPath(); ctx.arc(bcx,bcy,TILE*1.3,0,7); ctx.stroke(); }
    else { ctx.beginPath(); ctx.arc(bcx,bcy,TILE*0.9+a*4,0,7); ctx.stroke(); }
    ctx.globalAlpha=1; }
  // slam ring
  if(b.state==='slam' && b.ring){ ctx.strokeStyle='rgba(255,120,60,0.8)'; ctx.lineWidth=3; ctx.beginPath(); ctx.arc(bcx,bcy,b.ringR,0,7); ctx.stroke(); }
  // projectiles
  b.projectiles.forEach(p=>{ const px2=Math.round(p.x-camX), py2=Math.round(p.y-camY);
    ctx.fillStyle='#ff8a4a'; ctx.beginPath(); ctx.arc(px2,py2,3,0,7); ctx.fill();
    ctx.fillStyle='#ffe0a0'; ctx.beginPath(); ctx.arc(px2,py2,1.4,0,7); ctx.fill(); });
  // the king himself (hurt flash)
  // the ward: a shimmering shell while his knights live
  if(b.warded){ const pulse=0.5+0.3*Math.sin(Date.now()*0.008);
    ctx.strokeStyle='rgba(150,200,255,'+pulse.toFixed(2)+')'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(bcx,bcy,TILE*1.1,0,7); ctx.stroke();
    ctx.strokeStyle='rgba(200,230,255,'+(pulse*0.5).toFixed(2)+')'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.arc(bcx,bcy,TILE*1.35,0,7); ctx.stroke(); }
  if(b.wardFlash>0){ b.wardFlash--; ctx.strokeStyle='rgba(220,240,255,0.9)'; ctx.lineWidth=3;
    ctx.beginPath(); ctx.arc(bcx,bcy,TILE*1.2,0,7); ctx.stroke(); }
  if(b.hurt>0 && (b.hurt%4<2)) ctx.globalAlpha=0.6;
  if(typeof drawDemonKing==='function') drawDemonKing(bx-2, by-8);
  ctx.globalAlpha=1; if(b.hurt>0) b.hurt--;
  // boss HP bar (top of screen)
  const bw=VW-40, bh=7, bxp=20, byp=VH-26;   // low, clear of the HUD
  ctx.fillStyle='#1a1020'; ctx.fillRect(bxp-1,byp-1,bw+2,bh+2);
  ctx.fillStyle='#3a1a1a'; ctx.fillRect(bxp,byp,bw,bh);
  ctx.fillStyle='#e0885a'; ctx.fillRect(bxp,byp,Math.max(0,Math.round(bw*b.hp/b.maxHp)),bh);
  ctx.fillStyle='#fff'; ctx.font='bold 8px sans-serif'; ctx.textAlign='center';
  ctx.fillText(b.warded? 'THE PRETENDER KING \u2014 WARDED' : 'THE PRETENDER KING', VW/2, byp+bh+9);
  if(b.warded){ ctx.fillStyle='#9ccfff'; ctx.font='7px sans-serif'; ctx.fillText('cut down his knights to break the ward', VW/2, byp+bh+18); }
  ctx.textAlign='left';
}
function drawThroneTile(t,x,y,tx,ty){
  const pure=mistThrone.purified;
  const floor=pure?'#8a8478':'#4a4652', floorD=pure?'#7a7468':'#3a3644';
  const wall=pure?'#9a8f7a':'#2e2a38', wallLit=pure?'#b4a98e':'#3e3a48';
  if(t===5){ px(x,y,TILE,TILE,wall); px(x,y,TILE,3,wallLit); px(x,y,3,TILE,wallLit); px(x+TILE-3,y,3,TILE,floorD); return; }
  // floor base under everything
  const chk=((tx+ty)&1); px(x,y,TILE,TILE, chk?floor:floorD);
  if(t===23){ const c=pure?'#b48a3a':'#8a2f3a', cl=pure?'#c9a44a':'#a63f4a'; px(x+1,y,TILE-2,TILE,c); px(x+1,y,TILE-2,2,cl); px(x+2,y+3,1,TILE-3,cl); }
  if(t===21){ const d=pure?'#a89a6e':'#5a5464'; px(x,y,TILE,TILE,d); px(x,y,TILE,2,pure?'#c4b884':'#6a6478'); }
  if(t===9){ const dr=pure?'#7a5230':'#3a2c1a'; px(x+3,y+2,TILE-6,TILE-2,dr); px(x+3,y+2,TILE-6,2,pure?'#9a6a40':'#4a3a24'); }
  if(t===20){ // pillar: a tall shaft with cap + base, cold or warm
    const p=pure?'#cdc4b2':'#8a8296', pl=pure?'#e4dccb':'#a8a0b4', pd=pure?'#a49a86':'#5a5468';
    px(x+2,y-6,TILE-4,TILE+6,p); px(x+2,y-6,3,TILE+6,pl); px(x+TILE-4,y-6,2,TILE+6,pd);
    px(x+1,y-8,TILE-2,3,pl); px(x+1,y+TILE-3,TILE-2,3,pd); }
  if(t===24){ // brazier with flame
    px(x+4,y+6,TILE-8,TILE-7,pure?'#6a5230':'#3a3444'); const fl=pure?'#ffd24a':'#7fa8ff';
    px(x+6,y+1,4,5,fl); px(x+5,y+3,6,3,fl); px(x+7,y-1,2,3,pure?'#fff0a8':'#c8e0ff'); }
  if(t===22){ // the throne itself (drawn as a tall seat)
    const th=pure?'#c9a44a':'#6a5a4a', thl=pure?'#e8c25a':'#8a7a5a', thd=pure?'#8a6a2a':'#4a3a2a';
    px(x+2,y-10,TILE-4,TILE+10,th); px(x+2,y-10,TILE-4,3,thl); px(x+3,y-8,2,TILE+6,thl);
    px(x+TILE-5,y-8,2,TILE+6,thd); px(x+1,y-12,TILE-2,4,th); px(x+1,y-12,TILE-2,1,thl);
    px(x+5,y-14,1,4,th); px(x+9,y-14,1,4,th); }   // finials
}
// ── the Pretender's keep: a broad stone castle with corner towers, battlements,
//    banners and a gate arch. ox,oy = screen px of the gate tile (bottom-center).
//    `dark` = still held by the usurper; purified once he flees. ──
function drawMistralCastle(ox, oy, dark){
  const P=(x,y,w,h,c)=>px(x,y,w,h,c);
  const W=13*TILE, H=9*TILE;                  // spans the stamped keep footprint
  const bx=ox-Math.round(W/2)+TILE/2, by=oy-H+TILE;
  const wall=dark?'#5c5768':'#c9c2b2', wallLit=dark?'#6e6879':'#e2dbc9', wallDark=dark?'#423e4e':'#a49d8d';
  const roof=dark?'#3a2f46':'#7a4a6a', roofLit=dark?'#4c4058':'#96608a', OL='#1a141c';
  const band=dark?'#332f3e':'#b0a898';
  ctx.fillStyle='rgba(0,0,0,0.22)'; ctx.beginPath(); ctx.ellipse(bx+W/2, by+H-3, W/2.1, 9, 0,0,7); ctx.fill();
  if(dark){ const gg=ctx.createRadialGradient(bx+W/2,by+H*0.45,10,bx+W/2,by+H*0.45,W*0.8); gg.addColorStop(0,'rgba(90,150,255,0.13)'); gg.addColorStop(1,'rgba(90,150,255,0)'); ctx.fillStyle=gg; ctx.fillRect(bx-20,by-30,W+40,H+50); }
  // main curtain wall
  const wTop=by+Math.round(H*0.30);
  P(bx,wTop,W,(by+H)-wTop,wall); P(bx,wTop,W,3,wallLit); P(bx,wTop,3,(by+H)-wTop,wallLit);
  P(bx+W-3,wTop,3,(by+H)-wTop,wallDark); P(bx,by+H-3,W,3,wallDark);
  for(let cy2=wTop+7; cy2<by+H-3; cy2+=7) P(bx+3,cy2,W-6,1,wallDark);
  let i2=0; for(let cx2=bx+7; cx2<bx+W-6; cx2+=9){ P(cx2+(i2%2)*4,wTop+9,1,5,wallDark); i2++; }
  // battlements along the top of the curtain
  for(let x=bx; x<bx+W-4; x+=10){ P(x,wTop-7,7,8,wall); P(x,wTop-7,7,2,wallLit); P(x+5,wTop-7,2,8,wallDark); }
  // corner towers (taller, with conical roofs)
  [[bx-6, 0],[bx+W-14, 1]].forEach(([tx])=>{
    const tW=20, tTop=by+6, tH=(by+H)-tTop;
    P(tx,tTop,tW,tH,wall); P(tx,tTop,tW,3,wallLit); P(tx,tTop,3,tH,wallLit); P(tx+tW-3,tTop,3,tH,wallDark);
    for(let cy2=tTop+8; cy2<by+H-3; cy2+=7) P(tx+2,cy2,tW-4,1,wallDark);
    for(let x=tx; x<tx+tW-3; x+=7){ P(x,tTop-6,5,7,wall); P(x,tTop-6,5,2,wallLit); }
    // conical roof
    const rB=tTop-6, rT=rB-16;
    for(let i=0;i<(rB-rT);i++){ const ins=Math.round(i/(rB-rT)*(tW/2-1)); P(tx+ins,rB-i,tW-ins*2,1, i>(rB-rT)-4?roofLit:roof); }
    // banner pole
    P(tx+tW/2-1,rT-8,2,9,'#6a5a4a'); P(tx+tW/2+1,rT-8,7,5,dark?'#6a2f4a':'#c9a44a');
    P(tx+tW/2+1,rT-8,7,1,dark?'#8a4a6a':'#e8c25a');
  });
  // the gate arch (centered, at the bottom — this is the door tile)
  const gW=22, gX=bx+Math.round(W/2)-gW/2, gTop=by+H-34;
  P(gX-2,gTop-3,gW+4,(by+H)-gTop+3, wallDark);
  const dr=dark?'#241c30':'#4a3520', drL=dark?'#3a3048':'#5c4530';
  P(gX,gTop,gW,(by+H-3)-gTop,dr); P(gX,gTop-2,gW,4,drL);
  P(gX+Math.round(gW/2)-1,gTop-5,3,4,drL);
  // portcullis bars
  for(let x=gX+3;x<gX+gW-2;x+=5) P(x,gTop+3,1,(by+H-6)-gTop,dark?'#4a4258':'#6a5a44');
  for(let y=gTop+5;y<by+H-4;y+=7) P(gX+2,y,gW-4,1,dark?'#4a4258':'#6a5a44');
  // torches flanking the gate
  [gX-8, gX+gW+4].forEach(tx2=>{ P(tx2,gTop+4,3,10,'#5a4a3a');
    const fl=dark?'#7fa8ff':'#ffb84a'; P(tx2-1,gTop,5,5,fl); P(tx2,gTop-2,3,3,dark?'#c8e0ff':'#ffe08a'); });
}
function drawMistralChapel(ox, oy, overrun){
  const P=(x,y,w,h,c)=>px(x,y,w,h,c);
  const W=44, H=46; const bx=ox-14, by=oy+TILE-H;   // center the ~3-tile chapel on the anchor tile
  const wall=overrun?'#5a5560':'#d8d3c8', wallLit=overrun?'#6d6772':'#efeadf', wallDark=overrun?'#3c3846':'#b0aba0', side=overrun?'#4a4652':'#bcb7ac';
  const roof=overrun?'#3a2f46':'#8a4f2e', roofLit=overrun?'#4c4058':'#a4653c', roofDark=overrun?'#281f32':'#6a3a20', roofEave=overrun?'#201830':'#5a3018', roofRidge=overrun?'#5a4a6a':'#b47a48';
  const OL='#1a141c'; const door=overrun?'#241c30':'#4a3520', doorL=overrun?'#3a3048':'#5c4530';
  const glass=overrun?'#3a2f52':'#8fc0e0', glassL=overrun?'#4a3f62':'#b8e0f0', stoneTrim=overrun?'#6d6772':'#c4bfb4';
  ctx.fillStyle='rgba(0,0,0,0.20)'; ctx.beginPath(); ctx.ellipse(bx+W/2+5, by+H-2, W/2, 7, 0,0,7); ctx.fill();
  if(overrun){ const gg=ctx.createRadialGradient(bx+W/2,by+H*0.4,4,bx+W/2,by+H*0.4,W*0.9); gg.addColorStop(0,'rgba(90,150,255,0.16)'); gg.addColorStop(1,'rgba(90,150,255,0)'); ctx.fillStyle=gg; ctx.fillRect(bx-16,by-40,W+32,H+50); }
  const wallTop=by+Math.round(H*0.46), wallH=(by+H)-wallTop;
  P(bx,wallTop,W,wallH,wall); P(bx,wallTop,W,2,wallLit); P(bx,wallTop,2,wallH,wallLit);
  P(bx+W-2,wallTop,2,wallH,wallDark); P(bx,by+H-2,W,2,wallDark);
  P(bx+W,wallTop+3,4,wallH-3,side); P(bx+W,by+H-2,4,2,wallDark);
  for(let cy=wallTop+5; cy<by+H-2; cy+=5) P(bx+2,cy,W-4,1,wallDark);
  let i2=0; for(let cx=bx+5; cx<bx+W-4; cx+=7){ P(cx+(i2%2)*3,wallTop+6,1,4,wallDark); i2++; }
  const rTop=by+2, rBot=wallTop+2, rH=rBot-rTop;
  for(let i=0;i<rH;i++){ const inset=Math.round((rH-i)/rH*(W*0.10)); P(bx+inset, rTop+i, W-inset*2+1, 1, i<rH*0.35?roofLit:roof); }
  P(bx+Math.round(W/2)-1, rTop, 2, 2, roofRidge); P(bx, rBot-1, W, 1, roofEave);
  for(let i=4;i<rH-1;i+=4){ const inset=Math.round((rH-i)/rH*(W*0.10)); P(bx+inset, rTop+i, W-inset*2+1, 1, roofDark); }
  P(bx-1, rBot-2, W+2, 2, roof); P(bx-1, rBot, W+2, 1, '#00000038');
  for(let i=0;i<rH;i++){ const inset=Math.round((rH-i)/rH*(W*0.10)); P(bx+inset-1, rTop+i, 1,1, OL); P(bx+W-inset+1, rTop+i, 1,1, OL); }
  // steeple tower
  const stW=12, stX=bx+Math.round(W/2)-stW/2, stTop=by-16, stH=(rTop+4)-stTop;
  P(stX,stTop,stW,stH,wall); P(stX,stTop,stW,2,wallLit); P(stX,stTop,2,stH,wallLit);
  P(stX+stW-2,stTop,2,stH,wallDark); P(stX+stW,stTop+3,3,stH-3,side);
  for(let cy=stTop+4; cy<stTop+stH; cy+=5) P(stX+1,cy,stW-2,1,wallDark);
  P(stX+3,stTop+4,stW-6,5,overrun?'#151020':'#2a2438'); P(stX+4,stTop+5,stW-8,3,glass);
  // short spire
  const spBot=stTop+2, spTop=stTop-6, spH=spBot-spTop;
  for(let i=0;i<spH;i++){ const inset=Math.round(i/spH*(stW/2-1)); P(stX+inset,spBot-i,stW-inset*2,1, i>spH-3?roofLit:roof); }
  P(stX+Math.round(stW/2)-1,spTop,2,1,roofLit);
  // the cross (large, unambiguous, above the spire)
  const cross=overrun?'#8a7a9a':'#f4ecd2', crossHi=overrun?'#a89ab8':'#fffdf0', crossSh=overrun?'#5a4a6a':'#c9bd94';
  const cxc=stX+Math.round(stW/2), cTop=spTop-16, shaftH=18, barY=spTop-10, barHalf=5;
  P(cxc-1,cTop,3,shaftH,cross); P(cxc-1,cTop,1,shaftH,crossHi); P(cxc+1,cTop,1,shaftH,crossSh);
  P(cxc-barHalf,barY,barHalf*2+1,3,cross); P(cxc-barHalf,barY,barHalf*2+1,1,crossHi); P(cxc-barHalf,barY+2,barHalf*2+1,1,crossSh);
  P(cxc-1,cTop,3,1,crossHi);
  // arched door (front-center) + stone surround
  const dW=8, dX=bx+Math.round(W/2)-dW/2, dTop=wallTop+Math.round(wallH*0.30);
  P(dX,dTop,dW,(by+H-2)-dTop,door); P(dX,dTop-2,dW,3,doorL); P(dX+dW/2-1,dTop-3,2,2,doorL);
  P(dX+dW/2,dTop+2,1,(by+H-2)-dTop-2,overrun?'#151020':'#2a1e12'); P(dX,dTop,1,(by+H-2)-dTop,doorL);
  P(dX-1,dTop-2,1,(by+H)-dTop,stoneTrim); P(dX+dW,dTop-2,1,(by+H)-dTop,stoneTrim);
  // windows
  [bx+5, bx+W-10].forEach(wx=>{ P(wx,wallTop+6,5,8,overrun?'#2a2438':'#8a8496');
    P(wx+1,wallTop+7,3,6,glass); P(wx+1,wallTop+7,3,1,glassL); P(wx+1,wallTop+10,3,1,overrun?'#3a2f52':'#5a90b8'); });
}
function drawShepherd(x,y,s){
  const OL='#2a2018', ROBE='#8a7a52', ROBE_L='#a89a6e', ROBE_D='#6a5c3c';
  const SKIN='#e0b080', SKIN_D='#b98a5a', HAIR='#5a4327', STAFF='#7a5230', STAFF_L='#9a6a40';
  const o=Math.round(Math.sin((s.t||0)*0.08)*0.6);
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,5,2,0,0,7); ctx.fill();
  px(x+12,y+1+o,1,13,STAFF); px(x+11,y+1+o,2,1,STAFF_L); px(x+10,y+0+o,2,1,STAFF_L); px(x+10,y+1+o,1,1,STAFF_L);
  px(x+5,y+1+o,6,5,SKIN); px(x+5,y+1+o,6,1,HAIR); px(x+5,y+1+o,1,2,HAIR); px(x+10,y+1+o,1,2,HAIR);
  px(x+5,y+2+o,1,4,SKIN_D); px(x+6,y+3+o,1,1,OL); px(x+9,y+3+o,1,1,OL); px(x+7,y+5+o,2,1,SKIN_D);
  px(x+4,y+6+o,8,8,ROBE); px(x+4,y+6+o,2,8,ROBE_L); px(x+10,y+6+o,2,8,ROBE_D);
  px(x+4,y+6+o,8,1,ROBE_L); px(x+3,y+6+o,1,8,OL); px(x+12,y+6+o,1,8,OL); px(x+7,y+8+o,2,6,ROBE_D);
  px(x+4,y+10+o,8,1,'#c9a94a'); px(x+5,y+14+o,2,1,SKIN_D); px(x+9,y+14+o,2,1,SKIN_D);
}
const SHEEP_PAL={
  white:{wool:'#eae6dc',woolL:'#ffffff',woolD:'#c4bfb2',face:'#3a332c'},
  black:{wool:'#4a4650',woolL:'#65616c',woolD:'#33313a',face:'#1a181e'},
  brown:{wool:'#c9a878',woolL:'#e0c398',woolD:'#a2855a',face:'#5a4327'},
  lamb:{wool:'#f2eee6',woolL:'#ffffff',woolD:'#d8d2c6',face:'#6a5c4c'},
};
// a cute fenced pen: posts + rails with a gate gap at the bottom, hay + trough. ──
function drawSheepPen(ox,oy,wT,hT){
  const W=wT*TILE, H=hT*TILE; const post='#7a5230', postL='#9a6a40', postD='#5a3c20', rail='#8a6238';
  px(ox+2,oy+2,W-4,H-4,'#6a9a54');
  px(ox,oy+1,W,2,rail); px(ox,oy+3,W,1,postD);
  px(ox,oy+H+1,Math.round(W/2)-6,2,rail); px(ox+Math.round(W/2)+6,oy+H+1,Math.round(W/2)-6,2,rail);
  px(ox,oy,2,H,rail); px(ox+W,oy,2,H,rail);
  for(let x=ox;x<=ox+W;x+=8){ px(x,oy,2,6,post); px(x,oy,1,6,postL); px(x+1,oy,1,6,postD);
    const gate=(x>ox+W/2-7 && x<ox+W/2+7); if(!gate){ px(x,oy+H,2,6,post); px(x,oy+H,1,6,postL); px(x+1,oy+H,1,6,postD); } }
  for(let y=oy;y<=oy+H;y+=8){ px(ox,y,2,6,post); px(ox,y,1,6,postL); px(ox+W,y,2,6,post); px(ox+W,y,1,6,postL); }
  px(ox+4,oy+H-8,7,5,'#d8c060'); px(ox+4,oy+H-8,7,1,'#e8d878');           // hay bale
  px(ox+W-12,oy+5,8,3,'#6a4a2a'); px(ox+W-12,oy+5,8,1,'#8a6a4a');         // trough
}
// a bouncing golden '?' over a lost sheep so the player can find it. ──
function drawLostMarker(x,y){ const c='#ffe04a', cd='#c9a41a';
  px(x,y,6,2,c); px(x+4,y+2,2,2,c); px(x+2,y+4,2,2,c); px(x+2,y+7,2,2,c);
  px(x,y,6,1,'#fff2a8'); px(x+2,y+7,2,1,cd);
}
function drawSheep(x,y,s){
  const P=SHEEP_PAL[s.variant]||SHEEP_PAL.white; const small=s.variant==='lamb'; const sc=small?1:0;
  const o=Math.round(Math.sin((s.t||0)*0.12)*(s.follow?1.2:0.5));   // livelier bob when following
  const dir=s.dir||'right';
  ctx.fillStyle='rgba(0,0,0,.20)'; ctx.beginPath(); ctx.ellipse(x+8,y+14,small?4:5,2,0,0,7); ctx.fill();
  const LEG=P.face;
  px(x+4+sc,y+12+o,1,2,LEG); px(x+7,y+12+o,1,2,LEG); px(x+10-sc,y+12+o,1,2,LEG);
  const bx=3+sc, bw=9-2*sc;
  px(x+bx,y+6+o+sc,bw,6-sc,P.wool); px(x+bx,y+6+o+sc,bw,1,P.woolL);
  px(x+bx+1,y+5+o+sc,2,2,P.wool); px(x+bx+3,y+4+o+sc,2,2,P.wool); px(x+bx+6,y+5+o+sc,2,2,P.wool);
  px(x+bx-1,y+8+o,1,3,P.woolD); px(x+bx+bw,y+8+o,1,3,P.woolD);
  px(x+bx+1,y+10+o,2,1,P.woolD); px(x+bx+5,y+10+o,2,1,P.woolD);
  const hx = dir==='left'? x+1+sc : x+11-sc;
  px(hx,y+7+o,4,4,P.face); px(hx,y+7+o,4,1,P.woolD);
  px(hx+(dir==='left'?0:2),y+8+o,1,1,'#e8e0d0');
  px(hx,y+6+o,1,1,P.face); px(hx+3,y+6+o,1,1,P.face);
}
// ── THE FALLEN KNIGHT: the pretender's footsoldiers are corrupted copies of the
//    hero. We render the real knight body once per (dir,frame,mode) to an offscreen
//    tile, bake in a tarnished/broken filter, and cache it. drawFallenKnight blits
//    the cache. Deterministic per-pixel hash keeps the decay stable (no flicker). ──
const _fallenCache = {};
function _fallenHash(x,y){ return ((x*374761393 + y*668265263) >>> 0); }
function _buildFallenTile(dir,f,mode){
  const FALLEN_WPN='rusty';                 // corrupted copies of the hero, carrying ruined steel.
  const key=dir+'_'+f+'_'+mode+'_'+FALLEN_WPN;   // weapon in the key: the cache must never
  if(_fallenCache[key]) return _fallenCache[key];// depend on what the player happens to hold
  // The buffer is built at RENDER_SCALE so fallen knights are as sharp as the player.
  // At 1:1 they were the softest thing on screen once the world went to 2x.
  const RS=RENDER_SCALE;
  const oc=document.createElement('canvas'); oc.width=TILE*2*RS; oc.height=TILE*2*RS;
  const octx=oc.getContext('2d'); octx.imageSmoothingEnabled=false;
  // redirect the knight's pixel calls into the offscreen buffer by swapping px
  // (same technique the right-facing mirror uses), then restore in finally.
  const _px=px, _saveMoving=player.moving;
  try {
    px=function(ax,ay,w,h,c){ octx.fillStyle=c; octx.fillRect(ax*RS,ay*RS,w*RS,h*RS); };
    player.moving=false;
    if(dir==='right'){ const _px2=px; px=function(ax,ay,w,h,c){ const lx=ax-8; const mx=8+(16-lx-w); _px2(mx,ay,w,h,c); }; drawKnightBody(8,6,'left',f,0,0,false,FALLEN_WPN); }
    else drawKnightBody(8,6,dir,f,0,0,false,FALLEN_WPN);   // body drawn at (8,6) in the 32x32 buffer
  } catch(_e) { /* cache whatever we have rather than crash */ }
  finally { px=_px; player.moving=_saveMoving; }
  // now apply the fallen filter to the offscreen pixels
  const W=oc.width, H=oc.height; let img;
  try { img=octx.getImageData(0,0,W,H); } catch(_e){ _fallenCache[key]=oc; return oc; }
  const d=img.data;
  for(let y=0;y<H;y++) for(let x=0;x<W;x++){
    const i=(y*W+x)*4; let r=d[i],g=d[i+1],b=d[i+2],a=d[i+3]; if(a===0) continue;
    // gx/gy are GAME pixels: the decay pattern and the crack bands below are authored
    // in game space, so a bigger buffer must not make the speckle finer or move the cracks.
    const gx=Math.floor(x/RS), gy=Math.floor(y/RS);
    const L=(0.299*r+0.587*g+0.114*b)/255; const hv=_fallenHash(gx,gy)%100;
    if(mode==='night'){ r=Math.round(34+L*70); g=Math.round(46+L*82); b=Math.round(68+L*100); }
    else { r=Math.round(48+L*90); g=Math.round(60+L*95); b=Math.round(82+L*110); a=Math.round(a*0.96); }
    if(hv<12 && L>0.25){ r=Math.min(255,r+70); g=Math.round(g*0.7); b=Math.round(b*0.55); }   // rust flecks
    if(L<0.28 && hv>=40 && hv<50){ r=Math.round(r*0.7); g=Math.min(255,g+30); b=Math.round(b*0.8); } // sickly under-glow
    d[i]=r; d[i+1]=g; d[i+2]=b; d[i+3]=a;
    if(gy>=11 && gy<=18){ if(((gx+gy)%7===0) && (_fallenHash(gx,gy)>>5)%5===0){ d[i+3]=0; continue; } }  // torso cracks
    if(gy>=20 && hv<45){ d[i+3]=0; continue; }                                                          // broken lower edge
    if(gy>=7 && gy<=9 && gx>=11 && gx<=13 && hv<55){ d[i+3]=0; continue; }                              // broken pauldron
  }
  octx.putImageData(img,0,0);
  _fallenCache[key]=oc; return oc;
}
function drawFallenKnight(x,y,d){
  if(d.dying>0){ const a=d.dying/18; ctx.globalAlpha=a;
    const oc=_buildFallenTile('down',0, d.nightBuff?'night':'day');
    ctx.drawImage(oc, 0,0,oc.width,oc.height, x-8, y-8, TILE*2, TILE*2); ctx.globalAlpha=1; if(d.pop) drawDmgPop(x,y,d.pop); return; }
  const bob=Math.round(Math.sin(d.t*0.12)*1.0);
  const f=(Math.floor(d.t*0.12)%2)? 1 : 0;                 // simple 2-frame shamble
  const dir=d.face||'down';
  const oc=_buildFallenTile(dir,f, d.nightBuff?'night':'day');
  // cold ground shadow
  ctx.fillStyle='rgba(0,0,0,.28)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,5,2,0,0,7); ctx.fill();
  if(d.hurt>0){ ctx.globalAlpha=0.6; }
  ctx.drawImage(oc, 0,0,oc.width,oc.height, x-8, y-8+bob, TILE*2, TILE*2);
  ctx.globalAlpha=1;
  // dead cold eyes (small)
  const ec = d.nightBuff?'#7ff0ff':'#7ec8e0';
  px(x+5, y+4+bob, 1,1, ec); px(x+8, y+4+bob, 1,1, ec);
  if(d.hurt>0){ ctx.globalAlpha=0.5; px(x+2,y+2+bob,TILE-4,TILE-4,'#ffd0d0'); ctx.globalAlpha=1; }   // hit flash
  // HP bar
  if(d.hp<d.maxHp){ const w=12; px(x-1,y-3,w,2,'#101828'); px(x-1,y-3,Math.max(0,Math.round(w*d.hp/d.maxHp)),2,'#7fa8d8'); }
  if(d.pop) drawDmgPop(x,y,d.pop);
}
// ── the ice-beast: a hunched wolf of the frozen slopes. Two-frame lope, frost-grey
//    by day; the night form is half again the size, black-pelted, eyes like coals. ──
// a bundle of dry pine, roped — fuel for a dying man's fire
function drawWoodBundle(x,y){
  px(x+3,y+8,10,3,'#8a6238'); px(x+3,y+8,10,1,'#a87f4c');
  px(x+4,y+11,9,3,'#7a5430'); px(x+4,y+11,9,1,'#96703f');
  px(x+7,y+7,2,8,'#5e4227');                       // the rope
  px(x+4,y+6,4,2,'#eef6fb');                       // snow dusting
}
// a ring of stones. Dead ash — or, once kindled, a small stubborn flame.
function drawCampfire(x,y,lit){
  [[2,11],[6,13],[11,12],[13,9],[10,6],[4,7]].forEach(([a,b])=>{ px(x+a,y+b,3,2,'#8a94a4'); px(x+a,y+b,3,1,'#a8b2c0'); });
  px(x+5,y+9,6,2,'#4a3524'); px(x+7,y+8,2,4,'#5e4227');
  if(!lit){ px(x+6,y+9,4,2,'#3a3a42'); return; }
  const fl=(Date.now()>>7)&1;
  px(x+6,y+5+fl,4,4,'#ff9a3a'); px(x+7,y+3+fl,2,3,'#ffd24a'); px(x+7,y+6,2,2,'#ffe9a8');
  if(((Date.now()>>8)&3)===0) px(x+8,y+1,1,1,'#ffb060');   // a spark
}
// ── THE KING OF THE SHADOWS: wolf-kin the size of a hut. Matted black-violet pelt,
//    a jaw that does not close, one ear long torn away, eyes like cold stars. ──
// the floating quest marker: a bobbing gold ❗ (dim grey when not yet ready)
function drawQuestMark(x,y,active){
  const bob=Math.round(Math.sin(Date.now()*0.006)*2);
  const c= active? '#ffd24a' : '#8a94a4';
  const o= active? '#7a5a10' : '#3a4048';
  const yy=y+bob;
  px(x+6,yy,4,7,o); px(x+7,yy+1,2,4,c);
  px(x+6,yy+8,4,3,o); px(x+7,yy+9,2,1,c);
}
// the moored ship: hull, mast, furled sail. Reads as a vessel at a glance.
function drawShip(x,y,frozen){
  const t=Date.now()>>7; const sway=(t%4<2)?0:1;
  // hull
  px(x-2,y+10+sway,40,10,'#5e4227'); px(x-2,y+10+sway,40,2,'#8a6238');
  px(x-6,y+12+sway,4,6,'#5e4227'); px(x+38,y+12+sway,6,5,'#4a3524');   // bow + stern
  px(x-2,y+18+sway,40,2,'#3a2a1a');
  px(x+2,y+13+sway,3,3,'#2a2018'); px(x+12,y+13+sway,3,3,'#2a2018'); px(x+22,y+13+sway,3,3,'#2a2018');  // oar ports
  // deck rail
  px(x-2,y+8+sway,40,2,'#a87f4c');
  // mast + crossbeam + furled sail
  px(x+17,y-14+sway,3,24,'#6e4c2c'); px(x+17,y-14+sway,1,24,'#8a6844');
  px(x+6,y-12+sway,25,2,'#6e4c2c');
  px(x+7,y-10+sway,23,4,'#e8dcc0'); px(x+7,y-8+sway,23,1,'#cfc0a0'); px(x+7,y-7+sway,23,1,'#d8ccac');
  for(let i=9;i<29;i+=5) px(x+i,y-10+sway,1,4,'#b8a888');               // sail ties
  px(x+18,y-18+sway,1,4,'#6e4c2c'); px(x+19,y-18+sway,4,3,'#c03a3a');  // pennant
  if(frozen){ px(x-2,y+8+sway,40,1,'#f2f8fc'); px(x+7,y-10+sway,23,1,'#f2f8fc'); }  // snow on rail + sail
  // mooring line to the pier
  px(x-6,y+14+sway,4,1,'#8a8a76'); px(x-9,y+15+sway,3,1,'#8a8a76');
}
// the raft: lashed planks. Riding, it throws spray.
function drawRaft(x,y,riding){
  px(x-1,y+6,14,7,'#8a6238'); px(x-1,y+6,14,1,'#a87f4c');
  for(let i=1;i<14;i+=4) px(x-1+i,y+6,1,7,'#5e4227');
  px(x-1,y+9,14,1,'#6e4c2c');
  if(riding){ const t=Date.now()>>5;
    px(x-4,y+8+(t%3),2,2,'#eaf7ff'); px(x+13,y+7+((t>>1)%3),2,2,'#eaf7ff');
    px(x+2+(t%5),y+13,3,1,'#dff1f8'); px(x+7-((t>>2)%4),y+14,2,1,'#ffffff'); }
}
// a hammock slung between two posts
function drawHammock(x,y){
  px(x-3,y+2,2,12,'#7a5430'); px(x+17,y+2,2,12,'#7a5430');
  px(x-3,y+2,2,1,'#96703f'); px(x+17,y+2,2,1,'#96703f');
  px(x-1,y+6,4,2,'#e8dcc0'); px(x+3,y+8,10,3,'#f2e8cc'); px(x+13,y+6,4,2,'#e8dcc0');
  for(let i=3;i<13;i+=3) px(x+i,y+8,1,3,'#d0c4a4');
}
// a hot spring: a stone-ringed pool, steam curling off it
function drawHotSpring(x,y){
  [[0,8],[3,12],[8,13],[13,11],[15,7],[12,3],[6,2],[1,4]].forEach(([a,b])=>{ px(x+a,y+b,3,2,'#8a94a4'); px(x+a,y+b,3,1,'#a8b2c0'); });
  px(x+3,y+5,10,7,'#5fb8d8'); px(x+4,y+5,8,2,'#8ad4ec');
  const t=Date.now()>>6;
  px(x+5+(t%3),y+2-((t>>1)%3),1,2,'rgba(240,250,255,0.6)');
  px(x+10-((t>>2)%3),y+1-(t%2),1,2,'rgba(240,250,255,0.5)');
  px(x+7,y+3-((t>>1)%2),1,1,'rgba(255,255,255,0.7)');
}
// a palm: leaning trunk, five fronds, coconuts
function drawPalmTree(x,y){
  px(x+7,y-6,3,14,'#8a6238'); px(x+7,y-6,1,14,'#a87f4c');
  px(x+8,y-2,2,1,'#5e4227'); px(x+7,y+2,2,1,'#5e4227');
  const fr='#3f9a4c', frL='#5ec06a';
  px(x+2,y-9,6,2,fr); px(x+1,y-8,3,2,frL);
  px(x+9,y-9,6,2,fr); px(x+13,y-8,3,2,frL);
  px(x+4,y-11,4,2,fr); px(x+9,y-11,4,2,fr);
  px(x+6,y-12,5,2,frL);
  px(x+6,y-7,2,2,'#6e4a28'); px(x+9,y-7,2,2,'#6e4a28');   // coconuts
}
// an Eden fruit tree: round canopy heavy with red fruit
function drawFruitTree(x,y){
  px(x+6,y+2,4,8,'#7a5430'); px(x+6,y+2,1,8,'#96703f');
  px(x+2,y-6,12,8,'#3f8a3c'); px(x+3,y-7,10,2,'#54a04c'); px(x+2,y-6,3,3,'#54a04c');
  px(x+4,y-4,2,2,'#e84a5a'); px(x+10,y-5,2,2,'#e84a5a'); px(x+7,y-2,2,2,'#e84a5a');
  px(x+4,y-4,1,1,'#ff8a96'); px(x+10,y-5,1,1,'#ff8a96'); px(x+7,y-2,1,1,'#ff8a96');
}
function drawPretenderStanding(x,y){
  px(x+5,y-2,6,3,'#d8a832'); px(x+5,y-4,1,2,'#d8a832'); px(x+8,y-4,1,2,'#d8a832'); px(x+10,y-4,1,2,'#d8a832');
  px(x+5,y+1,6,4,'#e8c8a8'); px(x+6,y+3,1,1,'#402818'); px(x+9,y+3,1,1,'#402818');
  px(x+4,y+5,8,10,'#3a2a3e'); px(x+4,y+5,8,2,'#54405c'); px(x+4,y+13,8,2,'#e0885a');
  px(x+3,y+6,2,6,'#3a2a3e'); px(x+11,y+6,2,6,'#3a2a3e');
}
// ── THE PRETENDER on the mirror throne: gold armour over shadow, the same tell
//    ring the mountain taught — blue to hold, red to run — and a crown that was
//    never his. Drawn in the interior pass for vesper_cath. ──
function drawPretender(x,y,b){
  if(b.state==='tell'){
    const pulse=0.45+0.35*Math.sin(b.t*0.35);
    ctx.strokeStyle=(b.tellKind==='blue')? 'rgba(120,205,255,'+pulse.toFixed(2)+')' : 'rgba(255,80,60,'+pulse.toFixed(2)+')';
    ctx.lineWidth=2; ctx.beginPath(); ctx.arc(x+TILE/2, y+TILE/2, TILE*1.15, 0, Math.PI*2); ctx.stroke();
  }
  const hurt=b.hurt>0 && (b.hurt&2);
  const gold=hurt?'#fff0c0':'#d8b050', dark=hurt?'#c0a080':'#6a4a2a', shadow='#3a2438';
  px(x+2,y+13,12,3,shadow);                          // the dark he stands in
  px(x+4,y+4,8,9,gold); px(x+4,y+4,8,2,'#f0d890');   // gilt cuirass
  px(x+5,y+7,6,1,dark); px(x+5,y+10,6,1,dark);
  px(x+3,y+5,1,7,'#b09040'); px(x+12,y+5,1,7,'#b09040');   // pauldron edges
  px(x+5,y+1,6,4,'#e8c8a0');                         // the face
  px(x+6,y+2,1,1,'#3a2438'); px(x+9,y+2,1,1,'#3a2438');
  px(x+4,y,8,2,gold); px(x+4,y-1,1,2,gold); px(x+7,y-2,2,3,gold); px(x+11,y-1,1,2,gold);   // the stolen crown
  if(b.state==='charge'||b.state==='leap'){ px(x-2,y+6,3,6,'#c0392b'); px(x+15,y+6,3,6,'#c0392b'); }  // the cape flares
}
function drawPretenderHud(){
  const b=sunBoss.boss; if(!b) return;
  const wpx=Math.min(180, VW-40), x0=Math.round(VW/2-wpx/2), y0=24;
  ctx.fillStyle='rgba(20,12,24,0.78)'; ctx.fillRect(x0-2,y0-10,wpx+4,20);
  ctx.font='7px monospace'; ctx.textAlign='center'; ctx.fillStyle='#f0c860';
  ctx.fillText('THE PRETENDER KING', VW/2, y0-2);
  ctx.fillStyle='#40202a'; ctx.fillRect(x0,y0,wpx,6);
  ctx.fillStyle=(b.state==='mirror')?'#8a7a9a':'#f0c860';
  ctx.fillRect(x0,y0,Math.round(wpx*(b.hp/b.maxHp)),6);
  ctx.strokeStyle='#000'; ctx.lineWidth=1; ctx.strokeRect(x0+0.5,y0+0.5,wpx-1,5);
  ctx.textAlign='left';
}
function drawMadisonCage(x,y){
  const open = sunfallProgress.pretenderDown;
  px(x+3,y+12,10,2,'#5a4632');
  px(x+5,y+4,6,8,'#e8c8d8'); px(x+5,y+4,6,2,'#caa030');       // Madison — gown + hair
  px(x+6,y+2,4,3,'#f0d0b0');
  if(!open){ for(let i=0;i<5;i++) px(x+2+i*3,y,1,14,'#d8b050');
    px(x+1,y,14,1,'#b09040'); px(x+1,y+13,14,1,'#b09040'); }
  else { px(x+1,y,1,14,'#d8b050'); px(x+14,y,1,14,'#d8b050'); }  // the door hangs open
}
function drawShadowKing(x,y,b){
  const t=b.t||0;
  const sleep=!!b.sleep;
  const s=3.0;                                        // a mountain of him
  const cx=x+8, cy=y+4;
  const P=(ox,oy,w,h,c)=>px(Math.round(cx+(ox-8)*s), Math.round(cy+(oy-8)*s), Math.max(1,Math.round(w*s)), Math.max(1,Math.round(h*s)), c);
  const pelt='#241c30', peltD='#161020', peltL='#3c2f52', mange='#4a3a2a';
  const breathe=sleep? Math.sin(t*0.05)*1.2 : 0;
  if(b.hurt>0 && (b.hurt%4<2)) return;
  // the tell glow beneath him
  if(b.state==='tell'){ const pulse=0.45+0.3*Math.sin(t*0.5);
    ctx.strokeStyle=(b.tellKind==='blue')? 'rgba(120,205,255,'+pulse.toFixed(2)+')' : 'rgba(255,80,60,'+pulse.toFixed(2)+')';
    ctx.lineWidth=3; ctx.beginPath(); ctx.arc(cx, cy+6, TILE*2.1, 0, 7); ctx.stroke();
    ctx.lineWidth=1; ctx.beginPath(); ctx.arc(cx, cy+6, TILE*2.5, 0, 7); ctx.stroke(); }
  ctx.fillStyle='rgba(0,0,0,0.3)'; ctx.beginPath(); ctx.ellipse(cx, cy+7*s*0.8, 10*s, 3*s, 0, 0, 7); ctx.fill();
  // tail — ragged
  P(-2,6,5,2,peltD); P(-3,4,3,2,peltD); P(-1,5,2,1,mange);
  // haunch + body, spine ridged
  P(1,4+breathe*0.3,10,8,pelt); P(1,4,10,2,peltL);
  P(3,3,2,2,peltL); P(6,2,2,3,peltL); P(9,3,2,2,peltL);     // spine ridge
  P(4,7,3,2,mange); P(8,9,2,2,mange);                        // mange patches, rib-bare
  P(8,2,7,9,pelt); P(8,2,7,2,peltL);                         // shoulder mass
  // legs — clawed
  const f=sleep?0:((t>>3)&1);
  P(2,12,3,3+f,peltD); P(6,12,3,3-f,peltD); P(10,12,3,3-f,peltD); P(13,12,3,3+f,peltD);
  P(2,14.6,3,1,'#c8c8d4'); P(13,14.6,3,1,'#c8c8d4');         // claws catch the light
  // the head: low, huge, wrong
  P(13,3,6,6,pelt); P(13,3,6,1,peltL);
  P(17,6,4,3,peltD);                                         // the jaw that does not close
  P(17,5.6,4,1,'#e8e8f0'); P(20,7,1,2,'#e8e8f0'); P(18,8.6,1,1,'#e8e8f0');  // fangs
  P(13,2,2,2,peltD);                                         // one ear —
  P(16,1.5,1,1,mange);                                       // the other, long torn away
  if(sleep){ P(15,5,2,0.8,peltD); }                          // eyes shut
  else { const eye=(b.state==='tell')? (b.tellKind==='blue'? '#7fd0ff':'#ff5040') : '#d8ccff';
    P(15,4.6,2,1.2,eye); P(14,4.6,0.8,1,eye);
    if(((t>>5)&3)===0) P(21,6,3,1,'rgba(210,230,255,0.6)'); } // cold breath
}
function drawShadowKingHud(camX,camY){
  const b=taborBoss.boss; if(!b) return;
  // the marked leap ring and the breath cone, in world space
  if(b.state==='tell' && b.tellAtk==='leap' && b.leap){
    ctx.strokeStyle='rgba(255,70,50,'+(0.5+0.3*Math.sin(Date.now()*0.02)).toFixed(2)+')'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(b.leap.tx-camX, b.leap.ty-camY, TILE*2.3, 0, 7); ctx.stroke(); }
  if(b.state==='breath' && b.breath){ const br=b.breath; const bcx=b.x+TILE/2-camX, bcy=b.y+TILE/2-camY;
    ctx.fillStyle='rgba(150,215,255,0.22)'; ctx.beginPath(); ctx.moveTo(bcx,bcy);
    ctx.arc(bcx,bcy,TILE*5, br.ang-0.62, br.ang+0.62); ctx.closePath(); ctx.fill(); }
  b.shots.forEach(s2=>{ const sx=s2.x-camX, sy2=s2.y-camY;
    ctx.fillStyle='#bfe4f4'; ctx.beginPath(); ctx.moveTo(sx,sy2-4); ctx.lineTo(sx+3,sy2+3); ctx.lineTo(sx-3,sy2+3); ctx.closePath(); ctx.fill();
    ctx.fillStyle='#e8f6ff'; ctx.fillRect(sx-1,sy2-1,2,2); });
  // the bar
  const bw=Math.min(180, VW-40), bh=6, bxp=(VW-bw)/2, byp=VH-30;
  ctx.fillStyle='rgba(0,0,0,0.55)'; ctx.fillRect(bxp-2,byp-2,bw+4,bh+4);
  ctx.fillStyle='#2a2234'; ctx.fillRect(bxp,byp,bw,bh);
  const fr=Math.max(0,b.hp/b.maxHp);
  ctx.fillStyle= fr<0.5? '#b090ff' : '#8a6ae0'; ctx.fillRect(bxp,byp,Math.round(bw*fr),bh);
  ctx.fillStyle='#fff'; ctx.font='bold 8px sans-serif'; ctx.textAlign='center';
  ctx.fillText('THE KING OF THE SHADOWS', VW/2, byp+bh+9);
  ctx.font='7px sans-serif'; ctx.fillStyle='#cbb8ff';
  ctx.fillText(fr<0.5? 'the dark grows quick \u2014 watch the colour of his eyes' : 'blue: shield \u00b7 red: run', VW/2, byp+bh+18);
  ctx.textAlign='left';
}
function drawIceBeast(x,y,d){
  const s=d.big?1.5:1;                                  // the night form looms
  const f=((d.t>>3)&1);                                  // lope frame
  const pelt   = d.big? '#2a2e3a' : '#c8d2dc';
  const peltD  = d.big? '#1a1d26' : '#a4b0bc';
  const peltL  = d.big? '#3c4254' : '#e2eaf2';
  const eye    = d.big? '#ff5030' : '#4a80c0';
  const cx=x+8, cy=y+8;                                  // centre; scale around it
  const P=(ox,oy,w,h,c)=>px(Math.round(cx+(ox-8)*s), Math.round(cy+(oy-8)*s), Math.max(1,Math.round(w*s)), Math.max(1,Math.round(h*s)), c);
  if(d.hurt>0 && (d.hurt%4<2)) return;                   // hit-flicker
  // shadow
  ctx.fillStyle='rgba(0,0,0,0.20)'; ctx.beginPath();
  ctx.ellipse(cx, cy+7*s, 7*s, 2.4*s, 0, 0, 7); ctx.fill();
  // tail
  P(0,6,4,2,peltD); P(-1,5,2,2,peltD);
  // haunches + body, hunched high at the shoulder
  P(2,5,9,6,pelt); P(2,5,9,2,peltL);
  P(9,3,5,7,pelt); P(9,3,5,2,peltL);                     // shoulder hump
  P(3,10,2,3+f,peltD); P(6,10,2,3-f,peltD);              // hind legs (lope)
  P(10,10,2,3-f,peltD); P(12,10,2,3+f,peltD);            // fore legs
  // head low and forward
  P(12,4,4,4,pelt); P(15,5,2,2,peltD);                   // muzzle
  P(12,3,2,2,peltD); P(14,3,1,1,peltD);                  // ears
  P(13,5,1,1,eye);
  if(d.big){ P(13,5,2,1,eye); P(15,6,1,1,'#ff8060');     // the night eyes burn
    P(11,2,1,2,peltD); P(9,2,1,2,peltD); }               // raised hackles
  // frost breath
  if(((d.t>>4)&3)===0) P(17,5,2,1,'rgba(220,240,255,0.7)');
}
function drawDemon(x,y,d){
  if(d.beast){ drawIceBeast(x,y,d); return; }
  if(d.fallen){ drawFallenKnight(x,y,d); return; }
  if(d.dying>0){ const a=d.dying/18; ctx.globalAlpha=a;
    px(x+5,y+5,6,6,'#9a3aaa'); ctx.globalAlpha=1;
    if(d.pop) drawDmgPop(x,y,d.pop);
    return;
  }
  const OL='#1a141c';
  const bob=Math.round(Math.sin(d.t*0.12)*1.4);
  const wf=(Math.sin(d.t*0.12)>0)?0:2;                     // wing flap follows the hover
  const big=d.boss?1.4:1;
  ctx.fillStyle='rgba(0,0,0,.25)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,5*big,2*big,0,0,7); ctx.fill();
  if(d.boss){
    ctx.save(); ctx.shadowColor='#ff4a6a'; ctx.shadowBlur=6;
    const B=d.hurt>0?'#ff9aa8':'#a82a6a', BL='#c8437f', BD='#7a1a4a';
    px(x+0,y-2+bob,3,3,'#e8b93a'); px(x+13,y-2+bob,3,3,'#e8b93a');
    px(x+1,y-3+bob,2,2,'#e8b93a'); px(x+13,y-3+bob,2,2,'#e8b93a');
    px(x-2,y+1+bob+wf,4,8-wf,'#5a1436'); px(x-1,y+2+bob+wf,2,6-wf,'#8a2456');
    px(x+14,y+1+bob+wf,4,8-wf,'#5a1436'); px(x+15,y+2+bob+wf,2,6-wf,'#8a2456');
    px(x+1,y+2+bob,14,12,B); px(x+1,y+2+bob,3,12,BL); px(x+12,y+2+bob,3,12,BD);
    px(x+1,y+2+bob,14,1,'#d85a92'); px(x+0,y+2+bob,1,12,OL); px(x+15,y+2+bob,1,12,OL); px(x+1,y+1+bob,14,1,OL);
    px(x+3,y+6+bob,4,4,'#ffd05a'); px(x+9,y+6+bob,4,4,'#ffd05a');
    px(x+4,y+7+bob,2,2,'#ff7a2a'); px(x+10,y+7+bob,2,2,'#ff7a2a');
    px(x+5,y+11+bob,6,2,'#4a1030');
    px(x+5,y+11+bob,1,1,'#ffffff'); px(x+8,y+11+bob,1,1,'#ffffff'); px(x+10,y+11+bob,1,1,'#ffffff');
    px(x+2,y+14+bob,3,2,BD); px(x+11,y+14+bob,3,2,BD);
    ctx.restore();
  } else if(d.nightBuff){
    drawNightForm(d.nform||0, x, y, d.hurt, bob);   // after dark: one of four creepy forms
  } else {
    const B=d.hurt>0?'#ff9aa8':'#7a2a8a', BL='#9a44aa', BD='#5a1c68';
    px(x+0,y+1+bob+wf,4,7-wf,'#3f1252'); px(x+1,y+2+bob+wf,2,5-wf,'#6a2a80');
    px(x+12,y+1+bob+wf,4,7-wf,'#3f1252'); px(x+13,y+2+bob+wf,2,5-wf,'#6a2a80');
    px(x+4,y+1+bob,2,2,BD); px(x+10,y+1+bob,2,2,BD);
    px(x+3,y+4+bob,10,9,B); px(x+3,y+4+bob,2,9,BL); px(x+11,y+4+bob,2,9,BD);
    px(x+3,y+4+bob,10,1,'#b45ac4'); px(x+2,y+4+bob,1,9,OL); px(x+13,y+4+bob,1,9,OL); px(x+3,y+3+bob,10,1,OL);
    px(x+5,y+7+bob,2,2,'#ff5a5a'); px(x+9,y+7+bob,2,2,'#ff5a5a');
    px(x+5,y+6+bob,2,1,'#ff9a9a'); px(x+9,y+6+bob,2,1,'#ff9a9a');
    px(x+6,y+10+bob,4,1,'#3a0f44');
    px(x+4,y+13+bob,2,2,BD); px(x+10,y+13+bob,2,2,BD);
    px(x+4,y+14+bob,2,1,OL); px(x+10,y+14+bob,2,1,OL);
  }
  if(d.hp<d.maxHp){ const w=d.boss?16:12; px(x-1,y-3,w,2,'#3a1018'); px(x-1,y-3,Math.max(0,Math.round(w*d.hp/d.maxHp)),2,d.boss?'#ff3a5a':'#ff5a6a'); }
  ctx.fillStyle=d.boss?'#ffd05a':'#ffd0d8'; ctx.font='6px monospace'; ctx.fillText(d.boss?(d.name||'BOSS'):('L'+d.level), x+(d.boss?-2:1), y-5);
  if(d.pop) drawDmgPop(x,y,d.pop);
}


// ── NIGHT DEMON FORMS: four creepy variants, chosen per-demon at spawn (d.nform).
//    Each looms larger than the tile; painted with the demon's hover bob. ──
function _neye(x,y,r,c,cL){ px(x,y,r,r,c); px(x,y,Math.max(1,r-1),1,cL); px(x+1,y+1,1,1,'#fff8d0'); }
function drawNightForm(form,x,y,hurt,bob){
  const OLd='#0a0410';
  const hit=hurt>0;
  const B =hit?'#ff9aa8':'#4a1258', BL=hit?'#ffc0c8':'#66206e', BD=hit?'#d87a88':'#2c0838';
  const wing='#1e0628', wingL='#38103e';
  const yb=y+bob;
  if(form===0){        // ── THE LOOMER: 3 eyes, reaching arms, asymmetric horns ──
    px(x-2,yb+6,3,9,B); px(x-2,yb+6,1,9,BL); px(x-3,yb+13,3,3,BD);
    px(x+15,yb+6,3,9,B); px(x+16,yb+6,1,9,BD); px(x+16,yb+13,3,3,BD);
    px(x-3,yb+15,1,1,OLd); px(x-1,yb+16,1,1,OLd); px(x+17,yb+15,1,1,OLd); px(x+18,yb+16,1,1,OLd);
    px(x+0,yb-1,4,8,wing); px(x+1,yb+0,2,5,wingL); px(x+0,yb+3,1,2,OLd);
    px(x+12,yb-1,4,8,wing); px(x+13,yb+0,2,5,wingL); px(x+15,yb+3,1,2,OLd);
    px(x+3,yb-4,2,5,BD); px(x+2,yb-5,1,2,BD); px(x+11,yb-2,2,3,BD);
    px(x+3,yb+2,10,13,B); px(x+3,yb+2,3,13,BL); px(x+10,yb+2,3,13,BD);
    px(x+3,yb+2,10,1,'#7a2a88'); px(x+2,yb+2,1,13,OLd); px(x+13,yb+2,1,13,OLd); px(x+3,yb+1,10,1,OLd);
    px(x+4,yb+5,8,5,'#160420');
    _neye(x+5,yb+6,2,'#c8ff6a','#eaffb0'); _neye(x+9,yb+6,2,'#c8ff6a','#eaffb0'); _neye(x+7,yb+9,1,'#c8ff6a','#eaffb0');
    px(x+4,yb+12,8,1,'#0a0410'); px(x+5,yb+12,1,1,'#7a6a4a'); px(x+8,yb+12,1,1,'#7a6a4a'); px(x+10,yb+12,1,1,'#7a6a4a');
    px(x+3,yb+14,3,2,BD); px(x+10,yb+14,3,2,BD);
  } else if(form===1){ // ── THE MAW: huge fanged mouth, eyes forced high ──
    px(x-3,yb+2,5,9,wing); px(x-2,yb+3,2,6,wingL); px(x-3,yb+6,1,2,OLd);
    px(x+14,yb+2,5,9,wing); px(x+16,yb+3,2,6,wingL); px(x+18,yb+6,1,2,OLd);
    px(x-4,yb+4,1,3,wing); px(x+19,yb+4,1,3,wing);
    px(x+1,yb-1,2,3,BD); px(x+0,yb-2,1,2,BD); px(x+13,yb-1,2,3,BD); px(x+15,yb-2,1,2,BD);
    px(x+1,yb+2,14,12,B); px(x+1,yb+2,3,12,BL); px(x+12,yb+2,3,12,BD);
    px(x+1,yb+2,14,1,'#7a2a88'); px(x+0,yb+2,1,12,OLd); px(x+15,yb+2,1,12,OLd); px(x+1,yb+1,14,1,OLd);
    _neye(x+5,yb+4,2,'#ff5a3a','#ffb08a'); _neye(x+9,yb+4,2,'#ff5a3a','#ffb08a');
    px(x+4,yb+3,2,1,BD); px(x+10,yb+3,2,1,BD);
    px(x+3,yb+8,10,6,'#180418'); px(x+3,yb+8,10,1,'#0a0410');
    px(x+3,yb+8,2,3,'#f4f0e0'); px(x+6,yb+8,1,2,'#f4f0e0'); px(x+8,yb+8,1,2,'#f4f0e0'); px(x+11,yb+8,2,3,'#f4f0e0');
    px(x+4,yb+12,1,2,'#d8d0c0'); px(x+7,yb+13,2,1,'#d8d0c0'); px(x+10,yb+12,1,2,'#d8d0c0');
    px(x+5,yb+10,6,1,'#3a0a2a');
    px(x+2,yb+14,3,2,BD); px(x+11,yb+14,3,2,BD);
  } else if(form===2){ // ── THE HUSK: bloated, diseased, uneven eyes, dripping ──
    px(x+12,yb-1,5,10,wing); px(x+13,yb+0,2,7,wingL); px(x+16,yb+4,1,3,OLd); px(x+14,yb+8,1,2,OLd);
    px(x-1,yb+4,3,5,wing); px(x-1,yb+5,1,3,wingL);
    px(x+3,yb-3,2,4,BD); px(x+2,yb-4,1,2,BD); px(x+11,yb-1,1,2,BD);
    px(x+2,yb+3,13,12,B); px(x+2,yb+3,3,12,BL); px(x+12,yb+4,3,11,BD); px(x+13,yb+7,2,6,BD);
    px(x+2,yb+3,13,1,'#7a2a88'); px(x+1,yb+3,1,12,OLd); px(x+15,yb+4,1,11,OLd); px(x+2,yb+2,13,1,OLd);
    px(x+4,yb+10,2,2,'#8aff6a'); px(x+5,yb+10,1,1,'#d0ffb0'); px(x+11,yb+6,2,2,'#8aff6a'); px(x+12,yb+6,1,1,'#d0ffb0');
    _neye(x+4,yb+6,3,'#ffe04a','#fff4b0'); _neye(x+10,yb+8,2,'#ffe04a','#fff4b0');
    px(x+5,yb+12,6,2,'#180418');
    px(x+5,yb+12,1,2,'#f4f0e0'); px(x+8,yb+12,1,1,'#f4f0e0'); px(x+9,yb+13,1,1,'#f4f0e0');
    px(x+6,yb+14,1,2,'#7aff5a');
    px(x+3,yb+14,2,2,BD); px(x+11,yb+14,3,2,BD);
  } else {             // ── THE WATCHER: a mass of eyes, minimal face ──
    px(x+0,yb-1,4,7,wing); px(x+1,yb+0,2,4,wingL);
    px(x+12,yb-1,4,7,wing); px(x+13,yb+0,2,4,wingL);
    px(x+4,yb-2,1,3,BD); px(x+6,yb-3,1,4,BD); px(x+8,yb-2,1,3,BD); px(x+10,yb-3,1,4,BD);
    px(x+2,yb+2,12,13,B); px(x+2,yb+2,3,13,BL); px(x+11,yb+2,3,13,BD);
    px(x+2,yb+2,12,1,'#7a2a88'); px(x+1,yb+2,1,13,OLd); px(x+14,yb+2,1,13,OLd); px(x+2,yb+1,12,1,OLd);
    _neye(x+4,yb+4,2,'#ff3a6a','#ffb0c0'); _neye(x+9,yb+4,2,'#ff3a6a','#ffb0c0'); _neye(x+6,yb+7,2,'#ff3a6a','#ffb0c0');
    _neye(x+3,yb+9,1,'#ff3a6a','#ffb0c0'); _neye(x+11,yb+8,1,'#ff3a6a','#ffb0c0'); _neye(x+8,yb+10,1,'#ff3a6a','#ffb0c0');
    px(x+6,yb+13,4,1,'#0a0410');
    px(x+3,yb+14,2,2,BD); px(x+11,yb+14,2,2,BD);
  }
}

function drawVillager_legacy(x,y,v){
  const o=OUTFITS[v.outfit]||OUTFITS.peasant;
  const small = v.outfit==='child';
  const sc = small?2:0;                        // children sit a bit smaller
  const f=v.moving?v.frame:0; const bob=(f===1?-1:f===3?1:0);
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,4,2,0,0,7); ctx.fill();
  // body (clothing top)
  px(x+4,y+6+sc+bob,8,6-sc,o.top);
  // apron overlay for peasantF
  if(o.apron) px(x+6,y+7+bob,4,5-sc,o.apron);
  // legs / bottom
  px(x+4,y+12+bob,3,3-(small?1:0),o.bottom); px(x+9,y+12+bob,3,3-(small?1:0),o.bottom);
  // head + hair
  px(x+5,y+2+sc+bob,6,5,o.skin); px(x+5,y+2+sc+bob,6,2,o.hair);
  // hat (peasant/farmer)
  if(o.hat){ px(x+3,y+1+sc+bob,10,2,o.hat); px(x+5,y-1+sc+bob,6,2,o.hat); }
  // simple facing eyes
  const ey=y+4+sc+bob; if(v.dir!=='up'){ px(x+6,ey,1,1,'#3a2a1a'); px(x+9,ey,1,1,'#3a2a1a'); }
}

// ════════════════════════════════════════════════════════════════
//  RESIZE + BOOT
// ════════════════════════════════════════════════════════════════
function resize(){
  // FIT-TO-SCREEN: the stage is locked to the exact visible viewport (handles
  // mobile URL bars via visualViewport). A comfortable uniform tile scale is
  // chosen, the tile viewport covers the screen, and any sub-tile excess is
  // cropped at the edges — the page itself never scrolls or overflows.
  const vp=window.visualViewport;
  const maxW=Math.round(vp?vp.width:window.innerWidth), maxH=Math.round(vp?vp.height:window.innerHeight);
  let s=Math.min(maxW/(15*TILE), maxH/(11*TILE));        // at least the classic 15×11 visible
  s=Math.min(4, Math.max(1.0, s));
  VIEW_TW=Math.max(10, Math.min(27, Math.ceil(maxW/(TILE*s))));
  VIEW_TH=Math.max(8,  Math.min(32, Math.ceil(maxH/(TILE*s))));
  const vw=VIEW_TW*TILE, vh=VIEW_TH*TILE;
  VW=vw; VH=vh;                                   // viewport in GAME pixels
  cv.width=vw*RENDER_SCALE; cv.height=vh*RENDER_SCALE;   // backing store — RENDER_SCALE device px per game px
  cv.style.width=Math.round(vw*s)+'px'; cv.style.height=Math.round(vh*s)+'px';
  stage.style.width=maxW+'px'; stage.style.height=maxH+'px';   // stage = screen, exactly
}
if(window.visualViewport) window.visualViewport.addEventListener('resize', ()=>resize());
addEventListener('orientationchange', ()=>setTimeout(resize, 120));
// ── device adaptation: touch devices get the Game Boy layout (d-pad, A/B, START);
//    desktops play by keyboard with a clean screen (M opens the menu).
const IS_TOUCH = ('ontouchstart' in window) || (navigator.maxTouchPoints>0);
if(IS_TOUCH){ document.getElementById('legend').style.display='none'; }
else {
  document.getElementById('menuBtn').style.display='none';
  document.getElementById('controls').style.display='none';
  document.getElementById('legend').textContent='Ⓙ attack · talk · open　Ⓚ dash　Ⓜ menu　⚔ demons roam the roads';
  document.getElementById('banner').style.bottom='18px';   // no controls — banner hugs the bottom edge
}
addEventListener('resize', resize); resize();
// shop items are tappable: first tap highlights, second tap buys
banner.addEventListener('click', e=>{
  if(dialogue.open){ advanceDialogue(); return; }
  if(tourneyMenu.open){
    if(e.target.closest&&e.target.closest('[data-tmclose]')){ closeTourneyMenu(); return; }
    const ti=e.target.closest&&e.target.closest('[data-tmidx]');
    if(ti){ const i=+ti.dataset.tmidx; if(i===tourneyMenu.cursor) tourneyMenuSelect(); else { tourneyMenu.cursor=i; showTourneyMenu(); } }
    return;
  }
  if(wagonMenu.open){
    if(e.target.closest&&e.target.closest('[data-wagonclose]')){ closeWagonMenu(); return; }
    const wi=e.target.closest&&e.target.closest('[data-wagonidx]');
    if(wi){ const i=+wi.dataset.wagonidx; if(i===wagonMenu.cursor) wagonMenuSelect(); else { wagonMenu.cursor=i; showWagon(); } }
    return;
  }
  if(seedMode){
    if(e.target.closest&&e.target.closest('[data-seedclose]')){ closeSeedPicker(); return; }
    const si=e.target.closest&&e.target.closest('[data-seedidx]');
    if(!si) return;
    const j=+si.dataset.seedidx;
    if(j===seedMode.idx) plantSelected();
    else { seedMode.idx=j; showSeedPicker(); }
    return;
  }
  if(!shopMode) return;
  if(e.target.closest&&e.target.closest('[data-shopclose]')){ closeShop(); return; }
  const it=e.target.closest&&e.target.closest('[data-shopidx]');
  if(!it) return;
  const i=+it.dataset.shopidx;
  if(i===shopMode.idx) aPress();
  else { shopMode.idx=i; showShop(); }
});
// ── FLOATING JOYSTICK (touch): press anywhere on the left of the screen and a
// stick blooms under your thumb; drag to move, release to let go.
(function anchoredJoystick(){
  if(!IS_TOUCH) return;
  const joy=document.getElementById('joy'), knob=document.getElementById('joyk');
  let id=null, lastDir=null, lastFire=0; const R=30, DEAD=8, AX=72, AYOFF=110, GRAB=60;
  const clearHeld=()=>{ held.up=held.down=held.left=held.right=false; };
  const releaseRace=()=>{ if(typeof raceHold==='function'){ raceHold('UP',false); raceHold('LEFT',false); raceHold('RIGHT',false); } };
  const releaseTourney=()=>{ if(typeof tourneyHold==='function'){ tourneyHold('UP',false); tourneyHold('DOWN',false); tourneyHold('LEFT',false); tourneyHold('RIGHT',false); } };
  const rest=()=>{ joy.classList.add('idle'); joy.style.display='block'; joy.style.left=AX+'px'; joy.style.top='calc(100% - '+AYOFF+'px)'; knob.style.left='50%'; knob.style.top='50%'; };
  const stop=()=>{ id=null; lastDir=null; clearHeld(); releaseRace(); releaseTourney(); rest(); };
  const anchor=()=>{ const r=stage.getBoundingClientRect(); return [r.left+AX, r.top+r.height-AYOFF]; };
  const overlayOpen=()=>!!(shopMode||intro.open||menu.open||trial.open||library.open||libShop||petB||styl||barn);
  rest();
  stage.addEventListener('touchstart', e=>{
    if(id!==null) return;
    // _legacy: if(place.kind==='surf'||place.kind==='boatrace') return;
    //   "those minigames own their own input" was only half true. The REGATTA
    //   owns its input — it draws its own steering pads onto the canvas and
    //   tracks touches itself. SURF owns nothing: its physics reads the ordinary
    //   held.* flags (if(held.up) g.surferY-=sp; if(held.left) g.surferX-=sp*1.1),
    //   which nothing was setting once the stick bailed out here. The stick was
    //   dead on the wave. Same shape as the tourney stick bug: the game reads one
    //   set of flags and the input writes another, or none at all.
    if(place.kind==='boatrace') return;   // the regatta really does own its input
    const t=e.changedTouches[0];
    const [ax,ay]=anchor();
    if(Math.hypot(t.clientX-ax, t.clientY-ay) > GRAB) return;   // only grab ON the stick — taps elsewhere pass through untouched
    id=t.identifier; joy.classList.remove('idle');
    e.preventDefault();
  }, {passive:false});
  stage.addEventListener('touchmove', e=>{
    if(id===null) return;
    for(const t of e.changedTouches){ if(t.identifier!==id) continue;
      const [ax,ay]=anchor();
      let dx=t.clientX-ax, dy=t.clientY-ay;
      const d=Math.hypot(dx,dy)||1, c=Math.min(d,R)/d;
      knob.style.left=(50+ (dx*c)/88*100)+'%'; knob.style.top=(50+ (dy*c)/88*100)+'%';
      const L = dx < -DEAD && Math.abs(dx) > Math.abs(dy)*0.45;
      const Rt= dx >  DEAD && Math.abs(dx) > Math.abs(dy)*0.45;
      const U = dy < -DEAD && Math.abs(dy) > Math.abs(dx)*0.45;
      const D = dy >  DEAD && Math.abs(dy) > Math.abs(dx)*0.45;
      if(overlayOpen()){
        clearHeld();
        const dir = U?'up':D?'down':L?'left':Rt?'right':null;
        const now=performance.now();
        if(dir && (dir!==lastDir || now-lastFire>270)){ dirPress(dir); lastDir=dir; lastFire=now; }
        if(!dir) lastDir=null;
      } else if(place.kind==='race'){
        // continuous steering/gallop: hold the stick → throttle/steer stays ON
        clearHeld();
        raceHold('UP', U); raceHold('LEFT', L); raceHold('RIGHT', Rt);
      } else if(place.kind==='tourney'){
        // The lists read tourney.held, NOT held.* — without this branch the stick
        // set the overworld flags, which the tourney ignores and the movement
        // update skips for place.kind==='tourney', so the knight never moved.
        clearHeld();
        tourneyHold('UP', U); tourneyHold('DOWN', D); tourneyHold('LEFT', L); tourneyHold('RIGHT', Rt);
      } else {
        held.left=L; held.right=Rt; held.up=U; held.down=D; lastDir=null;
      }
      e.preventDefault();
    }
  }, {passive:false});
  const end=e=>{ for(const t of e.changedTouches){ if(t.identifier===id) stop(); } };
  stage.addEventListener('touchend', end); stage.addEventListener('touchcancel', end);
})();

// ── THE REGATTA: dedicated canvas pointer/touch input (its own on-canvas UI) ──
// The boat race draws all its buttons (menus + steering pads) onto the canvas.
// Steering pads support TRUE MULTI-TOUCH (throttle + steer at once): we track
// every active touch, work out which pads they cover, and set the flags each move.
// Menu buttons (dock/shop/results) fire once on touchstart.
(function regattaInput(){
  function toCanvas(clientX, clientY){
    const r=cv.getBoundingClientRect();
    // _legacy: * VW / r.width  and  * VH / r.height
    //   VW/VH are GAME pixels. The regatta is one of the two screens that swaps
    //   in its own DEVICE-pixel surface and manages its own transform — loop()
    //   hands it identity — so boat._xf maps its layout to the BACKING STORE.
    //   Converting a touch into game pixels and then un-mapping it with _xf
    //   looked for the pads in a coordinate system they do not live in, and
    //   never matched one: steering by touch did nothing at all, and only the
    //   keyboard worked. Same backing-store trap as the tournament knight.
    //   This is a case where reading cv.width is CORRECT, because this surface
    //   really is the one being drawn to.
    return [ (clientX-r.left) * cv.width  / r.width,
             (clientY-r.top)  * cv.height / r.height ];
  }
  // recompute steering from ALL currently-active touches
  function applyPads(touchList){
    const pads={ left:false, right:false, throttle:false };
    for(const t of touchList){
      const [px,py]=toCanvas(t.clientX, t.clientY);
      const pad=boatPadAt(px,py);
      if(pad) pads[pad]=true;
    }
    boatSetPads(pads);
  }
  // ── touch ──
  stage.addEventListener('touchstart', e=>{
    if(place.kind!=='boatrace') return;
    // a fresh touch may be a menu-button tap OR a steering press
    const t=e.changedTouches[0];
    const [px,py]=toCanvas(t.clientX, t.clientY);
    // only treat as a menu tap if it lands on a non-pad button
    if(boatPadAt(px,py)===null){ boatPointer(px,py,'down'); }
    applyPads(e.touches);
    e.preventDefault();
  }, {passive:false});
  stage.addEventListener('touchmove', e=>{
    if(place.kind!=='boatrace') return;
    applyPads(e.touches);
    e.preventDefault();
  }, {passive:false});
  const tend=e=>{
    if(place.kind!=='boatrace') return;
    applyPads(e.touches);   // remaining touches still down
  };
  stage.addEventListener('touchend', tend);
  stage.addEventListener('touchcancel', tend);
  // ── mouse (desktop) ──
  let mdown=false;
  cv.addEventListener('mousedown', e=>{
    if(place.kind!=='boatrace') return;
    const [px,py]=toCanvas(e.clientX, e.clientY);
    if(boatPadAt(px,py)===null){ boatPointer(px,py,'down'); }
    else { mdown=true; const pad=boatPadAt(px,py); const p={}; p[pad]=true; boatSetPads(p); }
    e.preventDefault();
  });
  cv.addEventListener('mousemove', e=>{
    if(place.kind!=='boatrace'||!mdown) return;
    const [px,py]=toCanvas(e.clientX, e.clientY);
    const pad=boatPadAt(px,py);
    boatSetPads({ left:pad==='left', right:pad==='right', throttle:pad==='throttle' });
  });
  addEventListener('mouseup', ()=>{ if(mdown){ mdown=false; boatSetPads({left:false,right:false,throttle:false}); } });
})();
// ════════════════════════════════════════════════════════════════
//  AUDIO — every sound is synthesised at runtime (Web Audio). No asset
//  files: the game stays one portable HTML page. One AudioContext, two
//  buses (music / sfx) under a master gain, unlocked on first touch.
// ════════════════════════════════════════════════════════════════
// device-level audio settings (localStorage — deliberately NOT in the save format)
// Volumes are five stepped levels (0 .. 1). 0 IS "off" — the legacy booleans
// are kept in sync as derived values so every existing audio.sfxOn /
// audio.musicOn check keeps working untouched.
const VOL_STEPS=[0,0.25,0.5,0.75,1];
let _audioPrefs={sfx:true,music:true,sfxVol:1,musicVol:1};
try{ const p=JSON.parse(localStorage.getItem('klk_audio')||'{}');
  if(typeof p.sfx==='boolean')_audioPrefs.sfx=p.sfx;
  if(typeof p.music==='boolean')_audioPrefs.music=p.music;
  if(typeof p.sfxVol==='number')_audioPrefs.sfxVol=Math.min(1,Math.max(0,p.sfxVol));
  if(typeof p.musicVol==='number')_audioPrefs.musicVol=Math.min(1,Math.max(0,p.musicVol));
  // an older save carried only the booleans: a muted flag means level 0
  if(typeof p.sfxVol!=='number' && p.sfx===false)_audioPrefs.sfxVol=0;
  if(typeof p.musicVol!=='number' && p.music===false)_audioPrefs.musicVol=0;
}catch(e){}
_audioPrefs.sfx   = _audioPrefs.sfxVol>0;
_audioPrefs.music = _audioPrefs.musicVol>0;
const audio = {
  ctx:null, master:null, musicBus:null, sfxBus:null,
  sfxOn:_audioPrefs.sfx, musicOn:_audioPrefs.music,
  sfxVol:_audioPrefs.sfxVol, musicVol:_audioPrefs.musicVol,
  MUSIC_BUS_BASE:0.85, SFX_BUS_BASE:1.45,   // the mix at 100% — levels scale these
  track:null, trackId:null, step:0, nextTime:0, stepDur:0.15,
  lastStep:0, voices:0,
};
// ── LUMINAR'S THEME ───────────────────────────────────────────────
// The open world's song is a real recording (theme-luminar.mp3, sitting beside
// index.html) rather than a chiptune pattern. It streams progressively and loops.
// If the file is absent — index.html uploaded on its own, or opened locally —
// we fall back to the chiptune 'overworld' track so the world is never silent.
const THEME = { src:'theme-luminar.mp3', el:null, dead:false, want:false, vol:0.50 };
// _legacy themeEl/themeStart/themePause built ONE looping element per track and
// let the browser wrap it. They now delegate to the two-deck crossfade system
// below so nothing can create a second, conflicting element for THEME.
function themeEl(){ return rtEl(THEME); }
function themeStart(){ return rtStart(THEME); }
function themePause(){ rtPause(THEME); }
// ── RECORDED WORLD THEMES ── each world can carry its own recording sitting
//    beside index.html. A missing file marks that track dead and the world falls
//    back to what it had before: Luminar -> chiptune, portal worlds -> silence.
const RTRACKS = {
  theme:   THEME,                                                                    // Luminar's open world
  mistral: { src:'theme-mistral.mp3',       el:null, dead:false, want:false, vol:0.50 },
  tabor:   { src:'theme-tabor.mp3',         el:null, dead:false, want:false, vol:0.50 },
  sunfall: { src:'last-knight-sunfall.mp3', el:null, dead:false, want:false, vol:0.50 },
  //  the morning music. Export the unused 47-second section of the overworld theme
  //  as theme-dawn.mp3 and it plays from the moment the sun is released through the
  //  walk home; if the file is absent, Sunfall's own theme simply keeps going.
  dawn:    { src:'theme-dawn.mp3',          el:null, dead:false, want:false, vol:0.52 },
  //  ── v66 recordings ──
  //  forest:     the wooded dungeons, the Forest of Disillusionment, the glade
  //  inn:        every inn hearth (INTERIORS[...].theme==='inn')
  //  home:       the Homestead, the title screen, and the closing credits
  //  taborclean: Tabor once it is thawed — the uncleansed loop is deliberately
  //              short and anxious; this one breathes.
  forest:     { src:'theme-forest.mp3',         el:null, dead:false, want:false, vol:0.50 },
  inn:        { src:'theme-inn.mp3',            el:null, dead:false, want:false, vol:0.46 },
  home:       { src:'theme-homestead.mp3',      el:null, dead:false, want:false, vol:0.50 },
  taborclean: { src:'theme-tabor-cleansed.mp3', el:null, dead:false, want:false, vol:0.50 },
  //  ── v81 recordings ──
  //  dungeon: every chapel dungeon floor EXCEPT the forest-flagged ones (those already
  //           carry `forest`) and except an active boss fight (still the 'boss' chiptune).
  //  chapel:  a cleansed town's sanctuary AND the un-cleansed chapel interior alike —
  //           both carry INTERIORS[id].theme==='sanctuary'.
  dungeon:    { src:'last-knight---dungeon-theme.mp3', el:null, dead:false, want:false, vol:0.50 },
  chapel:     { src:'last-knight-chapel-theme.mp3',    el:null, dead:false, want:false, vol:0.50 },
};
// ── CROSSFADE LOOPING ──────────────────────────────────────────────────
// A track's tail rarely sits at the same level as its head, so a plain
// loop=true wrap is audible — and MP3 adds a small frame-boundary gap on top.
// Each recording therefore runs TWO decks: as the lead nears its end the other
// starts from zero and the pair equal-power crossfade over XFADE seconds. The
// seam becomes a musical overlap instead of a cut.
const XFADE = 1.6;                     // seconds of overlap at the wrap
function rtDecks(t){
  if(t.dead) return null;
  if(!t.decks){
    try{
      const d=[null,null];
      for(let i=0;i<2;i++){
        const a=new Audio();
        a.loop=false;                  // WE own the wrap now, not the browser
        a.preload='auto';
        a.addEventListener('error', ()=>{ t.dead=true; t.decks=null; });
        a.src=t.src;
        d[i]=a;
      }
      t.decks=d; t.cur=0; t.xfading=false; t.gain=[1,0];
    }catch(e){ t.dead=true; t.decks=null; return null; }
    rtApplyVol(t);
  }
  return t.decks;
}
// the one place a deck's .volume is ever written: track vol x device level x
// this deck's crossfade gain
function rtApplyVol(t){
  if(!t.decks || !t.gain) return;
  const full=t.vol*audio.musicVol;
  for(let i=0;i<2;i++){ const a=t.decks[i];
    if(a) a.volume=Math.min(1,Math.max(0, full*t.gain[i])); }
}
function rtEl(t){ const d=rtDecks(t); return d ? d[t.cur] : null; }   // the lead deck
function rtStart(t){
  if(t.dead || !audio.musicOn) return false;
  const d=rtDecks(t); if(!d) return false;
  t.want=true;
  rtApplyVol(t);
  const lead=d[t.cur];
  // iOS refuses playback without a gesture; the rejection is harmless and the
  // next input path calls audioUnlock(), which retries.
  if(lead.paused){ try{ const p=lead.play(); if(p&&p.catch) p.catch(()=>{}); }catch(e){} }
  return true;
}
function rtPause(t){
  t.want=false; t.xfading=false;
  if(!t.decks) return;
  for(let i=0;i<2;i++){ const a=t.decks[i]; if(a&&!a.paused){ try{ a.pause(); }catch(e){} } }
  t.gain=[t.cur===0?1:0, t.cur===1?1:0];   // leave it ready to resume cleanly
  rtApplyVol(t);
}
function rtPauseAll(){ for(const k in RTRACKS) rtPause(RTRACKS[k]); }
// one frame of crossfade bookkeeping for a playing track
function rtTick(t){
  if(t.dead || !t.want || !t.decks || !t.gain) return;
  const lead=t.decks[t.cur], other=t.decks[1-t.cur];
  if(!lead) return;
  const dur=lead.duration;
  if(!isFinite(dur) || dur<=0) return;            // metadata not in yet
  const remain=dur-lead.currentTime;
  // the tab slept through the whole overlap: wrap hard rather than fall silent
  if(lead.ended && !t.xfading){
    try{ lead.currentTime=0; const p=lead.play(); if(p&&p.catch) p.catch(()=>{}); }catch(e){}
    return;
  }
  if(!t.xfading && remain<=XFADE && remain>0){
    t.xfading=true;
    try{ other.currentTime=0; }catch(e){}
    t.gain[1-t.cur]=0; rtApplyVol(t);
    try{ const p=other.play(); if(p&&p.catch) p.catch(()=>{}); }catch(e){}
  }
  if(t.xfading){
    let p=1-Math.max(0,remain)/XFADE; p=Math.min(1,Math.max(0,p));
    t.gain[t.cur]=Math.cos(p*Math.PI/2);          // equal power: no dip mid-fade
    t.gain[1-t.cur]=Math.sin(p*Math.PI/2);
    rtApplyVol(t);
    if(remain<=0.02 || lead.ended){               // the handover is done
      try{ lead.pause(); lead.currentTime=0; }catch(e){}
      t.cur=1-t.cur; t.xfading=false;
      t.gain=[t.cur===0?1:0, t.cur===1?1:0];
      rtApplyVol(t);
    }
  }
}
function rtTickAll(){ for(const k in RTRACKS){ const t=RTRACKS[k]; if(t.want) rtTick(t); } }
// ── THE MIXER ──────────────────────────────────────────────────────────
// One entry point per bus. Applies the level to the Web Audio gain AND to
// every live <audio> recording, keeps the legacy on/off booleans in sync,
// and writes the choice to localStorage.
function audioSavePrefs(){
  try{ localStorage.setItem('klk_audio', JSON.stringify({
    sfx:audio.sfxOn, music:audio.musicOn, sfxVol:audio.sfxVol, musicVol:audio.musicVol })); }catch(e){}
}
function setMusicVol(v){
  audio.musicVol=Math.min(1,Math.max(0,v));
  audio.musicOn=audio.musicVol>0;
  if(audio.musicBus) audio.musicBus.gain.value=audio.MUSIC_BUS_BASE*audio.musicVol;
  for(const k in RTRACKS) rtApplyVol(RTRACKS[k]);
  if(!audio.musicOn){ musicStop(); rtPauseAll(); }
  else if(typeof musicUpdate==='function') musicUpdate();   // silence -> sound again, straight away
  audioSavePrefs();
}
function setSfxVol(v){
  audio.sfxVol=Math.min(1,Math.max(0,v));
  audio.sfxOn=audio.sfxVol>0;
  if(audio.sfxBus) audio.sfxBus.gain.value=audio.SFX_BUS_BASE*audio.sfxVol;
  audioSavePrefs();
}
// step to the next level, wrapping past 100% back to off
function stepVol(which){
  const cur = which==='music' ? audio.musicVol : audio.sfxVol;
  let i = VOL_STEPS.findIndex(s=>Math.abs(s-cur)<0.001);
  i = (i<0 ? VOL_STEPS.length-1 : i+1) % VOL_STEPS.length;
  (which==='music' ? setMusicVol : setSfxVol)(VOL_STEPS[i]);
  return VOL_STEPS[i];
}
// a five-cell bar for the menu readout
function volBar(v){
  const n=Math.round(v*4);
  let s='';
  for(let i=0;i<4;i++) s += i<n ? '█' : '░';
  return s;
}
function A(){   // lazily build the graph; returns a running context or null
  if(audio.ctx){ if(audio.ctx.state==='suspended') audio.ctx.resume(); return audio.ctx.state==='running'?audio.ctx:null; }
  try{
    const C=window.AudioContext||window.webkitAudioContext; if(!C) return null;
    const c=new C();
    // a limiter on the master: lets the mix run hot without overlapping sounds clipping
    const comp=c.createDynamicsCompressor();
    comp.threshold.value=-3; comp.knee.value=8; comp.ratio.value=6;
    comp.attack.value=0.003; comp.release.value=0.14;
    comp.connect(c.destination);
    audio.master=c.createGain(); audio.master.gain.value=0.9; audio.master.connect(comp);
    audio.musicBus=c.createGain(); audio.musicBus.gain.value=audio.MUSIC_BUS_BASE*audio.musicVol; audio.musicBus.connect(audio.master);
    audio.sfxBus=c.createGain();   audio.sfxBus.gain.value=audio.SFX_BUS_BASE*audio.sfxVol;       audio.sfxBus.connect(audio.master);
    audio.ctx=c; if(c.state==='suspended') c.resume();
    return c.state==='running'?c:null;
  }catch(e){ audio.ctx=null; return null; }
}
function audioUnlock(){ A(); for(const k in RTRACKS){ if(RTRACKS[k].want) rtStart(RTRACKS[k]); } }   // called from every input path (iOS needs a gesture)

// ── tiny synth helpers ────────────────────────────────────────────
function hz(n){ return 440*Math.pow(2,(n-69)/12); }               // midi → frequency
function noiseBuf(c, secs, decay){
  const len=Math.max(1,Math.floor(c.sampleRate*secs)), b=c.createBuffer(1,len,c.sampleRate), d=b.getChannelData(0);
  for(let i=0;i<len;i++){ const e=decay?Math.pow(1-i/len,decay):1; d[i]=(Math.random()*2-1)*e; }
  return b;
}
// one shaped oscillator note
function tone(bus, o){
  const c=A(); if(!c) return;
  const t0=c.currentTime+(o.delay||0);
  const osc=c.createOscillator(); osc.type=o.type||'square';
  osc.frequency.setValueAtTime(o.f0, t0);
  if(o.f1 && o.f1!==o.f0) osc.frequency.exponentialRampToValueAtTime(Math.max(1,o.f1), t0+o.dur);
  const g=c.createGain();
  const peak=o.gain||0.2, atk=o.attack||0.004;
  g.gain.setValueAtTime(0.0001,t0);
  g.gain.exponentialRampToValueAtTime(peak, t0+atk);
  g.gain.exponentialRampToValueAtTime(0.0001, t0+o.dur);
  let node=osc;
  if(o.filter){ const f=c.createBiquadFilter(); f.type=o.filter; f.frequency.setValueAtTime(o.fc||1200,t0);
    if(o.fc1) f.frequency.exponentialRampToValueAtTime(Math.max(1,o.fc1), t0+o.dur);
    if(o.q!==undefined) f.Q.value=o.q; node.connect(f); node=f; }
  node.connect(g); g.connect(bus||audio.sfxBus);
  osc.start(t0); osc.stop(t0+o.dur+0.02);
}
// one shaped noise burst
function noise(bus, o){
  const c=A(); if(!c) return;
  const t0=c.currentTime+(o.delay||0);
  const src=c.createBufferSource(); src.buffer=noiseBuf(c, o.dur, o.decay===undefined?1.6:o.decay);
  let node=src;
  if(o.filter!==null){ const f=c.createBiquadFilter(); f.type=o.filter||'bandpass';
    f.frequency.setValueAtTime(o.fc||900,t0);
    if(o.fc1) f.frequency.exponentialRampToValueAtTime(Math.max(1,o.fc1), t0+o.dur);
    f.Q.value=o.q===undefined?1.0:o.q; src.connect(f); node=f; }
  const g=c.createGain(); g.gain.setValueAtTime(o.gain||0.2,t0);
  g.gain.exponentialRampToValueAtTime(0.0001, t0+o.dur);
  node.connect(g); g.connect(bus||audio.sfxBus);
  src.start(t0);
}
const sfxAllowed=()=>audio.sfxOn && A();

// ── COMBAT ────────────────────────────────────────────────────────
function sfxSwing(type){ if(!sfxAllowed()) return;      // the blade cuts only AIR — a swish
  const heavy=type==='heavy';
  noise(null,{ dur:heavy?0.24:0.16, fc:heavy?900:1600, fc1:heavy?2200:3400, q:0.8, gain:heavy?0.3:0.22, decay:1.1 });
  noise(null,{ dur:heavy?0.18:0.12, fc:heavy?400:700, fc1:heavy?900:1400, q:0.9, gain:heavy?0.14:0.1, decay:1.4, delay:0.01 });
}
function sfxHit(crit){ if(!sfxAllowed()) return;        // steel MEETS something — the ting
  // the metal rings on contact: inharmonic bell partials (crits ring higher & longer)
  const f=crit?1864:1568;
  tone(null,{ type:'triangle', f0:f,      f1:f,      dur:crit?0.26:0.16, gain:crit?0.3:0.24, attack:0.001 });
  tone(null,{ type:'sine',     f0:f*1.83, f1:f*1.83, dur:crit?0.18:0.11, gain:crit?0.17:0.13, attack:0.001 });
  tone(null,{ type:'sine',     f0:f*2.71, f1:f*2.71, dur:0.08,           gain:0.06, attack:0.001 });
  // …with a small thud of the blow landing beneath it
  noise(null,{ dur:0.08, fc:1200, fc1:300, q:0.7, gain:crit?0.2:0.14, decay:2.4 });
  tone(null,{ type:'square', f0:crit?220:170, f1:crit?70:60, dur:0.09, gain:0.1, filter:'lowpass', fc:900 });
}
