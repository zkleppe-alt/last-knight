  const _cut=Math.max(_needHard, _trulyHard);
  const _hardSpots=_byHard.slice(0, _cut);
  const _easySpots=_byHard.slice(_cut);
  for(let i=0;i<nDem;i++){
    const preferHard = _hardSpots.length && (i < Math.ceil(nDem*2/3) || !_easySpots.length);
    const pool = preferHard ? _hardSpots : (_easySpots.length ? _easySpots : _hardSpots);
    if(!pool.length) break;
    const j=Math.floor(rnd()*pool.length); const [x,y]=pool.splice(j,1)[0]; g[y][x]=6;
    for(const _o of [_hardSpots,_easySpots])
      for(let k=_o.length-1;k>=0;k--) if(Math.abs(_o[k][0]-x)+Math.abs(_o[k][1]-y)<3) _o.splice(k,1);
