function showWagon(msg){
  ensureDeliveryRequests();
  const rows=wagonRows(); if(wagonMenu.cursor>=rows.length) wagonMenu.cursor=rows.length-1;
  const cap=WAGON_CAP, load=cargoCount();
  const reqs=openRequests();
  const cargoStr=Object.keys(wagon.cargo).length
    ? Object.keys(wagon.cargo).map(k=>GOODS[k].emoji+(wagon.cargo[k]>1?'×'+wagon.cargo[k]:'')).join(' ')
    : '<span style="color:#8a7aaa">empty</span>';
  // the best-paying open request the cargo already aboard could settle
  const fillable=reqs.filter(o=>(wagon.cargo[o.good]||0)>0);
  const list=rows.map((r,i)=>{ const sel=i===wagonMenu.cursor; const c=sel?'#ffe04a':'#9a8ab8';
    let lbl;
    if(r.kind==='load'){ const g=GOODS[r.good]; const want=reqs.filter(o=>o.good===r.good);
      lbl=`Load ${g.emoji} ${g.name} <span style="color:#8fc0e0">(have ${inventory[r.good]||0})</span>`;
      if(want.length){ const w=want[0], carry=wagon.cargo[r.good]||0;
        lbl+=`<br><span style="font-size:6px;color:#8fd692">　　📦 ${TOWN_DATA[w.tid].name} needs ${w.left}`
          +(carry?` · <span style="color:#ffe04a">carrying ${carry}</span>`:'')
          +` · <span style="color:#e0b84a">~${w.pay}g</span>`
          +(want.length>1?` <span style="color:#8a7aaa">· ${TOWN_DATA[want[1].tid].name} too</span>`:'')
          +`</span>`; }
      else lbl+=`<br><span style="font-size:6px;color:#6a5a7a">　　no one is asking for this</span>`;
    }
    else if(r.kind==='unload') lbl='Unload all back to your packs';
    else if(r.kind==='hitch') lbl='🐎 <b>Hitch up &amp; drive</b>'+(fillable.length?` <span style="color:#8fd692">→ ${TOWN_DATA[fillable[0].tid].name}</span>`:'');
    else lbl='✕ Close';
    return `<span data-wagonidx="${i}" style="color:${c};display:inline-block;padding:1px 0">${sel?'▶ ':'　'}${lbl}</span>`; }).join('<br>');
  // goods the realm wants that your packs cannot cover — the reason to go harvest
  const unstocked=reqs.filter(o=>((inventory[o.good]||0)+(wagon.cargo[o.good]||0))<=0).slice(0,2);
  const alsoLine = unstocked.length
    ? `<br><span style="font-size:6px;color:#9a8ab8">Also wanted: ${unstocked.map(o=>`${GOODS[o.good].emoji} ${GOODS[o.good].name} → ${TOWN_DATA[o.tid].name} <span style="color:#e0b84a">~${o.pay}g</span>`).join(' · ')}</span>`
    : '';
  const waitStr = reqs.length
    ? `<span style="font-size:6px;color:#8fd692"> · ${reqs.length} town${reqs.length===1?'':'s'} waiting</span>`
    : `<span style="font-size:6px;color:#6a5a7a"> · no requests yet</span>`;
  banner.innerHTML = `<span data-wagonclose="1" style="position:absolute;top:1px;right:7px;color:#ff8a8a;font-size:10px;padding:3px 5px;cursor:pointer">✕</span>`+
    `<b style="color:#fff">🛒 Supply Wagon</b> <span style="font-size:7px;color:#ffe04a">${load}/${cap} crates</span>${waitStr}<br>`+
    `<span style="font-size:7px;color:#b0a8c0">Cargo: ${cargoStr}</span><br>`+
    `<span style="font-size:7px">${list}</span>${alsoLine}<br>`+
    `<span style="font-size:6px;color:#8a7aaa">tap a row, tap again to confirm · load your harvest, then hitch up · ✕ or walk away to leave</span>`+
    (msg?`<br><span style="font-size:7px;color:#7ad07a">${msg}</span>`:'');
  banner.style.display='block'; banner.style.pointerEvents='auto'; bannerT=999999;
}
function wagonMenuMove(delta){ const n=wagonRows().length; wagonMenu.cursor=(wagonMenu.cursor+n+delta)%n; showWagon(); }
function wagonMenuSelect(){
  const rows=wagonRows(); const r=rows[wagonMenu.cursor]; if(!r) return;
  if(r.kind==='close'){ closeWagonMenu(); return; }
  if(r.kind==='hitch'){ if(cargoCount()===0){ showWagon('Load at least one crate before you set out.'); return; } startDriving(); return; }
  if(r.kind==='unload'){ for(const k in wagon.cargo){ inventory[k]=(inventory[k]||0)+wagon.cargo[k]; } wagon.cargo={}; showWagon('Unloaded everything back to your packs.'); return; }
  if(r.kind==='load'){ const g=r.good;
    if(cargoCount()>=WAGON_CAP){ showWagon('The wagon is full ('+WAGON_CAP+' crates).'); return; }
    if((inventory[g]||0)<=0){ showWagon('You have no '+GOODS[g].name+' to load.'); return; }
    inventory[g]--; wagon.cargo[g]=(wagon.cargo[g]||0)+1; showWagon('Loaded '+GOODS[g].emoji+' '+GOODS[g].name+'.'); return; }
}
function closeWagonMenu(){ wagonMenu.open=false; banner.style.display='none'; banner.style.pointerEvents='none'; bannerT=0; }

// ════════════════════════════════════════════════════════════════
//  GAME LOOP
// ════════════════════════════════════════════════════════════════
const SPEED=1.5; let last=0;
let DIAG8=true;   // ⬡ eight-way walk (see the movement block in loop()); false = original four-way
// ── UNIVERSAL FISHING: classify the water tile the player faces into a catch
//    zone. Sea/surf → 'sea'; fresh water (tile 3) picks a zone by region so the
//    desert oasis, the Sage's forest waters, and ordinary ponds each feel right;
//    swamp water fishes like a forest pool. Returns null on non-water. ──
function fishZoneAt(fx,fy){
  const t=(place.kind==='overworld' && WORLD[fy]) ? WORLD[fy][fx] : undefined;
  if(t===undefined) return null;
  if(t===20||t===21) return 'sea';                       // sea + surf
  if(t===29) return 'forest';                            // swamp water → forest table
  if(t===3){                                             // fresh water: choose by region
    const desert = (fx>=78 && fx<=107 && fy>=56 && fy<=82);      // Dusthaven basin → oasis fish
    const sageWood = (fx>=84 && fx<=95 && fy>=165 && fy<=176);   // near the forest waters
    return desert ? 'oasis' : sageWood ? 'forest' : 'pond';
  }
  return null;
}
function regionName(){
  if(place.kind==='interior') return INTERIORS[place.id].name;
  if(place.kind==='surf') return `🏄 The Knight's Wave`;
  if(place.kind==='dungeon'){ if(dungeon.disillusion) return `🌫️ Forest of Disillusionment · Depth ${dungeon.floorIdx+1}/${dungeon.floors.length}`;
    if(dungeon.forest) return `🌲 Sage's Wood · ${dungeon.floors[dungeon.floorIdx]===3?"Eldan's Glade":'Depth '+(dungeon.floorIdx+1)+'/'+dungeon.floors.length}`;
    const td=TOWN_DATA[dungeon.townId]; return `⛪ ${td.general}'s Chapel · Floor ${dungeon.floorIdx+1}/${dungeon.floors.length}`; }
  if(place.kind==='abaddon'){ return abaddon.who==='pretender' ? `👑 The Usurped Throne` : `👑 Abaddon's Throne`; }
  if(place.kind==='keep'){ return `👑 Throne Hall of Luminar`; }
  if(place.kind==='portalworld'){
    const wn=(portalById(portalWorld.id)&&portalById(portalWorld.id).name)||'Portal World';
    const base=wn.replace(/ Gate$/,' Isle');
    // if standing within a village clearing, name it
    const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
    if(portalWorld.villages){ for(const v of portalWorld.villages){
      if(Math.abs(ptx-v.cx)<=6 && Math.abs(pty-v.cy)<=6) return '\ud83c\udf3e '+base+' \u00b7 '+v.name+(v.cleared?'':' (overrun)'); } }
    // near the castle hill?
    if(portalWorld.castle && Math.abs(ptx-portalWorld.castle.cx)<=10 && pty<=portalWorld.castle.cy+8) return '\ud83c\udff0 '+base+' \u00b7 the Castle Hill';
    return '\ud83c\udf00 '+base;
  }
  const tx=Math.floor((player.x+TILE/2)/TILE), ty=Math.floor((player.y+TILE/2)/TILE);
  return regionNameAt(tx,ty);
}
// Name any overworld tile, not just the one the knight is standing on — bounties need
// to tell the player WHERE the dark has resurfaced.
// new-grid town boxes: name -> [x0,y0,x1,y1]. Hoisted so cull bounties can name a
// place too, not just the tile the knight happens to be standing on.
const REGION_BOX={
  'Hearthvale':[16,12,49,32], 'The Homestead':[95,4,123,34], 'Ironhold':[14,52,57,75],
  'Saltmere':[12,198,55,224], 'Thornwood':[78,146,105,168], 'Dusthaven':[80,58,105,80],
  'Crystalpeak':[140,60,166,77], 'Ashfield':[138,136,178,165], 'Shadowmere':[205,136,229,159],
  'Hellgate Citadel':[212,12,238,26], 'Stormgate':[150,198,194,228],
  'The Southern Isles':[10,250,200,295]
};
function regionNameAt(tx,ty){
  // Stormgate is the tiered coastal capital — show its tier. This MUST be tested before
  // the box loop: REGION_BOX carries a plain 'Stormgate' entry so cull bounties can name
  // the region, and letting the loop match first would flatten all three tiers to one name.
  if(tx>=150&&tx<=194&&ty>=198&&ty<=228){ if(ty<=205)return 'Stormgate — The Keep'; if(ty<=216)return 'Stormgate — Inner City'; return 'Stormgate — Outer City'; }
  const BOX=REGION_BOX;
  for(const n in BOX){ const[x0,y0,x1,y1]=BOX[n]; if(tx>=x0&&tx<=x1&&ty>=y0&&ty<=y1) return n; }
  if(ty>=236) return 'The Great Sea';
  return 'The Open Road';
}
// ── the roads are at peace, so a demon cull must bring its own quarry. Each cull is
//    pinned to one encounter zone; spawnDemons() repopulates exactly what is still
//    owed there, on every place change, so the hunt survives saving and travelling.
// Encounter zones keep OLD-world coordinates (they were never shifted by the rebuild),
// so their centres land outside every new-world town box — asking regionNameAt() about
// them returns "The Open Road" for all ten, which tells the player nothing. Name them by
// which region they actually overlap, falling back to the nearest one.
function zoneRegionName(z){
  let best=null, bestArea=0;
  for(const n in REGION_BOX){ const[x0,y0,x1,y1]=REGION_BOX[n];
    const ox=Math.min(z.x1,x1)-Math.max(z.x0,x0), oy=Math.min(z.y1,y1)-Math.max(z.y0,y0);
    if(ox>0&&oy>0 && ox*oy>bestArea){ bestArea=ox*oy; best=n; } }
  if(best) return 'the outskirts of '+best;
  let near=null, nd=Infinity;
  const cx=(z.x0+z.x1)/2, cy=(z.y0+z.y1)/2;
  for(const n in REGION_BOX){ const[x0,y0,x1,y1]=REGION_BOX[n];
    const d=Math.hypot(cx-(x0+x1)/2, cy-(y0+y1)/2); if(d<nd){ nd=d; near=n; } }
  return near ? 'the wilds beyond '+near : 'the open wilds';
}
function cullZoneName(b){
  if(!b || typeof b.zone!=='number') return 'the wilds';
  const z=encounterZones[b.zone]; if(!z) return 'the wilds';
  return zoneRegionName(z);
}
function pickCullZone(){
  // avoid stacking two culls in the same place — it reads as a bug to the player
  const used=new Set(bounties.active.filter(b=>b.kind==='demons'&&typeof b.zone==='number').map(b=>b.zone));
  const all=encounterZones.map((z,i)=>i);
  const free=all.filter(i=>!used.has(i));
  const pool=free.length?free:all;
  return pool[Math.floor(Math.random()*pool.length)];
}
function spawnCullDemons(){
  bounties.active.forEach(b=>{
    if(b.kind!=='demons' || typeof b.zone!=='number') return;
    const z=encounterZones[b.zone]; if(!z) return;
    const owed=Math.max(0, (b.need||0)-(b.got||0));
    for(let i=0;i<owed;i++){
      let tx,ty,tries=0;
      do { tx=z.x0+Math.floor(Math.random()*(z.x1-z.x0)); ty=z.y0+Math.floor(Math.random()*(z.y1-z.y0)); tries++; }
      while((!WALK.has(WORLD[ty]?.[tx]) || Math.hypot(tx*TILE-player.x,ty*TILE-player.y)<TILE*8) && tries<40);
      if(tries<40){ const hp=5+z.level*2;
        demons.push({ x:tx*TILE, y:ty*TILE, hp, maxHp:hp, level:z.level, zi:b.zone,
          xp:4+z.level*3, t:Math.random()*60, alive:true, hurt:0, nform:(Math.random()*4)|0, cull:true }); }
    }
  });
}
function loop(ts){
  const dt=Math.min(34, ts-last)||16; last=ts;
  // The reveal is driven ONCE PER FRAME, not inside a place.kind branch: a
  // conversation can open anywhere, and the banner tickers are per-branch. The
  // first version of this hook sat in the overworld branch and simply never ran.
  if(dialogue.open) tickDialogue(dt);
  escortStep(dt);
  // THE WORLD HOLDS STILL while a conversation is on screen, so you cannot be
  // killed while reading. The guard sits on the frame rather than in any one
  // place.kind branch: there are three separate demon updaters and a conversation
  // can open in front of all of them.
  const _frozen = dialogue.open;
  // ── base transform: every draw call is authored in GAME pixels and scaled to
  //    the backing store here, once per frame. The race and regatta swap in their
  //    own device-pixel canvas and manage their own transform, so they get identity.
  { const _mini = (place.kind==='race'||place.kind==='boatrace');
    const _rs = _mini ? 1 : RENDER_SCALE;
    ctx.setTransform(_rs,0,0,_rs,0,0);
    // Setting cv.width resets context state, and the cached blits (fallen knights,
    // spectral steed) are upscaled by RENDER_SCALE — without this they go bilinear
    // and turn to mush. The minigames run on their own smooth surface and want it on.
    ctx.imageSmoothingEnabled = _mini; }
  // ⚔ GBA boot sequence (splash → title → save select) owns the frame until done
  // the title screen carries the homestead theme, so the music system has to run
  // here too — this branch returns before the main musicUpdate() call below
  if(!boot.done){ musicUpdate(); rtTickAll(); bootTick(dt); drawBoot(); requestAnimationFrame(loop); return; }
  updatePotBtn();
  playMs += dt;                                     // total time on this save (menus included)
  musicUpdate(); musicPump(); rtTickAll();
  // 👑 the endgame cutscene owns the frame entirely (above menus, banners, everything)
  if(place.kind==='throne'){ throneTick(dt); drawThrone();
    if(bannerT>0 && !dialogue.open){ bannerT-=dt; if(bannerT<=0) banner.style.display='none'; }
    requestAnimationFrame(loop); return; }
  // while the menu is open, freeze the world (still redraw the frame underneath)
  if(intro.open || menu.open || trial.open || library.open || libShop || petB || styl || barn){ draw(); drawMinimap(); requestAnimationFrame(loop); return; }
  if(place.kind==='tourney'){ tourneyTick(dt); drawTourney(); requestAnimationFrame(loop); return; }
  // ── the world clock turns (paused during menus/cutscenes by the returns above) ──
  // ☀ over Sunfall the sun hangs frozen at golden hour — the old order refusing
  //   to end — until the finale raises portalWorld.dawn and time moves again.
  if(place.kind==='portalworld' && portalWorld.id==='sunfall' && !portalWorld.dawn){
    dayClock.t = DAY_LEN*0.82;
  } else {
    dayClock.t += dt; if(dayClock.t>=DAY_LEN){ dayClock.t-=DAY_LEN; dayClock.day++; }
  }
  // _legacy: dayClock.t += dt; if(dayClock.t>=DAY_LEN){ dayClock.t-=DAY_LEN; dayClock.day++; }
  const _nn=isNight();
  if(_wasNight===null) _wasNight=_nn;
  else if(_nn!==_wasNight){ _wasNight=_nn; applyNightDemons(_nn);
    if(demons.some(d=>d.alive&&!d.boss))
      showBanner(_nn ? '\ud83c\udf19 <b>Night falls...</b><br><span style="font-size:7px">The demons grow bold \u2014 +'+NIGHT_LVL_BOOST+' levels until dawn.</span>'
                     : '\ud83c\udf05 <b>Dawn breaks.</b><br><span style="font-size:7px">The demons\' borrowed power wanes.</span>', 2600);
  }
  // ── THE KNIGHT'S WAVE: the surf session owns the frame ──
  if(place.kind==='surf'){
    updateSurf(dt); drawSurf();
    if(bannerT>0){ bannerT-=dt; if(bannerT<=0) banner.style.display='none'; }
    requestAnimationFrame(loop); return;
  }
  // ── THE KING'S TOURNEY: the horse race owns the frame ──
  if(place.kind==='race'){
    raceTick(dt/16.6667); drawRace(ctx, cv.width, cv.height);
    if(bannerT>0){ bannerT-=dt; if(bannerT<=0) banner.style.display='none'; }
    requestAnimationFrame(loop); return;
  }
  // ── THE REGATTA: the boat race owns the frame ──
  if(place.kind==='boatrace'){
    boatTick(dt/1000); drawBoat(ctx, cv.width, cv.height);
    if(!window.boat){ place={kind:'overworld'}; }   // module closed itself (left to shore)
    if(bannerT>0){ bannerT-=dt; if(bannerT<=0) banner.style.display='none'; }
    requestAnimationFrame(loop); return;
  }
  // ── SQUIRE MATTHEW'S MISSION: the moment you're back on the overworld after
  //    casting down the pretender, and once the victory banners have played out,
  //    Matthew runs up with the King's plea to follow. Fires exactly once. ──
  if(bounties.matthewIntercept && place.kind==='overworld' && !dialogue.open && bannerT<=0){
    bounties.matthewIntercept=false;
    sayAs('Squire Matthew', [
      "Sir! SIR! Thank the Light I caught you \u2014 the Captain sent me running the moment the throne hall emptied!",
      "It's the Princess. The pretender... he didn't flee alone. He took her THROUGH one of those tears in the sky, out past the southern isles.",
      "The King is beside himself. He asks \u2014 he BEGS \u2014 that you follow. Three portals, three worlds between you and her.",
      "I'd come myself, but... my sword is mostly for pointing. (he points it, southward) That way, Sir Knight. Bring her home." ]);
    saveGame();
  }
  let dx=0,dy=0;
  const canMove = player.swing<=6 && !dialogue.open && !portalWarp && !skiff && !credits && !(place.kind==='abaddon' && abaddon.victory);  // frozen during dialogue + victory beat + portal warp
  if(canMove){
    // ⬡ EIGHT-WAY WALK: hold two directions and the knight moves diagonally. The
    //   old if/else chain allowed only one axis, which made every 45° stretch a
    //   per-tile zigzag. Facing still snaps to the 4 sprite directions, and the
    //   diagonal is normalised so it is not 41% faster than walking straight.
    //   (Set DIAG8=false to restore the original four-way walk.)
    if(DIAG8){
      if(held.up) dy=-1; else if(held.down) dy=1;
      if(held.left) dx=-1; else if(held.right) dx=1;
      if(dx&&dy){ const k=0.70710678; dx*=k; dy*=k; }
      if(dy<0) player.dir='up'; else if(dy>0) player.dir='down';
      else if(dx<0) player.dir='left'; else if(dx>0) player.dir='right';
    } else {
      if(held.up){dy=-1;player.dir='up';} else if(held.down){dy=1;player.dir='down';}
      else if(held.left){dx=-1;player.dir='left';} else if(held.right){dx=1;player.dir='right';}
    }
  }
  player.moving=!!(dx||dy);
  if(player.moving && shopMode) closeShop();   // walking away closes the shop menu
  if(player.moving && seedMode) closeSeedPicker();   // 🌱 walking away cancels the sowing
  if(player.moving && wagonMenu.open) closeWagonMenu();   // 🛒 walking away closes the wagon menu
  if(player.moving && tourneyMenu.open) closeTourneyMenu();
  if(player.moving){
    let spd = (player.mounted && petAbility()==='ride') ? SPEED*2 : (player.mounted ? SPEED*1.4 : SPEED);
    if(player.driving){ // 🛒 the wagon is quick on roads/bridges, slow on open ground
      const dtx=Math.floor((player.x+TILE/2)/TILE), dty=Math.floor((player.y+TILE/2)/TILE);
      const on=tileAt(dtx,dty); spd = (on===2||on===10||on===11||on===12) ? SPEED*1.5 : SPEED*0.85;
    }
    if(player.blocking) spd*=0.6;                        // braced behind the shield (still mobile)
    const nx=player.x+dx*spd*(dt/16), ny=player.y+dy*spd*(dt/16);
    const ctx0=Math.floor((player.x+TILE/2)/TILE), cty0=Math.floor((player.y+TILE/2)/TILE);
    const ntx=Math.floor((nx+TILE/2)/TILE), nty=Math.floor((ny+TILE/2)/TILE);
    // ⚙ walking into fallen rubble shoves it instead of stopping dead
    if(ntx!==ctx0 && !canStep(ctx0,cty0, ntx, cty0)) sunfallShove(ntx>ctx0?1:-1, 0);
    if(nty!==cty0 && !canStep(ctx0,cty0, ctx0, nty)) sunfallShove(0, nty>cty0?1:-1);
    if(playerCanStep(ctx0,cty0, ntx, cty0)) player.x=nx; else barrierNotice(ntx,cty0);
    if(playerCanStep(Math.floor((player.x+TILE/2)/TILE),cty0, Math.floor((player.x+TILE/2)/TILE), nty)) player.y=ny; else barrierNotice(Math.floor((player.x+TILE/2)/TILE),nty);
    player.ftick++; if(player.ftick%8===0) player.frame=(player.frame+1)%4;
    // ♪ movement sounds paced by distance covered, voiced by how you travel
    player._trav=(player._trav||0)+spd*(dt/16);
    const _sTick = player.driving?22 : player.mounted?16 : player.boating?9999 : 13;
    if(player._trav>=_sTick){ player._trav=0;
      if(player.driving) sfxWagon();
      else if(player.mounted) sfxHoof();
      else {
        const _ut=tileAt(Math.floor((player.x+TILE/2)/TILE), Math.floor((player.y+TILE/2)/TILE));
        if(place.kind==='overworld' && (_ut===32||_ut===12)) sfxStairStep();   // cut stone under boot
        else sfxStep();
      }
    }
    checkTransitions();
    if(place.kind==='overworld'){ lastOverworld.x=player.x; lastOverworld.y=player.y; }
    if(place.kind==='portalworld') tickFlock(dt);
  // 👑 leave the throne hall by walking off the bottom
    if(place.kind==='keep' && Math.floor((player.y+TILE/2)/TILE) >= THALL.H-1){ exitKeep(); }
  }
  // tabor's pack replenishes every frame, whether or not the knight is walking
  if(place.kind==='portalworld') tickTaborBeasts(dt);
  if(place.kind==='portalworld') tickTaborSummit(dt);
  if(place.kind==='portalworld') tickTaborLeisure(dt);
  if(place.kind==='portalworld' && portalWorld.id==='sunfall'){
    const _n=_octN(Math.floor((player.x+TILE/2)/TILE)-portalWorld.cx, Math.floor((player.y+TILE/2)/TILE)-portalWorld.cy);
    const _R=(portalWorld.rings||[]).find(q=>_n>=q.r0&&_n<=q.r1);
    if(_R && !sunfallProgress.tiers['t'+_R.ring]){ sunfallProgress.tiers['t'+_R.ring]=true; saveGame(); }
  }
  tickMadison(dt);
  if(place.kind==='portalworld') tickSunfallFerries(dt);
  if(place.kind==='portalworld') tickSunfallGloamings(dt);
  // the throne fight runs every frame, not only while the knight is walking
  if(place.kind==='interior' && _isSunLampId(place.id)) tickSunLamp();
  if(place.kind==='interior' && place.id==='vesper_cath') tickVesperCath(dt);
  if(place.kind==='interior' && place.id==='mistthrone'){
    if(!mistThrone.sceneStarted && !mistThrone.purified && (player.y/TILE)<8) throneTemptation();
    if(mistThrone.fighting) tickThroneBoss(dt);
    if(mistThrone.cine) tickThroneCine(dt);
    if(mistThrone.lastStand) tickThroneLastStand();
    if(mistThrone.release) tickStewardRelease(dt);
  }
  if(player.swing>0) player.swing--;
  if(player.iframes>0) player.iframes--;
  player.blocking = !!bBtn.down && gameplayB();
  if(player.dodgeCd>0) player.dodgeCd--;
  if(player.comboT>0){ player.comboT--; if(player.comboT<=0) player.combo=0; }
  if(player.specialFx>0) player.specialFx--;
  // pet trails behind the knight (overworld only, when not mounted)
  if(player.pet && place.kind==='overworld'){
    if(!player.petInit){ player.petX=player.x; player.petY=player.y; player.petInit=true; }
    const tx=player.x, ty=player.y, ddx=tx-player.petX, ddy=ty-player.petY, d=Math.hypot(ddx,ddy);
    if(d>TILE*1.1){ player.petX += ddx/d*Math.min(d-TILE*0.9, SPEED*1.2*(dt/16)); player.petY += ddy/d*Math.min(d-TILE*0.9, SPEED*1.2*(dt/16)); player.petMoving=true; }
    else player.petMoving=false;
  }
  // dash (dodge roll) movement — overrides normal movement while active
  if(player.dashing>0){ player.dashing--;
    const nx=player.x+player.dashx*(dt/16), ny=player.y+player.dashy*(dt/16);
    if(walkable(Math.floor((nx+TILE/2)/TILE), Math.floor((player.y+TILE/2)/TILE))) player.x=nx;
    if(walkable(Math.floor((player.x+TILE/2)/TILE), Math.floor((ny+TILE/2)/TILE))) player.y=ny;
  }
  // HOT SPRING healing: standing on tile 24 restores HP over time
  if(place.kind==='overworld'){
    const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
    if(WORLD[pty] && WORLD[pty][ptx]===24){
      if(player.hp < player.maxHp){ player.healAcc=(player.healAcc||0)+dt;
        if(player.healAcc>=120){ player.healAcc=0; player.hp=Math.min(player.maxHp, player.hp+Math.max(1,Math.round(2*player.healMult)));
          if(player.hp<player.maxHp || !player.springMsg){ showBanner('♨ The warm waters mend you...', 900); player.springMsg=true; } } }
      else if(!player.springFull){ showBanner('♨ Fully restored!', 1000); player.springFull=true; }
    } else { player.healAcc=0; player.springMsg=false; player.springFull=false; }
    // SECRET AREAS — stand on/near a secret tile to discover it
    const sptx=Math.floor((player.x+TILE/2)/TILE), spty=Math.floor((player.y+TILE/2)/TILE);
    for(const s of SECRETS){ if(secretsFound[s.id]) continue;
      if(Math.abs(sptx-s.x)<=1 && Math.abs(spty-s.y)<=1){ discoverSecret(s); break; }
    }
  }
  // villagers wander gently near their home spot (overworld only)
  if(place.kind==='overworld'){
    villagers.forEach(v=>{ 
      if(v.wait>0){ v.wait--; v.moving=false; return; }
      // pick a new nearby target tile occasionally
      const atTarget = Math.abs(v.x-v.tx*TILE)<1 && Math.abs(v.y-v.ty*TILE)<1;
      if(atTarget){ if(Math.random()<0.015){ const nx=v.hx+(Math.floor(Math.random()*5)-2), ny=v.hy+(Math.floor(Math.random()*5)-2);
          if(WALK.has(WORLD[ny]?.[nx])){ v.tx=nx; v.ty=ny; } } else { v.moving=false; if(Math.random()<0.02)v.wait=60+Math.random()*120; return; } }
      const tgx=v.tx*TILE, tgy=v.ty*TILE; const ddx=tgx-v.x, ddy=tgy-v.y;
      let mx=0,my=0; if(Math.abs(ddx)>Math.abs(ddy)){ mx=Math.sign(ddx); v.dir=mx<0?'left':'right'; } else if(ddy!==0){ my=Math.sign(ddy); v.dir=my<0?'up':'down'; }
      const sp=0.6; const nx=v.x+mx*sp, ny=v.y+my*sp;
      if(walkable(Math.floor((nx+TILE/2)/TILE),Math.floor((v.y+TILE/2)/TILE))) v.x=nx;
      if(walkable(Math.floor((v.x+TILE/2)/TILE),Math.floor((ny+TILE/2)/TILE))) v.y=ny;
      v.moving=!!(mx||my); v.ftick++; if(v.ftick%10===0) v.frame=(v.frame+1)%4;
    });
  }
  // ── fallen-knights: same chase/strike AI as overworld demons. Runs in the portal
  //    world AND in the throne hall, where the Pretender summons them mid-fight. ──
  if(place.kind==='portalworld' || (place.kind==='interior' && place.id==='mistthrone' && (mistThrone.fighting||mistThrone.lastStand)) || sunTowerCombat()){
    demons.forEach(d=>{ if(_frozen) return;
      if(d.pop){ d.pop.t--; if(d.pop.t<=0) d.pop=null; }
      if(d.dying>0){ d.dying--; return; }
      if(!d.alive) return; d.t++; if(d.hurt>0)d.hurt--;
      if(d.knock>0){ d.knock--;
        const nx=d.x+(d.kdx||0), ny=d.y+(d.kdy||0);
        if(walkable(Math.floor((nx+TILE/2)/TILE),Math.floor((d.y+TILE/2)/TILE))) d.x=nx;
        if(walkable(Math.floor((d.x+TILE/2)/TILE),Math.floor((ny+TILE/2)/TILE))) d.y=ny;
        return; }
      const ddx=player.x-d.x, ddy=player.y-d.y, dist=Math.hypot(ddx,ddy)||1;
      // guardians hold near their chapel until you come close; wanderers drift wider
      let vx=Math.cos(d.t*0.03)*0.22, vy=Math.sin(d.t*0.04)*0.22;
      // beasts are hunters: they scent the knight from much farther, and the night
      // forms run him down. Knights and demons keep their old ranges.
      const aggro = d.beast? (d.big? TILE*11 : TILE*8) : (d.nightBuff? TILE*7 : TILE*5);
      if(dist<aggro){ const sp = d.beast? (d.big?0.82:0.62) : (d.nightBuff?0.7:0.55); vx=ddx/dist*sp; vy=ddy/dist*sp; if(Math.abs(ddx)>Math.abs(ddy)) d.face=ddx<0?'left':'right'; else d.face=ddy<0?'up':'down'; }
      const nx=d.x+vx, ny=d.y+vy;
      if(walkable(Math.floor((nx+TILE/2)/TILE),Math.floor((d.y+TILE/2)/TILE))) d.x=nx;
      if(walkable(Math.floor((d.x+TILE/2)/TILE),Math.floor((ny+TILE/2)/TILE))) d.y=ny;
      if(dist<TILE*0.75 && player.iframes<=0){ let inc=Math.max(1,(d.atk||8)-player.def); inc=Math.max(1,Math.round(inc*(1-player.dmgReduce)));
        let kb=1.5, ifr=40;
        if(player.blocking){ inc=Math.max(1,Math.ceil(inc*0.1)); player.blockFlash=12; showBlockSpark(); kb=3.2; ifr=70; } else sfxHurt();
        player.hp=Math.max(0,player.hp-inc); player.iframes=ifr;
        d.x-=ddx/dist*TILE*kb; d.y-=ddy/dist*TILE*kb;
        scatterFollowers();
        if(player.hp<=0){ player.hp=player.maxHp; player.mounted=false;
          if(place.kind==='interior' && String(place.id||'').indexOf('sunlamp_')===0){
            // beaten in the tower: wake at its threshold; the captain keeps his stair
            demons=[]; const f=INTERIORS[place.id].floors[0];
            place={kind:'interior', id:place.id, floor:0};
            player.x=4*TILE; player.y=(f.h-2)*TILE; player.dir='up';
            showBanner('\ud83d\udcab You fall... and wake at the tower door. The Captain keeps his watch.', 2000);
          } else {
            const r=portalWorld.entry; player.x=r.x*TILE; player.y=r.y*TILE; player.dir='down';
            const gnm = portalWorld.id==='tabor' ? 'Tabor' : (portalWorld.id==='sunfall' ? 'Sunfall' : 'Mistral');
            showBanner('\ud83d\udcab You fall... and wake at the '+gnm+' gate, alive.', 1800);
          } } }
        // _legacy: single-line portalworld-only death (said 'Mistral gate' in every world)
    });
  }
  // demons (overworld only)
  if(place.kind==='overworld'){
    demons.forEach(d=>{ if(_frozen) return;
      if(d.pop){ d.pop.t--; if(d.pop.t<=0) d.pop=null; }
      if(d.dying>0){ d.dying--; return; }
      if(!d.alive)return; d.t++; if(d.hurt>0)d.hurt--;
      // a low growl when a demon closes in (per-demon cooldown keeps the world quiet)
      { const gd=Math.hypot(player.x-d.x, player.y-d.y);
        if(gd<TILE*3 && (!d._growlAt || performance.now()-d._growlAt>6000)){ d._growlAt=performance.now(); sfxDemonGrowl(d.level); } }
      // knockback takes priority over AI movement
      if(d.knock>0){ d.knock--;
        const nx=d.x+(d.kdx||0), ny=d.y+(d.kdy||0);
        if(walkable(Math.floor((nx+TILE/2)/TILE),Math.floor((d.y+TILE/2)/TILE))) d.x=nx;
        if(walkable(Math.floor((d.x+TILE/2)/TILE),Math.floor((ny+TILE/2)/TILE))) d.y=ny;
        return;
      }
      const ddx=player.x-d.x, ddy=player.y-d.y, dist=Math.hypot(ddx,ddy)||1;
      let vx=Math.cos(d.t*0.03)*0.25, vy=Math.sin(d.t*0.04)*0.25;
      if(dist<TILE*5){ vx=ddx/dist*0.6; vy=ddy/dist*0.6; }
      const nx=d.x+vx, ny=d.y+vy;
      if(walkable(Math.floor((nx+TILE/2)/TILE),Math.floor((d.y+TILE/2)/TILE))) d.x=nx;
      if(walkable(Math.floor((d.x+TILE/2)/TILE),Math.floor((ny+TILE/2)/TILE))) d.y=ny;
      if(dist<TILE*0.7 && player.iframes<=0){ let inc=Math.max(1,(d.atk||6)-player.def); inc=Math.max(1,Math.round(inc*(1-player.dmgReduce)));
        let kb=1.5, ifr=40;
        if(player.blocking){ inc=Math.max(1,Math.ceil(inc*0.1)); player.blockFlash=12; showBlockSpark(); kb=3.2; ifr=70; }   // shove it off, longer breather
        if(!player.blocking) sfxHurt();
        player.hp=Math.max(0,player.hp-inc); player.iframes=ifr;
        d.x-=ddx/dist*TILE*kb; d.y-=ddy/dist*TILE*kb;
        if(player.hp<=0){ player.hp=player.maxHp; player.mounted=false; player.x=32*TILE; player.y=24*TILE; place={kind:'overworld'}; returnStack=[]; showBanner('💫 You fall... and wake safe in Hearthvale.', 1600); } }
    });
  }
  // ── DUNGEON demons: regular ones guard their cell; the BOSS runs attack patterns ──
  if(place.kind==='dungeon'){
    const kcx=player.x+TILE/2, kcy=player.y+TILE/2;
    /* ── BOSS TUNING — the anti-facetank levers, all in one place ──
       dmgMult: global boss damage scale · iframes: grace after a boss hit
       novaRange: crowding a TELEGRAPHING boss this close triggers a point-blank
       burst when the move fires · hotRadius: contact range while winding up
       enrageDmg: damage scale below 35% HP (the enraged flag finally has teeth) */
    // damage ramps with the town's tier: the Shadow Imp is a lesson, the Hellgate
    // archfiend is an exam. (Early bosses lead with charges, which are the hardest
    // move to read — a brand-new knight shouldn't be walled by the first one.)
    const _tier=Math.max(0,Math.min(9, dungeon.townId|0));
    const BOSS_TUNE={ dmgMult:0.70+_tier*0.05, iframes:26, novaRange:TILE*1.9, novaShots:8, novaSpeed:2.6, novaLife:26, hotRadius:TILE*1.05, enrageDmg:1.4 };
    const hurtFromBoss=(dmg, pierce)=>{ if(player.iframes>0 && !pierce) return; dmg*=BOSS_TUNE.dmgMult; let inc=Math.max(1,Math.round((dmg-player.def*0.5)*(1-player.dmgReduce))); if(player.blocking){ inc=Math.max(1,Math.ceil(inc*0.1)); player.blockFlash=12; showBlockSpark(); } else sfxHurt(); player.hp=Math.max(0,player.hp-inc); player.iframes=BOSS_TUNE.iframes;
      if(player.hp<=0){ player.hp=player.maxHp; dungeon.projectiles=[]; dungeon.adds=[];
        // _legacy: leaveChapel() unconditionally — 'You fall... and wake safe
        //   outside the chapel.' A death cost the whole expedition, which was the
        //   decision until the chair by the fire existed. Resting there now marks
        //   the floor, and a fall below sends you back to it.
        const cp=dungeon.checkpoint;
        if(cp && cp.townId===dungeon.townId && dungeon.floors[cp.floorIdx]!==undefined){
          loadDungeonFloor(cp.floorIdx);
          showBanner('💫 You fall... and wake by the fire, where you last rested.', 2200);
        } else {
          leaveChapel(); showBanner('💫 You fall... and wake safe outside the chapel.', 1800);
        } } };
    demons.forEach(d=>{ if(_frozen) return;
      if(d.pop){ d.pop.t--; if(d.pop.t<=0) d.pop=null; }
      if(d.dying>0){ d.dying--; return; }
      if(!d.alive) return; d.t++; if(d.hurt>0)d.hurt--;
      // ── KNOCKBACK ── _legacy: if(d.knock>0){ d.knock--; if(!d.boss) return; }
      //   The timer ran down and the demon simply stood there absorbing the blow.
      //   applyDemonHit had already worked out kdx/kdy from the weapon (light 4,
      //   heavy 8, specials up to 14) and nothing in the dungeon ever used them,
      //   so a war hammer landed exactly like a short sword. Each axis is tested
      //   separately so a demon slides along a wall instead of stopping dead —
      //   and is never shoved into rock. A boss holds its ground: being shovable
      //   would break the telegraph-and-dodge rhythm the whole fight is built on.
      if(d.knock>0){ d.knock--;
        if(!d.boss){
          const nx=d.x+(d.kdx||0), ny=d.y+(d.kdy||0);
          if(walkable(Math.floor((nx+TILE/2)/TILE),Math.floor((d.y+TILE/2)/TILE))) d.x=nx;
          if(walkable(Math.floor((d.x+TILE/2)/TILE),Math.floor((ny+TILE/2)/TILE))) d.y=ny;
          d.kdx*=0.72; d.kdy*=0.72;                 // it slows as it tumbles
          return;
        }
      }
      const ddx=player.x-d.x, ddy=player.y-d.y, dist=Math.hypot(ddx,ddy)||1;
      const bcx=d.x+TILE/2, bcy=d.y+TILE/2;
      if(d.boss && d.pat){
        // ── BOSS state machine: idle → telegraph → strike ──
        if(d.state==='idle'){ d.timer--;
          d.x += (d.anchorx-d.x)*0.02; d.y += (d.anchory-d.y)*0.02;
          if(d.timer<=0){ const mv=d.pat.moves[d.moveIdx % d.pat.moves.length]; d.moveIdx++;
            // bosses speed up below half HP (enrage)
            const rage = d.hp < d.maxHp*0.5 ? 0.7 : 1;
            d.move=mv; d.kind=mv.kind; d.state='telegraph'; d.telegraph=Math.round(mv.telegraph*rage); d.telMax=d.telegraph; sfxBossTelegraph(); }
        }
        else if(d.state==='telegraph'){ d.telegraph--;
          if(d.kind==='charge'){ const m=Math.hypot(kcx-bcx,kcy-bcy)||1; d.aimx=(kcx-bcx)/m; d.aimy=(kcy-bcy)/m; }
          if(d.telegraph<=0){ const mv=d.move;
            sfxBossStrike();
            // ⚔ RETALIATION NOVA: stand at sword's length through a wind-up and the
            // strike erupts point-blank — melee is hit-and-run now, not a parking spot.
            if(dist < BOSS_TUNE.novaRange){
              for(let i=0;i<BOSS_TUNE.novaShots;i++){ const a=(i/BOSS_TUNE.novaShots)*Math.PI*2 + (d.moveIdx*0.4);
                dungeon.projectiles.push({x:bcx,y:bcy,vx:Math.cos(a)*BOSS_TUNE.novaSpeed,vy:Math.sin(a)*BOSS_TUNE.novaSpeed,life:BOSS_TUNE.novaLife,nova:true}); } }
            if(mv.kind==='volley'){ const baseA=Math.atan2(kcy-bcy,kcx-bcx);
              for(let i=0;i<mv.count;i++){ const a=baseA+(i-(mv.count-1)/2)*0.18; dungeon.projectiles.push({x:bcx,y:bcy,vx:Math.cos(a)*mv.speed,vy:Math.sin(a)*mv.speed,life:150}); }
              d.state='idle'; d.timer=44; }
            else if(mv.kind==='spread'){ for(let i=0;i<mv.count;i++){ const a=(i/mv.count)*Math.PI*2; dungeon.projectiles.push({x:bcx,y:bcy,vx:Math.cos(a)*mv.speed,vy:Math.sin(a)*mv.speed,life:150}); } d.state='idle'; d.timer=48; }
            else if(mv.kind==='charge'){ d.state='charge'; d.timer=26; d.chx=d.aimx*mv.speed; d.chy=d.aimy*mv.speed; }
            else if(mv.kind==='slam'){ d.state='slam'; d.timer=16; d.ring=0; d.anchorx=d.x; d.anchory=d.y; }
            else if(mv.kind==='summon'){ const lv=d.level; for(let i=0;i<2;i++){ const ax=Math.max(TILE,Math.min((DW-2)*TILE, d.x+(i?TILE*2:-TILE*2)));
                dungeon.adds.push({x:ax,y:d.y,hp:8+lv,maxHp:8+lv,level:Math.max(1,lv-4),alive:true,speed:1.3,add:true}); } d.state='idle'; d.timer=58; }
            else { d.state='idle'; d.timer=50; }
          }
        }
        else if(d.state==='charge'){ d.x+=d.chx; d.y+=d.chy; d.timer--;
          if(d.x<TILE){d.x=TILE;d.chx*=-1;} if(d.x>(DW-2)*TILE){d.x=(DW-2)*TILE;d.chx*=-1;}
          if(d.y<TILE){d.y=TILE;d.chy*=-1;} if(d.y>(DH-2)*TILE){d.y=(DH-2)*TILE;d.chy*=-1;}
          if(Math.hypot(kcx-(d.x+TILE/2),kcy-(d.y+TILE/2))<TILE*0.8) hurtFromBoss((7+d.level*1.1)*(d.enraged?BOSS_TUNE.enrageDmg:1));
          if(d.timer<=0){ d.state='idle'; d.timer=40; }
        }
        else if(d.state==='slam'){ d.timer--;
          if(d.timer<=0 && d.ring===0){ d.ring=1; d.ringR=0; }
          if(d.ring){ d.ringR += (d.move.ringSpeed||4); const rd=Math.hypot(kcx-(d.x+TILE/2),kcy-(d.y+TILE/2));
            if(Math.abs(rd-d.ringR)<TILE*0.5) hurtFromBoss((5+d.level*1.0)*(d.enraged?BOSS_TUNE.enrageDmg:1));
            if(d.ringR>(d.move.ringMax||120)){ d.ring=0; d.state='idle'; d.timer=42; } }
        }
        // contact damage — the radius runs HOT while the boss winds up a strike
        const cr = d.state==='telegraph' ? BOSS_TUNE.hotRadius : TILE*0.7;
        if(dist<cr) hurtFromBoss((5+d.level*0.85)*(d.enraged?BOSS_TUNE.enrageDmg:1));
      } else {
        // ── WANDERING maze demon: patrols corridors, chases when it spots you ──
        const chase = dist < TILE*4.5;
        let mvx, mvy;
        if(chase){ // close in axis-aligned (slides along walls via per-axis checks)
          if(Math.abs(ddx)>Math.abs(ddy)){ mvx=Math.sign(ddx)*0.62; mvy=Math.sign(ddy)*0.2; }
          else { mvy=Math.sign(ddy)*0.62; mvx=Math.sign(ddx)*0.2; }
        } else {
          // ── HOLD A PATCH ── A straight-line patrol that re-picks at every wall
          //    eventually walks the whole floor, which is what made a "patrol" a
          //    slow migration. Beyond PATROL_R of its post it turns back, and the
          //    clamp below refuses any step that takes it further out — steering
          //    alone is not enough, because the way home is rarely a straight line.
          mvx=d.pdx*0.45; mvy=d.pdy*0.45;
          if(d.patrol && d.patrol<99){
            const hx=d.dtx*TILE, hy=d.dty*TILE;
            if(Math.hypot(d.x-hx,d.y-hy)>d.patrol*TILE){
              if(Math.abs(hx-d.x)>Math.abs(hy-d.y)){ d.pdx=Math.sign(hx-d.x)||1; d.pdy=0; }
              else { d.pdy=Math.sign(hy-d.y)||1; d.pdx=0; }
              mvx=d.pdx*0.45; mvy=d.pdy*0.45;
            }
          }
        }
        const nx=d.x+mvx, ny=d.y+mvy;
        let okX=walkable(Math.floor((nx+TILE/2)/TILE),Math.floor((d.y+TILE/2)/TILE));
        let okY=walkable(Math.floor((d.x+TILE/2)/TILE),Math.floor((ny+TILE/2)/TILE));
        if(!chase && d.patrol && d.patrol<99){
          const hx=d.dtx*TILE, hy=d.dty*TILE;
          if(Math.hypot(d.x-hx,d.y-hy)>d.patrol*TILE){
            if(Math.abs(nx-hx)>Math.abs(d.x-hx)) okX=false;
            if(Math.abs(ny-hy)>Math.abs(d.y-hy)) okY=false;
          }
        }
        if(okX) d.x=nx; if(okY) d.y=ny;
        if(!chase && (!okX && !okY || ((d.pdx&&!okX)||(d.pdy&&!okY)))){
          // hit a wall on patrol — pick a new open direction at this junction
          const tx2=Math.floor((d.x+TILE/2)/TILE), ty2=Math.floor((d.y+TILE/2)/TILE);
          const opts=[[1,0],[-1,0],[0,1],[0,-1]].filter(([ox,oy])=>walkable(tx2+ox,ty2+oy));
          if(opts.length){ const [ox,oy]=opts[Math.floor(Math.random()*opts.length)]; d.pdx=ox; d.pdy=oy; }
        }
        if(dist<TILE*0.75) hurtFromBoss(7+d.level*0.6);
      }
    });
    // boss projectiles
    dungeon.projectiles.forEach(p=>{ if(_frozen) return; p.x+=p.vx; p.y+=p.vy; p.life--;
      if(p.x<TILE*0.4||p.x>(DW-0.4)*TILE||p.y<TILE*0.4||p.y>(DH-0.4)*TILE) p.life=0;
      if(p.life>0 && Math.hypot(p.x-kcx,p.y-kcy)<TILE*0.5){ p.life=0;
        const tl=TOWN_DATA[dungeon.townId].lvl;
        // the retaliation burst PIERCES the grace window: contact damage fires earlier
        // in the same frame and used to eat the i-frames, so the nova never landed at
        // all. Crowding a wind-up is meant to hurt — an ordinary volley shot doesn't pierce.
        if(p.nova) hurtFromBoss(12+tl*2.4, true); else hurtFromBoss(4+tl*0.9); } });
    dungeon.projectiles=dungeon.projectiles.filter(p=>p.life>0);
    // summoned adds chase the player; killable by attacks (handled in resolveSwing via demons[]) — here just movement+contact
    dungeon.adds.forEach(a=>{ if(_frozen) return; if(!a.alive)return; const acx=a.x+TILE/2,acy=a.y+TILE/2; const m=Math.hypot(kcx-acx,kcy-acy)||1;
      a.x+=(kcx-acx)/m*a.speed; a.y+=(kcy-acy)/m*a.speed; if(a.hurt>0)a.hurt--;
      if(Math.hypot(kcx-acx,kcy-acy)<TILE*0.7) hurtFromBoss(4+a.level*0.7); });
    dungeon.adds=dungeon.adds.filter(a=>a.alive);
  }
  // ── ABADDON final battle update ──
  if(place.kind==='abaddon' && abaddon.active){
    const b=abaddon; if(b.intro>0) b.intro--;
    const kcx=player.x+TILE/2, kcy=player.y+TILE/2, bcx=b.x+TILE/2, bcy=b.y+TILE/2;
    if(b.hurt>0)b.hurt--;
    // phase transitions
    const ph=abaddonPhaseFor();
    if(ph>b.phase){ b.phase=ph; const P=bossCfg().phases[ph]; b.state='idle'; b.timer=70; b.shield=false; b.projectiles=[];
      showBanner(`👑 <b style="color:${P.color}">${P.name}</b><br><span style="font-size:7px">${P.taunt}</span>`, 3200); }
    const P=bossCfg().phases[b.phase];
    // shrinking safe zone in later phases (creeping shadow narrows the arena)
    const targetShrink = b.phase===0?0 : b.phase===1?1.2 : 2.2;
    b.shrink += (targetShrink-b.shrink)*0.01;
    if(b.shrink>0.3){ const m=b.shrink*TILE; // damage if knight is in the shadow margin
      if(player.iframes<=0 && (player.x<m || player.y<m || player.x>(ABADDON_W*TILE-m-TILE) || player.y>(ABADDON_H*TILE-m-TILE))) abaddonHurtKnight(30+b.phase*10); }
    if(b.intro<=0 && !b.dead){
      if(b.state==='idle'){ b.timer--;
        b.x += (b.anchorx-b.x)*0.02; b.y += (b.anchory-b.y)*0.02;
        // drift the anchor side to side
        b.anchorx = (ABADDON_W/2|0)*TILE + Math.sin(Date.now()*0.0006)*TILE*3;
        if(b.timer<=0){ const mv=P.moves[b.moveIdx % P.moves.length]; b.moveIdx++;
          const rage = b.hp<b.maxHp*0.15 ? 0.65 : 1;
          b.move=mv; b.kind=mv.kind; b.state='telegraph'; b.telegraph=Math.round(mv.telegraph*rage); b.telMax=b.telegraph; sfxBossTelegraph(); }
      }
      else if(b.state==='telegraph'){ b.telegraph--;
        if(b.kind==='charge'){ const m=Math.hypot(kcx-bcx,kcy-bcy)||1; b.aimx=(kcx-bcx)/m; b.aimy=(kcy-bcy)/m; }
        if(b.telegraph<=0){ const mv=b.move;
          sfxBossStrike();
          // ⚔ RETALIATION NOVA — crowd the Destroyer through a wind-up and the
          // strike erupts point-blank. Melee him in the openings, not on the swing.
          if(Math.hypot(kcx-bcx,kcy-bcy) < TILE*2.0){
            for(let i=0;i<10;i++){ const a=(i/10)*Math.PI*2 + b.moveIdx*0.4;
              b.projectiles.push({x:bcx,y:bcy,vx:Math.cos(a)*2.8,vy:Math.sin(a)*2.8,life:26,nova:true}); } }
          if(mv.kind==='volley'){ const baseA=Math.atan2(kcy-bcy,kcx-bcx); for(let i=0;i<mv.count;i++){ const a=baseA+(i-(mv.count-1)/2)*0.16; b.projectiles.push({x:bcx,y:bcy,vx:Math.cos(a)*mv.speed,vy:Math.sin(a)*mv.speed,life:200}); } b.state='idle'; b.timer=40; }
          else if(mv.kind==='spread'){ const off=Math.random()*0.5; for(let i=0;i<mv.count;i++){ const a=off+(i/mv.count)*Math.PI*2; b.projectiles.push({x:bcx,y:bcy,vx:Math.cos(a)*mv.speed,vy:Math.sin(a)*mv.speed,life:200}); } b.state='idle'; b.timer=42; }
          else if(mv.kind==='charge'){ b.state='charge'; b.timer=28; b.chx=b.aimx*mv.speed; b.chy=b.aimy*mv.speed; }
          else if(mv.kind==='slam'){ b.state='slam'; b.timer=16; b.ring=0; b.anchorx=b.x; b.anchory=b.y; }
          else if(mv.kind==='shield'){ // become invulnerable until adds are destroyed
            b.shield=true; for(let i=0;i<3;i++){ const ax=TILE*2+Math.random()*(ABADDON_W-4)*TILE; const ay=TILE*2+Math.random()*(ABADDON_H-5)*TILE;
              b.adds.push({x:ax,y:ay,hp:14+b.phase*6,maxHp:14+b.phase*6,level:20,alive:true,speed:1.3+b.phase*0.2,add:true,hurt:0}); }
            showBanner('🛡️ Abaddon shields himself! <span style="font-size:7px">Destroy his summoned shades to break it!</span>', 2400); b.state='idle'; b.timer=50; }
          else { b.state='idle'; b.timer=46; }
        }
      }
      else if(b.state==='charge'){ b.x+=b.chx; b.y+=b.chy; b.timer--;
        if(b.x<TILE){b.x=TILE;b.chx*=-1;} if(b.x>(ABADDON_W-2)*TILE){b.x=(ABADDON_W-2)*TILE;b.chx*=-1;}
        if(b.y<TILE){b.y=TILE;b.chy*=-1;} if(b.y>(ABADDON_H-2)*TILE){b.y=(ABADDON_H-2)*TILE;b.chy*=-1;}
        if(Math.hypot(kcx-(b.x+TILE/2),kcy-(b.y+TILE/2))<TILE*0.85) abaddonHurtKnight(46+b.phase*12);
        if(b.timer<=0){ b.state='idle'; b.timer=38; b.anchorx=(ABADDON_W/2|0)*TILE; b.anchory=1.5*TILE; }
      }
      else if(b.state==='slam'){ b.timer--;
        if(b.timer<=0 && b.ring===0){ b.ring=1; b.ringR=0; }
        if(b.ring){ b.ringR += (b.move.ringSpeed||5); const rd=Math.hypot(kcx-(b.x+TILE/2),kcy-(b.y+TILE/2));
          if(Math.abs(rd-b.ringR)<TILE*0.55) abaddonHurtKnight(40+b.phase*12);
          if(b.ringR>(b.move.ringMax||150)){ b.ring=0; b.state='idle'; b.timer=40; } }
      }
      // contact
      if(Math.hypot(kcx-bcx,kcy-bcy)<TILE*0.8) abaddonHurtKnight(36+b.phase*10);
    }
    // projectiles
    b.projectiles.forEach(p=>{ if(_frozen) return; p.x+=p.vx; p.y+=p.vy; p.life--;
      if(p.x<0||p.x>ABADDON_W*TILE||p.y<0||p.y>ABADDON_H*TILE) p.life=0;
      if(p.life>0 && Math.hypot(p.x-kcx,p.y-kcy)<TILE*0.5){ p.life=0;
        // the retaliation burst pierces the grace window; ordinary shots don't
        if(p.nova) abaddonHurtKnight(95+b.phase*25, true); else abaddonHurtKnight(32+b.phase*10); } });
    b.projectiles=b.projectiles.filter(p=>p.life>0);
    // adds chase; destroying all breaks the shield
    b.adds.forEach(a=>{ if(_frozen) return; if(!a.alive)return; const acx=a.x+TILE/2,acy=a.y+TILE/2,m=Math.hypot(kcx-acx,kcy-acy)||1;
      a.x+=(kcx-acx)/m*a.speed; a.y+=(kcy-acy)/m*a.speed; if(a.hurt>0)a.hurt--;
      if(Math.hypot(kcx-acx,kcy-acy)<TILE*0.7) abaddonHurtKnight(28+b.phase*8); });
    b.adds=b.adds.filter(a=>a.alive);
    if(b.shield && b.adds.length===0){ b.shield=false; showBanner('🛡️💥 The shield shatters! Strike Abaddon now!', 1800); }
  }
  // 👑 the victory beat plays out in the arena after the killing blow
  if(place.kind==='abaddon' && abaddon.victory) abaddonVictoryTick(dt);
  // ── CROPS grow over time (advance through 4 stages) ──
  // _legacy: every crop shared the single CROP_GROW_MS rate. Each kind now
  // ripens at its own pace — mustard quick, the vine slow.
  for(const key in crops){ const c=crops[key];
    if(c.stage<3){ const elapsed=ts-c.plantedAt; const st=Math.min(3, Math.floor(elapsed/cropGrowMs(c)));
      if(st!==c.stage){ c.stage=st; if(st===3){ const[cxx,cyy]=key.split(',').map(Number); const C=cropOf(c);
        if(place.kind==='overworld' && Math.hypot(player.x-cxx*TILE,player.y-cyy*TILE)<TILE*12) showBanner(`${C.emoji} <b>${C.name} is ripe for harvest!</b>`, 1300); } } }
  }
  // ── FISHING cast timer ──
  if(fishing){
    fishing.t++;
    // cancel if you walk away from the water you cast into
    const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
    if(Math.abs(ptx-fishing.fx)>2 || Math.abs(pty-fishing.fy)>2){ fishing=null; }
    else if(fishing.phase==='wait' && fishing.t>=fishing.biteAt){ fishing.phase='bite'; fishing.t=0; sfxBite(); showBanner('❗ A bite! Press Ⓐ to reel it in!', 1500); }
    else if(fishing.phase==='bite' && fishing.t>45){ sfxFishAway(); showBanner('🎣 The fish got away...', 1100); fishing=null; }  // ~0.75s window
  }
  if(bannerT>0){ bannerT-=dt; if(bannerT<=0) banner.style.display='none'; }
  document.getElementById('loc').textContent = regionName();
  let carried=0; for(const it in inventory) carried+=inventory[it];

  if(player.mounted && place.kind!=='overworld') player.mounted=false;
  if(player.boating && place.kind!=='overworld') player.boating=false;
  updateMountBtn();
  // ── HUD: only what you must read mid-swing. Phase + clock stay because night
  //    demons make the hour tactical; the combo pip stays because you cannot
  //    open a menu inside a 0.8s chaining window. Lv / XP / gold / bag are
  //    lookups, not glances — they live in the ☰ Character tab.
  //    (_legacy line kept below for instant revert.)
  //  document.getElementById('hint').textContent = `${phaseIcon()} ${clockHHMM()} · Lv ${player.level} · ❤ ${player.hp}/${player.maxHp} · ✦ ${player.xp}/${player.xpNext} · 🪙 ${gold}` + comboStr + (carried?` · 🎒 ${carried}`:'');
  setHudHint(`${phaseIcon()} ${clockHHMM()}`, player.combo);
  document.getElementById('hpbar').style.width = (player.hp/player.maxHp*100)+'%';
  tickArrows();
  draw();
  drawMinimap();
  requestAnimationFrame(loop);
}

// ════════════════════════════════════════════════════════════════
//  MINIMAP — a downscaled overview with towns + player position
// ════════════════════════════════════════════════════════════════
let _miniBase=null;   // pre-rendered static world (built once)
const MINI_TOWNS=[
  ['Hearthvale',33,22],['Homestead',108,18],['Ironhold',31,63],['Saltmere',33,210],
  ['Thornwood',91,157],['Dusthaven',92,69],['Crystalpeak',153,68],['Ashfield',158,150],
  ['Stormgate',172,213],['Shadowmere',217,147],['Hellgate',225,19]
];
function buildMiniBase(){
  const off=document.createElement('canvas'); off.width=WORLD_W; off.height=WORLD_H;
  const o=off.getContext('2d');
  // color per tile family
  const COL={0:'#5fa860',2:'#bd9a5e',3:'#2f5a86',4:'#78b46e',5:'#6b6275',6:'#b9b2a4',7:'#3f8a4e',
    8:'#bd9a5e',19:'#e8d6a0',20:'#5fb0c8',21:'#3f8ec0',22:'#eaf2f7',23:'#bfe0ec',24:'#7fcad8',
    25:'#6a6258',26:'#ff6a1a',27:'#5a4a42',28:'#3a4038',30:'#788a8a',31:'#6b4a2e',32:'#eef4f8',33:'#6e6a78',34:'#dfeaf2',36:'#6e4a2c',37:'#6e4a2c',38:'#6e4a2c'};
  for(let y=0;y<WORLD_H;y++)for(let x=0;x<WORLD_W;x++){ const t=WORLD[y][x]; o.fillStyle=COL[t]||'#5fa860'; o.fillRect(x,y,1,1); }
  _miniBase=off;
}
// ── THE WORLD MAP (☰ → Map): fog-of-war chart of Luminar ──
function initBigMap(){
  const mc=document.getElementById('bigmap'); if(!mc) return;
  if(!_miniBase) buildMiniBase();
  const g=mc.getContext('2d'); g.imageSmoothingEnabled=false;
  // _legacy: the sea beyond the map was '#0a0712' and the fog 'rgba(7,4,13,0.97)'
  //   — near-black holes punched in a parchment sheet. On a chart, unexplored
  //   land isn't absent, it's undrawn: the ink simply hasn't reached it. So the
  //   fog is now a warm shadow ON the sheet, and walking it lifts the shade
  //   rather than switching a light on.
  g.fillStyle='#c8b78e'; g.fillRect(0,0,WORLD_W,WORLD_H);
  g.drawImage(_miniBase,0,0);
  // FOG: until Abaddon falls, lands you haven't walked stay unlettered
  if(!abaddon.won){
    const CW=Math.ceil(WORLD_W/CHUNK), CH=Math.ceil(WORLD_H/CHUNK);
    for(let cy=0;cy<CH;cy++)for(let cx=0;cx<CW;cx++){
      if(explored.has(cx+','+cy)) continue;
      // a chunk touching explored ground is half-shaded, so the edge of what
      // you know reads as a soft margin instead of a cut line
      const edge = explored.has((cx-1)+','+cy) || explored.has((cx+1)+','+cy)
                || explored.has(cx+','+(cy-1)) || explored.has(cx+','+(cy+1));
      g.fillStyle = edge ? 'rgba(156,133,96,0.72)' : 'rgba(156,133,96,0.94)';
      g.fillRect(cx*CHUNK,cy*CHUNK,CHUNK,CHUNK);
    }
  }
  const vis=(tx,ty)=> abaddon.won || explored.has(Math.floor(tx/CHUNK)+','+Math.floor(ty/CHUNK));
  // town markers — only where the fog has lifted
  MINI_TOWNS.forEach(([name,tx,ty])=>{ if(!vis(tx,ty)) return;
    const ti=TOWN_DATA.findIndex(t=>t.name===name);
    const col = ti<0 ? '#ffe04a' : (chapelProgress[ti] ? '#6fdf8a' : '#ff6a7a');
    g.fillStyle='#1a1410'; g.fillRect(tx-3,ty-3,7,7);
    g.fillStyle=col;       g.fillRect(tx-2,ty-2,5,5);
    g.fillStyle='#fff';    g.fillRect(tx,ty,1,1);
  });
  // the knight — a red marker with a white core
  const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
  // _legacy: a WHITE 7x7 ring with red inside — white read fine on the old
  //   near-black map but measures ~1.8 against parchment land, so the knight
  //   lost his outline. Dark ring like the towns, with a white core to pick him
  //   out from them.
  g.fillStyle='#1a1410'; g.fillRect(ptx-3,pty-3,7,7);
  g.fillStyle='#c0271f'; g.fillRect(ptx-2,pty-2,5,5);
  g.fillStyle='#fff';    g.fillRect(ptx,pty,1,1);
  // hover / tap a town for its name (green = cleansed, red = still bound)
  const tip=document.getElementById('maptip');
  const pick=(ev)=>{
    const r=mc.getBoundingClientRect();
    const px2=((ev.touches?ev.touches[0].clientX:ev.clientX)-r.left)/r.width*WORLD_W;
    const py2=((ev.touches?ev.touches[0].clientY:ev.clientY)-r.top)/r.height*WORLD_H;
    let best=null, bd=14;
    MINI_TOWNS.forEach(([name,tx,ty])=>{ if(!vis(tx,ty)) return;
      const d=Math.hypot(tx-px2,ty-py2); if(d<bd){ bd=d; best=[name,tx,ty]; } });
    if(!best){ tip.style.display='none'; return; }
    const ti=TOWN_DATA.findIndex(t=>t.name===best[0]);
    const done = ti<0 ? null : !!chapelProgress[ti];
    tip.textContent = best[0] + (done===null ? '' : (done ? ' ✓ cleansed' : ' ✗ bound'));
    const col = done===null ? '#ffe04a' : (done ? '#6fdf8a' : '#ff6a7a');
    tip.style.color=col; tip.style.borderColor=col;
    tip.style.left=(best[1]/WORLD_W*100)+'%';
    tip.style.top =(best[2]/WORLD_H*100)+'%';
    tip.style.transform='translate(-50%,-150%)';
    tip.style.display='block';
  };
  mc.addEventListener('mousemove',pick);
  mc.addEventListener('click',pick);
  mc.addEventListener('touchstart',pick,{passive:true});
  mc.addEventListener('mouseleave',()=>{ tip.style.display='none'; });
}
function drawMinimap(){
  const mc=document.getElementById('minimap'); if(!mc) return;
  if(place.kind!=='overworld'){ mc.style.display='none'; return; } mc.style.display='block';
  revealAround();                                    // walking the land lifts the map fog
  const g=mc.getContext('2d');
  if(!_miniBase) buildMiniBase();
  const W=mc.width, H=mc.height;
  g.imageSmoothingEnabled=false;
  // view window: follow player, show a region around them (zoomed overview)
  const span=120;  // tiles shown across the minimap
  let px0 = Math.floor((player.x/TILE) - span/2), py0 = Math.floor((player.y/TILE) - span/2);
  px0 = Math.max(0, Math.min(WORLD_W-span, px0)); py0 = Math.max(0, Math.min(WORLD_H-span, py0));
  g.clearRect(0,0,W,H);
  g.drawImage(_miniBase, px0, py0, span, span, 0, 0, W, H);
  const sc=W/span;
  // town markers
  g.font='6px monospace'; g.textAlign='center';
  for(const [name,tx,ty] of MINI_TOWNS){ const mx=(tx-px0)*sc, my=(ty-py0)*sc;
    if(mx<0||my<0||mx>W||my>H) continue;
    g.fillStyle='#ffe04a'; g.fillRect(mx-1.5,my-1.5,3,3); g.fillStyle='#1a1410'; g.fillRect(mx-0.5,my-0.5,1,1);
  }
  // player dot (pulsing)
  const pmx=(player.x/TILE-px0)*sc, pmy=(player.y/TILE-py0)*sc;
  g.fillStyle='#ff4a4a'; g.beginPath(); g.arc(pmx,pmy,2.4,0,7); g.fill();
  g.strokeStyle='#fff'; g.lineWidth=0.8; g.beginPath(); g.arc(pmx,pmy,2.4,0,7); g.stroke();
}

// ════════════════════════════════════════════════════════════════
//  RENDERING — ground tiles + faked-3D buildings + sprites
// ════════════════════════════════════════════════════════════════
function px(x,y,w,h,c){ ctx.fillStyle=c; ctx.fillRect(x,y,w,h); }
// ══ CROP SPRITES ── one body per kind, four stages each. Approved as a rendered
//    mockup against the real tilled-soil tile before any of this was wired in.
//    Grapes are outlined because ripe purple measures 1.01 contrast against
//    #6b4a2e soil — identical luminance, i.e. invisible — and no recognisable
//    purple clears 4.0. The dark ring plus a bright specular carries the read.
function drawCrop_wheat(x,y,s){
  if (s === 0) { px(x + 6, y + 10, 4, 3, '#5a3e26'); px(x + 7, y + 9, 2, 1, '#3a8a4a'); return; }
  if (s === 1) { px(x + 7, y + 7, 2, 6, '#3a8a4a'); px(x + 5, y + 9, 2, 2, '#46a05a'); px(x + 9, y + 9, 2, 2, '#46a05a'); return; }
  if (s === 2) { for (const dx of [3, 7, 11]) { px(x + dx, y + 5, 1, 8, '#3a8a4a'); px(x + dx - 1, y + 6, 1, 2, '#46a05a'); } return; }
  for (const dx of [3, 7, 11]) { px(x + dx, y + 3, 1, 10, '#c8a83a'); px(x + dx - 1, y + 3, 3, 3, '#e8d068'); px(x + dx - 1, y + 4, 1, 1, '#a8842a'); }
}
function drawCrop_mustard(x,y,s){
  if (s === 0) { px(x + 7, y + 11, 2, 2, '#5a3e26'); px(x + 8, y + 11, 1, 1, '#7aa84a'); return; }
  if (s === 1) { px(x + 8, y + 8, 1, 5, '#4a8a3a'); px(x + 7, y + 9, 1, 1, '#6aba4a'); px(x + 9, y + 10, 1, 1, '#6aba4a'); return; }
  if (s === 2) {
    px(x + 8, y + 5, 1, 8, '#3a8a3a');
    px(x + 5, y + 7, 3, 2, '#4aa04a'); px(x + 9, y + 8, 3, 2, '#4aa04a');
    px(x + 6, y + 10, 2, 2, '#3f9040'); px(x + 9, y + 11, 2, 1, '#3f9040');
    px(x + 8, y + 4, 1, 1, '#f2d24e');
    return;
  }
  // stage 3 — the herb. Branching, wide, crowned with yellow flower clusters.
  px(x + 7, y + 4, 2, 9, '#2f7a34');                       // trunk
  px(x + 3, y + 6, 4, 1, '#2f7a34'); px(x + 9, y + 5, 4, 1, '#2f7a34');  // boughs
  px(x + 2, y + 7, 4, 3, '#3f9a44'); px(x + 10, y + 6, 4, 3, '#3f9a44'); // foliage
  px(x + 2, y + 9, 12, 3, '#4aad4e');                      // the canopy, tile-wide
  px(x + 0, y + 8, 2, 3, '#3f9a44'); px(x + 14, y + 7, 2, 3, '#3f9a44');
  px(x + 3, y + 12, 10, 1, '#2f7a34');
  // “and the birds of the air come and lodge in the branches thereof” — Matt 13:32
  px(x + 11, y + 1, 3, 2, '#3a3a4a'); px(x + 10, y + 2, 1, 1, '#3a3a4a');
  px(x + 13, y + 1, 1, 1, '#e8d068'); px(x + 12, y + 0, 1, 1, '#4a4a5e');
  // flower crowns
  px(x + 6, y + 1, 4, 3, '#f2d24e'); px(x + 7, y + 0, 2, 1, '#ffe98a');
  px(x + 1, y + 5, 3, 2, '#f2d24e'); px(x + 2, y + 4, 1, 1, '#ffe98a');
  px(x + 12, y + 3, 3, 2, '#f2d24e'); px(x + 13, y + 2, 1, 1, '#ffe98a');
  px(x + 7, y + 2, 1, 1, '#c8a02e'); px(x + 2, y + 6, 1, 1, '#c8a02e');
}
function drawCrop_barley(x,y,s){
  if (s === 0) { px(x + 6, y + 10, 4, 3, '#5a3e26'); px(x + 7, y + 9, 2, 1, '#6a9a4a'); return; }
  if (s === 1) { px(x + 7, y + 8, 2, 5, '#5a9a4a'); px(x + 5, y + 10, 2, 2, '#6aae5a'); px(x + 9, y + 10, 2, 2, '#6aae5a'); return; }
  if (s === 2) { for (const dx of [4, 8, 12]) { px(x + dx, y + 7, 1, 6, '#5a9a4a'); px(x + dx - 1, y + 8, 1, 2, '#6aae5a'); } return; }
  for (const dx of [3, 7, 11]) {
    px(x + dx, y + 6, 1, 7, '#b8a86a');                    // stalk
    px(x + dx - 1, y + 6, 3, 4, '#d8c88a');                // head (short, fat)
    px(x + dx - 1, y + 7, 1, 1, '#9a8a4a'); px(x + dx + 1, y + 8, 1, 1, '#9a8a4a');
    px(x + dx - 2, y + 3, 1, 3, '#e0d4a0');                // awns splaying out
    px(x + dx, y + 2, 1, 4, '#e0d4a0');
    px(x + dx + 2, y + 3, 1, 3, '#e0d4a0');
  }
}
function drawCrop_grapes(x,y,s){
  if (s === 0) { px(x + 6, y + 10, 4, 3, '#5a3e26'); px(x + 7, y + 9, 2, 1, '#4a8a4a'); return; }
  if (s === 1) {
    px(x + 11, y + 4, 1, 9, '#7a5a3a');                    // the stake goes in early
    px(x + 7, y + 8, 1, 5, '#3a8a4a');
    px(x + 8, y + 8, 2, 1, '#46a05a'); px(x + 6, y + 10, 1, 1, '#46a05a');
    return;
  }
  if (s === 2) {
    px(x + 11, y + 3, 1, 10, '#7a5a3a');
    px(x + 6, y + 5, 1, 8, '#5a7a3a');                     // vine climbing
    px(x + 7, y + 5, 4, 1, '#5a7a3a');
    px(x + 3, y + 6, 3, 3, '#3f9a44'); px(x + 7, y + 7, 3, 3, '#3f9a44');
    px(x + 4, y + 10, 3, 2, '#4aad4e');
    px(x + 12, y + 6, 2, 1, '#5a7a3a');                    // tendril
    return;
  }
  px(x + 11, y + 2, 1, 11, '#7a5a3a'); px(x + 10, y + 2, 3, 1, '#8a6a44');
  px(x + 5, y + 3, 1, 10, '#5a7a3a'); px(x + 6, y + 3, 5, 1, '#5a7a3a');
  px(x + 2, y + 4, 4, 3, '#3f9a44'); px(x + 12, y + 4, 3, 3, '#3f9a44');
  px(x + 2, y + 5, 1, 1, '#2f7a34'); px(x + 13, y + 5, 1, 1, '#2f7a34');
  // the cluster — OUTLINED. Measured: #6a3a8a against #6b4a2e soil is 1.01
  // contrast, i.e. identical luminance, so a ripe cluster vanishes into the
  // dirt at 16px. No recognisable purple clears 4.0 (best case 3.70, and by
  // then it reads lilac), so readability comes from a dark ring + specular.
  px(x + 4, y + 5, 8, 9, '#241038');                       // outline
  px(x + 6, y + 6, 4, 2, '#8a5ab0');
  px(x + 5, y + 8, 6, 2, '#9a6ac4');
  px(x + 6, y + 10, 4, 2, '#8a5ab0');
  px(x + 7, y + 12, 2, 1, '#6a3b8c');
  px(x + 6, y + 6, 1, 1, '#c9a0f0'); px(x + 8, y + 8, 1, 1, '#b98ae8');   // sheen
  px(x + 9, y + 6, 1, 1, '#5a2f78'); px(x + 6, y + 11, 1, 1, '#5a2f78');
  px(x + 3, y + 9, 3, 2, '#4aad4e');                       // leaf over the fruit
}
const CROP_SPRITES = { wheat:drawCrop_wheat, mustard:drawCrop_mustard, barley:drawCrop_barley, grape:drawCrop_grapes };
// _legacy (v92): a single hardcoded wheat-shaped body, signature drawCrop(x,y,stage).
//   Callers now pass the crop record so the kind can be resolved; a bare stage
//   still works and renders wheat, which is what every pre-v93 save holds.
function drawCrop(x,y,stage,c){
  const s=Math.max(0,Math.min(3,stage|0));
  (CROP_SPRITES[(c&&c.type)||'wheat']||drawCrop_wheat)(x,y,s);
}
function draw(){
  const m=activeGrid(), vw=VIEW_TW*TILE, vh=VIEW_TH*TILE;
  let camX=player.x-vw/2+TILE/2, camY=player.y-vh/2+TILE/2;
  const mx=m.w*TILE-vw, my=m.h*TILE-vh;
  camX = mx<0 ? mx/2 : Math.max(0,Math.min(camX,mx));
  camY = my<0 ? my/2 : Math.max(0,Math.min(camY,my));
  ctx.clearRect(0,0,VW,VH);
  // ── ABADDON arena ──
  if(place.kind==='abaddon'){
    const b=abaddon;
    ctx.fillStyle='#0a040e'; ctx.fillRect(0,0,VW,VH);
    // floor (dark infernal tiles), centered (arena smaller than viewport so clamp cam to 0)
    const camX2=0, camY2=0;
    for(let y=0;y<ABADDON_H;y++)for(let x=0;x<ABADDON_W;x++){ const sx=x*TILE, sy=y*TILE;
      px(sx,sy,TILE,TILE,(x+y)%2?'#1a0e22':'#22122c'); }
    // creeping shadow margin (shrinking safe zone)
    if(b.shrink>0.1){ const m=b.shrink*TILE; ctx.fillStyle='rgba(40,0,30,0.66)';
      ctx.fillRect(0,0,ABADDON_W*TILE,m); ctx.fillRect(0,ABADDON_H*TILE-m,ABADDON_W*TILE,m);
      ctx.fillRect(0,0,m,ABADDON_H*TILE); ctx.fillRect(ABADDON_W*TILE-m,0,m,ABADDON_H*TILE);
      ctx.strokeStyle='#ff2a6a'; ctx.lineWidth=1; ctx.globalAlpha=0.5; ctx.strokeRect(m,m,ABADDON_W*TILE-2*m,ABADDON_H*TILE-2*m); ctx.globalAlpha=1; }
    // telegraphs
    const bcx=b.x+TILE/2, bcy=b.y+TILE/2;
    if(b.state==='telegraph'){ const pulse=0.4+0.5*Math.abs(Math.sin(Date.now()*0.02)); ctx.globalAlpha=0.25+pulse*0.35; ctx.fillStyle=bossCfg().phases[b.phase].color; ctx.strokeStyle=bossCfg().phases[b.phase].color;
      if(b.kind==='charge'){ ctx.lineWidth=4; ctx.beginPath(); ctx.moveTo(bcx,bcy); ctx.lineTo(bcx+b.aimx*TILE*9,bcy+b.aimy*TILE*9); ctx.stroke(); }
      else if(b.kind==='slam'){ ctx.lineWidth=2; ctx.beginPath(); ctx.arc(bcx,bcy,TILE*1.4,0,7); ctx.stroke(); }
      else if(b.kind==='shield'){ ctx.lineWidth=3; ctx.beginPath(); ctx.arc(bcx,bcy,TILE,0,7); ctx.stroke(); }
      else { ctx.beginPath(); ctx.arc(bcx,bcy,TILE,0,7); ctx.fill(); }
      ctx.globalAlpha=1; }
    if(b.ring){ ctx.strokeStyle=bossCfg().phases[b.phase].color; ctx.globalAlpha=0.7; ctx.lineWidth=5; ctx.beginPath(); ctx.arc(b.anchorx+TILE/2,b.anchory+TILE/2,b.ringR,0,7); ctx.stroke(); ctx.globalAlpha=1; }
    // projectiles
    b.projectiles.forEach(p=>{ ctx.fillStyle='#ff3a8a'; ctx.beginPath(); ctx.arc(p.x,p.y,5,0,7); ctx.fill(); ctx.fillStyle='#ffd0e8'; ctx.beginPath(); ctx.arc(p.x,p.y,2,0,7); ctx.fill(); });
    // adds
    b.adds.forEach(a=>{ if(!a.alive)return; const body=a.hurt>0?'#ffb0c8':'#6a1a4a'; px(a.x+3,a.y+4,10,10,body); px(a.x+5,a.y+7,2,2,'#ff8'); px(a.x+9,a.y+7,2,2,'#ff8'); });
    // ABADDON himself — large, winged, glowing
    if(!b.dead){ const ax=Math.round(b.x), ay=Math.round(b.y); ctx.save();
      if(b.shield){ ctx.strokeStyle='#8fd0ff'; ctx.globalAlpha=0.5+0.3*Math.abs(Math.sin(Date.now()*0.01)); ctx.lineWidth=3; ctx.beginPath(); ctx.arc(ax+TILE/2,ay+TILE/2,TILE*1.1,0,7); ctx.stroke(); ctx.globalAlpha=1; }
      ctx.shadowColor=bossCfg().phases[b.phase].color; ctx.shadowBlur=14;
      if(abaddon.who==='pretender'){
        if(b.hurt>0){ ctx.globalAlpha=0.55; ctx.fillStyle='#ffd0c0'; ctx.fillRect(ax-4,ay-6,TILE+8,TILE+10); ctx.globalAlpha=1; }
        drawDemonKing(ax-2, ay-6);                          // the 16x20 usurper sprite, centred on the boss tile
      } else {
        const body=b.hurt>0?'#ffd0e0':'#2a0a2e';
        px(ax-2,ay+2,TILE+4,TILE+2,body);                 // bulk
        px(ax-6,ay-2,5,8,'#5a1a4a'); px(ax+TILE+1,ay-2,5,8,'#5a1a4a');  // wings
        px(ax-1,ay-5,4,6,'#7a1a2a'); px(ax+TILE-3,ay-5,4,6,'#7a1a2a');  // horns
        px(ax+3,ay+5,3,3,'#ff3a3a'); px(ax+TILE-6,ay+5,3,3,'#ff3a3a');  // eyes
      }
      ctx.restore();
      if(b.pop){ b.pop.t--; drawDmgPop(ax,ay,b.pop); if(b.pop.t<=0)b.pop=null; }
    }
    // 👑 VICTORY BEAT: Abaddon dissolves, a shaft of holy light, then Sir Aldric walks up
    if(abaddon.victory){ const v=abaddon.victory; const ax=Math.round(b.x), ay=Math.round(b.y);
      if(v.phase==='death'){
        if(v.t<420){ ctx.fillStyle=`rgba(255,255,255,${0.75*(1-v.t/420)})`; ctx.fillRect(0,0,VW,VH); }   // death flash
        const al=Math.max(0, 1-v.t/2000);
        if(al>0){ ctx.globalAlpha=al; const sy=ay+Math.round((v.t/2600)*TILE*1.4);   // sink as he fades
          if(abaddon.who==='pretender') drawDemonKing(ax-2, sy-6);
          else { px(ax-2,sy+2,TILE+4,TILE+2,'#2a0a2e'); px(ax-6,sy-2,5,8,'#5a1a4a'); px(ax+TILE+1,sy-2,5,8,'#5a1a4a');
            px(ax-1,sy-5,4,6,'#7a1a2a'); px(ax+TILE-3,sy-5,4,6,'#7a1a2a'); px(ax+3,sy+5,3,3,'#ff3a3a'); px(ax+TILE-6,sy+5,3,3,'#ff3a3a'); }
          ctx.globalAlpha=1; }
        for(const m of abaddon.deathMotes){ ctx.globalAlpha=m.life; px(Math.round(m.x),Math.round(m.y),2,2,'#b026ff'); } ctx.globalAlpha=1;
        ctx.globalAlpha=0.18*Math.min(1,v.t/1100); ctx.fillStyle='#fff7d8'; ctx.fillRect(b.x-TILE, 0, TILE*3, ABADDON_H*TILE); ctx.globalAlpha=1;  // shaft of light
      }
      if(v.phase==='father'||v.phase==='transition'){
        drawAldric(Math.round(cutAldric.x), Math.round(cutAldric.y), {dir:cutAldric.dir, moving:(v.phase==='father'&&cutAldric.y>(ABADDON_H-2)*TILE+1), frame:cutAldric.frame});
      }
      if(v.phase==='transition'){ ctx.fillStyle=`rgba(0,0,0,${v.fade||0})`; ctx.fillRect(0,0,VW,VH); }
    }
    drawKnight(Math.round(player.x),Math.round(player.y));
    // boss HP bar (top) + phase name
    if(!abaddon.victory){ const P=bossCfg().phases[b.phase];
    ctx.fillStyle='rgba(0,0,0,.6)'; ctx.fillRect(8,6,VW-16,8);
    ctx.fillStyle=P.color; ctx.fillRect(8,6,Math.round((VW-16)*Math.max(0,b.hp/b.maxHp)),8);
    ctx.fillStyle='#fff'; ctx.font='6px monospace'; ctx.textAlign='center';
    ctx.fillText((abaddon.who==='pretender'?'👑 THE PRETENDER — ':'👑 ABADDON — ')+P.name, VW/2, 21); ctx.textAlign='left'; }
    return;
  }
  // ── 👑 STORMGATE KEEP: the walkable throne hall ──
  if(place.kind==='keep'){
    drawThroneScene(camX, camY, Date.now(), true);   // quiet mode: hall + King + guards, no crowd/confetti
    // tournament champions loitering in the hall, once the Demon Hunt is done
    if(hunt.done) for(const k of KEEP_KNIGHTS){
      const kx=Math.round(k.tx*TILE-camX), ky=Math.round(k.ty*TILE-camY);
      drawVillager(kx, ky, {outfit:'soldier', dir:k.dir, moving:false, frame:0});
      ctx.fillStyle='#ffe04a'; ctx.font='7px monospace'; ctx.textAlign='center'; ctx.fillText('\u2694', kx+TILE/2, ky-2); ctx.textAlign='left';
    }
    // Princess Madison keeps her father's court, at the side of the dais
    // — unless the pretender has taken her: her place stands empty until she's rescued
    if(!(bounties.madisonTaken && !bounties.madisonRescued))
      drawPrincessMadison(Math.round(PMADISON.tx*TILE-camX), Math.round(PMADISON.ty*TILE-camY)-1);
    drawKnight(Math.round(player.x-camX), Math.round(player.y-camY));
    const pty=Math.floor((player.y+TILE/2)/TILE);
    if(pty>=THALL.H-3){ ctx.fillStyle='rgba(255,255,255,.7)'; ctx.font='7px sans-serif'; ctx.textAlign='center'; ctx.fillText('\u2b07 head down the hall to leave', VW/2, VH-6); ctx.textAlign='left'; }
    return;
  }
  // ── DUNGEON: its own tile vocabulary (0 floor,1 wall,2 stairs,5 chest,7 general,8 entrance) ──
  if(place.kind==='dungeon'){
    ctx.fillStyle='#0a0610'; ctx.fillRect(0,0,VW,VH);
    for(let y=0;y<DH;y++)for(let x=0;x<DW;x++){
      const sx=Math.round(x*TILE-camX), sy=Math.round(y*TILE-camY);
      drawDungeonTile(dungeon.grid[y][x], sx, sy, x, y);
    }
    ctx.textAlign='left';
    // boss telegraphs (drawn under the actors)
    demons.forEach(d=>{ if(!d.alive||!d.boss) return; const bx=Math.round(d.x-camX), by=Math.round(d.y-camY); const bcx=bx+TILE/2, bcy=by+TILE/2;
      if(d.state==='telegraph'){ const p=1-d.telegraph/d.telMax; const pulse=0.4+0.5*Math.abs(Math.sin(d.t*0.4));
        ctx.globalAlpha=0.25+pulse*0.3;
        if(d.kind==='charge'){ // warning line in the aim direction
          ctx.strokeStyle=d.col; ctx.lineWidth=3; ctx.beginPath(); ctx.moveTo(bcx,bcy); ctx.lineTo(bcx+d.aimx*TILE*7, bcy+d.aimy*TILE*7); ctx.stroke();
        } else if(d.kind==='slam'){ ctx.strokeStyle=d.col; ctx.lineWidth=2; ctx.beginPath(); ctx.arc(bcx,bcy,TILE*1.2,0,7); ctx.stroke();
        } else { ctx.fillStyle=d.col; ctx.beginPath(); ctx.arc(bcx,bcy,TILE*0.9,0,7); ctx.fill(); }
        ctx.globalAlpha=1;
      }
      if(d.ring){ ctx.strokeStyle=d.col; ctx.globalAlpha=0.7; ctx.lineWidth=4; ctx.beginPath(); ctx.arc(d.anchorx+TILE/2-camX, d.anchory+TILE/2-camY, d.ringR, 0,7); ctx.stroke(); ctx.globalAlpha=1; }
    });
    drawRolledStones(camX,camY);
    // projectiles
    dungeon.projectiles.forEach(p=>{ const px2=Math.round(p.x-camX), py2=Math.round(p.y-camY);
      ctx.fillStyle='#ff5a6a'; ctx.beginPath(); ctx.arc(px2,py2,4,0,7); ctx.fill();
      ctx.fillStyle='#ffd0d8'; ctx.beginPath(); ctx.arc(px2,py2,1.6,0,7); ctx.fill(); });
    // demons then adds then knight
    demons.forEach(d=>{ if(d.alive||d.dying>0||d.pop) drawDemon(Math.round(d.x-camX), Math.round(d.y-camY), d); });
    dungeon.adds.forEach(a=>{ if(!a.alive)return; const ax=Math.round(a.x-camX), ay=Math.round(a.y-camY);
      const body=a.hurt>0?'#ffb0b8':'#8a3a6a'; px(ax+4,ay+5,8,8,body); px(ax+5,ay+7,2,2,'#ff8'); px(ax+9,ay+7,2,2,'#ff8'); });
    drawKnight(Math.round(player.x-camX), Math.round(player.y-camY));
    // ── TORCHLIGHT vignette on maze floors: darkness presses in beyond your light ──
    // _legacy: floors[floorIdx]<=1 || ===4  — an unnamed range that silently
    //   excluded any kind added later. The library is excluded ON PURPOSE: it is
    //   a lit room, not a dark corridor.
    const _fk = dungeon.floors[dungeon.floorIdx];
    if(_fk===FLOOR.maze || _fk===FLOOR.maze2 || _fk===FLOOR.cave || _fk===FLOOR.doctrine){
      const lx=Math.round(player.x-camX)+TILE/2, ly=Math.round(player.y-camY)+TILE/2;
      const grad=ctx.createRadialGradient(lx,ly,TILE*2.6, lx,ly,TILE*6.2);
      grad.addColorStop(0,'rgba(6,3,12,0)'); grad.addColorStop(1,'rgba(6,3,12,0.72)');
      ctx.fillStyle=grad; ctx.fillRect(0,0,VW,VH);
    }
    // ── THE FOG OF DISILLUSIONMENT: in the forest maze, darkness drinks the light ──
    if(dungeon.disillusion && !dungeon.inGlade){
      const pcx=Math.round(player.x-camX)+TILE/2, pcy=Math.round(player.y-camY)+TILE/2;
      const lamp=!!player.hasLamp;
      const rClear=(lamp?5.0:3.0)*TILE, rFade=(lamp?8.0:5.4)*TILE;
      const dark=lamp?0.80:0.96;       // max darkness out in the fog
      // ONE radial gradient covering the whole view: fully TRANSPARENT at the player,
      // smoothly ramping to dark by rFade and staying dark beyond (the last color stop
      // extends outward). A single fill — no seams, no compositing.
      const fg=ctx.createRadialGradient(pcx,pcy,0, pcx,pcy,rFade);
      fg.addColorStop(0, 'rgba(5,6,10,0)');                       // center: clear
      fg.addColorStop(rClear/rFade, 'rgba(5,6,10,0)');           // still clear out to rClear
      fg.addColorStop(1, 'rgba(5,6,10,'+dark+')');               // dark by rFade (and beyond)
      ctx.fillStyle=fg; ctx.fillRect(0,0,VW,VH);
      if(lamp){
        const lgr=ctx.createRadialGradient(pcx,pcy,2, pcx,pcy,rClear);
        lgr.addColorStop(0,'rgba(255,196,90,0.18)'); lgr.addColorStop(1,'rgba(255,196,90,0)');
        ctx.fillStyle=lgr; ctx.fillRect(0,0,VW,VH);
      }
    }
    return;
  }
  const t0x=Math.floor(camX/TILE), t0y=Math.floor(camY/TILE);
  // ground
  for(let ry=-1;ry<=VIEW_TH;ry++) for(let rx=-1;rx<=VIEW_TW;rx++){
    const tx=t0x+rx, ty=t0y+ry;
    const sx=Math.round(rx*TILE-(camX-t0x*TILE)), sy=Math.round(ry*TILE-(camY-t0y*TILE));
    drawTile(tileAt(tx,ty), sx, sy, tx, ty);
  }
  // ── ELEVATION: draw cliff faces & lit top edges so height reads in 2.5D ──
  // Reference style: warm brown rock built from chunky blocks with lit tops,
  // and a grass/snow fringe overhanging the lip of each drop.
  if((place.kind==='overworld' || place.kind==='portalworld') && elevActive){
    // tile lookups must follow the active map — WORLD is wrong in a portal world
    const TG=(place.kind==='portalworld' && portalWorld.g) ? portalWorld.g : WORLD;
    const COLD=(place.kind==='portalworld' && portalWorld.frozen);
    for(let ry=-1;ry<=VIEW_TH+1;ry++) for(let rx=-1;rx<=VIEW_TW;rx++){
      const tx=t0x+rx, ty=t0y+ry; const h=elevAt(tx,ty); if(h<=0) continue;
      const sx=Math.round(rx*TILE-(camX-t0x*TILE)), sy=Math.round(ry*TILE-(camY-t0y*TILE));
      const hS=elevAt(tx,ty+1);   // tile to the south (toward camera/bottom)
      const tBelow=TG[ty+1]&&TG[ty+1][tx];
      if(hS<h && tBelow!==10 && tBelow!==11){ const drop=h-hS; const faceH=Math.min(TILE, 6+drop*5);
        const fy=sy+TILE;
        // warm rock face
        px(sx, fy, TILE, faceH, COLD?'#5d6773':'#6b4f38');
        px(sx, fy, TILE, 1, COLD?'#8b98a6':'#96714e');                          // catch-light at the lip
        // chunky blocks: 2 courses of deterministic stones, each with a lit top + dark gap
        for(let i=0;i<4;i++){
          const ch=((tx*31+ty*17+i*47)>>>0);
          const bw=4+(ch%4), bx2=sx+((ch>>2)%(TILE-bw));
          const by2=fy+2+((ch>>5)%Math.max(1,faceH-6));
          px(bx2,by2,bw,3,COLD?'#6d7885':'#7d5e44'); px(bx2,by2,bw,1,COLD?'#96a3b1':'#9c7752'); px(bx2,by2+3,bw,1,COLD?'#3c454f':'#46321f');
        }
        px(sx, fy+faceH-2, TILE, 2, COLD?'#2f3740':'#3c2c1c');                  // deep shadow at the base
        // overhanging fringe: grass or snow spills over the lip from the surface above
        const tt=TG[ty]&&TG[ty][tx];
        if(tt===22||tt===34||tt===23||tt===61||tt===63||tt===64){ for(let fx2=0;fx2<TILE;fx2+=3) px(sx+fx2, fy, 2, 2+((tx+fx2)%2), '#e8f0f6'); }
        else if(tt===25||tt===27){ for(let fx2=0;fx2<TILE;fx2+=4) px(sx+fx2, fy, 2, 1+((tx+fx2)%2), '#7a7268'); }
        else { for(let fx2=0;fx2<TILE;fx2+=3) px(sx+fx2, fy, 2, 2+((tx+fx2)%2), '#4f9050'); }
      }
      // lit top edge on the raised tile's north side (sun from top-left)
      const hN=elevAt(tx,ty-1);
      if(hN<h){ const tt=TG[ty]&&TG[ty][tx];
        const tN=TG[ty-1]&&TG[ty-1][tx];
        if(tN!==10 && tN!==11) px(sx, sy-1, TILE, 1, COLD?'#28303a':'#2e2216');   // crisp silhouette on the lower side
        px(sx, sy, TILE, 1, (tt===22||tt===34||tt===61||tt===63)?'#ffffff':'#cfe2c8'); }
      // side edges (sun from top-left), RUN-AWARE: full treatment only where the
      // side wall runs 2+ tiles vertically (straight terraces); isolated diagonal
      // steps (curved boundaries like Crystalpeak's rings) get a minimal seam so
      // curves stay clean while long ledges stay bold.
      const hE=elevAt(tx+1,ty), hW=elevAt(tx-1,ty);
      const tE=TG[ty]&&TG[ty][tx+1], tW=TG[ty]&&TG[ty][tx-1];
      if(hE<h && tE!==10 && tE!==11){
        const runE=(elevAt(tx,ty-1)===h && elevAt(tx+1,ty-1)<h) ||
                   (elevAt(tx,ty+1)===h && elevAt(tx+1,ty+1)<h);
        if(runE){
          px(sx+TILE-2, sy, 2, TILE, COLD?'#5d6773':'#6b4f38');
          px(sx+TILE-2, sy, 1, TILE, COLD?'#6d7885':'#7d5e44');
          px(sx+TILE-1, sy, 1, TILE, COLD?'#3c454f':'#46321f');
          px(sx+TILE,   sy, 2, TILE, '#140f0a44');
          px(sx+TILE+2, sy, 1, TILE, '#140f0a22');
          const tt3=TG[ty]&&TG[ty][tx];
          if(tt3===22||tt3===34||tt3===61||tt3===63) px(sx+TILE-2, sy, 1, TILE, '#e8f0f6');
        } else {
          px(sx+TILE-1, sy, 1, TILE, COLD?'#3c454f':'#46321f');
        }
      }
      if(hW<h && tW!==10 && tW!==11){
        const runW=(elevAt(tx,ty-1)===h && elevAt(tx-1,ty-1)<h) ||
                   (elevAt(tx,ty+1)===h && elevAt(tx-1,ty+1)<h);
        if(runW){
          const tt3=TG[ty]&&TG[ty][tx];
          px(sx, sy, 1, TILE, (tt3===22||tt3===34||tt3===61||tt3===63)?'#ffffff':'#cfe2c8');
          px(sx-1, sy, 1, TILE, '#140f0a22');
        } else {
          px(sx, sy, 1, TILE, COLD?'#3c454f':'#46321f');
        }
      }
      // subtle ambient lightening with height so upper tiers feel sunlit
      // (snow/ice tiles are exempt — they are already bright, and a warm wash muddies them)
      if(h>1){ const tt2=TG[ty]&&TG[ty][tx];
        if(tt2!==22&&tt2!==34&&tt2!==23&&tt2!==24&&tt2!==61&&tt2!==63&&tt2!==64){
          ctx.globalAlpha=Math.min(0.10, 0.035*(h-1)); ctx.fillStyle='#fff8e8'; ctx.fillRect(sx,sy,TILE,TILE); ctx.globalAlpha=1; } }
    }
  }
  // ── ABADDON'S BARRIERS: pulsing rings of dark power around still-sealed towns ──
  if(place.kind==='overworld'){
    const ph=Date.now()/300;
    for(let ry=-1;ry<=VIEW_TH;ry++) for(let rx=-1;rx<=VIEW_TW;rx++){
      const tx=t0x+rx, ty=t0y+ry;
      const bi=barrierAt(tx,ty); if(bi===-1) continue;
      const sx=Math.round(rx*TILE-(camX-t0x*TILE)), sy=Math.round(ry*TILE-(camY-t0y*TILE));
      const hsh=((tx*374761393+ty*668265263)>>>0);
      const pulse=0.30+0.14*Math.sin(ph+(hsh%7));
      ctx.globalAlpha=pulse; ctx.fillStyle='#5a1a8a'; ctx.fillRect(sx,sy,TILE,TILE);
      ctx.globalAlpha=Math.min(1,pulse+0.25); ctx.fillStyle='#9a4ae0';
      const cr=Math.floor(ph*2+(hsh%13))%4;                          // crawling energy crackles
      ctx.fillRect(sx+2+(hsh%9), sy+((cr*5+(hsh>>3))%14), 2, 2);
      ctx.fillRect(sx+((hsh>>4)%12), sy+13-cr*3, 2, 2);
      ctx.fillRect(sx+7, sy+((cr*4+(hsh>>6))%14), 1, 3);
      ctx.globalAlpha=1;
    }
  }
  // ── draw CROPS growing on their plots (overworld) ──
  if(place.kind==='overworld'){
    for(const key in crops){ const c=crops[key]; const [cxx,cyy]=key.split(',').map(Number);
      const sx=Math.round(cxx*TILE-camX), sy=Math.round(cyy*TILE-camY);
      if(sx<-TILE||sy<-TILE||sx>VW||sy>VH) continue;
      drawCrop(sx, sy, c.stage, c);   // pass the crop so its kind picks the sprite
    }
    // fishing bobber + bite indicator
    if(fishing){ const bx=Math.round(fishing.fx*TILE-camX)+TILE/2, by=Math.round(fishing.fy*TILE-camY)+TILE/2;
      const bob=fishing.phase==='bite'?Math.sin(performance.now()/60)*2:Math.sin(performance.now()/300)*1;
      px(bx-1,by-1+bob,3,3,'#e84a4a'); px(bx-1,by+1+bob,3,1,'#fff');   // red/white bobber
      if(fishing.phase==='bite'){ ctx.fillStyle='#ffe04a'; ctx.font='bold 12px monospace'; ctx.fillText('!', bx-2, by-6+bob); }
    }
  }
  // portal world: its own depth-sorted pass (sheep, shepherds, the knight; later
  //   fallen-knights). Mirrors the overworld sort so everything overlaps correctly.
  if(place.kind==='portalworld'){
    const objs=[];
    if(portalWorld.sheep) portalWorld.sheep.forEach(s=>objs.push({ sy:(s.y/TILE)+1,
      draw:()=>drawSheep(Math.round(s.x-camX), Math.round(s.y-camY), s) }));
    if(portalWorld.shepherds) portalWorld.shepherds.forEach(s=>objs.push({ sy:(s.y/TILE)+1,
      draw:()=>drawShepherd(Math.round(s.x-camX), Math.round(s.y-camY), s) }));
    if(madison && place.kind==='portalworld') objs.push({ sy:(madison.y/TILE)+1,
      draw:()=>drawMadison(Math.round(madison.x-camX), Math.round(madison.y-camY)) });
    if(portalWorld.pilgrims) portalWorld.pilgrims.forEach(P=>{
      objs.push({ sy:P.y+1, draw:()=>drawVillager(Math.round(P.x*TILE-camX), Math.round(P.y*TILE-camY), P.v) });
      if(!sunfallProgress.metPilgrims || !sunfallProgress.metPilgrims[P.id])
        objs.push({ sy:P.y+1.01, draw:()=>drawQuestMark(Math.round(P.x*TILE-camX), Math.round((P.y-1.15)*TILE-camY), false) });
    });
    // Tabor's people and props: the rescued, the wood, the hearth
    if(portalWorld.rescues) portalWorld.rescues.forEach(r=>{
      if(!r.hidden) objs.push({ sy:r.y+1, draw:()=>drawVillager(Math.round(r.x*TILE-camX), Math.round(r.y*TILE-camY), r.v) });
      const mk=taborQuestMark(r.id);
      if(mk) objs.push({ sy:r.y+1.01, draw:()=>drawQuestMark(Math.round(r.x*TILE-camX), Math.round((r.y-1.15)*TILE-camY), mk==='gold') });
    });
    if(portalWorld.hearthWood) portalWorld.hearthWood.forEach(w=>{ if(w.got) return;
      objs.push({ sy:w.y+0.8, draw:()=>drawWoodBundle(Math.round(w.x*TILE-camX), Math.round(w.y*TILE-camY)) }); });
    if(portalWorld.hearthFire){ const f=portalWorld.hearthFire;
      objs.push({ sy:f.y+0.9, draw:()=>drawCampfire(Math.round(f.x*TILE-camX), Math.round(f.y*TILE-camY), f.lit) }); }
    // the summit: the sleeping/fighting King, and the Pretender's departure
    if(portalWorld.id==='tabor' && taborBoss.spring){
      if(taborBoss.phase==='sleep'){ const sp=taborBoss.spring;
        objs.push({ sy:sp.y+1.6, draw:()=>drawShadowKing(Math.round(sp.x*TILE-camX), Math.round(sp.y*TILE-camY), {sleep:true, t:(Date.now()>>4)&1023}) }); }
      if(taborBoss.phase==='cine' && taborBoss.cine){ const c=taborBoss.cine; const sp=taborBoss.spring;
        objs.push({ sy:sp.y+1.6, draw:()=>drawShadowKing(Math.round(sp.x*TILE-camX), Math.round(sp.y*TILE-camY), {sleep:(c.stage==='talk'&&c.t<1), t:(Date.now()>>4)&1023}) });
        objs.push({ sy:(c.py/TILE)+1, draw:()=>{ ctx.globalAlpha=c.alpha; drawPretenderStanding(Math.round(c.px-camX), Math.round(c.py-camY)); ctx.globalAlpha=1; } });
        objs.push({ sy:(c.my/TILE)+1, draw:()=>{ ctx.globalAlpha=c.alpha; drawPrincessMadison(Math.round(c.mx-camX), Math.round(c.my-camY));
          const mx2=Math.round(c.mx-camX), my2=Math.round(c.my-camY);
          px(mx2-3,my2+9,3,2,'#8a8a96'); px(mx2-6,my2+10,3,2,'#7a7a86');   // the chain
          ctx.globalAlpha=1; } });
        if(c.stage==='out'){ objs.push({ sy:(c.py/TILE)+2, draw:()=>{ const t=Date.now()*0.01;
          ctx.strokeStyle='rgba(160,120,255,'+(0.35+0.25*Math.sin(t)).toFixed(2)+')'; ctx.lineWidth=2;
          ctx.beginPath(); ctx.arc(Math.round(c.px-camX)+8, Math.round(c.py-camY)+6, 14+3*Math.sin(t*1.7), 0, 7); ctx.stroke(); } }); }
      }
      if(taborBoss.phase==='fight' && taborBoss.boss){ const b=taborBoss.boss;
        objs.push({ sy:(b.y/TILE)+1.6, draw:()=>drawShadowKing(Math.round(b.x-camX), Math.round(b.y-camY), b) });
      }
      if(portalWorld.palms) portalWorld.palms.forEach(p=>{ if(!_tabThawedAt(p.x,p.y)) return;
        objs.push({ sy:p.y+1, draw:()=>drawPalmTree(Math.round(p.x*TILE-camX), Math.round(p.y*TILE-camY)) }); });
      if(portalWorld.fruitTrees) portalWorld.fruitTrees.forEach(p=>{ if(!_tabThawedAt(p.x,p.y)) return;
        objs.push({ sy:p.y+1, draw:()=>drawFruitTree(Math.round(p.x*TILE-camX), Math.round(p.y*TILE-camY)) }); });
      if(portalWorld.thawedFolk) portalWorld.thawedFolk.forEach(f=>{
        objs.push({ sy:f.y+1, draw:()=>drawVillager(Math.round(f.x*TILE-camX), Math.round(f.y*TILE-camY), f.v) }); });
      if(taborProgress.thawed && portalWorld.raftDock && !taborRide.active){ const d=portalWorld.raftDock;
        objs.push({ sy:d.y+1, draw:()=>drawRaft(Math.round(d.x*TILE-camX), Math.round((d.y+0.6)*TILE-camY), false) }); }
      if(taborRide.active){
        objs.push({ sy:(taborRide.y/TILE)+0.95, draw:()=>drawRaft(Math.round(taborRide.x-camX), Math.round(taborRide.y-camY), true) }); }
      if(taborProgress.thawed && portalWorld.hammocks) portalWorld.hammocks.forEach(h=>{
        objs.push({ sy:h.y+0.9, draw:()=>drawHammock(Math.round(h.x*TILE-camX), Math.round(h.y*TILE-camY)) }); });
      if(taborProgress.thawed && portalWorld.springs) portalWorld.springs.forEach(h=>{
        objs.push({ sy:h.y+0.85, draw:()=>drawHotSpring(Math.round(h.x*TILE-camX), Math.round(h.y*TILE-camY)) }); });
      if(portalWorld.ship){ const sh=portalWorld.ship;
        objs.push({ sy:sh.y+1.4, draw:()=>drawShip(Math.round(sh.x*TILE-camX), Math.round(sh.y*TILE-camY), !taborProgress.thawed) }); }
    }
    if(portalWorld.villages) portalWorld.villages.forEach(v=>{ const c=v.chapel;
      objs.push({ sy:c.y+1, draw:()=>drawMistralChapel(Math.round(c.x*TILE-camX), Math.round(c.y*TILE-camY), !v.cleared) }); });
    if(portalWorld.castle){ const cg=portalWorld.castle.gate;
      objs.push({ sy:cg.y+1, draw:()=>drawMistralCastle(Math.round(cg.x*TILE-camX), Math.round(cg.y*TILE-camY), !(mistThrone&&mistThrone.purified)) }); }
    // pens (ground-level, drawn before entities so sheep stand inside them)
    if(portalWorld.pens) portalWorld.pens.forEach(pen=>drawSheepPen(Math.round(pen.x*TILE-camX), Math.round(pen.y*TILE-camY), pen.w, pen.h));
    // lost sheep hiding in the fields (with a bouncing ? marker)
    if(portalWorld.lost) portalWorld.lost.forEach(s=>{ if(s.state==='penned') return;
      objs.push({ sy:(s.y/TILE)+1, draw:()=>{ drawSheep(Math.round(s.x-camX), Math.round(s.y-camY), s);
        if(s.state==='hiding'){ const by=Math.round(Math.sin(s.t*0.1)*2); drawLostMarker(Math.round(s.x-camX)+6, Math.round(s.y-camY)-8+by); } } }); });
    demons.forEach(d=>{ if(d.alive||d.dying>0||d.pop) objs.push({ sy:(d.y/TILE)+1,
      draw:()=>drawDemon(Math.round(d.x-camX), Math.round(d.y-camY), d) }); });
    if(player.pet && !player.mounted) objs.push({ sy:(player.petY/TILE)+0.9, draw:()=>drawPet(Math.round(player.petX-camX), Math.round(player.petY-camY)) });
    objs.push({ sy:(player.y/TILE)+1, draw:()=>drawKnight(Math.round(player.x-camX), Math.round(player.y-camY)) });
    objs.sort((a,b)=>a.sy-b.sy).forEach(o=>o.draw());
  }
  // overworld: collect all depth-objects and y-sort so nearer ones overlap farther
  if(place.kind==='overworld'){
    const objs=[];
    decorations.forEach(d=>objs.push({ sy:d.y+(d.w||1), draw:()=>drawDecor(d, Math.round(d.x*TILE-camX), Math.round(d.y*TILE-camY)) }));
    // faint sparkle on undiscovered secrets (a subtle shimmer that rewards a keen eye)
    SECRETS.forEach(s=>{ if(secretsFound[s.id]) return; const sx=Math.round(s.x*TILE-camX), sy=Math.round(s.y*TILE-camY);
      if(sx<-TILE||sx>VW+TILE||sy<-TILE||sy>VH+TILE) return;
      const tw=0.5+0.5*Math.sin(Date.now()*0.005+s.x); ctx.globalAlpha=0.35+tw*0.4; ctx.fillStyle='#fff7c8';
      const cx=sx+TILE/2, cy=sy+TILE/2, r=2+tw*2; ctx.beginPath(); ctx.moveTo(cx,cy-r-2); ctx.lineTo(cx+1.5,cy); ctx.lineTo(cx,cy+r+2); ctx.lineTo(cx-1.5,cy); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(cx-r-2,cy); ctx.lineTo(cx,cy-1.5); ctx.lineTo(cx+r+2,cy); ctx.lineTo(cx,cy+1.5); ctx.closePath(); ctx.fill(); ctx.globalAlpha=1; });
    buildings.forEach(b=>objs.push({ sy:b.y+b.h, draw:()=>drawBuilding(b, Math.round(b.x*TILE-camX), Math.round(b.y*TILE-camY)) }));
    // ── the summit portals (only after the pretender is cast down) ──
    if(bounties.portalsOpen) PORTALS.forEach(p=>objs.push({ sy:p.ty+1,
      draw:()=>drawPortal(p, Math.round(p.tx*TILE-camX), Math.round(p.ty*TILE-camY), Date.now()) }));
    villagers.forEach(v=>objs.push({ sy:(v.y/TILE)+1, draw:()=>drawVillager(Math.round(v.x-camX), Math.round(v.y-camY), v) }));
    if(player.pet && !player.mounted) objs.push({ sy:(player.petY/TILE)+0.9, draw:()=>drawPet(Math.round(player.petX-camX), Math.round(player.petY-camY)) });
    demons.forEach(d=>{ if(d.alive||d.dying>0||d.pop) objs.push({ sy:(d.y/TILE)+1, draw:()=>drawDemon(Math.round(d.x-camX), Math.round(d.y-camY), d) }); });
    // 🛒 the parked wagon (when not being driven), depth-sorted like a decoration
    if(wagon.unlocked && !player.driving){ objs.push({ sy:wagon.y+1, draw:()=>drawWagon(Math.round(wagon.x*TILE-camX), Math.round(wagon.y*TILE-camY), false, 'down') }); }
    if(player.driving){ objs.push({ sy:(player.y/TILE)+1.05, draw:()=>drawWagon(Math.round(player.x-camX), Math.round(player.y-camY), true, player.dir) }); }
    else objs.push({ sy:(player.y/TILE)+1, draw:()=>drawKnight(Math.round(player.x-camX), Math.round(player.y-camY)) });
    objs.sort((a,b)=>a.sy-b.sy).forEach(o=>o.draw());
    // ── HOMESTEAD DECOR GHOST: preview the piece on the facing tile ──
    if(decorPlace.active && decorPlace.id){
      const it=DECOR_ITEMS[decorPlace.id];
      const [fx,fy]=facingTile();
      const ok=decorFootprintOk(decorPlace.id,fx,fy);
      const gx=Math.round(fx*TILE-camX), gy=Math.round(fy*TILE-camY);
      ctx.globalAlpha=0.35; ctx.fillStyle=ok?'#5aff8a':'#ff5a5a';
      ctx.fillRect(gx,gy,it.w*TILE,it.w*TILE); ctx.globalAlpha=0.75;
      drawDecor({kind:it.kind,w:it.w}, gx, gy);
      ctx.globalAlpha=1;
    }
  } else {
    drawSanctuaryOverlay(camX, camY);   // camX/camY are local to draw(); pass them in
    drawKeepThroneOverlay(camX, camY);   // dress the capital keep as a throne room
    drawInteriorLight(camX, camY);       // window pools + fireplace glow (furnished interiors)
    activeNpcs().forEach(n=>drawNpc(Math.round(n.x*TILE-camX), Math.round(n.y*TILE-camY), n));
    // ── THE COMPANION BY THE FIRE ── Tobias says it is waiting there, so it had
    //    better be there. Drawn at the hearth on the ground floor until the
    //    lessons are done, after which it follows you like any other companion.
    if(place.id==='tobias' && place.floor===0 && player.pet && !tutorial.done){
      const f0=_inGrid();
      let hx=4, hy=0;
      if(f0) for(let y=0;y<f0.h;y++)for(let x=0;x<f0.w;x++) if(f0.g[y][x]===45){ hx=x; hy=y; }
      const sx0=Math.round(hx*TILE-camX), sy0=Math.round((hy+1)*TILE-camY);
      try{ drawPet(sx0, sy0); }catch(e){}
    }
    // ── THE FIRST MORNING ── the night lifts off the room while the old man
    //    climbs the stairs. A cool blue over everything, thinning to nothing.
    if(escort.on && escort.dawn>0 && place.id==='tobias' && place.floor===1){
      ctx.save();
      ctx.globalAlpha = 0.82*escort.dawn;
      px(0,0,VW,VH,'#0b1030');
      ctx.globalAlpha = 0.35*escort.dawn;
      px(0,0,VW,Math.round(VH*0.55),'#1a2050');
      ctx.restore();
    }
    // he is only on the throne BEFORE the fight — once he has fled he must not reappear
    if(place.id==='mistthrone' && !mistThrone.purified && !mistThrone.fighting && !mistThrone.cine
        && !mistThrone.lastStand && !mistThrone.freeable && !mistThrone.fled){
      const sx=Math.round(7*TILE-camX), sy=Math.round(1*TILE-camY);
      if(typeof drawDemonKing==='function') drawDemonKing(sx-2, sy-8);   // the seated Pretender
    }
    // she is only here until he drags her through the portal — then she is gone for good
    if(place.id==='mistthrone' && !mistThrone.purified && !mistThrone.madisonTaken
        && !(mistThrone.cine&&mistThrone.cine.seized)) drawChainedMadison(camX,camY);
    if(place.id==='mistthrone' && mistThrone.caged) drawStewardCage(camX,camY);
    if(place.id==='mistthrone' && mistThrone.release) drawStewardRelease(camX,camY);
    // the Pretender's summoned fallen knights — without this they fight invisibly
    if(place.id==='mistthrone' || _isSunLampId(place.id)) demons.forEach(d=>{ if(d.alive||d.dying>0||d.pop)
      drawDemon(Math.round(d.x-camX), Math.round(d.y-camY), d); });
    if(place.id==='mistthrone' && mistThrone.fighting && mistThrone.boss){ drawThroneBoss(camX,camY); }
    if(madison && place.kind==='interior') drawMadison(Math.round(madison.x-camX), Math.round(madison.y-camY));
    if(place.id==='vesper_cath' && place.floor===3){
      drawMadisonCage(Math.round(3*TILE-camX), Math.round(1*TILE-camY));
      if(sunBoss.boss){
        const b=sunBoss.boss;
        b.shots.forEach(s=>{ px(Math.round(s.x-camX)-2, Math.round(s.y-camY)-2, 4, 4, '#ffd070');
          px(Math.round(s.x-camX)-1, Math.round(s.y-camY)-1, 2, 2, '#fff4d0'); });
        drawPretender(Math.round(b.x-camX), Math.round(b.y-camY), b);
      }
    }
    if(place.kind==='portalworld' && portalWorld.id==='tabor' && taborBoss.phase==='fight' && taborBoss.boss){ drawShadowKingHud(camX,camY); }
    if(place.id==='vesper_cath' && sunBoss.phase==='fight' && sunBoss.boss){ drawPretenderHud(); }
    if(place.id==='mistthrone' && mistThrone.cine) drawThroneCine(camX,camY);
    drawKnight(Math.round(player.x-camX), Math.round(player.y-camY));
  }
  drawArrows(camX,camY);
  if(place.kind==='portalworld' && portalWorld.id==='sunfall') drawSunfallTier();
  drawCredits();
  // ── DAY/NIGHT tint: the overworld darkens and warms with the hour ──
  if(place.kind==='overworld'){ const _tc=dayTint(); if(_tc){ ctx.fillStyle=_tc; ctx.fillRect(0,0,VW,VH); } }
  // ── INN REST fade: black at the midpoint (heal + save fire there), then back in ──
  // ── PORTAL WARP: a full-screen violet/teal swirl. At the midpoint we swap place. ──
  if(portalWarp){ const dur=1000; const p=(performance.now()-portalWarp.t0)/dur;
    if(p>=0.5 && !portalWarp.fired){ portalWarp.fired=true; const to=portalWarp.to;
      if(to.kind==='enter') arrivePortalWorld(to.id, to.home);
      else arriveOverworldFromPortal(to.home); }
    if(p>=1){ portalWarp=null; }
    else {
      const a=Math.max(0,Math.min(1, p<0.5?p*2:(2-p*2)));
      const cxp=VW/2, cyp=VH/2, RR=Math.max(VW,VH)*0.75;
      const gr=ctx.createRadialGradient(cxp,cyp,2, cxp,cyp,RR);
      gr.addColorStop(0,'rgba(232,251,246,'+a+')');
      gr.addColorStop(0.4,'rgba(122,62,168,'+a+')');
      gr.addColorStop(1,'rgba(47,176,168,'+(a*0.9)+')');
      ctx.fillStyle=gr; ctx.fillRect(0,0,VW,VH);
      const ph=performance.now()*0.012;
      for(let arm=0;arm<3;arm++) for(let s2=0;s2<40;s2++){
        const ang=ph + arm*2.094 + s2*0.4, rr=4+s2*(RR/40);
        const x=cxp+Math.cos(ang)*rr, y=cyp+Math.sin(ang)*rr*0.9;
        ctx.globalAlpha=a*0.8; px(Math.round(x),Math.round(y),3,3, s2%2?'#c9a8f0':'#bfeee8'); }
      ctx.globalAlpha=1;
    }
  }
  if(skiff){ const p=(performance.now()-skiff.t0)/1900;
    if(p>=0.5 && !skiff.fired){ skiff.fired=true;
      const M=(portalWorld.moorings||[]).find(m=>m.ring===skiff.toTier);
      if(M){ player.x=M.x*TILE; player.y=(M.y+1)*TILE; player.dir='down'; }
      demons=[]; spawnSunfallGloamings(); saveGame();
    }
    if(p>=1){ const t=skiff.toTier; skiff=null;
      showBanner('\ud83e\ude81 <b>You set down on Tier '+t+'.</b><br><span style="font-size:7px">The skiff swings on its tether, waiting for the next thermal.</span>', 2400);
    } else {
      const a=Math.max(0,Math.min(1, p<0.5?p*2:(2-p*2)));
      ctx.globalAlpha=a; ctx.fillStyle='#2a1830'; ctx.fillRect(0,0,VW,VH);
      ctx.globalAlpha=Math.min(1,a*1.2);                                 // wind streaks
      for(let i=0;i<14;i++){ const yy=((i*37+Math.floor(performance.now()/6))%VH);
        px(((i*53)%VW), yy, 14, 1, '#e8d6e8'); }
      ctx.globalAlpha=1;
    }
  }
  if(innRest){ const p=(performance.now()-innRest.t0)/1600;
    if(p>=0.5 && !innRest.fired){ innRest.fired=true; player.hp=player.maxHp;
      dayClock.t=DAY_LEN*innRest.target;            // wake at the chosen hour
      if(innRest.wraps) dayClock.day++;             // crossed midnight → a new day
      _wasNight=isNight(); applyNightDemons(isNight());
      saveGame();
      showBanner(`🛏 <b style="color:#fff">${innRest.who}</b><br><span style="font-size:7px">${innRest.phrase} ❤ Fully restored · 💾 Game saved</span>`, 2600); }
    if(p>=1){ innRest=null; }
    else { const a=Math.max(0,Math.min(1, p<0.5?p*2:(2-p*2)));
      ctx.globalAlpha=a; ctx.fillStyle='#000'; ctx.fillRect(0,0,VW,VH); ctx.globalAlpha=1; }
  }
}


// ════════════════════════════════════════════════════════════════
//  INTERIOR FURNISHING v1 — timber rooms, solid furniture, warm light
//  (approved via mockup; home + inn template, rollout follows)
// ════════════════════════════════════════════════════════════════
function _inGrid(){ const f=INTERIORS[place.id].floors[place.floor]; return f; }
function _inT(f,tx,ty){ return (f.g[ty]&&f.g[ty][tx]!==undefined)?f.g[ty][tx]:-1; }  // -1 = out of bounds
function _inHash(tx,ty){ return ((tx*374761393+ty*668265263)>>>0); }
const _WALLISH = new Set([5,45,51,52]);   // tiles that continue a wall run
function drawIntWall(x,y,tx,ty,f){
  const below=_inT(f,tx,ty+1);
  if(below!==-1 && !_WALLISH.has(below) && below!==9){
    // room lies below → show the plastered face
    px(x,y,TILE,4,'#4a3626'); px(x,y,TILE,1,'#5e4630');               // timber cap
    px(x,y+4,TILE,9,'#e2d4b4'); px(x,y+4,TILE,1,'#f0e4c8');           // plaster face
    px(x,y+13,TILE,3,'#7a5c3a'); px(x,y+13,TILE,1,'#8a6a44');         // wainscot
    const h1=_inHash(tx,ty)%5; if(h1<2) px(x+3+h1*4,y+6,1,6,'#cfc0a0');
    const wl=_inT(f,tx-1,ty), wr=_inT(f,tx+1,ty);
    if(!_WALLISH.has(wl)&&wl!==9) px(x,y+4,2,12,'#5e4630');           // timber posts at run breaks
    if(!_WALLISH.has(wr)&&wr!==9) px(x+14,y+4,2,12,'#5e4630');
  } else {
    px(x,y,TILE,TILE,'#4a3626'); px(x,y,TILE,1,'#5e4630');            // cap only
    px(x,y+15,TILE,1,'#32241a');
    const h1=_inHash(tx,ty)%7; px(x+2+h1,y+4+(_inHash(tx,ty)>>3)%8,2,1,'#54402c');
  }
}
function drawIntFloor(x,y,tx,ty){
  const h=_inHash(tx,ty);
  px(x,y,TILE,TILE,'#a8825a');
  px(x,y+5,TILE,1,'#96714a'); px(x,y+11,TILE,1,'#96714a');            // plank seams
  if(h%3===0) px(x+((h>>2)%12),y,1,5,'#96714a');
  if((h>>4)%3===0) px(x+((h>>6)%12),y+6,1,5,'#96714a');
  px(x+2+(h%9),y+2,3,1,'#b48c62'); px(x+7-(h>>3)%5,y+8,3,1,'#b48c62');
  if((h%11)===0) px(x+4+(h>>4)%6,y+13,2,1,'#8a6a44');
}
// per-town accent colors: rug/blanket hues follow the town the building serves.
const INT_ACCENT = { ih:'#8a3a2a', sm:'#3a6a8a', tw:'#3a6a3a', dh:'#b8862a',
  cp:'#5a7aa8', af:'#b85a2a', sg:'#2f4a8f', sh:'#5a3a6a' };
function _intAccent(){ const id=place.id||''; const p=id.slice(0,2);
  return INT_ACCENT[p] || '#9a3b4a'; }
// ── A BED ── Two tiles, head above foot. Cottages had nothing to sleep on but a
// rug, which is a poor thing to wake a new knight on. Warm linen against the
// cottage's dark boards, a carved frame, and a pillow at the head.
function drawIntRug(x,y,tx,ty,f){
  // rug sits on stone in keeps, wood elsewhere (checked by neighbourhood)
  const stony=(t)=>t===53||t===55||t===56||t===58||t===66;
  if(stony(_inT(f,tx-1,ty))||stony(_inT(f,tx+1,ty))||stony(_inT(f,tx,ty-1))||stony(_inT(f,tx,ty+1)))
    drawIntStone(x,y,tx,ty); else drawIntFloor(x,y,tx,ty);
  const is=(t)=>t===13;
  const n=is(_inT(f,tx,ty-1)), s=is(_inT(f,tx,ty+1)), w=is(_inT(f,tx-1,ty)), e=is(_inT(f,tx+1,ty));
  const x0=w?x:x+1, x1=e?x+TILE:x+TILE-1, y0=n?y:y+1, y1=s?y+TILE:y+TILE-1;
  const ac=_intAccent();
  px(x0,y0,x1-x0,y1-y0,ac);
  if(!n) px(x0,y0,x1-x0,1,'#c8a038'); if(!s) px(x0,y1-1,x1-x0,1,'#c8a038');
  if(!w) px(x0,y0,1,y1-y0,'#c8a038'); if(!e) px(x1-1,y0,1,y1-y0,'#c8a038');
  const h=_inHash(tx,ty); px(x+4+(h%5),y+4+(h>>3)%5,2,2,_shadeHex(ac,1.25));
}
function drawIntWindow(x,y,tx,ty,f){
  drawIntWall(x,y,tx,ty,f);
  px(x+3,y+5,10,8,'#5e4630');
  px(x+4,y+6,8,6,'#9fd0e8'); px(x+4,y+6,8,2,'#c8e8f4');
  px(x+7,y+6,1,6,'#5e4630'); px(x+4,y+8,8,1,'#5e4630');
  px(x+3,y+13,10,1,'#8a6a44');
}
function drawIntShelfWall(x,y,tx,ty,f){
  drawIntWall(x,y,tx,ty,f);
  px(x+1,y+11,14,1,'#5e4630');
  const cols=['#8a3a4a','#3a6a4a','#b8862a','#4a5a8a','#7a4a2a'];
  const h=_inHash(tx,ty);
  for(let i=0;i<4;i++){ const c=cols[(h>>i)%5];
    px(x+2+i*3+((h>>(i+2))&1),y+7,2,4,c); px(x+2+i*3+((h>>(i+2))&1),y+7,2,1,'rgba(255,255,255,0.2)'); }
}
function drawIntFireplace(x,y){
  px(x,y,TILE,4,'#4a3626'); px(x,y,TILE,1,'#5e4630');
  px(x,y+4,TILE,12,'#8a8274'); px(x,y+4,TILE,1,'#a39c8e');            // stone breast
  px(x+1,y+5,2,2,'#9a9486'); px(x+12,y+7,3,2,'#7a7466');
  px(x+2,y+7,12,9,'#2a1a12');                                          // firebox
  px(x+2,y+7,12,1,'#4a3626'); px(x+2,y+7,1,9,'#6a6458'); px(x+13,y+7,1,9,'#6a6458');
  const fr=Math.floor(Date.now()/280)%2;
  px(x+5,y+10+fr,6,4-fr,'#e85a1a'); px(x+6,y+9+fr,4,3,'#ff8a2a'); px(x+7,y+10,2,2,'#ffd060');
  px(x+4,y+13,8,2,'#6a3a1a'); px(x+4,y+14,8,1,'#4a2a12');              // logs
}
function drawIntTable(x,y,tx,ty,f){
  drawIntFloor(x,y,tx,ty);
  const l=_inT(f,tx-1,ty)===40, r=_inT(f,tx+1,ty)===40;
  const x0=l?x:x+1, x1=r?x+TILE:x+TILE-1;
  px(x0,y+13,x1-x0,2,'rgba(20,10,4,0.3)');
  px(x0,y+3,x1-x0,8,'#8a5c32'); px(x0,y+3,x1-x0,1,'#b8895a');
  px(x0,y+10,x1-x0,1,'#5e3a1c');
  if(!l) px(x+2,y+11,2,3,'#5e3a1c');
  if(!r) px(x+12,y+11,2,3,'#5e3a1c');
  const h=_inHash(tx,ty); if((h%3)===0){ px(x+6,y+5,4,3,'#d8b070'); px(x+7,y+4,2,1,'#b8862a'); }
}
function drawIntChair(x,y,tx,ty,f){
  drawIntFloor(x,y,tx,ty);
  const tL=_inT(f,tx-1,ty)===40, tR=_inT(f,tx+1,ty)===40, tU=_inT(f,tx,ty-1)===40;
  px(x+4,y+13,8,2,'rgba(20,10,4,0.3)');
  px(x+4,y+7,8,6,'#7a4e28'); px(x+4,y+7,8,1,'#96683a');
  if(tR){ px(x+4,y+3,2,10,'#5e3a1c'); px(x+4,y+3,1,10,'#7a4e28'); }
  else if(tL){ px(x+10,y+3,2,10,'#5e3a1c'); px(x+11,y+3,1,10,'#7a4e28'); }
  else if(tU){ px(x+4,y+11,8,2,'#5e3a1c'); px(x+4,y+11,8,1,'#7a4e28'); }
  else { px(x+4,y+3,8,2,'#5e3a1c'); px(x+4,y+3,8,1,'#7a4e28'); }
  px(x+4,y+13,1,2,'#4a2e14'); px(x+11,y+13,1,2,'#4a2e14');
}
function drawIntBed(x,y,head){
  const inn = INTERIORS[place.id] && INTERIORS[place.id].theme==='inn';
  const blank = inn ? '#4a5a9a' : _intAccent(), blankL = _shadeHex(blank,1.28);
  if(head){
    px(x+2,y,12,3,'#5e3a1c'); px(x+2,y,12,1,'#7a4e28');
    px(x+2,y+3,12,13,'#e8e0d0');
    px(x+3,y+4,10,5,'#ffffff'); px(x+3,y+4,10,1,'#f0ece0');
    px(x+3,y+8,10,1,'#c8c0b0');
    px(x+2,y+11,12,5,blank); px(x+2,y+11,12,1,blankL);
    px(x+1,y+3,1,13,'#3a281a'); px(x+14,y+3,1,13,'#3a281a');
  } else {
    px(x+2,y,12,11,blank);
    px(x+4,y+1,8,1,blankL); px(x+3,y+4,10,1,blankL);
    px(x+2,y+11,12,2,'#5e3a1c'); px(x+2,y+11,12,1,'#7a4e28');
    px(x+1,y,1,12,'#3a281a'); px(x+14,y,1,12,'#3a281a');
    px(x+2,y+13,12,2,'rgba(20,10,4,0.3)');
  }
}
function drawIntBookshelf(x,y,tx,ty){
  px(x+1,y+14,14,2,'rgba(20,10,4,0.3)');
  px(x+1,y,14,14,'#5e3a1c'); px(x+1,y,14,1,'#7a4e28');
  const cols=['#8a3a4a','#3a6a4a','#b8862a','#4a5a8a','#7a4a2a','#6a4a8a'];
  const h=_inHash(tx,ty);
  for(let s=0;s<2;s++){ const sy=y+2+s*6;
    px(x+2,sy,12,5,'#2a1a0e');
    for(let i=0;i<5;i++){ const c=cols[(h>>(i+s*3))%6];
      px(x+3+i*2,sy+((h>>(i+s))&1),2,5-((h>>(i+s))&1),c); }
    px(x+2,sy+5,12,1,'#7a4e28'); }
}
function drawIntCounter(x,y,tx,ty,f){
  drawIntFloor(x,y,tx,ty);
  const l=_inT(f,tx-1,ty)===46, r=_inT(f,tx+1,ty)===46;
  const x0=l?x:x+1, x1=r?x+TILE:x+TILE-1;
  px(x0,y+2,x1-x0,5,'#96683a'); px(x0,y+2,x1-x0,1,'#c8a068');
  px(x0,y+7,x1-x0,7,'#6a4222'); px(x0,y+7,x1-x0,1,'#4a2e14');
  px(x0,y+14,x1-x0,2,'rgba(20,10,4,0.3)');
  const h=_inHash(tx,ty); if((h%3)===0){ px(x+5,y+3,2,3,'#d8c890'); px(x+9,y+3,2,3,'#b8862a'); }
}
function drawIntCabinet(x,y,tx,ty,f){
  const t=_inT(f,tx,ty-1)===47, b=_inT(f,tx,ty+1)===47;
  px(x,y,TILE,TILE,'#a8825a');                                         // floor peek at edges
  px(x,y+(t?0:1),13,15-(t?0:1)-(b?0:1),'#7a4e28');
  px(x,y+(t?0:1),13,1,'#96683a');
  px(x,y+3,13,3,'#c8a068'); px(x,y+3,13,1,'#e0c089');                  // counter surface
  px(x+2,y+8,9,3,'#5e3a1c'); px(x+6,y+9,1,1,'#d8b24a');
  px(x+2,y+12,9,3,'#5e3a1c'); px(x+6,y+13,1,1,'#d8b24a');
  const h=_inHash(tx,ty); if((h&1)===0){ px(x+3,y+1,5,2,'#8a8274'); px(x+4,y,3,1,'#6a6458'); }
}
function drawIntBarrel(x,y,tx,ty){
  drawIntFloor(x,y,tx,ty);
  px(x+3,y+13,10,2,'rgba(20,10,4,0.3)');
  px(x+3,y+3,10,11,'#8a5c32'); px(x+4,y+2,8,1,'#8a5c32');
  px(x+4,y+3,2,11,'#a06c3c');
  px(x+3,y+5,10,1,'#3a281a'); px(x+3,y+10,10,1,'#3a281a');
  px(x+4,y+2,8,2,'#6a4222'); px(x+5,y+2,6,1,'#96683a');
}
function drawIntPlant(x,y,tx,ty){
  drawIntFloor(x,y,tx,ty);
  px(x+5,y+11,6,4,'#9a5c3a'); px(x+5,y+11,6,1,'#b87048'); px(x+4,y+14,8,1,'#7a4222');
  px(x+7,y+5,2,6,'#3a7a42');
  px(x+4,y+3,4,4,'#2f7d3a'); px(x+8,y+2,4,4,'#3fa050'); px(x+6,y+5,4,3,'#52b863');
  px(x+9,y+3,1,1,'#8fd692');
}
function drawIntDresser(x,y,tx,ty){
  drawIntFloor(x,y,tx,ty);
  px(x+2,y+14,12,2,'rgba(20,10,4,0.3)');
  px(x+2,y+4,12,10,'#7a4e28'); px(x+2,y+4,12,1,'#96683a');
  px(x+3,y+6,10,3,'#5e3a1c'); px(x+7,y+7,2,1,'#d8b24a');
  px(x+3,y+10,10,3,'#5e3a1c'); px(x+7,y+11,2,1,'#d8b24a');
  const h=_inHash(tx,ty);
  if((h&1)===0){ px(x+11,y+1,2,3,'#e8e0c8'); px(x+11,y,2,1,'#f2c14e'); }
  else { px(x+4,y+1,3,3,'#8a8274'); px(x+5,y+2,1,1,'#c8e8f4'); }
}
// per-tile dispatcher; returns true when handled (drawTile falls through otherwise)
function drawInteriorTile(t,x,y,tx,ty){
  const f=_inGrid();
  if(tx<0||ty<0||tx>=f.w||ty>=f.h){ px(x,y,TILE,TILE,'#100c14'); return true; }   // beyond the room: dark void
  switch(t){
    case 5:  drawIntWall(x,y,tx,ty,f); return true;
    case 12: drawIntFloor(x,y,tx,ty); return true;
    case 61: drawIntBed(x,y,true);  return true;   // the head, with the pillow
    case 62: drawIntBed(x,y,false); return true;   // the foot
    case 13: drawIntRug(x,y,tx,ty,f); return true;
    case 40: drawIntTable(x,y,tx,ty,f); return true;
    case 41: drawIntChair(x,y,tx,ty,f); return true;
    case 42: drawIntBed(x,y,true); return true;
    case 43: drawIntBed(x,y,false); return true;
    case 44: drawIntBookshelf(x,y,tx,ty); return true;
    case 45: drawIntFireplace(x,y); return true;
    case 46: drawIntCounter(x,y,tx,ty,f); return true;
    case 47: drawIntCabinet(x,y,tx,ty,f); return true;
    case 48: drawIntBarrel(x,y,tx,ty); return true;
    case 49: drawIntPlant(x,y,tx,ty); return true;
    case 50: drawIntDresser(x,y,tx,ty); return true;
    case 51: drawIntWindow(x,y,tx,ty,f); return true;
    case 52: drawIntShelfWall(x,y,tx,ty,f); return true;
    case 53: drawIntStone(x,y,tx,ty); return true;
    case 54: drawIntBanner(x,y,tx,ty,f); return true;
    case 55: drawIntWeaponRack(x,y,tx,ty); return true;
    case 56: drawIntArmorStand(x,y,tx,ty); return true;
    case 57: drawIntShieldWall(x,y,tx,ty,f); return true;
    case 58: drawIntBrazier(x,y,tx,ty); return true;
    case 59: drawIntCrate(x,y,tx,ty); return true;
    case 60: drawIntGoodsShelf(x,y,tx,ty,f); return true;
    case 10: case 11: {   // ★ STAIRS INDOORS — the overworld renderer draws treads
      //  that blend into stone ground, which on an interior floor is invisible.
      //  A stairwell needs a dark opening, a lit lip and an arrow you can see.
      drawIntFloor(x,y,tx,ty);
      px(x+1,y+1,14,14,'#3e352e');                      // the well, cut into the floor
      px(x+2,y+2,12,12,'#6d6053');
      for(let i=0;i<3;i++){ px(x+3,y+3+i*4,10,3,'#8a7d6c'); px(x+3,y+3+i*4,10,1,'#a89a86'); }
      if(t===11){ px(x+2,y+2,12,3,'#1d1712'); px(x+2,y+2,12,1,'#120e0b'); }   // down: dark at the top
      else { px(x+2,y+11,12,3,'#1d1712'); px(x+2,y+12,12,1,'#e8d8b8'); }      // up: light spilling
      { const up=(t===10), cy=up?5:9, s=up?-1:1;        // the arrow
        px(x+7,cy,2,4,'#ffe9a8');
        px(x+6,cy+(up?0:3),4,1,'#ffe9a8'); px(x+5,cy+(up?1:2),6,1,'#ffe9a8'); }
      return true; }
    case 17: {   // ★ CARVED STONE — throne, altar, plinth, pillar, lamp pedestal.
      //  Solid indoors (walkable() already treats 17 as a block), but it used to
      //  fall through to the overworld case and render as a flat brown square.
      drawIntFloor(x,y,tx,ty);
      px(x+2,y+2,12,13,'#6d6053'); px(x+2,y+2,12,2,'#9a8b78');
      px(x+2,y+2,1,13,'#8a7d6c'); px(x+13,y+2,1,13,'#4a4038');
      px(x+3,y+6,10,1,'#4a4038'); px(x+3,y+10,10,1,'#4a4038');
      px(x+2,y+14,12,1,'#332b26');
      if(((tx*31+ty*17)&7)===0) px(x+5,y+8,3,2,'#7d7062');
      return true; }
    case 66: drawIntFootlocker(x,y,tx,ty); return true;
    case 67: drawIntHay(x,y,tx,ty); return true;
  }
  return false;   // doors, stairs, anything else → the shared cases below
}
// light overlay: window pools + fireplace glow (drawn after the ground pass,
// camX/camY are draw()-local and MUST be passed in)
function drawInteriorLight(camX,camY){
  if(place.kind!=='interior') return;
  const it=INTERIORS[place.id]; if(!it||it.theme==='sanctuary') return;
  const f=it.floors[place.floor], G=f.g;
  for(let ty=0;ty<f.h;ty++)for(let tx=0;tx<f.w;tx++){
    const t=G[ty][tx];
    if(t!==51&&t!==45&&t!==58) continue;
    const sx=Math.round(tx*TILE-camX), sy=Math.round(ty*TILE-camY);
    if(sx<-TILE*3||sy<-TILE*3||sx>VW+TILE*3||sy>VH+TILE*3) continue;
    if(t===51 && G[ty+1] && (G[ty+1][tx]===12||G[ty+1][tx]===13)){
      ctx.fillStyle='rgba(255,244,200,0.14)';
      ctx.fillRect(sx+2,sy+TILE,TILE-4,TILE); ctx.fillRect(sx+4,sy+TILE*2,TILE-8,Math.round(TILE*0.7));
    }
    if(t===45){
      const g=ctx.createRadialGradient(sx+8,sy+12,2, sx+8,sy+12,TILE*2.4);
      g.addColorStop(0,'rgba(255,150,50,0.22)'); g.addColorStop(1,'rgba(255,150,50,0)');
      ctx.fillStyle=g; ctx.fillRect(sx-TILE*2.5,sy-TILE,TILE*6,TILE*4);
    }
    if(t===58){
      const g=ctx.createRadialGradient(sx+8,sy+6,2, sx+8,sy+6,TILE*1.8);
      g.addColorStop(0,'rgba(255,150,50,0.18)'); g.addColorStop(1,'rgba(255,150,50,0)');
      ctx.fillStyle=g; ctx.fillRect(sx-TILE*1.5,sy-TILE,TILE*4,TILE*3);
    }
  }
}

// ── keep / shop tile art (rollout: stone halls, armories, wares) ──
function drawIntStone(x,y,tx,ty){
  const h=_inHash(tx,ty);
  px(x,y,TILE,TILE,'#a8a094');
  px(x,y,TILE,1,'#b8b0a2'); px(x,y+8,TILE,1,'#8e857a');
  px(x+((h&1)?4:10),y,1,8,'#8e857a'); px(x+(((h>>2)&1)?7:2),y+9,1,7,'#8e857a');
  if(h%4===0) px(x+2+(h>>3)%8,y+3,3,2,'#b4ac9e');
  if(h%9===0){ px(x+3+(h>>4)%6,y+11,3,1,'#7a7268'); px(x+5+(h>>4)%6,y+12,2,1,'#7a7268'); }
}
function _intHer(){ const id=place.id||''; // keep heraldry by prefix
  if(id.slice(0,2)==='ih') return {main:'#8a3a2a',trim:'#e8c766'};
  return {main:'#2f4a8f',trim:'#e8c766'}; }
function drawIntBanner(x,y,tx,ty,f){
  drawIntWall(x,y,tx,ty,f);
  const her=_intHer();
  px(x+4,y+2,8,12,her.main); px(x+4,y+2,8,1,_shadeHex(her.main,1.35));
  px(x+4,y+13,3,2,her.main); px(x+9,y+13,3,2,her.main);
  px(x+6,y+5,4,3,her.trim); px(x+7,y+4,1,2,_shadeHex(her.trim,1.2)); px(x+8,y+4,1,1,_shadeHex(her.trim,1.2));
  px(x+3,y+2,1,12,_shadeHex(her.main,0.55)); px(x+12,y+2,1,12,_shadeHex(her.main,0.55));
  px(x+2,y+1,12,1,'#5e4630');
}
function drawIntShieldWall(x,y,tx,ty,f){
  drawIntWall(x,y,tx,ty,f);
  const her=_intHer();
  px(x+5,y+4,6,7,her.main); px(x+5,y+4,6,1,_shadeHex(her.main,1.35));
  px(x+6,y+11,4,2,her.main); px(x+7,y+13,2,1,_shadeHex(her.main,0.55));
  px(x+7,y+4,2,9,her.trim); px(x+5,y+7,6,1,her.trim);
  px(x+4,y+4,1,8,_shadeHex(her.main,0.5)); px(x+11,y+4,1,8,_shadeHex(her.main,0.5));
}
function drawIntWeaponRack(x,y,tx,ty){
  drawIntStone(x,y,tx,ty);
  px(x+1,y+14,14,2,'rgba(10,8,4,0.3)');
  px(x+1,y+12,14,2,'#5e3a1c'); px(x+1,y+3,2,11,'#5e3a1c'); px(x+13,y+3,2,11,'#5e3a1c');
  px(x+1,y+3,14,2,'#7a4e28'); px(x+1,y+3,14,1,'#96683a');
  for(let i=0;i<3;i++){ const sx2=x+5+i*3;
    px(sx2,y+5,1,7,'#c8d0d8'); px(sx2,y+5,1,2,'#eef2f6');
    px(sx2-1,y+11,3,1,'#e8c766'); px(sx2,y+12,1,2,'#7a4e28'); }
}
function drawIntArmorStand(x,y,tx,ty){
  drawIntStone(x,y,tx,ty);
  px(x+4,y+14,8,2,'rgba(10,8,4,0.3)');
  px(x+7,y+3,2,11,'#5e3a1c');
  px(x+5,y+1,6,4,'#b8c0c8'); px(x+6,y,4,2,'#c8d0d8'); px(x+6,y+2,4,1,'#8a929a');
  px(x+4,y+5,8,6,'#b8c0c8'); px(x+4,y+5,8,1,'#dde3e8');
  px(x+3,y+5,1,4,'#8a929a'); px(x+12,y+5,1,4,'#8a929a');
  px(x+7,y+6,2,4,'#8a929a');
  px(x+5,y+13,6,2,'#5e3a1c'); px(x+5,y+13,6,1,'#7a4e28');
}
function drawIntBrazier(x,y,tx,ty){
  drawIntStone(x,y,tx,ty);
  px(x+4,y+14,8,2,'rgba(10,8,4,0.3)');
  px(x+4,y+8,8,4,'#8a6a2e'); px(x+4,y+8,8,1,'#b8944a');
  px(x+6,y+12,4,2,'#6a4e1e'); px(x+5,y+14,6,1,'#5a421a');
