  }
})();
*/
(function homesteadSanctuary(){
  const G=WORLD;
  const hash=(x,y)=>((x*374761393+y*668265263)>>>0);

  // ════════════════════════════════════════════════════════════════
  //  THE HOMESTEAD — relocated & redesigned (v13).
  //  A clearing in the woods inside the Forest of Disillusionment's dead
  //  overworld footprint (already-walled, unreachable grid). Entered from the
  //  SOUTH via a long flowered approach off the Saltmere road, crossing a
  //  footbridge over the creek that forms the clearing's southern boundary.
  //  Every farm/fish/decor system runs unchanged because this is still a real
  //  overworld region — no interior instance needed.
  // ════════════════════════════════════════════════════════════════
  const KEEP=new Set([5,9]);   // never overwrite building walls/doors

  // ── CLEANUP: the Homestead moved out of the old northern vale (x95-123,y4-36).
  //    Reset that abandoned footprint to natural meadow (grass + light tree
  //    scatter to blend with the surrounding north country), drop its orphaned
  //    signs, and RE-HOME its ambient set-dressing into the new clearing.
  for(let y=4;y<=36;y++) for(let x=95;x<=123;x++){ if(!G[y]) continue;
    G[y][x]=0; setElev(x,y,0);
    if(hash(x,y)%100<24) G[y][x]=1; else if(hash(x*3,y*7)%100<6) G[y][x]=7;
  }
  // erase the orphaned south-gate road stub that used to feed the old vale
  for(let y=33;y<=37;y++) for(let x=88;x<=95;x++){ if(G[y]&&(G[y][x]===2||G[y][x]===10||G[y][x]===11)){
    G[y][x]=(hash(x,y)%100<28)?1:0; } }
  for(const k of ['100,28','99,20','100,29','111,30','114,34','96,24']) delete signs[k];
  { const move={ scarecrow:[[16,155],[27,155]], haystack:[[20,150]], planter:[[20,138],[30,137]], bucket:[[37,162]] };
    const used={};
    for(const d of decorations){ if(d.x>=95&&d.x<=123&&d.y>=4&&d.y<=36 && move[d.kind]){
      const list=move[d.kind]; const i=(used[d.kind]||0); if(i<list.length){ d.x=list[i][0]; d.y=list[i][1]; used[d.kind]=i+1; }
    } }
  }

  // clearing = main rect (x8-44,y120-163) + a SE lobe that embraces the pond
  const inC=(x,y)=> (x>=8&&x<=44&&y>=120&&y<=163) || (x>=28&&x<=49&&y>=158&&y<=177);

  // 0) CARVE the clearing to grass, preserving the hidden lake (water 3 / sand 19)
  for(let y=118;y<=179;y++) for(let x=6;x<=51;x++){
    if(!inC(x,y)) continue; const t=G[y][x];
    if(t===3||t===19) continue; G[y][x]=0; setElev(x,y,0);
  }
  // organic fringe: woods press IN with decreasing density toward the edge
  for(let y=118;y<=179;y++) for(let x=6;x<=51;x++){
    if(!inC(x,y)||G[y][x]!==0) continue;
    let d=5; outer: for(let r=1;r<=4;r++){ for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++){
      if(Math.max(Math.abs(dx),Math.abs(dy))!==r) continue;
      if(!inC(x+dx,y+dy)){ d=r-1; break outer; } } }
    const r=hash(x,y)%100;
    if(d===0&&r<88) G[y][x]=1; else if(d===1&&r<50) G[y][x]=1;
    else if(d===2&&r<24) G[y][x]=1; else if(d===3&&r<10) G[y][x]=1;
    else if(d<=4&&r>=91) G[y][x]=7;   // forest-floor tufts just inside the tree line
  }

  // 1) BUILDINGS — farmhouse central, merchant bazaar NE, barn W
  const HB={ home_house:[22,135,25,139], dh_shop:[33,123,35,126], home_barn:[9,146,10,149] };
  for(const b of buildings){ const p=HB[b.id]; if(!p) continue; b.x=p[0]; b.y=p[1]; b.door={x:p[2],y:p[3]}; }
  for(const b of buildings){ if(HB[b.id]) stampBuilding(G,b); }

  // 2) THE CREEK — the clearing's southern boundary. Flat through the bridge
  //    reach, one soft meander, then a gentle SE descent spilling into the pond.
  const carve=(x,y)=>{ if(!G[y])return; if(KEEP.has(G[y][x]))return; G[y][x]=3; setElev(x,y,0); };
  for(let x=6;x<=19;x++){ carve(x,162); carve(x,163); }                    // flat reach (bridge here)
  for(let x=20;x<=27;x++){ const w=(x>=22&&x<=25)?1:0; carve(x,162+w); carve(x,163+w); }  // soft meander
  carve(21,163); carve(26,163);                                           // widen the bend shoulders
  carve(28,163); carve(28,164); carve(29,163); carve(29,164);            // begin the descent
  carve(30,164); carve(30,165); carve(31,164); carve(31,165);
  carve(32,165); carve(32,166); carve(33,165); carve(33,166);
  carve(34,166); carve(34,167); carve(35,167); carve(35,168); carve(36,167); carve(36,168);  // fuse into the NW shore

  // 3) FISHING — register every homestead water tile (creek + pond) as zone 'pond'.
  //    (fishZoneAt already classifies any overworld water; this makes the sign hints
  //    and rewards consistent, and clears any stale pond entries from old coords.)
  for(const k in FISH_SPOTS) if(FISH_SPOTS[k]==='pond') delete FISH_SPOTS[k];
  for(let y=118;y<=179;y++) for(let x=6;x<=51;x++){ if(inC(x,y)&&G[y]&&G[y][x]===3) FISH_SPOTS[x+','+y]='pond'; }

  // 4) FARM PLOTS — two tidy strips between the farmhouse and the creek
  const plots=[];
  const plot=(x,y)=>{ if(G[y]&&(G[y][x]===0||G[y][x]===4)){ G[y][x]=31; plots.push([x,y]); } };
  for(let y=151;y<=153;y++) for(let x=17;x<=26;x++) plot(x,y);
  for(let y=156;y<=158;y++) for(let x=17;x<=26;x++) plot(x,y);
  FARM_PLOTS.length=0; plots.forEach(p=>FARM_PLOTS.push(p));

  // 5) WAGON BAY — packed-dirt hardstand beside the barn (the supply-wagon's home)
  for(let y=146;y<=150;y++) for(let x=15;x<=18;x++){ if(G[y][x]===0) G[y][x]=2; }
  decorations.push({x:16,y:147,kind:'haycart',w:2});

  // 6) THE CORRAL — a small fenced pasture just beneath the farmhouse; the four
  //    King's-Tourney horses graze here, and the gate-post IS the race booth.
  for(let x=21;x<=29;x++){ if(G[142][x]===0||G[142][x]===7) G[142][x]=14; if(G[146][x]===0||G[146][x]===7) G[146][x]=14; }
  for(let y=142;y<=146;y++){ if(G[y][21]===0||G[y][21]===7) G[y][21]=14; if(G[y][29]===0||G[y][29]===7) G[y][29]=14; }
  for(let y=143;y<=145;y++) for(let x=22;x<=28;x++){ if(G[y][x]!==0) G[y][x]=0; }   // clean interior grass
  { const HORSES=[['#4a5a7a','#1f2a40',23,144],['#9a4528','#4a1f10',26,143],['#d8d0c0','#a89878',24,145],['#3a3040','#15101a',28,144]];
    HORSES.forEach(([c,m,x,y])=>decorations.push({x,y,kind:'horse',w:1,c,m})); }
  { const bx=25, by=142; if(G[by]) G[by][bx]=16;
    signs[bx+','+by]="🐎 THE KING'S TOURNEY\nThe corral gate. Face it and press Ⓐ\nto saddle up and ride the tourney.";
    RACE_SPOTS.push(bx+','+by); }

  // 7) THE OLD MULE stands beside the wagon bay; the SUPPLY WAGON parks on the
  //    bay tile (WAGON_HOME 19,148). Before the hunt is done the wagon is hidden
  //    and the mule's sign hints at what's coming; unlockWagonIfReady swaps it.
  { const mx=18, my=148; decorations.push({x:mx,y:my,kind:'mule',w:1}); if(G[my]) G[my][mx]=5;
    signs[mx+','+my]="Old Mule\n(He eyes the empty cart-hitch, ears twitching —\nas if he knows the roads will need him soon.)";
    // the parked-wagon interaction sign lives on its bay tile
    signs['19,148']="🛒 THE SUPPLY WAGON\nThe family cart, waiting in the bay.\n(It will roll once the roads are safe.)"; }

  // 8) PATHS + THE BRIDGE — one clean network, no dead-ends.
  const P=(x,y)=>{ if(!G[y]) return; const t=G[y][x]; if(t===0||t===7||t===4) G[y][x]=2; else if(t===3) G[y][x]=12; };
  const vrun=(x,a,b)=>{ for(let y=Math.min(a,b);y<=Math.max(a,b);y++) P(x,y); };
  const hrun=(y,a,b)=>{ for(let x=Math.min(a,b);x<=Math.max(a,b);x++) P(x,y); };
  vrun(13,140,164);                        // MAIN LANE: over the bridge (creek→12) up to the farmhouse row
  hrun(150,10,13);                         // -> barn door (10,149) approach
  hrun(140,13,25);                         // -> farmhouse door (25,139) approach
  vrun(35,127,130); hrun(130,25,35); vrun(25,130,140);   // farmhouse -> merchant bazaar (clean L)
  hrun(154,13,28);                         // field lane between the two strips -> farm stand
  vrun(30,154,160); hrun(160,30,38); vrun(38,160,164);   // spur down to the pond's north shore (fishing)

  // 9) FARM STAND — at the field corner; stand below & face up to sell
  const stand=decorations.find(d=>d.kind==='farmStand'); if(stand){ stand.x=28; stand.y=152; }
  if(G[152]){ G[152][28]=5; G[152][29]=5; }              // 2-wide footprint = solid
  SELL_SPOT='28,153';                                    // player stands here, faces NORTH to sell
  if(G[153]&&G[153][27]===0){ G[153][27]=16; signs['27,153']='FARM STAND\nStand below it, face up, press Ⓐ\nto sell your wheat & fish for gold!'; }

  // 10) relocate farmer villagers onto dry ground in the new clearing
  { let fi=0; const spots=[[20,153],[24,157],[31,151]]; villagers.filter(v=>v.outfit==='farmer').forEach(farm=>{ const s=spots[fi++%spots.length]; farm.x=s[0]*TILE; farm.y=s[1]*TILE; farm.hx=s[0]; farm.hy=s[1]; farm.tx=s[0]; farm.ty=s[1]; }); }

  // 11) SIGNS — welcome at the bridge, how-tos by fields & pond
  if(G[160]&&G[160][14]===0){ G[160][14]=16; signs['14,160']='THE HOMESTEAD\nYour reward, brave knight.\nRest here a while. '+'🌾'; }
  if(G[151]&&G[151][16]===0){ G[151][16]=16; signs['16,151']='THE FIELDS\nFace a plot, press Ⓐ to plant.\nCome back later to harvest the wheat!'; }
  if(G[161]&&G[161][39]===0){ G[161][39]=16; signs['39,161']='THE POND\nStand on the bank, face the water,\npress Ⓐ to cast a line!'; }

  // 12) THE APPROACH — a long flowered pathway from the Saltmere road up through
  //     the wood to the bridge. Road joint at (30,187) -> west along y187 -> north
  //     up x13 to the bridge. A lush two-deep flower border hugs the whole run,
  //     with blossoming trees spaced like an avenue; dense wood kept beyond.
  for(let x=13;x<=30;x++){ if(G[187]) G[187][x]=2; }
  for(let y=164;y<=187;y++){ if(G[y]&&G[y][13]!==12) G[y][13]=2; }
  // clear a 2-tile-wide green margin either side of the path (so flowers read against grass, not trees)
  const clear=(x,y)=>{ if(G[y]&&G[y][x]===1) G[y][x]=0; };
  for(let x=11;x<=32;x++){ clear(x,185); clear(x,186); clear(x,188); clear(x,189); }
  for(let y=164;y<=189;y++){ for(const x of [11,12,14,15]) clear(x,y); }
  // lay flowers (tile 4 = blooms) along the immediate verge, denser nearest the path
  const flower=(x,y,p)=>{ if(G[y]&&(G[y][x]===0)&&hash(x,y)%100<p) G[y][x]=4; };
  for(let x=11;x<=32;x++){ flower(x,186,80); flower(x,188,80); flower(x,185,45); flower(x,189,45); }
  for(let y=164;y<=189;y++){ flower(12,y,80); flower(14,y,80); flower(11,y,45); flower(15,y,45); }
  // blossoming avenue trees, evenly spaced just beyond the flower border
  const avenue=(x,y)=>{ if(G[y]&&(G[y][x]===0||G[y][x]===4)) G[y][x]=1; };
  for(let y=166;y<=186;y+=4){ avenue(10,y); avenue(16,y+2); }
  for(let x=14;x<=30;x+=4){ avenue(x,184); avenue(x+2,190); }

  // 12b) WILDFLOWER MEADOW — a final light bloom scatter across the clearing,
  //      run LAST so it only ever touches leftover plain grass (never plots,
  //      paths, buildings, signs, corral, or the bay).
  for(let y=120;y<=177;y++) for(let x=8;x<=49;x++){
    if(inC(x,y) && G[y] && G[y][x]===0 && hash(x*7,y*3)%100<9) G[y][x]=4;
  }

  // 13) 🐎 capital race booth — the grand tourney post in Stormgate's plaza (unchanged)
  { const bx=172, by=207; if(WORLD[by]) WORLD[by][bx]=16;
    signs[bx+','+by]="🐎 THE KING'S TOURNEY\nThe royal racing grounds.\nFace it and press Ⓐ to ride.";
    RACE_SPOTS.push(bx+','+by);
    for(let yy=by-1; yy<=by+2; yy++) for(let xx=bx-2; xx<=bx+1; xx++){
      if(xx===bx && yy===by) continue;
      if(WORLD[yy] && WORLD[yy][xx]===6) WORLD[yy][xx]=18;
    }
    WORLD[by][bx]=16;
  }
})();



// ── THE HOMESTEAD APPROACH ──
// One clean road from the south, joining the Pilgrim's Way to the homestead gate,
// and tidy away the old redundant/dead pilgrim spur.
(function homesteadApproach(){
  const G=WORLD;
  const road=(x,y)=>{ if(G[y]&&[0,1,7].includes(G[y][x])) G[y][x]=2; };
  // _legacy: this used to draw the OLD homestead's south-gate road (x104→x94 along
  //   row 35, welding onto the Pilgrim's Way). The Homestead was relocated to the
  //   southern Fog-Wood clearing (see homesteadSanctuary), whose approach now runs
  //   from the Saltmere road. The old road-draw is removed so it doesn't recreate an
  //   orphan dead-end into the vacated northern meadow. The defensive stub-prunes
  //   below are kept (harmless no-ops on the new layout).
  void road;
  // PRUNE the redundant southward dead stub (x58-59, rows 34-45) that leads nowhere
  for(let y=34;y<=46;y++) for(const x of [58,59]){ if(G[y]&&G[y][x]===2){
    // only remove if it dead-ends (no road continuing south/around)
    G[y][x]=0;
  } }
  // and prune the old vertical homestead spur (x100-101, rows 20-31) if it now dead-ends
  for(let pass=0;pass<8;pass++) for(let y=18;y<=32;y++) for(const x of [100,101]){
    if(G[y]&&G[y][x]===2){
      let n=0; for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]) if(G[y+dy]&&(G[y+dy][x+dx]===2||G[y+dy][x+dx]===12)) n++;
      let dest=false; for(let oy=-1;oy<=1;oy++)for(let ox=-1;ox<=1;ox++){ const t=G[y+oy]&&G[y+oy][x+ox]; if([9,16,31,12,19].includes(t)) dest=true; }
      if(n<=1 && !dest) G[y][x]=0;
    }
  }
})();


// ── SALTMERE'S APPROACH: the Ironhold road used to dead-end at the town's
// back fence (the plinth has no rear stair). Now it bends east at the meadow,
// wraps the seaward flank, joins the coastal road, and arrives along the
// beach at the town's FRONT staircase.
(function saltmereApproach(){
  const G=WORLD;
  // 1) seal the back: the two fence gaps the old road punched through
  for(const x of [27,28,29,33,34]){ if(G[198][x]===2){ G[198][x]=14; setElev(x,198,1); } }
  // the dead-end road segment from the bend down to the fence becomes meadow
  for(let y=191;y<=197;y++) for(const x of [33,34]){ if(G[y][x]===2) G[y][x]=0; }
  // 2) the EAST WRAP (widened to a 3-wide main road, smoothed): bend east across
  //    rows 188-190, then run down the seaward flank at cols 57-59 to the coast.
  for(let y=188;y<=190;y++) for(let x=33;x<=59;x++){ if(G[y][x]!==5&&G[y][x]!==9&&G[y][x]!==3) G[y][x]=2; }
  for(let y=191;y<=211;y++) for(const x of [57,58,59]){ if(G[y][x]!==5&&G[y][x]!==9&&G[y][x]!==3) G[y][x]=2; }
  // 3) the BEACH PROMENADE (widened): from the coast corner along the sand to the
  //    front stairs — rows 208-210 so it reads as a proper seafront avenue.
  for(let y=208;y<=210;y++) for(let x=30;x<=59;x++){ if(G[y][x]===19||G[y][x]===0) G[y][x]=2; }
  for(const x of [56,57]){ if(G[211][x]===19||G[211][x]===0) G[211][x]=2; }
  // ── ELEVATION (single coherent pass — supersedes the old tangle of patches) ──
  //  Saltmere sits on a raised plinth (tier 1). The approach road and the east-west
  //  coast road stay at ground level (tier 0). Where the road climbs onto the plinth
  //  to reach the town, a stair tile bridges the one-tier step. This avoids the
  //  invisible walls that used to force players off the path.
  //
  //  1) Raise the WHOLE town interior to tier 1 — every tile inside the walls (plaza
  //     floor, ground, walls, buildings, signs, AND the cliff-ledge tiles that show the
  //     elevation drop). The road below the plinth is handled separately in step 2.
  for(let y=199;y<=207;y++) for(let x=14;x<=52;x++){
    const t=G[y][x];
    if([0,5,6,9,14,16,32].includes(t)) setElev(x,y,1);
  }
  //  2) Force the ENTIRE approach + coast road flat at tier 0 (no stray raised tiles).
  for(let y=186;y<=214;y++) for(let x=12;x<=92;x++){
    if(G[y] && (G[y][x]===2 || G[y][x]===12)) setElev(x,y,0);
  }
  //  3) Only on the PROMENADE ROAD (rows 208+, below the plinth) turn a cliff-ledge
  //     (tile 32) that blocks the path into walkable ground. Town-interior ledges
  //     (rows ≤207) are left intact as elevation markers.
  for(let y=208;y<=212;y++) for(let x=12;x<=64;x++){
    if(G[y] && G[y][x]===32){
      const road=t=>t===2||t===10||t===12;
      const near = road(G[y][x-1])||road(G[y][x+1])||(G[y-1]&&road(G[y-1][x]))||(G[y+1]&&road(G[y+1][x]));
      if(near){ G[y][x]=2; setElev(x,y,0); }
    }
  }
  //  4) The Saltmere entrance stairs (climbing from the tier-0 promenade up into the
  //     tier-1 town): mark the stair tiles so canStep() bridges the one-tier change.
  //     The front stairs are the tile-10 run at the town's south edge.
  for(let y=206;y<=209;y++) for(let x=14;x<=52;x++){
    if(G[y] && G[y][x]===10) setElev(x,y,1);          // stair top = town tier
  }
  // a welcome sign where the promenade meets the stairs
  if(G[209] && G[209][31]===2 && G[210] && (G[210][31]===19||G[210][31]===0)){ G[210][31]=16; signs['31,210']='SALTMERE\\nHarbor of the western shore.\\nThe stairs ahead climb to town.'; }
  // WIDEN the existing southern coast path (Saltmere <-> Thornwood) to 3-wide.
  for(let x=55;x<=92;x++){
    if(G[211] && (G[211][x]===2 || G[211][x]===12)){
      if(G[210] && (G[210][x]===0 || G[210][x]===19)){ G[210][x]=2; setElev(x,210,0); }
      if(G[213] && (G[213][x]===0 || G[213][x]===19)){ G[213][x]=2; setElev(x,213,0); }
    }
  }
})();

// ── WIDEN & TIDY the Thornwood ↔ Dusthaven road (a clean straight run at cols 92-93)
//    to a 3-wide main road, matching the network standard. Widen east to col 94 where
//    the neighbour is plain ground/sand (avoids the few trees on the west flank). ──
(function widenThornwoodDusthaven(){
  const G=WORLD;
  for(let y=74;y<=150;y++){
    if(G[y] && (G[y][92]===2 || G[y][93]===2)){
      if(G[y][94]===0 || G[y][94]===19){ G[y][94]=2; setElev(94,y,elevAt(93,y)); }
    }
  }
})();

// ── DUSTHAVEN → CRYSTALPEAK: route the connector via the two towns' SOUTHERN roads
//    (per design). Removes any east-side path, walls Dusthaven's east gate, and lays a
//    new 3-wide branch from Dusthaven's south road across to Crystalpeak's south road. ──
(function dusthavenCrystalpeakSouth(){
  const G=WORLD;
  // 1) REMOVE any leftover east-side road: the vertical run at cols 105-107 (rows 69-89)
  //    and the horizontal connector at rows 88-89 (cols 95-153). Restore to sand/grass.
  for(let y=69;y<=89;y++) for(const x of [105,106,107]){
    if(G[y] && G[y][x]===2){ G[y][x] = (y<=80?19:0); setElev(x,y,0); }   // sand near town, grass below
  }
  for(const y of [88,89]) for(let x=95;x<=153;x++){
    if(G[y] && G[y][x]===2){ G[y][x] = 0; setElev(x,y,0); }
  }
  // 2) WALL OFF Dusthaven's east gate — close the wall gap at col 105, rows 69-70.
  for(const y of [69,70]){ if(G[y]) G[y][105]=5; }
  // 3) NEW SOUTH BRANCH: 3-wide road (rows 103-105) from Dusthaven's south road
  //    (col 93) east to Crystalpeak's south road (col 157). Paint over grass/sand/trees
  //    only — never walls, water, town tiles, or ice features.
  const SKIP=new Set([5,9,3,16,8,10,11,26,27,30,31,32]);   // don't overwrite these
  for(const y of [103,104,105]) for(let x=93;x<=158;x++){
    if(G[y] && !SKIP.has(G[y][x])){ G[y][x]=2; setElev(x,y,0); }
  }
  // stitch the branch into the Dusthaven south road (cols 92-94) and Crystalpeak south
  // road (cols 157-158) so the junctions are solid
  for(const y of [102,103,104,105,106]){
    for(const x of [92,93,94,157,158]){
      if(G[y] && (G[y][x]===2)) setElev(x,y,0);
    }
  }
})();

// ── CRYSTALPEAK → ASHFIELD: a single road that drops from the stairs/Dusthaven
//    junction, wraps around Ashfield's WEST flank, and enters only the SOUTH gate.
//    Removes the old south-to-north road and the east road; walls the north & east
//    gates. (Per design — touches only these roads + those two Ashfield gates.) ──
(function crystalpeakAshfieldSouth(){
  const G=WORLD;
  // 1a) REMOVE the old south road BELOW the Dusthaven junction (rows 106-136, col 158-159)
  for(let y=106;y<=136;y++) for(const x of [158,159]){
    if(G[y] && G[y][x]===2){ G[y][x]=0; setElev(x,y,0); }
  }
  // 1b) REMOVE the entire east road (cols 178-179, rows 77-152) + its breach (176-177,150-151)
  for(let y=77;y<=152;y++) for(const x of [178,179]){
    if(G[y] && G[y][x]===2){ G[y][x]=0; setElev(x,y,0); }
  }
  for(const y of [150,151]) for(const x of [176,177]){
    if(G[y] && G[y][x]===2){ G[y][x]=0; setElev(x,y,0); }
  }
  // 2) WALL OFF Ashfield's NORTH gate (cols 158-159, rows 134-136) and EAST gate
  //    (cols 178-179 where the road breached the east wall, rows 134-136 & 150-151).
  for(let y=134;y<=136;y++) for(const x of [158,159]){ if(G[y]) G[y][x]=5; }
  for(let y=134;y<=137;y++) for(const x of [178,179]){ if(G[y]) G[y][x]=5; }
  for(const y of [150,151]) for(const x of [178,179]){ if(G[y]) G[y][x]=5; }
  // 3) NEW 3-wide road. Taps the existing Dusthaven branch (rows 103-105) and:
  //    (a) drops south down the west flank at cols 133-135 (rows 105-168),
  //    (b) runs east along the bottom at rows 166-168 to the south gate (col ~168).
  //    Paint over open ground only — never walls, water, town, lava-rock, or ice.
  const SKIP=new Set([5,9,3,16,8,10,11,26,27,30,31,32]);
  for(let y=105;y<=168;y++) for(const x of [133,134,135]){
    if(G[y] && !SKIP.has(G[y][x])){ G[y][x]=2; setElev(x,y,0); }
  }
  for(let x=133;x<=169;x++) for(const y of [166,167,168]){
    if(G[y] && !SKIP.has(G[y][x])){ G[y][x]=2; setElev(x,y,0); }
  }
})();

// ── CRYSTALPEAK: align the approach road with the centered stairs, then heal the
//    old road trench so the mountain terraces close over it cleanly. These run on the
//    final WORLD grid, AFTER all other road passes. (Added post-road-rebuild.) ──
(function crystalpeakAlignApproach(){
  const G = WORLD;
  // 1) Lay the vertical approach straight down the stair columns (153-154), from the
  //    stair foot to the east-west branch at rows 103-105. Open ground only.
  const SKIP = new Set([5,9,3,16,8,10,11,26,27,30,31,32]);   // walls/doors/water/stairs/cliffs
  for(let y=87; y<=105; y++) for(const x of [153,154]){
    if(G[y] && !SKIP.has(G[y][x])){ G[y][x]=2; setElev(x,y,0); }
  }
  // 2) Remove the old misaligned run (cols 158-159, rows 77-102) + the row-77/78 jog
  //    (cols 155-159) that fed it. Restore to grass.
  for(let y=77; y<=102; y++) for(const x of [158,159]){
    if(G[y] && G[y][x]===2){ G[y][x]=0; setElev(x,y,0); }
  }
  for(const y of [77,78]) for(let x=155; x<=159; x++){
    if(G[y] && G[y][x]===2){ G[y][x]=0; setElev(x,y,0); }
  }
})();
(function crystalpeakHealTrench(){
  const G = WORLD;
  const cx=153, cy=68;
  // Same ring geometry the mountain was built with, so healed tiles match neighbours.
  const RINGS=[[23,18],[19,15],[15,12],[11,9],[9,8]];
  function inEllipse(x,y,rx,ry){ const nx=(x-cx)/rx, ny=(y-cy)/ry; return nx*nx+ny*ny<=1; }
  function ringTile(x,y){ for(let i=0;i<RINGS.length;i++){ if(inEllipse(x,y,RINGS[i][0],RINGS[i][1])){ if(i===RINGS.length-1 || !inEllipse(x,y,RINGS[i+1][0],RINGS[i+1][1])) return i; } } return inEllipse(x,y,RINGS[RINGS.length-1][0],RINGS[RINGS.length-1][1])?RINGS.length-1:-1; }
  // Restore surface tile + tier height for the old trench columns (158-159). Never touch
  // the stair columns, our new road, walls, or doors.
  const KEEP = new Set([5,9,2,10,11]);
  for(let y=72; y<=86; y++) for(const x of [158,159]){
    if(!G[y] || G[y][x]===undefined) continue;
    const t = ringTile(x,y); if(t<0) continue;          // outside mountain -> leave grass
    if(KEEP.has(G[y][x])) continue;
    let surf; if(t<=1) surf=0; else if(t===2) surf=((x*7+y*5)%6===0)?22:0; else surf=22;
    G[y][x]=surf; setElev(x,y,t);
  }
  // Rebuild cliff lips (32) + rock faces (33) over the healed gap, same rule as the
  // original build, on a small window covering the seam.
  const rim=[];
  for(let y=71;y<=87;y++) for(let x=156;x<=161;x++){
    if(!G[y]||G[y][x]===undefined) continue;
    const t=ringTile(x,y); if(t<0) continue;
    if(G[y][x]===5||G[y][x]===9) continue;
    let higherInside=false;
    for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ if(ringTile(x+dx,y+dy)>t) higherInside=true; }
    if(higherInside) rim.push([x,y,t]);
  }
  for(const [x,y,t] of rim){ if(G[y]&&![5,9,2,10,11].includes(G[y][x])) G[y][x]=32; }
  for(const [x,y,t] of rim){
    for(const [dx,dy] of [[0,1],[0,-1],[1,0],[-1,0]]){ const nt=ringTile(x+dx,y+dy);
      if(nt>=0 && nt<t){ const fx=x+dx, fy=y+dy; if(G[fy]&&G[fy][fx]!==undefined && ![5,9,2,10,11].includes(G[fy][fx])) G[fy][fx]=33; }
    }
  }
})();

// ── CRYSTALPEAK VILLAGE FLATTEN: the peak-clearing pass (relocateToGrid step 7)
//    wiped the summit SURFACE to flat snow out to RINGS[4]+2, but ring-tier
//    heights left invisible 4→3 steps inside the visually flat village — the two
//    southern homes sat in sealed tier-3 pockets, and healTrench (just above)
//    re-stamps ring tiers over cols 158-159, so this must run LAST of the peak
//    passes. Raise every tier-3+ tile inside the cleared ellipse to tier 4.
//    Bounded to y<=cy+6 so the south stair column keeps its one-level ramp.
(function crystalpeakVillageFlatten(){
  const G=WORLD, cx=153, cy=68;
  const RINGS=[[23,18],[19,15],[15,12],[11,9],[9,8]];
  function inE(x,y,rx,ry){ const nx=(x-cx)/rx, ny=(y-cy)/ry; return nx*nx+ny*ny<=1; }
  function ringTile(x,y){ for(let i=0;i<RINGS.length;i++){ if(inE(x,y,RINGS[i][0],RINGS[i][1])){ if(i===RINGS.length-1 || !inE(x,y,RINGS[i+1][0],RINGS[i+1][1])) return i; } } return inE(x,y,RINGS[4][0],RINGS[4][1])?4:-1; }
  const crx=RINGS[4][0]+2, cry=RINGS[4][1]+2;
  for(let y=cy-cry;y<=cy+6;y++)for(let x=cx-crx;x<=cx+crx;x++){
    if(!G[y]||G[y][x]===undefined) continue;
    if(!inE(x,y,crx,cry)) continue;
    if(ringTile(x,y)>=3) setElev(x,y,4);
  }
})();

// ── WIDEN the Stormgate ↔ Shadowmere connector (col 217-218) to 3-wide, matching the
//    network standard. Widen east to col 219 where the neighbour is open ground; never
//    overwrite walls, water, or other features. ──
(function widenStormgateShadowmere(){
  const G=WORLD;
  const SKIP=new Set([5,9,3,16,8,10,11,26,27,30,31,32,1]);
  for(let y=160;y<=212;y++){
    if(G[y] && (G[y][217]===2 || G[y][218]===2)){
      if(G[y][219]!==undefined && !SKIP.has(G[y][219])){ G[y][219]=2; setElev(219,y,elevAt(218,y)); }
    }
  }
})();

// ════════════════════════════════════════════════════════════════
//  THE SOUTHERN ISLES — open deep sea south of Saltmere leads to a
//  three-island archipelago, reachable only by boat. Each island
//  rises to a high peak with a clean switchback stair to the summit.
//  (Foundation pass: land, mountains, stairs. Towns/quests come later.)
// ════════════════════════════════════════════════════════════════
(function southernIsles(){
  const G=WORLD, H=WORLD_H, Wd=WORLD_W;
  const hash=(x,y)=>((x*374761393+y*668265263)>>>0);
  const put=(x,y,t)=>{ if(G[y]&&G[y][x]!==undefined) G[y][x]=t; };
  const get=(x,y)=>(G[y]&&G[y][x]!==undefined)?G[y][x]:-1;

  // 0) DEEP SEA: the southern ocean. Flood every row from the coast (239) to the
  //    new map bottom with DEEP SEA (tile 3). The new rows picked up stray
  //    grass/trees/flowers during earlier passes, so we wipe EVERYTHING here
  //    (the islands are stamped afterward and overwrite the sea where needed).
  for(let y=239;y<H;y++) for(let x=0;x<Wd;x++){ put(x,y,3); setElev(x,y,0); }
  // a thin shallows seam (tile 20, wadeable — NOT a surf spot) where the deep sea
  // meets the southern shelf, so the coast reads as a beach edge rather than a wall.
  for(let x=0;x<Wd;x++){ if(get(x,238)===3) put(x,238,20); }

  // a clear DEEP-SEA LANE south out of Saltmere's harbour (x16-40) so the
  // boat has open water to set off into.
  for(let y=234;y<=240;y++) for(let x=14;x<=42;x++){ const t=get(x,y);
    if(t!==5&&t!==9&&t!==19&&![22,32,33,34].includes(t)){ if(t!==20){ put(x,y, y>=238?20:3);} } }

  // ── ISLAND BUILDER ───────────────────────────────────────────────
  //  A stepped volcanic cone: a wide beach, then concentric elevation
  //  tiers each at least `band` tiles wide so the slope is gentle, rising
  //  to a snowy peak. A switchback stair climbs exactly one level per step.
  function island(cx, cy, R, peak, name){
    const band = Math.max(2, Math.round((R-3)/peak));   // horizontal run per tier (>=2)
    for(let y=cy-R-2;y<=cy+R+2;y++) for(let x=cx-R-2;x<=cx+R+2;x++){
      if(!G[y]||G[y][x]===undefined) continue;
      const dx=x-cx, dy=y-cy, d=Math.sqrt(dx*dx+dy*dy*1.1);
      const jitter=((hash(x,y)%100)/100-0.5)*1.2;
      const dd=d+jitter;
      if(dd>R+1) continue;                                  // open sea
      if(dd>R-0.4){ put(x,y,20); setElev(x,y,0); continue; } // shallows (wadeable, not a surf spot)
      if(dd>R-2.4){ put(x,y,19); setElev(x,y,0); continue; } // beach
      // inland distance -> tier (0 at beach edge). each tier spans `band` tiles.
      const inland = (R-2.4) - dd;
      let tier = Math.min(peak, 1 + Math.floor(inland/band));
      // surface by tier: low = grass/woods, mid = bare rock, top 2 = snow
      let surf;
      if(tier<=1) surf=0;
      else if(tier>=peak-1) surf=22;
      else surf=33;
      put(x,y,surf); setElev(x,y,tier);
      if(tier===1 && hash(x,y)%6===0) put(x,y,1);            // sparse coastal trees
    }
    // flat snowcap at the very top
    for(let y=cy-1;y<=cy+1;y++) for(let x=cx-1;x<=cx+1;x++){ put(x,y,22); setElev(x,y,peak); }
    put(cx,cy,16); signs[cx+','+cy]=name+"\n\u2014 the summit \u2014\nThe whole realm lies before you.";

    // ── SWITCHBACK STAIR: a clean trail from the beach to the summit, climbing
    //    exactly one elevation level per step (always climbable). ──
    // find the beach row on the centre column (first sand tile south of centre)
    let beachY=cy;
    for(let yy=cy; yy<=cy+R+2; yy++){ const t=get(cx,yy); if(t===19||t===20){ beachY=yy; break; } }
    const trailLen = beachY - cy;                 // grass/rock tiles from beach to peak
    // lay a 2-wide trail with a perfectly linear 0..peak elevation ramp
    for(let k=0;k<=trailLen;k++){
      const yy=beachY-k;
      const want=Math.min(peak, Math.round(peak * k/trailLen));
      const surfT = want>=peak-1 ? 34 : 2;        // high-snow path near top, packed path below
      for(const xx of [cx,cx+1]){ put(xx,yy,surfT); setElev(xx,yy,want); }
    }
    // stairs at every +1 step
    for(let k=0;k<trailLen;k++){
      const yy=beachY-k, yN=yy-1;
      const h=elevAt(cx,yy), hN=elevAt(cx,yN);
      if(hN>h){ for(const xx of [cx,cx+1]){ put(xx,yy,10); setElev(xx,yy,h); put(xx,yN,10); setElev(xx,yN,hN); } }
    }
    // walkable snow summit (the trail tops out here)
    for(const xx of [cx,cx+1]){ put(xx,cy,22); setElev(xx,cy,peak); }
    // plank landing on the beach where boats arrive
    put(cx,beachY+1,6); put(cx+1,beachY+1,6); setElev(cx,beachY+1,0); setElev(cx+1,beachY+1,0);
  }

  // THREE islands across the southern sea. Bigger radii so the tiers are
  // wide enough to climb; centres pulled north a touch to fit the cones.
  island(40,  270, 13, 6, 'Mistral Isle');     // western — gentle green peak
  island(95,  274, 16, 9, 'Mount Tabor');      // central — the tallest, elev 9
  island(155, 270, 13, 7, 'Sunfall Atoll');    // eastern — rocky spire

  // 🏁 THE REGATTA marker — a checkered-flag buoy bobbing in the open lane just
  //    south of Saltmere's harbour. Sail up to it and press Ⓐ to enter the races.
  (function regattaMarker(){
    const rx=28, ry=236;
    if(G[ry] && (G[ry][rx]===20 || G[ry][rx]===3)){
      // ensure the buoy sits on clean deep water and isn't culled
      put(rx,ry,20); setElev(rx,ry,0);
      for(let i=decorations.length-1;i>=0;i--){ if(decorations[i].kind==='regatta') decorations.splice(i,1); }
      decorations.push({ x:rx, y:ry, kind:'regatta', w:1 });
      signs[rx+','+ry]='🏁 THE REGATTA\\nSail up and press Ⓐ to\\nenter the harbour races!';
    }
  })();
})();

// ════════════════════════════════════════════════════════════════
//  THE HERMIT'S WOOD — a dense thicket north-west of Hellgate hiding a
//  cave where an old monk waits. Found by Eldan's riddle, not a trail.
//  (C1: the world space + the hidden cave mouth.)
// ════════════════════════════════════════════════════════════════
(function hermitsWood(){
  const G=WORLD;
  const hash=(x,y)=>((x*374761393+y*668265263)>>>0);
  const set=(x,y,t)=>{ if(G[y]&&G[y][x]!==undefined) G[y][x]=t; };
  const get=(x,y)=>(G[y]&&G[y][x]!==undefined)?G[y][x]:-1;
  // dense-wood band NW of Hellgate: rows 3-12, x183-209 (open grass + scattered trees today)
  const X0=183,X1=209,Y0=3,Y1=12;
  for(let y=Y0;y<=Y1;y++) for(let x=X0;x<=X1;x++){
    const t=get(x,y);
    if(t!==0 && t!==7) continue;                  // only thicken over grass/forest-grass
    // leave clearings + a winding gap so the player can move through the wood
    const h=hash(x,y)%100;
    if(h<62) set(x,y,1);                            // ~62% trees -> a heavy thicket
  }
  // carve a small clearing around the cave mouth
  const CX=196, CY=7;
  for(let y=CY-1;y<=CY+2;y++) for(let x=CX-2;x<=CX+2;x++){ if(get(x,y)===1) set(x,y,0); }
  // carve a WINDING natural gap (grass, not a road) from the open east side into the
  // clearing, so the cave is reachable by exploration but has no obvious trail.
  const gap=[[202,7],[201,7],[200,8],[199,8],[199,7],[198,7],[197,7],[200,6],[199,6],[201,9],[200,9],[199,9]];
  for(const [gx,gy] of gap){ if(get(gx,gy)===1) set(gx,gy,0); }
  // the cave mouth — a dark hollow in the rock. Use tile 35 (hollow) like Sage's Wood;
  // the entry handler tells the two apart by coordinate.
  set(CX, CY, 35);
  set(CX, CY+1, 2);                                // a single step of bare earth at its foot
  signs[CX+','+(CY+2)]="A low cave mouth breathes cool air...\n(step onto the dark hollow to enter)";
})();




// ════════════════════════════════════════════════════════════════
//  INPUT
// ════════════════════════════════════════════════════════════════
const held = { up:false,down:false,left:false,right:false };
// ⌨ releasing every direction when the page loses focus. Without this, alt-tabbing
//   mid-stride never delivers the keyup and the knight walks off on his own.
function releaseHeld(){ held.up=held.down=held.left=held.right=false; }
try{ addEventListener('blur', releaseHeld);
  document.addEventListener('visibilitychange', ()=>{ if(document.hidden) releaseHeld(); }); }catch(e){}
const keymap = { w:'up',s:'down',a:'left',d:'right',arrowup:'up',arrowdown:'down',arrowleft:'left',arrowright:'right' };
// ── DOOR NORMALIZATION + SAFETY (extended): every door lives IN the bottom
//    wall row of its building — matching the drawn door in drawBuilding — with
//    b.door and the tile-9 moved TOGETHER so checkTransitions' pkey lookup stays
//    in sync. Stale ground-row 9s are healed, blocking signs relocated, the
//    doorstep kept walkable + level with the door (tile 9 is NOT in STAIR_TILES,
//    so a height mismatch silently bricks entry), and connected outward.
//    Runs after ALL world passes so nothing can silently brick an entrance again.
/* _legacy ensureDoorAccess (pre-normalization; kept for revert):
(function ensureDoorAccess(){
  const G=WORLD;
  buildings.forEach(b=>{
    if(!b.door) return;
    const dx=b.door.x, dy=b.door.y;
    if(G[dy] && G[dy][dx]!==undefined && G[dy][dx]!==9) G[dy][dx]=9;
    const sy=dy+1;
    if(G[sy] && G[sy][dx]!==undefined){
      if(!WALK.has(G[sy][dx])){
        const w=G[sy][dx-1], e2=G[sy][dx+1];
        G[sy][dx] = (WALK.has(w)&&w!==9)?w : (WALK.has(e2)&&e2!==9)?e2 : 6;
      }
      if(elevAt(dx,sy)!==elevAt(dx,dy)) setElev(dx,sy, elevAt(dx,dy));
      const nb=[[dx,sy+1],[dx-1,sy],[dx+1,sy]];
      if(!nb.some(([qx,qy])=>G[qy]&&WALK.has(G[qy][qx]))){
        const qy=sy+1;
        if(G[qy]&&G[qy][dx]!==undefined){ G[qy][dx]=G[sy][dx]; setElev(dx,qy, elevAt(dx,sy)); }
      }
    }
  });
})();
*/
(function ensureDoorAccess(){
  const G=WORLD;
  const healTile=(x,y)=>{ // pick a walkable tile matching neighbours (never 9)
    const c=[G[y+1]&&G[y+1][x], G[y]&&G[y][x-1], G[y]&&G[y][x+1]];
    for(const t of c) if(t!==undefined && WALK.has(t) && t!==9) return t;
    return 6;
  };
  buildings.forEach(b=>{
    if(!b.door) return;
    // 1) clear a stale ground-row door tile (door declared outside the footprint)
    const inFoot = b.door.x>=b.x && b.door.x<b.x+b.w && b.door.y>=b.y && b.door.y<b.y+b.h;
    if(!inFoot && G[b.door.y] && G[b.door.y][b.door.x]===9)
      G[b.door.y][b.door.x]=healTile(b.door.x,b.door.y);
    // 2) normalize the coordinate: bottom wall row, x clamped into the footprint
    b.door.x=Math.max(b.x, Math.min(b.x+b.w-1, b.door.x));
    b.door.y=b.y+b.h-1;
    const dx=b.door.x, dy=b.door.y, sy=dy+1;
    if(G[dy] && G[dy][dx]!==undefined) G[dy][dx]=9;
    if(!G[sy] || G[sy][dx]===undefined) return;
    // 3) doorstep: relocate a blocking SIGN (Stormgate cathedral case), then heal
    if(G[sy][dx]===16){
      const k=dx+','+sy;
      for(const [ox2,oy2] of [[dx-1,sy],[dx+1,sy],[dx-2,sy],[dx+2,sy]]){
        if(G[oy2] && (G[oy2][ox2]===0||G[oy2][ox2]===6||G[oy2][ox2]===2)){
          G[oy2][ox2]=16; signs[ox2+','+oy2]=signs[k]; break; } }
      delete signs[k]; G[sy][dx]=healTile(dx,sy);
    }
    if(!WALK.has(G[sy][dx]) || G[sy][dx]===9) G[sy][dx]=healTile(dx,sy);
    // 4) elevation: the door shares a height with its doorstep (9 is not a stair)
    if(elevAt(dx,sy)!==elevAt(dx,dy)) setElev(dx,dy, elevAt(dx,sy));
    // 5) a barrier dome's ring must never sit ON a door or doorstep (the ring
    //    ellipse can graze a wall row — e.g. Saltmere chapel). Domes seal roads,
    //    not thresholds; the town's outer ring still seals the town itself.
    BARRIERS.forEach(bar=>{ if(bar){ bar.set.delete(dx+','+dy); bar.set.delete(dx+','+sy); } });
    // 6) the doorstep must connect outward (unchanged from the old pass)
    const nb=[[dx,sy+1],[dx-1,sy],[dx+1,sy]];
    if(!nb.some(([qx,qy])=>G[qy]&&WALK.has(G[qy][qx])&&G[qy][qx]!==9)){
      const qy=sy+1;
      if(G[qy]&&G[qy][dx]!==undefined){ G[qy][dx]=G[sy][dx]; setElev(dx,qy, elevAt(dx,sy)); }
    }
  });
})();

// ── DECOR SOLIDITY, RE-STAMPED LAST ────────────────────────────────────
// addDecor() marks a decoration's footprint solid at creation, but later terrain
// passes repaint those tiles and the stamp is silently lost: the Homestead clearing
// carves its whole region back to grass, and Crystalpeak's snow pass paints tile 22
// over its braziers and ice pillars. 24 of 101 decorations ended up walkable, which
// is why villagers appeared to stroll straight through scenery. Re-stamp every
// footprint once, here, after all terrain work is finished.
//   · doors are never overwritten — a decoration on one would seal a building
//   · water is never overwritten — decor sits beside it, and filling it would
//     strand boats and break the sail routes
(function resolidifyDecor(){
  const G=WORLD;
  const KEEP_TILE = new Set([9]);            // doorway
  for(const d of decorations){
    const w=d.w||1;
    for(let dy=0;dy<w;dy++) for(let dx=0;dx<w;dx++){
      const x=d.x+dx, y=d.y+dy;
      if(!G[y] || G[y][x]===undefined) continue;
      const t=G[y][x];
      if(KEEP_TILE.has(t)) continue;
      if(!WALK.has(t)) continue;             // already solid; leave it alone
      if(SAIL_TILES && SAIL_TILES.has(t)) continue;   // never fill a sailable tile
      G[y][x]=5;
    }
  }
})();

addEventListener('keydown', e=>{ const lk=e.key.toLowerCase();
  if(!boot.done){ bootKey(e); return; }   // boot sequence owns the keyboard
  if(saveio.open){ if(e.key==='Escape') closeSaveIo(); return; }   // let the textarea type freely
  // The companion-naming box owns the keyboard the same way. Without this, every
  // keystroke fell through to the movement bindings — you could not type a name
  // on a desktop, and Enter never confirmed, so the box could not be dismissed.
  if(petName.open){
    if(e.key==='Enter'){ e.preventDefault(); closePetName(); }
    return;                                       // everything else types normally
  }
  if(place.kind==='surf'){
    if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' '){ e.preventDefault(); surfPress('A'); return; }
    if(lk==='k'||lk==='x'){ e.preventDefault(); surfPress('B'); return; }
    if(lk==='m'){ e.preventDefault(); return; }
  }
  // ── horse race: arrows steer / gallop (HELD during race; pick steed on select), A, B ──
  if(place.kind==='race'){
    e.preventDefault();
    if(place.kind==='tourney'){
      if(lk==='arrowup'||lk==='w'){ tourneyHold('UP',true); tourneyPress('UP'); }
      else if(lk==='arrowdown'||lk==='s'){ tourneyHold('DOWN',true); tourneyPress('DOWN'); }
      else if(lk==='arrowleft'||lk==='a'){ tourneyHold('LEFT',true); tourneyPress('LEFT'); }
      else if(lk==='arrowright'||lk==='d'){ tourneyHold('RIGHT',true); tourneyPress('RIGHT'); }
      else if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' ') tourneyPress('A');
      else if(lk==='k'||lk==='x'||e.key==='Escape') tourneyPress('B');
      e.preventDefault(); return;
    }
    if(lk==='arrowup'||lk==='w'){ if(!e.repeat){ raceHold('UP',true); racePress('UP'); } }
    else if(lk==='arrowleft'||lk==='a'){ if(!e.repeat){ raceHold('LEFT',true); racePress('LEFT'); } }
    else if(lk==='arrowright'||lk==='d'){ if(!e.repeat){ raceHold('RIGHT',true); racePress('RIGHT'); } }
    else if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' ') racePress('A');
    else if(lk==='k'||lk==='x'||e.key==='Escape') racePress('B');
    return;
  }
  // ── boat regatta: arrows steer (held), throttle = up, A confirm, B back/quit ──
  if(place.kind==='boatrace'){
    e.preventDefault();
    if(lk==='arrowup'||lk==='w') boatHold('UP', true);
    else if(lk==='arrowleft'||lk==='a') boatHold('LEFT', true);
    else if(lk==='arrowright'||lk==='d') boatHold('RIGHT', true);
    else if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' ') boatPress('A');
    else if(lk==='k'||lk==='x'||e.key==='Escape') boatPress('B');
    return;
  }
  if(petB && !petB.done){
    const n=petBMoves().length;
    if(lk==='w'||e.key==='ArrowUp'){ e.preventDefault(); petB.cursor=(petB.cursor+n-1)%n; renderPetB(); return; }
    if(lk==='s'||e.key==='ArrowDown'){ e.preventDefault(); petB.cursor=(petB.cursor+1)%n; renderPetB(); return; }
  }
  // ── intro sequence ──
  if(intro.open){
    if(intro.step===INTRO_STORY.length){ if(e.key==='Enter'){ e.preventDefault(); introNext(); } return; }
    e.preventDefault();
    if(lk==='arrowleft'||lk==='a') introMove(-1);
    else if(lk==='arrowright'||lk==='d') introMove(1);
    else if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' ') introNext();
    return;
  }
  // ── shop menu: arrows cycle, A/Enter buys ──
  if(seedMode && (lk==='arrowup'||lk==='arrowdown'||lk==='arrowleft'||lk==='arrowright'||lk==='w'||lk==='s')){
    e.preventDefault();
    cycleSeed((lk==='arrowup'||lk==='arrowleft'||lk==='w') ? -1 : 1);
    return; }
  if(shopMode && (lk==='arrowup'||lk==='arrowdown'||lk==='arrowleft'||lk==='arrowright'||lk==='w'||lk==='s')){
    e.preventDefault(); const n=shopMode.items.length;
    if(lk==='arrowup'||lk==='arrowleft'||lk==='w') shopMode.idx=(shopMode.idx+n-1)%n; else shopMode.idx=(shopMode.idx+1)%n;
    showShop(); return;
  }
  // ── 🛒 wagon menu: arrows cycle, A/Enter confirms ──
  if(tourneyMenu.open && (lk==='arrowup'||lk==='arrowdown'||lk==='arrowleft'||lk==='arrowright'||lk==='w'||lk==='s')){
    e.preventDefault(); tourneyMenuMove((lk==='arrowup'||lk==='arrowleft'||lk==='w')?-1:1); return;
  }
  if(wagonMenu.open && (lk==='arrowup'||lk==='arrowdown'||lk==='arrowleft'||lk==='arrowright'||lk==='w'||lk==='s')){
    e.preventDefault(); wagonMenuMove((lk==='arrowup'||lk==='arrowleft'||lk==='w')?-1:1); return;
  }
  // ── library shop ──
  if(libShop){ e.preventDefault();
    if(lk==='arrowup'||lk==='w') libShopMove(-1);
    else if(lk==='arrowdown'||lk==='s') libShopMove(1);
    else if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' ') libShopBuy();
    else if(lk==='k'||lk==='x'||e.key==='Escape'){ libShop=null; renderLibrary(); }
    return;
  }
  // ── library (doctrine study) ──
  if(library.open){ e.preventDefault();
    if(lk==='arrowleft'||lk==='a') libraryMove(-1);
    else if(lk==='arrowright'||lk==='d') libraryMove(1);
    else if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' ') librarySelect();
    else if(lk==='k'||lk==='x'||e.key==='Escape') closeLibrary();
    return;
  }
  // ── theology trial: ▲▼ choose, A answer, B leave ──
  if(trial.open){ e.preventDefault();
    if(lk==='arrowup'||lk==='w') trialMove(-1);
    else if(lk==='arrowdown'||lk==='s') trialMove(1);
    else if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' ') trialSelect();
    else if(lk==='k'||lk==='x'||e.key==='Escape') closeTrial();
    return;
  }
  // ── menu mode: d-pad navigates, A selects, B/M/Esc close ──
  if(menu.open){ e.preventDefault();
    if(lk==='arrowup'||lk==='w') menuMove(0,-1);
    else if(lk==='arrowdown'||lk==='s') menuMove(0,1);
    else if(lk==='arrowleft'||lk==='a') menuMove(-1,0);
    else if(lk==='arrowright'||lk==='d') menuMove(1,0);
    else if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' ') menuSelect();
    else if(lk==='k'||lk==='x'||lk==='m'||e.key==='Escape') toggleMenu();
    return;
  }
  if(lk==='m'){ e.preventDefault(); toggleMenu(); return; }
  if(lk==='h'||lk==='q'){ e.preventDefault(); quickPotion(); return; }
  if(place.kind==='tourney'){ const kt=keymap[lk];
    if(kt){ tourneyHold(kt.toUpperCase(), true); e.preventDefault(); } }
  const k=keymap[lk]; if(k){held[k]=true;e.preventDefault();}
  // Ⓐ on the keyboard must take the SAME path as the on-screen button: with a
  // dialogue open it ADVANCES it. It used to call doAction() straight out,
  // which re-ran the sign/NPC and called say() again — resetting idx to 0, so
  // the text never advanced, dialogue.open never cleared, and canMove stayed
  // false. Movement froze while attack/dodge (ungated) kept working, until you
  // tapped the banner shut. e.repeat guards stop a held key machine-gunning
  // through the lines.
  if(e.key===' '||e.key==='Enter'){ e.preventDefault();
    if(dialogue.open){ if(!e.repeat) advanceDialogue(); }
    else if(!e.repeat) doAction(); }
  else if(lk==='j'||lk==='z'){                         // A = strike
    if(dialogue.open){ if(!e.repeat) advanceDialogue(); }
    else doAttack(); }                                 // (held J still spams attacks, unchanged)
  else if(lk==='k'||lk==='x'||e.key==='Shift'){ if(!e.repeat) bDown(); }  // B: hold=block · double-tap=dodge
});
addEventListener('keyup', e=>{
  if(place.kind==='tourney'){ const kt=keymap[e.key.toLowerCase()];
    if(kt) tourneyHold(kt.toUpperCase(), false); }
  const k=keymap[e.key.toLowerCase()]; if(k){held[k]=false;e.preventDefault();}
  if(place.kind==='race'){ const lkr=e.key.toLowerCase();
    if(place.kind==='tourney'){
      if(lkr==='arrowup'||lkr==='w') tourneyHold('UP',false);
      else if(lkr==='arrowdown'||lkr==='s') tourneyHold('DOWN',false);
      else if(lkr==='arrowleft'||lkr==='a') tourneyHold('LEFT',false);
      else if(lkr==='arrowright'||lkr==='d') tourneyHold('RIGHT',false);
    }
    if(lkr==='arrowup'||lkr==='w') raceHold('UP', false);
    else if(lkr==='arrowleft'||lkr==='a') raceHold('LEFT', false);
    else if(lkr==='arrowright'||lkr==='d') raceHold('RIGHT', false); }
  if(place.kind==='boatrace'){ const lku=e.key.toLowerCase();
    if(lku==='arrowup'||lku==='w') boatHold('UP', false);
    else if(lku==='arrowleft'||lku==='a') boatHold('LEFT', false);
    else if(lku==='arrowright'||lku==='d') boatHold('RIGHT', false); }
  const lk2=e.key.toLowerCase(); if(lk2==='k'||lk2==='x'||e.key==='Shift') bUp(); });
function dirPress(d){   // discrete direction press → overlay browsing (shop, menus, trials…)
  if(!boot.done){ bootDir(d); return true; }
  audioUnlock();
  if(intro.open){ if(intro.step>INTRO_STORY.length){ if(d==='left')introMove(-1); else if(d==='right')introMove(1); } return true; }
  if(seedMode){ if(d==='up'||d==='left') cycleSeed(-1); else if(d==='down'||d==='right') cycleSeed(1); return true; }
  if(shopMode){ const n=shopMode.items.length; if(d==='up'||d==='left'){ shopMode.idx=(shopMode.idx+n-1)%n; showShop(); } else if(d==='down'||d==='right'){ shopMode.idx=(shopMode.idx+1)%n; showShop(); } return true; }
  if(tourneyMenu.open){ if(d==='up'||d==='left') tourneyMenuMove(-1); else if(d==='down'||d==='right') tourneyMenuMove(1); return true; }
  if(wagonMenu.open){ if(d==='up'||d==='left') wagonMenuMove(-1); else if(d==='down'||d==='right') wagonMenuMove(1); return true; }
  if(libShop){ if(d==='up')libShopMove(-1); else if(d==='down')libShopMove(1); return true; }
  if(library.open){ if(d==='left')libraryMove(-1); else if(d==='right')libraryMove(1); return true; }
  if(trial.open){ if(d==='up')trialMove(-1); else if(d==='down')trialMove(1); return true; }
  if(petB && !petB.done){ const n=petBMoves().length; if(d==='up')petB.cursor=(petB.cursor+n-1)%n; else if(d==='down')petB.cursor=(petB.cursor+1)%n; renderPetB(); return true; }
  if(menu.open){ const dir={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]}[d]; menuMove(dir[0],dir[1]); return true; }
  return false;
}
function bindHold(el,d){ const on=e=>{e.preventDefault();
  if(place.kind==='tourney'){ const m={up:'UP',down:'DOWN',left:'LEFT',right:'RIGHT'}[d]; if(m){ tourneyHold(m,true); tourneyPress(m); } else if(d==='a') tourneyPress('A'); else if(d==='b') tourneyPress('B'); return; }
  if(place.kind==='race'){ const m={up:'UP',left:'LEFT',right:'RIGHT'}[d]; if(m){ raceHold(m,true); racePress(m); } return; }
  // ⬡ a corner button ("up-left") holds BOTH flags, so pointer and one-thumb
  //   players get the diagonals that keyboard players get by holding two keys.
  const parts=d.split('-');
  if(dirPress(parts[0])) return;
  parts.forEach(p=>{ held[p]=true; });}; const off=e=>{e.preventDefault();
  if(place.kind==='tourney'){ const m={up:'UP',down:'DOWN',left:'LEFT',right:'RIGHT'}[d]; if(m) tourneyHold(m,false); return; }
  if(place.kind==='race'){ const m={up:'UP',left:'LEFT',right:'RIGHT'}[d]; if(m) raceHold(m,false); return; }
  d.split('-').forEach(p=>{ held[p]=false; });};
  el.addEventListener('touchstart',on,{passive:false}); el.addEventListener('touchend',off); el.addEventListener('touchcancel',off);
  el.addEventListener('mousedown',on); el.addEventListener('mouseup',off); el.addEventListener('mouseleave',off); }
document.querySelectorAll('.db[data-d]').forEach(b=>bindHold(b,b.dataset.d));
function aPress(){ if(!boot.done){ bootA(); return; } audioUnlock(); if(petName.open){ closePetName(); return; } if(saveio.open) return; if(dialogue.open){ advanceDialogue(); return; } if(cutscene.active) return; if(place.kind==='surf'){ surfPress('A'); return; } if(place.kind==='race'){ racePress('A'); return; } if(place.kind==='boatrace'){ boatPress('A'); return; } if(place.kind==='tourney'){ tourneyPress('A'); return; } if(petB){ if(petB.done) petAdvance(); else petMove(petB.cursor); return; } if(intro.open){ introNext(); } else if(libShop){ libShopBuy(); } else if(library.open){ librarySelect(); } else if(trial.open){ trialSelect(); } else if(menu.open){ menuSelect(); } else { if(!doAction(true)) doAttack(); } }
// ── QUICK-USE POTION: one tap (🧪 button) or H/Q — no menu digging mid-fight ──
let _lastPotAt=-9999;
function quickPotion(){
  if(!boot.done) return;
  if(menu.open||intro.open||dialogue.open||saveio.open||library.open||trial.open||petB||styl||barn||cutscene.active) return;
  if(place.kind==='surf'||place.kind==='race'||place.kind==='boatrace'||place.kind==='throne'||place.kind==='tourney') return;
  const now=performance.now();
  if(now-_lastPotAt<1200) return;                              // one swig at a time
  if((inventory.potion||0)<=0){ showBanner('Your potion belt is empty. 🧪×0', 1000); _lastPotAt=now; return; }
  if(player.hp>=player.maxHp){ showBanner('Your health is already full. ❤', 900); return; }
  inventory.potion--; player.hp=Math.min(player.maxHp, player.hp+40); _lastPotAt=now; sfxPotion();
  showBanner(`🧪 +40 HP! (${Math.round(player.hp)}/${player.maxHp}) · ${inventory.potion} left`, 1200);
  updatePotBtn();
}
let _potShown=-1;
function updatePotBtn(){
  const n=inventory.potion||0; if(n===_potShown) return; _potShown=n;
  const el=document.getElementById('btnPot'); if(!el) return;
  el.textContent='🧪'+n; el.classList.toggle('empty', n<=0);
}
function bPress(){ if(!boot.done){ bootB(); return; } audioUnlock(); if(saveio.open){ closeSaveIo(); return; } if(cutscene.active){ cutsceneSkip(); return; } if(dialogue.open){ closeDialogue(); return; } if(tourneyMenu.open){ closeTourneyMenu(); return; } if(place.kind==='surf'){ surfPress('B'); return; } if(place.kind==='race'){ racePress('B'); return; } if(place.kind==='boatrace'){ boatPress('B'); return; } if(wagonMenu.open){ closeWagonMenu(); return; } if(player.driving){ stopDriving(); return; } if(petB){ closePetB(false); return; } if(barn){ closeBarn(); return; } if(styl){ closeStylist(); return; } if(intro.open){ return; } else if(libShop){ libShop=null; renderLibrary(); } else if(library.open){ closeLibrary(); } else if(trial.open){ closeTrial(); }
  // _legacy: else if(menu.open){ toggleMenu(); }
  // Ⓑ now walks back out of the page to the rail; only a second press closes.
  else if(menu.open){ if(!menuBackToRail()) toggleMenu(); }
  else doDodge(); }
// ⚔ A must listen for touchstart, not click. Mobile browsers don't synthesize a
// click for a second finger during an active multi-touch gesture, so while the
// joystick was held the click never fired and the sword wouldn't swing while walking.
// mousedown keeps desktop working; preventDefault on touchstart suppresses the
// duplicate compatibility click so a tap only ever fires aPress once.
// _legacy: document.getElementById('btnA').addEventListener('click', aPress);
const aEl=document.getElementById('btnA');
aEl.addEventListener('touchstart', e=>{ e.preventDefault(); aPress(); }, {passive:false});
aEl.addEventListener('mousedown',  e=>{ e.preventDefault(); aPress(); });
const bEl=document.getElementById('btnB');
bEl.addEventListener('touchstart', e=>{ e.preventDefault(); bDown(); }, {passive:false});
bEl.addEventListener('touchend',   e=>{ e.preventDefault(); bUp(); });
bEl.addEventListener('touchcancel',e=>{ bUp(); });
bEl.addEventListener('mousedown',  e=>{ e.preventDefault(); bDown(); });
bEl.addEventListener('mouseup',    ()=>bUp());
bEl.addEventListener('mouseleave', ()=>bUp());
document.getElementById('menuBtn').addEventListener('click', toggleMenu);
// tap anywhere on the intro overlay to advance the story / confirm (mobile-friendly)
document.getElementById('gamemenu').addEventListener('click', e=>{
  // rail: first tap selects the tab, a second tap on the same one steps into it
  const rt = e.target.closest && e.target.closest('.gm-rt');
  if(rt && menu.open){
    const i=+rt.dataset.tab;
    if(i===menu.tab && menu.focus==='rail') menuEnterList();
    else { setMenuTab(i); menu.focus='rail'; renderMenu(); }
    return;
  }
  // ── ✕ close (any overlay except the intro) ──
  const closer=e.target.closest && e.target.closest('[data-close]');
  if(closer){ if(!intro.open) bPress(); return; }
  // ── INTRO ──
  if(intro.open){
    if(intro.step===INTRO_STORY.length && e.target && e.target.id==='introName') return;
    if(intro.step>INTRO_STORY.length){ const card=e.target.closest && e.target.closest('[data-pet]'); if(card){ intro.petPick=+card.dataset.pet; renderIntro(); return; } }
    introNext(); return;
  }
  const tgt=e.target;
  // ── THEOLOGY TRIAL: tap an answer to pick (and again to confirm) ──
  if(styl){ const rb=tgt.closest&&tgt.closest('[data-ribbon]');
    if(rb){ player.pet.ribbon=RIBBONS[+rb.dataset.ribbon]; renderStylist(); return; } }
  if(barn){ const sw=tgt.closest&&tgt.closest('[data-barnswap]');
    if(sw){ barnSwap(+sw.dataset.barnswap); return; }
    const c=tgt.closest&&tgt.closest('[data-close]'); if(c){ closeBarn(); return; } }
  if(petB){ const mv=tgt.closest&&tgt.closest('[data-petmove]');
    if(mv){ petMove(+mv.dataset.petmove); return; }
    const pg=tgt.closest&&tgt.closest('[data-petgo]'); if(pg){ petAdvance(); return; } }
  if(trial.open && trial.answered){ const go=tgt.closest&&tgt.closest('[data-trialgo]');
    if(go){ trialSelect(); return; } }
  if(trial.open && !trial.answered){ const opt=tgt.closest&&tgt.closest('[data-trial]');
    if(opt){ const i=+opt.dataset.trial; if(trial.picked===i){ trialSelect(); } else { trial.picked=i; renderTrial(); } return; } }
  // ── PAUSE MENU: tap a tab to switch, or tap a row to select ──
  if(menu.open){
    const tab=tgt.closest&&tgt.closest('[data-tab]');
    if(tab){ menu.tab=+tab.dataset.tab; menu.cursor=0; menu.erase=false; menu.confirmErase=null; renderMenu(); return; }
    const qtog=tgt.closest&&tgt.closest('[data-questtoggle]');
    if(qtog){ menu.questsShowDone=!menu.questsShowDone; renderMenu(); return; }
    const row=tgt.closest&&tgt.closest('[data-menurow]');
    if(row){ menu.cursor=+row.dataset.menurow; renderMenu(); menuSelect(); return; } }
  // ── LIBRARY: tap the ◀ ▶ arrows to switch doctrine, or open the wares ──
  if(library.open && !libShop){
    const nav=tgt.closest&&tgt.closest('[data-libnav]');
    if(nav){ libraryMove(+nav.dataset.libnav); return; }
    const wares=tgt.closest&&tgt.closest('[data-libwares]');
    if(wares){ librarySelect(); return; } }
  // ── LIBRARY shop: tap a ware ──
  if(libShop){ const w=tgt.closest&&tgt.closest('[data-libitem]'); if(w){ libShop.cursor=+w.dataset.libitem; renderLibrary(); libShopBuy(); return; } }
});
document.getElementById('mountBtn').addEventListener('click', toggleMount);
document.getElementById('wagonBtn').addEventListener('click', toggleDriving);

// ════════════════════════════════════════════════════════════════
//  BANNER / DIALOGUE
// ════════════════════════════════════════════════════════════════
const banner = document.getElementById('banner'); let bannerT=0;
// ── HUD HINT: the tag is rewritten every frame, so both halves are diffed and
//    only touched when they actually change (a style write 60x/sec for a pip
//    that changes a few times a second is pure churn). ──
let _hudTxt=null, _hudCombo=-1;
function setHudHint(txt, combo){
  const t=document.getElementById('hinttxt'); if(t && txt!==_hudTxt){ t.textContent=txt; _hudTxt=txt; }
  const p=document.getElementById('combopip');
  if(p && combo!==_hudCombo){ p.className = combo>0 ? ('c'+Math.min(3,combo)) : ''; _hudCombo=combo; }
}
function showBanner(html, ms=1500){ banner.innerHTML=html; banner.style.display='block'; bannerT=ms; }

// ── DIALOGUE: tap-to-advance conversation box (never auto-dismisses) ──
// Story/NPC dialogue waits for Ⓐ / tap so it can't vanish before you're ready.
// (Transient notifications — gold, level-ups, quest pings — still use showBanner.)
// ── WORD-BY-WORD REVEAL ──
// A banner that fades on a timer is a guess at how fast someone reads, and the
// guess is wrong for anyone who blinks. The line now arrives word by word, so
// the READING is the gate: first Ⓐ finishes the line, second moves on. Nothing
// important can be blown past, and nothing has to be timed.
const REVEAL_MS = 105;          // one word every this many ms — paced to be read,
                               // not to be got through
const REVEAL_LOCK = 260;       // taps ignored for this long after a line opens,
                               // so a double-tap on the previous line cannot
                               // skip the next one before it is even seen
const dialogue = { open:false, lines:[], idx:0, onDone:null,
                   shown:0, full:0, tokens:null, acc:0, lockUntil:0 };
// Split HTML into atomic tags and words. Tags are never counted as words, and a
// tag opened before the cut is closed again, or the box tears itself apart as
// it types.
function revealTokens(html){
  const out=[]; let words=0;
  const re=/<[^>]+>/g; let last=0, m;
  const pushText=(s)=>{ for(const w of s.split(/(\s+)/)){ if(!w) continue;
    if(/^\s+$/.test(w)) out.push({sp:w}); else { out.push({w}); words++; } } };
  while((m=re.exec(html))){ pushText(html.slice(last,m.index)); out.push({tag:m[0]}); last=re.lastIndex; }
  pushText(html.slice(last));
  return { parts:out, words };
}
function revealPrefix(tk, n){
  let seen=0, s=''; const open=[];
  for(const p of tk.parts){
    if(p.tag){
      s+=p.tag;
      const nm=p.tag.match(/^<\/?([a-zA-Z][\w-]*)/);
      if(nm){ const t=nm[1].toLowerCase();
        if(/^<\//.test(p.tag)){ const i=open.lastIndexOf(t); if(i>=0) open.splice(i,1); }
        else if(!/\/>$/.test(p.tag) && !['br','hr','img'].includes(t)) open.push(t); }
      continue;
    }
    if(p.sp){ if(seen<n) s+=p.sp; continue; }
    if(seen>=n) break;
    s+=p.w; seen++;
  }
  for(let i=open.length-1;i>=0;i--) s+='</'+open[i]+'>';
  return s;
}
function tickDialogue(dt){
  if(!dialogue.open || !dialogue.tokens) return;
  if(dialogue.lockUntil>0) dialogue.lockUntil=Math.max(0, dialogue.lockUntil-dt);
  if(dialogue.shown>=dialogue.full) return;
  dialogue.acc+=dt;
  while(dialogue.acc>=REVEAL_MS && dialogue.shown<dialogue.full){ dialogue.acc-=REVEAL_MS; dialogue.shown++; }
  renderDialogue();
}
function say(lines, onDone){
  dialogue.lines = Array.isArray(lines) ? lines.slice() : [lines];
  dialogue.idx = 0; dialogue.onDone = onDone||null; dialogue.open = dialogue.lines.length>0;
  if(!dialogue.open){ if(onDone) onDone(); return; }
  beginLine();
  renderDialogue();
}
function beginLine(){
  const item = dialogue.lines[dialogue.idx] || '';
  const text = (item && typeof item==='object') ? (item.text||'') : String(item);
  dialogue.tokens = revealTokens(text);
  dialogue.full = dialogue.tokens.words;
  dialogue.shown = 0; dialogue.acc = 0; dialogue.lockUntil = REVEAL_LOCK;
}
function renderDialogue(){
  const item = dialogue.lines[dialogue.idx] || '';
  let speaker='', text='';
  if(item && typeof item==='object'){ speaker=item.speaker||''; text=item.text||''; }
  else text=String(item);
  if(dialogue.tokens) text = revealPrefix(dialogue.tokens, dialogue.shown);
  const done = !dialogue.tokens || dialogue.shown>=dialogue.full;
  const more = dialogue.idx < dialogue.lines.length-1;
  banner.innerHTML = (speaker?`<b style="color:#ffe9a8">${speaker}</b><br>`:'')
    + `<span style="font-size:7px">${text}</span>`
    + `<br><span style="font-size:6px;color:#8fd0ff;letter-spacing:.5px">${!done?'\u2026':(more?'\u25b6 Ⓐ / tap':'Ⓐ / tap to close')}</span>`;
  banner.style.display='block'; banner.style.pointerEvents='auto'; bannerT=999999;
}
function advanceDialogue(){
  if(!dialogue.open) return;
  // the opening moment: a tap here is almost always the tail of the tap that
  // opened the box, so it is ignored outright
  if(dialogue.lockUntil>0) return;
  sfxClick();
  // first press finishes the line; only the second moves on
  if(dialogue.tokens && dialogue.shown<dialogue.full){ dialogue.shown=dialogue.full; renderDialogue(); return; }
  dialogue.idx++;
  if(dialogue.idx >= dialogue.lines.length) closeDialogue();
  else { beginLine(); renderDialogue(); }
}
function closeDialogue(){
  const cb=dialogue.onDone; dialogue.open=false; dialogue.onDone=null; dialogue.lines=[];
  dialogue.tokens=null; dialogue.shown=0; dialogue.full=0; dialogue.lockUntil=0;
  banner.style.display='none'; banner.style.pointerEvents='none'; bannerT=0;
  if(cb) cb();
}
// helper: format an NPC's name + one or more lines into dialogue entries
function sayAs(name, lines, onDone){
  const arr=(Array.isArray(lines)?lines:[lines]).map(t=>({speaker:name, text:t}));
  say(arr, onDone);
}

// ════════════════════════════════════════════════════════════════
//  ACTIONS — enter doors/stairs, talk, attack
// ════════════════════════════════════════════════════════════════
function pkey(){ return Math.floor((player.x+TILE/2)/TILE)+','+Math.floor((player.y+TILE/2)/TILE); }
function facingTile(){ const d={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]}[player.dir];
  return [Math.floor((player.x+TILE/2)/TILE)+d[0], Math.floor((player.y+TILE/2)/TILE)+d[1]]; }

function enterDoor(b){
  sfxDoor(true);
  // the Homestead barn opens the Stables swap menu instead of a plain interior
  if(b.id==='home_barn'){ openBarn(); return; }
  // chapels lead into the multi-floor dungeon instead of a plain interior
  if(CHAPEL_TOWN[b.id]!==undefined){ enterChapel(b); return; }
  // Abaddon's Throne → the final battle (gated behind cleansing all 10 towns)
  if(b.id==='hg_keep'){ enterAbaddon(b); return; }
  // Stormgate Keep → the grand throne hall (walkable, the King enthroned)
  if(b.id==='sg_keep'){ enterKeep(b); return; }
  returnStack.push({ x:b.door.x*TILE, y:(b.door.y+1)*TILE, dir:'down' });
  place={kind:'interior', id:b.interior, floor:0};
  const f=INTERIORS[b.interior].floors[0];
  // spawn on the interior's exit door, nudged up one tile
  let sx=4, sy=f.h-2; for(let y=0;y<f.h;y++)for(let x=0;x<f.w;x++) if(f.g[y][x]===9){ sx=x; sy=y-1; }
  player.x=sx*TILE; player.y=sy*TILE; player.dir='up';
  showBanner(`🚪 ${INTERIORS[b.interior].name}`, 1000);
}

// ════════════════════════════════════════════════════════════════
//  CHAPEL DUNGEON ENGINE
// ════════════════════════════════════════════════════════════════
const dungeon = { townId:0, floors:[], floorIdx:0, grid:null, cleared:{}, chests:{}, bossDead:false, returnTo:null, projectiles:[], adds:[] };
// _legacy: showBanner(`<b …>Eldan the Sage</b>…`, 3600)
//   His glade is a CONVERSATION — two lore beats, then the trial, then the
//   reward — and every line of it was on a 3.6 second fuse. Tapping through it
//   read as a flicker of half-seen banners rather than a talk with a man.
//   Accepts a string or an array, so a multi-part beat is ONE conversation
//   the knight taps through, not a queue of things that fade.
function sageSay(t, onDone){ sayAs('Eldan the Sage', t, onDone); }
const SAGE_INTRO=[
  `"Ah... a knight walks the old wood. Few find my glade — fewer still by accident. Sit; the trees are patient."`,
  `"In time I can teach you to raise more than one companion — when a steed has grown to its fullness, send it home to the barn with honor and raise another at your side."`,
];
let _sageIntro=0;
function sageTalk(){
  // ── GOLDEN FISH QUEST ──
  if(quests.goldenFish==='unstarted'){
    // first couple of taps = lore, then he offers the trial
    if(_sageIntro<SAGE_INTRO.length){ sageSay(SAGE_INTRO[_sageIntro++]); return; }
    quests.goldenFish='active'; saveGame();
    sageSay(`"But wisdom is not bought with gold — only deeds. Here is your first trial: <b style='color:#ffe04a'>catch the Golden Fish</b> that hides in the quiet waters of the realm. Cast your line in pond, sea, or oasis... patience will reward you. Bring it to me." 🎣`);
    return;
  }
  if(quests.goldenFish==='active'){
    if(inventory.goldenFish>0){
      // turn it in — complete the quest (the pet offer comes in a later step)
      quests.goldenFish='done'; inventory.goldenFish=0; saveGame();
      sageSay(`"The Golden Fish! It shimmers like a promise kept. You have the patience of the old saints, knight. 🌟 The first trial is done — return to me again, and we shall speak of your reward."`);
      return;
    }
    sageSay(`"The Golden Fish still hides, knight. Cast your line in the quiet waters — pond, sea, or oasis. It comes to those who wait." 🎣`);
    return;
  }
  // ── SECOND TRIAL: CARRY KINDNESS TO THE FORGOTTEN ──
  if(quests.kindness==='unstarted'){
    quests.kindness='active';
    if(inventory.sacredScroll<1) inventory.sacredScroll=1;     // Eldan hands you the scroll
    saveGame();
    sageSay(`"Now the second trial — the harder one, for it asks your time, not your blade. Take this <b style='color:#ffe9a8'>sacred scroll</b> 📜, and grow <b style='color:#ffe9a8'>provisions</b> from the earth — wheat, three measures. <br><br>Carry them to one the world forgot: <i>'Where the Destroyer's shadow falls coldest, seek the green hush north of his black gate. A door of stone breathes in the deep wood; within, an old flame still waits for friends long gone.'</i> 🕯️"`);
    return;
  }
  if(quests.kindness==='active'){
    const haveFood=(inventory.wheat||0)>=3, haveScroll=(inventory.sacredScroll||0)>=1;
    if(haveFood && haveScroll) sageSay(`"You have the scroll and the grain. Now find him, knight — north of Hellgate, in the deep wood. A door of stone, an old flame waiting." 🕯️`);
    else sageSay(`"Bring the <b style='color:#ffe9a8'>sacred scroll</b> 📜 and <b style='color:#ffe9a8'>three measures of wheat</b> 🌾 to the forgotten one in the wood north of Hellgate. Grow the grain from tilled earth; the scroll you already carry." `);
    return;
  }
  // both trials done — idle wisdom (the pet reward comes in the next step)
  sageSay(`"You have done well, knight — the fish caught, kindness carried. Rest a moment in the green hush. Your reward will come when next we speak." 🌿`);
}
// _legacy: showBanner(`<b …>The Old Monk</b>…`, 4200)  — same fault as sageSay.
function monkSay(t, onDone){ sayAs('The Old Monk', t, onDone); }
function monkTalk(){
  // already delivered — warm thanks
  if(quests.kindness==='done'){
    monkSay(`"You are the one who came. The bread is long eaten, the scroll read by firelight — but the kindness stays warm. Go with God, knight." 🕯️`);
    return;
  }
  // quest active and the player has the scroll + provisions → deliver, complete it
  if(quests.kindness==='active'){
    const haveScroll=(inventory.sacredScroll||0)>=1, haveFood=(inventory.wheat||0)>=3;
    if(haveScroll && haveFood){
      inventory.sacredScroll=0; inventory.wheat-=3;
      quests.kindness='done'; saveGame();
      monkSay(`"...A scroll? And bread, warm from the world above? For me?" <br><br>The old monk's eyes shine. "I had begun to believe I was forgotten. You have carried more than provisions, knight — you have carried <b style='color:#ffe9a8'>kindness</b> into the dark. Bless you. Return to the sage; tell Eldan his trial is met." 🕯️🌾`);
      return;
    }
    // active but missing items — hint at what's needed
    if(!haveScroll && !haveFood) monkSay(`"A traveler... have you something for an old hermit? Eldan's scroll, perhaps, and a little bread? My friends used to bring both." `);
    else if(!haveFood) monkSay(`"You carry the sage's scroll, I see it. But an old man cannot live on words — have you any bread? Three measures of wheat would see me through the winter." 🌾`);
    else monkSay(`"Bread! Bless you... but where is Eldan's scroll? He always sent word with those who came. Bring it, and I will know you are truly his." 📜`);
    return;
  }
  // quest not yet given by Eldan — a quiet greeting
  monkSay(`"Oh... a visitor? It has been so long. I keep the fire lit for friends who went to the citadel and never came back. Sit a while, knight — the road outside is dark."`);
}
// ── Every dungeon entry must state ALL FOUR of its mode flags. Each one gates
//    rendering or progression, and leaving one set from a previous dungeon has
//    real consequences: a stale `disillusion` makes a town chapel render as cursed
//    forest (the forest branch in drawDungeonTile returns before tile 7, so the
//    bound general becomes invisible) AND skips the clear-all-demons stairs gate
//    entirely. Set them together through here, never one at a time.
function setDungeonMode(m){
  m = m || {};
  dungeon.forest      = !!m.forest;
  dungeon.disillusion = !!m.disillusion;
  dungeon.inGlade     = !!m.inGlade;
  dungeon.monkCave    = !!m.monkCave;
}
function enterForest(){
  setDungeonMode({forest:true});
  dungeon.townId = 99;                 // seed namespace for the wood's own mazes
  dungeon.floors = [0,1,3];            // two forest mazes, then the sage's glade
  dungeon.floorIdx = 0;
  dungeon.cleared = {}; dungeon.chests = {}; dungeon.bossDead = false;
  dungeon.returnTo = { x:24*TILE, y:140*TILE };
  loadDungeonFloor(0);
  place = { kind:'dungeon' };
  saveGame();
  showBanner(`🌲 Sage's Wood<br><span style="font-size:7px">The trees close behind you. Forest spirits prowl the dark — find the way through.</span>`, 2600);
}
// ── THE FOREST OF DISILLUSIONMENT (entry) ──────────────────────────────────
//  Enter from either overworld mouth. The return position is the OPEN road stub
//  beside whichever mouth you came in by, so you never spawn inside the tree wall.
//  (Step 2 swaps the temporary interior for the dedicated 21×41 maze floor.)
function enterDisillusionment(mouth){
  setDungeonMode({forest:true, disillusion:true});
  dungeon.townId = 97;                 // its own seed namespace (distinct from Sage's Wood=99)
  dungeon.floors = [5];                // ONE large 21×41 forest-maze floor
  dungeon.forestSeed = 97;             // stable seed → the wood is the same place each visit
                                       // (Step 4 hides Eldan's entrance inside it)
  dungeon.floorIdx = 0;
  dungeon.cleared = {}; dungeon.chests = {}; dungeon.bossDead = false;
  // return to the WALKABLE stub beside the mouth you entered (never onto trees/hollow)
  dungeon.returnTo = (mouth==='south')
    ? { x:33*TILE, y:187*TILE }        // south mouth: road stub below the hollow
    : { x:33*TILE, y:82*TILE };        // north mouth: road stub above the hollow
  dungeon.entryMouth = mouth;
  loadDungeonFloor(0);
  place = { kind:'dungeon' };
  saveGame();
  showBanner(`🌫️ <b>The Forest of Disillusionment</b><br><span style="font-size:7px">A cold fog drinks the light. You can see only a few paces. Press on, and pray you find the way.</span>`, 2800);
}
// Emerge from the forest at the given overworld mouth ('north' or 'south').
function exitDisillusionment(mouth){
  place = { kind:'overworld' };
  setDungeonMode();                 // out of the wood entirely
  demons = []; spawnDemons();
  // land on the WALKABLE road stub beside that mouth (never on the hollow or trees)
  if(mouth==='south'){ player.x=33*TILE; player.y=187*TILE; player.dir='down'; }
  else               { player.x=33*TILE; player.y=82*TILE;  player.dir='up';   }
  saveGame();
  showBanner(mouth==='south'
    ? `🌅 You break through the tree-line at last — the road to <b>Saltmere</b> opens ahead.`
    : `🌅 You emerge from the wood, back on the <b>Ironhold</b> road.`, 2400);
}
// Step through the hidden hollow deep in the maze into Eldan's Glade. We remember the
// maze position so leaving the glade drops you right back where you found the hollow.
function enterSageGlade(){
  dungeon._gladeReturn = { x:player.x, y:player.y };   // remember the hollow's spot in the maze
  dungeon._mazeGrid = dungeon.grid;                    // stash the maze so we can restore it
  dungeon.inGlade = true;
  dungeon.grid = genGladeFloor();
  DH = dungeon.grid.length; DW = dungeon.grid[0].length;
  demons = []; dungeon.projectiles=[]; dungeon.adds=[];
  // place the player next to the glade entrance (tile 8)
  let ex=7, ey=9; for(let y=0;y<DH;y++)for(let x=0;x<DW;x++) if(dungeon.grid[y][x]===8){ ex=x; ey=y; }
  player.x=ex*TILE; player.y=(ey-1)*TILE; player.dir='up';
  dungeon._justEntered=true;
  saveGame();
  showBanner(`🌿 Light through the canopy... a hidden glade. <b style="color:#8fd4a8">Eldan the Sage</b> waits at the old altar.`, 2800);
}
function leaveSageGlade(){
  dungeon.inGlade = false;
  dungeon.grid = dungeon._mazeGrid;                    // restore the maze
  DH = dungeon.grid.length; DW = dungeon.grid[0].length;
  demons = [];                                         // the glade had none; maze demons stay cleared (forest needs no clearing)
  const r = dungeon._gladeReturn;
  if(r){
    // step the player to an adjacent walkable maze tile so they don't instantly re-enter
    const hx=Math.floor(r.x/TILE), hy=Math.floor(r.y/TILE);
    let px=hx, py=hy;
    for(const [dx,dy] of [[0,1],[0,-1],[1,0],[-1,0]]){
      const nx=hx+dx, ny=hy+dy;
      if(dungeon.grid[ny] && dungeon.grid[ny][nx]===0){ px=nx; py=ny; break; }
    }
    player.x=px*TILE; player.y=py*TILE; player.dir='down';
  }
  dungeon._justEntered=true;
  showBanner('🌲 You step back into the fog of the wood.', 1400);
}
function enterMonkCave(){
  setDungeonMode({forest:true, monkCave:true});   // reuses the forest namespace
  dungeon.townId = 99;
  dungeon.floors = [4];             // a single special floor (type 4 = monk cave)
  dungeon.floorIdx = 0;
  dungeon.cleared = {}; dungeon.chests = {}; dungeon.bossDead = false;
  dungeon.returnTo = { x:196*TILE, y:8*TILE };
  loadDungeonFloor(0);
  place = { kind:'dungeon' };
  saveGame();
  showBanner(`🕯️ A Hidden Cave<br><span style=\"font-size:7px\">Cold stone and the far glow of a fire. Someone dwells deep within...</span>`, 2600);
}
function enterChapel(b){
  sfxDoor(true);
  const townId = CHAPEL_TOWN[b.id];
  // a cleansed town's chapel becomes its SANCTUARY — pews, pulpit, a teaching
  // priest, the town's redeemed general at service, and the library lectern.
  if(chapelProgress[townId]){ enterSanctuary(townId, b); return; }
  /* _legacy routing: if(chapelProgress[townId]){ openLibrary(townId, b); return; } */
  setDungeonMode();                 // a chapel is none of the special modes
  dungeon.townId = townId;
  dungeon.floors = getChapelFloors(townId);
  dungeon.floorIdx = 0;
  dungeon.cleared = {}; dungeon.chests = {}; dungeon.bossDead = false;
  dungeon.returnTo = { x:b.door.x*TILE, y:(b.door.y+1)*TILE };
  loadDungeonFloor(0);
  place = { kind:'dungeon' };
  const td=TOWN_DATA[townId];
  saveGame();   // auto-save on entering a chapel
  showBanner(`⛪ ${td.general}'s Chapel<br><span style="font-size:7px">Free the general trapped within!</span>`, 2000);
}
// ── SANCTUARIES: a cleansed chapel becomes a true chapel. Pews face the pulpit,
//    the priest teaches the town's doctrine (one lesson per talk, cycling), the
//    town's REDEEMED GENERAL sits in service in Aldric-style attire tinted to
//    their town, and the old library lives on at the lectern by the door. ──
const PRIEST_NAMES=['Father Polycarp','Father Athanasius','Father Chrysostom','Father Augustine',
  'Father Irenaeus','Father Anselm','Father Basil','Father Aquinas','Father Gregory','Father Wycliffe'];
const PRIEST_TEACHINGS=[
 ['Scripture is a lamp to the feet, child — not a leash, but a light. Walk by it.',
  'Every word tested, every promise kept. The Book has outlasted every empire that burned it.',
  'Read it as a letter from home. It was written that you might not lose the way.'],
 ['Before the mountains were, HE IS. Unmade, unchanging, unbought — and yet He knows your name.',
  'The forge teaches us: what is true does not bend in the fire. So it is with God.',
  'We do not shrink God to fit our minds; we stretch our hearts to fit His mercy.'],
 ['You are made in the image of God — the tide may wear the cliff, but not the imprint.',
  'Dust and breath, child. Never forget you are both — humble as dust, alive by His breath.',
  'Every soul in this harbor is a coin stamped with the King\u2019s face. Spend none cheaply.'],
 ['Sin is not a broken rule first — it is a broken heart turned from home.',
  'The thorn does not become a rose by hiding its point. Confess, and be pruned into life.',
  'Grace does not excuse the wound; it heals it. There is a difference, and it is everything.'],
 ['The Word became flesh and walked our ash and ember — fully God, fully man, fully for you.',
  'He did not shout from the ridge; He came down into the valley. That is Christology, child.',
  'Behold the mystery: the Author stepped onto the page.'],
 ['Salvation is not scaled like this peak — it is given, as snow is given to the summit.',
  'By grace, through faith — not of works, lest any knight should boast of his own blade.',
  'You were bought at a price. Walk warm in that, whatever the weather.'],
 ['The Spirit is not a wind you command but a breath you welcome.',
  'From these ashes, He raises gardens. The Helper is nearer than your armor.',
  'Gifts differ as embers differ — but one Fire kindles them all.'],
 ['The Church is not these stones — it is the living stones seated beside you.',
  'One body, many members. Even a storm-wall stands only because each stone bears another.',
  'Do not forsake the assembly, knight. Lone coals go cold.'],
 ['The angels are ministers, not masters — servants of the same King you serve.',
  'More stand with us than against us, though shadow hides the host.',
  'Worship no messenger. Even the brightest herald bows toward the throne.'],
 ['Behold, He makes all things new — the Last Things are not an ending but a wedding.',
  'Every gate of hell has a hinge, and every hinge obeys Him. Fear not the last chapter.',
  'Live ready, not anxious. The King returns for a Bride, not a fugitive.']];
const GENERAL_LINES=[
 'I guarded the first doctrine and was first to fall. You brought me back to the Book, knight.',
 'I trusted iron more than the Smith who made it. Now I sit, and listen, and am mended.',
 'The tide took my faith out and your blade brought it home. I owe you my mornings.',
 'The thorns grew from my own heart. Pruned now — and blooming, slowly.',
 'I denied the Word made flesh until you cut the lie away. Now I cannot hear enough of Him.',
 'I climbed for my own salvation and froze. It was given me instead — as snow is given.',
 'I quenched the Spirit and called it discipline. He rekindles even generals.',
 'I broke the assembly I was sworn to shield. See — the Church rebuilt me among them.',
 'I bowed to a bright messenger and forgot the King. Never again, knight. Never again.',
 'I feared the last chapter and served the darkness to delay it. You taught me to long for it.'];
const GENERAL_TINTS=['#a02030','#8a3a2a','#2a6a9a','#2a7a3a','#c06a2a','#7ab8d8','#5a5a64','#3a4a9a','#6a3a8a','#8a1a2a'];
function buildSanctuary(townId){
  const id='sanct'+townId;
  if(INTERIORS[id]) return id;
  // A proper nave: 13 wide × 18 tall. Rows 1-4 are a RAISED CHANCEL (platform tile
  // 15) reached by a step course (tile 14); the pulpit sits on it, the altar behind.
  // Tile legend inside a sanctuary: 5 wall · 12 flag floor · 13 pew · 14 chancel
  // step riser · 15 chancel platform · 17 altar block · 18 pulpit.
  const W=13,H=18,g=[];
  for(let y=0;y<H;y++){ g.push([]); for(let x=0;x<W;x++) g[y].push(y===0||y===H-1||x===0||x===W-1?5:12); }
  for(let x=1;x<W-1;x++){ g[1][x]=15; g[2][x]=15; g[3][x]=15; }      // raised chancel floor (3 rows deep)
  [3,4,8,9].forEach(x=>g[1][x]=17);                                  // altar blocks flanking centre, back wall
  [5,6,7].forEach(x=>g[2][x]=17);                                    // altar table centre
  g[2][6]=18;                                                        // pulpit (priest teaches here)
  for(let x=1;x<W-1;x++) g[4][x]=14;                                 // step course down to the nave (aisle gap kept walkable via 14)
  g[4][6]=14;                                                        // centre step (still walkable)
  // long pew rows down the nave, aisle at x6. Pews occupy x2-4 and x8-10, leaving
  // x1,x5,x7,x11 as side walkways and x6 as the central aisle — so NPCs and the
  // player can always reach a seat-front. Rows 8 and 11 are left clear as cross-aisles.
  for(const y of [6,7,9,10,12,13,15]){ [2,3,4].forEach(x=>g[y][x]=13); [8,9,10].forEach(x=>g[y][x]=13); }
  g[H-1][6]=9;                                                       // exit to the doorstep (aisle stays clear)
  const td=TOWN_DATA[townId];
  INTERIORS[id]={ name:td.name+' Sanctuary', theme:'sanctuary', floors:[{w:W,h:H,g}], npcs:[
    { floor:0, x:6, y:3, name:PRIEST_NAMES[townId], priest:true, cycle:true, lines:PRIEST_TEACHINGS[townId] },
    { floor:0, x:7, y:9, name:td.general, rgeneral:true, town:townId,   // side walkway beside a pew
      lines:[GENERAL_LINES[townId]] },
    { floor:0, x:5, y:12, name:'Ezra the Scribe', librarian:true, town:townId,   // opposite side walkway
      lines:['The doctrine you have won is kept here. Study, or browse the wares.'] },
  ]};
  return id;
}
function enterSanctuary(townId, b){
  const id=buildSanctuary(townId);
  returnStack.push({ x:b.door.x*TILE, y:(b.door.y+1)*TILE, dir:'down' });
  place={kind:'interior', id, floor:0};
  const f=INTERIORS[id].floors[0];
  let sx=6, sy=f.h-2; for(let y=0;y<f.h;y++)for(let x=0;x<f.w;x++) if(f.g[y][x]===9){ sx=x; sy=y-1; }
  player.x=sx*TILE; player.y=sy*TILE; player.dir='up';
  showBanner('⛪ <b>'+TOWN_DATA[townId].name+' Sanctuary</b><br><span style="font-size:7px">The chapel breathes again. Hear the Word; greet the redeemed.</span>', 2600);
}
// ── TOWN LIBRARY — unlocked after the town is cleansed ──
const library = { open:false, townId:0, doc:0, scroll:0, returnTo:null };
function openLibrary(townId, b){
  library.open=true; library.townId=townId; library.doc=0; library.scroll=0;
  library.returnTo = b ? { x:b.door.x*TILE, y:(b.door.y+1)*TILE } : null;   // null → opened from inside the sanctuary
  renderLibrary();
  document.getElementById('gamemenu').classList.add('open');
}
function renderLibrary(){
  const td=TOWN_DATA[library.townId]; const dd=DEEP_DOCTRINE[library.townId];
  // which cleansed towns' doctrine can be studied here (all completed so far)
  const studyable = TOWN_DATA.map((t,i)=>i).filter(i=>chapelProgress[i]);
  if(!studyable.includes(library.doc)) library.doc=library.townId;
  const cur=DEEP_DOCTRINE[library.doc];
  let html=`<div class="gm-close" data-close="1">✕</div><div class="gm-tabs"><div class="gm-tab sel">📚 ${td.name} Library</div></div><div class="gm-body">`;
  html+=`<div style="font-size:7px;color:#9a8ab8;margin:2px 4px 8px;line-height:1.7">Ezra the Scribe keeps these shelves. The town is cleansed; its library is open — study the doctrine you've mastered.</div>`;
  // doctrine selector (arrows are tappable on touch screens)
  html+=`<div style="display:flex;align-items:center;gap:6px;margin:2px 0 4px">`
    + `<div class="gm-tab" data-libnav="-1" style="flex:0 0 30px">◀</div>`
    + `<div class="gm-sectitle" style="color:#f5a623;flex:1;text-align:center;margin:0">${cur.head}</div>`
    + `<div class="gm-tab" data-libnav="1" style="flex:0 0 30px">▶</div></div>`;
  html+=`<div style="max-height:42vh;overflow-y:auto;padding:2px 4px">`;
  cur.points.forEach(p=>{ const colon=p.indexOf(':'); const term=colon>0&&colon<40?p.slice(0,colon):''; const body=term?p.slice(colon+1):p;
    html+=`<div style="font-size:7px;color:#cbb8e0;line-height:1.9;margin-bottom:7px">${term?`<b style="color:#ffe04a">${term}:</b>`:''}${body}</div>`; });
  html+=`</div>`;
  html+=`<div class="gm-node" data-libwares="1" style="margin-top:6px"><span class="nm" style="pointer-events:none">📜 Browse progression wares <span class="ds">rare gear for gold</span></span></div>`;
  html+=`<div class="gm-hint">◀▶ doctrine (${studyable.indexOf(library.doc)+1}/${studyable.length}) · ✕ leave</div>`;
  html+=`</div>`;
  document.getElementById('gamemenu').innerHTML=html;
}
function libraryMove(dx){ const studyable=TOWN_DATA.map((t,i)=>i).filter(i=>chapelProgress[i]); if(!studyable.length) return;
  let idx=studyable.indexOf(library.doc); if(idx<0)idx=0; idx=(idx+dx+studyable.length)%studyable.length; library.doc=studyable[idx]; renderLibrary(); }
function librarySelect(){ openLibraryShop(library.townId); }   // A → progression gear store
function closeLibrary(){ library.open=false; document.getElementById('gamemenu').classList.remove('open'); const r=library.returnTo;
  if(r){ place={kind:'overworld'}; player.x=r.x; player.y=r.y; player.dir='down'; showBanner('📚 You leave the library.', 900); }
  else showBanner('📖 You close the lectern.', 900); }   // opened inside the sanctuary — stay there
// progression gear sold in libraries — deeper towns stock stronger wares
const LIBRARY_WARES = {
  0:['ironsword','leather'], 1:['warhammer','chainmail'], 2:['greatsword','chainmail'],
  3:['greatsword','platemail'], 4:['holyblade','platemail'], 5:['holyblade','platemail'],
  6:['holyblade','armorofgod'], 7:['armorofgod'], 8:['armorofgod'], 9:['greatsword','platemail','holyblade','armorofgod'],
};
const LIBRARY_PRICE = { ironsword:80, leather:35, warhammer:110, chainmail:120, greatsword:200, platemail:260, holyblade:400, armorofgod:600 };
function openLibraryShop(townId){
  // build a shop menu of this library's progression wares (only ones not yet owned)
  const wares=(LIBRARY_WARES[townId]||[]).filter(id=>!player.ownedGear[id]);
  if(!wares.length){ showBannerOver('📜 The librarian has no new wares for you — study on, knight.'); return; }
  libShop={ items:wares, idx:0 }; renderLibShop();
}
let libShop=null;
function renderLibShop(msg){
  const id=libShop.items[libShop.idx]; const e=EQUIP[id]; const price=LIBRARY_PRICE[id]||100;
  const list=libShop.items.map((k,i)=>{ const it=EQUIP[k]; const sel=i===libShop.idx; const pr=LIBRARY_PRICE[k]||100;
    return `<div class="gm-item ${sel?'cur':''}">${it.emoji} <span style="flex:1">${it.name} <span class="ds">${it.slot==='weapon'?`[${it.type}] +${it.atk} atk`:`+${it.def} def`}</span></span><span style="color:#ffe04a">${pr}g</span></div>`; }).join('');
  let html=`<div class="gm-close" data-close="1">✕</div><div class="gm-tabs"><div class="gm-tab sel">📜 Library Wares</div></div><div class="gm-body">`;
  html+=`<div class="gm-stat"><span>🪙 Your gold</span><b>${gold}</b></div>`;
  if(msg) html+=`<div style="font-size:7px;color:#6fdf8a;margin:4px;text-align:center">${msg}</div>`;
  html+=list;
  html+=`<div class="gm-hint">▲▼ choose · Ⓐ buy (${price}g) · Ⓑ back to study</div></div>`;
  document.getElementById('gamemenu').innerHTML=html;
}
function libShopMove(dy){ if(!libShop) return; const n=libShop.items.length; libShop.idx=(libShop.idx+dy+n)%n; renderLibShop(); }
function libShopBuy(){ if(!libShop) return; const id=libShop.items[libShop.idx]; const price=LIBRARY_PRICE[id]||100;
  if(player.ownedGear[id]){ renderLibShop('Already owned.'); return; }
  if(gold<price){ renderLibShop('Not enough gold.'); return; }
  gold-=price; player.ownedGear[id]=true;
  libShop.items=libShop.items.filter(x=>x!==id); if(!libShop.items.length){ libShop=null; renderLibrary(); showBannerOver(`Bought ${EQUIP[id].emoji} ${EQUIP[id].name}! Equip it in ☰.`); return; }
  if(libShop.idx>=libShop.items.length) libShop.idx=0; renderLibShop(`Bought ${EQUIP[id].emoji} ${EQUIP[id].name}!`); }
function showBannerOver(t){ showBanner(t,1600); }
function loadDungeonFloor(idx, returning){
  dungeon.floorIdx = idx;
  const ftype = dungeon.floors[idx];
  // generate the floor: mazes for the climb, an arena sanctum, or the sage's glade
  // PLACEHOLDER: the doctrine floor still generates as an ordinary maze until
  // step 10 builds it. The library is real as of step 9.
  dungeon.grid = ftype===FLOOR.library ? genLibraryFloor(dungeon.townId)
               : ftype===FLOOR.forest ? genForestMaze(21, 41, dungeon.forestSeed||97)
               : ftype===FLOOR.cave ? genMonkCave()
               : ftype===FLOOR.sanctum ? genArenaFloor()
               : ftype===FLOOR.glade ? genGladeFloor()
               : genMazeFloor(dungeon.townId, idx);
  DH = dungeon.grid.length; DW = dungeon.grid[0].length;
  // A seal you have already broken stays broken for the run. The floor is
  // regenerated from its seed on every visit, so this must happen BEFORE the
  // knight is placed — otherwise returning seats him against a wall that the
  // very next line takes down.
  // Re-light whatever was already burning. The floor is rebuilt from its seed
  // on every visit, so the candles come back unlit unless we say otherwise.
  dungeon.candleLit=dungeon.candleLit||{};
  { const cs=dungeon._candles||[], lit=dungeon.candleLit[idx]||0;
    for(let i=0;i<Math.min(lit,cs.length);i++){
      if(dungeon.grid[cs[i].y]) dungeon.grid[cs[i].y][cs[i].x]=T_CANDLE_LIT; } }
  dungeon.opened=dungeon.opened||{};
  // You can only RETURN to a floor you climbed from, and you could not have
  // climbed without breaking its seal.
  if(returning) dungeon.opened[idx]=true;
  if(dungeon.opened[idx]){
    for(let y=0;y<DH;y++)for(let x=0;x<DW;x++) if(dungeon.grid[y][x]===T_SEAL) dungeon.grid[y][x]=0;
  }
  dungeon.projectiles=[]; dungeon.adds=[];
  // spawn demons on tile-6 cells (unless already cleared this run), then OPEN the
  // cell — maze demons WANDER the corridors rather than standing as solid blocks.
  demons = [];
  const td = dungeon.forest ? {lvl:6, boss:'', bossHp:0} : TOWN_DATA[dungeon.townId];
  const isTop = ftype===FLOOR.sanctum;
  for(let y=0;y<DH;y++)for(let x=0;x<DW;x++){
    if(dungeon.grid[y][x]===6){
      dungeon.grid[y][x]=0;                               // free the cell
      const k=idx+':'+x+','+y;
      if(dungeon.cleared[k]) continue;                    // already slain this run
      const isBoss = isTop;   // the top-floor demon is the boss guarding the general
      const lv = td.lvl + (isBoss?3:0);
      // _legacy: isBoss ? td.bossHp*2 + lv*6  — far too thin once the 18% cap was
      // removed; bosses now carry a pool worth ~25 blows from a knight of their tier.
      // _legacy: 16 + lv*3 for a lesser demon — survivable in numbers that no
      //   longer exist. A patrolled floor needs each one to matter.
      const hp = isBoss ? td.bossHp*6 + lv*16 : Math.round((16 + lv*3) * 1.4);
      const dem = { x:x*TILE, y:y*TILE, hp, maxHp:hp, level:lv, xp:(isBoss?td.lvl*7:td.lvl*3), t:Math.random()*60,
        alive:true, hurt:0, dungeon:true, dtx:x, dty:y, boss:isBoss, name:isBoss?td.boss:null,
        atk: isBoss ? 10+Math.round(lv*0.9) : 5+Math.round(lv*0.7),
        patrol: isBoss ? 99 : PATROL_R,          // how far it will stray from its post
        pdx:[1,-1,0,0][Math.floor(Math.random()*4)], pdy:0 };
      if(dem.pdx===0) dem.pdy=Math.random()<0.5?1:-1;
      if(isBoss){ // boss fight state machine
        dem.pat=bossPattern(dungeon.townId); dem.moveIdx=0; dem.state='idle'; dem.timer=34;
        dem.guardUntil=performance.now()+1300;     // it stirs — strike now and the blade glances off
        dem.telegraph=0; dem.telMax=0; dem.move=null; dem.kind=null; dem.aimx=0; dem.aimy=0;
        dem.chx=0; dem.chy=0; dem.ring=0; dem.ringR=0; dem.anchorx=x*TILE; dem.anchory=y*TILE;
        dem.col=dem.pat.color;
      }
      demons.push(dem);
    }
  }
  // the guardian announces itself when you step onto its floor
  if(isTop && demons.some(d=>d.alive&&d.boss)) sfxBossRoar();
  // place the player on a walkable floor cell NEXT TO the marker — never ON it —
  // so a stray A-press or first step on entry can't send them back out.
  const _a=dungeonArrivalCell(idx, returning);
  const ex=_a.x, ey=_a.y;
  let sx=ex, sy=ey;
  for(const [dx,dy] of [[0,-1],[0,1],[-1,0],[1,0]]){      // prefer up, then down/left/right
    const nx=ex+dx, ny=ey+dy;
    if(dungeon.grid[ny] && dungeon.grid[ny][nx]===0){ sx=nx; sy=ny; break; }
  }
  player.x=sx*TILE; player.y=sy*TILE; player.dir = (sy<ey?'down':sy>ey?'up':'down');
  // A seal you have already broken stays broken for the run — the floor is
  // regenerated from its seed on every visit, so without this, climbing back
  // down would re-wall a chamber you opened and could strand you inside it.
  dungeon.sealed=dungeon.sealed||{};
  dungeon.sealed[idx]=dungeon.grid.some(r=>r.includes(T_SEAL));
  dungeon._justEntered=true;     // guard: ignore the very next leave attempt
}
// ── ARRIVAL ──
// Which cell marks the way you came in. Climbing INTO a floor lands you at its
// entrance; returning from the floor above lands you at the onward stair you
// originally took, so coming back down doesn't teleport you to the start of a
// floor you already walked. (The interiors model this in changeFloor, matching
// the opposite stair on the target floor; this is the maze vocabulary's version.)
// _legacy: let ex=5, ey=6; for(...) if(grid[y][x]===8){ ex=x; ey=y; }
//   A scan for tile 8 with a hardcoded fallback. Silent and wrong the moment a
//   floor has no tile 8 — which the sanctum is about to be.
function dungeonArrivalCell(idx, returning){
  const g=dungeon.grid, want = returning ? 2 : 8;
  for(let y=0;y<g.length;y++)for(let x=0;x<g[0].length;x++) if(g[y][x]===want) return {x,y};
  // no such marker on this floor: the sanctum is entered at its declared cell,
  // and any other floor falls back to the entrance before giving up
  if(dungeon.floors[idx]===FLOOR.sanctum) return {x:ARENA_ENTRY.x, y:ARENA_ENTRY.y};
  for(let y=0;y<g.length;y++)for(let x=0;x<g[0].length;x++) if(g[y][x]===8) return {x,y};
  for(let y=0;y<g.length;y++)for(let x=0;x<g[0].length;x++) if(g[y][x]===0) return {x,y};
  return {x:1, y:1};
}
// Open every seal on the live floor: the wall grinds back and the chamber beyond
// it is simply there. Idempotent — replaying a solve costs nothing.
// STEP 8 will move the trigger from "the floor is clear" to "the puzzle is solved";
// until the puzzles exist, clearing the floor is what opens the way.
function openSeal(){
  if(!dungeon.grid) return false;
  let opened=0;
  dungeon.rolled=dungeon.rolled||{};
  const list=dungeon.rolled[dungeon.floorIdx]=dungeon.rolled[dungeon.floorIdx]||[];
  for(let y=0;y<dungeon.grid.length;y++)for(let x=0;x<dungeon.grid[0].length;x++){
    if(dungeon.grid[y][x]!==T_SEAL) continue;
    // which way does it roll? Out of the doorway and away down the hall the
    // knight came from — the chamber behind is a dead end with no runway.
    let dir=null, best=-1;
    for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){
      let run=0;
      for(let s=1;s<=4;s++){ const r=dungeon.grid[y+dy*s]; if(!r||r[x+dx*s]===undefined||r[x+dx*s]===1) break; run++; }
      if(run>best){ best=run; dir=[dx,dy]; }
    }
    if(dir && best>0) list.push({x, y, dx:dir[0], dy:dir[1], dist:Math.min(4,best), t0:Date.now()});
    dungeon.grid[y][x]=0; opened++;
  }
  dungeon.sealed=dungeon.sealed||{};
  dungeon.opened=dungeon.opened||{};
  dungeon.sealed[dungeon.floorIdx]=false;
  dungeon.opened[dungeon.floorIdx]=true;
  if(opened){ sfxDoor(true); showBanner('⛓ The wall grinds back — a way opens beyond.', 1600); }
  return opened>0;
}
// Light a candle. Only the RIGHT one takes: a wrong one gutters where it stands
// and nothing already burning goes out, so progress is kept and the walking is
// the whole cost of a mistake.
function lightCandle(tx,ty){
  const cs=dungeon._candles||[]; if(!cs.length) return false;
  const i=cs.findIndex(c=>c.x===tx&&c.y===ty); if(i<0) return false;
  dungeon.candleLit=dungeon.candleLit||{};
  const lit=dungeon.candleLit[dungeon.floorIdx]||0;
  if(i<lit) return false;                                    // already burning
  if(i!==lit){
    showBanner(`🕯 The wick catches, gutters, and dies.<br><span style="font-size:7px">${cs[i].church} is not next.</span>`, 1500);
    return false;
  }
  dungeon.grid[ty][tx]=T_CANDLE_LIT;
  dungeon.candleLit[dungeon.floorIdx]=lit+1;
  sfxDoor(true);
  if(lit+1>=cs.length){
    showBanner('🕯 The last lampstand takes light.', 1400);
    openSeal();
  } else {
    showBanner(`🕯 <b>${cs[i].church}</b> burns. ${cs.length-lit-1} lampstand${cs.length-lit-1===1?'':'s'} remain${cs.length-lit-1===1?'s':''} dark.`, 1500);
  }
  return true;
}
// The tablet quotes the verses and nothing else. Rev 1:11 lists the seven
// churches IN ORDER and Rev 1:20 gives the lampstand reading, so the text hands
// over the answer without ever stating a rule — and a knight who knows his
// Revelation never needs to come here at all.
// say() rather than showBanner(): scripture the player must read cannot be
// allowed to fade on a timer before they have read it.
function readTablet(){
  say([
    '<b style="color:#e8c46a">A tablet, cut deep and filled with old wax</b>',
    '<b>Rev 1:11</b><br>What thou seest, write in a book, and send it unto the seven churches which are in Asia; unto Ephesus, and unto Smyrna, and unto Pergamos, and unto Thyatira, and unto Sardis, and unto Philadelphia, and unto Laodicea.',
    '<b>Rev 1:20</b><br>The seven candlesticks which thou sawest are the seven churches.'
  ]);
}
function dungeonAllClear(){ return !demons.some(d=>d.alive); }
function leaveChapel(){ sfxDoor(false); const r=dungeon.returnTo; setDungeonMode(); place={kind:'overworld'}; demons=[]; spawnDemons(); if(r){player.x=r.x;player.y=r.y;player.dir='down';} showBanner('🌿 You step back outside.', 900); }

// ════════════════════════════════════════════════════════════════
//  ABADDON — the final battle
// ════════════════════════════════════════════════════════════════
const abaddon = { active:false, hp:0, maxHp:0, phase:0, x:0, y:0, anchorx:0, anchory:0,
  state:'idle', timer:0, telegraph:0, telMax:0, move:null, kind:null, moveIdx:0,
  aimx:0, aimy:0, chx:0, chy:0, ring:0, ringR:0, hurt:0, shield:false, shrink:0,
  projectiles:[], adds:[], returnTo:null, intro:0, dead:false, won:false, who:'abaddon' };
function cleansedCount(){ return TOWN_DATA.reduce((n,_,i)=>n+(chapelProgress[i]?1:0),0); }
function enterAbaddon(b){
  if(cleansedCount() < 10){
    showBanner(`🔒 The throne is sealed by dark power.<br><span style="font-size:7px">Cleanse all 10 towns and free every general first. (${cleansedCount()}/10 done)</span>`, 3200); return;
  }
  // if the pretender has taken the throne (Abaddon beaten, pretender unlocked and
  // not yet driven off), the throne room hosts HIM instead of the empty dark.
  if(bounties.pretenderUnlocked && !bounties.pretenderDefeated){ startBossFight(b,'pretender'); return; }
  startBossFight(b,'abaddon');
}
function startBossFight(b, who){
  const cfg = who==='pretender' ? PRETENDER : ABADDON;
  abaddon.who=who;
  abaddon.active=true; abaddon.dead=false; abaddon.won=false;
  abaddon.maxHp=cfg.maxHp; abaddon.hp=cfg.maxHp; abaddon.phase=0;
  abaddon.x=(ABADDON_W/2|0)*TILE; abaddon.y=1.5*TILE; abaddon.anchorx=abaddon.x; abaddon.anchory=abaddon.y;
  abaddon.state='idle'; abaddon.timer=110; abaddon.moveIdx=0; abaddon.shield=false; abaddon.shrink=0;
  abaddon.projectiles=[]; abaddon.adds=[]; abaddon.hurt=0; abaddon.ring=0; abaddon.intro=160;
  abaddon.returnTo={ x:b.door.x*TILE, y:(b.door.y+1)*TILE };
  place={kind:'abaddon'};
  player.mounted=false; player.boating=false;
  player.x=(ABADDON_W/2|0)*TILE; player.y=(ABADDON_H-2)*TILE; player.dir='up'; player.hp=player.maxHp;
  saveGame();
  if(who==='pretender')
    showBanner(`👑 <b style="color:#e0885a">THE PRETENDER KING</b><br><span style="font-size:7px">${cfg.phases[0].taunt}<br>He is stronger than the dark he stole. Read his attacks; dodge with Ⓑ.</span>`, 4600);
  else
    showBanner(`👑 <b style="color:#b026ff">ABADDON, THE DESTROYER</b><br><span style="font-size:7px">${cfg.phases[0].taunt}<br>Read his attacks. Dodge with Ⓑ. End the darkness.</span>`, 4200);
}
function abaddonPhaseFor(){ const r=abaddon.hp/abaddon.maxHp; const ph=bossCfg().phases;
  for(let i=ph.length-1;i>=0;i--){ if(r<=ph[i].hpFrom) return i; } return 0; }
function leaveAbaddon(won){
  abaddon.active=false; const r=abaddon.returnTo; place={kind:'overworld'};
  demons=[]; spawnDemons(); if(r){player.x=r.x;player.y=r.y;player.dir='down';}
}
function abaddonHurtKnight(dmg, pierce){ if(player.iframes>0 && !pierce) return; let inc=Math.max(2,Math.round((dmg-player.def*0.5)*(1-player.dmgReduce))); if(player.blocking){ inc=Math.max(1,Math.ceil(inc*0.1)); player.blockFlash=12; showBlockSpark(); } else sfxHurt(); player.hp=Math.max(0,player.hp-inc); player.iframes=34;
  if(player.hp<=0){ player.hp=player.maxHp; const rt=abaddon.returnTo; abaddon.active=false; place={kind:'overworld'}; demons=[]; spawnDemons(); if(rt){player.x=rt.x;player.y=rt.y;player.dir='down';} showBanner('💫 Abaddon\'s darkness overwhelms you... but you wake at the gate, alive. Try again.', 2600); } }
// The Unicorn is stabled rather than forced into your hand: the barn swap UI
// already exists, so this needs no new screen. Idempotent — a replayed victory
// cannot hand out a second one.
function grantUnicorn(){
  if(!player.barnPets) player.barnPets=[];
  const has = (player.pet && player.pet.id==='unicorn')
           || player.barnPets.some(p=>p && p.id==='unicorn');
  if(has) return false;
  player.barnPets.push({ id:'unicorn', form:2 });
  saveGame();
  showBanner('\ud83e\udd84 <b style="color:#ffe04a">THE UNICORN IS GIVEN!</b><br><span style="font-size:7px">A holy thing out of the world beyond now waits in your stables \u2014 swift as the Lion, whole as the Dove, unbowed as the Sea Dragon, and winged besides. Bring it out at the Homestead Stables.</span>', 4600);
  return true;
}
function winAbaddon(){
  // ── THE PRETENDER: defeat does not slay him — he flees, and his flight tears
  //    open the three southern portals. This is the doorway to the portal-worlds. ──
  if(abaddon.who==='pretender'){
    abaddon.dead=true; abaddon.won=true; abaddon.active=false;
    bounties.pretenderDefeated=true;
    bounties.portalsOpen=true;                              // the three southern portals are now torn open
    bounties.madisonTaken=true;                            // — and he does not flee alone: Madison is seized
    bounties.matthewIntercept=true;                        // Matthew will run up the moment you're back on the overworld
    // credit the pretender bounty as complete if it's in the active list
    const pb=bounties.active.find(x=>x.kind==='pretender');
    if(pb){ bounties.active=bounties.active.filter(x=>x!==pb);
      bounties.complete.push({ title:'The Pretender King', txt:'👑 driven from the throne' });
      if(bounties.complete.length>20) bounties.complete.shift(); }
    player.hp=player.maxHp;
    player.skillPoints+=3;                                  // a reward for the hunt, but not the ultimate gear
    place={kind:'overworld'}; const r=abaddon.returnTo; demons=[]; spawnDemons(); if(r){player.x=r.x;player.y=r.y;player.dir='down';}
    abaddon.who='abaddon';                                  // reset identity so the throne reads normally hereafter
    if(typeof openPortals==='function') openPortals();      // tear open the three southern portals (next build wires the worlds)
    saveGame();
    setTimeout(()=>showBanner('🌀 <b style="color:#e0885a">He does not flee alone.</b><br><span style="font-size:7px">As shadow swallows him, the pretender’s hand closes on Princess Madison’s wrist — \u201cTo a world where you cannot follow! And she comes with me.\u201d Her cry is lost as three portals tear open above the southern islands. The chase is not over.</span>', 7000), 2600);
    showBanner('⚔️ <b style="color:#ffe04a">THE PRETENDER IS CAST DOWN!</b><br><span style="font-size:7px">Abaddon\u2019s stolen throne stands empty once more \u2014 but the usurper has fled the world itself, and taken the princess with him.</span>', 4200);
    return;
  }
  abaddon.dead=true; abaddon.won=true; abaddon.active=false;
  hunt.won=true; initHuntRoster(); ensureAldric();
  player.hp=player.maxHp;
  // ultimate reward
  player.ownedGear['armor_michael']=true; player.skillPoints+=5;
  grantUnicorn();
  chapelProgress.abaddon=true; saveGame();
  // 👑 the on-field victory beat (Abaddon's death, Sir Aldric's thanksgiving) → then the throne
  startAbaddonVictory();
}
// called when a dungeon demon dies (from combat) — open its tile, check boss/floor
function onDungeonDemonKilled(d){
  const k=dungeon.floorIdx+':'+d.dtx+','+d.dty;
  dungeon.cleared[k]=true;
  if(dungeon.grid[d.dty]) dungeon.grid[d.dty][d.dtx]=0;   // body becomes walkable floor
  if(d.boss){ dungeon.bossDead=true; const td=TOWN_DATA[dungeon.townId];
    // BOSS BEATS: _legacy showBanner(`⚔️ ${td.boss} defeated!…`, 2600) — the
    //   single most important line in a chapel, on a 2.6s fuse. It waits now.
    say([`<b>⚔️ ${td.boss} is defeated.</b>`,
         `The thing that bound this place is undone. <b>${td.general}</b> is free to approach. 🙏`]); }
  // _legacy: the INTERIM TRIGGER of step 7 called openSeal() here, so clearing
  //   the floor was what rolled the stone. The lampstands are the key now, and
  //   the demons are pressure while you find them — not a checklist.
  else if(dungeonAllClear()) showBanner('✨ Floor cleared — but the stone still stands.', 1600);
}
function dungeonChestReward(){
  const td=dungeon.forest ? {lvl:6, boss:'', bossHp:0} : TOWN_DATA[dungeon.townId];
  const r=Math.random();
  if(r<0.5){ const g=20+td.lvl*6; gold+=Math.round(g*player.goldMult); return `📦 Chest: <b>${Math.round(g*player.goldMult)} gold!</b>`; }
  if(r<0.8){ inventory.potion=(inventory.potion||0)+2; return '📦 Chest: <b>2 Healing Potions! 🧪</b>'; }
  // occasional gear find scaled to depth
  const gearByTown=['shortsword','leather','ironsword','warhammer','chainmail','greatsword','platemail','holyblade','armorofgod','armorofgod'];
  const g=gearByTown[td_id()]; if(g && !player.ownedGear[g]){ player.ownedGear[g]=true; return `📦 Chest: <b>${EQUIP[g].emoji} ${EQUIP[g].name}!</b><br><span style="font-size:7px">Equip it in the ☰ menu.</span>`; }
  const gold2=30+td.lvl*5; gold+=Math.round(gold2*player.goldMult); return `📦 Chest: <b>${Math.round(gold2*player.goldMult)} gold!</b>`;
}
function td_id(){ return dungeon.townId; }
function freeGeneral(){
  // approaching the freed general begins their theology test
  if(chapelProgress[dungeon.townId]){ const td=TOWN_DATA[dungeon.townId];
    showBanner(`🙏 ${td.general}: "${td.name} remains at peace, knight. Go with God."`, 2600); return; }
  openTheologyTest(dungeon.townId);
}
// ── THEOLOGY TEST overlay ──
const trial = { open:false, townId:0, picked:-1, answered:false };
function openTheologyTest(townId){
  trial.open=true; trial.townId=townId; trial.picked=-1; trial.answered=false;
  menu.open=false;   // ensure menu closed
  renderTrial();
  document.getElementById('gamemenu').classList.add('open');
}

// ════════════════════════════════════════════════════════════════
//  🏟 THE GRAND PET TOURNAMENT — Stormgate's lower-town market
//  Turn-based companion battles in the legacy style: pick a move,
//  trade blows, three rounds of rising purses. Ⓑ/✕ forfeits (you
//  keep gold already won). The knight never takes a scratch.
// ════════════════════════════════════════════════════════════════
const TOURNEY_SPOT='155,222';
const STYLIST_SPOT='153,222';
// 🐎 King's Tourney race booths — unlocked only after the realm is freed (abaddon.won).
function openRace(){
  if(!abaddon.won){
    showBanner("🐎 The race marshal bows. <span style=\"font-size:7px\">\"The King's Tourney is closed while the realm is in shadow, knight. Free the land, and return a champion.\"</span>", 2800);
    return;
  }
  place={kind:'race'};
  // ── crisp rendering: the race screen has fine text + graphics, so swap the low
  //    tile-resolution pixelated canvas for a full device-pixel-resolution, smooth
  //    surface (same treatment the Regatta uses). Restored in finishRace(). ──
  raceCanvasSave = { w:cv.width, h:cv.height, sw:cv.style.width, sh:cv.style.height, ir:cv.style.imageRendering };
  const dpr=Math.min(3, window.devicePixelRatio||1);
  const cssW=Math.round(parseFloat(cv.style.width)||cv.clientWidth||cv.width);
  const cssH=Math.round(parseFloat(cv.style.height)||cv.clientHeight||cv.height);
  cv.width=Math.round(cssW*dpr); cv.height=Math.round(cssH*dpr);
  cv.style.imageRendering='auto';
  startRace({ record: (typeof raceRecordMs==='number'?raceRecordMs:60000) });
}
let raceCanvasSave=null;
const RIBBONS=['','🎀','⭐','🔥','✝','🌊','🍀'];
let styl=null;
function openStylist(){
  if(!player.pet){ showBanner('💈 The stylist smiles — "Bring me a companion to dress, dear!"',2200); return; }
  styl={open:true}; renderStylist();
}
function renderStylist(){
  const f=PETS[player.pet.id].forms[player.pet.form];
  let html=`<div class="gm-close" data-close="1">✕</div><div class="gm-tabs"><div class="gm-tab sel">💈 Pet Stylist of Stormgate</div></div><div class="gm-body">`;
  html+=`<div style="text-align:center;font-size:40px;margin:10px 0">${f.emoji}${player.pet.ribbon||''}</div>`;
  html+=`<div style="font-size:7px;color:#cbb8e0;text-align:center;margin:0 8px 8px;line-height:1.9">"Every champion deserves a touch of flair! Pick a ribbon — first one's free, all of them are free."</div>`;
  html+=`<div class="gm-sectitle">Ribbons</div>`;
  RIBBONS.forEach((rb,i)=>{ const cur=(player.pet.ribbon||'')===rb;
    html+=`<div class="gm-node ${cur?'owned':''}" data-ribbon="${i}"><span class="nm" style="pointer-events:none">${rb||'∅'} ${rb?'Ribbon':'No ribbon'}</span>${cur?'<span style="color:#6fdf8a;pointer-events:none">✓</span>':''}</div>`; });
  html+=`<div class="gm-hint">tap to wear it · shown in battles & the Pet tab · ✕ done</div></div>`;
  gmEl().innerHTML=html; gmEl().classList.add('open');
}
function closeStylist(){ styl=null; gmEl().classList.remove('open'); saveGame(); }

// ════════════════════════════════════════════════════════════════
//  THE BARN / STABLES — swap your active companion with retired ones
// ════════════════════════════════════════════════════════════════
let barn=null;
function openBarn(){
  if(!player.barnPets) player.barnPets=[];
  barn={open:true}; renderBarn();
}
function petCard(p, label, big){
  if(!p) return `<div style="text-align:center;font-size:${big?40:26}px;margin:6px 0;opacity:.4">—</div><div style="font-size:7px;color:#9a8ab8;text-align:center">${label}</div>`;
  const line=PETS[p.id], f=line.forms[p.form];
  return `<div style="text-align:center;font-size:${big?40:26}px;margin:6px 0">${f.emoji}${p.ribbon||''}</div>`
    +`<div style="font-size:8px;color:#e8e4f0;text-align:center;font-weight:600">${line.name}</div>`
    +`<div style="font-size:7px;color:#9a8ab8;text-align:center">${f.name} · ${label}</div>`;
}
function renderBarn(){
  if(!player.barnPets) player.barnPets=[];
  let html=`<div class="gm-close" data-close="1">✕</div><div class="gm-tabs"><div class="gm-tab sel">🐎 The Homestead Stables</div></div><div class="gm-body">`;
  html+=`<div style="font-size:7px;color:#cbb8e0;text-align:center;margin:0 8px 8px;line-height:1.9">Your faithful companions rest here. Bring one out to your side — the one at your side will take its place in the stables.</div>`;
  // current companion
  html+=`<div class="gm-sectitle">At your side</div>`;
  html+=`<div class="gm-node owned" style="display:block">${petCard(player.pet,'active',true)}</div>`;
  // stabled companions
  html+=`<div class="gm-sectitle">In the stables</div>`;
  if(player.barnPets.length===0){
    html+=`<div class="gm-node" style="opacity:.6;display:block"><div style="font-size:7px;color:#9a8ab8;text-align:center;padding:6px">No companions resting yet.<br>Complete Eldan's trials to raise more.</div></div>`;
  } else {
    player.barnPets.forEach((p,i)=>{
      html+=`<div class="gm-node" data-barnswap="${i}" style="display:block;cursor:pointer">${petCard(p,'tap to bring out',false)}</div>`;
    });
  }
  html+=`<div class="gm-hint">tap a stabled companion to swap · ✕ done</div></div>`;
  gmEl().innerHTML=html; gmEl().classList.add('open');
}
function barnSwap(i){
  if(!player.barnPets||i<0||i>=player.barnPets.length) return;
  const incoming=player.barnPets[i];
  const outgoing=player.pet;
  player.pet=incoming;
  player.barnPets.splice(i,1);
  if(outgoing) player.barnPets.push(outgoing);
  updateMountBtn&&updateMountBtn();
  renderBarn(); saveGame();
  const f=PETS[player.pet.id].forms[player.pet.form];
  showBanner(`${f.emoji} ${PETS[player.pet.id].name} bounds to your side!`, 1800);
}
function closeBarn(){ barn=null; gmEl().classList.remove('open'); saveGame(); }
const TOURNEY_FOES=[
  { owner:'Squire Tobin',  pet:'Rascal',  emoji:'🐈', lv:-2, purse:50  },
  { owner:'Dame Mira',     pet:'Asher',   emoji:'🦊', lv:0,  purse:120 },
  { owner:'Captain Bran',  pet:'Goliath', emoji:'🦁', lv:2,  purse:300 },
];
let petB=null;
function petBStats(){
  const f=player.pet.form, lv=player.level;
  let bonus=0; for(const b in PET_TREE) for(const n of PET_TREE[b].nodes) if(player.skills[n.id]&&n.bonus&&n.bonus.petBonus) bonus+=n.bonus.petBonus;
  let atk=6+lv*1.5+f*4+bonus*0.8, def=2+lv*0.5+f*2+bonus*0.3, maxHp=30+lv*4+f*12+bonus, crit=0.04+f*0.02;
  const eq=player.pet.equip||{};
  for(const slot of ['collar','charm']){ const g=eq[slot]&&PET_GEAR[eq[slot]]; if(g&&g.bonus){
    atk+=g.bonus.atk||0; def+=g.bonus.def||0; maxHp+=g.bonus.maxHp||0; crit+=g.bonus.crit||0; } }
  return { atk:Math.round(atk), def:Math.round(def), maxHp:Math.round(maxHp), crit };
}
function petBMoves(){
  const f=player.pet.form; const mv=[{name:'Pounce',icon:'🐾',mult:1.0}];
  if(f>=1) mv.push({name:'Fierce Strike',icon:'⚡',mult:1.5});
  if(player.skills['bond1']) mv.push({name:'Nuzzle',icon:'💚',heal:true});
  if(f>=2||player.skills['devotion2']) mv.push({name:'Holy Charge',icon:'✨',mult:2.0});
  return mv;
}
function openPetTourney(){
  if(!player.pet){ showBanner('🐾 The marshal shakes his head — you need a <b>companion</b> to enter!',2200); return; }
  petB={ open:true, round:0, cursor:0, log:[], done:false, won:false, paid:0 };
  startPetRound();
}
function startPetRound(){
  const foe=TOURNEY_FOES[petB.round]; const lv=Math.max(1, player.level+foe.lv);
  const s=petBStats();
  petB.my={...s, hp:s.maxHp};
  const fhp=Math.round(26+lv*3.6+petB.round*8);
  petB.foe={ name:foe.pet, owner:foe.owner, emoji:foe.emoji, purse:foe.purse,
    atk:Math.round(5+lv*1.3+petB.round*2), def:Math.round(1+lv*0.45), maxHp:fhp, hp:fhp };
  petB.done=false; petB.won=false; petB.myHit=false; petB.foeHit=false; petB.cursor=0;
  petB.log=[`🏟 Round ${petB.round+1}: ${foe.owner} sends out ${foe.pet} ${foe.emoji}!`];
  renderPetB();
}
function petBLog(s){ petB.log.push(s); petB.log=petB.log.slice(-8); }
function petMove(i){
  if(!petB||petB.done) return;
  const f=PETS[player.pet.id].forms[player.pet.form];
  const mv=petBMoves()[i]; if(!mv) return;
  petB.foeHit=false; petB.myHit=false;
  if(mv.heal){
    const h=14+Math.floor(Math.random()*15);
    petB.my.hp=Math.min(petB.my.maxHp, petB.my.hp+h);
    petBLog(`💚 ${f.name} nuzzles close — +${h} HP!`);
  } else {
    const isCrit=Math.random()<(petB.my.crit||0.04);
    let dmg=Math.max(1, Math.floor(petB.my.atk*mv.mult)+(Math.floor(Math.random()*9)-3)-petB.foe.def);
    if(isCrit) dmg=Math.floor(dmg*1.5);
    petB.foe.hp=Math.max(0, petB.foe.hp-dmg); petB.foeHit=true;
    petBLog(`${mv.icon} ${f.name} uses ${mv.name} — ${isCrit?'<b style="color:#ffe04a">CRITICAL!</b> ':''}${dmg} dmg!`);
  }
  if(petB.foe.hp<=0){
    petB.done=true; petB.won=true; gold+=petB.foe.purse; petB.paid+=petB.foe.purse;
    petBLog(`🏆 ${petB.foe.name} is defeated! <b style="color:#ffe04a">+${petB.foe.purse}g</b>`);
    renderPetB(); return;
  }
  const eDmg=Math.max(1, petB.foe.atk - petB.my.def + (Math.floor(Math.random()*11)-4));
  petB.my.hp=Math.max(0, petB.my.hp-eDmg); petB.myHit=true;
  const jeers=['strikes back','lunges fiercely','snaps and claws','pounces in fury'];
  petBLog(`😼 ${petB.foe.name} ${jeers[(petB.log.length)%jeers.length]} — ${eDmg} dmg!`);
  if(petB.my.hp<=0){ petB.done=true; petB.won=false; petBLog(`💫 ${f.name} is exhausted...`); }
  renderPetB();
}
function petAdvance(){
  if(!petB||!petB.done) return;
  if(petB.won && petB.round<TOURNEY_FOES.length-1){ petB.round++; startPetRound(); return; }
  closePetB(petB.won && petB.round===TOURNEY_FOES.length-1);
}
function closePetB(champion){
  const paid=petB?petB.paid:0; petB=null;
  gmEl().classList.remove('open');
  if(champion) showBanner(`👑 <b style="color:#ffe04a">TOURNAMENT CHAMPION!</b><br><span style="font-size:7px">The market roars — ${paid} gold in winnings!</span>`,3200);
  else if(paid>0) showBanner(`🐾 Out of the running — but ${paid}g won still shines.`,2200);
  else showBanner('🐾 Your companion will grow stronger. Return anytime!',2000);
  saveGame();
}
function renderPetB(){
  const f=PETS[player.pet.id].forms[player.pet.form];
  const bar=(hp,max,col)=>`<div style="background:#1a1030;border:1px solid #3a2a5a;border-radius:3px;height:8px;margin:3px 0"><div style="width:${Math.max(0,Math.round(hp/max*100))}%;height:100%;background:${col};border-radius:2px;transition:width .2s"></div></div>`;
  let html=`<div class="gm-close" data-close="1">✕</div><div class="gm-tabs"><div class="gm-tab sel">🏟 Pet Tournament — Round ${petB.round+1}/${TOURNEY_FOES.length}</div></div><div class="gm-body">`;
  html+=`<div style="display:flex;align-items:center;gap:9px;margin:4px 2px"><span style="font-size:30px;${petB.foeHit?'animation:pbshake .18s':''}">${petB.foe.emoji}</span><div style="flex:1"><div style="font-size:7px;color:#ff8a8a">${petB.foe.name} <span style="color:#9a8ab8">— ${petB.foe.owner}</span></div>${bar(petB.foe.hp,petB.foe.maxHp,'#ff6a7a')}<div style="font-size:6px;color:#9a8ab8">${petB.foe.hp}/${petB.foe.maxHp}</div></div></div>`;
  html+=`<div style="display:flex;align-items:center;gap:9px;margin:4px 2px"><span style="font-size:30px;${petB.myHit?'animation:pbshake .18s':''}">${f.emoji}${player.pet.ribbon||''}</span><div style="flex:1"><div style="font-size:7px;color:#6fdf8a">${f.name} <span style="color:#9a8ab8">— yours</span></div>${bar(petB.my.hp,petB.my.maxHp,'#6fdf8a')}<div style="font-size:6px;color:#9a8ab8">${petB.my.hp}/${petB.my.maxHp}</div></div></div>`;
  html+=`<div style="background:#0d0618;border:1px solid #2a1c44;border-radius:3px;font-size:6px;line-height:2;padding:5px 7px;margin:7px 2px;min-height:50px;max-height:20vh;overflow-y:auto;color:#cbb8e0">${petB.log.map(l=>`<div>${l}</div>`).join('')}</div>`;
  if(!petB.done){
    html+=`<div class="gm-sectitle">Moves</div>`;
    petBMoves().forEach((mv,i)=>{ const cur=petB.cursor===i;
      html+=`<div class="gm-node ${cur?'cur':''}" data-petmove="${i}"><span class="nm" style="pointer-events:none">${mv.icon} ${mv.name} <span class="ds">${mv.heal?'restore 14–28 HP':'×'+mv.mult+' power'}</span></span></div>`; });
    html+=`<div class="gm-hint">tap a move · ▲▼ then Ⓐ · ✕ forfeit (keep winnings)</div>`;
  } else {
    const last=petB.won && petB.round===TOURNEY_FOES.length-1;
    html+=`<div class="gm-node" data-petgo="1" style="margin-top:8px;${petB.won?'border-color:#ffe04a':''}"><span class="nm" style="pointer-events:none;${petB.won?'color:#ffe04a':''}">${petB.won?(last?'👑 Claim the championship!':'⚔ Face the next challenger'):'🐾 Leave the arena'}</span></div>`;
  }
  html+=`</div>`;
  gmEl().innerHTML=html; gmEl().classList.add('open');
}

function renderTrial(){
  const td=TOWN_DATA[trial.townId]; const t=THEOLOGY_TESTS[trial.townId];
  let html=`<div class="gm-close" data-close="1">✕</div><div class="gm-tabs"><div class="gm-tab sel">🙏 ${td.general}'s Trial</div></div><div class="gm-body">`;
  html+=`<div class="gm-sectitle" style="color:#f5a623">${td.head}</div>`;
  if(!trial.answered){
    html+=`<div style="font-size:8px;color:#cbb8e0;line-height:1.9;margin:6px 4px 10px">"${["Young knight, before I pass on my gift, answer rightly what you know of the faith I died defending.","Prove your understanding, and my blessing is yours."][0]}"</div>`;
    html+=`<div style="font-size:8px;color:#fff;line-height:1.8;margin-bottom:8px">${t.q}</div>`;
    t.o.forEach((opt,i)=>{ const cur=trial.picked===i;
      html+=`<div class="gm-node ${cur?'cur':''}" data-trial="${i}" style="line-height:1.7"><span class="nm" style="pointer-events:none">${String.fromCharCode(65+i)}. ${opt}</span></div>`; });
    html+=`<div class="gm-hint">Tap an answer, or ▲▼ then Ⓐ · Ⓑ leave</div>`;
  } else {
    const correct = trial.picked===t.a;
    html+=`<div style="font-size:9px;color:${correct?'#6fdf8a':'#ff8a8a'};margin:6px 4px;font-weight:bold">${correct?'✓ Correct!':'✗ Not quite.'}</div>`;
    html+=`<div style="font-size:7px;color:#cbb8e0;line-height:1.9;margin:4px;max-height:38vh;overflow-y:auto">${t.ex}</div>`;
    if(correct){ const rw=EQUIP[GENERAL_REWARD[trial.townId]];
      html+=`<div class="gm-sectitle" style="color:#ffe04a;margin-top:8px">Reward</div><div class="gm-item equipped">${rw.emoji} <span style="flex:1">${rw.name}</span></div>`;
      html+=`<div class="gm-node" data-trialgo="1" style="margin-top:8px;border-color:#ffe04a"><span class="nm" style="pointer-events:none;color:#ffe04a">🙏 Receive the blessing &amp; cleanse the town</span></div>`;
      html+=`<div class="gm-hint">📖 ${td.div} restored · tap above or press Ⓐ</div>`;
    } else {
      html+=`<div class="gm-node" data-trialgo="1" style="margin-top:8px"><span class="nm" style="pointer-events:none">↻ Try again</span></div>`;
      html+=`<div class="gm-hint">tap above or Ⓐ · ✕ leave</div>`;
    }
  }
  html+=`</div>`;
  document.getElementById('gamemenu').innerHTML=html;
  const curT=document.querySelector('#gamemenu .gm-node.cur');
  if(curT && curT.scrollIntoView) curT.scrollIntoView({block:'nearest'});
}
function trialMove(dy){ if(trial.answered) return; const n=THEOLOGY_TESTS[trial.townId].o.length;
  trial.picked=(trial.picked<0?0:(trial.picked+dy+n)%n); renderTrial(); }
function trialSelect(){
  const t=THEOLOGY_TESTS[trial.townId];
  if(!trial.answered){ if(trial.picked<0) return; trial.answered=true; renderTrial(); return; }
  // answered:
  if(trial.picked===t.a){ grantGeneralReward(trial.townId); closeTrial(); }
  else { trial.answered=false; trial.picked=-1; renderTrial(); }   // retry
}
function closeTrial(){ trial.open=false; document.getElementById('gamemenu').classList.remove('open'); if(place.kind==='dungeon') leaveChapel(); }
function grantGeneralReward(townId){
  const td=TOWN_DATA[townId]; const rwId=GENERAL_REWARD[townId];
  chapelProgress[townId]=true;
  player.ownedGear[rwId]=true; player.skillPoints+=2; player.hp=player.maxHp;
  const rw=EQUIP[rwId];
  const nextTown = TOWN_DATA[dungeon.townId+1];
  showBanner(`🙏 <b style="color:#ffe04a">${td.general} blesses you!</b><br><span style="font-size:7px">${td.name} is cleansed. 📖 ${td.div} restored.<br>Received <b>${rw.emoji} ${rw.name}</b> — equip it in ☰.<br>+2 skill points · fully healed!${nextTown?`<br><b style="color:#c06aff">💥 The dark dome over ${nextTown.name} shatters!</b>`:''}</span>`, 5800);
  saveGame();   // auto-save after cleansing a town
}
function changeFloor(toFloor){
  const inter=INTERIORS[place.id]; const f=inter.floors[toFloor];
  let sx=f.w-2, sy=2, stx=null, sty=null;
  for(let y=0;y<f.h;y++)for(let x=0;x<f.w;x++){ const t=f.g[y][x]; if((toFloor>place.floor&&t===11)||(toFloor<place.floor&&t===10)){ stx=x; sty=y; sx=x; sy=y+1; } }
  //  ★ land on solid floor. The old rule always dropped the knight one tile SOUTH
  //    of the stair, which put him outside the grid when a stair sat on the wall
  //    row (the cathedral throne room — it read as an empty castle) and on a wall
  //    in the farmhouse. Fall back to the nearest walkable neighbour, preferring
  //    the side that faces INTO the room.
  const ok=(x,y)=> f.g[y] && f.g[y][x]!==undefined && WALK.has(f.g[y][x]);
  if(!ok(sx,sy) && stx!==null){
    const mid=Math.floor(f.h/2), inward=(sty>mid)?-1:1;      // step toward the room's middle
    const cand=[[stx,sty+inward],[stx,sty-inward],[stx-1,sty],[stx+1,sty],
                [stx-1,sty+inward],[stx+1,sty+inward],[stx-1,sty-inward],[stx+1,sty-inward]];
    for(const [cx,cy] of cand){ if(ok(cx,cy)){ sx=cx; sy=cy; break; } }
  }
  place={kind:'interior', id:place.id, floor:toFloor};
  player.x=sx*TILE; player.y=sy*TILE;
  showBanner(toFloor>0?`⬆ Upstairs`:`⬇ Downstairs`, 850);
}
function exitInterior(){ sfxDoor(false);
  // Vesper's cathedral and houses return to the street outside
  if(place.id && String(place.id).indexOf('vesper_')===0 && portalWorld._cathReturn){
    const r=portalWorld._cathReturn; portalWorld._cathReturn=null;
    place={kind:'portalworld'}; player.x=r.x; player.y=r.y; player.dir='down';
    showBanner('\ud83c\udf06 Vesper — the streets of the false capital.', 900); return; }
  // a Sunfall lighthouse returns to its ring
  if(place.id && String(place.id).indexOf('sunlamp_')===0 && portalWorld._lampReturn){
    const r=portalWorld._lampReturn; portalWorld._lampReturn=null;
    place={kind:'portalworld'}; player.x=r.x; player.y=r.y; player.dir='down';
    if(typeof spawnSunfallGloamings==='function') spawnSunfallGloamings();
    showBanner('\ud83c\udf05 Outside — the long gold evening.', 900); return; }
  // a Mistral village chapel returns to the portal world, not the overworld
  if(place.id && String(place.id).indexOf('mistchapel_')===0 && portalWorld._chapelReturn){
    const r=portalWorld._chapelReturn; portalWorld._chapelReturn=null;
    place={kind:'portalworld'}; player.x=r.x; player.y=r.y; player.dir='down';
    showBanner('🌿 Outside', 700); return; }
  if(place.id==='mistthrone' && portalWorld._throneReturn){
    const r=portalWorld._throneReturn; portalWorld._throneReturn=null;
    place={kind:'portalworld'}; player.x=r.x; player.y=r.y; player.dir='down';
    showBanner('🌿 Outside', 700); return; }
  let back=returnStack.pop();
  // If the stack is ever empty — a reload inside a building, a scene that reset
  // it — fall back to THIS building's own door rather than leaving the knight
  // wherever he happened to be, which reads as a teleport to the world spawn.
  if(!back && place.id){
    const _b=buildings.find(b=>b.interior===place.id || b.id===place.id);
    if(_b && _b.door) back={ x:_b.door.x*TILE, y:(_b.door.y+1)*TILE, dir:'down' };
  }
  place={kind:'overworld'}; if(back){player.x=back.x;player.y=back.y;player.dir='down';} showBanner('🌿 Outside', 700); }
// ── enter a portal world via the transport swirl. The warp midpoint does the
//    actual place-swap (see loop's portalWarp handler), so here we just remember
//    where to drop the knight back on the overworld and start the effect. ──
function enterPortalWorld(pr){
  player.mounted=false; player.boating=false; player.driving=false; player.moving=false;
  const home={ x:pr.tx*TILE, y:(pr.ty+1)*TILE };   // just south of the summit portal tile
  beginPortalWarp({ kind:'enter', id:pr.id, home:home });
}
// ── graze-wander: sheep drift to random nearby tiles around their fold and pause
//    to 'graze'; shepherds stroll a little. A rare soft bleat when the player is near. ──
// ── the throne boss update: adapted Abaddon patterns, but projectiles are stopped
//    by pillars, waves of fallen-knights spawn as HP drops, and at low HP he FLEES
//    (6f-3) rather than dying. ──
// `ifr` lets light projectile hits use a short invulnerability window, so a spread
// actually threatens, while heavy blows (charge/slam) still grant a real reprieve.
function throneHurtKnight(dmg, pierce, ifr){ if(player.iframes>0 && !pierce) return;
  let inc=Math.max(2,Math.round((dmg-player.def*0.5)*(1-player.dmgReduce)));
  if(player.blocking){ inc=Math.max(1,Math.ceil(inc*0.1)); player.blockFlash=12; showBlockSpark(); } else sfxHurt();
  player.hp=Math.max(0,player.hp-inc); player.iframes=(ifr||34); scatterFollowers&&scatterFollowers();
  if(player.hp<=0){ player.hp=player.maxHp; mistThrone.fighting=false; mistThrone.boss=null; demons=[];
    const r=portalWorld._throneReturn||{x:portalWorld.castle.gate.x*TILE,y:(portalWorld.castle.gate.y+1)*TILE};
    place={kind:'portalworld'}; player.x=r.x; player.y=r.y; player.dir='down';
    showBanner('\ud83d\udcab The pretender\u2019s power overwhelms you... but you wake at the gate, alive. Steel yourself and return.', 2800); } }
function tickThroneBoss(dt){
  const b=mistThrone.boss; if(!b) return;
  const P={moves:THRONE_MOVES};
  const kcx=player.x+TILE/2, kcy=player.y+TILE/2;
  const bcx=b.x+TILE/2, bcy=b.y+TILE/2;
  const W=15, H=17;
  if(b.intro>0){ b.intro--; }
  // guarded by his knights: he is invulnerable and slowly knits himself back together
  b.warded = demons.some(d=>d._throneAdd && d.alive);
  if(b.warded && b.hp<b.maxHp){ b.regenAcc=(b.regenAcc||0)+dt;
    if(b.regenAcc>=250){ b.regenAcc=0; b.hp=Math.min(b.maxHp, b.hp+Math.round(b.maxHp*0.012)); } }
  // ── HP-gated waves of fallen-knights: at 75/50/25% he summons a wave ──
  [75,50,25].forEach(pct=>{ if(!b.wavesFired[pct] && b.hp<=b.maxHp*(pct/100)){ b.wavesFired[pct]=true;
    const n=pct===25?4:3; for(let i=0;i<n;i++){ const sp=throneSpawnSpot();
      const hp=110+ (100-pct); demons.push({x:sp.x,y:sp.y,hp,maxHp:hp,level:10,xp:0,atk:52,alive:true,hurt:0,t:0,fallen:true,nightBuff:true,face:'down',wander:true,knock:0,_throneAdd:true}); }
    sfxBossRoar&&sfxBossRoar(); showBanner('\ud83d\udc51 <span style="font-size:8px">\u201cRise, my hollow men!\u201d The Pretender summons his fallen knights!</span>', 2200); } });
  if(b.intro<=0){
    if(b.state==='idle'){ b.timer--; b.x+=(b.anchorx-b.x)*0.03; b.y+=(b.anchory-b.y)*0.03;
      b.anchorx=7*TILE + Math.sin(Date.now()*0.0007)*TILE*3;
      if(b.timer<=0){ const mv=P.moves[b.moveIdx%P.moves.length]; b.moveIdx++;
        const rage=b.hp<b.maxHp*0.4?0.7:1; b.move=mv; b.kind=mv.kind; b.state='telegraph'; b.telegraph=Math.round(mv.telegraph*rage); b.telMax=b.telegraph; sfxBossTelegraph&&sfxBossTelegraph(); } }
    else if(b.state==='telegraph'){ b.telegraph--;
      if(b.kind==='charge'){ const m=Math.hypot(kcx-bcx,kcy-bcy)||1; b.aimx=(kcx-bcx)/m; b.aimy=(kcy-bcy)/m; }
      if(b.telegraph<=0){ const mv=b.move; sfxBossStrike&&sfxBossStrike();
        if(mv.kind==='volley'){ const ncx=b.x+TILE/2, ncy=b.y+TILE/2; const baseA=Math.atan2(kcy-ncy,kcx-ncx); for(let i=0;i<mv.count;i++){ const a=baseA+(i-(mv.count-1)/2)*0.10; b.projectiles.push({x:ncx,y:ncy,vx:Math.cos(a)*mv.speed,vy:Math.sin(a)*mv.speed,life:200}); } b.state='idle'; b.timer=32; }
        else if(mv.kind==='spread'){ const ncx2=b.x+TILE/2, ncy2=b.y+TILE/2; const off=Math.random()*0.5; for(let i=0;i<mv.count;i++){ const a=off+(i/mv.count)*Math.PI*2; b.projectiles.push({x:ncx2,y:ncy2,vx:Math.cos(a)*mv.speed,vy:Math.sin(a)*mv.speed,life:200}); } b.state='idle'; b.timer=34; }
        else if(mv.kind==='charge'){ b.state='charge'; b.timer=26; b.chx=b.aimx*mv.speed; b.chy=b.aimy*mv.speed; }
        else if(mv.kind==='slam'){ b.state='slam'; b.timer=16; b.ring=0; b.anchorx=b.x; b.anchory=b.y; }
        else { b.state='idle'; b.timer=34; } } }
    else if(b.state==='charge'){ b.x+=b.chx; b.y+=b.chy; b.timer--;
      if(b.x<TILE){b.x=TILE;b.chx*=-1;} if(b.x>(W-2)*TILE){b.x=(W-2)*TILE;b.chx*=-1;}
      if(b.y<TILE){b.y=TILE;b.chy*=-1;} if(b.y>(H-2)*TILE){b.y=(H-2)*TILE;b.chy*=-1;}
      if(Math.hypot(kcx-(b.x+TILE/2),kcy-(b.y+TILE/2))<TILE*0.85) throneHurtKnight(130);
      if(b.timer<=0){ b.state='idle'; b.timer=30; b.anchorx=7*TILE; b.anchory=2*TILE; } }
    else if(b.state==='slam'){ b.timer--;
      if(b.timer<=0 && b.ring===0){ b.ring=1; b.ringR=0; }
      if(b.ring){ b.ringR+=(b.move.ringSpeed||5); const rd=Math.hypot(kcx-(b.x+TILE/2),kcy-(b.y+TILE/2));
        if(Math.abs(rd-b.ringR)<TILE*0.55) throneHurtKnight(105);   // AoE ring ignores pillar cover
        if(b.ringR>(b.move.ringMax||160)){ b.ring=0; b.state='idle'; b.timer=32; } } }
    if(Math.hypot(kcx-bcx,kcy-bcy)<TILE*0.8) throneHurtKnight(95);
  }
  // projectiles: move, expire, blocked by pillars, hit the knight
  b.projectiles.forEach(p=>{ p.x+=p.vx; p.y+=p.vy; p.life--;
    const tx=Math.floor(p.x/TILE), ty=Math.floor(p.y/TILE); const g=INTERIORS['mistthrone'].floors[0].g;
    if(p.x<0||p.x>W*TILE||p.y<0||p.y>H*TILE) p.life=0;
    else if(g[ty]&&(g[ty][tx]===20||g[ty][tx]===5)) p.life=0;   // pillar/wall stops it
    if(p.life>0 && Math.hypot(p.x-kcx,p.y-kcy)<TILE*0.72){ p.life=0; throneHurtKnight(85,false,12); } });
  b.projectiles=b.projectiles.filter(p=>p.life>0);
  // ── FLEE at low HP: he does not die — he escapes (6f-3 handles the aftermath) ──
  if(b.hp<=b.maxHp*0.18 && !mistThrone.fleeing){ mistThrone.fleeing=true; throneFlee(); }
}
function tickFlock(dt){
  const pw=portalWorld; if(!pw||!pw.sheep) return;
  const step=(e,spd,rad)=>{
    e.t=(e.t||0)+1;
    if(e.wait>0){ e.wait--; return; }
    const tgx=e.tx*TILE, tgy=e.ty*TILE;
    const dx=tgx-e.x, dy=tgy-e.y, d=Math.hypot(dx,dy);
    if(d<1){ // arrived — pause to graze, then pick a new nearby spot
      e.wait=60+Math.floor(Math.random()*160);
      let ax,ay,ok=false;
      for(let tr=0;tr<12 && !ok;tr++){ ax=e.hx+Math.round((Math.random()*2-1)*rad); ay=e.hy+Math.round((Math.random()*2-1)*rad);
        const t=(pw.g[ay]&&pw.g[ay][ax]); ok=(t===0||t===2||t===4||t===6||t===19); }
      if(ok){ e.tx=ax; e.ty=ay; } return; }
    const nx=e.x+(dx/d)*spd*(dt/16), ny=e.y+(dy/d)*spd*(dt/16);
    e.x=nx; e.y=ny; if(Math.abs(dx)>Math.abs(dy)) e.dir=dx<0?'left':'right';
  };
  // a sheep is scared while its village is still overrun (not yet cleansed)
  const clearedMap={}; (pw.villages||[]).forEach(v=>clearedMap[v.id]=!!v.cleared);
  pw.sheep.forEach(s=>{ s.scared = !clearedMap[s.village];
    if(s.scared){
      // huddle: drift toward the fold center and bunch up, slower and skittish
      s.t=(s.t||0)+1;
      const cxp=s.hx*TILE, cyp=s.hy*TILE, dx=cxp-s.x, dy=cyp-s.y, d=Math.hypot(dx,dy);
      if(d>TILE*2){ s.x+=(dx/d)*0.5*(dt/16); s.y+=(dy/d)*0.5*(dt/16); if(Math.abs(dx)>Math.abs(dy)) s.dir=dx<0?'left':'right'; }
      return; }
    step(s, 0.35, 5); });
  pw.shepherds.forEach(s=>step(s, 0.3, 3));
  // ambient bleat: rare, only when the player is reasonably close to a sheep
  if(!tickFlock._bl) tickFlock._bl=0; tickFlock._bl--;
  if(tickFlock._bl<=0){ tickFlock._bl=180+Math.floor(Math.random()*240);
    for(const s of pw.sheep){ if(Math.hypot(player.x-s.x,player.y-s.y)<TILE*7){ if(Math.random()<0.5) sfxBleat(); break; } } }
  tickHerding(dt);
}
// ── the herding quest: walk near a lost sheep (in a cleansed village) to make it
//    follow; lead the conga-line to the village pen to deliver. Getting hit scatters
//    the whole line (handled in the combat hook). ──
function tickHerding(dt){
  const pw=portalWorld; if(!pw||!pw.lost) return;
  const followers=pw.followers||(pw.followers=[]);
  // 1) start following: a hiding lost sheep, whose village is cleansed & square-clear,
  //    begins to follow when the player comes close.
  pw.lost.forEach(s=>{ if(s.state!=='hiding') return; const v=(pw.villages||[]).find(vv=>vv.id===s.village);
    if(!v||!v.cleared) return;   // only after the village is cleansed
    if(Math.hypot((player.x)-(s.x),(player.y)-(s.y))<TILE*1.3){ s.state='following'; s.followIdx=followers.length; followers.push(s); sfxBleat(); } });
  // 2) conga-line: each follower trails the one ahead (or the player for the first).
  const SPACING=TILE*0.9;
  followers.forEach((s,i)=>{ const lead = i===0? {x:player.x,y:player.y} : {x:followers[i-1].x,y:followers[i-1].y};
    const dx=lead.x-s.x, dy=lead.y-s.y, d=Math.hypot(dx,dy)||1;
    if(d>SPACING){ const sp=Math.min(1.8, (d-SPACING)*0.2); s.x+=(dx/d)*sp*(dt/16); s.y+=(dy/d)*sp*(dt/16);
      if(Math.abs(dx)>Math.abs(dy)) s.dir=dx<0?'left':'right'; }
    s.t=(s.t||0)+1; });
  // 3) deliver: if the player (front of the line) is on the village's pen gate, pen
  //    every follower from THAT village.
  const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
  const pen=(pw.pens||[]).find(p=> Math.abs(ptx-(p.x+p.w/2))<=p.w/2+0.5 && Math.abs(pty-(p.y+p.h/2))<=p.h/2+0.5);
  if(pen){ const st=mistVil(pen.vid); let delivered=0;
    for(let i=followers.length-1;i>=0;i--){ const s=followers[i]; if(s.village!==pen.vid) continue;
      s.state='penned'; s.x=(pen.x+0.5+Math.random()*(pen.w-1))*TILE; s.y=(pen.y+0.5+Math.random()*(pen.h-1))*TILE;
      followers.splice(i,1); delivered++; }
    if(delivered){ st.lostGathered=Math.min(st.lostTotal,(st.lostGathered||0)+delivered);
      followers.forEach((f,idx)=>f.followIdx=idx); sfxBleat(); saveGame();
      if(st.lostGathered>=st.lostTotal && !st.herdDone){ st.herdDone=true;
        const reward=60+st.lostTotal*15; gold+=reward;
        const v=(pw.villages||[]).find(vv=>vv.id===pen.vid); const nm=v?v.name:'the fold';
        showBanner('\ud83d\udc11 <b>All of '+nm+'\u2019s lost sheep are home!</b><br><span style="font-size:7px">The shepherd rewards you with '+reward+' gold. \u201cThere is joy over one sheep that was lost and is found.\u201d</span>', 3600); saveGame(); }
      else showBanner('\ud83d\udc11 Penned '+delivered+' \u2014 '+st.lostGathered+' of '+st.lostTotal+' home.', 1600); } }
}
// scatter the whole following line back into hiding (called when the player is hit). ──
function scatterFollowers(){ const pw=portalWorld; if(!pw||!pw.followers||!pw.followers.length) return;
  pw.followers.forEach(s=>{ s.state='hiding'; s.followIdx=-1;
    // bolt back to a hiding spot near their home village
    const v=(pw.villages||[]).find(vv=>vv.id===s.village); if(v){ const ang=Math.random()*6.28, rad=8+Math.random()*5;
      s.hx=Math.round(v.cx+Math.cos(ang)*rad); s.hy=Math.round(v.cy+Math.sin(ang)*rad); s.x=s.hx*TILE; s.y=s.hy*TILE; } });
  pw.followers=[]; showBanner('\ud83d\udc11 The frightened sheep scatter!', 1400); }
// enter a village chapel from the portal world; remember the door to return to. ──
// ── the teaching beat: when you enter a chapel whose square is clear, the freed
//    villagers gather and you speak a blessing — scripture and the truth it carries.
//    Completing it CLEANSES the village (v.cleared), which restores the shepherd,
//    the flock, and the chapel itself, and counts toward opening the castle. ──
const CHAPEL_BLESSINGS={
  fold:[ {speaker:'Freed villagers', text:"The hollow ones told us we were forgotten \u2014 left to the wolves."},
         {speaker:'You', text:"Hear the truth: 'What man of you, having a hundred sheep, if he lose one, doth not leave the ninety and nine, and go after that which is lost, until he find it?'"},
         {speaker:'You', text:"You were never forgotten. The Shepherd Himself came for you."},
         {speaker:'Freed villagers', text:"Then we are found. We are His still."} ],
  brook:[ {speaker:'Freed villagers', text:"They fouled our well and said no clean thing remained for us."},
          {speaker:'You', text:"'Whosoever drinketh of the water that I shall give him shall never thirst.'"},
          {speaker:'You', text:"The pretender poisons wells; the King gives living water. Drink, and be restored."},
          {speaker:'Freed villagers', text:"The water runs clear again \u2014 and so do we."} ],
  meadowe:[ {speaker:'Freed villagers', text:"A false lord wore a crown and demanded we bow. We almost did."},
            {speaker:'You', text:"'I am the door: by Me if any man enter in, he shall be saved.'"},
            {speaker:'You', text:"The pretender is a shadow wearing a crown. There is one true King \u2014 and He lays down His life for the sheep, not takes yours."},
            {speaker:'Freed villagers', text:"We bow now only to the true King."} ],
  millford:[ {speaker:'Freed villagers', text:"We doubted any rescue would come. Our faith was too small."},
             {speaker:'You', text:"'If ye have faith as a grain of mustard seed... nothing shall be impossible unto you.'"},
             {speaker:'You', text:"Small faith in a great God is enough. He does not despise the doubting heart that turns to Him."},
             {speaker:'Freed villagers', text:"Then our small faith will grow."} ],
  downs:[ {speaker:'Freed villagers', text:"The castle still stands. The pretender is not yet beaten."},
          {speaker:'You', text:"'Be strong and of a good courage; be not afraid, neither be thou dismayed: for the Lord thy God is with thee whithersoever thou goest.'"},
          {speaker:'You', text:"Five folds are freed. Now go \u2014 and He goes with you, to the very gate."},
          {speaker:'Freed villagers', text:"Go, knight. All Mistral prays you home."} ],
};
function beginTeaching(v){
  const lines=CHAPEL_BLESSINGS[v.id]||[{speaker:'Freed villagers', text:'You have freed us. Thank you, knight.'}];
  say(lines, ()=>cleanseVillage(v));
}
function cleanseVillage(v){
  const st=mistVil(v.id); if(st.cleared) return;
  st.cleared=true; v.cleared=true;
  codexSyncMistral(v.id);
  sfxLevelUp && sfxLevelUp();   // a triumphant chord for the restoration
  saveGame();
  const total=(portalWorld.villages||[]).filter(x=>mistVil(x.id).cleared).length;
  if(total>=5){
    if(portalWorld.castle) portalWorld.castle.unlocked=true;
    showBanner('\u2728 <b>All five folds are restored.</b><br><span style="font-size:7px">A great bell tolls across Mistral. Far to the north, the castle gate grinds open \u2014 the pretender can no longer hide. The way stands open.</span>', 5000);
  } else {
    showBanner('\u2728 <b>'+v.name+' is cleansed.</b><br><span style="font-size:7px">The chapel bell rings clean and true. '+total+' of 5 folds restored.</span>', 3200);
  }
}
// enter the castle throne room from the portal world. ──
function enterMistralThrone(){
  if(mistThrone.caged===undefined) mistThrone.caged=!mistThrone.purified;
  sfxDoor(true);
  const id=buildMistralThrone();
  portalWorld._throneReturn={ x:portalWorld.castle.gate.x*TILE, y:(portalWorld.castle.gate.y+1)*TILE };
  place={kind:'interior', id, floor:0};
  const f=INTERIORS[id].floors[0];
  player.x=7*TILE; player.y=(f.h-2)*TILE; player.dir='up'; player.mounted=false;
  mistThrone.fighting=false;
  showBanner('\ud83d\udc51 <b>The Usurped Hall</b><br><span style="font-size:7px">A cold wind guts the torches. Upon a stolen throne, a crowned shadow waits.</span>', 2600);
}
// ── the Pretender's temptation: a seductive rant, the knight's humble rebuke that
//    all authority is God's alone, then his enraged turn to violence. ──
function throneTemptation(){
  if(mistThrone.fighting || mistThrone.purified) return;
  mistThrone.sceneStarted=true;
  const lines=[
    {speaker:'The Pretender', text:"So. The little knight climbs all this way. Do you know what I see when I look at you? A king. Bend the knee to me, and I will make it so."},
    {speaker:'The Pretender', text:"I hold every road, every crown, every throne in this land \u2014 and I would give them all to you. Riches beyond the counting-houses of Stormgate. Armies to call you sovereign. The princess on your arm and a kingdom at your feet."},
    {speaker:'The Pretender', text:"No more wandering. No more bleeding for a master who left you to it. Look around \u2014 I took all of this. Where was your King when the villages burned? I am the power here now. Worship me, and it is yours."},
    {speaker:'You', text:"You offer me what was never yours to give. There is one God, and He alone gives and takes away \u2014 kingdoms, crowns, and breath itself. Blessed be the name of the Lord."},
    {speaker:'You', text:"Every road you claim, every throne you have stolen, is held under His hand alone. I will not bow to a shadow wearing a crown. You are no king \u2014 only a thief who forgot he is already judged."},
    {speaker:'The Pretender', text:"...Then die with your King's name on your lips!"},
  ];
  say(lines, ()=>startThroneFight());
}
// ── the defeat sequence. He does not simply vanish: he FALLS, gathers himself,
//    staggers back up the dais to where Madison is chained, seizes her, and only
//    then tears the air open. Driven by mistThrone.cine, ticked in tickThroneCine. ──
function throneFlee(){
  const b=mistThrone.boss; if(!b) return;
  mistThrone.fighting=false; demons=[];
  player.hp=player.maxHp;
  b.projectiles=[];
  // he keeps his body on the field for the cinematic
  mistThrone.fled=true;
  mistThrone.cine={ phase:'fall', t:0, x:b.x, y:b.y, tx:7*TILE, ty:2*TILE, alpha:1, portal:0,
    seized:false, mad:{ x:9*TILE, y:2*TILE } };
  sfxBossRoar && sfxBossRoar();
  say([
    {speaker:'The Pretender', text:"\u2014 agh! \u2026 No. No, not like this."},
  ], ()=>{ mistThrone.cine.phase='rise'; });
}
// advance the defeat cinematic one frame. ──
function tickThroneCine(dt){
  const c=mistThrone.cine; if(!c) return; c.t++;
  if(c.phase==='fall'){ /* he lies where he fell until the line is dismissed */ }
  else if(c.phase==='rise'){ if(c.t>24){ c.phase='stagger'; c.t=0; } }
  else if(c.phase==='stagger'){
    // limp back up the aisle to the throne, listing side to side
    const dx=c.tx-c.x, dy=c.ty-c.y, d=Math.hypot(dx,dy)||1;
    if(d>2){ c.x+=(dx/d)*0.9; c.y+=(dy/d)*0.9; }
    else { c.phase='seize'; c.t=0; c.seized=true;
      say([
        {speaker:'The Pretender', text:"His hand closes on the princess\u2019s chain. \u201cYou fight like a man who believes his King is watching. No matter \u2014 I will not die on this rock.\u201d"},
        {speaker:'Princess Madison', text:"Do not lose heart for my sake! The Lord will provide \u2014 He has never once failed us. Follow, and trust Him to go before you."},
        {speaker:'The Pretender', text:"\u201cTo another world, then! Chase me if your faith has legs, little knight.\u201d"},
        {speaker:'You', text:"Wherever you flee, He is already there. I will follow \u2014 to the ends of the earth if I must."},
      ], ()=>{ mistThrone.cine.phase='portal'; mistThrone.cine.t=0; });
    } }
  else if(c.phase==='portal'){ c.portal=Math.min(1,c.portal+0.02);
    // she is hauled along by the chain, into the portal with him
    if(c.mad){ const tx=7*TILE, ty=1*TILE; c.mad.x+=(tx-c.mad.x)*0.06; c.mad.y+=(ty-c.mad.y)*0.06; }
    if(c.portal>=1){ c.alpha-=0.04; if(c.alpha<=0){ c.phase='gone'; c.t=0; } } }
  else if(c.phase==='gone'){ if(c.t>30){ mistThrone.madisonTaken=true; mistThrone.cine=null; mistThrone.boss=null; throneLastStand(); } }
}
// ── THE LAST STAND: the usurper is gone, but his hollow men remain and will not
//    yield the hall. Five of them, stronger than any before. The castle cannot be
//    cleansed until the last one falls. ──
function throneLastStand(){
  mistThrone.lastStand=true;
  demons=[];
  for(let i=0;i<5;i++){ const sp=throneSpawnSpot();
    const hp=300;
    demons.push({ x:sp.x, y:sp.y, hp, maxHp:hp, level:13, xp:0, atk:64, alive:true, hurt:0, t:i*7,
      fallen:true, nightBuff:true, face:'down', wander:true, knock:0, _throneAdd:true, _lastStand:true }); }
  sfxBossRoar && sfxBossRoar();
  say([
    {speaker:'You', text:"He is fled \u2014 but his hollow men do not fall with him. They hold the hall yet."},
    {speaker:'You', text:"Then we finish it here. \u2018Fight the good fight of faith.\u2019 Not one of them leaves this floor."},
  ], ()=>{ showBanner('\u2694\ufe0f <b>The hollow men hold the hall!</b><br><span style="font-size:7px">Five remain, and they are the strongest he had. Cut them down and the castle is free.</span>', 3600); });
}
// watch the last stand: once every one of them is down, the hall is cleansed. ──
function tickThroneLastStand(){
  if(!mistThrone.lastStand) return;
  const left=demons.filter(d=>d._lastStand && d.alive).length;
  if(left===0){ mistThrone.lastStand=false; demons=[];
    mistThrone.freeable=true;   // the cage can now be opened
    say([
      {speaker:'A voice from the cage', text:"Sir knight \u2014 here! By the west wall. They penned me here when the usurper took the hall."},
    ], ()=>showBanner('\ud83d\udddd\ufe0f <b>A caged man calls to you.</b><br><span style="font-size:7px">Go to the cage by the west wall and set him free.</span>', 3600));
  }
}
// free the caged steward — this is what cleanses the hall. ──
function freeSteward(){
  if(!mistThrone.freeable || mistThrone.purified) return;
  mistThrone.freeable=false;
  sfxDoor && sfxDoor(false);
  // the door swings open and he climbs out on his own feet
  mistThrone.release={ phase:'open', t:0, x:2*TILE, y:6*TILE, tx:3*TILE, ty:7*TILE };
  say([
    {speaker:'The Steward', text:"The bar \u2014 you have it. Bless you, sir. Bless you."},
  ], ()=>{ if(mistThrone.release) mistThrone.release.phase='stepout'; });
}
// walk him out of the cage, then let him speak and the hall come back to light. ──
function tickStewardRelease(dt){
  const r=mistThrone.release; if(!r) return; r.t++;
  if(r.phase==='open'){ /* waiting on his first line */ }
  else if(r.phase==='stepout'){
    const dx=r.tx-r.x, dy=r.ty-r.y, d=Math.hypot(dx,dy)||1;
    if(d>1.5){ r.x+=(dx/d)*0.55; r.y+=(dy/d)*0.55; }
    else { r.phase='clear'; r.t=0; mistThrone.caged=false;   // cage now stands empty
      say([
        {speaker:'The Steward', text:"I kept the keys of this house before he came. I had thought to die with them on my belt."},
        {speaker:'The Steward', text:"Go on, then \u2014 open the shutters with me. Let the light back in."},
      ], ()=>{ mistThrone.release=null; throneAftermath(); });
    } }
}
function throneAftermath(){
  // purify the hall, plant the steward, grant rewards, open Tabor.
  mistThrone.purified=true; mistThrone.fighting=false; mistThrone.boss=null; mistThrone.cleared=true;
  mistThrone.steward=true;
  // add the steward NPC to the throne interior (by the empty throne)
  const I=INTERIORS['mistthrone']; if(I && !(I.npcs||[]).some(n=>n.steward)){
    I.npcs=I.npcs||[]; I.npcs.push({ x:3, y:7, floor:0, dir:'down', steward:true, name:'The Steward',
      look:'steward', lines:[
        'The usurper is fled, but this hall need not stay empty. I will keep it \u2014 swept and lit \u2014 against the day a true king comes.',
        '\u201cWell done, good and faithful servant.\u201d Go with God, knight. The way south lies open; Mount Tabor\u2019s gate glows on the far shore.'] });
  }
  // mark Mistral (world 1) cleared + open Tabor (world 2)
  const mp=portalById('mistral'); if(mp) mp.cleared=true;
  const tp=portalById('tabor'); if(tp) tp.unlocked=true;
  // grant the spectral mount skin (cosmetic, equip from the Pet menu)
  player.mountSkinOwned=player.mountSkinOwned||{}; player.mountSkinOwned.spectral=true;
  player.skillPoints=(player.skillPoints||0)+3;
  saveGame();
  setTimeout(()=>showBanner('\u2728 <b>Mistral is free.</b><br><span style="font-size:7px">The hall warms; a faithful steward takes up the watch. A spectral barding for your steed is yours \u2014 equip it from the Pet menu. And far to the south, <b>Mount Tabor\u2019s gate</b> tears open. The chase goes on.</span>', 7000), 2400);
  showBanner('\u2694\ufe0f <b style="color:#ffe04a">THE USURPER IS DRIVEN FROM MISTRAL!</b>', 3800);
}
// the Pretender in the throne hall lives outside demons[], so he needs the same
// explicit rules as Abaddon: a cooldown between landed blows, a burst cap, and
// reduced damage while he's braced mid-wind-up. ──
// pick an open floor tile in the hall for a summoned knight. Without this they
// spawn inside pillars and the throne and stick fast. ──
function throneSpawnSpot(){
  const g=INTERIORS['mistthrone'].floors[0].g, W=15, H=17;
  for(let tries=0; tries<200; tries++){
    const tx=1+Math.floor(Math.random()*(W-2)), ty=4+Math.floor(Math.random()*(H-6));
    const t=g[ty] && g[ty][tx];
    if(t!==12 && t!==23 && t!==21) continue;              // floor, carpet, dais only
    const x=tx*TILE, y=ty*TILE;
    if(Math.hypot(x-player.x, y-player.y) < TILE*2.5) continue;   // not on top of the knight
    return {x,y};
  }
  return {x:7*TILE, y:12*TILE};                            // safe fallback: open aisle
}
function throneHitGate(dmg){
  const b=mistThrone.boss; if(!b) return -1;
  // while his hollow men stand, the usurper cannot be touched — cut them down first
  if(demons.some(d=>d._throneAdd && d.alive)){ b.wardFlash=10; return -1; }
  const now=performance.now();
  if(b.lastHitAt && now-b.lastHitAt<BOSS_GATE) return -1;
  b.lastHitAt=now;
  dmg=Math.min(dmg, Math.ceil(b.maxHp*BOSS_CAP));
  if(b.state==='telegraph') dmg*=0.3;
  return Math.max(1,Math.round(dmg));
}
function startThroneFight(){
  mistThrone.fighting=true; mistThrone.purified=false;
  const maxHp=2600;
  mistThrone.boss={ x:7*TILE, y:2*TILE, anchorx:7*TILE, anchory:2*TILE, hp:maxHp, maxHp,
    state:'idle', timer:24, moveIdx:0, kind:null, move:null, telegraph:0, telMax:1,
    aimx:0, aimy:1, chx:0, chy:0, ring:0, ringR:0, projectiles:[], hurt:0, intro:26,
    wavesFired:{} };
  demons=[];   // his summoned knights live in demons[] and reuse the portal-world AI
  sfxBossRoar && sfxBossRoar();
  showBanner('\ud83d\udc51 <b style="color:#e0885a">THE PRETENDER KING</b><br><span style="font-size:7px">He is stronger than the folds you freed. Read his attacks \u2014 duck behind the pillars, and strike in the openings.</span>', 4200);
}
// the adapted boss moveset for the throne (volley/spread/charge/slam), tuned for
// the pillared hall. Escalates as HP drops. ──
const THRONE_MOVES=[
  {kind:'volley',count:5,telegraph:26,speed:3.2},
  {kind:'spread',count:12,telegraph:26,speed:2.9},
  {kind:'charge',telegraph:24,speed:7.5},
  {kind:'volley',count:6,telegraph:24,speed:3.4},
  {kind:'slam',telegraph:26,ringSpeed:4.8,ringMax:170},
  {kind:'spread',count:15,telegraph:24,speed:3.3},
];
// a pillar between two points blocks projectiles (line-of-sight cover). ──
function throneLOSblocked(x0,y0,x1,y1){ const g=INTERIORS['mistthrone'].floors[0].g;
  const steps=Math.ceil(Math.hypot(x1-x0,y1-y0)/6);
  for(let i=1;i<steps;i++){ const t=i/steps, tx=Math.floor((x0+(x1-x0)*t)/TILE), ty=Math.floor((y0+(y1-y0)*t)/TILE);
    if(g[ty]&&g[ty][tx]===20) return true; }   // 20 = pillar
  return false; }
function enterMistralChapel(v){
  sfxDoor(true);
  const id=buildMistralChapel(v.id);
  portalWorld._chapelReturn={ x:v.chapelDoor.x*TILE, y:(v.chapelDoor.y+1)*TILE, vid:v.id };
  place={kind:'interior', id, floor:0};
  const f=INTERIORS[id].floors[0];
  let sx=4, sy=f.h-2; for(let y=0;y<f.h;y++)for(let x=0;x<f.w;x++) if(f.g[y][x]===9){ sx=x; sy=y-1; }
  player.x=sx*TILE; player.y=sy*TILE; player.dir='up';
  const st=mistVil(v.id);
  if(st.squareClear && !st.cleared){
    // the square is safe and the village awaits restoration — the freed gather
    setTimeout(()=>beginTeaching(v), 700);
  } else if(st.cleared){
    showBanner('\u26ea <b>'+INTERIORS[id].name+'</b><br><span style="font-size:7px">Peace dwells here now.</span>', 1400);
  } else {
    showBanner('\u26ea <b>'+INTERIORS[id].name+'</b><br><span style="font-size:7px">Shadows still hold this fold. Clear the square outside first.</span>', 2400);
  }
}
function arrivePortalWorld(id, home){
  buildPortalWorld(id);
  portalWorld.ret=home;   // where 'return home' drops us on the overworld
  place={kind:'portalworld'};
  if(id==='mistral') spawnMistralKnights();
  if(id==='sunfall') spawnSunfallGloamings();

  player.x=portalWorld.entry.x*TILE; player.y=portalWorld.entry.y*TILE; player.dir='up';
  const nm=(portalById(id)&&portalById(id).name)||'the portal world';
  if(id==='tabor' && !taborProgress.thawed){
    showBanner('\u2744\ufe0f <b>MOUNT TABOR — hearts of stone and ice.</b><br><span style="font-size:7px">Five souls on this mountain can still be reached. Follow the walkway up, stair by stair — a gold \u2757 marks a soul who needs you. Read the signposts. Beware the beasts, and beware the night.</span>', 7000);
  } else if(id==='tabor'){
    showBanner('\ud83c\udf34 <b>MOUNT TABOR — alive.</b><br><span style="font-size:7px">Eden crowns the summit — the raft at its lip rides the falls all the way down. Hammocks and hot springs: face them and press \u24b6 to rest.</span>', 5200);
  } else {
    showBanner('\ud83c\udf00 <b>You step through '+nm+'.</b><br><span style="font-size:7px">A strange sky wheels overhead. (The return gate lies to the north.)</span>', 2600);
  }
}
// ── populate Mistral with fallen-knights. Guardians ring each village whose
//    square isn't yet cleared; wanderers roam the open fields. Both stored in the
//    shared demons[] array so hit-detection and death reuse the demon system.
//    They do NOT respawn — we spawn only the survivors recorded in mistralProgress. ──
// record a fallen-knight death so it never respawns; flag a village's square clear
// once all 5 guardians are down (the teaching beat in 6d-3 does the real cleanse). ──
function onFallenKnightKilled(d){
  if(d.wander){ mistralProgress.wanderersDown=Math.min(10,(mistralProgress.wanderersDown||0)+1); return; }
  if(d.village){ const st=mistVil(d.village); st.guardsDown=Math.min(5,(st.guardsDown||0)+1);
    if(st.guardsDown>=5 && !st.squareClear){ st.squareClear=true;
      const v=(portalWorld.villages||[]).find(vv=>vv.id===d.village); const nm=v?v.name:'the village';
      showBanner('\u2694\ufe0f <b>The square is clear.</b><br><span style="font-size:7px">The fallen guardians of '+nm+' are undone. Enter the chapel to restore it.</span>', 3200); }
  }
}
function spawnMistralKnights(){
  demons=[]; const pw=portalWorld, g=pw.g, night=isNight();
  const mk=(tx,ty,opts)=>{ const lvl=opts.level||6; const beef=(night?1.6:1.0)*(opts.wander?1.15:1.0);
    const hp=Math.round((16+lvl*3)*beef);
    demons.push({ x:tx*TILE, y:ty*TILE, hp, maxHp:hp, level:lvl, xp:8+lvl*3,
      atk:Math.round((7+lvl)* (night?1.35:1)), alive:true, hurt:0, t:Math.random()*60,
      fallen:true, nightBuff:night, face:'down', village:opts.village||null, wander:!!opts.wander,
      knock:0 }); };
  // guardians: 5 around each village whose square isn't cleared
  (pw.villages||[]).forEach(v=>{ const st=mistVil(v.id); if(st.squareClear) return;
    const survivors=5-(st.guardsDown||0); if(survivors<=0){ st.squareClear=true; return; }
    let placed=0, tries=0;
    // scan outward rings around the chapel front until all survivors are placed
    while(placed<survivors && tries<200){ tries++;
      const ang=Math.random()*6.283, rad=2+Math.random()*4;
      const tx=Math.round(v.cx+Math.cos(ang)*rad), ty=Math.round(v.cy+2+Math.sin(ang)*rad);
      const t=(g[ty]&&g[ty][tx]);
      if((t===0||t===2||t===4||t===6) && Math.hypot(tx-v.cx,ty-(v.cy+2))>1.5){ mk(tx,ty,{village:v.id, level:6}); placed++; }
    }
  });
  // wanderers: up to 10 survivors roaming open ground, away from the entry
  const wLeft=Math.max(0, 10-(mistralProgress.wanderersDown||0));
  let made=0, tries=0;
  while(made<wLeft && tries<400){ tries++;
    const tx=5+Math.floor(Math.random()*(pw.w-10)), ty=5+Math.floor(Math.random()*(pw.h-10));
    const t=(g[ty]&&g[ty][tx]);
    if((t===0||t===2||t===4) && Math.hypot(tx-pw.entry.x,ty-pw.entry.y)>10){ mk(tx,ty,{wander:true, level:7}); made++; }
  }
}
// ── WHERE AM I? — a small standing plate at the top of the screen naming the tier
//    of the spiral underfoot, its lamp, and whether that lamp is lit. On a long
//    walk inward it is the one thing that says how far you have come. ──
function sunfallTierLabel(){
  const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
  const n=_octN(ptx-portalWorld.cx, pty-portalWorld.cy);
  if(n<=portalWorld.vesper.r) return { txt:'VESPER — the false capital', lit:null, tier:0 };
  const R=(portalWorld.rings||[]).find(q=>n>=q.r0&&n<=q.r1);
  if(!R){
    const cw=portalWorld.causeway;
    if(cw && n>portalWorld.vesper.r && n<cw.from) return { txt:'THE LONG CAUSEWAY', lit:null, tier:0 };
    const t=portalWorld.g[pty] && portalWorld.g[pty][ptx];
    if(t===82) return { txt:'ABOARD A SKY-FERRY', lit:null, tier:0 };
    return { txt:'THE CROSSING', lit:null, tier:0 };
  }
  const L=(portalWorld.lampSites||[]).find(s=>s.ring===R.ring);
  const D=L?SUNLAMPS[L.id]:null;
  const st=L?sunLamp(L.id):null;
  return { txt:'TIER '+R.ring+(D?' — '+D.tower:''), lit:st?st.lit:null, tier:R.ring };
}
function drawSunfallTier(){
  const info=sunfallTierLabel();
  const lit=sunfallLitCount();
  ctx.font='7px monospace'; ctx.textAlign='center';
  const label=info.txt, wpx=Math.max(96, ctx.measureText(label).width+20);
  const x0=Math.round(VW/2-wpx/2), y0=3;
  ctx.fillStyle='rgba(28,16,30,0.72)'; ctx.fillRect(x0,y0,wpx,17);
  ctx.fillStyle='rgba(240,160,80,0.55)'; ctx.fillRect(x0,y0,wpx,1); ctx.fillRect(x0,y0+16,wpx,1);
  ctx.fillStyle = info.lit===true ? '#ffd79a' : '#e8c8a0';
  ctx.fillText(label, VW/2, y0+8);
  // five pips: one per lamp, filled as each is kindled, the current tier ringed
  const pw=7, tot=5*pw, px0=Math.round(VW/2-tot/2);
  for(let i=0;i<5;i++){
    const on=sunLamp('lamp'+(i+1)).lit, cur=(info.tier===i+1);
    const bx=px0+i*pw;
    ctx.fillStyle = on ? '#f0a050' : 'rgba(230,210,220,0.30)';
    ctx.fillRect(bx+1,y0+11,4,3);
    if(cur){ ctx.fillStyle='#fff'; ctx.fillRect(bx,y0+10,6,1); }
  }
  ctx.textAlign='left';
  if(lit>=5 && info.tier===0){ /* the causeway stands open */ }
}
// ── SKY FERRIES: the crossings between isles are not bridges but platforms that
//    drift back and forth across the gulf. Step aboard while one is docked and it
//    carries you over; miss it and you wait. The platform writes itself into the
//    live grid as walkable deck (82) and lifts back out to open sky (81) behind
//    it, so ordinary tile collision does all the work. ──
const FERRY_SPD=0.010, FERRY_DWELL=1500;      // units of gulf per frame · ms docked
function _ferryPos(F){
  const a=F.deg*Math.PI/180, ux=Math.cos(a), uy=Math.sin(a);
  const n=F.nA+(F.nB-F.nA)*F.p, s=n/_octN(ux,uy);
  return { x:portalWorld.cx+ux*s, y:portalWorld.cy+uy*s };
}
function _ferryLift(F){        // take the deck back out of the grid
  const g=portalWorld.g;
  F.cells.forEach(([x,y])=>{ if(g[y]&&g[y][x]===82) g[y][x]=81; });
  F.cells=[];
}
function _ferrySet(F,cx,cy){   // lay the deck down at a tile position
  const g=portalWorld.g; F.cells=[];
  for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){
    const x=cx+dx, y=cy+dy;
    if(!g[y]||g[y][x]===undefined) continue;
    if(g[y][x]===81){ g[y][x]=82; F.cells.push([x,y]); }
  }
}
function tickSunfallFerries(dt){
  if(portalWorld.id!=='sunfall' || !portalWorld.ferries) return;
  const ptile=()=>[Math.floor((player.x+TILE/2)/TILE), Math.floor((player.y+TILE/2)/TILE)];
  //  ★ riding means STANDING ON THE DECK — not merely near it. The old test used a
  //    box around the raft's centre, which also covered the landing beside it, so
  //    waiting on solid ground got you dragged out over the drop and stranded.
  const onDeck=(F)=>{ const [ptx,pty]=ptile();
    return F.cells.some(([cx,cy])=>cx===ptx&&cy===pty); };
  portalWorld.ferries.forEach(F=>{
    // ★ the last crossing is gated on the watch: until all five lamps burn, the
    //   raft stays moored at VESPER'S side of the lagoon — visible, out of reach.
    if(F.id==='ferryCauseway' && sunfallLitCount()<5){
      if(F.p<1){ F.p=1; F.dir=-1; F.dwell=0;
        const pos=_ferryPos(F); _ferryLift(F); _ferrySet(F, Math.round(pos.x), Math.round(pos.y)); }
      const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
      const a=F.deg*Math.PI/180, ux=Math.cos(a), uy=Math.sin(a);
      const s=(F.nA)/_octN(ux,uy);
      const lx=Math.round(portalWorld.cx+ux*s), ly=Math.round(portalWorld.cy+uy*s);
      if(Math.abs(ptx-lx)<=2 && Math.abs(pty-ly)<=2 && !F._hintT){ F._hintT=1;
        showBanner('\u26f4\ufe0f <b>The raft waits at the far shore — and will not come.</b><br><span style="font-size:7px">'+sunfallLitCount()+' of 5 lamps burn. The last crossing answers only to a kept watch.</span>', 3600); }
      if(!(Math.abs(ptx-lx)<=2 && Math.abs(pty-ly)<=2)) F._hintT=0;
      return;
    }
    const before=_ferryPos(F);
    const btx=Math.round(before.x), bty=Math.round(before.y);
    const riding = place.kind==='portalworld' && onDeck(F);
    if(F.dwell>0){ F.dwell-=dt; }
    else {
      F.p+=F.dir*FERRY_SPD*(dt/16);
      if(F.p>=1){ F.p=1; F.dir=-1; F.dwell=FERRY_DWELL; }
      else if(F.p<=0){ F.p=0; F.dir=1; F.dwell=FERRY_DWELL; }
    }
    const after=_ferryPos(F);
    const atx=Math.round(after.x), aty=Math.round(after.y);
    if(atx!==btx || aty!==bty || !F.cells.length){
      _ferryLift(F); _ferrySet(F,atx,aty);
      if(riding){                                  // carried across with the deck
        const [ptx,pty]=ptile();
        const nx=ptx+(atx-btx), ny=pty+(aty-bty);
        const nt=portalWorld.g[ny] && portalWorld.g[ny][nx];
        if(nt!==undefined && WALK.has(nt)){ player.x+=(atx-btx)*TILE; player.y+=(aty-bty)*TILE; }
        // if the deck slid somewhere the knight cannot stand, leave him put and
        // let the rescue below sort it out rather than posting him into the sky
      }
    }
  });
  sunfallRescueFromVoid();
}
// ── shoving rubble: walk into a block and it slides one tile. If there is nothing
//    but sky behind it, it goes over and is gone. Blocked by walls, other blocks,
//    towers, and by the raft decks (you cannot load rubble onto a ferry). ──
let _shoveT=0;
function sunfallShove(sx,sy){
  if(place.kind!=='portalworld' || portalWorld.id!=='sunfall') return false;
  if(!portalWorld.debrisFields || !portalWorld.debrisFields.length) return false;
  const now=performance.now(); if(now-_shoveT<220) return false;
  const g=portalWorld.g;
  const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
  const bx=ptx+sx, by=pty+sy;
  if(!g[by] || g[by][bx]!==87) return false;
  const tx=bx+sx, ty=by+sy;
  const dest=g[ty] && g[ty][tx];
  if(dest===undefined) return false;
  const intoSky = (dest===81);
  if(!intoSky && !(WALK.has(dest) && dest!==82 && dest!==9 && dest!==35 && dest!==86 && dest!==85 && dest!==83)) return false;
  _shoveT=now;
  g[by][bx]=6;                                  // the road under the block
  const F=portalWorld.debrisFields.find(f=>f.blocks.some(b=>b[0]===bx&&b[1]===by));
  if(F){
    F.blocks=F.blocks.filter(b=>!(b[0]===bx&&b[1]===by));
    if(!intoSky){ g[ty][tx]=87; F.blocks.push([tx,ty]); }
    sunfallProgress.debris[F.id]=F.blocks.map(b=>[b[0],b[1]]);
    saveGame();
  } else if(!intoSky){ g[ty][tx]=87; }
  if(intoSky){ sfxDoor(false);
    showBanner('\ud83e\udea8 <b>The block goes over the edge.</b><br><span style="font-size:7px">You never hear it land.</span>', 1600); }
  return true;
}
// ★ last line of defence: if anything ever leaves the knight standing on open sky,
//   put him back on the nearest solid ground instead of letting him be stuck.
function sunfallRescueFromVoid(){
  if(place.kind!=='portalworld' || portalWorld.id!=='sunfall') return;
  const g=portalWorld.g;
  const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
  const here=g[pty] && g[pty][ptx];
  if(here===undefined || WALK.has(here)) return;
  let best=null, bd=1e9;
  for(let r=1;r<=6 && !best;r++){
    for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++){
      if(Math.max(Math.abs(dx),Math.abs(dy))!==r) continue;
      const x=ptx+dx, y=pty+dy, t=g[y]&&g[y][x];
      if(t===undefined || !WALK.has(t)) continue;
      const d=dx*dx+dy*dy; if(d<bd){ bd=d; best=[x,y]; }
    }
    if(best) break;
  }
  if(best){ player.x=best[0]*TILE; player.y=best[1]*TILE;
    showBanner('\u26a0\ufe0f <b>You scramble back onto solid stone.</b><br><span style="font-size:7px">The raft went out from under you.</span>', 1600); }
}
// ── SUNFALL GLOAMINGS: shadow-forms bred under a sun that never sets — they are
//    ALWAYS in their strengthened night shape. They roam the ring circuits,
//    respawn like Tabor's pack, and abandon any ring whose lamps are all lit. ──
function sunRingOf(tx,ty){
  // read the live geometry — never hardcode radii, the atoll has been resized once already
  const cx=(portalWorld.cx===undefined?112:portalWorld.cx), cy=(portalWorld.cy===undefined?112:portalWorld.cy);
  // measure with the SAME norm the builder used, or the rings sit where nothing is
  const r=(portalWorld.shape==='octagon') ? _octN(tx-cx,ty-cy) : Math.hypot(tx-cx,ty-cy);
  const R=(portalWorld.rings||[]).find(q=>r>=q.r0&&r<=q.r1);
  return R?R.ring:0; }
// _legacy: const r=Math.hypot(tx-60,ty-60);
//   if(r>=49&&r<=57) return 1; if(r>=34&&r<=43) return 2; if(r>=19&&r<=28) return 3; return 0;
function sunRingAtPeace(ring){
  const sites=(portalWorld.lampSites||[]).filter(L=>L.ring===ring);
  return sites.length>0 && sites.every(L=>sunLamp(L.id).lit);
}
function _mkGloaming(tx,ty){
  const lvl=9, hp=Math.round((16+lvl*3)*1.7);
  demons.push({ x:tx*TILE, y:ty*TILE, hp, maxHp:hp, level:lvl, xp:8+lvl*3,
    atk:Math.round((8+lvl)*1.35), alive:true, hurt:0, t:Math.random()*60,
    gloaming:true, nightBuff:true, face:'down', knock:0 });
}
function _gloamingSpotOK(tx,ty){
  const g=portalWorld.g; const t=(g[ty]&&g[ty][tx]);
  if(!(t===6||t===25||t===27)) return false;                          // circuit, ash, cracked earth
  const ring=sunRingOf(tx,ty); if(!ring||sunRingAtPeace(ring)) return false;
  if(Math.hypot(tx-portalWorld.entry.x,ty-portalWorld.entry.y)<10) return false;   // never at the gate
  return true;
}
function spawnSunfallGloamings(){
  demons=[]; if(portalWorld.id!=='sunfall') return;
  let made=0, tries=0;
  while(made<14 && tries<600){ tries++;
    const tx=3+Math.floor(Math.random()*(portalWorld.w-6)), ty=3+Math.floor(Math.random()*(portalWorld.h-6));
    if(_gloamingSpotOK(tx,ty)){ _mkGloaming(tx,ty); made++; }
  }
}
let _gloamT=0;
function tickSunfallGloamings(dt){
  if(portalWorld.id!=='sunfall') return;
  _gloamT+=dt; if(_gloamT<6000) return; _gloamT=0;   // one replacement every ~6s
  const alive=demons.filter(d=>d.alive&&d.gloaming).length;
  if(alive>=14) return;
  for(let tries=0;tries<80;tries++){
    const tx=3+Math.floor(Math.random()*(portalWorld.w-6)), ty=3+Math.floor(Math.random()*(portalWorld.h-6));
    if(!_gloamingSpotOK(tx,ty)) continue;
    if(Math.hypot(tx-(player.x/TILE),ty-(player.y/TILE))<14) continue;   // never inside your sightline
    _mkGloaming(tx,ty); return;
  }
}
function leavePortalWorld(){
  const home=portalWorld.ret||{x:40*TILE,y:271*TILE};
  beginPortalWarp({ kind:'exit', home:home });
}
function arriveOverworldFromPortal(home){
  portalWorld.active=false; portalWorld.g=null;
  place={kind:'overworld'}; demons=[]; spawnDemons();
  player.x=home.x; player.y=home.y; player.dir='down';
  if(_homecomingPending){ _homecomingPending=false; startWedding(); return; }
  showBanner('\ud83c\udf00 <b>You return through the gate.</b>', 1600);
}

function checkTransitions(){
  if(player.driving) return false;   // 🛒 the wagon never enters buildings, caves, or the deep wood
  const t=tileAt(...pkey().split(',').map(Number));
  // ── inside a portal world: stepping onto the return gate (35) warps home ──
  if(place.kind==='portalworld'){
    if(t===35){
      if(portalWorld.id==='sunfall' && bounties.madisonRescued && !sunfallProgress.homecoming){
        startHomecoming(); return true;
      }
      leavePortalWorld(); return true; }
    if(t===9){ const [dtx,dty]=pkey().split(',').map(Number);
      const LH=(portalWorld.lampSites||[]).find(s=>s.door && s.door.x===dtx && s.door.y===dty);
      if(LH){ enterSunfallLighthouse(LH); return true; }
      const VT=portalWorld.vesperTown;
      if(VT){
        if(VT.cath.door.x===dtx && VT.cath.door.y===dty){ enterVesperCathedral(); return true; }
        const VH=VT.houses.find(h=>h.door.x===dtx && h.door.y===dty);
        if(VH){ enterVesperHouse(VH); return true; }
      }
      const v=(portalWorld.villages||[]).find(vv=>vv.chapelDoor && vv.chapelDoor.x===dtx && vv.chapelDoor.y===dty);
      if(v){ enterMistralChapel(v); return true; }
      // the castle gate (north): enter the throne room if the castle is unlocked
      const cg=portalWorld.castle&&portalWorld.castle.gate;
      if(cg && dtx===cg.x && dty===cg.y){
        if(portalWorld.castle.unlocked){ enterMistralThrone(); return true; }
        else { showBanner('\ud83d\udd12 The great gate is barred. Cleanse all five folds first.', 2200); return true; } } }
    return false; }
  if(place.kind==='overworld'){
    if(t===9){ const b=buildings.find(b=>b.door && (b.door.x+','+b.door.y)===pkey()); if(b){ enterDoor(b); return true; } }
    // ── an ancient portal at a summit: step onto it to be carried into its world ──
    if(bounties.portalsOpen){ const [ptx,pty]=pkey().split(',').map(Number);
      const pr=portalAt(ptx,pty);
      if(pr){ if(pr.unlocked){ enterPortalWorld(pr); } else { showBanner('\ud83d\udd12 <b>The way is sealed.</b><br><span style="font-size:7px">This gate will not open until the world beyond the first portal is set free.</span>', 2200); }
        return true; } }
    if(t===35){ const px=Math.floor((player.x+TILE/2)/TILE), py=Math.floor((player.y+TILE/2)/TILE);
        if(px===196 && py===7){ enterMonkCave(); }
        else if(px===33 && py===84){ enterDisillusionment('north'); }   // Forest of Disillusionment — north mouth
        else if(px===33 && py===185){ enterDisillusionment('south'); }  // Forest of Disillusionment — south mouth
        else { enterForest(); } return true; }
  } else if(place.kind==='dungeon'){
    // once the player moves off the entrance tile, clear the just-entered guard
    if(dungeon._justEntered && t!==8) dungeon._justEntered=false;
    // HIDDEN SAGE HOLLOW inside the Forest of Disillusionment → Eldan's Glade
    if(t===35 && dungeon.disillusion && !dungeon.inGlade){ enterSageGlade(); return true; }
    if(t===2){ // stairs up — town/cave dungeons require clearing demons first; the forest does NOT
      if(!dungeon.disillusion && !dungeonAllClear()){ if(!dungeon._warned){ showBanner('⚠️ Clear all demons first!', 1200); dungeon._warned=true; setTimeout(()=>dungeon._warned=false,1400); } return false; }
      if(dungeon.floorIdx+1 < dungeon.floors.length){ dungeon.opened=dungeon.opened||{}; dungeon.opened[dungeon.floorIdx]=true; loadDungeonFloor(dungeon.floorIdx+1); const ft=dungeon.floors[dungeon.floorIdx]; const top=ft===2;
        // _legacy: showBanner(top?`⬆ The general's sanctum…`, 3000) — the warning
        //   that teaches the whole boss fight, gone in three seconds.
        if(top){ say([`<b>⬆ The general's sanctum.</b>`,
          `⚠️ <b>${TOWN_DATA[dungeon.townId].boss}</b> guards it. Read its telegraphed attacks and dodge with Ⓑ — it cannot turn once it has committed.`]); }
        else if(ft===3){ say([`🌿 Light through the canopy... you have found <b style="color:#8fd4a8">Eldan's Glade</b>.`]); }
        else showBanner(`⬆ Floor ${dungeon.floorIdx+1}/${dungeon.floors.length}`, 1200);
        return true; }
      // FINAL floor reached. In the Forest of Disillusionment, the last stairs lead
      // OUT the FAR side of the wood (north→south, or south→north).
      if(dungeon.disillusion){ exitDisillusionment(dungeon.entryMouth==='south' ? 'north' : 'south'); return true; }
    }
    return false;
  } else {
    if(t===9){
      // the old man is quick about it, but he does finish
      if(place.id==='tobias' && !tutorial.done){
        sayAs('Tobias', ['Not yet. Come here and let me finish — it won\'t take long, and it may keep you alive.']);
        return true;
      }
      exitInterior(); return true; }
    if(t===10){ changeFloor(place.floor+1); return true; }
    if(t===11){ changeFloor(place.floor-1); return true; }
  }
  return false;
}
function doAction(quiet){
  // Tabor: dig, gather, and speak with the people of the mountain
  if(place.kind==='portalworld' && portalWorld.id==='tabor' && taborAction()) return;
  if(credits){ if(creditsDone()){ credits=null;
      showBanner('\ud83d\udc51 <b style="color:#f0c860">THE KINGDOM IS WHOLE.</b> ⭐ +5 skill points<br><span style="font-size:7px">Three worlds at peace · Madison home · the watch kept. The gates stand open — the story keeps.</span>', 5200); }
    return; }
  // ✦ the knight's own top floor: the library and the wardrobe glass
  if(place.kind==='interior' && place.id==='home_house' && place.floor===2){
    const htx=Math.floor((player.x+TILE/2)/TILE), hty=Math.floor((player.y+TILE/2)/TILE);
    if(Math.abs(htx-HS_LECTERN.x)<=1 && Math.abs(hty-HS_LECTERN.y)<=1){
      say(codexPages(), null); return;
    }
    if(Math.abs(htx-HS_WARDROBE.x)<=1 && Math.abs(hty-HS_WARDROBE.y)<=1){
      const all=liveryList(), have=all.filter(liveryUnlocked);
      const cur=currentLivery(), i=have.indexOf(cur);
      const next=have[(i+1)%have.length];
      player.livery=next; saveGame();
      const L=LIVERIES[next];
      const locked=all.filter(id=>!liveryUnlocked(id));
      const more=locked.length
        ? '<br><span style="font-size:7px;color:#c8b898">Still to earn: '+locked.map(id=>LIVERIES[id].name+' ('+LIVERIES[id].note+')').join(' · ')+'</span>'
        : '<br><span style="font-size:7px;color:#ffe9a8">Every livery earned.</span>';
      showBanner('\ud83e\udde5 <b style="color:#ffe9a8">'+L.name+'</b><br><span style="font-size:7px">'+L.note+' · '+have.length+' of '+all.length+' liveries · \ud83c\udf3e '+trade.sold+' goods traded</span>'+more, 3800);
      return;
    }
  }
  // Sunfall: speak with a pilgrim on the ledge
  if(place.kind==='portalworld' && portalWorld.id==='sunfall'){
    const qtx=Math.floor((player.x+TILE/2)/TILE), qty=Math.floor((player.y+TILE/2)/TILE);
    for(const P of (portalWorld.pilgrims||[])){
      if(Math.abs(qtx-P.x)>1 || Math.abs(qty-P.y)>1) continue;
      const D=SUNPILGRIMS.find(q=>q.id===P.id); if(!D) break;
      const first=!sunfallProgress.metPilgrims[P.id];
      const lines=D.lines.map(t=>({speaker:D.name, text:t}));
      if(first) lines.push({speaker:D.name, text:'\u201c'+D.verse.text+'\u201d \u2014 '+D.verse.ref});
      say(lines, ()=>{
        if(first){ sunfallProgress.metPilgrims[P.id]=true;
          codexAdd(D.name+', Sunfall', D.verse.ref, D.verse.text);
          player.hp=Math.min(player.maxHp, player.hp+Math.round(player.maxHp*0.25));
          saveGame();
          showBanner('\ud83e\udd1d <b>'+D.name+'</b> shares what little she has.<br><span style="font-size:7px">❤ Some strength returns · \ud83d\udcbe Game saved</span>', 2400);
        }
      });
      return;
    }
  }
  // Sunfall: take a skiff on the updraft
  if(place.kind==='portalworld' && portalWorld.id==='sunfall' && !skiff){
    const mtx=Math.floor((player.x+TILE/2)/TILE), mty=Math.floor((player.y+TILE/2)/TILE);
    for(const M of (portalWorld.moorings||[])){
      if(Math.abs(mtx-M.x)>1 || Math.abs(mty-M.y)>1) continue;
      const deepest=sunDeepestTier();
      const dest = (M.ring===1) ? deepest : 1;
      if(dest===M.ring){
        showBanner('\ud83e\ude81 <b>A skiff, tethered and ready.</b><br><span style="font-size:7px">Nowhere yet to fly — press on inward, and it will carry you back.</span>', 2600);
        return;
      }
      skiff={ t0:performance.now(), toTier:dest, fired:false };
      showBanner('\ud83e\ude81 <b>You cast off, and the updraft takes you.</b><br><span style="font-size:7px">'+(dest===1?'Out along the spiral, back to the mouth.':'Inward, to Tier '+dest+' — as far as you have come.')+'</span>', 1800);
      return;
    }
  }
  // Sunfall: rest at a watchman's brazier
  if(place.kind==='portalworld' && portalWorld.id==='sunfall'){
    const wtx=Math.floor((player.x+TILE/2)/TILE), wty=Math.floor((player.y+TILE/2)/TILE);
    for(const Wp of (portalWorld.ways||[])){
      if(Math.abs(wtx-Wp.x)>1 || Math.abs(wty-Wp.y)>1) continue;
      const D=SUNWAYS[Wp.id]; if(!D) break;
      const first=!sunfallProgress.waystations[Wp.id];
      const hurt=player.hp<player.maxHp;
      if(first){
        sunfallProgress.waystations[Wp.id]=true;
        codexAdd(D.name+', Sunfall', D.verse.ref, D.verse.text);
        player.hp=player.maxHp; saveGame();
        say([
          {speaker:'You', text:'(a watchman\u2019s brazier, still burning after all this time. Someone kept it against the dark.)'},
          {speaker:D.name, text:'\u201c'+D.verse.text+'\u201d \u2014 '+D.verse.ref},
        ], ()=>{ showBanner('\ud83d\udd25 <b>'+D.name+'</b> — ❤ fully restored · \ud83d\udcbe saved', 2600); });
      } else if(hurt){
        player.hp=player.maxHp; saveGame();
        showBanner('\ud83d\udd25 <b>'+D.name+'</b><br><span style="font-size:7px">You warm your hands a while. ❤ Fully restored · \ud83d\udcbe Game saved</span>', 2400);
      } else {
        showBanner('\ud83d\udd25 <b>'+D.name+'</b><br><span style="font-size:7px">\u201c'+D.verse.ref+'\u201d — the fire holds steady against the wind.</span>', 2200);
      }
      return;
    }
  }
  // Sunfall: haul timber, and mend a fallen span — the repairer of the breach
  if(place.kind==='portalworld' && portalWorld.id==='sunfall'){
    const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
    for(const S of (portalWorld.spans||[])){
      if(Math.abs(ptx-S.cache.x)<=1 && Math.abs(pty-S.cache.y)<=1
         && portalWorld.g[S.cache.y][S.cache.x]===83){
        portalWorld.g[S.cache.y][S.cache.x]=6;
        sunfallProgress.caches[S.id]=true;
        sunfallProgress.timber=(sunfallProgress.timber|0)+1;
        saveGame();
        showBanner('\ud83e\udeb5 <b>You shoulder a bundle of planks.</b><br><span style="font-size:7px">Someone left these for a mending they never lived to make. Carry them to the break in the ledge.</span>', 3000);
        return;
      }
    }
    for(const S of (portalWorld.spans||[])){
      if(sunfallProgress.spans[S.id]) continue;
      const near=S.cells.some(([cx,cy])=>Math.abs(ptx-cx)<=1&&Math.abs(pty-cy)<=1);
      if(!near) continue;
      if((sunfallProgress.timber|0)<=0){
        showBanner('\u26a0\ufe0f <b>The ledge is gone here.</b><br><span style="font-size:7px">Nothing but sky, and a long way down. There was timber stacked back along the path.</span>', 2600);
        return;
      }
      const D=SUNSPANS[S.id];
      say([
        {speaker:'You', text:'(you set the bundle down at the brink, and look across the gap at the ledge on the far side)'},
        {speaker:'You', text:'(plank by plank, you lay the span \u2014 hammering, testing your weight, hammering again)'},
        {speaker:'You', text:'\u201c'+D.verse.text+'\u201d \u2014 '+D.verse.ref},
      ], ()=>{
        S.cells.forEach(([cx,cy])=>{ if(portalWorld.g[cy][cx]===81) portalWorld.g[cy][cx]=84; });
        codexAdd('A mended breach, Sunfall', D.verse.ref, D.verse.text);
        sunfallProgress.spans[S.id]=true;
        sunfallProgress.timber=Math.max(0,(sunfallProgress.timber|0)-1);
        player.skillPoints=(player.skillPoints||0)+1;
        saveGame();
        showBanner('\ud83d\udd28 <b style="color:#f0a050">THE BREACH IS REPAIRED.</b> ⭐ +1 skill point<br><span style="font-size:7px">The planks hold. The road goes on.</span>', 3600);
      });
      return;
    }
  }
  // Sunfall: kindle a lighthouse lamp — the restoration beat
  if(place.kind==='interior' && _isSunLampId(place.id) && place.floor===2){
    const lampId=String(place.id).slice(8); const st=sunLamp(lampId);
    const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
    if(Math.abs(ptx-4)<=1 && pty<=3 && st.captainDown && !st.lit){
      const D=SUNLAMPS[lampId];
      say([
        {speaker:'You', text:'(you kneel at the cold lamp, strike the King\u2019s flint, and shelter the first small flame with both hands)'},
        {speaker:'You', text:'\u201c'+D.verse.text+'\u201d \u2014 '+D.verse.ref},
        {speaker:'You', text:'Keep this watch, little flame. The night is not the end of the story.'},
      ], ()=>{
        st.lit=true; player.skillPoints=(player.skillPoints||0)+1;
        codexAdd(D.tower+', Sunfall', D.verse.ref, D.verse.text); saveGame();
        const n=sunfallLitCount();
        showBanner('\ud83d\udd25 <b style="color:#f0a050">'+D.tower+' BURNS AGAIN.</b> ⭐ +1 skill point<br><span style="font-size:7px">'+(n>=5?'Five flames keep the watch. Far inward, the last causeway to VESPER lies open before you.':n+' of 5 lamps kindled. Its ring falls quiet — the gloamings flee a kept light.')+'</span>', n>=5?6000:4200);
      });
      return;
    }
  }
  // free the caged steward when standing beside his cage in the throne hall
  if(place.kind==='interior' && place.id==='mistthrone' && mistThrone.freeable){
    const cx=2, cy=6;   // the cage tile, west wall
    const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
    if(Math.abs(ptx-cx)<=1 && Math.abs(pty-cy)<=1){ freeSteward(); return; }
  }
  if(tourneyMenu.open){ tourneyMenuSelect(); return true; }
  if(decorPlace.active){ decorConfirm(); return true; }
  // 👑 the walkable throne hall: near the dais, address the King; at the foot, leave
  if(place.kind==='keep'){
    const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
    // a tournament champion?
    if(hunt.done){ const k=keepKnightNear();
      if(k){ sayAs(k.name, k.line, ()=>openTourneyMenu(k.keep)); return true; } }
    if(Math.abs(ptx-PMADISON.tx)<=1 && Math.abs(pty-PMADISON.ty)<=1){
      if(bounties.madisonTaken && !bounties.madisonRescued){
        sayAs('The King of Luminar', [
          "Her place... empty. My Madison, gone through one of those cursed doors. Every hour she is beyond my reach is an hour I cannot breathe.",
          "You are the only blade I trust to cross into those worlds, knight. Follow the pretender. Bring my daughter home." ]);
        return true; }
      sayAs('Princess Madison', [
        "Father says the realm is safe again. Yet at night I dream of doors that are not doors...",
        "So YOU are the knight the heralds sing of? The songs left out how muddy your boots are.",
        "Should the shadows ever reach for me, knight — I will be counting on you." ]);
      return true; }
    if(pty<=9 && ptx>=THALL.cx-2 && ptx<=THALL.cx+2){ kingSpeak(); return true; }
    return false;
  }
  // ── 🛒 WAGON load menu open: A on the highlighted row loads/hitches ──
  if(wagonMenu.open){ wagonMenuSelect(); return true; }
  // ── 🛒 while DRIVING: A next to a town drop-off delivers ──
  if(player.driving){ if(tryDeliver()) return true; return true; }   // driving A is never an attack
  // ── talk to a shepherd in the portal world (A while facing one) ──
  if(place.kind==='portalworld' && portalWorld.shepherds){
    const [sfx,sfy]=facingTile();
    const sh=portalWorld.shepherds.find(s=> Math.floor((s.x+TILE/2)/TILE)===sfx && Math.floor((s.y+TILE/2)/TILE)===sfy)
         || portalWorld.shepherds.find(s=> Math.hypot((s.x+TILE/2)-(player.x+TILE/2),(s.y+TILE/2)-(player.y+TILE/2)) < TILE*1.4);
    if(sh){ const v=(portalWorld.villages||[]).find(vv=>vv.id===sh.village);
      const cleared=v&&v.cleared; const L=sh.lines||{before:['...'],after:['...']};
      if(cleared){ const st=mistVil(sh.village); const remain=Math.max(0,st.lostTotal-(st.lostGathered||0));
        const lines=L.after.slice();
        if(st.herdDone) lines.push('Every last lamb is back in the fold. Bless you, knight.');
        else if(remain>0) lines.push('But '+remain+' of my sheep are still lost out in the fields \u2014 '+st.lostTotal+' strayed when the shadows came. Bring them to the pen by the chapel, if you can. Mind the wanderers; a fright will scatter them.');
        sayAs('Shepherd', lines);
      } else sayAs('Shepherd', L.before);
      return true; } }
  // Returns true when the press performed a real interaction; false otherwise
  // (so the A button can fall through to an attack when there's nothing to do).
  // ── SHOP MENU open: A/ENTER buys the highlighted item ──
  // ── 🌱 SEED PICKER open: Ⓐ commits the highlighted seed ──
  if(seedMode){ plantSelected(); return true; }
  if(shopMode){
    const key=shopMode.items[shopMode.idx]; const it=shopItem(key);
    if(PET_GEAR[key]){
      player.petGear=player.petGear||{};
      if(player.petGear[key]){ showShop(`You already own the ${it.name}.`); }
      else if(gold>=it.price){ gold-=it.price; player.petGear[key]=true; showShop(`Bought ${it.emoji} ${it.name}! Equip it from the 🐾 Pet tab.`); }
      else showShop(`Not enough gold for ${it.name}.`);
      return true;
    }
    if(it.lamp){
      if(player.hasLamp){ showShop(`You already carry the ${it.name}.`); }
      else if(gold>=it.price){ gold-=it.price; player.hasLamp=true; saveGame(); showShop(`Bought ${it.emoji} ${it.name}! Its light will pierce the fog of the deep wood.`); }
      else showShop(`Not enough gold for ${it.name}.`);
      return true;
    }
    if(it.gear){
      if(player.ownedGear[it.gear]){ showShop(`You already own ${it.name}.`); }
      else if(gold>=it.price){ gold-=it.price; player.ownedGear[it.gear]=true; showShop(`Bought ${it.emoji} ${it.name}! Equip it in the ☰ menu.`); }
      else showShop(`Not enough gold for ${it.name}.`);
    }
    else if(gold>=it.price){ gold-=it.price; inventory[key]=(inventory[key]||0)+1; showShop(`Bought ${it.emoji} ${it.name}!`); }
    else showShop(`Not enough gold for ${it.name}.`);
    return true;
  }
  if(banner.style.display==='block' && bannerT>400){ bannerT=200; }   // tap to dismiss
  if(checkTransitions()) return true;
  const [fx,fy]=facingTile();
  // ── SURF SPOT: the deeper swell at Saltmere (tile 21) ──
  if(place.kind==='overworld'){
    const hereT=WORLD[Math.floor((player.y+TILE/2)/TILE)]?.[Math.floor((player.x+TILE/2)/TILE)];
    const faceT=WORLD[fy]&&WORLD[fy][fx];
    if(hereT===21 || faceT===21){ startSurf(); return true; }
    if((fx+','+fy)===TOURNEY_SPOT){ openPetTourney(); return true; }
    if((fx+','+fy)===STYLIST_SPOT){ openStylist(); return true; }
    if(RACE_SPOTS.indexOf(fx+','+fy)>=0){ openRace(); return true; }
    // ⛵ SALTMERE BOATS: board a moored boat to set sail; press Ⓐ by land to dock
    if(player.boating){
      // 🏁 THE REGATTA: sail up to the regatta marker buoy and press Ⓐ to enter the races
      const here_rx=Math.floor((player.x+TILE/2)/TILE), here_ry=Math.floor((player.y+TILE/2)/TILE);
      const atRegatta = decorations.find(d=>d.kind==='regatta' &&
        ((fx===d.x&&fy===d.y) || (here_rx===d.x&&here_ry===d.y)));
      if(atRegatta){ openBoatRaceGate(); return true; }
      // dock if the faced tile is walkable land (not a sail/water tile)
      const lt=WORLD[fy]&&WORLD[fy][fx];
      if(lt!==undefined && WALK.has(lt) && !SAIL_TILES.has(lt)){
        // moor THE boat on the water tile we're departing from (only one ever exists)
        const wx=Math.floor((player.x+TILE/2)/TILE), wy=Math.floor((player.y+TILE/2)/TILE);
        if(SAIL_TILES.has(WORLD[wy]&&WORLD[wy][wx])){
          // remove any stray boats, then place the single moored boat here
          for(let i=decorations.length-1;i>=0;i--){ if(decorations[i].kind==='boat') decorations.splice(i,1); }
          decorations.push({ x:wx, y:wy, kind:'boat', w:1 });
        }
        player.boating=false; player.x=fx*TILE; player.y=fy*TILE; player.dir=player.dir||'down';
        updateMountBtn&&updateMountBtn();
        showBanner('⚓ You step ashore. Your boat waits at the dock.', 1500); return true;
      }
      showBanner('⛵ Face the shore and press Ⓐ to dock.', 1400); return true;
    } else {
      const boatDec = decorations.find(d=>d.kind==='boat' && (fx===d.x||fx===d.x+(d.w||1)-1) && (fy===d.y||fy===d.y+(d.w||1)-1));
      if(boatDec){
        player.boating=true; player.mounted=false;
        // hop onto the boat's water tile, and remove the moored boat (we're sailing it now)
        player.x=boatDec.x*TILE; player.y=boatDec.y*TILE;
        const i=decorations.indexOf(boatDec); if(i>=0) decorations.splice(i,1);
        updateMountBtn&&updateMountBtn();
        showBanner('⛵ You set sail! Steer onto the water — press Ⓐ by land to dock.', 2400); return true;
      }
    }
  }
  // ── DUNGEON interactions: chests, the general, and leaving ──
  if(place.kind==='dungeon'){
    const dt = (fy>=0&&fy<DH&&fx>=0&&fx<DW) ? dungeon.grid[fy][fx] : 1;
    const here = dungeon.grid[Math.floor((player.y+TILE/2)/TILE)]?.[Math.floor((player.x+TILE/2)/TILE)];
    // the facing tile is fx,fy in this scope — dtx/dty are demon fields and are
    // not defined here, which threw a ReferenceError on every tap
    if(dt===T_FALSEWALL){ setVerse(); return true; }
    if(dt===T_VERSE){ takeVerse(fx,fy); return true; }
    if(dt===T_LECTERN){ readBook(libraryBookAt(fx,fy)); return true; }
    if(dt===T_CHAIR){ restInChair(); return true; }
    if(dt===T_HEARTH){ showBanner('🔥 The fire is kept up. Someone still comes here.', 1400); return true; }
    if(dt===T_CANDLE||dt===T_CANDLE_LIT){ lightCandle(fx,fy); return true; }
    if(dt===T_TABLET){ readTablet(); return true; }
    if(dt===5){ // chest in front
      const k=dungeon.floorIdx+':'+fx+','+fy;
      if(dungeon.chests[k]){ showBanner('📭 Empty — already looted.', 900); }
      else { dungeon.chests[k]=true; sfxCoin(); const reward=dungeonChestReward(); showBanner(reward, 2200); }
      return true;
    }
    if(dt===7){ // the trapped general (top floor)
      if(!dungeon.bossDead){ sayAs(TOWN_DATA[dungeon.townId].general,
        [`The demon <b>${TOWN_DATA[dungeon.townId].boss}</b> binds me — strike it down first!`]); }
      else freeGeneral();
      return true;
    }
    if(dt===9){ if(dungeon.monkCave){ monkTalk(); } else { sageTalk(); } return true; }
    if(here===8){
      // Tile 8 is the way you came IN — which on floor 0 is the door, and on any
      // floor above it is the stair down to the floor below.
      // _legacy: leaveChapel() on every floor, with no reference to floorIdx.
      //   Every maze floor carries an entrance tile, so Ⓐ on tile 8 two floors
      //   down walked you out of the building instead of back one floor.
      const _deep = dungeon.floorIdx>0 && !dungeon.inGlade;
      if(dungeon._justEntered){ dungeon._justEntered=false;
        showBanner(dungeon.inGlade?'🚪 The way back into the wood. Press Ⓐ here again to leave.'
                 : _deep?'🚪 The way back down a floor. Press Ⓐ here again to descend.'
                 :'🚪 The way back outside. Press Ⓐ here again to leave.', 1500); return true; }
      if(dungeon.inGlade){ leaveSageGlade(); return true; }   // glade → back into the maze
      if(_deep){ sfxDoor(false); loadDungeonFloor(dungeon.floorIdx-1, true);
        showBanner('⬇ You climb back down to floor '+(dungeon.floorIdx+1)+'.', 1100); return true; }
      leaveChapel(); return true;
    }   // stand on entrance + press A to leave (first press after entry just warns)
    if(!quiet) showBanner(dungeon.floors[dungeon.floorIdx]===FLOOR.sanctum
      ? '⛪ No way back — the guardian holds this floor. Defeat it to free the general.'
      : '⛪ Explore, fight demons 👹, climb the stairs ⬆. (Stand on ⬇ + A to go back a floor.)', 1600);
    return false;
  }
  // talk to a facing interior NPC — a solid counter (46) between you and them
  // does not block conversation: look one tile past the counter, GBA-style.
  let npc=activeNpcs().find(n=>n.x===fx&&n.y===fy);
  if(!npc && place.kind==='interior' && tileAt(fx,fy)===46){
    const d={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]}[player.dir];
    npc=activeNpcs().find(n=>n.x===fx+d[0]&&n.y===fy+d[1]);
  }
  if(npc){
    // hooded strangers offer bounties (checked before the inn branch — they live in inns)
    if(npc.stranger){ strangerTalk(npc.town); return true; }
    // shopkeepers (NPCs inside a 'shop'-themed building) open a buy menu
    if(place.kind==='interior' && INTERIORS[place.id].theme==='shop'){ openShop(); return true; }
    // innkeepers put you up for the night: fade to black, full heal + auto-save
    if(place.kind==='interior' && INTERIORS[place.id].theme==='inn' && npc.name==='Innkeeper'){
      openInnChoice(npc.name); return true;
    }
    /* _legacy (revert): instant heal —
      if(player.hp<player.maxHp){ player.hp=player.maxHp; showBanner(`Rest well, traveler.`, 2200); }
      else showBanner(`You're already hale and hearty.`, 2200); */
    if(npc.aldric){
      if(hunt.done){
        sayAs('Sir Aldric','You have cleansed the roads, my son. The keeps sound their trumpets \u2014 go, and let the realm see its champion.');
      } else if(!hunt.active){
        hunt.active=true;
        sayAs('Sir Aldric',['The fall of Abaddon broke the chains that held me.',`But his stragglers still haunt the wilds \u2014 <b>${huntLeft()} demons</b> remain. Hunt them all, and the keeps will honor you with tournaments.`]);
      } else {
        sayAs('Sir Aldric',`${huntLeft()} demons still roam. Steel and faith, my son.`);
      }
      return true;
    }
    // the old man at the hearth teaches, then simply welcomes you
    if(npc.name==='Tobias' && place.id==='tobias'){ tobiasTalk(); return true; }
    if(npc.librarian){ openLibrary(npc.town, null); return true; }
    if(npc.cycle){ npc._li=((npc._li===undefined?-1:npc._li)+1)%npc.lines.length;
      sayAs(npc.name, npc.lines[npc._li]); return true; }
    if(npc.king){
      if(homesteadGranted || hunt.won){
        sayAs('The King of Luminar', ['Champion of Luminar \u2014 the realm still sings your name.','May the Lord who steadied your hand keep you on the roads ahead.']);
      } else if(cleansedCount()>=10){
        sayAs('The King of Luminar', ['Abaddon festers at Hellgate, yet you have cleansed every chapel of the realm.','Go, knight \u2014 end the long night, and come back to me crowned in victory.']);
      } else {
        sayAs('The King of Luminar', npc.lines);
      }
      return true;
    }
    sayAs(npc.name, npc.lines); return true;
  }
  // talk to a facing overworld villager
  if(place.kind==='overworld'){
    const v=villagers.find(v=>Math.floor((v.x+TILE/2)/TILE)===fx && Math.floor((v.y+TILE/2)/TILE)===fy);
    if(v && v.marshal){ startTourney(v.marshal.keep, v.marshal.mode); return true; }
    if(v){ v.wait=120; v.dir=({up:'down',down:'up',left:'right',right:'left'})[player.dir]; // turn to face you, pause
      sayAs(v.vname||'Villager', v.lines); return true; }
  }
  // sign?
  // the summit sign is hidden once its portal is present (post-pretender)
  const sKey=(place.kind==='portalworld' ? portalWorld.id+':' : '')+fx+','+fy;
  const s=signs[sKey]; if(s && !(bounties.portalsOpen && portalAt(fx,fy))){ say(s.replace(/\n/g,'<br>')); return true; }
  // ── SELLING: face the farm stand to sell all your goods for gold ──
  if(place.kind==='overworld' && SELL_SPOT && (fx+','+fy)===SELL_SPOT){
    let earned=0, sold=0, lines=[];
    for(const item in GOODS){ if(item==='goldenFish'||item==='sacredScroll') continue; const n=inventory[item]||0; if(n>0){ const g=GOODS[item]; const sub=n*g.value; earned+=sub; sold+=n; lines.push(`${g.emoji}${n} ${g.name} → ${sub}g`); inventory[item]=0; } }
    if(earned>0){ earned=Math.round(earned*player.goldMult); gold+=earned;
      const wasSold=trade.sold; trade.sold+=sold; trade.gold+=earned;
      //  crossing a threshold unlocks a livery — announced at the stand that paid for it
      for(const id of liveryList()){ const L=LIVERIES[id];
        if(L.flag||!L.req) continue;
        if(wasSold<L.req && trade.sold>=L.req){
          setTimeout(()=>showBanner('\ud83e\uddf5 <b style="color:#ffe9a8">NEW LIVERY: '+L.name+'</b><br><span style="font-size:7px">'+trade.sold+' goods traded. Change your colours at the wardrobe upstairs in the Family Farmhouse.</span>', 4200), 3200);
        } }
      showBanner(`<b style="color:#fff">Sold ${sold} goods for ${earned}g!</b><br><span style="font-size:7px">${lines.join('<br>')}</span><br><span style="font-size:7px;color:#ffe04a">You now have ${gold} gold.</span>`, 3000); }
    else showBanner(`<b>Farm Stand</b><br><span style="font-size:7px">Nothing to sell yet — grow wheat or catch fish first!<br>You have ${gold} gold.</span>`, 2200);
    return true;
  }
  // ── FISHING: face a fishable water tile, press ENTER to cast; press again on the bite ──
  if(place.kind==='overworld'){
    const key=fx+','+fy;
    if(fishing){   // a cast is in progress — this press is the "reel in" attempt
      if(fishing.phase==='bite'){
        // Eldan's trial: while the quest is active, a chance to hook the Golden Fish
        if(quests.goldenFish==='active' && inventory.goldenFish<1 && Math.random()<0.28){
          inventory.goldenFish++; sfxCatch(); fishing=null; saveGame();
          showBanner(`🪙 <b style="color:#ffe04a">A Golden Fish!</b> It gleams in the light — surely the one Eldan spoke of. Bring it to the Sage's Wood!`, 2600);
        } else {
          const table=FISH_ZONES[fishing.zone]||FISH_ZONES.pond;
          let total=table.reduce((s,e)=>s+e[1],0), roll=Math.random()*total, pick=table[0][0];
          for(const [item,w] of table){ if(roll<w){ pick=item; break; } roll-=w; }
          inventory[pick]++; const g=GOODS[pick];
          sfxCatch(); showBanner(`${g.emoji} You caught a ${g.name}! (worth ${g.value}g)`, 1700); fishing=null;
        }
      } else if(fishing.phase==='wait'){ sfxFishAway(); showBanner('🎣 ...too early! The fish slipped away.', 1200); fishing=null; }
      return true;
    }
    // start a new cast: an explicit spot uses its tuned zone; otherwise ANY water
    // tile you face is fishable, with the zone chosen by tile type + region.
    const zone = FISH_SPOTS[key] || fishZoneAt(fx,fy);
    if(zone){
      fishing={ phase:'wait', t:0, biteAt:60+Math.floor(Math.random()*180), fx, fy, zone };
      sfxCast();
      showBanner('🎣 You cast your line... wait for a bite!', 1400);
      return true;
    }
  }
  // ── 🛒 WAGON: face the parked wagon at the bay to load cargo / hitch up ──
  if(place.kind==='overworld' && wagonAtBay(fx,fy)){ openWagonMenu(); return true; }
  // ── HOMESTEAD DECOR: press A facing a placed piece to pick it back up ──
  if(place.kind==='overworld' && inHomestead(fx,fy)){
    const p=pickUpDecorAt(fx,fy);
    if(p){ showBanner('🏡 '+DECOR_ITEMS[p.id].emoji+' '+DECOR_ITEMS[p.id].name+' stowed. (in your Home tab)',1600); return true; }
  }
  // ── FARMING: plant on tilled soil / harvest a ripe crop ──
  if(place.kind==='overworld'){
    const key=fx+','+fy;
    if(WORLD[fy] && WORLD[fy][fx]===31){            // facing a tilled plot
      const c=crops[key];
      if(!c){
        // _legacy (v92): planted wheat unconditionally, and the else branch
        // planted anyway and merely nagged, so seeds were effectively infinite:
        //   if(inventory.wheatSeed>0){ inventory.wheatSeed--; crops[key]={stage:0, plantedAt:performance.now()}; showBanner(`🌱 Planted wheat. (${inventory.wheatSeed} seeds left)`, 1100); }
        //   else { crops[key]={stage:0, plantedAt:performance.now()}; showBanner('🌱 Planted wheat. (Buy seeds at a shop to keep planting!)', 1500); }
        return openSeedPicker(fx,fy);
      }
      // _legacy: delete crops[key]; inventory.wheat++; — wheat only, always 1
      if(c.stage>=3){ const C=cropOf(c); delete crops[key];
        inventory[C.produce]=(inventory[C.produce]||0)+C.yield;
        showBanner(`${GOODS[C.produce].emoji} <b>Harvested ${C.name} ×${C.yield}!</b> (you have ${inventory[C.produce]})`, 1600); return true; }
      { const C=cropOf(c); showBanner(`${C.emoji} ${C.name}, still growing...`, 900); } return true;
    }
  }
  if(!quiet && place.kind==='overworld') showBanner('Walk into a 🚪 door to enter.', 900);
  return false;
}
function doAttack(){
  if(decorPlace.active){ decorConfirm(); return; }
  // while shopping, the A button cycles to the next item
  if(shopMode){ shopMode.idx=(shopMode.idx+1)%shopMode.items.length; showShop(); return; }
  if(player.swing>0 || player.dashing>0) return;
  // advance the combo counter (resets if the window lapsed)
  if(player.comboT<=0) player.combo=0;
  player.combo++; player.comboT=48;   // ~0.8s window to chain the next hit
  if(player.combo>=3){ player.combo=0; doSpecial(); return; }   // 3rd hit = signature special
  const type = player.weaponType==='heavy' ? 'heavy' : 'light';   // auto from equipped weapon
  const w = SWING[type];
  player.swing = w.windup + w.dur; player.swingDir = player.dir; player.swingType = type; player.swingHit=false;
  sfxSwing(type);
  // a bow looses an arrow instead of sweeping the melee cone — ranged INSTEAD of
  // melee, not as well, or it would simply dominate every blade in the game
  if(bowEquipped()) setTimeout(()=>fireArrow(), w.windup*16);
  else setTimeout(()=>resolveSwing(type), w.windup*16);
}
// ── SWING LINE-OF-SIGHT: a blade cannot pass through dungeon walls. Samples the
//    segment from knight to target every ~6px; any wall tile (1) blocks the hit.
//    (Only dungeons have a wall grid; overworld swings are unchanged.)
function swingLOS(ax,ay,bx,by){
  if(place.kind!=='dungeon') return true;
  const dist=Math.hypot(bx-ax,by-ay), steps=Math.max(1,Math.ceil(dist/6));
  for(let i=1;i<steps;i++){ const t=i/steps;
    const tx=Math.floor((ax+(bx-ax)*t)/TILE), ty=Math.floor((ay+(by-ay)*t)/TILE);
    if(dungeon.grid[ty] && dungeon.grid[ty][tx]===1) return false;
  }
  return true;
}
let _swingHit=false,_swingCrit=false,_swingClang=false;
// ══════════════════════════════════════════════════════════════════════
//  ARROWS — the Prophetic Bow strikes from range.
//  Mirrors the boss-shot pattern (step, tile test, radius test) but owned by
//  the player and aimed at demons. Kills route through applyDemonHit so a bow
//  kill awards the same xp, gold, bounty and hunt credit as a blade.
// ══════════════════════════════════════════════════════════════════════
let playerShots = [];
const ARROW_SPEED = 3.2, ARROW_LIFE = 26;   // ~5.2 tiles; a melee reach is 2.4
// Every combat system in this file branches on the same set of place kinds, and
// forgetting one has caused the same bug repeatedly. One predicate, used by all.
function arrowsAllowedHere(){
  return place.kind==="overworld" || place.kind==="dungeon" || place.kind==="abaddon"
      || place.kind==="portalworld"
      || (place.kind==="interior" && place.id==="mistthrone" && (mistThrone.fighting||mistThrone.lastStand))
      || sunTowerCombat();
}
function bowEquipped(){
  const a = WEAPON_ART[player.equip && player.equip.weapon];
  return !!a && a.fam === 'bow';
}
function fireArrow(){
  if(!arrowsAllowedHere()) return;
  const fv = player.dir==='up'?[0,-1] : player.dir==='down'?[0,1] : player.dir==='left'?[-1,0] : [1,0];
  playerShots.push({ x:player.x+TILE/2, y:player.y+TILE/2,
                     vx:fv[0]*ARROW_SPEED, vy:fv[1]*ARROW_SPEED,
                     t:ARROW_LIFE, dir:player.dir });
}
function tickArrows(){
  if(!playerShots.length) return;
  if(!arrowsAllowedHere()){ playerShots.length=0; return; }   // never survive a place change
  playerShots = playerShots.filter(s=>{
    s.x+=s.vx; s.y+=s.vy; s.t--;
    if(s.t<=0) return false;                                   // spent its range
    if(!walkable(Math.floor(s.x/TILE), Math.floor(s.y/TILE))) return false;  // struck a wall
    for(const d of demons){
      if(!d.alive) continue;
      const vx=(d.x+TILE/2)-s.x, vy=(d.y+TILE/2)-s.y, dist=Math.hypot(vx,vy);
      if(dist>9) continue;
      let dmg = Math.max(1, Math.round(player.atk) + (Math.random()*5|0) - 2);
      const isCrit = Math.random() < player.crit;
      if(isCrit) dmg = Math.round(dmg*1.8);
      dmg = bossHitGate(d, dmg);
      if(dmg<0){ d.hurt=3; sfxBlock(); return false; }          // turned aside
      applyDemonHit(d, dmg, isCrit, vx, vy, dist, 4);
      sfxHit(isCrit); player.comboT=48;
      return false;                                            // an arrow strikes once
    }
    return true;
  });
}
// The stones that have been rolled aside. They SETTLE and stay — a great stone
// rolled away stays rolled away — and are drawn beneath the knight, so walking
// past one reads as passing in front of it.
// camX/camY are let-scoped inside draw() and are passed in, never read as globals.
function drawRolledStones(camX,camY){
  if(place.kind!=='dungeon' || !dungeon.rolled) return;
  const list=dungeon.rolled[dungeon.floorIdx]; if(!list||!list.length) return;
  const now=Date.now();
  for(const r of list){
    const prog=Math.max(0,Math.min(1,(now-r.t0)/900));
    const ease=1-Math.pow(1-prog,2.2);                 // shoved hard, then settles
    const trav=ease*r.dist*TILE;
    // TRUE rolling: a disc of radius R turns trav/R radians over trav pixels.
    // Anything else is a disc spinning in place while it slides.
    const ang=trav/SEAL_R;
    const bx=Math.round(r.x*TILE + r.dx*trav - camX), by=Math.round(r.y*TILE + r.dy*trav - camY);
    if(bx<-TILE||by<-TILE||bx>VW+TILE||by>VH+TILE) continue;
    const cx=7.5, cy=7.5;
    for(let yy=0;yy<TILE;yy++)for(let xx=0;xx<TILE;xx++){
      const dx=xx-cx, dy=yy-cy, d=Math.sqrt(dx*dx+dy*dy);
      if(d>SEAL_R) continue;
      let col=SEAL_STONE;
      if(d>SEAL_R-1.1) col=SEAL_RIM;
      else if(dx+dy<-3.4) col=SEAL_LIT;
      else if(dx+dy>3.0) col=SEAL_DARK;
      px(bx+xx,by+yy,1,1,col);
    }
    const mark=(a,r0,r1,col)=>{ const steps=Math.ceil((r1-r0)*2);
      for(let i=0;i<=steps;i++){ const rr=r0+(r1-r0)*(i/steps);
        const mx=Math.round(cx+Math.cos(a)*rr), my=Math.round(cy+Math.sin(a)*rr);
        if(mx<0||my<0||mx>=TILE||my>=TILE) continue; px(bx+mx,by+my,1,1,col); } };
    mark(ang,-5.2,5.2,hexMix(SEAL_STONE,SEAL_DARK,.55));
    mark(ang+2.09,-4.4,4.4,hexMix(SEAL_STONE,SEAL_DARK,.40));
    mark(ang+4.19,1.5,4.6,hexMix(SEAL_STONE,SEAL_LIT,.5));
    const wx=Math.round(cx+Math.cos(ang+1.0)*4.2), wy=Math.round(cy+Math.sin(ang+1.0)*4.2);
    px(bx+wx-1,by+wy-1,2,2,SEAL_WAX_DARK); px(bx+wx-1,by+wy-1,2,1,SEAL_WAX);
  }
}
function drawArrows(camX,camY){                 // camX/camY are local to draw() — passed in
  if(!playerShots.length) return;
  for(const s of playerShots){
    const sx=Math.round(s.x-camX), sy=Math.round(s.y-camY);
    const horiz = (s.dir==='left'||s.dir==='right');
    ctx.fillStyle='#6a4a24';
    if(horiz) ctx.fillRect(sx-4,sy,7,1); else ctx.fillRect(sx,sy-4,1,7);
    ctx.fillStyle='#e8e8f0';                                   // head
    if(s.dir==='left') ctx.fillRect(sx-5,sy-0.5,2,2);
    else if(s.dir==='right') ctx.fillRect(sx+3,sy-0.5,2,2);
    else if(s.dir==='up') ctx.fillRect(sx-0.5,sy-5,2,2);
    else ctx.fillRect(sx-0.5,sy+3,2,2);
    ctx.fillStyle='#d8b070';                                   // fletching
    if(horiz) ctx.fillRect(s.dir==='left'?sx+2:sx-3,sy-1,2,3);
    else ctx.fillRect(sx-1,s.dir==='up'?sy+2:sy-3,3,2);
  }
}
// ── One place where a demon takes damage and dies. Melee and arrows both route
//    through here so a bow kill awards the same xp, gold, bounty and hunt credit.
function applyDemonHit(d, dmg, isCrit, vx, vy, dist, knock){
  d.hp -= dmg; d.hurt=8;
  d.pop={ dmg, crit:isCrit, t:26 };
  const m=dist||1; d.kdx=vx/m*knock; d.kdy=vy/m*knock; d.knock=8;
  if(d.hp<=0){ d.alive=false; d.dying=18; sfxDemonDie(); gainXp(d.xp||5);
    const g=Math.max(1,Math.round((2+d.level)*player.goldMult)); gold+=g;
    if(d.fallen){ onFallenKnightKilled(d); }
    else if(d.beast){ if(d._rescueGuard) onTaborGuardKilled(d); }
    else if(d.dungeon) onDungeonDemonKilled(d);
    else onHuntKill(d); }
}
function resolveSwing(type){
  _swingHit=false; _swingCrit=false; _swingClang=false;
  if(place.kind!=="overworld" && place.kind!=="dungeon" && place.kind!=="abaddon" && place.kind!=="portalworld" && !(place.kind==="interior" && place.id==="mistthrone" && (mistThrone.fighting||mistThrone.lastStand)) && !sunTowerCombat()) return;
  const w = SWING[type];
  const fv = player.dir==='up'?[0,-1] : player.dir==='down'?[0,1] : player.dir==='left'?[-1,0] : [1,0];
  const reach = TILE*w.reach + TILE*0.9;
  const cosCut = Math.cos(w.half);
  const kcx=player.x+TILE/2, kcy=player.y+TILE/2;
  let anyHit=false;
  demons.forEach(d=>{ if(!d.alive)return;
    const dcx=d.x+TILE/2, dcy=d.y+TILE/2;
    let vx=dcx-kcx, vy=dcy-kcy; const dist=Math.hypot(vx,vy);
    if(dist>reach) return;
    if(dist>0.001){ const dot=(vx*fv[0]+vy*fv[1])/dist; if(dot<cosCut) return; }
    if(!swingLOS(kcx,kcy,dcx,dcy)) return;                     // a wall is in the way
    let dmg = Math.max(1, Math.round(player.atk * w.mult) + (Math.random()*5|0) - 2);
    const isCrit = Math.random() < player.crit;
    if(isCrit) dmg = Math.round(dmg*1.8);
    dmg = bossHitGate(d, dmg);
    if(dmg<0){ d.hurt=3; anyHit=true; _swingClang=true; return; }   // turned aside — no damage
    anyHit=true; _swingHit=true; if(isCrit)_swingCrit=true;
    applyDemonHit(d, dmg, isCrit, vx, vy, dist, w.knock);
  });
  // also strike boss-summoned adds
  if(place.kind==='dungeon' && dungeon.adds.length){ dungeon.adds.forEach(a=>{ if(!a.alive)return;
    const acx=a.x+TILE/2, acy=a.y+TILE/2; let vx=acx-kcx, vy=acy-kcy; const dist=Math.hypot(vx,vy);
    if(dist>reach) return; if(dist>0.001){ const dot=(vx*fv[0]+vy*fv[1])/dist; if(dot<cosCut) return; }
    if(!swingLOS(kcx,kcy,acx,acy)) return;
    let dmg=Math.max(1,Math.round(player.atk*w.mult)); a.hp-=dmg; a.hurt=8; anyHit=true; a.pop={dmg,crit:false,t:24};
    if(a.hp<=0){ a.alive=false; } }); }
  // ABADDON + his shades
  if(place.kind==='abaddon' && abaddon.active){
    const bcx=abaddon.x+TILE/2, bcy=abaddon.y+TILE/2; let vx=bcx-kcx, vy=bcy-kcy; const dist=Math.hypot(vx,vy);
    if(dist<=reach && (dist<0.001 || (vx*fv[0]+vy*fv[1])/dist>=cosCut)){
      if(abaddon.shield){ abaddon.hurt=4; showBanner('🛡️ Shielded! Destroy the shades first!', 900); }
      else { let dmg=Math.max(1,Math.round(player.atk*w.mult)+(Math.random()*5|0)); const crit=Math.random()<player.crit; if(crit)dmg=Math.round(dmg*1.8);
        dmg=abaddonHitGate(dmg);
        if(dmg<0){ abaddon.hurt=3; }                              // turned aside
        else { abaddon.hp=Math.max(0,abaddon.hp-dmg); abaddon.hurt=8; anyHit=true; abaddon.pop={dmg,crit,t:26};
          if(abaddon.hp<=0) winAbaddon(); } }
    }
    abaddon.adds.forEach(a=>{ if(!a.alive)return; const acx=a.x+TILE/2,acy=a.y+TILE/2; let ax=acx-kcx, ay=acy-kcy; const ad=Math.hypot(ax,ay);
      if(ad>reach) return; if(ad>0.001){ const dot=(ax*fv[0]+ay*fv[1])/ad; if(dot<cosCut) return; }
      let dmg=Math.max(1,Math.round(player.atk*w.mult)); a.hp-=dmg; a.hurt=8; anyHit=true; a.pop={dmg,crit:false,t:24};
      if(a.hp<=0){ a.alive=false; } }); }
  // ── strike the Pretender in the throne room ──
  if(place.kind==='interior' && place.id==='mistthrone' && mistThrone.fighting && mistThrone.boss){
    const b=mistThrone.boss; const bcx=b.x+TILE/2, bcy=b.y+TILE/2; let vx=bcx-kcx, vy=bcy-kcy; const dist=Math.hypot(vx,vy);
    if(dist<=reach && (dist<0.001 || (vx*fv[0]+vy*fv[1])/dist>=cosCut)){
      let dmg=Math.max(1,Math.round(player.atk*w.mult)+(Math.random()*5|0)); const crit=Math.random()<player.crit; if(crit)dmg=Math.round(dmg*1.8);
      dmg=throneHitGate(dmg);
      if(dmg>0){ b.hp=Math.max(0,b.hp-dmg); b.hurt=8; anyHit=true; _swingHit=true; if(crit)_swingCrit=true; } }
  }
  // ── strike the King of the Shadows on Eden's spring ──
  if(place.kind==='portalworld' && portalWorld.id==='tabor' && taborBoss.phase==='fight' && taborBoss.boss){
    const b=taborBoss.boss; const bcx=b.x+TILE/2, bcy=b.y+TILE/2; let vx=bcx-kcx, vy=bcy-kcy; const dist=Math.hypot(vx,vy);
    const bigReach=reach+TILE*0.9;                    // he is a mountain; the target is wide
    if(dist<=bigReach && (dist<0.001 || (vx*fv[0]+vy*fv[1])/dist>=cosCut)){
      let dmg=Math.max(1,Math.round(player.atk*w.mult)+(Math.random()*5|0)); const crit=Math.random()<player.crit; if(crit)dmg=Math.round(dmg*1.8);
      dmg=shadowHitGate(dmg);
      if(dmg>0){ b.hp=Math.max(0,b.hp-dmg); b.hurt=8; anyHit=true; _swingHit=true; if(crit)_swingCrit=true; } }
  }
  // ── strike the Pretender on the mirror throne ──
  if(place.kind==='interior' && place.id==='vesper_cath' && sunBoss.phase==='fight' && sunBoss.boss){
    const b=sunBoss.boss; const bcx=b.x+TILE/2, bcy=b.y+TILE/2; let vx=bcx-kcx, vy=bcy-kcy; const dist=Math.hypot(vx,vy);
    const bigReach=reach+TILE*0.6;
    if(dist<=bigReach && (dist<0.001 || (vx*fv[0]+vy*fv[1])/dist>=cosCut)){
      let dmg=Math.max(1,Math.round(player.atk*w.mult)+(Math.random()*5|0)); const crit=Math.random()<player.crit; if(crit)dmg=Math.round(dmg*1.8);
      dmg=pretenderHitGate(dmg);
      if(dmg>0){ b.hp=Math.max(0,b.hp-dmg); b.hurt=8; anyHit=true; _swingHit=true; if(crit)_swingCrit=true; } }
  }
  if(anyHit) player.comboT=48;   // landing a hit keeps the combo alive
  if(_swingHit) sfxHit(_swingCrit);
  else if(_swingClang) sfxBlock();      // the guardian turned it aside — steel on steel
}
// ── SIGNATURE SPECIAL — the 3rd combo strike unleashes the weapon's signature ──
function doSpecial(){
  if(place.kind!=="overworld" && place.kind!=="dungeon" && place.kind!=="abaddon" && place.kind!=="portalworld" && !(place.kind==="interior" && place.id==="mistthrone" && (mistThrone.fighting||mistThrone.lastStand)) && !sunTowerCombat()) return;
  const wId = player.equip ? player.equip.weapon : 'none_w';
  const sp = SPECIALS[(EQUIP[wId]&&EQUIP[wId].special)||'flurry'];
  player.swing = 22; player.swingDir = player.dir; player.swingType='special';
  player.specialFx = 22; player.specialColor = sp.color;
  const kcx=player.x+TILE/2, kcy=player.y+TILE/2;
  const reach = TILE*sp.radius;
  const fv = player.dir==='up'?[0,-1] : player.dir==='down'?[0,1] : player.dir==='left'?[-1,0] : [1,0];
  setTimeout(()=>{
    if(place.kind!=="overworld" && place.kind!=="dungeon" && place.kind!=="abaddon" && place.kind!=="portalworld" && !(place.kind==="interior" && place.id==="mistthrone" && (mistThrone.fighting||mistThrone.lastStand)) && !sunTowerCombat()) return;
    let hits=0;
    demons.forEach(d=>{ if(!d.alive)return;
      const dcx=d.x+TILE/2, dcy=d.y+TILE/2; let vx=dcx-kcx, vy=dcy-kcy; const dist=Math.hypot(vx,vy);
      if(dist>reach) return;
      if(!sp.spin){ // forward-only specials must be in the facing arc
        if(dist>0.001){ const dot=(vx*fv[0]+vy*fv[1])/dist; if(dot<Math.cos(Math.PI*0.5)) return; }
      }
      let dmg=Math.max(1, Math.round(player.atk*sp.mult)+(Math.random()*6|0)-2);
      const isCrit=Math.random()<player.crit+0.1; if(isCrit) dmg=Math.round(dmg*1.8);
      dmg=bossHitGate(d, dmg);
      if(dmg<0){ d.hurt=3; return; }
      d.hp-=dmg; d.hurt=10; d.pop={dmg,crit:isCrit,t:30}; hits++;
      const m=dist||1; d.kdx=vx/m*sp.knock; d.kdy=vy/m*sp.knock; d.knock=10;
      if(d.hp<=0){ d.alive=false; d.dying=18; sfxDemonDie(); gainXp(d.xp||5); const g=Math.max(1,Math.round((2+d.level)*player.goldMult)); gold+=g; if(d.fallen){ onFallenKnightKilled(d); } else if(d.beast){ if(d._rescueGuard) onTaborGuardKilled(d); } else if(d.dungeon) onDungeonDemonKilled(d); else onHuntKill(d); }
    });
    if(sp.heal>0 && player.hp<player.maxHp){ player.hp=Math.min(player.maxHp, player.hp+Math.round(sp.heal*player.healMult)); }
    // specials also strike Abaddon + his shades (and dungeon adds)
    if(place.kind==='abaddon' && abaddon.active){
      const bcx=abaddon.x+TILE/2, bcy=abaddon.y+TILE/2; const bd=Math.hypot(bcx-kcx,bcy-kcy);
      if(bd<=reach && !abaddon.shield){ let dmg=Math.max(1,Math.round(player.atk*sp.mult)); const crit=Math.random()<player.crit+0.1; if(crit)dmg=Math.round(dmg*1.8);
        dmg=abaddonHitGate(dmg);                                  // the special honours the rules too
        if(dmg<0){ abaddon.hurt=3; }
        else { abaddon.hp=Math.max(0,abaddon.hp-dmg); abaddon.hurt=10; abaddon.pop={dmg,crit,t:30}; hits++; if(abaddon.hp<=0) winAbaddon(); } }
      abaddon.adds.forEach(a=>{ if(!a.alive)return; if(Math.hypot(a.x+TILE/2-kcx,a.y+TILE/2-kcy)>reach)return; a.hp-=Math.max(1,Math.round(player.atk*sp.mult)); a.hurt=8; hits++; if(a.hp<=0)a.alive=false; });
    }
    if(place.kind==='dungeon'){ dungeon.adds.forEach(a=>{ if(!a.alive)return; if(Math.hypot(a.x+TILE/2-kcx,a.y+TILE/2-kcy)>reach)return; a.hp-=Math.max(1,Math.round(player.atk*sp.mult)); a.hurt=8; hits++; if(a.hp<=0)a.alive=false; }); }
    showBanner(`✦ ${sp.name}!`+(hits?` <span style="font-size:7px">×${hits}</span>`:''), 700);
  }, 100);
}
// ── DYNAMIC Ⓑ: hold to BLOCK (75% damage turned aside, slowed steps),
//    double-tap to DODGE-dash. Overlays & surf keep their old tap behavior.
const bBtn={down:false, downAt:0, lastTap:0};
function gameplayB(){ return !(intro.open||menu.open||trial.open||library.open||libShop||shopMode||seedMode||petB||styl||barn)
  && (place.kind==='overworld'||place.kind==='dungeon'||place.kind==='abaddon'||place.kind==='portalworld'
      ||(place.kind==='interior' && place.id==='mistthrone' && (mistThrone.fighting||mistThrone.lastStand))
      ||sunTowerCombat()); }
function bDown(){ if(decorPlace.active){ decorCancel(); return; }
  // in the lists Ⓑ is HELD, not tapped: it raises the shield, and holding it
  // long enough yields. Routed here so the button reaches the guard at all —
  // the logic is worth nothing if nothing calls it.
  if(place.kind==='tourney'){ tourneyGuard(true); return; }
  if(place.kind==='surf'){ surfPress('B'); return; }
  if(place.kind==='tourney'){ tourneyPress('B'); return; }
  if(!gameplayB()){ bPress(); return; }                 // menus, trials, shops… = classic tap
  const now=performance.now();
  if(now-bBtn.lastTap<300){ bBtn.lastTap=0; doDodge(); return; }   // double-tap → dodge!
  bBtn.down=true; bBtn.downAt=now;
}
function bUp(){
  if(place.kind==='tourney'){ tourneyGuard(false); }
  if(!bBtn.down) return;
  bBtn.down=false; player.blocking=false;
  if(performance.now()-bBtn.downAt<170) bBtn.lastTap=performance.now();  // quick tap — a second one dodges
}
let blockSparkT=0;
function showBlockSpark(){ blockSparkT=14; sfxBlock(); }
function doDodge(){ if(decorPlace.active){ decorCancel(); return; }
  if(place.kind!=="overworld" && place.kind!=="dungeon" && place.kind!=="abaddon" && place.kind!=="portalworld" && !(place.kind==="interior" && place.id==="mistthrone" && (mistThrone.fighting||mistThrone.lastStand)) && !sunTowerCombat()) return;
  if(player.dodgeCd>0 || player.dashing>0 || player.swing>0) return;
  const dirs={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]};
  const [dx,dy]=dirs[player.dir];
  // hop BACKWARD — away from the way you're facing (negate the facing vector)
  player.dashx=-dx*5.2; player.dashy=-dy*5.2; player.dashing=7; player.iframes=22; player.dodgeCd=34;
  sfxDodge();
}
// ── MOUNT / TRAVERSAL — third-form pets carry you (ride/fly/swim) ──
function toggleMount(){
  const ab=petAbility();
  if(!ab){ showBanner('Your companion must reach its final form to carry you.', 1800); return; }
  if(place.kind!=='overworld'){ showBanner('You can only mount in the open world.', 1400); return; }
  if(player.mounted){
    // dismount only onto solid ground (not in the air over water/cliffs)
    const tx=Math.floor((player.x+TILE/2)/TILE), ty=Math.floor((player.y+TILE/2)/TILE);
    if(!WALK.has(tileAt(tx,ty))){ showBanner('Find solid ground before dismounting!', 1600); return; }
    player.mounted=false; showBanner('🚶 You dismount.', 1000);
  } else {
    player.mounted=true; sfxMount();
    const f=petForm();
    showBanner(`${f.emoji} You mount your ${f.name}! <span style="font-size:7px">${ab==='ride'?'Gallop with the d-pad — double speed.':ab==='fly'?'Soar over trees, water, and cliffs.':'Swim across water.'}<br>Press the 🐎 button to dismount.</span>`, 2400);
  }
  updateMountBtn();
}
function updateMountBtn(){ const b=document.getElementById('mountBtn'); if(!b) return;
  const ab=petAbility(); b.style.display = (ab && place.kind==='overworld' && !player.driving) ? 'flex' : 'none';
  b.textContent = player.boating ? '⚓' : (player.mounted ? '🚶' : (petForm()?petForm().emoji:'🐎'));
  if(typeof updateWagonBtn==='function') updateWagonBtn();
}
function discoverSecret(s){
  secretsFound[s.id]=true;
  const r=s.reward;
  if(r.kind==='gold'){ gold += Math.round(r.amount*player.goldMult); }
  else if(r.kind==='gear'){ if(!player.ownedGear[r.id]) player.ownedGear[r.id]=true; }
  showBanner(`✨ <b style="color:#ffe04a">SECRET DISCOVERED!</b><br><span style="font-size:7px">${r.text}${r.kind==='gear'?'<br>Equip it in the ☰ menu.':''}</span>`, 4000);
  saveGame();
}
// ── XP / LEVELING ──
function gainXp(amount){
  player.xp += amount;
  let leveled=false, gained=0;
  while(player.xp >= player.xpNext){
    player.xp -= player.xpNext; player.level++; leveled=true; gained++;
    player.skillPoints++;                                  // 1 skill point per level
    player.xpNext = xpForLevel(player.level);
  }
  if(leveled){ recalcStats(); player.hp = player.maxHp; sfxLevelUp();   // recompute stats, full heal on level
    showBanner(`⭐ LEVEL UP! You are now level ${player.level}.<br><span style="font-size:7px">❤ Max HP ${player.maxHp} · ⚔ Attack ${player.atk} · 🛡 Def ${player.def}</span><br><span style="font-size:7px;color:#ffe04a">+${gained} skill point${gained>1?'s':''}! Press ☰ / M to spend.</span>`, 2600);
    checkPetEvolve();
  }
  else showBanner(`⚔️ Demon vanquished! +${amount} XP`, 800);
}
// pet evolves when the player reaches its form thresholds
function checkPetEvolve(){
  if(!player.pet) return;
  const line=PETS[player.pet.id];
  let target=0; for(let i=0;i<PET_EVOLVE_LV.length;i++){ if(player.level>=PET_EVOLVE_LV[i]) target=i; }
  if(target>player.pet.form){
    player.pet.form=target; recalcStats();
    const f=line.forms[target];
    let msg=`✨ <b style="color:#ffe04a">${line.name} evolved into ${f.emoji} ${f.name}!</b>`;
    if(f.ability) msg+=`<br><span style="font-size:7px">New ability: <b>${f.abilityName}</b> — ${f.abilityDesc}<br>Press Ⓑ near the right terrain to use it.</span>`;
    showBanner(msg, 4200);
  }
}
// ── SHOP MENU helpers ──
function openShop(){
  const items=Object.keys(SHOP_ITEMS).filter(k=>k!=='lantern');   // lantern is special — gated below
  const ti=SHOP_TOWN[place.id];                       // this village's unique pet piece
  if(ti!==undefined){ for(const k in PET_GEAR) if(PET_GEAR[k].town===ti) items.push(k); }
  // 🏮 Forester's Lantern unlocks once Saltmere (town 1) is liberated — it lifts the
  //    fog of the Forest of Disillusionment. Sold everywhere thereafter, once.
  if(chapelProgress[1] && !player.hasLamp) items.push('lantern');
  shopMode={ items, idx:0 }; showShop();
}
function showShop(msg){
  const it=shopItem(shopMode.items[shopMode.idx]);
  const list=shopMode.items.map((k,i)=>{ const s=shopItem(k); const sel=i===shopMode.idx; 
    return `<span data-shopidx="${i}" style="color:${sel?'#ffe04a':'#9a8ab8'};display:inline-block;padding:1px 0">${sel?'▶ ':'　'}${s.emoji} ${s.name} — ${s.price}g</span>`; }).join('<br>');
  banner.innerHTML = `<span data-shopclose="1" style="position:absolute;top:1px;right:7px;color:#ff8a8a;font-size:10px;padding:3px 5px;cursor:pointer">✕</span>`+
    `<b style="color:#fff">🏪 Shop</b> <span style="font-size:7px;color:#ffe04a">(you have ${gold}g)</span><br>`+
    `<span style="font-size:7px">${list}</span><br>`+
    `<span style="font-size:6px;color:#8a7aaa">${it.note} · tap an item, tap again to buy · ✕ or walk away to leave</span>`+
    (msg?`<br><span style="font-size:7px;color:#7ad07a">${msg}</span>`:'');
  banner.style.display='block'; banner.style.pointerEvents='auto'; bannerT=999999;   // stays until closed (tappable while shopping)
}
function closeShop(){ shopMode=null; banner.style.display='none'; banner.style.pointerEvents='none'; bannerT=0; }

// ══ 🌱 THE SEED PICKER ── four seeds, four parables. Mustard costs least and
//    gives most, because that is what the Lord said of it. ══
function openSeedPicker(x,y){
  const items=ownedSeeds();
  if(!items.length){
    showBanner('🌱 <b>No seed in your pouch.</b><br><span style="font-size:7px">Seed is sold at any village shop — mustard for a single coin. “He that observeth the wind shall not sow.” — Ecc 11:4</span>', 2400);
    return true;
  }
  let idx=items.indexOf(lastSeed); if(idx<0) idx=0;
  seedMode={ items, idx, x, y };
  showSeedPicker();
  return true;
}
function showSeedPicker(msg){
  if(!seedMode) return;
  const k=seedMode.items[seedMode.idx], C=CROPS[k];
  const list=seedMode.items.map((ck,i)=>{ const c=CROPS[ck]; const sel=i===seedMode.idx;
    const have=inventory[c.seed]||0;
    return `<span data-seedidx="${i}" style="color:${sel?'#ffe04a':'#9a8ab8'};display:inline-block;padding:1px 0">${sel?'▶ ':'　'}${c.emoji} ${c.name} ×${have}</span>`; }).join('<br>');
  const ripeS=Math.round(C.ms*3/1000);
  banner.innerHTML = `<span data-seedclose="1" style="position:absolute;top:1px;right:7px;color:#ff8a8a;font-size:10px;padding:3px 5px;cursor:pointer">✕</span>`+
    `<b style="color:#fff">🌱 Sow which seed?</b><br>`+
    `<span style="font-size:7px">${list}</span><br>`+
    `<span style="font-size:6px;color:#8a7aaa">ripe in ~${ripeS}s · yields ${C.yield} ${GOODS[C.produce].emoji} · tap a seed, tap again to sow</span><br>`+
    `<span style="font-size:6px;color:#c8b0f0;font-style:italic">${C.verse}</span>`+
    (msg?`<br><span style="font-size:7px;color:#7ad07a">${msg}</span>`:'');
  banner.style.display='block'; banner.style.pointerEvents='auto'; bannerT=999999;
}
function closeSeedPicker(){ seedMode=null; banner.style.display='none'; banner.style.pointerEvents='none'; bannerT=0; }
function cycleSeed(step){
  if(!seedMode) return;
  const n=seedMode.items.length;
  seedMode.idx=(seedMode.idx+step+n)%n;
  showSeedPicker();
}
// commit: spend one seed of the chosen kind and put it in the ground
function plantSelected(){
  if(!seedMode) return true;
  const k=seedMode.items[seedMode.idx], C=CROPS[k];
  const key=seedMode.x+','+seedMode.y;
  if((inventory[C.seed]||0)<=0){ seedMode.items=ownedSeeds();
    if(!seedMode.items.length){ closeSeedPicker(); showBanner('🌱 Your seed pouch is empty.', 1600); return true; }
    seedMode.idx=0; showSeedPicker('That seed ran out.'); return true; }
  if(crops[key]){ closeSeedPicker(); showBanner('🌱 Something already grows here.', 1200); return true; }
  if(!(WORLD[seedMode.y] && WORLD[seedMode.y][seedMode.x]===31)){ closeSeedPicker(); return true; }
  inventory[C.seed]--;
  crops[key]={ type:k, stage:0, plantedAt:performance.now() };
  lastSeed=k;
  closeSeedPicker();
  showBanner(`${C.emoji} <b>Sown: ${C.name}.</b> (${inventory[C.seed]} left)<br><span style="font-size:6px;color:#c8b0f0;font-style:italic">${C.verse}</span>`, 2200);
  return true;
}

// ── 🛒 WAGON LOAD MENU (uses the banner overlay, like the shop) ──
function wagonRows(){
  const rows=[];
  for(const g of WAGON_GOODS){ if((inventory[g]||0)>0) rows.push({kind:'load', good:g}); }
  if(cargoCount()>0) rows.push({kind:'unload'});
  rows.push({kind:'hitch'});
  rows.push({kind:'close'});
  return rows;
}
// ── _legacy showWagon (pre-demand-annotations) — kept verbatim for instant revert
