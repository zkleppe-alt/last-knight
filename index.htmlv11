      px(x,y+5,TILE,1,'#a39c8e'); px(x,y+11,TILE,1,'#a39c8e');
      const off=(h1&1)?4:0;
      px(x+3+off,y,1,5,'#a39c8e'); px(x+9+off-((h2&1)?3:0),y+6,1,5,'#a39c8e'); px(x+5+(h3&3),y+12,1,4,'#a39c8e');
      if(h1<5) px(x+(off?4+off:0)+1,y+1,3,3,'#c2bbad');
