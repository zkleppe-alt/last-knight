function mulberry(seed){ let a=seed>>>0; return ()=>{ a|=0; a=(a+0x6D2B79F5)|0; let t=Math.imul(a^(a>>>15),1|a); t=(t+Math.imul(t^(t>>>7),61|t))^t; return ((t^(t>>>14))>>>0)/4294967296; }; }
function genMazeFloor(townId, floorIdx){
  const rnd=mulberry(townId*7919 + floorIdx*104729 + 13);
  const g=Array.from({length:MAZE_H},()=>Array(MAZE_W).fill(1));
  // carve a maze on the odd-coordinate cell lattice — recursive backtracker
  // _legacy: const CX=7, CY=5;  — a second copy of the lattice size that had to
  //   agree with MAZE_W/MAZE_H by hand.
  const CX=MAZE_CX, CY=MAZE_CY; const cx2=(c)=>c*2+1, cy2=(c)=>c*2+1;
  const seen=Array.from({length:CY},()=>Array(CX).fill(false));
  const stack=[[Math.floor(rnd()*CX), CY-1]]; seen[CY-1][stack[0][0]]=true;
  g[cy2(CY-1)][cx2(stack[0][0])]=0;
  while(stack.length){
    const [cx,cy]=stack[stack.length-1];
    const nbrs=[[1,0],[-1,0],[0,1],[0,-1]].map(([dx,dy])=>[cx+dx,cy+dy,dx,dy])
      .filter(([nx,ny])=>nx>=0&&nx<CX&&ny>=0&&ny<CY&&!seen[ny][nx]);
    if(!nbrs.length){ stack.pop(); continue; }
    const [nx,ny,dx,dy]=nbrs[Math.floor(rnd()*nbrs.length)];
    g[cy2(cy)+dy][cx2(cx)+dx]=0; g[cy2(ny)][cx2(nx)]=0;
    seen[ny][nx]=true; stack.push([nx,ny]);
  }
  // braid: open a few extra walls so corridors loop (less dead-end backtracking)
  for(let y=1;y<MAZE_H-1;y++)for(let x=1;x<MAZE_W-1;x++){
    if(g[y][x]!==1) continue;
    const open=(g[y-1][x]===0&&g[y+1][x]===0&&g[y][x-1]===1&&g[y][x+1]===1)||
               (g[y][x-1]===0&&g[y][x+1]===0&&g[y-1][x]===1&&g[y+1][x]===1);
    if(open && rnd()<0.18) g[y][x]=0;
  }
  // ENTRANCE at the bottom-center cell; STAIRS at the farthest floor cell (BFS)
  const ex=cx2(Math.floor(CX/2)), ey=cy2(CY-1); g[ey][ex]=8;
  const distm={}; const q=[[ex,ey,0]]; distm[ex+','+ey]=0;
  while(q.length){ const [x,y,dd]=q.shift();
    [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dx,dy])=>{ const nx2=x+dx, ny2=y+dy, k=nx2+','+ny2;
      if(nx2<0||ny2<0||nx2>=MAZE_W||ny2>=MAZE_H) return;
      if(g[ny2][nx2]===1 || distm[k]!==undefined) return; distm[k]=dd+1; q.push([nx2,ny2,dd+1]); }); }
  let far=null, fd=-1;
  for(const k in distm){ if(distm[k]>fd){ fd=distm[k]; far=k; } }
  const [sx2,sy2]=far.split(',').map(Number); g[sy2][sx2]=2;
  // ── THE WALKWAY ──────────────────────────────────────────────────────────
  //    The floor has a destination. A walkway runs along the top of the level;
  //    the stair waits at its far end; a great stone stands in the channel and
  //    bars the way. TWO climbs lead up to it from the maze below — one short
  //    and bare, one long and guarding a chest. The stone rolls horizontally,
  //    which is the only motion that reads right for a stone in a channel.
  //
  //      row 1   #.....O########B......S#     S stair  B stone  O where it rests
  //      row 2   ####.#############.####      the two climbs
  //      row 3   the maze below
  //
  //    _legacy: the stair used to sit at the BFS-farthest cell, sealed behind a
  //      dead-end stub chosen from whatever the seed produced. Two earlier
  //      passes before that walled off a corridor room (which orphaned regions
  //      of maze) and tried to carve a chamber into solid rock (impossible: a
  //      lattice maze's walls are one cell thick). The walkway is built, not
  //      found, so the floor reads the same way every time.
  {
