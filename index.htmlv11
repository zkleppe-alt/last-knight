  //  cacti, and robed desert-dwellers. Sandstone wall enclosure.
  // ════════════════════════════════════════════════════════════════
  rect(g, 48, 30, 71, 50, 19);                // sandy town ground
  // sandstone walls with a WEST gate (from the desert trail)
  for(let x=47;x<=72;x++){ g[29][x]=5; g[51]&&(g[51][x]=5); }
  for(let y=29;y<=51;y++){ g[y][47]=5; g[y][72]=5; }
  g[40][47]=8; g[41][47]=8;                    // WEST gate <- desert trail
  g[51][66]=8; g[51][67]=8;                     // SOUTH-EAST gate -> Mountain Pass to Crystalpeak
  rect(g,45,40,47,41,2);
  // sandy central plaza with packed-earth paths
  rect(g, 53, 36, 66, 44, 2);
  rect(g, 48, 40, 53, 41, 2);                  // gate -> plaza
  rect(g, 58, 31, 59, 36, 2); rect(g, 58, 44, 59, 49, 2); // vertical lanes
  // welcome sign
  g[41][48]=16; signs['48,41']='DUSTHAVEN\nLife clings to the oasis';

  // ───────── buildings of Dusthaven (adobe styling) ─────────
  buildings.push({ id:'dh_chapel', name:'Dusthaven Chapel',  style:'chapel', x:57, y:30, w:6, h:6, door:{x:59,y:36}, interior:'dh_chapel' });
  buildings.push({ id:'dh_shop',   name:'Caravan Bazaar',    style:'shop',   x:49, y:32, w:5, h:4, door:{x:51,y:36}, interior:'dh_shop' });
  buildings.push({ id:'dh_inn',    name:'The Oasis Rest',    style:'inn',    x:66, y:33, w:5, h:4, door:{x:68,y:37}, interior:'dh_inn' });
  buildings.push({ id:'dh_home1',  name:'Adobe Dwelling',    style:'cottage',x:49, y:45, w:5, h:4, door:{x:51,y:49}, interior:'dh_home1' });
  buildings.push({ id:'dh_home2',  name:'Nomad\'s Tent-Home',style:'house',  x:66, y:45, w:4, h:3, door:{x:67,y:48}, interior:'dh_home2' });
  buildings.forEach(b=>stampBuilding(g,b));
  [[59,37],[51,37],[68,38],[51,50],[67,49]].forEach(([dx,dy])=>{ if(g[dy]&&g[dy][dx]!==undefined && g[dy][dx]!==3) g[dy][dx]=2; });
  // link buildings to plaza
  rect(g,51,36,51,40,2); rect(g,68,37,68,44,2); rect(g,51,44,51,49,2); rect(g,67,44,67,48,2);

  // ───────── Dusthaven decorations (desert/oasis theme) ─────────
  addDecor(59, 40, 'oasis', true, 3);          // CENTERPIECE: oasis pool with palms (3x3)
  addDecor(55, 38, 'tent', true, 2);           // sun-shade market tents
  addDecor(63, 42, 'tent', true, 2);
  addDecor(54, 43, 'cactus', true);            // potted/standing cacti
  addDecor(64, 37, 'cactus', true);
  addDecor(57, 46, 'waterjug', true);          // clay water jars
  addDecor(62, 35, 'waterjug', true);
  addDecor(53, 47, 'palmDesert', true);        // lone desert palms
  addDecor(69, 41, 'palmDesert', true);

  // ───────── Dusthaven villagers (robed desert-dwellers) ─────────
  addVillager(57, 39, 'nomad',   ["Water is life, traveler. Drink at the oasis.","The dunes shift — trust no map out there."]);
  addVillager(62, 41, 'merchantD',["Silks, spices, secrets — the bazaar has all."]);
  addVillager(60, 45, 'nomadF',  ["The sun is cruel, but the oasis is kind."]);
  addVillager(55, 42, 'nomad',   ["Demons fear the deep desert. So should you."]);

  // ════════════════════════════════════════════════════════════════
  //  MOUNTAIN PASS (south down the FAR-east edge, clear of Thornwood) →
  //  Crystalpeak. Desert gives way to SNOW & ICE as you climb.
  // ════════════════════════════════════════════════════════════════
  // snow corridor down the far-east columns (74-84), well east of Thornwood (ends col 72)
  rect(g, 74, 44, 84, 100, 22);
  // connector from Dusthaven's SE gate (col 66-67, row 51) east to the pass head
  for(let x=66;x<=79;x++){ g[52][x]=2; g[53][x]=2; }
  rect(g,66,51,67,52,2);
  // the descending pass (packed-snow trail) down to Crystalpeak's north gate
  for(let y=53; y<=100; y++){
    const xx = 78 + Math.round(Math.sin((y-53)*0.28)*2);
    for(let c=0;c<2;c++){ if(g[y]&&g[y][xx+c]!==undefined) g[y][xx+c]=2; }
  }
  // ice patches + rocky outcrops flanking the pass
  for(let i=0;i<30;i++){ const tx=75+Math.floor(Math.random()*9), ty=55+Math.floor(Math.random()*44);
    if((tx+ty)%4===0 && g[ty] && g[ty][tx]===22) g[ty][tx]=(i%2?1:23); }
  // reserved frozen cave nook
  rect(g, 75, 72, 77, 75, 18); g[75][75]=16; signs['75,75']='An icy cavern mouth...\n(nothing here yet)';
  // soft-gate mountain demons (tough)
  encounterZones.push({ x0:74, y0:55, x1:84, y1:99, level:8 });

  // ════════════════════════════════════════════════════════════════
  //  CRYSTALPEAK (cols ~60..84, rows ~100..115) — frozen MONASTERY town.
  //  Snow & ice, stone monastery halls, a central HEALING HOT SPRING
  //  (step in to restore HP!), braziers, and robed monks.
  // ════════════════════════════════════════════════════════════════
  rect(g, 60, 100, 84, 115, 22);               // snowy town ground
  // stone monastery walls with a NORTH gate (from the pass)
  for(let x=59;x<=85;x++){ g[99][x]=5; g[116]&&(g[116][x]=5); }
  for(let y=99;y<=116;y++){ g[y][59]=5; g[y][85]=5; }
  g[99][78]=8; g[99][79]=8;                     // NORTH gate <- mountain pass
  rect(g,78,98,79,99,2);
  // swept stone courtyard paths
  rect(g, 65, 104, 79, 111, 6);
  rect(g, 72, 100, 73, 104, 6);                 // gate -> courtyard (col 78 funnels to 72-73)
  for(let x=73;x<=78;x++){ g[100][x]=6; }
  rect(g, 61, 107, 65, 108, 6); rect(g, 79, 107, 83, 108, 6);
  // welcome sign
  g[101][61]=16; signs['61,101']='CRYSTALPEAK\nThe frozen monastery — rest in the spring';
  // ── HEALING HOT SPRING (step in to heal) ──
  rect(g, 70, 108, 73, 110, 24);
  // ice patches
  g[103][63]=23; g[113][81]=23; g[102][80]=23;

  // ───────── buildings of Crystalpeak (stone monastery styling) ─────────
  buildings.push({ id:'cp_chapel', name:'Mountain Cathedral', style:'chapel', x:70, y:100, w:6, h:6, door:{x:72,y:106}, interior:'cp_chapel' });
  buildings.push({ id:'cp_shop',   name:'Pilgrim\'s Supply',  style:'shop',   x:61, y:102, w:5, h:4, door:{x:63,y:106}, interior:'cp_shop' });
  buildings.push({ id:'cp_inn',    name:'The Warm Hearth',    style:'inn',    x:79, y:103, w:5, h:4, door:{x:81,y:107}, interior:'cp_inn' });
  buildings.push({ id:'cp_home1',  name:'Monk\'s Cell',       style:'cottage',x:61, y:110, w:5, h:3, door:{x:63,y:110}, interior:'cp_home1' });
  buildings.push({ id:'cp_home2',  name:'Abbot\'s Quarters',  style:'house',  x:79, y:111, w:4, h:3, door:{x:80,y:111}, interior:'cp_home2' });
  buildings.forEach(b=>stampBuilding(g,b));
  // carve walkable snow approaches in front of every Crystalpeak door (north-facing doors -> approach above)
  [[72,107],[63,107],[81,108],[63,109],[80,110]].forEach(([dx,dy])=>{ if(g[dy]&&g[dy][dx]!==undefined) g[dy][dx]=22; });
