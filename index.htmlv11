  // a few decorative trees just inside the walls
  g[52][6]=1; g[53][43]=1; g[70][6]=15; g[69][43]=15;
  // banners/flowers sparse (it is a martial town)
  g[55][9]=4; g[64][40]=4;
  // welcome sign at the gate
  g[51][21]=16; signs['21,51']='IRONHOLD\nThe Iron Hub — forge of the realm';
  // south gate -> the Coast Road to Saltmere
  g[72][18]=8; g[72][19]=8; g[72][20]=8;

  // ───────── buildings of Ironhold (spread across the wider hub) ─────────
  buildings.push({ id:'ih_keep',   name:'Ironhold Keep',     style:'keep',   x:21, y:51, w:7, h:5, door:{x:24,y:56}, interior:'ih_keep' });
  buildings.push({ id:'ih_chapel', name:'Ironhold Chapel',   style:'chapel', x:38, y:52, w:6, h:6, door:{x:40,y:58}, interior:'ih_chapel' });
  buildings.push({ id:'ih_forge',  name:'The Great Forge',   style:'shop',   x:5,  y:53, w:6, h:4, door:{x:7,y:57},  interior:'ih_forge' });
  buildings.push({ id:'ih_inn',    name:'The Anvil Rest Inn',style:'inn',    x:38, y:65, w:5, h:4, door:{x:40,y:69}, interior:'ih_inn' });
  buildings.push({ id:'ih_home1',  name:"Smith's Home",      style:'house',  x:6,  y:66, w:4, h:3, door:{x:7,y:69},  interior:'ih_home1' });
  buildings.push({ id:'ih_home2',  name:"Soldier's Quarters",style:'house',  x:7,  y:60, w:4, h:3, door:{x:8,y:63}, interior:'ih_home2' });
