    for(let x=1;x<MAZE_W-1;x++){ g[WROW][x]=0; g[CEIL][x]=1; }   // the walkway and its floor
    for(let x=1;x<MAZE_W-1;x++) if(g[3][x]===2) g[3][x]=0;       // no stray stair below
    g[sy2][sx2]=0;                                                // the old stair cell is plain floor
    // walk the maze BODY from the entrance, so "easier" and "harder" are measured
    const dEnt={}; { const q=[[ex,ey]]; dEnt[ex+','+ey]=0;
      while(q.length){ const [x,y]=q.shift();
        for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nx=x+dx, ny=y+dy, k=nx+','+ny;
          if(nx<1||ny<3||nx>=MAZE_W-1||ny>=MAZE_H-1) continue;
          if(g[ny][nx]===1 || dEnt[k]!==undefined) continue;
          dEnt[k]=dEnt[x+','+y]+1; q.push([nx,ny]); } } }
    // candidate climbs: odd columns on the maze side of the stone, reachable below
    const cands=[];
    for(let x=3;x<=bx-2;x+=2) if(g[3][x]!==1 && dEnt[x+',3']!==undefined) cands.push(x);
    // Take the PAIR with the widest gap in effort that is also physically apart,
    // so the two ways up are visibly different routes and one is plainly longer.
    // The two climbs must be far APART, not merely different. Four columns apart
    // in a braided maze leaves most cells the same distance from both, so there
    // is no long road and no short one — just two doors onto the same corridor.
    const minSpan=Math.max(4, Math.floor((bx-4)/2));
    // Choose the pair that carves the maze into TWO REAL ROADS, not the pair
    // with the biggest distance gap. Optimising the gap produced floors where
    // three cells out of three hundred were nearer one climb than the other —
    // two doors onto the same corridor, and no choice to make. Score each pair
    // by how balanced its two territories are; break ties on the longer road.
    const _terr=(fromX)=>{ const d={}; const q=[[fromX,3]]; d[fromX+',3']=0;
      while(q.length){ const [x,y]=q.shift();
        for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nx=x+dx, ny=y+dy, k=nx+','+ny;
          if(nx<1||ny<3||nx>=MAZE_W-1||ny>=MAZE_H-1) continue;
          if(g[ny][nx]===1 || d[k]!==undefined) continue;
          d[k]=d[x+','+y]+1; q.push([nx,ny]); } }
      return d; };
    // The pair must satisfy BOTH: two real territories, and one road plainly
    // longer than the other. Optimising balance alone gave floors where the two
    // roads measured 46 and 46 — a fork with nothing to choose between its arms,
    // and no way to say which one earns the chest. Insist on a gap first; only
    // if no pair offers one do we settle for the best-balanced tie.
    let easyX=null, hardX=null, bestScore=-1, bestGap=-1;
    const _score=(a,b)=>{ const da=_terr(a), db=_terr(b); let na=0, nb=0;
      for(const k in da){ if(db[k]===undefined){ na++; continue; }
        if(da[k]<db[k]) na++; else if(db[k]<da[k]) nb++; }
      return Math.min(na,nb); };
    for(const needGap of [true,false]){
      for(const a of cands) for(const b of cands){
        if(b<=a || Math.abs(a-b)<minSpan) continue;
        const gap=Math.abs((dEnt[b+',3']||0)-(dEnt[a+',3']||0));
        if(needGap && gap<2) continue;
