    {
      const reach=()=>{ const seen=new Set([ex+','+ey]), st=[[ex,ey]];
        while(st.length){ const [x,y]=st.pop();
          for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nx=x+dx, ny=y+dy, k=nx+','+ny;
            if(nx<1||ny<3||nx>=MAZE_W-1||ny>=MAZE_H-1||seen.has(k)) continue;
            if(g[ny][nx]===1) continue; seen.add(k); st.push([nx,ny]); } }
