  // walkable approaches in front of each door
  [[24,57],[40,59],[7,58],[40,70],[7,70],[8,64]].forEach(([dx,dy])=>{ if(g[dy]&&g[dy][dx]!==undefined && g[dy][dx]!==3) g[dy][dx]=6; });

  // ───────── Ironhold decorations (martial/forge theme, spaced out) ─────────
  addDecor(24, 61, 'anvilMonument', true, 2);  // CENTERPIECE: great anvil monument (central)
  addDecor(18, 58, 'brazier', true);           // fire braziers light the courtyard
  addDecor(31, 58, 'brazier', true);
  addDecor(18, 65, 'brazier', true);
  addDecor(31, 65, 'brazier', true);
  addDecor(12, 54, 'weaponRack', true);        // weapon racks by the forge
  addDecor(15, 61, 'crate', true);
  addDecor(34, 61, 'crate', true);
  addDecor(36, 53, 'banner2', true);           // war banners

  // ───────── Ironhold villagers (smiths & soldiers) ─────────
  addVillager(22, 62, 'smith',   ["The forge never cools in Ironhold.","Need your blade reforged? See the Great Forge."]);
  addVillager(28, 63, 'soldier', ["Halt — ah, just you, knight.","The roads grow thick with demons of late."]);
  addVillager(16, 60, 'soldier', ["We hold the heart of the realm here."]);
  addVillager(33, 61, 'smithF',  ["Mind the sparks, traveler!"]);

  // ════════════════════════════════════════════════════════════════
  //  COAST ROAD (rows ~73..82) — Ironhold south gate down to Saltmere.
  //  Drier, scrubbier than Meadow Road as it nears the sea.
  // ════════════════════════════════════════════════════════════════
  let cx=19;
  for(let y=73;y<=82;y++){
    if(y%4===0) cx += (y%8===0?1:-1)*2;
    cx=Math.max(12,Math.min(26,cx));
    g[y][cx]=2; g[y][cx+1]=2;
  }
  for(let y=82;y<=84;y++){ g[y][19]=2; g[y][20]=2; }   // funnel to Saltmere north gate
  // coastal scrub & rocks flanking the road (bushes + a couple trees)
  blob(g, 9, 76, 4, 7); blob(g, 30, 78, 4, 7); g[75][11]=15; g[79][28]=15; g[77][8]=1; g[80][31]=1;
  // reserved coastal nook for future content
  rect(g, 5, 79, 7, 81, 18); g[80][5]=16; signs['5,80']='Sea caves nearby?\n(nothing here yet)';
  // soft-gate demon zone on the coast road (a bit tougher)
  encounterZones.push({ x0:7, y0:74, x1:32, y1:83, level:5 });

  // ════════════════════════════════════════════════════════════════
  //  FOREST PATH (branches EAST off the Coast Road ~row 76) → Thornwood.
  //  Dense woods: lots of trees (walls) with a winding walkable trail.
  // ════════════════════════════════════════════════════════════════
  // a signpost at the fork where the trail leaves the coast road
  g[76][27]=16; signs['27,76']='← Saltmere (south)\nThornwood (east) →';
  // fill the eastern region with forest grass + dense trees, then carve a trail
  rect(g, 37, 68, 73, 92, 7);                 // forest floor (walkable forest grass)
  // scatter dense trees (walls) only in the WILD strip between trail head and town (cols 38-45)
  for(let i=0;i<70;i++){ const tx=38+Math.floor(Math.random()*7), ty=70+Math.floor(Math.random()*20);
    if((tx+ty*3)%5!==0) g[ty][tx]=1; }
  // connector from the coast road eastward to the trail head (rows around 76)
  for(let x=17;x<=27;x++){ g[76][x]=2; g[77][x]=2; }
  // winding TRAIL east from the coast road (col 27, row 76) to Thornwood's west gate (col 45, row 79)
  for(let x=27; x<=45; x++){
    const yy = 77 + Math.round(Math.sin((x-27)*0.4)*3);   // gentle S-curve, drifting toward row 79
    for(let c=-1;c<=1;c++){ const ty=yy+c; if(g[ty]&&g[ty][x]!==undefined && g[ty][x]!==14 && g[ty][x]!==3) g[ty][x]=2; }
  }
  // make sure the trail's east end lines up with the gate rows 79-80
  for(let x=42;x<=45;x++){ g[79][x]=2; g[80][x]=2; }
  // reserved forest glade for future content (hidden grove)
  rect(g, 40, 85, 43, 88, 18); g[88][40]=16; signs['40,88']='A quiet glade...\n(nothing here yet)';
  // soft-gate forest demons (in the wild strip before town)
  encounterZones.push({ x0:37, y0:70, x1:45, y1:90, level:6 });

  // ════════════════════════════════════════════════════════════════
  //  THORNWOOD (cols ~46..71, rows ~70..90) — the deep FOREST town.
  //  Roomier layout: buildings spread around a broad central clearing
  //  with the GREAT ANCIENT TREE; woodcutters & hunters in greens.
  // ════════════════════════════════════════════════════════════════
  rect(g, 46, 70, 71, 90, 7);                 // forest-floor town ground (big)
  // log palisade walls with a WEST gate (from the forest trail)
  for(let x=45;x<=72;x++){ g[69][x]=14; g[91]&&(g[91][x]=14); }
  for(let y=69;y<=91;y++){ g[y][45]=14; g[y][72]=14; }
  g[79][45]=8; g[80][45]=8;                    // WEST gate <- forest trail
  g[91][57]=8; g[91][58]=8;                    // SOUTH gate -> Ash Road to Ashfield
  rect(g,43,79,45,80,2);
  // broad clearing of trodden earth in the middle (paths) with room to breathe
  rect(g, 52, 76, 65, 84, 2);
  // connecting lanes from the gate and out to the buildings
  rect(g, 46, 79, 52, 80, 2);                  // gate -> central clearing
  rect(g, 50, 73, 51, 84, 2);                  // west lane
  rect(g, 66, 73, 67, 86, 2);                  // east lane
  rect(g, 52, 86, 65, 87, 2);                  // south lane
  // welcome sign by the gate
  g[81][46]=16; signs['46,81']='THORNWOOD\nWhere the old trees watch';
  // scattered stumps & bushes around the edges
  g[71][48]=15; g[89][69]=15; g[72][69]=15; g[88][48]=15;

  // ───────── buildings of Thornwood (spread to the perimeter) ─────────
  buildings.push({ id:'tw_chapel', name:'Thornwood Chapel',  style:'chapel', x:56, y:70, w:6, h:6, door:{x:58,y:76}, interior:'tw_chapel' });
  buildings.push({ id:'tw_shop',   name:'Woodcutter\'s Trade',style:'shop',  x:47, y:72, w:5, h:4, door:{x:49,y:76}, interior:'tw_shop' });
  buildings.push({ id:'tw_inn',    name:'The Hollow Log Inn', style:'inn',    x:66, y:72, w:5, h:4, door:{x:68,y:76}, interior:'tw_inn' });
  buildings.push({ id:'tw_home1',  name:'Hunter\'s Lodge',    style:'cottage',x:47, y:85, w:5, h:4, door:{x:49,y:89}, interior:'tw_home1' });
  buildings.push({ id:'tw_home2',  name:'Forester\'s Hut',    style:'house',  x:67, y:85, w:4, h:3, door:{x:68,y:88}, interior:'tw_home2' });
  buildings.forEach(b=>stampBuilding(g,b));
  // walkable approaches in front of Thornwood doors
  [[58,77],[49,77],[68,77],[49,90],[68,89]].forEach(([dx,dy])=>{ if(g[dy]&&g[dy][dx]!==undefined && g[dy][dx]!==3) g[dy][dx]=2; });
  // short connector lanes so each building links to the clearing
  rect(g,49,76,49,79,2); rect(g,58,76,58,79,2); rect(g,68,76,68,79,2);
  rect(g,49,84,49,89,2); rect(g,68,84,68,88,2);

  // ───────── Thornwood decorations (spaced out) ─────────
  addDecor(58, 80, 'greatTree', true, 3);     // CENTERPIECE: great ancient tree (3x3), centered in clearing
  addDecor(54, 78, 'logpile', true);          // stacked logs
  addDecor(63, 82, 'logpile', true);
  addDecor(62, 78, 'campfire', true);         // hunters' campfire
  addDecor(53, 83, 'stump', true);            // big cut stumps (seats)
  addDecor(64, 76, 'stump', true);
  addDecor(70, 80, 'mushroom', true);         // forest mushrooms near the edges
  addDecor(47, 80, 'mushroom', true);

  // ───────── Thornwood villagers (woodcutters & hunters) ─────────
  addVillager(54, 81, 'hunter',   ["The old trees remember everything, they say.","Keep to the trail — the deep woods aren't safe."]);
  addVillager(63, 80, 'woodcutter',["Timber's the lifeblood of Thornwood."]);
  addVillager(60, 83, 'hunterF',  ["Saw a demon prowling the treeline. Be careful."]);
  addVillager(56, 78, 'woodcutter',["Need arrows? The trade post has the finest."]);

  // ════════════════════════════════════════════════════════════════
  //  ASH ROAD (south from Thornwood ~row 91) → Ashfield.
  //  Forest gives way to scorched earth, ash, and lava cracks.
  // ════════════════════════════════════════════════════════════════
  rect(g, 46, 92, 84, 119, 25);                // ashen ground corridor (widened east)
  // the scorched road: starts at Thornwood's south gate (col 57), drifts east to Ashfield's gate (col 64)
  for(let y=92; y<=119; y++){
    const xx = Math.round(57 + (64-57)*((y-92)/27) + Math.sin((y-92)*0.3)*2);
    for(let c=0;c<2;c++){ if(g[y]&&g[y][xx+c]!==undefined) g[y][xx+c]=27; }  // cracked-earth path
  }
  for(let x=57;x<=58;x++){ g[92][x]=27; g[93][x]=27; }      // meet Thornwood south gate
  for(let x=63;x<=65;x++){ g[118][x]=27; g[119]&&(g[119][x]=g[119][x]===5?8:27); } // meet Ashfield gate
  // lava cracks + charred rock outcrops flanking the road
  for(let i=0;i<34;i++){ const tx=47+Math.floor(Math.random()*36), ty=94+Math.floor(Math.random()*24);
    if((tx+ty)%4===0 && g[ty] && g[ty][tx]===25) g[ty][tx]=(i%2?1:26); }  // 1=charred rock, 26=lava
  // reserved volcanic cave nook
  rect(g, 48, 100, 50, 103, 18); g[103][48]=16; signs['48,103']='A smoking fissure...\n(nothing here yet)';
  // soft-gate volcanic demons (very tough)
  encounterZones.push({ x0:46, y0:93, x1:83, y1:118, level:10 });

  // ════════════════════════════════════════════════════════════════
  //  ASHFIELD (cols ~46..84, rows ~119..148) — the volcanic RUINS town.
  //  Roomy layout: buildings spread to the edges around a broad ruined
  //  plaza, with the lava channel + lava-altar centerpiece in open space.
  // ════════════════════════════════════════════════════════════════
  rect(g, 46, 120, 84, 147, 27);               // cracked-earth town ground (big)
  // broken stone walls (ruins) with a NORTH gate (from the ash road)
  for(let x=45;x<=85;x++){ g[119][x]=5; g[148]&&(g[148][x]=5); }
  for(let y=119;y<=148;y++){ g[y][45]=5; g[y][85]=5; }
  g[119][64]=8; g[119][65]=8;                   // NORTH gate <- ash road
  g[132][85]=8; g[133][85]=8;                   // EAST gate -> King's Road to Stormgate
  rect(g,64,118,65,119,27);
  // broad ruined plaza (broken flagstone = cobble)
  rect(g, 52, 124, 78, 142, 6);
  rect(g, 64, 119, 65, 124, 27);                // gate corridor down into plaza
  // a glowing LAVA CHANNEL crossing the plaza (impassable) with a stone bridge gap
  rect(g, 56, 133, 74, 133, 26); g[133][64]=6; g[133][65]=6;   // bridge at center
  // welcome sign
  g[121][47]=16; signs['47,121']='ASHFIELD\nWhat the fire spared, faith keeps';

  // ───────── buildings of Ashfield (spread to the edges) ─────────
  buildings.push({ id:'af_chapel', name:'Ashfield Chapel',   style:'chapel', x:68, y:120, w:6, h:6, door:{x:70,y:126}, interior:'af_chapel' });
  buildings.push({ id:'af_shop',   name:'Emberforge Trade',  style:'shop',   x:47, y:122, w:5, h:4, door:{x:49,y:126}, interior:'af_shop' });
  buildings.push({ id:'af_inn',    name:'The Cinder Rest',   style:'inn',    x:78, y:123, w:5, h:4, door:{x:80,y:127}, interior:'af_inn' });
  buildings.push({ id:'af_home1',  name:'Survivor\'s Shelter',style:'cottage',x:47, y:141, w:5, h:4, door:{x:49,y:141}, interior:'af_home1' });
  buildings.push({ id:'af_home2',  name:'Ashen Dwelling',    style:'house',  x:79, y:142, w:4, h:3, door:{x:80,y:142}, interior:'af_home2' });
  buildings.forEach(b=>stampBuilding(g,b));
  // carve the gate corridor THROUGH to the plaza AFTER stamping
  rect(g, 64, 119, 65, 125, 27);
  // walkable approaches in front of each door (avoid lava)
  [[70,127],[49,127],[80,128],[49,140],[80,141]].forEach(([dx,dy])=>{ if(g[dy]&&g[dy][dx]!==undefined && g[dy][dx]!==26) g[dy][dx]=6; });
  // lanes linking edge buildings to the plaza
  rect(g,49,126,52,127,27); rect(g,80,127,80,131,27); rect(g,49,141,52,141,6); rect(g,78,142,80,142,6);
  rect(g,49,127,49,132,27); rect(g,70,127,70,131,6);

  // ───────── Ashfield decorations (volcanic ruins theme, spaced out) ─────────
  addDecor(64, 129, 'lavaAltar', true, 2);     // CENTERPIECE: lava-forge altar (above the channel)
  addDecor(56, 126, 'brokenPillar', true);     // toppled ruin pillars
  addDecor(73, 127, 'brokenPillar', true);
  addDecor(58, 138, 'emberPit', true);         // glowing ember pits (below the channel)
  addDecor(71, 138, 'emberPit', true);
  addDecor(54, 131, 'charredTree', true);      // burnt skeletal trees
  addDecor(76, 137, 'charredTree', true);
  addDecor(67, 124, 'banner2', true);          // a scorched banner

  // ───────── Ashfield villagers (soot-streaked survivors) ─────────
  addVillager(60, 128, 'survivor', ["The mountain burns, but we endure.","Faith is what the fire could not take."]);
  addVillager(69, 129, 'embersmith',["I forge with the mountain's own fire."]);
  addVillager(58, 130, 'survivorF',["We rebuild, stone by blackened stone."]);
  addVillager(70, 137, 'survivor', ["Demons crawl from the deep fissures. Beware."]);

  // ════════════════════════════════════════════════════════════════
  //  KING'S ROAD (east from Ashfield ~row 132) → Stormgate, the capital.
  //  A grand paved approach leaving the volcanic ruins for green land again.
  // ════════════════════════════════════════════════════════════════
  rect(g, 86, 122, 100, 143, 0);               // green land returns east of the ruins
  for(let x=86;x<=100;x++){ g[132][x]=2; g[133][x]=2; }   // the king's road (paved)
  rect(g, 86, 132, 88, 133, 2);                // meet Ashfield east gate
  // lined with banners (decor) + a couple trees
  g[128][90]=1; g[137][95]=1; g[126][97]=15;
  // soft-gate demons on the approach (capital is well-defended; moderate)
  encounterZones.push({ x0:86, y0:123, x1:99, y1:142, level:9 });

  // ════════════════════════════════════════════════════════════════
  //  STORMGATE (cols ~100..136, rows ~118..148) — the GRAND CAPITAL.
  //  Multi-tier walled city: OUTER CITY → INNER WALL → INNER CITY → KEEP.
  //  Reserved blue plots (tile 18) mark future minigame/activity areas.
  // ════════════════════════════════════════════════════════════════
  const SX=100, SY=118;                         // city origin (top-left)
  // ----- OUTER WALL & city ground -----
  rect(g, SX, SY, SX+36, SY+30, 5);             // fill as wall, then carve interior
  rect(g, SX+1, SY+1, SX+35, SY+29, 6);         // outer city cobble
  // WEST main gate (from the king's road) into the outer city
  g[132][SX]=8; g[133][SX]=8; rect(g, SX-1, 132, SX, 133, 2);
  // NORTH gate (outer wall) -> Shadow Road to Shadowmere
  g[SY][SX+30]=8; g[SY][SX+31]=8; rect(g, SX+30, SY+1, SX+31, SY+2, 6);
  // grand avenue west->east across the outer city
  rect(g, SX+1, 132, SX+35, 133, 2);
  // ----- INNER WALL around the upper-central city -----
  rect(g, SX+8, SY+3, SX+28, SY+18, 5);         // inner wall ring
  rect(g, SX+9, SY+4, SX+27, SY+17, 6);         // inner city floor
  // inner gate (south side) connecting to the avenue
  g[132][SX+18]=8; rect(g, SX+17, SY+14, SX+19, SY+18, 6);
  rect(g, SX+18, 132, SX+18, SY+18, 2);         // short link from avenue up to inner gate
  // ----- KEEP (innermost, top-center) -----
  rect(g, SX+15, SY, SX+22, SY+5, 5);           // keep base block (building added below)
  // ----- reserved ACTIVITY PLOTS (tile 18, walkable, clearly marked) -----
  rect(g, SX+3, SY+22, SX+8, SY+26, 18);   g[SY+24][SX+3]=16; signs[(SX+3)+','+(SY+24)]='MARKET GAMES\n(minigame plot — later)';
  rect(g, SX+24, SY+6, SX+27, SY+10, 18);  g[SY+6][SX+24]=16; signs[(SX+24)+','+(SY+6)]='ARENA PLOT\n(minigame plot — later)';
  // welcome sign at the main gate
  g[131][SX+1]=16; signs[(SX+1)+',131']='STORMGATE\nCapital of the realm';
  g[SY+13][SX+18]=16; signs[(SX+18)+','+(SY+13)]='— INNER CITY —\nCathedral & Keep beyond';

  // ───────── buildings of Stormgate (grand city set) ─────────
  buildings.push({ id:'sg_keep',     name:'Stormgate Keep',      style:'keep',   x:SX+15, y:SY,    w:6, h:5, door:{x:SX+17, y:SY+5},  interior:'sg_keep' });
  buildings.push({ id:'sg_cathedral',name:'Stormgate Cathedral', style:'chapel', x:SX+11, y:SY+6,  w:6, h:7, door:{x:SX+13, y:SY+13}, interior:'sg_cathedral' });
  buildings.push({ id:'sg_inn',      name:'The Gilded Gate Inn', style:'inn',    x:SX+29, y:SY+20, w:5, h:4, door:{x:SX+31, y:SY+24}, interior:'sg_inn' });
  buildings.push({ id:'sg_shop',     name:'Capital Market Hall', style:'shop',   x:SX+3,  y:SY+15, w:6, h:4, door:{x:SX+5,  y:SY+19}, interior:'sg_shop' });
  buildings.push({ id:'sg_home1',    name:'Townhouse',           style:'house',  x:SX+30, y:SY+9, w:4, h:3, door:{x:SX+31, y:SY+12}, interior:'sg_home1' });
  buildings.push({ id:'sg_guard',    name:'Guard Barracks',      style:'keep',   x:SX+3,  y:SY+8,  w:4, h:4, door:{x:SX+4,  y:SY+12}, interior:'sg_guard' });
  buildings.forEach(b=>stampBuilding(g,b));
  // carve approaches & corridors AFTER stamping
  rect(g, SX+15, SY, SX+22, SY, 5); g[SY+5][SX+17]=9; rect(g, SX+16, SY+5, SX+18, SY+6, 6); // keep door into inner city
  [[SX+17,SY+6],[SX+13,SY+14],[SX+31,SY+25],[SX+5,SY+20],[SX+31,SY+16],[SX+4,SY+13]].forEach(([dx,dy])=>{ if(g[dy]&&g[dy][dx]!==undefined && g[dy][dx]!==5) g[dy][dx]=6; });

  // ───────── Stormgate decorations (grand city) ─────────
  addDecor(SX+18, SY+9, 'fountain', true, 2);   // grand fountain in the inner city
  addDecor(SX+12, 131, 'banner2', true); addDecor(SX+24, 131, 'banner2', true);  // avenue banners
  addDecor(SX+6, SY+20, 'lantern', true); addDecor(SX+32, SY+18, 'lantern', true);
  addDecor(SX+10, SY+5, 'lantern', true); addDecor(SX+26, SY+5, 'lantern', true);

  // ───────── Stormgate villagers (citizens, guards, nobles) ─────────
  addVillager(SX+20, 132, 'soldier',  ["Welcome to the capital, knight.","The King watches all who enter."]);
  addVillager(SX+22, SY+11,'merchantD',["Finest goods in all the realm, here in the capital!"]);
  addVillager(SX+25, SY+22,'peasant',  ["So many people... the capital never sleeps."]);
  addVillager(SX+4, 132,  'soldier',  ["Move along, citizen. Keep the avenue clear."]);

  // ════════════════════════════════════════════════════════════════
  //  SHADOW ROAD (north from Stormgate ~col 130) → Shadowmere.
  //  Green land fades into murky BOG, mist, and dead trees.
  // ════════════════════════════════════════════════════════════════
  rect(g, 118, 60, 139, 117, 28);              // bog ground corridor (north of Stormgate)
  // the misty trail north to Shadowmere's south gate
  for(let y=60; y<=117; y++){
    const xx = 130 + Math.round(Math.sin((y-60)*0.25)*3);
    for(let c=0;c<2;c++){ if(g[y]&&g[y][xx+c]!==undefined) g[y][xx+c]=2; }
  }
  for(let x=130;x<=131;x++){ g[117][x]=2; }    // meet Stormgate north gate
  // swamp pools (wall) + dead trees + mist patches flanking the trail
  for(let i=0;i<40;i++){ const tx=119+Math.floor(Math.random()*20), ty=62+Math.floor(Math.random()*54);
    if(g[ty] && g[ty][tx]===28){ const r3=(tx+ty)%5; if(r3===0)g[ty][tx]=29; else if(r3===1)g[ty][tx]=1; else if(r3===2)g[ty][tx]=30; } }
  // reserved haunted nook
  rect(g, 120, 70, 122, 73, 18); g[73][120]=16; signs['120,73']='Whispers in the mist...\n(nothing here yet)';
  // soft-gate shadow demons (very tough)
  encounterZones.push({ x0:118, y0:61, x1:138, y1:116, level:11 });

  // ════════════════════════════════════════════════════════════════
  //  SHADOWMERE (cols ~116..139, rows ~38..59) — the misty SHADOW town.
