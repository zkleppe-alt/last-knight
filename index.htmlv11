    const severs=(x,y)=>{
      const before=openCells();
      const was=g[y][x]; g[y][x]=T_CANDLE;
      const after=openCells();
      g[y][x]=was;
      for(const k of before){ if(k===x+','+y) continue; if(!after.has(k)) return true; }
      return false;
    };
    const take=(pool)=>{
      for(let n=0;n<pool.length;n++){
        const j=Math.floor(rnd()*pool.length);
        const [x,y]=pool[j];
        pool.splice(j,1); n--;
        if(!placed.every(p=>Math.abs(p[0]-x)+Math.abs(p[1]-y)>=6)) { if(!pool.length) break; continue; }
        if(severs(x,y)) { if(!pool.length) break; continue; }
        return [x,y];
      }
      return null;
    };
    for(let i=0;i<nC;i++){
      const pool = (i%2===0 ? (hard.length?hard:easy) : (easy.length?easy:hard));
