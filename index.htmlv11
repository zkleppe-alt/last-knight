  addVillager(69, 106, 'monk',   ["Peace be upon your journey, knight.","Soak in the spring — it will mend your wounds."]);
  addVillager(75, 107, 'monkF',  ["The cold teaches patience. The spring teaches mercy."]);
  addVillager(67, 105, 'monk',   ["We tend the eternal warmth beneath the ice."]);
  addVillager(77, 106, 'pilgrim',["I climbed all this way just to rest in those waters."]);




  // ════════════════════════════════════════════════════════════════
  //  IRONHOLD (rows ~50..72) — the iron & stone fortress town (hub)
