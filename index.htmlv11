    // a verse-stone is SOLID, so the same severing check the lampstands use
    const open=()=>{ const seen=new Set([ex+','+ey]), st=[[ex,ey]];
      while(st.length){ const [x,y]=st.pop();
        for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nx=x+dx, ny=y+dy, k=nx+','+ny;
          if(nx<1||ny<1||nx>=MAZE_W-1||ny>=MAZE_H-1||seen.has(k)) continue;
