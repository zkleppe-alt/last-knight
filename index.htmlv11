        if(nx<1||ny<1||nx>=MAZE_W-1||ny>=MAZE_H-1||seen.has(k)) continue;
        const t=g[ny][nx];
        if(t===1||t===T_SEAL||t===T_CANDLE||t===T_TABLET||t===T_VERSE||t===T_FALSEWALL) continue;
