//   collar = offense · charm = guard. Bought once, equipped from the Pet tab.
const PET_GEAR = {
  hearthCollar:{ town:0, slot:'collar', name:'Hearth Collar',      emoji:'🦴', price:60,  note:'pet +2 atk · stitched by Hearthvale weavers',            bonus:{atk:2} },
  thornCharm:  { town:3, slot:'charm',  name:'Thornwood Charm',    emoji:'🌿', price:160, note:'pet +3 def +6 hp · cut from the deep wood',              bonus:{def:3,maxHp:6} },
  duneCollar:  { town:4, slot:'collar', name:'Dune-Runner Collar', emoji:'🏜', price:260, note:'pet +5 atk +3% crit · Dusthaven leather',                bonus:{atk:5,crit:0.03} },
  crystalCharm:{ town:5, slot:'charm',  name:'Crystal Charm',      emoji:'💎', price:380, note:'pet +6 def +10 hp · Crystalpeak-cut',                    bonus:{def:6,maxHp:10} },
  emberCollar: { town:6, slot:'collar', name:'Ember Collar',       emoji:'🔥', price:520, note:'pet +8 atk +5% crit · forged in Ashfield',               bonus:{atk:8,crit:0.05} },
  royalCharm:  { town:7, slot:'charm',  name:'Royal Navy Charm',   emoji:'⚓', price:700, note:'pet +8 def +18 hp +4% crit · the Admiralty\'s finest',   bonus:{def:8,maxHp:18,crit:0.04} },
  shadowCollar:{ town:8, slot:'collar', name:'Shadowveil Collar',  emoji:'🌙', price:900, note:'pet +12 atk +8% crit · woven from dusk itself',          bonus:{atk:12,crit:0.08} },
};
const SHOP_TOWN = { shop:0, tw_shop:3, dh_shop:4, cp_shop:5, af_shop:6, sg_shop:7, sh_shop:8 };
function shopItem(key){ return SHOP_ITEMS[key] || PET_GEAR[key]; }
let shopMode = null;                // { items:[keys], idx } when a shop menu is open
// ── 🌱 SEED PICKER ── opens when you press Ⓐ on an empty plot. Deliberately
//    the same idiom as the shop: Ⓐ opens, d-pad cycles, Ⓐ again commits, walking
//    away cancels. It costs one extra press and buys the moment where the
//    parable can actually be read — the choice of seed is the teaching.
let seedMode = null;                // { items:[cropKeys], idx, x, y } while choosing a seed
let lastSeed = 'wheat';             // the picker reopens on your last sowing
function ownedSeeds(){ return CROP_ORDER.filter(k=>(inventory[CROPS[k].seed]||0)>0); }

// place a decoration; if solid, stamp wall tiles under its footprint (w x w)
function addDecor(x,y,kind,solid,w){ w=w||1; decorations.push({x,y,kind,w});
  if(solid) for(let dy=0;dy<w;dy++)for(let dx=0;dx<w;dx++){ if(WORLD_READY) WORLD[y+dy][x+dx]=5; else pendingSolid.push([x+dx,y+dy]); } }
// place a wandering villager who mills around their start point
function addVillager(x,y,outfit,lines){ villagers.push({ x:x*TILE, y:y*TILE, hx:x, hy:y, outfit, lines:lines||["..."],
  dir:'down', t:Math.random()*120, moving:false, frame:0, ftick:0, wait:0, tx:x, ty:y }); }
let WORLD_READY=false; const pendingSolid=[];


let WORLD = (function(){
  const g = makeGrid(WORLD_W, WORLD_H, 0);   // base meadow

  // ───────── HEARTHVALE (rows ~2..20) — the complete model town ─────────
  // cozy walled hometown: cobble square, central FOUNTAIN, full building set,
  // themed harvest/hearth decorations, and villagers in warm peasant clothing.
  rect(g, 4, 2, 35, 20, 0);            // village ground (grass)
  for(let x=3;x<=36;x++){ g[1][x]=14; }              // north fence
  for(let y=1;y<=20;y++){ g[y][3]=14; g[y][36]=14; } // side fences
  for(let x=3;x<=36;x++){ if(x<18||x>20) g[21][x]=14; } // south fence w/ gate gap
  g[21][18]=8; g[21][19]=8; g[21][20]=8;             // south GATE -> road
  // cobble town square (central plaza)
  rect(g, 13, 8, 26, 16, 6);
  // paths radiating to each building door
  rect(g, 9, 9, 13, 9, 6); rect(g, 26, 9, 31, 9, 6);     // to cottage / chapel
  rect(g, 9, 15, 13, 15, 6); rect(g, 26, 15, 31, 15, 6); // to shop / inn
  rect(g, 19, 16, 20, 21, 6);                            // to south gate
  // a couple trees & bushes around the edges for life
  g[4][7]=1; g[5][32]=1; g[18][6]=1; g[17][33]=1; g[3][14]=1; g[3][26]=1;
  g[6][11]=15; g[14][29]=15; g[18][24]=15; g[7][28]=15;
  // flowers scattered
  g[6][17]=4; g[8][24]=4; g[16][12]=4; g[12][30]=4; g[5][20]=4; g[19][15]=4;
  // welcome sign by the gate
  g[18][21]=16; signs['21,18']='HEARTHVALE\nPop. small, faith large';

  // ───────── buildings of Hearthvale (faked-3D, full set) ─────────
  buildings.push({ id:'tobias', name:"Tobias's Cottage", style:'cottage', x:7, y:4, w:5, h:4,
    door:{x:9,y:8}, interior:'tobias' });
  buildings.push({ id:'chapel', name:'Hearthvale Chapel', style:'chapel', x:28, y:3, w:6, h:6,
    door:{x:30,y:9}, interior:'chapel' });
  buildings.push({ id:'shop', name:'General Store', style:'shop', x:7, y:13, w:5, h:4,
    door:{x:9,y:17}, interior:'shop' });
  buildings.push({ id:'inn', name:'Hearth & Home Inn', style:'inn', x:28, y:14, w:5, h:4,
    door:{x:30,y:18}, interior:'inn' });
  // a couple of villager HOMES (enterable)
  buildings.push({ id:'home1', name:"Mira's Home", style:'house', x:14, y:3, w:4, h:3,
    door:{x:15,y:6}, interior:'home1' });
  buildings.push({ id:'home2', name:"Old Bram's Home", style:'house', x:22, y:3, w:4, h:3,
    door:{x:23,y:6}, interior:'home2' });
  buildings.forEach(b=>stampBuilding(g,b));

  // ───────── themed decorations (drawn on top; some solid) ─────────
  // CENTERPIECE: village fountain in the middle of the square
  addDecor(19, 11, 'fountain', true, 2);   // 2x2 solid fountain
  // hearth/harvest flavor
  addDecor(15, 9, 'planter', true);        // flower planter
  addDecor(24, 9, 'planter', true);
  addDecor(14, 15, 'marketStall', true, 2);// market stall (2 wide)
  addDecor(25, 14, 'lantern', true);       // hanging lantern post
  addDecor(12, 12, 'lantern', true);
  addDecor(23, 16, 'haycart', true, 2);    // hay cart
  addDecor(17, 7, 'barrel', true);
  addDecor(22, 7, 'barrel', true);

  // ───────── villagers walking Hearthvale (themed peasant clothing) ─────────
  addVillager(16, 11, 'peasant', ["Blessed morning to you!","The harvest was kind this year."]);
  addVillager(23, 12, 'peasantF', ["Careful past the gate — demons roam the road.","Tobias speaks well of you."]);
  addVillager(20, 14, 'farmer', ["These old bones remember your father, knight."]);
  addVillager(18, 9,  'child', ["Are you really gonna fight the Demon King?!"]);

  // ───────── MEADOW ROAD (rows ~19..47): winding path + filler forest ─────────
  // a winding dirt road south from the gate; padded with forest & reserved zones.
  let px=19;
  for(let y=22;y<=46;y++){
    if(y%5===0) px += (y%10===0?1:-1)*2;
    px=Math.max(10,Math.min(28,px));
    g[y][px]=2; g[y][px+1]=2;
  }
  // funnel the road back to center (col 19-20) to meet Ironhold's north gate
  for(let y=47;y<=49;y++){ const c=Math.round(px + (19-px)*((y-46)/3)); g[y][c]=2; g[y][c+1]=2; g[y][19]=2; g[y][20]=2; }
  // forest filler flanking the road (themed area; trees are walls, grass walkable)
  blob(g, 8, 26, 5, 7); blob(g, 31, 24, 5, 7); blob(g, 9, 40, 5, 7); blob(g, 30, 42, 5, 7);
  blob(g, 8, 26, 2, 1); blob(g, 31, 24, 2, 1); blob(g, 9, 40, 2, 1); blob(g, 30, 42, 2, 1);
  // a pond + flowers for variety
  blob(g, 25, 30, 2, 3); blob(g, 14, 35, 1, 4); blob(g, 22, 44, 1, 4);
  // RESERVED empty pockets (walkable tile 18) for future caves/chests/bases
  rect(g, 4, 32, 6, 34, 18);     // reserved nook (west)
  g[33][5]=16; signs['5,33']='A worn trail leads off...\n(nothing here yet)';
  g[35][34]=16; signs['34,35']='← Ironhold (south)\nDusthaven (east) →';

  // soft-gate demon zone along the road (scales danger; skippable but risky)
  encounterZones.push({ x0:6, y0:23, x1:33, y1:46, level:3 });

  // ════════════════════════════════════════════════════════════════
  //  THE HOMESTEAD (cols ~32..52, rows ~22..42) — a peaceful family FARM.
  //  Branches east off the Meadow Road. The player's true home: farmhouse
  //  with the family inside, crop plots, a fishing pond, and a farm stand.
  //  (Farming/fishing/selling activities get wired up next session.)
  // ════════════════════════════════════════════════════════════════
  // a quiet lane east from the Meadow Road (col 18, row 28) to the farm
  for(let x=18;x<=33;x++){ g[28][x]=2; g[29][x]=2; }
  g[27][33]=16; signs['33,27']='The Homestead →\nA quiet family farm';
  // farm meadow ground (grass) with a low fence enclosing it
  rect(g, 33, 22, 52, 42, 0);
  for(let x=32;x<=53;x++){ g[21][x]=14; g[43]&&(g[43][x]=14); }   // top & bottom fence
  for(let y=21;y<=43;y++){ g[y][32]=14; g[y][53]=14; }            // side fences
  g[28][32]=8; g[29][32]=8;                                        // WEST gate <- lane
  rect(g, 35, 28, 36, 29, 2);
  // soft dirt paths through the farm
  rect(g, 35, 28, 50, 29, 2); rect(g, 42, 24, 43, 40, 2);
  // ── CROP PLOTS (tilled soil, tile 31 — plantable next session) ──
  rect(g, 34, 31, 40, 35, 31);    // west field
  rect(g, 45, 31, 51, 35, 31);    // east field
  g[36][34]=16; signs['34,36']='CROP FIELD\n(plant & harvest — coming soon!)';
  // ── FISHING POND (water; a calm spot to fish) ──
  rect(g, 45, 37, 50, 41, 3);     // the pond (water = not walkable, you fish from the edge)
  g[37][45]=16; signs['45,37']='FISHING POND\n(cast a line — coming soon!)';
  // a few homey touches
  g[24][35]=4; g[25][49]=4; g[40][35]=15; g[23][48]=1; g[41][33]=1;

  // ───────── buildings of the Homestead ─────────
  buildings.push({ id:'home_house', name:'The Family Farmhouse', style:'cottage', x:37, y:23, w:7, h:5, door:{x:40,y:28}, interior:'home_house' });
  buildings.push({ id:'home_barn',  name:'The Barn',             style:'house',   x:46, y:23, w:5, h:4, door:{x:48,y:27}, interior:'home_barn' });
  buildings.forEach(b=>stampBuilding(g,b));
  [[40,29],[48,28]].forEach(([dx,dy])=>{ if(g[dy]&&g[dy][dx]!==undefined && g[dy][dx]!==3) g[dy][dx]=2; });

  // ───────── Homestead decorations (farm life) ──────────
  addDecor(48, 39, 'farmStand', true, 2);     // FARM STAND (sell crops — coming soon)
  g[38][48]=16; // (sign tile near stand handled by stand itself)
  addDecor(35, 30, 'scarecrow', true);        // scarecrow watching the west field
  addDecor(50, 30, 'scarecrow', true);
  addDecor(38, 38, 'haystack', true, 2);      // hay bales
  addDecor(35, 25, 'planter', true); addDecor(49, 24, 'planter', true);
  addDecor(44, 36, 'bucket', true);           // a bucket by the pond

  // ───────── Homestead villager (a farmhand outside) ──────────
  addVillager(43, 33, 'farmer', ["Welcome home! The fields have missed you.","Face a tilled plot and press Ⓐ to plant.","Give it time, then come back to harvest!"]);

  // ───────── Old Mule — placed AFTER relocation, beside the barn (see homestead fix-up) ──────────


  // ════════════════════════════════════════════════════════════════
  //  DESERT ROAD (branches EAST off Meadow Road ~row 35) → Dusthaven.
  //  Sandy, sun-baked, sparse — cacti & dunes instead of forest.
  // ════════════════════════════════════════════════════════════════
  // desert ground spreads east (sand tile 19), getting drier from the road
  rect(g, 34, 28, 73, 52, 19);
  // connector from Meadow Road east to the desert
  for(let x=20;x<=34;x++){ g[35][x]=2; g[36][x]=2; }
  // winding sandy trail east to Dusthaven's west gate (col 47, row 40)
  for(let x=34; x<=47; x++){
    const yy = 36 + Math.round(Math.sin((x-34)*0.4)*3) + Math.floor((x-34)/4); // drifts down toward row 40
    for(let c=-1;c<=1;c++){ const ty=yy+c; if(g[ty]&&g[ty][x]!==undefined && g[ty][x]!==3) g[ty][x]=2; }
  }
  for(let x=44;x<=47;x++){ g[40][x]=2; g[41][x]=2; }
  // scattered cacti & rocks in the desert (walls)
  for(let i=0;i<24;i++){ const tx=35+Math.floor(Math.random()*11), ty=29+Math.floor(Math.random()*22);
    if((tx+ty)%3===0 && g[ty] && g[ty][tx]===19) g[ty][tx]=1; }   // reuse tree-tile as cactus-wall (rendered as cactus in desert)
  // reserved desert ruin nook
  rect(g, 37, 47, 40, 50, 18); g[50][37]=16; signs['37,50']='Buried ruins?\n(nothing here yet)';
  // soft-gate desert demons
  encounterZones.push({ x0:34, y0:29, x1:46, y1:51, level:4 });

  // ════════════════════════════════════════════════════════════════
  //  DUSTHAVEN (cols ~48..71, rows ~30..50) — the desert OASIS town.
