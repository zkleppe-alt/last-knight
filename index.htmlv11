    { id:'devotion1', tier:1, name:'Comfort',       cost:1, desc:"+20% Healing",                 bonus:{healMult:0.20} },
    { id:'devotion2', tier:2, name:'Guardian Beast',cost:2, desc:"8% dmg reduce, +15 HP",        bonus:{dmgReduce:0.08,maxHp:15} },
    { id:'devotion3', tier:3, name:'Faithful Unto Death',cost:3, desc:"ULT: +50 HP, 12% reduce", bonus:{maxHp:50,dmgReduce:0.12} },
  ]},
};
function skillNode(id){ for(const b in SKILL_TREE){ const n=SKILL_TREE[b].nodes.find(z=>z.id===id); if(n) return n; } for(const b in PET_TREE){ const n=PET_TREE[b].nodes.find(z=>z.id===id); if(n) return n; } return null; }
// can the player buy this node? (enough points, prereq owned, not already owned)
function canBuySkill(id){ const n=skillNode(id); if(!n||player.skills[id]) return false;
  if(player.skillPoints < n.cost) return false;
  if(n.tier>0){ const branch=id.replace(/\d+$/,''); const prev=branch+(n.tier-1); if(!player.skills[prev]) return false; }
  return true; }
function buySkill(id){ if(!canBuySkill(id)) return false; const n=skillNode(id); player.skillPoints-=n.cost; player.skills[id]=true; recalcStats(); return true; }
// equip a weapon/armor the player owns; weapons set the free-roam swing type
function equipItem(id){ const e=EQUIP[id]; if(!e||!player.ownedGear[id]) return false;
  player.equip[e.slot]=id; if(e.slot==='weapon') player.weaponType=e.type||'light';
  recalcStats(); return true; }

// ════════════════════════════════════════════════════════════════
//  PAUSE MENU — Character / Skills / Items  (d-pad navigates, A selects)
// ════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════
//  SAVE / LOAD  (localStorage when available; export/import string fallback)
// ════════════════════════════════════════════════════════════════
const SAVE_KEY = 'klk_save_v1';        // legacy single-save key (auto-migrated to Slot 1)
const SLOTS = 3;
const slotKey = (n)=>'klk_save_slot'+n;
let activeSlot = 1;
try{ activeSlot = Math.min(SLOTS, Math.max(1, +localStorage.getItem('klk_active_slot')||1)); }catch(e){}
function setActiveSlot(n){ activeSlot=n; try{ localStorage.setItem('klk_active_slot', String(n)); }catch(e){} }
// one-time migration: an old single save becomes Slot 1
try{ const _old=localStorage.getItem(SAVE_KEY); if(_old && !localStorage.getItem(slotKey(1))) localStorage.setItem(slotKey(1), _old); }catch(e){}
function eraseSave(n){ try{ localStorage.removeItem(slotKey(n)); }catch(e){} }
function slotInfo(n){
  try{ const raw=localStorage.getItem(slotKey(n)); if(!raw) return null;
    const s=JSON.parse(raw);
    const towns=Object.keys(s.chapelProgress||{}).filter(k=>s.chapelProgress[k]).length;
    return { name:(s.player&&s.player.name)||'Knight', level:(s.player&&s.player.level)||1, towns, won:!!s.abaddonWon, playMs:s.playMs||0 };
  }catch(e){ return null; }
}
function buildSaveData(){
  return {
    v:1, t:Date.now(),
    player:{ x:player.x, y:player.y, dir:player.dir, hp:player.hp, level:player.level, xp:player.xp, xpNext:player.xpNext,
      baseMaxHp:player.baseMaxHp, baseAtk:player.baseAtk, baseDef:player.baseDef, baseCrit:player.baseCrit,
      skillPoints:player.skillPoints, skills:player.skills, equip:player.equip, ownedGear:player.ownedGear, weaponType:player.weaponType,
      name:player.name||'Knight', pet:player.pet||null, surfBest:player.surfBest||0, petGear:player.petGear||{}, barnPets:player.barnPets||[], raceBarding:!!player.raceBarding, boatInv:player.boatInv||null, hasLamp:!!player.hasLamp, championRobe:!!player.championRobe, mountSkin:player.mountSkin||null, mountSkinOwned:player.mountSkinOwned||{} },
    gold, inventory, quests, tutorial, chapelProgress, crops, secretsFound,
    raceRecordMs: (typeof raceRecordMs==='number'?raceRecordMs:60000),
    explored:[...explored], abaddonWon:!!abaddon.won,
    hunt:{ active:hunt.active, done:hunt.done, killed:hunt.killed, total:hunt.total, remaining:hunt.remaining.slice() },
    bounties:{ active:bounties.active.map(b=>Object.assign({},b)), complete:bounties.complete.map(c=>Object.assign({},c)), nextId:bounties.nextId,
      perTown:Object.assign({},bounties.perTown), pretenderUnlocked:bounties.pretenderUnlocked, pretenderDefeated:bounties.pretenderDefeated, portalsOpen:bounties.portalsOpen, madisonTaken:bounties.madisonTaken, madisonRescued:bounties.madisonRescued, matthewIntercept:bounties.matthewIntercept },
    portals: PORTALS.map(p=>({ id:p.id, unlocked:p.unlocked, cleared:p.cleared })),
    mistral: { wanderersDown:mistralProgress.wanderersDown, villages:JSON.parse(JSON.stringify(mistralProgress.villages)) },
    tabor: { hopeAll:!!taborProgress.hopeAll, bossDown:!!taborProgress.bossDown, summitCine:!!taborProgress.summitCine, thawed:!!taborProgress.thawed, rescues:JSON.parse(JSON.stringify(taborProgress.rescues)) },
    trade:{ sold:trade.sold|0, gold:trade.gold|0 }, livery:player.livery||'azure',
    // ★ WHERE the knight stands — the world, the building, the floor. Without this a
    //   save made inside Tabor or a chapel reloaded those local coordinates onto the
    //   OVERWORLD map, which could drop you anywhere at all.
    where: { kind:place.kind, id:place.id||null, floor:place.floor|0,
             pw: (portalWorld.active?portalWorld.id:null),
             ret: portalWorld.ret||null,
             lampReturn: portalWorld._lampReturn||null,
             cathReturn: portalWorld._cathReturn||null,
             home: { x:lastOverworld.x, y:lastOverworld.y } },
    codex: codex.seen.slice(0,300),
    sunfall: { dawn:!!sunfallProgress.dawn, pretenderDown:!!sunfallProgress.pretenderDown, homecoming:!!sunfallProgress.homecoming, lamps:JSON.parse(JSON.stringify(sunfallProgress.lamps)),
               spans:JSON.parse(JSON.stringify(sunfallProgress.spans||{})), caches:JSON.parse(JSON.stringify(sunfallProgress.caches||{})), timber:sunfallProgress.timber|0,
               waystations:JSON.parse(JSON.stringify(sunfallProgress.waystations||{})),
               tiers:JSON.parse(JSON.stringify(sunfallProgress.tiers||{})),
               metPilgrims:JSON.parse(JSON.stringify(sunfallProgress.metPilgrims||{})),
               debris:JSON.parse(JSON.stringify(sunfallProgress.debris||{})) },
    homesteadDecor:{ inv:Object.assign({},homesteadDecor.inv), placed:homesteadDecor.placed.map(p=>({id:p.id,x:p.x,y:p.y})) },
    wagon:{ unlocked:wagon.unlocked, x:wagon.x, y:wagon.y, cargo:Object.assign({},wagon.cargo), announced:wagon.announced },
    deliveries:{ req:Object.assign({},deliveries.req), done:deliveries.done },
    homesteadGranted:homesteadGranted,
    clock:{ t:dayClock.t, day:dayClock.day }, playMs:playMs,
  };
}
// ══ restore the knight to the place he saved in. Anything we cannot safely rebuild
//    (a dungeon run, a boat race, a cutscene) falls back to the last place he stood
//    in Luminar, so a save can never strand him in a world that no longer exists. ══
function restoreWhere(w){
  const bail=()=>{ place={kind:'overworld'};
    player.x=(w&&w.home?w.home.x:lastOverworld.x); player.y=(w&&w.home?w.home.y:lastOverworld.y);
    portalWorld.active=false; portalWorld.g=null;
    demons=[]; if(typeof spawnDemons==='function') spawnDemons(); };
  if(!w || !w.kind || w.kind==='overworld'){
    place={kind:'overworld'};
    if(w&&w.home){ lastOverworld.x=w.home.x; lastOverworld.y=w.home.y; }
    demons=[]; if(typeof spawnDemons==='function') spawnDemons();
    return true;
  }
  if(w.home){ lastOverworld.x=w.home.x; lastOverworld.y=w.home.y; }
  const standOrElse=(g,ex,ey)=>{                       // keep the saved tile if it is solid
    const tx=Math.floor((player.x+TILE/2)/TILE), ty=Math.floor((player.y+TILE/2)/TILE);
    if(g && g[ty] && WALK.has(g[ty][tx])) return;
    player.x=ex*TILE; player.y=ey*TILE;
  };
  const buildWorld=(id)=>{
    if(!id) return false;
    buildPortalWorld(id);
    if(w.ret) portalWorld.ret=w.ret;
    return true;
  };
  const repopulate=(id)=>{
    demons=[];
    if(id==='sunfall' && typeof spawnSunfallGloamings==='function') spawnSunfallGloamings();
    else if(id==='mistral' && typeof spawnMistralKnights==='function') spawnMistralKnights();
    else if(id==='tabor' && typeof spawnTaborBeasts==='function') spawnTaborBeasts();
  };
  if(w.kind==='portalworld'){
    if(!buildWorld(w.pw)) { bail(); return false; }
    place={kind:'portalworld'};
    standOrElse(portalWorld.g, portalWorld.entry.x, portalWorld.entry.y);
    repopulate(w.pw);
    return true;
  }
  if(w.kind==='interior' && w.id){
    const id=String(w.id);
    // the lazily-built interiors have to be rebuilt before he can stand in one
    try{
      if(id.indexOf('sunlamp_')===0) buildSunfallLighthouse(id.slice(8));
      else if(id==='vesper_cath') buildVesperCathedral();
      else if(id.indexOf('vesper_vh')===0) buildVesperHouse(id.slice(7));
      else if(id.indexOf('mistchapel_')===0) buildMistralChapel(id.slice(11));
      else if(id==='mistthrone') buildMistralThrone();
    }catch(e){}
    const inter=INTERIORS[id];
    if(!inter || !inter.floors || !inter.floors.length){ bail(); return false; }
    if(w.pw){ buildWorld(w.pw);
      portalWorld._lampReturn=w.lampReturn||null; portalWorld._cathReturn=w.cathReturn||null; }
    const fl=Math.max(0, Math.min(w.floor|0, inter.floors.length-1));
    const f=inter.floors[fl];
    place={kind:'interior', id:id, floor:fl};
    let dx=Math.floor(f.w/2), dy=f.h-2;                // the door, as a fallback
    for(let y=0;y<f.h;y++)for(let x=0;x<f.w;x++) if(f.g[y][x]===9){ dx=x; dy=Math.min(f.h-2,y-1<1?y+1:y-1); }
    standOrElse(f.g, dx, dy);
    demons=[];
    return true;
  }
  bail(); return false;                                 // dungeons, races, cutscenes
}
function applySaveData(s){
  if(!s||!s.player) return false;
  const p=s.player;
  Object.assign(player, { x:p.x, y:p.y, dir:p.dir||'down', hp:p.hp, level:p.level, xp:p.xp, xpNext:p.xpNext,
    baseMaxHp:p.baseMaxHp, baseAtk:p.baseAtk, baseDef:p.baseDef, baseCrit:p.baseCrit,
    skillPoints:p.skillPoints, skills:p.skills||{}, equip:p.equip||{weapon:'rusty',armor:'none_a'},
    ownedGear:p.ownedGear||{rusty:true,none_w:true,none_a:true}, weaponType:p.weaponType||'light', name:p.name||'Knight', pet:p.pet||null, surfBest:p.surfBest||0, petGear:p.petGear||{}, barnPets:p.barnPets||[], raceBarding:!!p.raceBarding, boatInv:p.boatInv||null, hasLamp:!!p.hasLamp, championRobe:!!(p.championRobe||p.crossNecklace), mountSkin:p.mountSkin||null, mountSkinOwned:p.mountSkinOwned||{} });
  // ── back-compat: saves from before the Rusty Old Sword existed. Grant it, and
  //    if they're still empty-handed, put it in their hand — atk 0 and the same
  //    special as Bare Fists, so this is a silhouette change and nothing more.
  const _preRusty = !(p.ownedGear && p.ownedGear.rusty);   // save predates the Rusty Old Sword
  if(!player.ownedGear) player.ownedGear={};
  player.ownedGear.rusty=true;
  if(!player.equip) player.equip={weapon:'rusty',armor:'none_a'};
  // Migrate ONCE, only for saves from before the sword existed. Doing this on every
  // load would make Bare Fists impossible to keep equipped across a save/load.
  if(_preRusty && player.equip.weapon==='none_w') player.equip.weapon='rusty';
  if(typeof s.raceRecordMs==='number') raceRecordMs=s.raceRecordMs;
  dayClock.t=(s.clock&&typeof s.clock.t==='number')?s.clock.t:DAY_LEN*0.375;
  dayClock.day=(s.clock&&s.clock.day)||1; _wasNight=null;
  playMs=s.playMs||0;
  gold = s.gold||0;
  // _legacy: Object.keys(inventory).forEach(k=>delete inventory[k]); Object.assign(inventory, s.inventory||{});
  //   Wiped every key, so anything added to the game after the save was written
  //   came back undefined. Defaults go down FIRST, the save overlays them — so a
  //   missing item is 0, a saved value still wins, and an unknown key from a
  //   newer version is kept rather than dropped.
  Object.keys(inventory).forEach(k=>delete inventory[k]);
  Object.assign(inventory, INVENTORY_DEFAULTS, s.inventory||{});
  Object.keys(chapelProgress).forEach(k=>delete chapelProgress[k]); Object.assign(chapelProgress, s.chapelProgress||{});
  Object.keys(crops).forEach(k=>delete crops[k]); Object.assign(crops, s.crops||{});
  // MIGRATION: v92 and earlier stored crops with no `type` — every one of them
  // was wheat. Without this, an old save's standing field renders as bare dirt.
  for(const k in crops){ if(!crops[k].type || !CROPS[crops[k].type]) crops[k].type='wheat'; }
  Object.keys(quests).forEach(k=>quests[k]='unstarted'); Object.assign(quests, s.quests||{});
  // an older save has no tutorial block: that knight has plainly been playing
  // for a while, so do not sit him back down at the hearth
  tutorial.step = (s.tutorial && s.tutorial.step)||0;
  tutorial.done = s.tutorial ? !!s.tutorial.done : true;
  Object.keys(secretsFound).forEach(k=>delete secretsFound[k]); Object.assign(secretsFound, s.secretsFound||{});
  explored = new Set(s.explored||[]);
  abaddon.won = !!s.abaddonWon;
  hunt.won = !!s.abaddonWon;
  if(s.hunt){ hunt.active=!!s.hunt.active; hunt.done=!!s.hunt.done; hunt.killed=s.hunt.killed||0; hunt.total=s.hunt.total||0; hunt.remaining=(s.hunt.remaining||[]).slice(); }
  else if(hunt.won){ initHuntRoster(); }
  bounties.active=(s.bounties&&s.bounties.active||[]).slice();
  bounties.complete=(s.bounties&&s.bounties.complete||[]).slice();
  bounties.nextId=(s.bounties&&s.bounties.nextId)||(bounties.active.concat(bounties.complete).length+1);
  bounties.perTown=Object.assign({}, s.bounties&&s.bounties.perTown||{});
  bounties.pretenderUnlocked=!!(s.bounties&&s.bounties.pretenderUnlocked);
  bounties.pretenderDefeated=!!(s.bounties&&s.bounties.pretenderDefeated);
  bounties.portalsOpen=!!(s.bounties&&s.bounties.portalsOpen);
  bounties.madisonTaken=!!(s.bounties&&s.bounties.madisonTaken);
  bounties.madisonRescued=!!(s.bounties&&s.bounties.madisonRescued);
  bounties.matthewIntercept=!!(s.bounties&&s.bounties.matthewIntercept);
  // A demon cull from before culls were pinned to a zone has no b.zone, so
  // spawnCullDemons() would skip it and it could never be finished. Assign one.
  bounties.active.forEach(b=>{ if(b.kind==='demons' && typeof b.zone!=='number') b.zone=pickCullZone(); });
  // portals: restore unlocked/cleared per id; missing entries keep registry defaults
  if(Array.isArray(s.portals)) s.portals.forEach(sp=>{ const p=portalById(sp&&sp.id);
    if(p){ p.unlocked=!!sp.unlocked; p.cleared=!!sp.cleared; } });
  mistralProgress.wanderersDown = (s.mistral&&s.mistral.wanderersDown)|0;
  mistralProgress.villages = (s.mistral&&s.mistral.villages) ? JSON.parse(JSON.stringify(s.mistral.villages)) : {};
  taborProgress.hopeAll = !!(s.tabor && s.tabor.hopeAll);
  taborProgress.bossDown = !!(s.tabor && s.tabor.bossDown);
  taborProgress.summitCine = !!(s.tabor && s.tabor.summitCine);
  taborProgress.thawed = !!(s.tabor && s.tabor.thawed);
  taborProgress.rescues = (s.tabor && s.tabor.rescues) ? JSON.parse(JSON.stringify(s.tabor.rescues)) : {};
  trade.sold=(s.trade&&s.trade.sold)|0; trade.gold=(s.trade&&s.trade.gold)|0;
  codex.seen = Array.isArray(s.codex) ? s.codex.slice() : [];
  player.livery=s.livery||'azure';
  sunfallProgress.dawn = !!(s.sunfall && s.sunfall.dawn);
  sunfallProgress.pretenderDown = !!(s.sunfall && s.sunfall.pretenderDown);
  sunfallProgress.homecoming = !!(s.sunfall && s.sunfall.homecoming);
  if(typeof ensureMadisonAtHome==='function') ensureMadisonAtHome();
  sunfallProgress.lamps = (s.sunfall && s.sunfall.lamps) ? JSON.parse(JSON.stringify(s.sunfall.lamps)) : {};
  sunfallProgress.spans = (s.sunfall && s.sunfall.spans) ? JSON.parse(JSON.stringify(s.sunfall.spans)) : {};
  sunfallProgress.caches = (s.sunfall && s.sunfall.caches) ? JSON.parse(JSON.stringify(s.sunfall.caches)) : {};
  sunfallProgress.timber = (s.sunfall && s.sunfall.timber)|0;
  sunfallProgress.waystations = (s.sunfall && s.sunfall.waystations) ? JSON.parse(JSON.stringify(s.sunfall.waystations)) : {};
  sunfallProgress.tiers = (s.sunfall && s.sunfall.tiers) ? JSON.parse(JSON.stringify(s.sunfall.tiers)) : {};
  sunfallProgress.metPilgrims = (s.sunfall && s.sunfall.metPilgrims) ? JSON.parse(JSON.stringify(s.sunfall.metPilgrims)) : {};
  sunfallProgress.debris = (s.sunfall && s.sunfall.debris) ? JSON.parse(JSON.stringify(s.sunfall.debris)) : {};
  homesteadDecor.inv=Object.assign({}, s.homesteadDecor&&s.homesteadDecor.inv||{});
  homesteadDecor.placed=(s.homesteadDecor&&s.homesteadDecor.placed||[]).slice();
  migrateHomesteadDecor();   // v13: re-home legacy placements into the redesigned clearing
  syncPlacedDecor();
  // 🛒 wagon + deliveries (v13) — legacy saves simply arrive with the wagon still locked
  { const w=s.wagon||{};
    wagon.unlocked=!!w.unlocked; wagon.x=(typeof w.x==='number')?w.x:WAGON_HOME.x; wagon.y=(typeof w.y==='number')?w.y:WAGON_HOME.y;
    wagon.cargo=Object.assign({}, w.cargo||{}); wagon.announced=!!w.announced;
    const d=s.deliveries||{}; deliveries.req=Object.assign({}, d.req||{}); deliveries.done=d.done||0;
    player.driving=false; }
  homesteadGranted=!!s.homesteadGranted;
  ensureDeliveryPoints();
  unlockWagonIfReady();   // in case this save already finished the hunt but predates the wagon
  if(hunt.won) ensureAldric();
  if(hunt.done) ensureMarshals();
  checkPetEvolve();      // a companion that has earned its growth evolves on load
  if(player.equip&&player.equip.weapon&&EQUIP[player.equip.weapon]) player.weaponType=EQUIP[player.equip.weapon].type||'light';
  recalcStats();
  place={kind:'overworld'}; demons=[]; spawnDemons();
  // ── UNSTUCK SAFETY: if the saved position is inside a wall/tree (e.g. terrain
  //    changed since the save), nudge the player to the nearest walkable tile so
  //    they can never be trapped on load. ──
  {
    const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
    const here=WORLD[pty] && WORLD[pty][ptx];
    if(!WALK.has(here)){
      let best=null, bestD=Infinity;
      for(let r=1; r<=24 && !best; r++){
        for(let dy=-r; dy<=r; dy++) for(let dx=-r; dx<=r; dx++){
          if(Math.max(Math.abs(dx),Math.abs(dy))!==r) continue;   // ring at radius r
          const nx=ptx+dx, ny=pty+dy;
          if(WORLD[ny] && WALK.has(WORLD[ny][nx])){
            const d=dx*dx+dy*dy; if(d<bestD){ bestD=d; best=[nx,ny]; }
          }
        }
        if(best){ player.x=best[0]*TILE; player.y=best[1]*TILE; }
      }
    }
  }
  // ★ LAST of all: every progress flag is now set and the overworld snap has run,
  //   so the world can be rebuilt correctly and the knight put back where he saved.
  restoreWhere(s.where);

  return true;
}
// ── storage health + portable save codes ──────────────────────────
// On some mobile setups (opening a downloaded/att­ached HTML file, private
// browsing, etc.) the browser gives the page an EPHEMERAL storage origin:
// localStorage writes succeed in the moment but are wiped when the tab closes,
// so progress never sticks. We probe once, keep the latest save in memory, and
// offer copy-paste Save Codes so progress can always be backed up & restored.
let storageWorks=true;
try{ localStorage.setItem('__klk_probe','1'); storageWorks=(localStorage.getItem('__klk_probe')==='1'); localStorage.removeItem('__klk_probe'); }
catch(e){ storageWorks=false; }
let lastSaveJSON=null;   // latest save snapshot (for Export even when storage is blocked)
function encodeSaveCode(){
  try{ const json = lastSaveJSON || JSON.stringify(buildSaveData());
    return 'KLK1:'+btoa(unescape(encodeURIComponent(json))); }
  catch(e){ return ''; }
}
function decodeSaveCode(code){
  try{
    code=String(code||'');
    const m=code.search(/klk1/i);                   // locate the marker in ANY case (iOS lowercases it)
    if(m>=0) code=code.slice(m+4);                  // drop the 'klk1' marker
    code=code.replace(/[^A-Za-z0-9+/=]/g,'');       // keep only base64 chars (preserves body casing)
    if(code.length<8) return null;
    return JSON.parse(decodeURIComponent(escape(atob(code))));
  }catch(e){ return null; }
}
function saveGame(slot){
  slot=slot||activeSlot;
  const data=JSON.stringify(buildSaveData());
  lastSaveJSON=data;   // keep the latest snapshot in memory so Export always works, even if storage is blocked
  try{ localStorage.setItem(slotKey(slot), data); return {ok:true, where:'local'}; }
  catch(e){ return {ok:false, data}; }   // sandbox: hand back the string to copy
}
function loadGame(slot){
  slot=slot||activeSlot;
  try{ const raw=localStorage.getItem(slotKey(slot)); if(!raw) return {ok:false, reason:'none'};
    const ok=applySaveData(JSON.parse(raw));
    if(ok && pendingDecorMigration>0){ const n=pendingDecorMigration; pendingDecorMigration=0;
      setTimeout(()=>showBanner('🏡 <b>The Homestead was rebuilt!</b><br><span style="font-size:7px">'+n+' of your decoration'+(n>1?'s are':' is')+' waiting in your Home tab (☰) to place in the new clearing.</span>', 5200), 400); }
    return { ok }; }
  catch(e){ return {ok:false, reason:'err'}; }
}
function hasSave(slot){ try{ return !!localStorage.getItem(slotKey(slot||activeSlot)); }catch(e){ return false; } }

// ════════════════════════════════════════════════════════════════
//  ✦ MAX HERO — a fully-progressed cheat character for testing.
//  All ten chapels cleansed · both skill trees maxed · flying Sky Steed ·
//  best gear owned+equipped · all questlines/bounties done UP TO Tabor ·
//  spawns at the base of Mount Tabor (the overworld Tabor Gate, 95,274).
//  Writes into a chosen slot (default 3) so real saves are left intact.
// ════════════════════════════════════════════════════════════════
function _buildMaxSave(){
  // every Knight + Pet skill node id (both trees fully owned)
  const allSkills={};
  for(const b in SKILL_TREE) for(const n of SKILL_TREE[b].nodes) allSkills[n.id]=true;
  for(const b in PET_TREE)  for(const n of PET_TREE[b].nodes)  allSkills[n.id]=true;
  // all ten chapels cleansed (0..9) + Abaddon's cathedral
  const chapels={ abaddon:true }; for(let i=0;i<10;i++) chapels[i]=true;
  // own every weapon & armor; equip the best (Holy Avenger + Armor of God)
  const ownedGear={}; for(const id in EQUIP) ownedGear[id]=true;
  const LV=45;                                   // enough that all 42 skill points are affordable, plenty spare
  return {
    v:1, t:Date.now(),
    player:{
      x:95*TILE, y:274*TILE, dir:'up',
      hp:9999, level:LV, xp:0, xpNext:xpForLevel(LV),
      baseMaxHp:100, baseAtk:12, baseDef:0, baseCrit:0.06,
      skillPoints:20,                            // spare points after buying everything
      skills:allSkills,
      equip:{ weapon:'holyblade', armor:'armorofgod' },
      ownedGear, weaponType:'light',
      name:'Paladin', pet:{ id:'grace', form:2 },   // flying Sky Steed
      surfBest:0, petGear:{}, barnPets:[{ id:'unicorn', form:2 }], raceBarding:true, boatInv:null,
      hasLamp:true, championRobe:true, mountSkin:null, mountSkinOwned:{ spectral:true },
    },
    gold:9999,
    inventory:{ potion:20, bread:20 },
    quests:{ goldenFish:'done', kindness:'done' },
    chapelProgress:chapels,
    crops:{}, secretsFound:{},
    raceRecordMs:45000,
    explored:[], abaddonWon:true,
    hunt:{ active:false, done:true, killed:12, total:12, remaining:[] },
    bounties:{ active:[], complete:[], nextId:1, perTown:{},
      pretenderUnlocked:false, pretenderDefeated:true, portalsOpen:true,
      madisonTaken:true, madisonRescued:false, matthewIntercept:true },
    // overworld portals: Mistral cleared, Tabor unlocked & waiting to be played
    portals:[ {id:'mistral',unlocked:true,cleared:true},
              {id:'tabor',unlocked:true,cleared:false},
              {id:'sunfall',unlocked:false,cleared:false} ],
    mistral:{ wanderersDown:5, villages:{} },
    // Tabor fresh: not yet climbed, so the whole world is there to play
    tabor:{ hopeAll:false, bossDown:false, summitCine:false, thawed:false, rescues:{} },
    homesteadDecor:{ inv:{}, placed:[] },
    wagon:{ unlocked:true, x:WAGON_HOME.x, y:WAGON_HOME.y, cargo:{}, announced:true },
    deliveries:{ req:{}, done:0 },
    homesteadGranted:true,
    clock:{ t:DAY_LEN*0.375, day:1 }, playMs:0,
  };
}
// ══ ✦ SUNFALL HERO — the same fully-progressed knight, but with BOTH earlier
//    portal worlds behind him: Mistral cleansed, Tabor's five rescued and the
//    mountain thawed, the third gate open. Spawns at the overworld Sunfall Gate
//    (155,270) with Sunfall itself untouched — the whole world left to play. ══
function _buildSunfallSave(){
  const s=_buildMaxSave();
  s.player.x=155*TILE; s.player.y=270*TILE; s.player.dir='up';
  s.player.skillPoints=28;                       // +8 earned across Tabor's rescues and the thaw
  s.playMs=0;
  // all three gates: two worlds finished, the third open and waiting
  s.portals=[ {id:'mistral',unlocked:true,cleared:true},
              {id:'tabor',  unlocked:true,cleared:true},
              {id:'sunfall',unlocked:true,cleared:false} ];
  // Mistral: every fold cleansed, every lamb home
  const vil={};
  ['fold','brook','meadowe','millford','downs'].forEach(id=>{
    vil[id]={ guardsDown:5, squareClear:true, cleared:true, lostTotal:0, lostGathered:0, herdDone:true }; });
  s.mistral={ wanderersDown:10, villages:vil };
  // Tabor: the five hearts warmed, the King of the Shadows down, the mountain green
  const res={}; ['beset','buried','hearth','ledge','eden'].forEach(id=>{ res[id]={done:true, stage:9}; });
  s.tabor={ hopeAll:true, bossDown:true, summitCine:true, thawed:true, rescues:res };
  // Sunfall: fresh — no captain felled, no lamp kindled, the sun still held at evening
  s.sunfall={ dawn:false, lamps:{} };
  return s;
}
function loadSunfallHero(slot){
  slot=slot||3;
  const s=_buildSunfallSave();
  if(!applySaveData(s)) return false;
  recalcStats(); player.hp=player.maxHp;
  setActiveSlot(slot);
  try{ localStorage.setItem(slotKey(slot), JSON.stringify(buildSaveData())); }catch(e){}
  lastSaveJSON=JSON.stringify(buildSaveData());
  if(boot.done && typeof showBanner==='function'){
    showBanner('\u2726 <b>Sunfall hero loaded</b> — '+player.name+', Lv '+player.level+
      '<br><span style="font-size:7px">Mistral cleansed · Tabor thawed · the third gate open.<br>You stand at the <b>Sunfall Gate</b>. Press \u24b6 to cross.</span>', 4600);
  }
  if(typeof menu!=='undefined' && menu.open) toggleMenu();
  if(typeof updateMountBtn==='function') updateMountBtn();
  return true;
}
try{ if(typeof window!=='undefined') window.loadSunfallHero=loadSunfallHero; }catch(e){}
// Build, apply, and persist the max hero into a slot (default 3). Returns true on success.
function loadMaxHero(slot){
  slot=slot||3;
  const s=_buildMaxSave();
  if(!applySaveData(s)) return false;
  recalcStats(); player.hp=player.maxHp;          // top off HP to the freshly-computed max
  setActiveSlot(slot);
  try{ localStorage.setItem(slotKey(slot), JSON.stringify(buildSaveData())); }catch(e){}
  lastSaveJSON=JSON.stringify(buildSaveData());
  if(boot.done && typeof showBanner==='function'){
    showBanner('✦ <b>Max hero loaded</b> — '+player.name+', Lv '+player.level+
      '<br><span style="font-size:7px">All chapels cleansed · both trees maxed · Sky Steed · best gear.<br>You stand at the base of Mount Tabor. Enter the gate to climb.</span>', 4200);
  }
  if(typeof menu!=='undefined' && menu.open) toggleMenu();
  if(typeof updateMountBtn==='function') updateMountBtn();
  return true;
}
try{ if(typeof window!=='undefined') window.loadMaxHero=loadMaxHero; }catch(e){}

// ── SAVE-CODE overlay (export / import) ──
const saveio = { open:false, mode:null };
function sioEl(id){ return document.getElementById(id); }
function openSaveExport(){
  const code=encodeSaveCode();
  saveio.open=true; saveio.mode='export';
  sioEl('sioTitle').textContent='📤 Export Save Code';
  sioEl('sioHelp').innerHTML='Copy this whole code and keep it somewhere safe (paste it into Notes, a message to yourself, etc.). On mobile, saves can vanish when you reopen the file \u2014 this code lets you restore your hero anywhere.';
  const ta=sioEl('sioText'); ta.value=code; ta.readOnly=true;
  sioEl('sioMsg').textContent = storageWorks ? '' : '\u26a0 This device isn\u2019t keeping saves \u2014 back up with this code.';
  sioEl('sioBtns').innerHTML='<button class="primary" id="sioCopy">Copy</button><button id="sioClose">Close</button>';
  sioEl('sioCopy').onclick=()=>{ try{ ta.focus(); ta.select(); ta.setSelectionRange(0, ta.value.length); }catch(e){}
    let done=false; try{ if(navigator.clipboard&&navigator.clipboard.writeText){ navigator.clipboard.writeText(ta.value); done=true; } }catch(e){}
    if(!done){ try{ document.execCommand('copy'); done=true; }catch(e){} }
    sioEl('sioMsg').textContent = done ? '\u2713 Copied! Paste it somewhere safe.' : 'Select all the text above and copy it.'; };
  sioEl('sioClose').onclick=closeSaveIo;
  sioEl('saveio').classList.add('open');
}
function openSaveImport(){
  saveio.open=true; saveio.mode='import';
  sioEl('sioTitle').textContent='📥 Import Save Code';
  sioEl('sioHelp').innerHTML='Paste a Save Code below and press <b>Load</b> to restore that hero into Slot '+activeSlot+'. This overwrites the current slot.';
  const ta=sioEl('sioText'); ta.value=''; ta.readOnly=false;
  sioEl('sioMsg').textContent='';
  sioEl('sioBtns').innerHTML='<button class="primary" id="sioLoad">Load</button><button id="sioClose">Close</button>';
  sioEl('sioLoad').onclick=()=>{
    const raw=sioEl('sioText').value||'';
    const s=decodeSaveCode(raw);
    if(!s){ sioEl('sioMsg').style.color='#ff8a8a';
      sioEl('sioMsg').textContent = !/klk1/i.test(raw)
        ? '\u2717 No code found \u2014 paste the whole thing, starting with KLK1:'
        : ('\u2717 Code looks cut off ('+raw.length+' chars). Copy the ENTIRE code and retry.');
      return; }
    if(!s.player){ sioEl('sioMsg').style.color='#ff8a8a'; sioEl('sioMsg').textContent='\u2717 Decoded, but no hero data inside.'; return; }
    if(applySaveData(s)){ try{ localStorage.setItem(slotKey(activeSlot), JSON.stringify(buildSaveData())); }catch(e){}
      lastSaveJSON=JSON.stringify(buildSaveData());
      closeSaveIo(); if(menu.open) toggleMenu();
      showBanner('\ud83d\udcc2 Save Code loaded \u2014 welcome back, <b>'+(player.name||'Knight')+'</b>!', 2600);
    } else { sioEl('sioMsg').style.color='#ff8a8a'; sioEl('sioMsg').textContent='\u2717 Could not load that code.'; }
  };
  sioEl('sioClose').onclick=closeSaveIo;
  sioEl('saveio').classList.add('open');
}
function closeSaveIo(){ saveio.open=false; saveio.mode=null; sioEl('sioMsg').style.color='#7ad07a'; sioEl('saveio').classList.remove('open'); }

// ════════════════════════════════════════════════════════════════
//  INTRO — story crawl → name yourself → choose a starter pet
// ════════════════════════════════════════════════════════════════
const intro = { open:false, step:0, name:'', petPick:0 };
const INTRO_STORY = [
  "Long ago, the kingdom of <b>Luminar</b> shone bright under heaven's grace.",
  "Then the demon king <b>Abaddon</b> tore open the dark, and his legions fell upon the land. Ten towns were seized, their faithful generals struck down.",
  "Your father, the knight <b>Sir Aldric</b>, rode out to answer the darkness — and never returned.",
  "Your grandfather <b>Tobias</b> raised you in the quiet village of Hearthvale, teaching you the sword and the Word.",
  "Now the shadow creeps toward home. The call has come to you, the kingdom's last knight...",
];
function startIntro(){ intro.open=true; intro.step=0; intro.name=''; intro.petPick=0; renderIntro(); document.getElementById('gamemenu').classList.add('open'); }
function renderIntro(){
  let html='';
  if(intro.step < INTRO_STORY.length){
    const line=INTRO_STORY[intro.step];
    html = `<div class="gm-tabs"><div class="gm-tab sel">⚔ Kingdom's Last Knight</div></div>`
      + `<div class="gm-body" style="display:flex;flex-direction:column;justify-content:center;min-height:50vh">`
      + `<div style="font-size:9px;color:#cbb8e0;line-height:2.1;padding:0 8px;text-align:center">${line}</div>`
      + `<div class="gm-hint" style="margin-top:24px">Ⓐ / tap to continue · (${intro.step+1}/${INTRO_STORY.length})</div></div>`;
  } else if(intro.step === INTRO_STORY.length){
    // name entry
    html = `<div class="gm-tabs"><div class="gm-tab sel">Name Your Knight</div></div>`
      + `<div class="gm-body" style="min-height:40vh">`
      + `<div style="font-size:8px;color:#cbb8e0;line-height:1.9;margin:10px 4px;text-align:center">What is your name, young knight?</div>`
      + `<input id="introName" maxlength="14" placeholder="Knight" value="${intro.name}" `
      + `style="width:100%;background:#1a1330;border:1px solid #5a4a7a;color:#fff;font-family:inherit;font-size:11px;padding:8px;border-radius:4px;text-align:center;letter-spacing:1px">`
      + `<div class="gm-hint" style="margin-top:16px">Type your name · Ⓐ / Enter to continue</div></div>`;
  } else {
    // pet pick
    const ids=STARTER_PETS; const pid=ids[intro.petPick]; const p=PETS[pid];
    html = `<div class="gm-tabs"><div class="gm-tab sel">Choose Your Companion</div></div><div class="gm-body">`
      + `<div style="font-size:8px;color:#cbb8e0;line-height:1.8;margin:6px 4px 10px;text-align:center">A faithful creature will walk with you. As it grows, it will carry you across the land. Choose well.</div>`
      + `<div style="display:flex;gap:6px;justify-content:center;margin-bottom:8px">`
      + ids.map((id,i)=>`<div data-pet="${i}" style="flex:1;text-align:center;padding:8px 2px;border:2px solid ${i===intro.petPick?'#e94560':'#2a1f3e'};border-radius:6px;background:${i===intro.petPick?'rgba(224,85,106,.2)':'rgba(30,20,46,.5)'}"><div style="font-size:22px;pointer-events:none">${PETS[id].forms[0].emoji}</div><div style="font-size:7px;color:#cbb8e0;margin-top:3px;pointer-events:none">${PETS[id].name}</div></div>`).join('')
      + `</div>`;
    const f3=p.forms[2];
    html += `<div class="gm-sectitle" style="color:#f5a623">${p.name} — ${p.focus}</div>`
      + `<div style="font-size:7px;color:#cbb8e0;line-height:1.9;margin:2px 4px">${p.desc}</div>`
      + `<div style="font-size:7px;color:#9a8ab8;margin:6px 4px;line-height:1.8">Evolves: ${p.forms.map(f=>f.emoji+' '+f.name).join(' → ')}<br><b style="color:#6fdf8a">Final ability: ${f3.abilityName}</b> — ${f3.abilityDesc}</div>`
      + `<div class="gm-hint">◀▶ choose · Ⓐ begin your journey</div></div>`;
  }
  document.getElementById('gamemenu').innerHTML=html;
  if(intro.step===INTRO_STORY.length){ const inp=document.getElementById('introName'); if(inp){ inp.focus(); inp.oninput=()=>{ intro.name=inp.value; }; } }
}
function introMove(dx){ if(intro.step>INTRO_STORY.length){ const n=STARTER_PETS.length; intro.petPick=(intro.petPick+dx+n)%n; renderIntro(); } }
function introNext(){
  if(intro.step < INTRO_STORY.length){ intro.step++; renderIntro(); return; }
  if(intro.step === INTRO_STORY.length){ const inp=document.getElementById('introName'); if(inp) intro.name=inp.value.trim(); intro.step++; renderIntro(); return; }
  // finish: assign name + pet, close intro
  player.name = (intro.name||'Knight').slice(0,14);
  const id=STARTER_PETS[intro.petPick];
  player.pet = { id, form:0 };
  recalcStats();
  intro.open=false; document.getElementById('gamemenu').classList.remove('open');
  const p=PETS[id];
  // _legacy: showBanner(`⚔️ Go forth, …  Ⓐ attack / talk / open · Ⓑ dash`, 4200)
  //   The whole tutorial was one banner on a four-second fuse, on the road, with
  //   nobody to ask. You begin at Tobias's hearth instead.
  tutorial.step=0; tutorial.done=false;
  const _tb=buildings.find(b=>b.id==='tobias');
  if(_tb && INTERIORS.tobias){
    returnStack.length=0;
    returnStack.push({ x:_tb.door.x*TILE, y:(_tb.door.y+1)*TILE, dir:'down' });
    // You wake in the bed UPSTAIRS, not at the front door — the first thing the
    // game shows you should be the room you slept in, then the stairs down to
    // the old man. Stand at the foot of the bedding on floor 1, facing it.
    place={kind:'interior', id:'tobias', floor:1};
    const f=INTERIORS.tobias.floors[1];
    // Tiles 42 and 43 ARE the bed — head and foot — and this room already has
    // one. Stand beside it, facing it, so the first thing on screen is the bed
    // you woke from. Found by tile, not hardcoded, so moving the bed moves you.
    let bx=-1, by=-1;
    for(let y=0;y<f.h && by<0;y++)for(let x=0;x<f.w;x++) if(f.g[y][x]===42){ bx=x; by=y; break; }
    if(bx<0){ bx=1; by=1; }
    // You wake IN the bed — on the foot tile, looking out at the room. The bed is
    // solid, but walkable() only gates where you are GOING, so you can step off it.
    player.x=bx*TILE; player.y=(by+1)*TILE; player.dir='right';
  }
  saveGame();
  startTobiasScene();
  // he speaks only once he has crossed the room to the bedside
  escort.onArrive = ()=> sayAs('Tobias', [`Easy now, <b>${player.name}</b>. You slept like the dead.`,
    `${p.forms[0].emoji} And there's a <b>${p.forms[0].name}</b> curled by the fire downstairs that won't be shooed off. Yours, it seems.`,
    "Get your legs under you. I\'ll be downstairs by the fire — come down and I\'ll show you what you need to know."],
    ()=>{ escort.phase='walk'; escort.t=0; });
}

// focus: 'rail' while the d-pad drives the tab margin, 'list' once you have
// pressed Ⓐ to step into the page. Ⓑ walks it back out. Same descend/ascend
// idiom the seed picker already teaches.
const menu = { open:false, tab:0, cursor:0, questsShowDone:false, focus:'rail' };
// _legacy (v92, 8 tabs): ['Character','Skills','Items','Pet','Map','Quests','System','Home']
const MENU_TABS = ['Character','Gear','Items','Skills','Pet','Quests','Map','Home','System'];
// Tab identity by NAME, never by bare index. menu.tab was compared against a
// raw integer in 18 places; inserting or reordering a tab silently rendered the
// wrong body rather than throwing, which is the same failure mode as a missing
// place.kind branch. The numbers below are the ONLY place order is written down.
const TAB = { character:0, gear:1, items:2, skills:3, pet:4, quests:5, map:6, home:7, system:8 };
const gmEl = ()=>document.getElementById('gamemenu');
function toggleMenu(){ if(!boot.done) return; if(place.kind==='surf'||place.kind==='throne'||cutscene.active||(place.kind==='abaddon'&&abaddon.victory)||petB) return; sfxMenu(!menu.open); menu.open=!menu.open; menu.cursor=0; menu.erase=false; menu.confirmErase=null; menu.focus='rail'; gmEl().classList.toggle('open', menu.open); gmEl().classList.toggle('sheet', menu.open); if(menu.open){ closeShop&&closeShop(); renderMenu(); } }
// build a flat list of selectable rows for the current tab (for cursor navigation)
function menuRows(){
  if(menu.tab===TAB.skills){ // skills: the Knight's tree (the companion's tree lives on the Pet tab)
    const rows=[]; for(const b in SKILL_TREE) for(const n of SKILL_TREE[b].nodes) rows.push({kind:'skill', id:n.id});
    return rows;
  }
  if(menu.tab===TAB.pet){ // pet: equippable gear, then the companion's skill tree
    const rows=[];
    if(player.pet){
      for(const k in PET_GEAR) if(player.petGear&&player.petGear[k]) rows.push({kind:'petgear', id:k});
      for(const b in PET_TREE) for(const n of PET_TREE[b].nodes) rows.push({kind:'skill', id:n.id});
    }
    return rows; }
  // _legacy (v92): one Items tab carried consumables AND all equipment —
  //   return [...use, ...weapons, ...armor]
  //   Gear now has its own tab, which leaves Items free to hold what a farmer
  //   actually carries: what you can eat, what you can sow, and what you reaped.
  if(menu.tab===TAB.gear){ // gear: weapons, then armor
    const owned=Object.keys(EQUIP).filter(id=>player.ownedGear[id]);
    return [...owned.filter(id=>EQUIP[id].slot==='weapon').map(id=>({kind:'gear', id})),
            ...owned.filter(id=>EQUIP[id].slot==='armor').map(id=>({kind:'gear', id}))]; }
  if(menu.tab===TAB.items){ // items: consumables · seed pouch · larder · the catch
    const use=[]; if(inventory.potion>0) use.push({kind:'use', id:'potion'}); if(inventory.bread>0) use.push({kind:'use', id:'bread'});
    return use; }   // seeds and produce are read-only tallies, not selectable rows
  if(menu.tab===TAB.home){ // home: placeable decorations
    return Object.keys(DECOR_ITEMS).filter(id=>(homesteadDecor.inv[id]||0)>0).map(id=>({kind:'decor', id}));
  }
  if(menu.tab===TAB.system){ // system: save profiles
    return [ {kind:'sys', id:'sfx'}, {kind:'sys', id:'music'},
      {kind:'sys', id:'save'},
      {kind:'slot', n:1}, {kind:'slot', n:2}, {kind:'slot', n:3},
      {kind:'sys', id:'export'}, {kind:'sys', id:'import'},
      {kind:'sys', id:'erase'} ]; }
  return []; // character & pet tabs have no selectable rows
}
function renderMenu(){
  const rows=menuRows(); if(menu.cursor>=rows.length) menu.cursor=Math.max(0,rows.length-1);
  // _legacy (v92): a horizontal strip of tabs above a single body —
  //   `<div class="gm-tabs">`+MENU_TABS.map((t,i)=>`<div class="gm-tab ${i===menu.tab?'sel':''}" data-tab="${i}">${t}</div>`).join('')+`</div><div class="gm-body">`
  //   Nine tabs across 346px gives each one ~38px, which will not hold the word
  //   "Character" at 8px. The rail runs down the margin instead, ruled like the
  //   contents page of a book.
  let html = `<div class="gm-close" data-close="1">✕</div>`
    + `<div class="gm-crest">${(player.name||'KNIGHT').toUpperCase()} — Lv ${player.level} · ${gold}g</div>`
    + `<div class="gm-split"><div class="gm-rail${menu.focus==='rail'?' focus':''}">`
    + MENU_TABS.map((t,i)=>`<div class="gm-rt ${i===menu.tab?'sel':''}" data-tab="${i}">${t}</div>`).join('')
    + `</div><div class="gm-pane"><div class="gm-panehead">${MENU_TABS[menu.tab].toUpperCase()}</div>`;
  if(menu.tab===TAB.quests){ // quests (informational)
    html += `<div style="padding:6px 4px;font-size:9px;line-height:1.7">`;
    const active=[], done=[];   // split so completed quests can collapse under a dropdown
    // ── The Journey (always shown, never "done") ──
    active.push(['The Journey','You are in: <b>'+regionName()+'</b>','#23517d']);
    // ── MAIN QUEST: the ten chapels, cleansed in order, and Abaddon ──
    const cleansed=TOWN_DATA.filter((t,i)=>chapelProgress[i]).length;
    if(!hunt.won){
      active.push(['The Shadow Over the Realm','Defeat Abaddon in Hellgate Citadel.','#7a5c28']);
      active.push(['The Ten Chapels','Cleanse the realm\u2019s chapels in order \u2014 <b>'+cleansed+'/10</b> restored.', cleansed>=10?'#2f5434':'#5c3f7a']);
    } else {
      done.push(['The Shadow Over the Realm','Abaddon is fallen. The realm draws breath again. \u2713','#2f5434']);
      done.push(['The Ten Chapels','All ten chapels restored. \u2713','#2f5434']);
    }
    // ── Aldric / the Demon Hunt ──
    if(hunt.won && !hunt.active && !hunt.done) active.push(['A Father Returned','Sir Aldric awaits you at the Family Farmhouse in the Homestead.','#2f5434']);
    if(hunt.active && !hunt.done) active.push(['The Demon Hunt','Wandering demons remaining: <b>'+huntLeft()+'</b> of '+hunt.total+'.','#7d4119']);
    if(hunt.done) done.push(['The Demon Hunt','Complete. The roads are at peace. \u2713','#2f5434']);
    // ── Knight Tournaments ──
    if(hunt.done) active.push(['Knight Tournaments','OPEN \u2014 speak to the marshals at Ironhold, Stormgate, and the Redeemed Throne.','#2f5434']);
    else active.push(['Knight Tournaments','Locked \u2014 finish the Demon Hunt.','#4a3f28']);
    // ── Eldan the Sage: the Golden Fish ──
    if(quests.goldenFish==='active'){
      active.push(['The Sage\u2019s Golden Fish',
        (inventory.goldenFish>0
          ? 'You hold the Golden Fish \u2014 return it to Eldan in the Sage\u2019s Wood. \u2713'
          : 'Eldan seeks a Golden Fish. Cast your line at any water \u2014 rivers, ponds, sea \u2014 and it may rise.'),
        inventory.goldenFish>0?'#7a5c28':'#2f5434']);
    } else if(quests.goldenFish==='done'){
      done.push(['The Sage\u2019s Golden Fish','Delivered to Eldan. He counts you a friend. \u2713','#2f5434']);
    }
    // ── Carry Kindness ──
    if(quests.kindness==='active'){
      const haveScroll=inventory.sacredScroll>0, haveFood=(inventory.bread>0);
      active.push(['Carry Kindness into the Dark',
        'Bring Eldan\u2019s scroll'+(haveScroll?' \u2713':'')+' and warm bread'+(haveFood?' \u2713':'')+' to the hermit in the monk\u2019s cave.',
        (haveScroll&&haveFood)?'#7a5c28':'#2f5434']);
    } else if(quests.kindness==='done'){
      done.push(['Carry Kindness into the Dark','The hermit is remembered no longer forgotten. \u2713','#2f5434']);
    }
    // ── The Supply Wagon: standing delivery requests ──
    if(wagon.unlocked){
      ensureDeliveryRequests();
      const reqs=[]; for(let t=0;t<10;t++){ const r=deliveries.req[t]; if(r && chapelProgress[t]){ const g=GOODS[r.good];
        reqs.push(`<div style="font-size:8px;color:#302718;margin:1px 4px">\u2022 ${TOWN_DATA[t].name}: <b>${g.emoji} ${r.need} ${g.name}</b> <span style="color:#23517d">(${r.got}/${r.need})</span></div>`); } }
      active.push(['\ud83d\uded2 The Supply Wagon',
        'Load your harvest at the barn bay and drive it to the towns.'+(deliveries.done>0?' <span style="color:#2f5434">Delivered so far: '+deliveries.done+'.</span>':'')
        + (reqs.length? '<div style="margin-top:3px">Standing requests:</div>'+reqs.join('') : ' <span style="color:#4a3f28">No open requests right now.</span>'),
        '#7a5c28']);
    }
    // ── render ACTIVE quests ──
    active.forEach(([t,d,c])=>{ html += `<div style="margin-bottom:8px"><div style="color:${c};font-weight:bold">\u2694 ${t}</div><div style="color:#302718">${d}</div></div>`; });

    // ── bounties (active) ──
    html += `<div style="border-top:1px solid #b9a880;margin:8px 0 6px;padding-top:6px;color:#5c3f7a;font-weight:bold">\ud83d\udcdc Bounties <span style="font-weight:normal;color:#4a3f28;font-size:7px">\u2014 hooded strangers wait in the realm's inns</span></div>`;
    if(!bounties.active.length){
      html += (!hunt.done && !bounties.pretenderUnlocked)
        ? `<div style="color:#665639;font-size:8px;margin-bottom:6px">🔒 Locked — the hooded strangers offer no work until <b>Sir Aldric's Demon Hunt</b> is finished.</div>`
        : `<div style="color:#665639;font-size:8px;margin-bottom:6px">None taken. Seek a stranger by an inn's hearth.</div>`;
    }
    bounties.active.forEach(b=>{ const rdy=b.got>=b.need;
      html += `<div style="margin-bottom:7px"><div style="color:${rdy?'#7a5c28':'#241d10'}">${rdy?'\u27e1 ':''}${b.title} <span style="color:${rdy?'#7a5c28':'#23517d'}">${b.got}/${b.need}</span></div>`
        + `<div style="color:#302718;font-size:8px">${bountyGoalText(b)} \u00b7 ${bountyRewardText(b)}${rdy?' \u2014 <b style="color:#7a5c28">return to a stranger!</b>':''}</div></div>`; });

    // ── the pretender's hunt: shown only in the endgame (Abaddon fallen) ──
    if(hunt.done && chapelProgress.abaddon && !bounties.pretenderDefeated){
      html += `<div style="border-top:1px solid #c0a882;margin:8px 0 6px;padding-top:6px;color:#7d4119;font-weight:bold">\ud83d\udc41 The Pretender King</div>`;
      if(bounties.pretenderUnlocked){
        html += `<div style="color:#7d4119;font-size:8px;margin-bottom:6px">He has claimed Abaddon\u2019s throne beneath Hellgate. Descend into the Citadel and cast him down. <b style="color:#7d4119">The last hunt is open.</b></div>`;
      } else {
        const towns=cleansedInnTowns();
        html += `<div style="color:#302718;font-size:8px;margin-bottom:4px">Prove the realm secure: <b>${BOUNTIES_PER_TOWN}</b> bounties fulfilled in each cleansed town.</div>`;
        towns.forEach(t=>{ const d=Math.min(bountyTownDone(t),BOUNTIES_PER_TOWN); const ok=d>=BOUNTIES_PER_TOWN;
          html += `<div style="font-size:8px;color:${ok?'#2f5434':'#4a3f28'};margin:1px 4px">${ok?'\u2713':'\u2022'} ${TOWN_DATA[t].name} <span style="color:${ok?'#2f5434':'#23517d'}">${d}/${BOUNTIES_PER_TOWN}</span></div>`; });
        if(!towns.length) html += `<div style="font-size:8px;color:#665639;margin:2px 4px">Cleanse a town\u2019s chapel to begin.</div>`;
      }
    }

    // ── COMPLETED (collapsible) ──
    const doneBounties=bounties.complete.slice();
    const doneCount=done.length + doneBounties.length;
    if(doneCount>0){
      const open=menu.questsShowDone;
      html += `<div data-questtoggle="1" style="border-top:1px solid #3f6b44;margin:10px 0 4px;padding:5px 4px;color:#2f5434;font-weight:bold;cursor:pointer;user-select:none">`
        + `${open?'\u25be':'\u25b8'} Completed <span style="color:#4a5a44;font-weight:normal;font-size:8px">(${doneCount}) \u2014 tap to ${open?'hide':'show'}</span></div>`;
      if(open){
        done.forEach(([t,d,c])=>{ html += `<div style="margin:0 4px 6px;opacity:.85"><div style="color:#4a5a44;font-weight:bold">\u2713 ${t}</div><div style="color:#4a5a44;font-size:8px">${d}</div></div>`; });
        doneBounties.slice().reverse().forEach(c2=>{ html += `<div style="color:#4a5a44;font-size:8px;margin:0 4px 3px">\u2713 ${c2.title} \u2014 ${c2.txt}</div>`; });
      }
    }
    html += `</div>`;
  }
  if(menu.tab===TAB.character){ // CHARACTER
    const w=EQUIP[player.equip.weapon], a=EQUIP[player.equip.armor];
    html += `<div class="gm-stat"><span>Level</span><b>${player.level}</b></div>`
      + `<div class="gm-stat"><span>XP</span><b>${player.xp} / ${player.xpNext}</b></div>`
      + `<div class="gm-stat"><span>❤ Max HP</span><b>${player.maxHp}</b></div>`
      + `<div class="gm-stat"><span>⚔ Attack</span><b>${player.atk}</b></div>`
      + `<div class="gm-stat"><span>🛡 Defense</span><b>${player.def}</b></div>`
      + `<div class="gm-stat"><span>✦ Crit</span><b>${Math.round(player.crit*100)}%</b></div>`
      + `<div class="gm-stat"><span>🩹 Dmg Reduce</span><b>${Math.round(player.dmgReduce*100)}%</b></div>`
      + `<div class="gm-stat"><span>🪙 Gold</span><b>${gold}</b></div>`
      + `<div class="gm-stat"><span>★ Skill Points</span><b style="color:#7a5c28">${player.skillPoints}</b></div>`
      + `<div class="gm-sectitle">Equipped</div>`
      + `<div class="gm-stat"><span>${w.emoji} Weapon</span><b>${w.name} <span style="font-size:7px;color:#8fb">[${w.type}]</span></b></div>`
      + `<div class="gm-stat"><span>✦ Combo Special</span><b style="color:#7a5c28">${SPECIALS[w.special||'flurry'].name}</b></div>`
      + `<div class="gm-stat"><span>${a.emoji} Armor</span><b>${a.name}</b></div>`;
  } else if(menu.tab===TAB.skills){ // SKILLS
    html += `<div class="gm-stat"><span>★ Skill Points to spend</span><b style="color:#7a5c28">${player.skillPoints}</b></div>`;
    let ri=0;
    const renderTree=(TREE,label)=>{
      html += `<div class="gm-sectitle" style="color:#fff;border-top:1px solid #b9a880;padding-top:6px;margin-top:6px">${label}</div>`;
      for(const bk in TREE){ const br=TREE[bk];
        html += `<div class="gm-branch"><div class="gm-sectitle" style="color:${br.color}">${br.icon} ${br.name}</div>`;
        for(const n of br.nodes){ const owned=player.skills[n.id]; const cur=(menu.cursor===ri); const can=canBuySkill(n.id);
          const cls = owned?'owned':(cur?'cur':(can?'':'locked'));
          html += `<div class="gm-node ${cls}" data-menurow="${ri}"><span class="nm" style="pointer-events:none">${n.name} <span class="ds">${n.desc}</span></span>`
            + (owned?`<span style="color:#2f5434;pointer-events:none">✓</span>`:`<span style="color:#7a5c28;pointer-events:none">${n.cost}★</span>`)+`</div>`;
          ri++;
        }
        html += `</div>`;
      }
    };
    renderTree(SKILL_TREE,'⚔ Knight');
  } else if(menu.tab===TAB.gear){ // GEAR — weapons and armor, lifted out of Items
    const rows=menuRows();
    html += `<div class="gm-sectitle">Weapons</div>`;
    rows.filter(r=>r.kind==='gear'&&EQUIP[r.id].slot==='weapon').forEach(r=>{ const e=EQUIP[r.id]; const idx=rows.indexOf(r); const cur=menu.cursor===idx; const eq=player.equip.weapon===r.id;
      html += `<div class="gm-item ${cur?'cur':''} ${eq?'equipped':''}" data-menurow="${idx}">${e.emoji} <span style="flex:1;pointer-events:none">${e.name} <span class="ds">[${e.type}] +${e.atk} atk${e.crit?` +${Math.round(e.crit*100)}% crit`:''}</span></span>${eq?'<span style="color:#2f5434;font-weight:bold;pointer-events:none">worn</span>':''}</div>`; });
    html += `<div class="gm-sectitle">Armor</div>`;
    rows.filter(r=>r.kind==='gear'&&EQUIP[r.id].slot==='armor').forEach(r=>{ const e=EQUIP[r.id]; const idx=rows.indexOf(r); const cur=menu.cursor===idx; const eq=player.equip.armor===r.id;
      html += `<div class="gm-item ${cur?'cur':''} ${eq?'equipped':''}" data-menurow="${idx}">${e.emoji} <span style="flex:1;pointer-events:none">${e.name} <span class="ds">+${e.def||0} def${e.maxHp?` +${e.maxHp} hp`:''}</span></span>${eq?'<span style="color:#2f5434;font-weight:bold;pointer-events:none">worn</span>':''}</div>`; });
    if(!rows.length) html += `<div class="gm-item" style="opacity:.6">— nothing but what you stand in —</div>`;
  } else if(menu.tab===TAB.items){ // ITEMS — consumables · seed pouch · larder · the catch
    const rows=menuRows();
    html += `<div class="gm-sectitle">Consumables</div>`;
    if(rows.length){ rows.forEach(r=>{ const idx=rows.indexOf(r); const cur=menu.cursor===idx;
        const em=r.id==='potion'?'🧪':'🍞', nm=r.id==='potion'?'Healing Potion':'Loaf of Bread', hp=r.id==='potion'?40:15;
        html += `<div class="gm-item ${cur?'cur':''}" data-menurow="${idx}">${em} <span style="flex:1;pointer-events:none">${nm} ×${inventory[r.id]} <span class="ds">use: +${hp} HP</span></span></div>`; }); }
    else html += `<div class="gm-item" style="opacity:.6">— none —</div>`;
    // ── SEED POUCH — what you can still put in the ground ──
    html += `<div class="gm-sectitle">Seed Pouch</div>`;
    const pouch=CROP_ORDER.filter(k=>(inventory[CROPS[k].seed]||0)>0);
    if(pouch.length){ pouch.forEach(k=>{ const C=CROPS[k]; const ripe=Math.round(C.ms*3/1000);
      const sn=(SHOP_ITEMS[C.seed]&&SHOP_ITEMS[C.seed].name)||(C.name+' Seed');   // the shop calls a grape seed a Vine Cutting; call it that here too
      html += `<div class="gm-item">${C.emoji} <span style="flex:1;pointer-events:none">${sn} ×${inventory[C.seed]} <span class="ds">ripe ~${ripe}s · ${C.yield} × ${GOODS[C.produce].value}g</span></span></div>`; }); }
    else html += `<div class="gm-item" style="opacity:.6">— empty · seed is sold at any village shop —</div>`;
    // ── LARDER — what the ground gave back ──
    html += `<div class="gm-sectitle">Larder</div>`;
    const larder=CROP_ORDER.map(k=>CROPS[k].produce).filter(g=>(inventory[g]||0)>0);
    if(larder.length){ let worth=0;
      larder.forEach(g=>{ const G=GOODS[g]; const n=inventory[g]; worth+=n*G.value;
        html += `<div class="gm-item">${G.emoji} <span style="flex:1;pointer-events:none">${G.name} ×${n} <span class="ds">${n*G.value}g</span></span></div>`; });
      html += `<div class="gm-stat"><span>Harvest worth</span><b>${worth}g</b></div>`; }
    else html += `<div class="gm-item" style="opacity:.6">— empty —</div>`;
    // ── THE CATCH — kept apart from the harvest: different labour, different tab of the ledger ──
    html += `<div class="gm-sectitle">The Catch</div>`;
    const cropSet=new Set(CROP_ORDER.map(k=>CROPS[k].produce));
    const fish=Object.keys(GOODS).filter(g=>!cropSet.has(g) && (inventory[g]||0)>0);
    if(fish.length){ let worth=0;
      fish.forEach(g=>{ const G=GOODS[g]; const n=inventory[g]; worth+=n*G.value;
        html += `<div class="gm-item">${G.emoji} <span style="flex:1;pointer-events:none">${G.name} ×${n} <span class="ds">${n*G.value}g</span></span></div>`; });
      html += `<div class="gm-stat"><span>Catch worth</span><b>${worth}g</b></div>`; }
    else html += `<div class="gm-item" style="opacity:.6">— empty —</div>`;
  } else if(menu.tab===TAB.pet){ // PET
    if(!player.pet){ html += `<div class="gm-stat" style="opacity:.6">No companion yet.</div>`; }
    else { const line=PETS[player.pet.id], f=line.forms[player.pet.form];
      // _legacy: <div …font-size:40px…>${f.emoji}${player.pet.ribbon||''}</div>
      // The companion now has real pixel art in the world; the name carries it
      // here. The div is dropped entirely when there is no ribbon, or it leaves
      // a 40px hole where the glyph used to be.
      const petRibbon = player.pet.ribbon||'';
      if(petRibbon) html += `<div style="text-align:center;font-size:40px;margin:10px 0">${petRibbon}</div>`;
      html += `<div class="gm-sectitle" style="color:#7a5c28;text-align:center">${f.name} <span style="color:#4a3f28">(${line.name})</span></div>`;
      html += `<div style="font-size:7px;color:#302718;text-align:center;margin:2px 8px 8px;line-height:1.8">${line.desc}</div>`;
      // bonuses
      const b=f.bonus||{}; const parts=[]; if(b.atk)parts.push(`+${b.atk} atk`); if(b.def)parts.push(`+${b.def} def`); if(b.maxHp)parts.push(`+${b.maxHp} hp`); if(b.crit)parts.push(`+${Math.round(b.crit*100)}% crit`); if(b.healMult)parts.push(`+${Math.round(b.healMult*100)}% heal`); if(b.dmgReduce)parts.push(`+${Math.round(b.dmgReduce*100)}% reduce`);
      html += `<div class="gm-stat"><span>Companion bonus</span><b style="color:#2f5434">${parts.join(' · ')}</b></div>`;
      // evolution track
      html += `<div class="gm-sectitle">Evolution</div>`;
      line.forms.forEach((fm,i)=>{ const owned=i<=player.pet.form; const cur=i===player.pet.form;
        const at = i<PET_EVOLVE_LV.length ? `Lv ${PET_EVOLVE_LV[i]}` : '';
        html += `<div class="gm-item ${cur?'cur':''}" style="${owned?'':'opacity:.5'}"><span style="flex:1">${fm.name}${fm.ability?` <span class="ds">— ${fm.abilityName}</span>`:''}</span>${owned?(cur?'<span style="color:#2f5434">current</span>':'<span style="color:#6a6">✓</span>'):`<span style="color:#4a3f28">${at}</span>`}</div>`; });
      const ab=petAbility();
      if(ab) html += `<div style="font-size:7px;color:#7a5c28;margin:8px 4px;line-height:1.8">✨ Ability unlocked: <b>${f.abilityName}</b><br>${f.abilityDesc}<br>Press Ⓑ next to the right terrain to use it.</div>`;
      else html += `<div style="font-size:7px;color:#665639;margin:8px 4px">Keep leveling — your companion grows stronger and will one day carry you across the land.</div>`;
      // ── spectral barding skin (a reward from Mistral) ──
      if(player.mountSkinOwned && player.mountSkinOwned.spectral){ const on=player.mountSkin==='spectral';
        html += `<div class="gm-sectitle" style="margin-top:6px">Pet Barding</div>`;
        html += `<div class="gm-item ${on?'equipped':''}" onclick="toggleMountSkin('spectral')" style="cursor:pointer">\u2728 <span style="flex:1">Spectral Barding <span class="ds">a ghostly blue-white sheen</span></span>${on?'<span style="color:#23517d">equipped</span>':'<span style="color:#6a6">tap to equip</span>'}</div>`;
        html += `<div class="gm-item ${!on?'equipped':''}" onclick="toggleMountSkin(null)" style="cursor:pointer"><span style="flex:1">Normal <span class="ds">your steed\u2019s true coat</span></span>${!on?'<span style="color:#23517d">equipped</span>':''}</div>`;
      }
      // ── equipped village gear ──
      const gearRows=Object.keys(PET_GEAR).filter(k=>player.petGear&&player.petGear[k]);
      if(gearRows.length){
        html += `<div class="gm-sectitle" style="margin-top:6px">Companion Gear <span class="ds">(one collar · one charm)</span></div>`;
        gearRows.forEach((k,gi)=>{ const g=PET_GEAR[k]; const eq=player.pet.equip&&player.pet.equip[g.slot]===k; const cur=menu.cursor===gi;
          const b=g.bonus, parts=[]; if(b.atk)parts.push(`+${b.atk} atk`); if(b.def)parts.push(`+${b.def} def`); if(b.maxHp)parts.push(`+${b.maxHp} hp`); if(b.crit)parts.push(`+${Math.round(b.crit*100)}% crit`);
          html += `<div class="gm-item ${cur?'cur':''} ${eq?'equipped':''}" data-menurow="${gi}">${g.emoji} <span style="flex:1;pointer-events:none">${g.name} <span class="ds">[${g.slot}] ${parts.join(' ')}</span></span>${eq?'<span style="color:#23517d;pointer-events:none">equipped</span>':''}</div>`; });
      }
      // ── the companion's own skill tree (moved here from the Skills tab) ──
      html += `<div class="gm-stat" style="margin-top:6px;border-top:1px solid #b9a880;padding-top:6px"><span>★ Skill Points to spend</span><b style="color:#7a5c28">${player.skillPoints}</b></div>`;
      let ri2=gearRows.length;
      for(const bk in PET_TREE){ const br=PET_TREE[bk];
        html += `<div class="gm-branch"><div class="gm-sectitle" style="color:${br.color}">${br.icon} ${br.name}</div>`;
        for(const n of br.nodes){ const owned=player.skills[n.id]; const cur=(menu.cursor===ri2); const can=canBuySkill(n.id);
          const cls = owned?'owned':(cur?'cur':(can?'':'locked'));
          html += `<div class="gm-node ${cls}" data-menurow="${ri2}"><span class="nm" style="pointer-events:none">${n.name} <span class="ds">${n.desc}</span></span>`
            + (owned?`<span style="color:#2f5434;pointer-events:none">✓</span>`:`<span style="color:#7a5c28;pointer-events:none">${n.cost}★</span>`)+`</div>`;
          ri2++;
        }
        html += `</div>`;
      }
    }
  } else if(menu.tab===TAB.map){ // MAP — fog-of-war world map
    html += `<div style="position:relative">`
      + `<canvas id="bigmap" width="${WORLD_W}" height="${WORLD_H}" style="width:100%;image-rendering:pixelated;border:1px solid #b9a880;border-radius:3px;background:#e8dcbb;display:block"></canvas>`
      + `<div id="maptip" style="display:none;position:absolute;pointer-events:none;background:rgba(10,4,14,.94);border:1px solid #b9a880;border-radius:3px;font-size:7px;padding:3px 7px;z-index:5;white-space:nowrap"></div></div>`
      + `<div style="font-size:6px;color:#665639;margin-top:7px;line-height:1.9;text-align:center">`
      + (abaddon.won ? `🗺️ Abaddon has fallen — the whole of Luminar lies open.` : `Fog hides the lands you have not yet walked.`)
      + `<br>🔴 you · 🟡 towns — hover / tap a town: <span style="color:#2f5434">green = cleansed</span>, <span style="color:#8f2a20">red = still bound</span></div>`;
  } else if(menu.tab===TAB.home){ // HOME — decoration inventory + placement
    const rows=menuRows();
    const here=inHomestead(Math.floor((player.x+TILE/2)/TILE),Math.floor((player.y+TILE/2)/TILE));
    html += `<div class="gm-stat"><span>🏡 The Homestead</span><b>${homesteadDecor.placed.length} placed · ${rows.length} kinds in store</b></div>`;
    if(!here) html += `<div style="font-size:7px;color:#7a5c28;margin:4px;line-height:1.8">You are away from home — travel to the Homestead to place decorations.</div>`;
    html += `<div class="gm-sectitle">Decorations</div>`;
    if(!rows.length) html += `<div class="gm-item" style="opacity:.5">— none yet — hooded strangers pay in these —</div>`;
    rows.forEach((r,idx)=>{ const it=DECOR_ITEMS[r.id]; const cur=menu.cursor===idx;
      html += `<div class="gm-item ${cur?'cur':''}" data-menurow="${idx}">${it.emoji} <span style="flex:1;pointer-events:none">${it.name} ×${homesteadDecor.inv[r.id]} <span class="ds">${it.w}×${it.w} tiles</span></span>${here?'<span style="color:#2f5434;pointer-events:none">place</span>':''}</div>`; });
    if(homesteadDecor.placed.length){
      html += `<div class="gm-sectitle" style="margin-top:6px">Placed on your land</div>`;
      homesteadDecor.placed.forEach(p=>{ const it=DECOR_ITEMS[p.id];
        html += `<div style="font-size:8px;color:#4a5a44;margin:2px 4px">${it.emoji} ${it.name}</div>`; });
    }
    html += `<div style="font-size:7px;color:#665639;margin:8px 4px;line-height:1.8">Ⓐ a decoration to start placing · face open grass, Ⓐ sets it down, Ⓑ stows it.<br>Press Ⓐ at a placed piece any time to pick it back up.</div>`;
  // _legacy: `} else {` — a bare else catches every tab NOT named in the chain.
  //   Quests is handled by its own `if` above and never joins this chain, so it
  //   fell through here and had the save-profile block stapled onto the bottom
  //   of the quest log. Name the tab instead of relying on position.
  } else if(menu.tab===TAB.system){ // SYSTEM (save profiles)
    const rows=menuRows();
    html += `<div class="gm-stat"><span>Playing</span><b>Slot ${activeSlot} · ${player.name||'Knight'} · Lv ${player.level} · ${Object.keys(chapelProgress).filter(k=>chapelProgress[k]).length}/10</b></div>`;
    html += `<div class="gm-stat"><span>Time</span><b>${phaseIcon()} Day ${dayClock.day} · ${clockHHMM()} · ⏱ ${fmtPlay(playMs)} played</b></div>`;
    html += `<div class="gm-sectitle" ${menu.erase?'style="color:#8f2a20"':''}>${menu.erase?'⚠ Choose a slot to erase':'Save Profiles'}</div>`;
    rows.forEach((r,idx)=>{ const cur=menu.cursor===idx;
      let label='', note='';
      if(r.kind==='sys' && r.id==='sfx'){
        label=`${audio.sfxOn?'🔊':'🔇'} Sound FX  <span style="letter-spacing:1px;color:${audio.sfxOn?'#2f5434':'#665639'}">${volBar(audio.sfxVol)}</span>  ${audio.sfxOn?Math.round(audio.sfxVol*100)+'%':'OFF'}`;
        note='swords, steps, doors, demons… — Ⓐ to change'; }
      else if(r.kind==='sys' && r.id==='music'){
        label=`${audio.musicOn?'🎵':'🔇'} Music  <span style="letter-spacing:1px;color:${audio.musicOn?'#2f5434':'#665639'}">${volBar(audio.musicVol)}</span>  ${audio.musicOn?Math.round(audio.musicVol*100)+'%':'OFF'}`;
        note='the realm\'s travelling themes — Ⓐ to change'; }
      else if(r.kind==='sys' && r.id==='save'){ label='💾 Save Game'; note=`write your progress to Slot ${activeSlot}`; }
      else if(r.kind==='sys' && r.id==='export'){ label='📤 Export Save Code'; note='back up this hero as a code you can keep'; }
      else if(r.kind==='sys' && r.id==='import'){ label='📥 Import Save Code'; note='restore a hero from a code (into this slot)'; }
      else if(r.kind==='sys' && r.id==='erase'){ label=menu.erase?'✖ Cancel':'🗑 Erase a slot…'; note=menu.erase?'leave erase mode':'clear a profile to start fresh'; }
      else { const inf=slotInfo(r.n); const star=r.n===activeSlot?' ★':'';
        if(menu.confirmErase===r.n){ label=`⚠ Slot ${r.n} — press Ⓐ again to ERASE`; note='this cannot be undone'; }
        else if(inf){ label=`${r.n===activeSlot?'💾':'📂'} Slot ${r.n}${star} — ${inf.name} · Lv ${inf.level}`;
          note=`${inf.towns}/10 towns${inf.won?' · 👑 Abaddon slain':''} · ⏱ ${fmtPlay(inf.playMs)} · ${menu.erase?'erase this profile':(r.n===activeSlot?'save here':'switch to this hero')}`; }
        else { label=`🆕 Slot ${r.n}${star} — Empty`; note=menu.erase?'nothing to erase':'begin a brand-new journey'; }
      }
      html += `<div class="gm-node ${cur?'cur':''}" data-menurow="${idx}"><span class="nm" style="pointer-events:none">${label} <span class="ds">${note}</span></span></div>`; });
    html += `<div style="font-size:7px;color:#665639;margin:8px 4px;line-height:1.8">Profiles live in this browser on this device. <b style="color:#5c3f7a">On phones, saves can be wiped when you reopen a downloaded file</b> — if progress isn't sticking, use <b>📤 Export Save Code</b> to back up, and <b>📥 Import</b> to restore (works across devices too). Auto-saves to the active slot on entering/leaving towns.</div>`;
  }
  const actLbl = menu.tab===TAB.skills?'buy skill':menu.tab===TAB.items?'use / equip':menu.tab===TAB.pet?'buy skill':menu.tab===TAB.system?'select':menu.tab===TAB.home?'place':'—';
  // the hint names only the keys that do something RIGHT NOW — which half of
  // the screen the d-pad drives depends on where focus sits.
  html += `</div></div><div class="gm-hint">`
    + (menu.focus==='rail'
        ? `▲▼ tab · Ⓐ open · ☰/M or Ⓑ close`
        : `▲▼ select · Ⓐ ${actLbl} · Ⓑ back to tabs · ☰/M close`)
    + `</div>`;
  // _legacy (v92): gmEl().innerHTML = html; then cur.scrollIntoView({block:'nearest'})
  //   Assigning innerHTML destroys the scroller, so scrollTop fell to 0 on EVERY
  //   re-render and scrollIntoView then yanked the cursor back from the top. On
  //   the Pet and Skills trees — long lists you re-render on every purchase —
  //   that threw you back up the page after each point spent. Carry the scroll
  //   across a re-render of the SAME tab; only a tab change starts at the top.
  const paneWas = gmEl().querySelector('.gm-pane');
  const keepTop = (paneWas && menu._paintedTab===menu.tab) ? paneWas.scrollTop : 0;
  gmEl().innerHTML = html;
  menu._paintedTab = menu.tab;
  if(menu.tab===TAB.map) initBigMap();
  // a tab with no selectable rows can never hold focus — don't strand the d-pad
  if(menu.focus==='list' && !menuRows().length) menu.focus='rail';
  const pane = gmEl().querySelector('.gm-pane');
  if(pane) pane.scrollTop = keepTop;
  // Nudge only if the cursor actually fell outside the visible band, and move
  // the PANE rather than calling scrollIntoView, which also scrolls ancestors.
  // _legacy: document.querySelector('#gamemenu .gm-node.cur, #gamemenu .gm-item.cur')
  //   That returns the FIRST match in document order, not the row the cursor is
  //   on — on the Pet tab it picked up a .gm-item.cur above the tree and the
  //   nudge computed -424px. Address the row by its cursor index instead, and
  //   look only inside the pane so nothing outside it can ever match.
  const cur = pane && pane.querySelector('[data-menurow="'+menu.cursor+'"]');
  if(cur && pane){
    // Rects, not offsetTop: .gm-pane is position:static, so offsetParent is
    // #gamemenu and offsetTop is measured from there — comparing it against the
    // pane's own scrollTop mixes two coordinate spaces and the nudge never fires.
    const cr=cur.getBoundingClientRect(), pr=pane.getBoundingClientRect();
    if(cr.top < pr.top) pane.scrollTop += cr.top - pr.top - 4;
    else if(cr.bottom > pr.bottom) pane.scrollTop += cr.bottom - pr.bottom + 4;
  }
}
// _legacy (v92): ◀▶ always changed tab and ▲▼ always moved the row.
//   if(dx!==0){ menu.tab=(menu.tab+dx+MENU_TABS.length)%MENU_TABS.length; ... }
//   if(dy!==0){ const rows=menuRows(); if(rows.length){ menu.cursor=(menu.cursor+dy+rows.length)%rows.length; } }
// Now ▲▼ drives whichever half holds focus. ◀▶ still changes tab from
// anywhere, so nobody who learned the old menu is stranded.
function menuMove(dx,dy){ if(!menu.open) return;
  if(dx!==0) setMenuTab(menu.tab+dx);
  if(dy!==0){
    if(menu.focus==='rail'){ setMenuTab(menu.tab+dy); }
    else { const rows=menuRows(); if(rows.length){ menu.cursor=(menu.cursor+dy+rows.length)%rows.length; } }
  }
  renderMenu();
}
function setMenuTab(i){
  menu.tab=(i+MENU_TABS.length)%MENU_TABS.length;
  menu.cursor=0; menu.erase=false; menu.confirmErase=null;
}
// Ⓐ on the rail steps into the page. A tab with nothing selectable (Character,
// Map) has no list to step into, so focus stays put rather than trapping you.
function menuEnterList(){
  if(menu.focus!=='rail') return false;
  if(!menuRows().length) return false;
  menu.focus='list'; menu.cursor=0; renderMenu(); return true;
}
function menuBackToRail(){
  if(menu.focus!=='list') return false;
  menu.focus='rail'; menu.erase=false; menu.confirmErase=null; renderMenu(); return true;
}
function menuSelect(){ if(!menu.open) return;
  if(menuEnterList()) return;          // Ⓐ on the rail opens the page first
  const rows=menuRows(); const row=rows[menu.cursor]; if(!row) return;
  if(row.kind==='decor'){ startDecorPlace(row.id); return; }
  if(row.kind==='skill'){ if(buySkill(row.id)){ showBanner(`★ Learned ${skillNode(row.id).name}!`, 1200); } else { const n=skillNode(row.id); if(player.skills[row.id]) showBanner('Already learned.',800); else if(player.skillPoints<n.cost) showBanner('Not enough skill points.',1000); else showBanner('Learn the previous tier first.',1200); } }
  else if(row.kind==='petgear'){
    const g=PET_GEAR[row.id]; player.pet.equip=player.pet.equip||{};
    if(player.pet.equip[g.slot]===row.id){ player.pet.equip[g.slot]=null; showBanner(`Removed the ${g.name}.`, 1100); }
    else { player.pet.equip[g.slot]=row.id; showBanner(`${g.emoji} ${g.name} equipped!`, 1100); }
    renderMenu();
  }
  else if(row.kind==='use'){
    const heal=row.id==='potion'?40:15, em=row.id==='potion'?'🧪':'🍞';
    if(player.hp>=player.maxHp) showBanner('Your health is already full. ❤', 1100);
    else { inventory[row.id]--; player.hp=Math.min(player.maxHp, player.hp+heal); sfxPotion();
      showBanner(`${em} +${heal} HP! (${Math.round(player.hp)}/${player.maxHp})`, 1300); }
  }
  else if(row.kind==='gear'){ equipItem(row.id); showBanner(`Equipped ${EQUIP[row.id].name}.`, 1000); }
  else if(row.kind==='sys'){
    if(row.id==='sfx'||row.id==='music'){
      stepVol(row.id==='sfx' ? 'sfx' : 'music');
      sfxMenu(true); renderMenu(); return; }
    if(row.id==='save'){ menu.erase=false; menu.confirmErase=null;
      const r=saveGame(); if(r.ok) showBanner(`💾 Saved to Slot ${activeSlot}!`, 1400);
      else showBanner('⚠️ Could not save here.<br><span style="font-size:7px">This browser blocks storage. Use 📤 Export Save Code to back up.</span>', 2600); }
    else if(row.id==='export'){ openSaveExport(); return; }
    else if(row.id==='import'){ openSaveImport(); return; }
    else if(row.id==='erase'){ menu.erase=!menu.erase; menu.confirmErase=null; }
  }
  else if(row.kind==='slot'){
    const n=row.n, inf=slotInfo(n);
    if(menu.erase){
      if(!inf) showBanner('That slot is already empty.', 1000);
      else if(menu.confirmErase===n){ eraseSave(n); menu.erase=false; menu.confirmErase=null; showBanner(`🗑 Slot ${n} erased.`, 1500); }
      else menu.confirmErase=n;
    }
    else if(!inf){ newGameOnSlot(n); return; }   // fresh journey — intro takes over
    else if(n===activeSlot){ const r=saveGame(); showBanner(r.ok?`💾 Saved to Slot ${activeSlot}!`:'⚠️ Could not save.', 1400); }
    else { setActiveSlot(n); const r=loadGame();
      if(r.ok){ toggleMenu(); showBanner(`📂 Slot ${n} — welcome back, <b>${player.name||'Knight'}</b>!`, 2200); return; }
      else showBanner('⚠️ Load failed.', 1400); }
  }
  renderMenu();
}
// sum all skill bonuses + apply to derived stats (called after level-up, skill buy, equip)
function recalcStats(){
  let atk=player.baseAtk, def=player.baseDef, maxHp=player.baseMaxHp, crit=player.baseCrit;
  let healMult=1, goldMult=1, dmgReduce=0, petBonus=0;
  // level scaling (ported: atk +3/level, def +1.5/level, maxHp +12/level)
  const lv=player.level-1;
  atk += lv*3; def += Math.floor(lv*3/2); maxHp += lv*12;
  // skills (Knight + Pet trees)
  for(const id in player.skills){ if(!player.skills[id]) continue; const n=skillNode(id); if(!n) continue;
    const b=n.bonus; if(b.atk)atk+=b.atk; if(b.def)def+=b.def; if(b.maxHp)maxHp+=b.maxHp; if(b.crit)crit+=b.crit;
    if(b.healMult)healMult+=b.healMult; if(b.goldMult)goldMult+=b.goldMult; if(b.dmgReduce)dmgReduce+=b.dmgReduce;
    if(b.petBonus)petBonus+=b.petBonus; }
  // equipment (added in inventory step)
  if(player.equip){ const w=EQUIP[player.equip.weapon], a=EQUIP[player.equip.armor];
    if(w){ atk+=w.atk||0; if(w.crit)crit+=w.crit; } if(a){ def+=a.def||0; if(a.maxHp)maxHp+=a.maxHp; } }
  // pet companion bonus (scales with its evolution form) + Bond-tree petBonus boost
  if(player.pet){ const f=PETS[player.pet.id].forms[player.pet.form]; const b=f.bonus||{};
    if(b.atk)atk+=b.atk; if(b.def)def+=b.def; if(b.maxHp)maxHp+=b.maxHp; if(b.crit)crit+=b.crit;
    if(b.healMult)healMult+=b.healMult; if(b.dmgReduce)dmgReduce+=b.dmgReduce;
    // petBonus from the Bond branch adds raw points distributed to the pet's main focus stat
    if(petBonus>0){ const focus=PETS[player.pet.id].focus;
      if(focus==='offense') atk+=petBonus; else if(focus==='defense'){ def+=petBonus; maxHp+=petBonus; } else maxHp+=petBonus*2; } }
  const hpRatio = player.maxHp>0 ? player.hp/player.maxHp : 1;
  player.atk=atk; player.def=def; player.crit=Math.min(0.75,crit); player.maxHp=maxHp;
  player.healMult=healMult; player.goldMult=goldMult; player.dmgReduce=Math.min(0.6,dmgReduce);
  player.hp=Math.min(player.maxHp, Math.round(player.maxHp*hpRatio));
}
// light vs heavy swing profiles (ported from legacy RouteScreen weapon profile)
const SWING={ light:{ windup:3, dur:12, reach:1.5, half:Math.PI*0.48, mult:1.0, knock:4 },
              heavy:{ windup:6, dur:18, reach:1.7, half:Math.PI*0.62, mult:1.7, knock:8 } };
// XP needed to reach the NEXT level grows each level
function xpForLevel(lv){ return Math.floor(20 + 7*lv*lv); }   // gentle quadratic — lv12≈1k, lv20≈2.8k per level

// roaming demons spawned in encounter zones (soft gate)
let demons = [];
// ── DEMON HUNT (post-Abaddon): demons stop respawning; a fixed roster remains.
//    hunt.won mirrors abaddon.won (set at victory + on load) so the boot-time
//    spawnDemons() call never touches the later-declared abaddon const. ──
const hunt = { won:false, active:false, done:false, killed:0, total:0, remaining:[] };
function initHuntRoster(){
  hunt.remaining = encounterZones.map(()=>5);
  hunt.total = hunt.remaining.reduce((a,b)=>a+b,0);
  hunt.killed = 0; hunt.done = hunt.total<=0;
}
function huntLeft(){ return hunt.remaining.reduce((a,b)=>a+b,0); }
function ensureAldric(){
  const it = INTERIORS && INTERIORS.home_house;
  if(!it || !it.npcs || it.npcs.some(n=>n.aldric)) return;
  const ex=it.npcs.find(n=>n.name==='Sir Aldric');
  if(ex){ ex.aldric=true; return; }
  it.npcs.push({ floor:0, x:7, y:5, name:'Sir Aldric', aldric:true, lines:["It is truly you, my son."] });
}
function onHuntKill(d){
  bountyProgress('demons',1);          // bounty culls count any wilds demon, any era
  if(!hunt.won || hunt.done) return;
  if(typeof d.zi==='number' && hunt.remaining[d.zi]>0) hunt.remaining[d.zi]--;
  hunt.killed++;
  const left=huntLeft();
  if(left<=0){ hunt.done=true; hunt.active=false; ensureMarshals();
    showBanner('\ud83c\udfc6 <b>The last wandering demon falls!</b><br><span style="font-size:7px">Word spreads through the realm \u2014 the keeps prepare KNIGHT TOURNAMENTS in your honor.</span>', 4600);
    setTimeout(unlockWagonIfReady, 4800);   // 🛒 the roads are safe — bring out the supply wagon
  } else if(hunt.active){ showBanner('\u2694 Demon Hunt: <b>'+left+'</b> remain', 1200); }
}
// ── BOUNTY BOARD: hooded strangers wait in every inn, offering up to three
//    concurrent bounties — demon culls any time, tournament glory once the
//    Demon Hunt is done. Progress shows in the Quests tab; finished bounties
//    turn in at ANY stranger for gold, gear, or Homestead decorations. ──
const BOUNTY_CAP = 3;
const DECOR_ITEMS = {   // kind → drawDecor case · w → footprint tiles · all solid
  scarecrow:{name:'Scarecrow',      emoji:'🎃', kind:'scarecrow',   w:1},
  fountain: {name:'Stone Fountain', emoji:'⛲', kind:'fountain',    w:2},
  banner:   {name:'Kingdom Banner', emoji:'🚩', kind:'banner2',     w:1},
  flowerbed:{name:'Flowerbed',      emoji:'🌷', kind:'planter',     w:1},
  angel:    {name:'Angel Statue',   emoji:'🕊️', kind:'angelStatue', w:1},
  lamppost: {name:'Lamp Post',      emoji:'🏮', kind:'lantern',     w:1},
  haybale:  {name:'Hay Cart',       emoji:'🌾', kind:'haycart',     w:2},
  sapling:  {name:'Apple Sapling',  emoji:'🌳', kind:'sapling',     w:1},
  champion_cross:{name:"Champion's Cross", emoji:'✝️', kind:'crossSword', w:1},
};
const BOUNTY_GEAR_POOL = ['ironsword','warhammer','chainmail','greatsword','platemail','holyblade'];
const BOUNTY_TITLES = {
  demons: ['Purge the Wilds','The Roads Made Straight','A Watchman\u2019s Plea','Light Against the Dark'],
  tourney:['Glory of the Lists','A Champion\u2019s Proof','Honor of the Keeps'],
};
const bounties = { active:[], complete:[], nextId:1, perTown:{}, pretenderUnlocked:false, pretenderDefeated:false, portalsOpen:false, madisonTaken:false, madisonRescued:false, matthewIntercept:false };
// ── THE THREE PORTALS: one at each southern-island summit. They only appear
//    once the pretender is cast down (bounties.portalsOpen). The first (Mistral)
//    is enterable immediately; the others stay SEALED until the prior world is
//    cleared. `unlocked` = the way is open; `cleared` = that world is finished. ──
const PORTALS = [
  { id:'mistral', tx:40,  ty:270, world:1, unlocked:true,  cleared:false, name:'Mistral Gate' },
  { id:'tabor',   tx:95,  ty:274, world:2, unlocked:false, cleared:false, name:'Tabor Gate'   },
  { id:'sunfall', tx:155, ty:270, world:3, unlocked:false, cleared:false, name:'Sunfall Gate' },
];
function portalById(id){ return PORTALS.find(p=>p.id===id); }
// ── MISTRAL PROGRESS: non-respawning kill/clear state, persisted to save so a
//    slain fallen-knight stays dead across leaving and re-entering the world. ──
const mistralProgress = { villages:{}, wanderersDown:0 };
// ── TABOR PROGRESS: the five rescues, persisted so a heart once warmed stays warm. ──
const taborProgress = { rescues:{}, hopeAll:false };
// ── SUNFALL PROGRESS: five lighthouse lamps, each with a fallen Captain of the
//    Watch. captainDown and lit persist — a lamp once kindled stays kindled. ──
const sunfallProgress = { lamps:{}, dawn:false, spans:{}, caches:{}, timber:0, waystations:{}, tiers:{}, metPilgrims:{}, debris:{}, pretenderDown:false, homecoming:false };
// ── RUBBLE: masonry shaken loose off the towers, lying across the promenade. Walk
//    into a block to shove it one tile. Push it over the brink and it is gone for
//    good. Positions persist, so a puzzle half-solved stays half-solved. ──
// ── UPDRAFT SKIFFS: a moored glider at the end of every arm. The thermals off the
//    isles run outward, so a skiff will carry you back to the mouth of the spiral
//    — and from the mouth, out again to the deepest tier you have reached. It is
//    the long walk made optional once you have earned it. ──
let skiff=null;   // {t0, toTier, fired}
// ── WIND-BLOWN PILGRIMS: people caught out on the ledges when the sun stopped.
//    They are not quest-givers — they are the reason the road matters. Speak once
//    and they tell you what they are doing out here; each carries a verse. ──
const SUNPILGRIMS = [
  { id:'pil1', ring:1, outfit:'peasantF', name:'A lamplighter\u2019s widow', lines:[
    'My husband climbed that tower every evening of his life to light it. Then the evening never came, and there was nothing to light.',
    'I still walk up at the hour he used to. Habit is a kind of faith, I think. A poor kind. But it kept me walking.'], verse:{ref:'Lamentations 3:22-23', text:'It is of the LORD\u2019s mercies that we are not consumed, because his compassions fail not. They are new every morning: great is thy faithfulness.'} },
  { id:'pil2', ring:2, outfit:'child', name:'A boy with a kite', lines:[
    'Mother says not to go near the rail. But the wind comes UP here, sir — up, not down. You can lean on it.',
    'If the sun ever goes down, do the stars come? I\u2019ve heard of stars. I should like to see one before I\u2019m grown.'], verse:{ref:'Psalm 8:3-4', text:'When I consider thy heavens, the work of thy fingers, the moon and the stars, which thou hast ordained; what is man, that thou art mindful of him?'} },
  { id:'pil3', ring:3, outfit:'monk', name:'A hooded almoner', lines:[
    'I came out to bring bread to the watchmen. I found their braziers burning and their posts empty. So I have been keeping the fires instead.',
    'The Pretender does not forbid mercy. He simply built a city where there is nothing left to be merciful about. That is the cleverer cruelty.'], verse:{ref:'Isaiah 21:11-12', text:'Watchman, what of the night? The watchman said, The morning cometh, and also the night.'} },
  { id:'pil4', ring:4, outfit:'peasant', name:'An old mason', lines:[
    'I cut the stone for these rails, knight. Sixty years of it. I know every course by the feel of my thumb.',
    'And I will tell you what they never tell you — a wall is not for keeping things out. A wall is so that a frightened man can walk near the edge.'], verse:{ref:'Proverbs 18:10', text:'The name of the LORD is a strong tower: the righteous runneth into it, and is safe.'} },
  { id:'pil5', ring:5, outfit:'child', name:'A girl facing inward', lines:[
    'That is Vesper, there across the gulf. My sister went in through the gate and did not come out. They all go in shining and come out gold.',
    'You are going too, aren\u2019t you. Everyone does in the end. — Then take this, and come back out again. Somebody ought to.'], verse:{ref:'Revelation 21:23', text:'And the city had no need of the sun, neither of the moon, to shine in it: for the glory of God did lighten it.'} },
];
function sunDeepestTier(){ let d=1; for(let k=1;k<=5;k++) if(sunfallProgress.tiers['t'+k]) d=k; return d; }
// ── WAYSTATIONS: a watchman's brazier on every arm. Rest at one to be healed and
//    to read the verse cut into its plinth. The first visit gives the scripture;
//    after that it stays a place to bind wounds on the long walk inward. ──
const SUNWAYS = {
  way1:{ name:'The Windward Brazier', verse:{ ref:'Psalm 121:8', text:'The LORD shall preserve thy going out and thy coming in, from this time forth, and even for evermore.' } },
  way2:{ name:'The Watchman\u2019s Rest',   verse:{ ref:'Psalm 130:6', text:'My soul waiteth for the Lord more than they that watch for the morning: I say, more than they that watch for the morning.' } },
  way3:{ name:'The Pilgrim\u2019s Fire',    verse:{ ref:'Hebrews 11:13', text:'These all died in faith, not having received the promises, but having seen them afar off, and were persuaded of them, and embraced them, and confessed that they were strangers and pilgrims on the earth.' } },
  way4:{ name:'The Lampless Shrine',  verse:{ ref:'Psalm 27:1', text:'The LORD is my light and my salvation; whom shall I fear? the LORD is the strength of my life; of whom shall I be afraid?' } },
  way5:{ name:'The Last Brazier',     verse:{ ref:'2 Peter 1:19', text:'Ye do well that ye take heed, as unto a light that shineth in a dark place, until the day dawn, and the day star arise in your hearts.' } },
};
// ── BROKEN SPANS: two stretches of the spiral have fallen away into the sky. A
//    timber cache waits back along the ledge; carry a bundle to the brink and
//    lay the planks yourself. Repairs persist — a mended span stays mended. ──
const SUNSPANS = {
  span1:{ ring:1, verse:{ ref:'Psalm 40:2', text:'He brought me up also out of an horrible pit, out of the miry clay, and set my feet upon a rock, and established my goings.' } },
  span3:{ ring:3, verse:{ ref:'Ezekiel 22:30', text:'And I sought for a man among them, that should make up the hedge, and stand in the gap before me for the land.' } },
  span5:{ ring:5, verse:{ ref:'Isaiah 35:8', text:'And an highway shall be there, and a way, and it shall be called The way of holiness.' } },
  span2:{ ring:2, verse:{ ref:'Isaiah 58:12', text:'And they that shall be of thee shall build the old waste places: thou shalt raise up the foundations of many generations; and thou shalt be called, The repairer of the breach, The restorer of paths to dwell in.' } },
  span4:{ ring:4, verse:{ ref:'Nehemiah 2:18', text:'Let us rise up and build. So they strengthened their hands for this good work.' } },
};
function sunLamp(id){ if(!sunfallProgress.lamps[id]) sunfallProgress.lamps[id]={captainDown:false, lit:false}; return sunfallProgress.lamps[id]; }
function sunfallLitCount(){ return ['lamp1','lamp2','lamp3','lamp4','lamp5'].filter(k=>sunLamp(k).lit).length; }
// ══ THE PRETENDER'S LAST STAND — the mirror throne at the top of the cathedral.
//    He speaks in the language the mountain taught: BLUE burns and can be held on
//    a shield; RED cannot. At half strength he casts the MIRROR — a false-gold
//    double of the knight — and when it falls, his next blue tell is a LIE. The
//    false light, made combat. ══
const sunBoss = { phase:'idle', boss:null, cine:null };
function tabRescue(id){ if(!taborProgress.rescues[id]) taborProgress.rescues[id]={done:false,stage:0}; return taborProgress.rescues[id]; }
function taborDoneCount(){ return ['beset','buried','hearth','ledge','eden'].filter(k=>tabRescue(k).done).length; }
function mistVil(id){ if(!mistralProgress.villages[id]) mistralProgress.villages[id]={ guardsDown:0, squareClear:false, cleared:false, lostTotal:0, lostGathered:0, herdDone:false }; return mistralProgress.villages[id]; }
function portalAt(tx,ty){ return PORTALS.find(p=>p.tx===tx && p.ty===ty); }
// which town each inn interior belongs to (shares the CHAPEL_TOWN prefix scheme).
// Hellgate (town 9) has no inn — it is the final citadel — so the pretender gate
// counts the nine inn-towns only.
const INN_TOWN = { inn:0, ih_inn:1, sm_inn:2, tw_inn:3, dh_inn:4, cp_inn:5, af_inn:6, sg_inn:7, sh_inn:8 };
const BOUNTIES_PER_TOWN = 3;   // completed bounties required in each cleansed town
function bountyTownDone(t){ return bounties.perTown[t]||0; }
function cleansedInnTowns(){   // towns that are both cleansed AND have an inn (0-8)
  return Object.values(INN_TOWN).filter((t,i,a)=>a.indexOf(t)===i).filter(t=>chapelProgress[t]);
}
function pretenderReady(){     // every cleansed inn-town has met the per-town quota
  const towns=cleansedInnTowns();
  return towns.length>0 && towns.every(t=>bountyTownDone(t)>=BOUNTIES_PER_TOWN);
}
function checkPretenderUnlock(){
  if(bounties.pretenderUnlocked || bounties.pretenderDefeated) return;
  if(!hunt.done || !chapelProgress.abaddon) return;    // only after Abaddon has fallen
  if(!pretenderReady()) return;
  bounties.pretenderUnlocked=true; saveGame();
  showBanner('👁 <b style="color:#c96">A hooded stranger grips your arm.</b><br><span style="font-size:7px">\u201cThe pit does not leave its crown unclaimed. One has taken Abaddon\u2019s throne and calls himself king. Come to any inn hearth when you are ready to end him.\u201d</span>', 6000);
}
const homesteadDecor = { inv:{}, placed:[] };

// ════════════════════════════════════════════════════════════════
//  🛒 THE SUPPLY WAGON — unlocks once the roads are at peace (hunt done).
//  Park it at the barn's wagon-bay, load it with your harvest & catch, then
//  hitch the Old Mule and DRIVE it out to the cleansed towns to fill standing
//  supply requests for gold (scaled by distance) + occasional decor & seeds.
// ════════════════════════════════════════════════════════════════
const WAGON_HOME = { x:19, y:148 };                 // the bay tile the wagon parks on
const WAGON_CAP = 12;                                // crates it can carry
const wagon = { unlocked:false, x:WAGON_HOME.x, y:WAGON_HOME.y, cargo:{}, announced:false };
// goods the wagon can haul (farm + fishable), with a per-crate base payout
// _legacy (v92): ['wheat','perch','trout','oasisCarp','seabass','kingfish']
// rollDelivery draws from here UNIFORMLY, so adding a crop is the whole of the
// work — the towns start asking for it, the load menu lists it with its demand
// and payout, and the "Also wanted" hook picks it up. It is also what keeps
// mustard from being monocultured: the requests stay mixed whatever you sow.
const WAGON_GOODS = ['wheat','mustard','barley','grapes','perch','trout','oasisCarp','seabass','kingfish'];
// standing delivery requests, one per cleansed town: { good, need, got:0 }
const deliveries = { req:{}, done:0 };
// each town's drop-off point (chapel door) — filled at init from the buildings list
const DELIVERY_POINTS = {};   // townId -> {x,y}
function cargoCount(){ let n=0; for(const k in wagon.cargo) n+=wagon.cargo[k]; return n; }
function player_driving(){ return !!player.driving; }

function rollBounty(town){
  const L=player.level;
  const kinds=['demons']; if(hunt.done) kinds.push('tourney');
  const kind=kinds[Math.floor(Math.random()*kinds.length)];
  const titles=BOUNTY_TITLES[kind];
  const b={ id:bounties.nextId++, kind, got:0, town,
    title:titles[Math.floor(Math.random()*titles.length)] };
  if(kind==='demons'){ b.need=6+3*Math.floor(Math.random()*3); b.reward={gold:b.need*(4+L)};
    b.zone=pickCullZone(); }                        // where the dark will resurface
  else { b.need=1+Math.floor(Math.random()*2); b.reward={gold:30+b.need*(10+2*L)}; }
  const pool=BOUNTY_GEAR_POOL.filter(g=>!player.ownedGear[g]);
  const r=Math.random();
  if(r<0.30 && pool.length) b.reward.gear=pool[Math.floor(Math.random()*pool.length)];
  else if(r<0.60){ const ks=Object.keys(DECOR_ITEMS); b.reward.decor=ks[Math.floor(Math.random()*ks.length)]; }
  return b;
}
function bountyGoalText(b){ return b.kind==='demons'
  ? 'Slay <b>'+b.need+'</b> demons — reported in <b>'+cullZoneName(b)+'</b>'
  : 'Win <b>'+b.need+'</b> tournament'+(b.need>1?'s':''); }
function bountyRewardText(b){
  const parts=['🪙 '+b.reward.gold+' gold'];
  if(b.reward.gear) parts.push(EQUIP[b.reward.gear].emoji+' '+EQUIP[b.reward.gear].name);
  if(b.reward.decor) parts.push(DECOR_ITEMS[b.reward.decor].emoji+' '+DECOR_ITEMS[b.reward.decor].name);
  return parts.join(' · ');
}
function bountyProgress(kind,n){
  let newlyDone=0;
  bounties.active.forEach(b=>{ if(b.kind!==kind || b.got>=b.need) return;
    b.got=Math.min(b.need, b.got+n);
    if(b.got>=b.need) newlyDone++;
  });
  if(newlyDone>0) showBanner('📜 <b>Bounty complete!</b><br><span style="font-size:7px">Seek a hooded stranger at any inn to claim your due.</span>', 2600);
}
function payBounty(b){
  bounties.active=bounties.active.filter(x=>x.id!==b.id);
  const g=Math.max(1,Math.round(b.reward.gold*player.goldMult)); gold+=g;
  let extra='';
  if(b.reward.gear && !player.ownedGear[b.reward.gear]){ player.ownedGear[b.reward.gear]=true;
    extra=' The stranger presses <b>'+EQUIP[b.reward.gear].name+'</b> into your hands.'; }
  else if(b.reward.decor){ homesteadDecor.inv[b.reward.decor]=(homesteadDecor.inv[b.reward.decor]||0)+1;
    extra=' A '+DECOR_ITEMS[b.reward.decor].emoji+' <b>'+DECOR_ITEMS[b.reward.decor].name+'</b> for your Homestead.'; }
  // credit the town this bounty was taken in, toward the pretender's unlock
  if(b.town!==undefined){ bounties.perTown[b.town]=(bounties.perTown[b.town]||0)+1; }
  bounties.complete.push({ title:b.title, txt:bountyRewardText(b) });
  if(bounties.complete.length>20) bounties.complete.shift();
  showBanner('📜 <b>'+b.title+' \u2014 fulfilled.</b><br><span style="font-size:7px">+'+g+' gold.'+extra+'</span>', 4200);
  checkPretenderUnlock();
}
function strangerTalk(town){
  // finished ordinary bounty waiting? pay it first (can only exist post-hunt)
  const fin=bounties.active.find(b=>b.got>=b.need);
  if(fin){ payBounty(fin); return; }
  // ── GATE: bounties are an endgame calling. The stranger offers no work until
  //    Sir Aldric's Demon Hunt is finished — then the bounty board (and, in time,
  //    the Pretender) opens. (Exception: an already-unlocked pretender is handled below.)
  if(!hunt.done && !bounties.pretenderUnlocked){
    const line = !hunt.won
      ? 'The demon king still holds Hellgate. Break his grip on the realm first, knight \u2014 then seek me out.'
      : 'The roads still crawl with the fleeing dark. Finish Sir Aldric\u2019s hunt, and I\u2019ll have work worthy of your blade.';
    showBanner('<b style="color:#c96">Hooded Stranger</b><br><span style="font-size:7px">\u201c'+line+'\u201d</span>', 3400);
    return;
  }
  // the pretender's hunt, once unlocked, is offered at any hearth
  if(bounties.pretenderUnlocked && !bounties.pretenderDefeated){
    if(!bounties.active.some(b=>b.kind==='pretender')){
      const pb={ id:bounties.nextId++, kind:'pretender', got:0, need:1, town,
        title:'The Pretender King', reward:{gold:500} };
      bounties.active.push(pb);
      showBanner('<b style="color:#c96">Hooded Stranger</b><br><span style="font-size:7px">\u201cHe holds the black throne beneath Hellgate, wearing a crown he did not earn. Go down into the Citadel and cast him out. This is the last hunt.\u201d</span>', 5600);
    } else {
      showBanner('<b style="color:#c96">Hooded Stranger</b><br><span style="font-size:7px">The pretender waits beneath Hellgate Citadel. End him, knight.</span>', 3000);
    }
    return;
  }
  if(bounties.active.length>=BOUNTY_CAP){
    showBanner('<b style="color:#fff">Hooded Stranger</b><br><span style="font-size:7px">Your hands are full, knight. Finish what you carry \u2014 the Quests page remembers it all.</span>', 2600);
    return;
  }
  const b=rollBounty(town); bounties.active.push(b);
  if(b.kind==='demons') spawnDemons();              // call the quarry back into its zone now
  // per-town progress hint toward the pretender, if we're in the endgame
  let gate='';
  if(hunt.done && chapelProgress.abaddon && town!==undefined && chapelProgress[town]){
    const d=bountyTownDone(town);
    gate = d>=BOUNTIES_PER_TOWN
      ? '<br><span style="color:#c96">This town\u2019s debt is paid ('+d+'/'+BOUNTIES_PER_TOWN+').</span>'
      : '<br><span style="color:#9a8ab8">'+TOWN_DATA[town].name+': '+d+'/'+BOUNTIES_PER_TOWN+' bounties done.</span>';
  }
  let word='';
  if(b.kind==='demons') word='<br><span style="color:#c96">\u201cWord has come from '+cullZoneName(b)
    +' \u2014 a number of them have crept back into the open. Hunt them down and put an end to them.\u201d</span>';
  showBanner('<b style="color:#fff">Hooded Stranger</b><br><span style="font-size:7px">\u201c'+b.title+'.\u201d '+bountyGoalText(b)+'.'+word+'<br>Reward: '+bountyRewardText(b)+'<span style="color:#9a8ab8"> \u00b7 tracked in Quests</span>'+gate+'</span>', 5600);
}
function ensureStrangers(){
  for(const id in INTERIORS){ const it=INTERIORS[id];
    if(it.theme!=='inn' || !it.npcs || it.npcs.some(n=>n.stranger)) continue;
    const town=INN_TOWN[id];                                        // which town this inn serves
    const f=it.floors[0];
    // find a free walkable corner tile, scanning inward from the bottom-right
    let sx=-1, sy=-1;
    outer: for(let y=f.h-2;y>=1;y--) for(let x=f.w-2;x>=1;x--){
      const t=f.g[y][x];
      if(t!==12) continue;                                         // wood-plank floor only
      if(it.npcs.some(n=>n.floor===0&&n.x===x&&n.y===y)) continue; // not on another npc
      if(f.g[y+1]&&f.g[y+1][x]===9) continue;                      // not blocking the exit
      sx=x; sy=y; break outer;
    }
    if(sx<0) continue;
    it.npcs.push({ floor:0, x:sx, y:sy, name:'Hooded Stranger', stranger:true, town:town, look:'shadeTr',
      lines:['Work for a blade like yours, if you have the stomach.'] });
  }
}
ensureStrangers();
// ── HOMESTEAD CUSTOMIZATION: bounty decorations placeable on the farm. ──
//    Placement lives in the Home menu tab; A confirms on the facing tile,
//    B cancels; press A on a placed piece at the farm to pick it back up.
//    Valid ground = plain grass (tile 0) inside the sanctuary bounds, so
//    pickup simply restores grass — no original-tile bookkeeping needed.
const HS_BOUNDS={x0:8,x1:49,y0:120,y1:177};   // = homesteadSanctuary clearing (relocated to the Fog-Wood pocket)
const decorPlace={active:false,id:null};
function inHomestead(tx,ty){ return tx>=HS_BOUNDS.x0&&tx<=HS_BOUNDS.x1&&ty>=HS_BOUNDS.y0&&ty<=HS_BOUNDS.y1; }
// ── where the homestead SONG plays ─────────────────────────────────────
// Deliberately NOT HS_BOUNDS: that is the decor-placement bounding box, and
// its corners sit out in the dead wood. This traces what homesteadSanctuary
// actually carved — the clearing (main rect + the SE lobe around the pond) —
// plus the flowered approach: west along the road joint at y187, then north up
// the lane at x13, over the creek bridge, into the clearing. Kept a couple of
// tiles wider than the path itself so the verge counts as "on the walkway".
function inHomesteadMusic(tx,ty){
  if(tx>=8 &&tx<=44&&ty>=120&&ty<=163) return true;   // the clearing proper
  if(tx>=28&&tx<=49&&ty>=158&&ty<=177) return true;   // the SE lobe around the pond
  if(tx>=10&&tx<=16&&ty>=164&&ty<=189) return true;   // the lane north to the bridge
  if(tx>=13&&tx<=31&&ty>=185&&ty<=189) return true;   // the run in from the Saltmere road
  return false;
}
function decorFootprintOk(id,tx,ty){
  const it=DECOR_ITEMS[id]; if(!it) return false;
  for(let dy=0;dy<it.w;dy++)for(let dx=0;dx<it.w;dx++){
    const x=tx+dx,y=ty+dy;
    if(!inHomestead(x,y)) return false;
    if(!WORLD[y]||WORLD[y][x]!==0) return false;                 // plain grass only
    if(crops[x+','+y]) return false;
    if(typeof SELL_SPOT!=='undefined'&&(x+','+y)===SELL_SPOT) return false;
    if(buildings.some(b=>b.door&&b.door.x===x&&(b.door.y===y||b.door.y+1===y))) return false;
    if(homesteadDecor.placed.some(p=>{ const pw=DECOR_ITEMS[p.id].w;
      return x>=p.x&&x<p.x+pw&&y>=p.y&&y<p.y+pw; })) return false;
  }
  return true;
}
function placeDecorAt(id,tx,ty){
  if((homesteadDecor.inv[id]||0)<=0 || !decorFootprintOk(id,tx,ty)) return false;
  const it=DECOR_ITEMS[id];
  homesteadDecor.inv[id]--; if(homesteadDecor.inv[id]<=0) delete homesteadDecor.inv[id];
  homesteadDecor.placed.push({id,x:tx,y:ty});
  decorations.push({x:tx,y:ty,kind:it.kind,w:it.w,hs:true});
  for(let dy=0;dy<it.w;dy++)for(let dx=0;dx<it.w;dx++) WORLD[ty+dy][tx+dx]=5;   // solid
  return true;
}
function pickUpDecorAt(tx,ty){
  const pi=homesteadDecor.placed.findIndex(p=>{ const pw=DECOR_ITEMS[p.id].w;
    return tx>=p.x&&tx<p.x+pw&&ty>=p.y&&ty<p.y+pw; });
  if(pi<0) return null;
  const p=homesteadDecor.placed.splice(pi,1)[0], it=DECOR_ITEMS[p.id];
  const di=decorations.findIndex(d=>d.hs&&d.x===p.x&&d.y===p.y); if(di>=0) decorations.splice(di,1);
  for(let dy=0;dy<it.w;dy++)for(let dx=0;dx<it.w;dx++) WORLD[p.y+dy][p.x+dx]=0;  // back to grass
  homesteadDecor.inv[p.id]=(homesteadDecor.inv[p.id]||0)+1;
  return p;
}
let pendingDecorMigration=0;   // v13: count of legacy decorations stowed on load (for a one-time banner)
function migrateHomesteadDecor(){
  // After the v13 Homestead redesign, the clearing moved to a new site. Any
  // decoration whose stored footprint is no longer valid placeable grass inside
  // the (new) HS_BOUNDS is STOWED back to the Home inventory — nothing is lost,
  // nothing is left floating in the old vale / the woods. Current-layout
  // placements pass through untouched, so this is a no-op for post-v13 saves.
  let stowed=0; const kept=[];
  for(const p of (homesteadDecor.placed||[])){
    const it=DECOR_ITEMS[p.id]; if(!it) continue;          // unknown id → drop quietly
    const w=it.w||1; let ok=true;
    for(let dy=0;dy<w&&ok;dy++)for(let dx=0;dx<w&&ok;dx++){
      const x=p.x+dx, y=p.y+dy;
      if(!inHomestead(x,y)) ok=false;
      else if(!WORLD[y]||WORLD[y][x]!==0) ok=false;        // must be plain grass in the redesigned clearing
    }
    if(ok) kept.push(p);
    else { homesteadDecor.inv[p.id]=(homesteadDecor.inv[p.id]||0)+1; stowed++; }
  }
  homesteadDecor.placed=kept;
  if(stowed>0) pendingDecorMigration+=stowed;
}
function syncPlacedDecor(){   // (re)build world entries from the placed list — used on load
  for(let i=decorations.length-1;i>=0;i--){ const d=decorations[i];
    if(!d.hs) continue;
    const it=Object.values(DECOR_ITEMS).find(v=>v.kind===d.kind)||{w:d.w||1};
    for(let dy=0;dy<(d.w||1);dy++)for(let dx=0;dx<(d.w||1);dx++){ if(WORLD[d.y+dy]&&WORLD[d.y+dy][d.x+dx]===5) WORLD[d.y+dy][d.x+dx]=0; }
    decorations.splice(i,1);
  }
  homesteadDecor.placed=homesteadDecor.placed.filter(p=>DECOR_ITEMS[p.id]);
  homesteadDecor.placed.forEach(p=>{ const it=DECOR_ITEMS[p.id];
    decorations.push({x:p.x,y:p.y,kind:it.kind,w:it.w,hs:true});
    for(let dy=0;dy<it.w;dy++)for(let dx=0;dx<it.w;dx++){ if(WORLD[p.y+dy]) WORLD[p.y+dy][p.x+dx]=5; } });
}
// ── 🛒 SUPPLY WAGON logic ───────────────────────────────────────
const WAGON_TOWN_CHAPEL = { 0:'chapel', 1:'ih_chapel', 2:'sm_chapel', 3:'tw_chapel', 4:'dh_chapel',
  5:'cp_chapel', 6:'af_chapel', 7:'sg_cathedral', 8:'sh_chapel', 9:'hg_chapel' };
function ensureDeliveryPoints(){
  for(const tid in WAGON_TOWN_CHAPEL){ if(DELIVERY_POINTS[tid]) continue;
    const b=buildings.find(bb=>bb.id===WAGON_TOWN_CHAPEL[tid]);
    if(b&&b.door){ // drop-off = the tile just below the chapel door (where a wagon can stand)
      DELIVERY_POINTS[tid]={x:b.door.x, y:b.door.y+1, dx:b.door.x, dy:b.door.y }; }
  }
}
// Which town drop-offs the wagon can actually DRIVE to from its bay (computed once,
// cached). The wagon can't cross water/surf, so towns on separate islands (e.g. the
// Hearthvale/Ironhold starting isle) are excluded — no impossible delivery requests.
let _wagonReach=null;
function wagonReachableTowns(){
  if(_wagonReach) return _wagonReach;
  ensureDeliveryPoints();
  const seen=new Set(), q=[[WAGON_HOME.x,WAGON_HOME.y]]; seen.add(WAGON_HOME.x+','+WAGON_HOME.y);
  const drive=(x,y)=>{ if(x<0||y<0||x>=WORLD_W||y>=WORLD_H) return false; const t=WORLD[y][x];
    if(t===20) return false; return WALK.has(t)||t===9||t===12; };
  while(q.length){ const [x,y]=q.pop();
    for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nx=x+dx,ny=y+dy,k=nx+','+ny;
      if(!seen.has(k)&&drive(nx,ny)){ seen.add(k); q.push([nx,ny]); } } }
  const set={};
  for(const tid in DELIVERY_POINTS){ const p=DELIVERY_POINTS[tid];
    if(seen.has(p.x+','+p.y)||seen.has(p.dx+','+p.dy)) set[tid]=true; }
  _wagonReach=set; return set;
}
function townDistance(tid){ const p=DELIVERY_POINTS[tid]; if(!p) return 20;
  return Math.round(Math.hypot(p.x-WAGON_HOME.x, p.y-WAGON_HOME.y)); }
function rollDelivery(tid){
  // pick a good this town wants + a qty; distance nudges qty up a little
  const good=WAGON_GOODS[(Math.random()*WAGON_GOODS.length)|0];
  const dist=townDistance(tid);
  const need=2 + ((Math.random()*3)|0) + (dist>90?1:0);   // 2..5
  deliveries.req[tid]={ good, need, got:0 };
}
function ensureDeliveryRequests(){
  ensureDeliveryPoints();
  const reach=wagonReachableTowns();
  for(let t=0;t<10;t++){ if(chapelProgress[t] && reach[t] && !deliveries.req[t]) rollDelivery(t); }
  // clear any stale request for a town the wagon can't actually reach
  for(const t in deliveries.req){ if(!reach[t]) delete deliveries.req[t]; }
}
// ── 📦 DELIVERY READ-OUTS: what the towns are asking for, and what it pays.
//    The load menu leans on these so the demand is visible at the moment you
//    choose what to haul — the payout spread IS the route decision. ──
function deliveryPay(tid){
  const req=deliveries.req[tid]; if(!req) return 0;
  const g=GOODS[req.good]; if(!g) return 0;
  // mirrors the payout arithmetic in tryDeliver() exactly — keep the two in step
  return Math.round(g.value*req.need*2*(1+townDistance(tid)/60)*(player.goldMult||1));
}
// every open request, richest first: {tid, good, req, left, dist, pay}
function openRequests(){
  const out=[];
  for(let t=0;t<10;t++){ const r=deliveries.req[t];
    if(!r || !chapelProgress[t] || !GOODS[r.good] || !DELIVERY_POINTS[t]) continue;
    out.push({ tid:t, good:r.good, req:r, left:Math.max(0,r.need-r.got),
               dist:townDistance(t), pay:deliveryPay(t) }); }
  out.sort((a,b)=>b.pay-a.pay);
  return out;
}
function unlockWagonIfReady(){
  if(wagon.unlocked) return;
  if(hunt.won && hunt.done){
    wagon.unlocked=true;
    // swap the Old Mule's idle sign for a "hitched & ready" one
    const mk=WAGON_HOME.x+','+WAGON_HOME.y;
    signs[(WAGON_HOME.x)+','+(WAGON_HOME.y)]="🛒 THE SUPPLY WAGON\nHitched and loaded-for-bear. Face it, press Ⓐ\nto load cargo or hitch up and drive.";
    ensureDeliveryRequests();
    if(!wagon.announced){ wagon.announced=true;
      showBanner('🛒 <b>The roads are at peace — your Supply Wagon is ready!</b><br><span style="font-size:7px">Load it at the barn bay, then drive your harvest out to the towns for gold.</span>', 5200); }
  }
}
// A pressed facing the parked wagon → load menu / hitch up
function wagonAtBay(fx,fy){ return wagon.unlocked && !player.driving && fx===wagon.x && fy===wagon.y; }
function openWagonMenu(){
  ensureDeliveryRequests();
  wagonMenu.open=true; wagonMenu.cursor=0; if(menu.open) toggleMenu();
  showBanner('🛒 <b>Supply Wagon</b> — load your goods, then hitch up.', 1400);
}
function startDriving(){
  sfxWagon();
  if(!wagon.unlocked) return;
  if(place.kind!=='overworld'){ showBanner('You can only hitch up in the open world.', 1400); return; }
  player.driving=true; wagonMenu.open=false;
  // stand the knight on the wagon's tile
  player.x=wagon.x*TILE; player.y=wagon.y*TILE; player.dir='down';
  showBanner('🛒 <b>Hitched up!</b> <span style="font-size:7px">Drive with the d-pad — quick on roads, slow on open ground. Water, trees & cliffs block the wagon.<br>Press the 🛒 button (or Ⓑ) to park on solid ground.</span>', 3000);
  updateWagonBtn();
}
function stopDriving(){
  if(!player.driving) return;
  const tx=Math.floor((player.x+TILE/2)/TILE), ty=Math.floor((player.y+TILE/2)/TILE);
  if(!WALK.has(tileAt(tx,ty))){ showBanner('Find solid ground before you park!', 1600); return; }
  player.driving=false; wagon.x=tx; wagon.y=ty;    // the wagon stays where you left it
  showBanner('🛒 You park the wagon and step down.', 1200);
  updateWagonBtn();
}
function toggleDriving(){ if(player.driving) stopDriving(); else if(wagonAtBayOrHere()) startDriving(); }
function wagonAtBayOrHere(){ // allow re-mounting a parked wagon you're standing next to
  const fx=Math.floor((player.x+TILE/2)/TILE), fy=Math.floor((player.y+TILE/2)/TILE);
  return wagon.unlocked && (Math.abs(fx-wagon.x)+Math.abs(fy-wagon.y))<=1;
}
function updateWagonBtn(){ const b=document.getElementById('wagonBtn'); if(!b) return;
  b.style.display = (wagon.unlocked && place.kind==='overworld') ? 'flex' : 'none';
  b.textContent = player.driving ? '🚶' : '🛒';
}
// while driving, A next to a town drop-off delivers the requested good
function tryDeliver(){
  if(!player.driving) return false;
  ensureDeliveryRequests();
  const px=Math.floor((player.x+TILE/2)/TILE), py=Math.floor((player.y+TILE/2)/TILE);
  for(let t=0;t<10;t++){ const p=DELIVERY_POINTS[t]; if(!p||!chapelProgress[t]) continue;
    if(Math.abs(px-p.x)+Math.abs(py-p.y)>1 && Math.abs(px-p.dx)+Math.abs(py-p.dy)>1) continue;
    const req=deliveries.req[t]; if(!req){ rollDelivery(t); return true; }
    const have=wagon.cargo[req.good]||0; const g=GOODS[req.good];
    if(have<=0){ showBanner('📦 '+TOWN_DATA[t].name+' wants <b>'+req.need+' '+g.emoji+' '+g.name+'</b>.<br><span style="font-size:7px">Your wagon carries none. Load some at the barn bay.</span>', 2600); return true; }
    const give=Math.min(have, req.need-req.got);
    wagon.cargo[req.good]-=give; if(wagon.cargo[req.good]<=0) delete wagon.cargo[req.good];
    req.got+=give;
    if(req.got>=req.need){
      const dist=townDistance(t); const mult=1+dist/60;             // farther = better pay
      const payGold=Math.round(g.value*req.need*2*mult*(player.goldMult||1));
      gold+=payGold; deliveries.done++;
      let extra='';
      // occasional bonus: decoration or seeds
      const roll=Math.random();
      if(roll<0.30){ const decoKeys=Object.keys(DECOR_ITEMS); const dk=decoKeys[(Math.random()*decoKeys.length)|0];
        homesteadDecor.inv[dk]=(homesteadDecor.inv[dk]||0)+1; extra=' A '+DECOR_ITEMS[dk].emoji+' <b>'+DECOR_ITEMS[dk].name+'</b> for your Homestead!'; }
      // _legacy (v92): inventory.wheatSeed=(inventory.wheatSeed||0)+3;
      //   Hardcoded to wheat, which was harmless while planting was free. Now
      //   that seed is spent to sow, this roll is the ONLY way back for a
      //   player who has sown their last coin — so it must never hand out a
      //   seed they cannot use, and it leans to mustard: the smallest seed is
      //   the one that keeps turning up.
      else if(roll<0.60){ const sk=bonusSeedKind(); const C=CROPS[sk];
        inventory[C.seed]=(inventory[C.seed]||0)+3;
        extra=' <b>+3 '+C.emoji+' '+C.name+' seed</b> for the fields.'; }
      showBanner('📦 <b>Delivered to '+TOWN_DATA[t].name+'!</b><br><span style="font-size:7px">+'+payGold+' gold.'+extra+'</span>', 4200);
      rollDelivery(t);   // post a fresh request
      saveGame();
    } else {
      showBanner('📦 '+TOWN_DATA[t].name+': <b>'+req.got+'/'+req.need+' '+g.emoji+'</b> delivered. Bring the rest!', 2400);
    }
    return true;
  }
  return false;
}
const wagonMenu = { open:false, cursor:0 };
function startDecorPlace(id){
  if((homesteadDecor.inv[id]||0)<=0) return;
  const [px2,py2]=[Math.floor((player.x+TILE/2)/TILE),Math.floor((player.y+TILE/2)/TILE)];
  if(!inHomestead(px2,py2)){ showBanner('🏡 Bring your decorations home — this is for the Homestead.',1800); return; }
  decorPlace.active=true; decorPlace.id=id;
  if(menu.open) toggleMenu();
  showBanner('🏡 <b>Placing: '+DECOR_ITEMS[id].emoji+' '+DECOR_ITEMS[id].name+'</b><br><span style="font-size:7px">Face a grassy spot · Ⓐ place · Ⓑ cancel</span>',2600);
}
function decorConfirm(){
  const [fx,fy]=facingTile();
  if(placeDecorAt(decorPlace.id,fx,fy)){
    const left=homesteadDecor.inv[decorPlace.id]||0;
    showBanner('🏡 '+DECOR_ITEMS[decorPlace.id].emoji+' placed!'+(left>0?' ('+left+' more)':''),1400);
    if(left<=0){ decorPlace.active=false; decorPlace.id=null; }
  } else showBanner('Not here — needs open grass on your land.',1200);
}
function decorCancel(){ decorPlace.active=false; decorPlace.id=null; showBanner('Placement stowed.',900); }
// ── KNIGHT TOURNAMENTS (post-hunt): every keep hosts a themed arena.
//    Runs as place.kind==='tourney', mirroring the race minigame conventions. ──
const tourney={active:false,keep:null,mode:null,round:0,foes:[],held:{},px:0,py:0,pdir:'up',swing:0,inv:0,php:0,pmax:0,t:0,ret:null,msg:'',msgT:0};
const TOURNEY_THEMES={
  ih_keep:{name:'Ironhold Grand Melee', floor:'#565660',wall:'#3a3a44',accent:'#8890a2',trim:'#c9cdd6'},
  sg_keep:{name:'Stormgate Trials',     floor:'#46506a',wall:'#2e3646',accent:'#7c8caa',trim:'#a8c0e8'},
  hg_keep:{name:'Redeemed Throne Tourney',floor:'#3a3440',wall:'#28242e',accent:'#8a3e50',trim:'#ff8040'},
};
function ensureMarshals(){
  ['ih_keep','sg_keep','hg_keep'].forEach(id=>{
    if(villagers.some(v=>v.marshal&&v.marshal.keep===id)) return;
    const b=buildings.find(b2=>b2.id===id); if(!b||!b.door) return;
    [['waves',-2],['duel',2]].forEach(([mode,off])=>{
      villagers.push({ x:(b.door.x+off)*TILE, y:(b.door.y+1)*TILE, hx:b.door.x+off, hy:b.door.y+1,
        outfit:'soldier', lines:[], marshal:{keep:id,mode},
        dir:'down', t:0, moving:false, frame:0, ftick:0, wait:99999, tx:b.door.x+off, ty:b.door.y+1 });
    });
  });
}
const tourneyMenu={open:false, keep:null, cursor:0};
const TOURNEY_MODES=[
  {mode:'ladder', label:'🏆 The Grand Tournament', desc:'5 bouts — each foe fiercer than the last'},
  {mode:'duel',   label:'⚔️ Single Duel',          desc:'one champion, one clean contest'},
  {mode:'waves',  label:'🛡️ Grand Melee',          desc:'survive 3 waves of challengers'},
];
function openTourneyMenu(keep){
  if(!hunt.done){ showBanner('The champion eyes you. Finish the Demon Hunt first.',1800); return; }
  tourneyMenu.open=true; tourneyMenu.keep=keep; tourneyMenu.cursor=0; showTourneyMenu();
}
function showTourneyMenu(msg){
  const th=TOURNEY_THEMES[tourneyMenu.keep]||{name:'The Lists'};
  const list=TOURNEY_MODES.map((m,i)=>{ const sel=i===tourneyMenu.cursor; const c=sel?'#ffe04a':'#c8b8e0';
    return `<span data-tmidx="${i}" style="color:${c};display:block;padding:2px 0;cursor:pointer">${sel?'▶ ':'　'}${m.label}<br><span style="font-size:6px;color:#9a8ab8">　${m.desc}</span></span>`; }).join('');
  banner.innerHTML=`<span data-tmclose="1" style="position:absolute;top:1px;right:7px;color:#ff8a8a;font-size:10px;padding:3px 5px;cursor:pointer">✕</span>`+
    `<b style="color:#fff">⚔️ ${th.name}</b><br><span style="font-size:7px;color:#b0a8c0">Choose your contest:</span><br>`+
    `<span style="font-size:8px">${list}</span>`+
    `<br><span style="font-size:6px;color:#8a7aaa">tap a row (or ▲▼ + Ⓐ) · ✕ / Ⓑ to step back</span>`+
    (msg?`<br><span style="font-size:7px;color:#7ad07a">${msg}</span>`:'');
  banner.style.display='block'; banner.style.pointerEvents='auto'; bannerT=999999;
}
function tourneyMenuMove(d){ const n=TOURNEY_MODES.length; tourneyMenu.cursor=(tourneyMenu.cursor+n+d)%n; showTourneyMenu(); }
function tourneyMenuSelect(){ const m=TOURNEY_MODES[tourneyMenu.cursor]; const keep=tourneyMenu.keep; closeTourneyMenu(); startTourney(keep, m.mode); }
function closeTourneyMenu(){ tourneyMenu.open=false; banner.style.display='none'; banner.style.pointerEvents='none'; bannerT=0; }
function startTourney(keep,mode){
  if(!hunt.done){ showBanner('The marshal eyes you. Finish the Demon Hunt first.',1800); return; }
  tourney.active=true; tourney.keep=keep; tourney.mode=mode; tourney.round=1; tourney.rest=false;
  tourney.pmax=player.maxHp; tourney.php=player.maxHp; tourney.t=0; tourney.inv=0; tourney.swing=0;
  tourney.held={}; tourney.pdir='up'; tourney.ret={x:player.x,y:player.y}; tourney.fromKeep=(place.kind==='keep');
  // _legacy: const cw=ctx.canvas.width, chh=ctx.canvas.height;
  // canvas.width is the BACKING STORE. loop() sets ctx.setTransform(RENDER_SCALE,…)
  // so every draw call in the tourney is authored in GAME pixels, which are
  // RENDER_SCALE× smaller. Using the backing size put the knight at y=984 in a
  // 512px-tall arena: off-screen, unable to move or fight. race/boatrace were
  // special-cased during the RENDER_SCALE refactor; tourney was missed.
  const cw=VW, chh=VH;
  tourney.px=cw/2; tourney.py=chh-40;
  tourneyWave(); place={kind:'tourney'};
  const th=TOURNEY_THEMES[keep];
  const blurb = mode==='waves' ? 'Survive 3 waves!'
    : mode==='ladder' ? ('Five bouts, each foe fiercer than the last. Bout 1: '+(tourney.foes[0]&&tourney.foes[0].title||'Challenger')+'!')
    : 'Defeat the keep champion in single combat!';
  showBanner('\u2694 <b>'+th.name+'</b><br><span style="font-size:7px">'+blurb+'</span>',2600);
}
// How many blows a wave knight should stand. Tied to the KNIGHT'S DAMAGE, not to
// his level: foe hp used to scale at 2/level while attack scales at ~3/level, so
// a wave foe died in a single blow at every tier — level 5 or level 45, one hit.
// Reading it off player.atk keeps the fight honest at any gear or level.
const TOURNEY_HITS = 2.2;
// Ⓑ is a GUARD in the lists, not a trapdoor. It used to end the tournament on a
// single stray tap, mid-bout, with no warning — and Ⓑ is the dodge button
// everywhere else in the game, so the muscle memory was actively against you.
// Yielding now takes a deliberate hold.
const TOURNEY_YIELD_MS = 900;
const TOURNEY_PARRY_MS = 220;    // a guard raised THIS recently turns a blow aside
const TOURNEY_GUARD_CUT = 0.30;  // a standing guard blunts a blow to this much
const TOURNEY_LADDER_ROUNDS=5;
// The rank and file of the lists — the knights you meet in the open rounds.
const WAVE_FOES=['A Hedge Knight','A Squire of the Marches','A Sellsword','A Knight of the Vale',
                 'A Tourney Veteran','A Knight Errant'];
const LADDER_FOES=['Squire Bartholomew','Ser Aldwin the Bold','Ser Percival','Dame Cordelia','The Grand Champion'];
function tourneyWave(){
  const L=player.level, cw=VW;   // _legacy: cw=ctx.canvas.width — backing store, RENDER_SCALE× too wide
  tourney.foes=[];
  if(tourney.mode==='waves'){
    // _legacy: kind:'demon' … hp:6+2*L+2*tourney.round
    //   The lists are a contest of KNIGHTS — demons belong in the chapels. And
    //   the old hp formula meant one blow killed at every level.
    const n=1+tourney.round;
    const swing=Math.max(1, Math.round(player.atk));
    const hp=Math.max(10, Math.round(swing*(TOURNEY_HITS + 0.35*(tourney.round-1))));
    for(let i=0;i<n;i++) tourney.foes.push({kind:'rival',x:40+(cw-80)*i/Math.max(1,n-1),y:40,
      hp, maxHp:hp, level:L, t:Math.random()*60, dir:'down', ai:0,
      title:WAVE_FOES[(tourney.round-1+i)%WAVE_FOES.length],
      spd:0.55+0.05*tourney.round, dmg:2+Math.ceil(L/2), alive:true, hurt:0, cd:0});
  } else if(tourney.mode==='ladder'){
    // a bracket of single combats — each challenger fiercer than the last
    const r=tourney.round, hp=18+4*L + r*(7+L);
    tourney.foes.push({kind:'rival',x:cw/2,y:44, hp, maxHp:hp, level:L, t:0,
      spd:0.74+0.13*r, dmg:2+Math.ceil(L*0.5)+r, alive:true, hurt:0, cd:0, ai:0, dir:'down',
      title:LADDER_FOES[Math.min(r-1,LADDER_FOES.length-1)]});
  } else {
    tourney.foes.push({kind:'rival',x:cw/2,y:44, hp:20+5*L, maxHp:20+5*L, level:L, t:0,
      spd:0.9, dmg:3+Math.ceil(L*0.7), alive:true, hurt:0, cd:0, ai:0, dir:'down'});
  }
}
function tourneyHold(d,on){ tourney.held[d]=!!on; }
// Ⓑ held: raise the shield. Raising it starts a parry window — a blow met on the
// rise is turned aside entirely and the striker is thrown back. Keep it up long
// enough and you yield the bout, which is the only way out now.
function tourneyGuard(on){
  if(!tourney.active) return;
  on=!!on;
  if(on && !tourney.guard){ tourney.parry=TOURNEY_PARRY_MS; tourney.yieldT=0; }
  if(!on){ tourney.yieldT=0; tourney.parry=0; }
  tourney.guard=on;
}
function tourneyPress(k){
  if(!tourney.active) return;
  if(tourney.rest){
    if(k==='A'){ tourney.rest=false; tourney.round++;
      tourney.php=Math.min(tourney.pmax, tourney.php+Math.round(tourney.pmax*0.12));
      tourneyWave(); const foe=tourney.foes[0];
      showBanner('⚔ Bout '+tourney.round+' of '+TOURNEY_LADDER_ROUNDS+' — <b>'+(foe.title||'Challenger')+'</b>!',1700); return; }
    if(k==='B'){
      if((inventory.potion||0)>0 && tourney.php<tourney.pmax){ inventory.potion--;
        tourney.php=Math.min(tourney.pmax, tourney.php+Math.round(tourney.pmax*0.4));
        showBanner('🧪 Potion drained — vigor returns! ('+(inventory.potion||0)+' left)',1400); }
      else if((inventory.potion||0)<=0) showBanner('Your potion belt is empty.',1200);
      else showBanner('Already at full strength.',1000);
      return; }
    return;
  }
  // _legacy: if(k==='B'){ exitTourney(false,true); return; }
  //   One tap and the tournament was over. Ⓑ raises the shield now; see
  //   tourneyGuard for the hold-to-yield.
  if(k==='B') return;
  if(k==='A'){
    if(tourney.swing>0) return;
    tourney.swing=12;
    const fv={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]}[tourney.pdir];
    tourney.foes.forEach(fo=>{ if(!fo.alive) return;
      const vx=fo.x-tourney.px, vy=fo.y-tourney.py, dist=Math.hypot(vx,vy);
      if(dist>26) return;
      if(dist>0.001){ const dot=(vx*fv[0]+vy*fv[1])/dist; if(dot<0.15) return; }
      let dmg=Math.max(1,Math.round(player.atk)+(Math.random()*4|0));
      if(Math.random()<player.crit+0.05) dmg=Math.round(dmg*1.8);
      fo.hp-=dmg; fo.hurt=8;
      // ── KNOCKBACK ── the same weapon feel as the field: a short sword taps a
      //    man back, a war hammer throws him. Without it every blade landed
      //    identically and the only difference between weapons was a number.
      { const wk=(SWING[player.weaponType==='heavy'?'heavy':'light']||SWING.light).knock;
        const m=dist||1;
        fo.kx=(vx/m)*wk*0.9; fo.ky=(vy/m)*wk*0.9; fo.knock=8; }
      if(fo.hp<=0){ fo.alive=false; }
    });
    return;
  }
  const m={UP:'up',DOWN:'down',LEFT:'left',RIGHT:'right'}[k];
  if(m) tourney.pdir=m;
}
function tourneyTick(dt){
  if(!tourney.active) return;
  // dt-true physics: f = 1.0 at 60fps. Frame-counted timers ran DOUBLE speed on
  // 120Hz phones and stuttered slow on dropped frames; all durations below are
  // still authored in 60fps-frames, now consumed at true wall-clock rate.
  const f=(dt||16.6667)/16.6667;
  tourney.t+=f;
  if(tourney.rest) return;
  // _legacy: const cw=ctx.canvas.width, chh=ctx.canvas.height;
  // canvas.width is the BACKING STORE. loop() sets ctx.setTransform(RENDER_SCALE,…)
  // so every draw call in the tourney is authored in GAME pixels, which are
  // RENDER_SCALE× smaller. Using the backing size put the knight at y=984 in a
  // 512px-tall arena: off-screen, unable to move or fight. race/boatrace were
  // special-cased during the RENDER_SCALE refactor; tourney was missed.
  const cw=VW, chh=VH;
  const spd=1.5*f; let mvx=0,mvy=0;
  if(tourney.held.UP)mvy-=1; if(tourney.held.DOWN)mvy+=1;
  if(tourney.held.LEFT)mvx-=1; if(tourney.held.RIGHT)mvx+=1;
  if(mvx||mvy){ const n=Math.hypot(mvx,mvy); tourney.px+=mvx/n*spd; tourney.py+=mvy/n*spd;
    tourney.pdir = Math.abs(mvx)>Math.abs(mvy) ? (mvx<0?'left':'right') : (mvy<0?'up':'down'); }
  tourney.px=Math.max(16,Math.min(cw-32,tourney.px));
  tourney.py=Math.max(28,Math.min(chh-24,tourney.py));
  if(tourney.swing>0)tourney.swing-=f;
  if(tourney.inv>0)tourney.inv-=f;
  // the shield, the parry window, and the yield clock
  if(tourney.guard){
    if(tourney.parry>0) tourney.parry-=dt;
    tourney.yieldT=(tourney.yieldT||0)+dt;
    if(tourney.yieldT>=TOURNEY_YIELD_MS){ tourney.guard=false; tourney.yieldT=0;
      showBanner('🏳️ You lower your blade and yield the field.', 1600);
      exitTourney(false,true); return; }
  }
  tourney.foes.forEach(fo=>{
    if(!fo.alive) return;
    fo.t+=f; if(fo.hurt>0)fo.hurt-=f;
    if(fo.cd>0)fo.cd-=f;
    // reeling from the last blow — he gives ground before he comes on again,
    // and is clamped to the sand so a hammer cannot drive him out of the lists
    if(fo.knock>0){
      fo.knock-=f;
      fo.x=Math.max(10, Math.min(VW-10, fo.x+(fo.kx||0)*f));
      fo.y=Math.max(10, Math.min(VH-24, fo.y+(fo.ky||0)*f));
      fo.kx*=0.78; fo.ky*=0.78;
      return;
    }
    const vx=tourney.px-fo.x, vy=tourney.py-fo.y, dist=Math.hypot(vx,vy)||1;
    if(fo.kind==='rival'){
      // ── TELEGRAPH ── he used to drift in and touch you, which gave the guard
      //    and the dodge nothing to answer. He circles, then sets himself
      //    VISIBLY, then commits — and a committed lunge cannot be called back.
      fo.ai=(fo.ai+f)%160;
      fo.wind=(fo.ai>=100 && fo.ai<122)?1:0;
      fo.lunge=(fo.ai>=122)?1:0;
      if(fo.wind){ /* set, and open — the moment to strike or raise the shield */ }
      else if(fo.ai<100){ const tang=Math.atan2(vy,vx)+Math.PI/2;    // circle the knight
        fo.x+=(Math.cos(tang)*fo.spd*0.7 + vx/dist*0.25)*f; fo.y+=(Math.sin(tang)*fo.spd*0.7 + vy/dist*0.25)*f;
      } else { fo.x+=vx/dist*fo.spd*2.1*f; fo.y+=vy/dist*fo.spd*2.1*f; }  // lunge
      fo.dir=Math.abs(vx)>Math.abs(vy)?(vx<0?'left':'right'):(vy<0?'up':'down');
    } else { fo.x+=vx/dist*fo.spd*f; fo.y+=vy/dist*fo.spd*f; }
    fo.x=Math.max(16,Math.min(cw-32,fo.x)); fo.y=Math.max(28,Math.min(chh-24,fo.y));
    if(dist<13 && fo.cd<=0 && tourney.inv<=0){
      // a lunge lands harder than a brush — that is what the guard is FOR
      let dmg=fo.dmg * ((fo.lunge>0)?2:1);
      if(tourney.guard && tourney.parry>0){
        // met on the rise: turned aside, and he is thrown back for his trouble
        dmg=0; fo.cd=70; tourney.inv=30;
        const m=dist||1; fo.kx=(fo.x-tourney.px)/m*9; fo.ky=(fo.y-tourney.py)/m*9; fo.knock=10;
        fo.wind=0; fo.lunge=0;
        sfxClick(); showBanner('🛡 Parried!', 700);
      } else if(tourney.guard){
        dmg=Math.max(1, Math.round(dmg*TOURNEY_GUARD_CUT));
      }
      if(dmg>0){ tourney.php-=dmg; }
      fo.cd=fo.cd||50; if(fo.cd<50) fo.cd=50;
      tourney.inv=Math.max(tourney.inv,40);
      if(tourney.php<=0){ exitTourney(false,false); return; }
    }
  });
  if(tourney.active && tourney.foes.every(f=>!f.alive)){
    if(tourney.mode==='waves' && tourney.round<3){ tourney.round++; tourneyWave();
      showBanner('Wave '+tourney.round+'!',1000); }
    else if(tourney.mode==='ladder' && tourney.round<TOURNEY_LADDER_ROUNDS){ tourney.rest=true; }
    else exitTourney(true,false);
  }
}
function exitTourney(win,fled){
  const th=TOURNEY_THEMES[tourney.keep]||{name:'Tournament'};
  const L=player.level;
  tourney.active=false;
  if(tourney.fromKeep){ if(!keepGrid) buildKeepGrid(); place={kind:'keep'}; if(tourney.ret){ player.x=tourney.ret.x; player.y=tourney.ret.y; } player.dir='up'; }
  else { place={kind:'overworld'}; if(tourney.ret){ player.x=tourney.ret.x; player.y=tourney.ret.y; } spawnDemons(); }
  if(win){
    bountyProgress('tourney',1);
    if(tourney.mode==='ladder'){ const g=60+12*L; gold+=g; gainXp(45+9*L);
      const firstTime=!player.championRobe;
      player.championRobe=true;
      homesteadDecor.inv['champion_cross']=(homesteadDecor.inv['champion_cross']||0)+1;
      showBanner('🏆 <b>'+th.name+' — GRAND CHAMPION!</b><br><span style="font-size:7px">Five bouts, five victories — the Grand Champion falls to your blade! +'+g+' gold.<br>'+(firstTime?'You are girded with the <b>Champion\\u2019s Cross</b> \\u2014 and a cross-forged blade to raise at your Homestead. \u271d\ufe0f':'Another <b>Champion\\u2019s Cross</b> monument awaits at your Homestead.')+'</span>',5200);
    } else if(tourney.mode==='waves'){ const g=20+6*L; gold+=g; gainXp(12+3*L);
      showBanner('\ud83c\udfc6 <b>'+th.name+' \u2014 CHAMPION!</b><br><span style="font-size:7px">The crowd roars! +'+g+' gold, and glory besides.</span>',4200);
    } else { const g=6+2*L; gold+=g; gainXp(26+6*L);
      showBanner('\ud83c\udfc6 <b>'+th.name+' \u2014 DUEL WON!</b><br><span style="font-size:7px">A worthy blade. The heralds sing of you. +'+g+' gold.</span>',4200);
    }
  } else if(fled){ showBanner('You withdraw from the lists. The marshal nods \u2014 another day.',2200); }
  else showBanner('\ud83d\udca5 Bested! The healers tend you \u2014 train and return.',2600);
}
function drawTourney(){
  // _legacy: const cw=ctx.canvas.width, chh=ctx.canvas.height;
  // canvas.width is the BACKING STORE. loop() sets ctx.setTransform(RENDER_SCALE,…)
  // so every draw call in the tourney is authored in GAME pixels, which are
  // RENDER_SCALE× smaller. Using the backing size put the knight at y=984 in a
  // 512px-tall arena: off-screen, unable to move or fight. race/boatrace were
  // special-cased during the RENDER_SCALE refactor; tourney was missed.
  const cw=VW, chh=VH;
  const th=TOURNEY_THEMES[tourney.keep];
  px(0,0,cw,chh,th.floor);
  for(let gx=16;gx<cw;gx+=24) px(gx,10,1,chh-10,'#00000012');
  for(let gy=24;gy<chh;gy+=24) px(0,gy,cw,1,'#00000012');
  px(0,0,cw,10,th.wall); px(0,chh-8,cw,8,th.wall); px(0,0,10,chh,th.wall); px(cw-10,0,10,chh,th.wall);
  for(let bx=20;bx<cw-24;bx+=34){ px(bx,10,10,14,th.accent); px(bx,10,10,2,th.trim); px(bx+4,22,2,2,th.trim); }
  // ── TOURNEY FOE BAR ── a foe health bar you can actually read. Without it a
  //    knight that now stands two or three blows just looks like one that isn't
  //    dying, and you cannot tell a fresh opponent from a nearly-beaten one.
  tourney.foes.forEach(fo=>{ if(!fo.alive) return;
    if(fo.maxHp>0){
      const bw=18, bx=Math.round(fo.x-bw/2), by=Math.round(fo.y)-17;
      const frac=Math.max(0, Math.min(1, fo.hp/fo.maxHp));
      px(bx-1,by-1,bw+2,5,'#0c0a14');
      px(bx,by,bw,3,'#3a2130');
      const w=Math.max(fo.hp>0?1:0, Math.round(bw*frac));
      // it warms as he weakens, so a glance tells you who is nearly done
      const col = frac>0.6 ? '#67c96b' : frac>0.3 ? '#e8c24a' : '#e05a4a';
      px(bx,by,w,3,col);
      px(bx,by,w,1,hexMix(col,'#ffffff',.35));
    }
    if(fo.kind==='demon') drawDemon(fo.x-8,fo.y-8,fo);
    else {
      const rx=fo.x-8, ry=fo.y-8;
      ctx.fillStyle='rgba(0,0,0,.25)'; ctx.beginPath(); ctx.ellipse(fo.x,ry+15,4,2,0,0,7); ctx.fill();
      px(rx+4,ry+12,3,3,'#2a2a34'); px(rx+9,ry+12,3,3,'#2a2a34');
      px(rx+4,ry+5,8,7,th.accent); px(rx+4,ry+5,2,7,th.trim); px(rx+3,ry+5,1,7,'#141c2e'); px(rx+12,ry+5,1,7,'#141c2e');
      px(rx+4,ry+2,8,4,'#9a96a8'); px(rx+4,ry+2,8,1,'#c8c4d4'); px(rx+5,ry+4,6,2,'#1a2740');
      px(rx+3,ry+1,1,5,'#141c2e'); px(rx+12,ry+1,1,5,'#141c2e'); px(rx+4,ry+1,8,1,'#141c2e');
      px(rx+7,ry+0,3,1,th.trim);
      px(rx+13,ry+4,2,6,'#e8e8f0'); px(rx+13,ry+4,1,6,'#ffffff');
      if(fo.hp<fo.maxHp){ px(rx-1,ry-4,14,2,'#3a1018'); px(rx-1,ry-4,Math.max(0,Math.round(14*fo.hp/fo.maxHp)),2,'#ff5a6a'); }
    }
  });
  const kx=tourney.px-8, ky=tourney.py-8;
  const kf=(tourney.held.UP||tourney.held.DOWN||tourney.held.LEFT||tourney.held.RIGHT)?((tourney.t>>3)%2?1:3):0;
  if(tourney.pdir==='right') drawKnightBodyR(kx,ky,'right',kf,0,0,tourney.swing>0);
  else drawKnightBody(kx,ky,tourney.pdir,kf,0,0,tourney.swing>0);
  if(tourney.swing>8){ const fv={up:[0,-14],down:[0,14],left:[-14,0],right:[14,0]}[tourney.pdir];
    ctx.globalAlpha=0.5; px(tourney.px+fv[0]-6,tourney.py+fv[1]-6,12,12,'#fff0b0'); ctx.globalAlpha=1; }
  px(8,chh-20,52,8,'#00000066');
  px(10,chh-18,48,4,'#3a1018'); px(10,chh-18,Math.max(0,Math.round(48*tourney.php/tourney.pmax)),4,'#ff5a6a');
  ctx.fillStyle=th.trim; ctx.font='7px monospace';
  ctx.fillText(th.name+(tourney.mode==='waves'?('  \u2014  WAVE '+tourney.round+'/3'):tourney.mode==='ladder'?('  \u2014  BOUT '+tourney.round+'/'+TOURNEY_LADDER_ROUNDS):'  \u2014  DUEL'), 12, 18);
  if(tourney.mode==='ladder' && !tourney.rest){ const foe=tourney.foes[0];
    if(foe&&foe.title){ ctx.textAlign='center'; ctx.fillStyle='#ffe04a'; ctx.font='7px monospace';
      ctx.fillText('⚔ '+foe.title, cw/2, chh-8); ctx.textAlign='left'; } }
  if(tourney.rest){
    ctx.fillStyle='rgba(8,6,14,.72)'; ctx.fillRect(0,0,cw,chh);
    const bw=Math.min(cw-24,184), bx=(cw-bw)/2, by=chh/2-34;
    px(bx,by,bw,70,'#1a1424'); px(bx,by,bw,2,th.trim); px(bx,by+68,bw,2,'#000');
    ctx.textAlign='center';
    ctx.fillStyle='#7ad07a'; ctx.font='9px monospace'; ctx.fillText('BOUT WON', cw/2, by+16);
    const left=TOURNEY_LADDER_ROUNDS-tourney.round;
    ctx.fillStyle='#c8b8e0'; ctx.font='7px monospace';
    ctx.fillText(left+' challenger'+(left===1?'':'s')+' still to come', cw/2, by+28);
    px(bx+bw/2-30,by+35,60,5,'#3a1018'); px(bx+bw/2-30,by+35,Math.max(0,Math.round(60*tourney.php/tourney.pmax)),5,'#5ad06a');
    ctx.fillStyle='#ffe04a'; ctx.font='7px monospace';
    ctx.fillText('Ⓐ Next Bout    Ⓑ 🧪 Potion ('+(inventory.potion||0)+')', cw/2, by+54);
    ctx.textAlign='left';
  }
}

// ════════════════════════════════════════════════════════════════
//  DAY/NIGHT CLOCK — one full day every 72 real minutes (1 game hour = 3 real min).
//  Midnight is frac 0. Dawn 6-7am, long day 7am-8pm, short dusk 8-9pm, night 9pm-6am.
//  The overworld is tinted by the hour; demons grow bold after dark.
//  playMs = total time played on this save (persisted, shown on save slots).
// ════════════════════════════════════════════════════════════════
const DAY_LEN = 72*60*1000;
let dayClock = { t: DAY_LEN*0.375, day: 1 };   // new journeys begin at 9:00 AM, day 1
let playMs = 0;
let _wasNight = null;
function dayFrac(){ return ((dayClock.t%DAY_LEN)+DAY_LEN)%DAY_LEN/DAY_LEN; }
function isNight(){ const f=dayFrac(); return f>=0.875||f<0.25; }   // night falls at 9 PM
function clockHHMM(){ const f=dayFrac()*24; const h=Math.floor(f), m=Math.floor((f-h)*60);
  const ap=h<12?'AM':'PM'; let hh=h%12; if(hh===0)hh=12;
  return hh+':'+String(m).padStart(2,'0')+ap; }
function phaseIcon(){ const f=dayFrac();
  if(f>=0.25&&f<0.292) return '\ud83c\udf05';      // dawn 6-7am
  if(f>=0.292&&f<0.833) return '\u2600\ufe0f';     // long day 7am-8pm
  if(f>=0.833&&f<0.875) return '\ud83c\udf07';     // short dusk 8-9pm
  return '\ud83c\udf19'; }                          // night 9pm-6am
function fmtPlay(ms){ const m=Math.floor(ms/60000), h=Math.floor(m/60);
  return h+'H'+String(m%60).padStart(2,'0')+'M'; }
// overworld tint: rgba keyframes across the day, lerped smoothly
const DAY_TINT = [
  [0.000, 14,18,74, 0.58],   // midnight — commit to the blue, GBA-style
  [0.250, 14,18,74, 0.58],   // pre-dawn ends at 6am
  [0.270, 255,190,110, 0.20],// dawn gold, 6:30am
  [0.292, 255,190,110, 0.00],// morning clear by 7am
  [0.820, 255,150,70,  0.00],// clear until ~7:40pm, then the sun starts to set
  [0.833, 255,140,60,  0.16],// 8:00pm — dusk visibly begins
  [0.855, 255,120,50,  0.30],// 8:30pm — dusk peak (evening-wake lands here)
  [0.885, 14,18,74, 0.58],   // full night by ~9:15pm
  [1.000, 14,18,74, 0.58],
];
function dayTint(){ const f=dayFrac();
  let a=DAY_TINT[0], b=DAY_TINT[DAY_TINT.length-1];
  for(let i=0;i<DAY_TINT.length-1;i++){ if(f>=DAY_TINT[i][0]&&f<=DAY_TINT[i+1][0]){ a=DAY_TINT[i]; b=DAY_TINT[i+1]; break; } }
  const span=(b[0]-a[0])||1, k=(f-a[0])/span, L=i=>a[i]+(b[i]-a[i])*k;
  const al=L(4); if(al<=0.004) return null;
  return 'rgba('+Math.round(L(1))+','+Math.round(L(2))+','+Math.round(L(3))+','+al.toFixed(3)+')'; }
// ── night empowers the roaming demons: +2 levels, hp scaled, richer xp ──
const NIGHT_LVL_BOOST = 2;
function applyNightDemons(on){
  demons.forEach(d=>{ if(!d.alive||d.boss) return;
    if(on && !d.nightBuff){ d.nightBuff=true; d.level+=NIGHT_LVL_BOOST;
      const r=d.hp/d.maxHp; d.maxHp=5+d.level*2; d.hp=Math.max(1,Math.round(d.maxHp*r)); d.xp=4+d.level*3; }
    else if(!on && d.nightBuff){ d.nightBuff=false; d.level-=NIGHT_LVL_BOOST;
      const r=d.hp/d.maxHp; d.maxHp=5+d.level*2; d.hp=Math.max(1,Math.round(d.maxHp*r)); d.xp=4+d.level*3; }
  });
}
function spawnDemons(){
  demons = [];
  if(hunt.won && hunt.done){                        // the roads are at peace...
    spawnCullDemons();                              // ...except where a cull has called the dark back
    applyNightDemons(isNight());
    return;
  }
  encounterZones.forEach((z,zi)=>{
    const count = hunt.won ? (hunt.remaining[zi]||0) : 5;
    for(let i=0;i<count;i++){
      let tx,ty,tries=0;
      do { tx = z.x0 + Math.floor(Math.random()*(z.x1-z.x0)); ty = z.y0 + Math.floor(Math.random()*(z.y1-z.y0)); tries++; }
      while((!WALK.has(WORLD[ty]?.[tx]) || Math.hypot(tx*TILE-player.x,ty*TILE-player.y)<TILE*8) && tries<40);
      if(tries<40){ const hp=5+z.level*2; demons.push({ x:tx*TILE, y:ty*TILE, hp, maxHp:hp, level:z.level, zi, xp:4+z.level*3, t:Math.random()*60, alive:true, hurt:0, nform:(Math.random()*4)|0 }); }
    }
  });
  applyNightDemons(isNight());   // demons born after dark come out bold
}
spawnDemons();
recalcStats();   // initialize derived stats from base + level + skills + gear

// ════════════════════════════════════════════════════════════════
//  WORLD STATE — overworld vs interior (proven door/floor system)
// ════════════════════════════════════════════════════════════════
let place = { kind:'overworld' };       // or {kind:'interior', id, floor}
let returnStack = [];
function activeGrid(){
  if(place.kind==='overworld') return { w:WORLD_W, h:WORLD_H, g:WORLD };
  if(place.kind==='portalworld') return { w:portalWorld.w, h:portalWorld.h, g:portalWorld.g };
  if(place.kind==='dungeon') return { w:DW, h:DH, g:dungeon.grid };
  if(place.kind==='abaddon') return { w:ABADDON_W, h:ABADDON_H, g:null };
  if(place.kind==='throne') return { w:THALL.W, h:THALL.H, g:null };   // cutscene owns its own draw
  if(place.kind==='keep') return { w:THALL.W, h:THALL.H, g:keepGrid };
  const f = INTERIORS[place.id].floors[place.floor];
  return { w:f.w, h:f.h, g:f.g };
}
function tileAt(tx,ty){ const m=activeGrid(); if(!m.g) return 0; if(tx<0||ty<0||tx>=m.w||ty>=m.h) return place.kind==='dungeon'?1:5; return m.g[ty][tx]; }
// tiles each traversal ability lets you cross (beyond the normal WALK set)
const FLY_PASS  = new Set([1,3,14,15,20,21,29,32,33]);   // trees, water, fences, bushes, surf, swamp, cliffs, rock
const SWIM_PASS = new Set([3,20,21,29]);                  // water, surf, swamp water
// ── TABOR tiles (world 2). 61 ice shelf, 62 frozen falls (solid), 63 Eden ground,
//    64 snowdrift (blocks until cleared), 65 frozen villager (solid until the thaw). ──
const T_ICE=61, T_FALL=62, T_EDEN=63, T_DRIFT=64, T_FROZEN=65;
// harbour pieces: 68 plank pier, 69 hut wall (solid), 70 hut roof (solid),
// 71 lit window (solid), 72 market stall (solid), 73 ice floe (solid), 74 crate/barrel (solid)
const T_PIER=68, T_WALL=69, T_ROOF=70, T_WIN=71, T_STALL=72, T_FLOE=73, T_CRATE=74;
// 75 = the frozen pond the falls cascade into; it becomes the raft's landing basin
// once the mountain thaws, so it is carved now and only re-tiled later.
const T_POND=75;
const T_HUTDOOR=77;                 // a hut's front door (solid — no interiors on Tabor yet)
const SAIL_TILES = new Set([3,20,21,12,32]);             // open water + harbor + bridges a boat may ride

// ── ELEVATION LAYER (sparse; everything defaults to height 0 = flat) ──
// Heights only need to be set on raised regions; the rest of the world stays flat.
// You change height between adjacent tiles only via a STAIR tile (10 up / 11 down)
// or a RAMP. Ledges (cliff tile 32) let you drop DOWN one+ level but not climb.
const ELEV = {};                                  // "x,y" -> integer height (0..n)
let elevActive = false;                            // true once any tile is raised (skips render cost when flat)
// Portal worlds have their own coordinate space, so they need their own height
// map — sharing ELEV would collide with the overworld at the same x,y.
const _FLAT_ELEV = {};   // portal worlds with no heights of their own are FLAT —
                         // never fall back to ELEV, or the overworld's terrain
                         // heights leak in and gate movement at matching x,y.
function elevMap(){ if(place.kind!=='portalworld') return ELEV;
  return portalWorld.elev || _FLAT_ELEV; }
function elevAt(x,y){ const v=elevMap()[x+','+y]; return v===undefined?0:v; }
function setElev(x,y,h){ const M=elevMap(); if(h){ M[x+','+y]=h; elevActive=true; } else delete M[x+','+y]; }
function fillElev(x0,y0,x1,y1,h){ for(let y=y0;y<=y1;y++)for(let x=x0;x<=x1;x++) setElev(x,y,h); }
const STAIR_TILES = new Set([10,11,8]);           // stairs up/down + gate act as height connectors
// Can the player step from (fx,fy) to the adjacent tile (tx,ty)? Considers elevation.
function canStep(fx,fy,tx,ty){
  if(place.kind==='overworld' && barrierAt(tx,ty)!==-1) return false;   // dark barrier — nothing passes
  if(!walkable(tx,ty)) return false;
  if(player.driving && place.kind==='overworld'){ const t=tileAt(tx,ty);
    if(t===20) return false;   // 🛒 the wagon can't ford the shallow surf (on-foot wade only)
  }
  if((place.kind!=='overworld' && place.kind!=='portalworld') || player.mounted || player.boating) return true;   // elevation gates on-foot overworld + portal worlds
  const hf=elevAt(fx,fy), ht=elevAt(tx,ty);
  if(hf===ht) return true;                                       // same level — free
  const tf=tileAt(fx,fy), tt=tileAt(tx,ty);
  // a stair/ramp on either the source or destination bridges a one-level change
  const connector = STAIR_TILES.has(tf)||STAIR_TILES.has(tt);
  if(Math.abs(hf-ht)===1 && connector) return true;
  // ledges (cliff tile 32) let you DROP down (to lower ground) but never climb up
  if(ht<hf && (tt===32 || tf===32)) return true;
  return false;                                                  // unbridged height change → blocked
}
// ── SOLID NPCs ─────────────────────────────────────────────────────────
// Townsfolk occupy their tile so you bump into them rather than sliding
// through — it makes facing one to talk far easier. Only the PLAYER is stopped;
// walkable() stays purely tile-based so pathing and reachability are unaffected.
function npcTileBlocked(tx,ty){
  // a door, exit or stair is never blocked: nothing may seal a room
  const t=tileAt(tx,ty);
  if(t===9 || (typeof STAIR_TILES!=='undefined' && STAIR_TILES.has(t))) return false;
  if(place.kind==='interior'){
    for(const n of activeNpcs()){ if(n.x===tx && n.y===ty) return true; }
    return false;
  }
  if(place.kind==='overworld'){
    for(const v of villagers){
      if(Math.floor((v.x+TILE/2)/TILE)===tx && Math.floor((v.y+TILE/2)/TILE)===ty) return true;
    }
  }
  return false;
}
// ── PUSH-THROUGH ───────────────────────────────────────────────────────
// Townsfolk stop you on contact, but lean on one for a moment and you ease
// past. This is what makes solidity safe: a single NPC standing in a one-tile
// gap would otherwise seal a room (the inns' upper floors and two homes all
// failed exactly that way), and no amount of doorway exemption covers every
// piece of furniture in 52 interiors. With push-through, no arrangement of
// townsfolk can trap the knight anywhere, so solidity costs nothing.
const NPC_PUSH_MS=380;      // lean this long and you slip past
const NPC_PUSH_LAPSE=600;   // stop pushing this long and the attempt resets
const _npcPush=new Map();   // 'tx,ty' -> when the current push began
function npcPushOk(tx,ty){
  const k=tx+','+ty, now=(typeof performance!=='undefined'?performance.now():Date.now());
  const t0=_npcPush.get(k);
  if(t0===undefined || now-t0>NPC_PUSH_LAPSE){ _npcPush.set(k,now); return false; }
  if(_npcPush.size>64) _npcPush.clear();     // it only ever holds a few live tiles
  return (now-t0)>=NPC_PUSH_MS;
}
// the player's own step test: tile rules AND townsfolk
function playerCanStep(fx,fy,tx,ty){
  if(!canStep(fx,fy,tx,ty)) return false;
  // riding or driving, you go around them rather than being stopped by them
  if(player.mounted || player.driving || player.boating) return true;
  if(!npcTileBlocked(tx,ty)) return true;
  return npcPushOk(tx,ty);                   // lean on them and you get through
}
// Erase a stamped building footprint back into whatever ground surrounds it.
// Used when a building is relocated after the world has already been carved —
// without it, the walls and door tile stay behind as a structure the player can
// walk up to, see a door on, and never enter.
function clearFootprint(G,b){
  const counts={};
  const look=(x,y)=>{ const r=G[y]; if(!r) return; const v=r[x]; if(v===undefined) return;
                      if(WALK.has(v)) counts[v]=(counts[v]||0)+1; };
  for(let x=b.x-1;x<=b.x+b.w;x++){ look(x,b.y-1); look(x,b.y+b.h); }
  for(let y=b.y-1;y<=b.y+b.h;y++){ look(b.x-1,y); look(b.x+b.w,y); }
  let fill=0, best=-1;
  for(const k in counts) if(counts[k]>best){ best=counts[k]; fill=+k; }
  for(let y=b.y;y<b.y+b.h;y++) for(let x=b.x;x<b.x+b.w;x++)
    if(G[y]&&G[y][x]!==undefined) G[y][x]=fill;
  if(b.door&&G[b.door.y]&&G[b.door.y][b.door.x]!==undefined) G[b.door.y][b.door.x]=fill;
}
function walkable(tx,ty){
  if(place.kind==='keep'){ if(tx<0||ty<0||tx>=THALL.W||ty>=THALL.H||!keepGrid) return false; return WALK.has(keepGrid[ty][tx]); }
  if(place.kind==='abaddon'){ return tx>=0 && ty>=0 && tx<ABADDON_W && ty<ABADDON_H; }
  if(place.kind==='dungeon'){ const t=tileAt(tx,ty); if(t===1) return false; if(t===T_SEAL) return false; if(t===T_CANDLE||t===T_CANDLE_LIT||t===T_TABLET) return false; if(t===T_LECTERN||t===T_HEARTH||t===T_CHAIR) return false; if(t===T_FALSEWALL||t===T_VERSE) return false; if(t===6) return false; if(t===5) return false; if(t===7) return false; if(t===9) return false; if(t===17) return false; if(t===26) return false; return true; }
  const t=tileAt(tx,ty);
  // ── SANCTUARY interiors use extra tile codes for the raised chancel; resolve
  //    them here so they never collide with overworld/dungeon meanings of the
  //    same numbers. Walkable: floor(12) pew-front handled by geometry, step(14),
  //    platform(15). Solid: wall(5), altar block(17), pulpit(18), pew(13).
  if(place.kind==='interior' && INTERIORS[place.id] && INTERIORS[place.id].theme==='sanctuary'){
    if(t===5||t===13||t===17||t===18) return false;   // walls, pews, altar, pulpit block
    if(t===9||t===12||t===14||t===15) return true;    // exit, floor, step, platform walk
    return false;
  }
  if(place.kind==='interior' && INTERIORS[place.id] && INTERIORS[place.id].theme==='mistthrone'){
    if(t===5||t===20||t===22||t===24) return false;   // walls, pillars, throne, braziers block
    return true;                                        // floor(12), dais(21), carpet(23), door(9) walk
  }
  //    you cannot drive the boat onto land; step ashore with Ⓐ facing the shore.
  if(place.kind==='overworld' && player.boating){
    return SAIL_TILES.has(t);
  }
  if(WALK.has(t)) return true;
  // A bed you can lie on. The knight wakes ON one, and collision tests the box
  // he is standing in — so with the bed solid, every step he tried still
  // overlapped it and was refused. He was stuck in bed on the first morning.
  if(place.kind==='interior' && (t===42||t===43)) return true;
  // traversal abilities (overworld only) open up otherwise-blocked terrain
  if(place.kind==='overworld' && player.mounted){
    const ab=petAbility();
    if(ab==='fly'  && FLY_PASS.has(t))  return true;
    if(ab==='swim' && SWIM_PASS.has(t)) return true;
  }
  return false;
}
function activeNpcs(){ if(place.kind!=='interior') return []; return (INTERIORS[place.id].npcs||[]).filter(n=>n.floor===place.floor); }

// ── ELEVATION: assign heights to Crystalpeak's concentric rings ──
// The relocation pass already SCULPTED the mountain (5 grass→snow tiers, cliffs,
// zig-zag stairs, peak village). Here we just stamp the matching HEIGHT per ring so
// movement gates correctly: you climb tier→tier only via the stairs the pass laid.
function buildElevation(){
  const G=WORLD;
  const cx=153, cy=68;                 // must match the relocation pass center (C.Crystalpeak)
  const RINGS=[ [23,18],[19,15],[15,12],[11,9],[9,8] ];   // same radii as the builder
  const inE=(x,y,rx,ry)=>{ const nx=(x-cx)/rx, ny=(y-cy)/ry; return nx*nx+ny*ny<=1; };
  const ringTile=(x,y)=>{ for(let i=0;i<RINGS.length;i++){ if(inE(x,y,RINGS[i][0],RINGS[i][1])){ if(i===RINGS.length-1||!inE(x,y,RINGS[i+1][0],RINGS[i+1][1])) return i; } } return inE(x,y,RINGS[4][0],RINGS[4][1])?4:-1; };
  const R0=RINGS[0];
  // 0) clear ORPHANED wall tiles around Crystalpeak — remnants of the old (pre-ring)
  //    town wall. Building footprints keep their walls (they provide collision).
  const inBld=(x,y)=>buildings.some(b=>b.id&&b.id.startsWith('cp_')&&x>=b.x&&x<b.x+b.w&&y>=b.y&&y<b.y+b.h);
  for(let y=cy-R0[1]-4;y<=cy+R0[1]+4;y++)for(let x=cx-R0[0]-6;x<=cx+R0[0]+6;x++){
    if(!G[y]||G[y][x]!==5||inBld(x,y)) continue;
    const t=ringTile(x,y);
    G[y][x] = (t>=4)?22 : (t>=0?0:0);            // snow on the peak, grass elsewhere
  }
  for(let y=cy-R0[1]-2;y<=cy+R0[1]+2;y++)for(let x=cx-R0[0]-2;x<=cx+R0[0]+2;x++){
    if(!G[y]||G[y][x]===undefined) continue;
    const t=ringTile(x,y);
    setElev(x,y, t<0?0:t);             // height == tier index (0 base … 4 peak)
  }
  // ── VILLAGE PLATEAU FLATTEN: moved to crystalpeakVillageFlatten() further down
  //    (it must run AFTER crystalpeakHealTrench, which re-stamps ring-tier heights
  //    over cols 158-159 rows 72-86 and was undoing the flatten on the east home).
  // GUARANTEE a clean climb: lay a continuous stair ribbon up the south path (cols 153-154)
  // wherever the height steps up, so every tier boundary on the main route is bridged.
  const T=(x,y)=>(G[y]&&G[y][x]!==undefined)?G[y][x]:-1;
  const put=(x,y,t)=>{ if(G[y]&&G[y][x]!==undefined) G[y][x]=t; };
  for(const x of [153,154]){
    for(let y=cy+R0[1]+2; y>=cy; y--){
      const h=elevAt(x,y), hN=elevAt(x,y-1);
      if(hN>h){ // a step up ahead — ensure BOTH tiles are walkable stairs so canStep bridges it
        if(![5,9].includes(T(x,y)))   put(x,y,10);
        if(![5,9].includes(T(x,y-1))) put(x,y-1,10);
      }
      // keep the corridor itself walkable (don't tunnel through buildings)
      if([1,33,32].includes(T(x,y))) put(x,y,2);
    }
  }
  // MIRROR the two climb columns so the flight is a clean 2-tile-wide staircase:
  // wherever one column has a stair, the other gets one on the same row (same height).
  for(let y=cy+R0[1]+2; y>=cy-2; y--){
    const a=T(153,y)===10, b=T(154,y)===10;
    if(a!==b){ const src=a?153:154, dst=a?154:153;
      if(![5,9].includes(T(dst,y))){ put(dst,y,10); setElev(dst,y,elevAt(src,y)); } }
  }

  // ── SALTMERE: a gentle coastal tier — town sits one step up; beach/surf/docks at sea level ──
  // Town body ~ y198..207 (cobble + buildings). Sand begins ~y208, surf/docks below.
  // Raise the town to height 1; everything from the sand down stays height 0 (the beach),
  // so you can freely walk onto the beach and out along the docks.
  (function saltmereTier(){
    const SX0=11, SX1=45;             // town x-span (cobble area)
    const townTop=198, townBot=207;   // raised town rows
    // cleanup: the old gen scattered decorative "rocks" as wall tiles (purple masonry)
    // and laid a tile-32 cliff row at the beach line. Walls → warm boulders (same
    // collision, better look); the old cliff row → sand (heights now gate the edge).
    const inBld=(x,y)=>buildings.some(b=>x>=b.x&&x<b.x+b.w&&y>=b.y&&y<b.y+b.h);
    for(let y=193;y<=224;y++)for(let x=8;x<=47;x++){
      if(!G[y]||G[y][x]===undefined) continue;
      if(G[y][x]===32 && y===townBot+1) G[y][x]=19;
      else if(G[y][x]===5 && !inBld(x,y)) G[y][x]=32;
    }
    // raise the town platform
    for(let y=townTop;y<=townBot;y++)for(let x=SX0;x<=SX1;x++){
      const t=T(x,y); if(t<0) continue;
      if([3,20].includes(t)) continue;          // never raise actual water
      setElev(x,y,1);
    }
    // beach + everything south stays height 0 (default) — explicitly clear in case
    for(let y=townBot+1;y<=224;y++)for(let x=SX0-1;x<=SX1+1;x++) setElev(x,y,0);
    // strip ALL old beach-descent stairs on the boundary rows, then carve ONE
    // central staircase down to the beach (a single clean flight, cols 28-29).
    for(const y of [townBot, townBot+1])for(let x=SX0-1;x<=SX1+1;x++){
      if(G[y]&&(G[y][x]===10||G[y][x]===11)) G[y][x]=(y<=townBot?6:19);
    }
    // ── THE HARBOR: open water from the docks to the southern sea ──
    // The grass strip below the surf becomes the harbor basin; the south beach
    // parts at a wide mouth so Saltmere truly opens onto the ocean. (One day,
    // ships will sail from here to the southern isles.)
    for(let y=225;y<=235;y++)for(let x=9;x<=50;x++){
      const t=G[y][x];
      if([0,1,4,7,15,18].includes(t)) G[y][x]=3;
    }
    for(let y=236;y<=237;y++)for(let x=16;x<=40;x++){        // the harbor mouth through the beach
      if(G[y][x]===19) G[y][x]=3;
    }
    for(let y=225;y<=235;y++){                                // sandy banks framing the basin
      if(G[y][8]===0) G[y][8]=19;
      if(G[y][51]===0) G[y][51]=19;
    }
    const descents=[28,29];
    // erase the orphaned path landings where the removed staircases used to meet the strip
    for(let y=townBot+1;y<=townBot+4;y++)for(const x of [15,16,17,18,37,38,39,40]){
      if(G[y]&&G[y][x]===2) G[y][x]=(y===townBot+1?19:0);
    }
    descents.forEach(x=>{
      if(![5,9].includes(T(x,townBot)))   { put(x,townBot,10);   setElev(x,townBot,1); }
      if(![5,9].includes(T(x,townBot+1))) { put(x,townBot+1,10); setElev(x,townBot+1,0); }
    });
  })();

  // ── IRONHOLD: a clean rectangular fortress on a raised stone platform ──
  // Strip the old ragged walls and rebuild one tidy curtain wall. The courtyard sits
  // one step up (height 1); the ground outside is height 0, with gate stairs N & S.
  (function ironholdFortress(){
    // final fortress bounds: right wall pushed out to x56 so it clears the chapel/inn
    // (which extend to x54) — previously x53 clipped through them.
    const WX0=14, WX1=56, WY0=52, WY1=75;       // wall rectangle (inclusive)
    const inX=(x)=>x>WX0&&x<WX1, inY=(y)=>y>WY0&&y<WY1;
    // 0) clear the leftover ragged rock (33) and stray ledges (32) around the fortress
    for(let y=WY0-6;y<=WY1+6;y++)for(let x=WX0-10;x<=WX1+6;x++){
      if(!G[y]||G[y][x]===undefined) continue;
      if(G[y][x]===33||G[y][x]===32) G[y][x]=0;   // rock/ledge → plain grass
    }
    // 1) wipe the old wall ring (any wall on the rectangle perimeter band) to rebuild clean
    for(let y=WY0;y<=WY1;y++)for(let x=WX0;x<=WX1;x++){
      const edge = (x===WX0||x===WX1||y===WY0||y===WY1);
      if(edge && G[y]&&G[y][x]!==undefined && G[y][x]===5) G[y][x]=6;  // temporarily floor; we re-wall below
    }
    // 2) lay a crisp 1-tile curtain wall around the rectangle
    for(let x=WX0;x<=WX1;x++){ if(G[WY0])G[WY0][x]=5; if(G[WY1])G[WY1][x]=5; }
    for(let y=WY0;y<=WY1;y++){ if(G[y]){ G[y][WX0]=5; G[y][WX1]=5; } }
    // 3) gate: SOUTH only (the front, Saltmere side) — open the wall + lay road through.
    //    The north (Hearthvale-side / rear) gate is sealed; the road wraps around to the front.
    for(const gx of [32,33,34]){ if(G[WY1])G[WY1][gx]=2; }
    // 4) raise the courtyard interior to height 1 (stone platform); keep buildings on it
    for(let y=WY0;y<=WY1;y++)for(let x=WX0;x<=WX1;x++){
      if(!G[y]||G[y][x]===undefined) continue;
      setElev(x,y,1);
    }
    // 5) gate stairs: step DOWN from the raised courtyard (h1) through the SOUTH gate to ground (h0)
    for(const gx of [32,33,34]){
      put(gx,WY1,10);   setElev(gx,WY1,1);
      put(gx,WY1+1,10); setElev(gx,WY1+1,0);
    }
    // 6) the approach road outside the south gate stays height 0 (ground)
    for(let y=WY1+2;y<=WY1+5;y++) for(const gx of [32,33,34]){ if(G[y]&&G[y][gx]!==undefined){ if(G[y][gx]!==5) G[y][gx]=2; setElev(gx,y,0);} }
  })();

  // ── ASHFIELD: kept simple — the walled town sits one gentle step down in the crater. ──
  // Raise the ASH RIM one level around the town; the town interior stays at ground (0).
  // A single north gate steps from the rim down into the town. One tier, one entrance.
  (function ashfieldCrater(){
    // town wall bounds (from the relocated layout): roughly x138..178, y136..162
    const WX0=138, WX1=178, WY0=136, WY1=162;
    const gateX=[158,159];                 // north gate columns
    // raise the ash apron that rings the town to height 1 (the crater rim)
    for(let y=WY0-7;y<=WY1+7;y++)for(let x=WX0-9;x<=WX1+4;x++){
      if(!G[y]||G[y][x]===undefined) continue;
      const insideTown = (x>WX0 && x<WX1 && y>WY0 && y<WY1);
      if(insideTown) continue;             // town interior stays at ground level (the crater floor)
      if(G[y][x]===25){ setElev(x,y,1); }  // only the ash tiles form the raised rim
    }
    // gate stairs: step DOWN from the rim (h1) through the north gate into the town (h0)
    for(const gx of gateX){
      // the rim tile just north of the wall is h1; the gate opening descends to the town h0
      if(G[WY0-1]&&G[WY0-1][gx]!==undefined){ if(![5].includes(G[WY0-1][gx])) G[WY0-1][gx]=10; setElev(gx,WY0-1,1); }
      if(G[WY0]&&G[WY0][gx]!==undefined){ if(![5].includes(G[WY0][gx])) G[WY0][gx]=10; setElev(gx,WY0,0); }
    }
  })();

  // ── STORMGATE: the capital, kept simple — the whole walled city sits one step up. ──
  // Raise the interior to height 1 (a grand platform); the ground outside is height 0.
  // Both north gates get stairs stepping down. One tier, easy to read.
  (function stormgateCity(){
    const WX0=150, WX1=186, WY0=198, WY1=228;     // outer wall rectangle
    const gateX=[168,169, 180,181];               // the two north gates
    // raise the whole walled interior (and the wall ring) to height 1
    for(let y=WY0;y<=WY1;y++)for(let x=WX0;x<=WX1;x++){
      if(!G[y]||G[y][x]===undefined) continue;
      setElev(x,y,1);
    }
    // gate stairs: step DOWN from the city (h1) through each north gate to the ground (h0)
    for(const gx of gateX){
      if(G[WY0]&&G[WY0][gx]!==undefined){   if(![5].includes(G[WY0][gx]))   G[WY0][gx]=10;   setElev(gx,WY0,1); }
      if(G[WY0-1]&&G[WY0-1][gx]!==undefined){ if(![5].includes(G[WY0-1][gx])) G[WY0-1][gx]=10; setElev(gx,WY0-1,0); }
    }
    // the approach roads outside the gates stay at ground level
    for(let y=WY0-6;y<WY0-1;y++) for(const gx of gateX){ if(G[y]&&G[y][gx]!==undefined && G[y][gx]!==5){ G[y][gx]=2; setElev(gx,y,0);} }
  })();
}
buildElevation();

// ════════════════════════════════════════════════════════════════
//  WORLD DRESSING — fill the empty fields so the map reads like a
//  finished game: smooth biome edges, a forest world-border, tree
//  groves, flower meadows, and ponds. Never touches roads, towns,
//  or secret approaches (3-tile safety margin around all structures).
// ════════════════════════════════════════════════════════════════
function worldDressing(){
  const G=WORLD, H=G.length, W=G[0].length;
  // deterministic per-tile random so the world is stable across loads
  const rng=(x,y,s)=>{ let n=(x*374761393+y*668265263+s*982451653)>>>0; n=((n^(n>>>13))*1274126177)>>>0; return ((n^(n>>>16))>>>0)/4294967296; };

  // 1) SMOOTH ragged biome spray-edges: lone ash/dust/rock flecks → grass (3 firm passes)
  //    (sand 19 is included only ABOVE the coast strip, so beaches stay intact)
  const SPRAY=new Set([25,27,33]);
  const sprayAt=(x,y)=>{ const t=G[y][x]; return SPRAY.has(t) || (t===19 && y<196); };
  for(let pass=0;pass<3;pass++){
    const kill=[];
    for(let y=1;y<H-20;y++)for(let x=1;x<W-1;x++){
      if(!sprayAt(x,y)) continue;
      let same=0; for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){ if(!dx&&!dy)continue; if(sprayAt(x+dx,y+dy)) same++; }
      if(same<4) kill.push([x,y]);
    }
    kill.forEach(([x,y])=>G[y][x]=0);
  }

  // 2) WORLD BORDER: a forest frame on the top/left/right edges (sea covers the south),
  //    with clearings kept around the two walk-to secrets near the edges.
  const nearWalkSecret=(x,y)=> (Math.abs(x-4)<=5&&Math.abs(y-4)<=5)||(Math.abs(x-7)<=5&&Math.abs(y-120)<=5);
  for(let y=0;y<H-16;y++)for(let x=0;x<W;x++){
    const depth=Math.min(x,y,W-1-x);
    if(depth<3 && G[y][x]===0 && !nearWalkSecret(x,y)) G[y][x]=(depth<2?1:(rng(x,y,1)<.6?1:7));
  }

  // 3) KEEP-CLEAR mask: stay ≥3 tiles from any structure (roads, walls, biomes, water…)
  //    and ≥5 from every secret, so nothing we add can block a route.
  const clear=Array.from({length:H},()=>new Uint8Array(W));
  const PLAIN=new Set([0,1,4,7,15,18]);
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    if(PLAIN.has(G[y][x])) continue;
    for(let dy=-3;dy<=3;dy++)for(let dx=-3;dx<=3;dx++){ const ny=y+dy,nx=x+dx; if(ny>=0&&ny<H&&nx>=0&&nx<W) clear[ny][nx]=1; }
  }
  if(typeof SECRETS!=='undefined') SECRETS.forEach(s=>{ for(let dy=-5;dy<=5;dy++)for(let dx=-5;dx<=5;dx++){ const ny=s.y+dy,nx=s.x+dx; if(ny>=0&&ny<H&&nx>=0&&nx<W) clear[ny][nx]=1; } });

  // 4a) LARGE FOREST MASSES: big organic woodlands in the dead zones between towns —
  //     these give the map real geography. Each mass is a noisy ellipse of forest,
  //     and the keep-clear mask automatically carves road corridors through them.
  const forestMass=(cx,cy,rx,ry)=>{
    for(let dy=-ry;dy<=ry;dy++)for(let dx=-rx;dx<=rx;dx++){
      const nx=cx+dx, ny=cy+dy; if(nx<0||nx>=W||ny<0||ny>=H) continue;
      if(G[ny][nx]!==0||clear[ny][nx]) continue;
      const n=(dx/rx)**2+(dy/ry)**2;
      const edge=n>0.55;                                   // ragged organic rim
      if(n<=1 && (!edge || rng(nx,ny,7)<0.55)) G[ny][nx]= rng(nx,ny,8)<.7?1:7;
    }
  };
  forestMass(60,150,26,20);    // western wilds (between Homestead road & Thornwood)
  forestMass(110,60,22,16);    // northern woods (left of Dusthaven)
  forestMass(205,160,22,18);   // eastern reaches (below Hellgate road)
  forestMass(110,175,18,14);   // heartwood (center-south)
  forestMass(225,70,14,12);    // northeast fringe
  forestMass(35,95,14,12);     // west of Homestead

  // 4b) small TREE GROVES as accents on the remaining plains
  for(let y=4;y<H-18;y++)for(let x=4;x<W-4;x++){
    if(G[y][x]!==0||clear[y][x]||rng(x,y,2)>=0.016) continue;
    const r=2+Math.floor(rng(x,y,3)*3);
    for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++){
      const ny=y+dy,nx=x+dx; if(ny<0||ny>=H||nx<0||nx>=W) continue;
      if(G[ny][nx]!==0||clear[ny][nx]) continue;
      const d=Math.hypot(dx,dy); if(d>r) continue;
      if(rng(nx,ny,4) < (d<r*0.6?0.9:0.45)) G[ny][nx]= rng(nx,ny,5)<.75?1:7;
    }
  }

  // 5) MEADOWS: light flower + bush sprinkle on the remaining grass
  for(let y=3;y<H-18;y++)for(let x=3;x<W-3;x++){
    if(G[y][x]!==0) continue;
    const v=rng(x,y,6);
    if(v<0.014) G[y][x]=4;
    else if(v<0.018&&!clear[y][x]) G[y][x]=15;
  }

  // 6) PONDS: small lakes in the deep-empty regions, ringed with a sandy bank so
  //    they read clearly (only placed if the whole area is untouched plain ground)
  const tryPond=(cx,cy,rx,ry)=>{
    for(let dy=-ry-2;dy<=ry+2;dy++)for(let dx=-rx-2;dx<=rx+2;dx++){
      const ny=cy+dy,nx=cx+dx;
      if(ny<0||ny>=H||nx<0||nx>=W) return false;
      if(!PLAIN.has(G[ny][nx])||clear[ny][nx]) return false;
    }
    for(let dy=-ry-1;dy<=ry+1;dy++)for(let dx=-rx-1;dx<=rx+1;dx++){
      const n=(dx/(rx+1))**2+(dy/(ry+1))**2;
      if(n<=1) G[cy+dy][cx+dx]=19;                          // sandy bank
    }
    for(let dy=-ry;dy<=ry;dy++)for(let dx=-rx;dx<=rx;dx++){
      if((dx/rx)**2+(dy/ry)**2<=1) G[cy+dy][cx+dx]=3;       // water
    }
    return true;
  };
  [[70,120,6,4],[205,120,6,4],[140,90,5,4],[40,170,6,4],[230,200,5,4],[90,210,5,3],[170,40,5,3]].forEach(c=>tryPond(c[0],c[1],c[2],c[3]));
}
worldDressing();

// ── SAGE'S WOOD: a hidden forest west of the Saltmere road. An old hermit—
// Eldan the Sage—dwells deep within its maze. (His quests come in a later chapter.)
(function forestOfDisillusionment(){
  const G=WORLD;
  const hash=(x,y)=>((x*374761393+y*668265263)>>>0);
  const ENTER_Y=84, EXIT_Y=185;        // the two overworld mouths
  const ROADx=33;                       // the old corridor ran cols 33-34
  // Wall the FULL width from the western tree-line to the eastern river (~col 62)
  // with SOLID trees (tile 1 = wall) so there is no way around. Bushes are walkable,
  // so we never use them for the wall — only sparse non-blocking decor isn't placed here.
  const XL=2, XR=61;                    // river barrier sits ~col 62-66; stop just short
  for(let y=ENTER_Y; y<=EXIT_Y; y++){
    for(let x=XL; x<=XR; x++){
      if(!G[y]||G[y][x]===undefined) continue;
      const t=G[y][x];
      // preserve walls/doors/gates/water/stairs/cliffs/special/sand/beach/signs
      if([5,9,8,3,16,35,12,10,11,32,33,26,19,20,21,24,30,31].includes(t)) continue;
      const nearEnter = (y<=ENTER_Y+1 && Math.abs(x-ROADx)<=1);
      const nearExit  = (y>=EXIT_Y-1  && Math.abs(x-ROADx)<=1);
      if(nearEnter||nearExit){ G[y][x]=2; continue; }   // small clearing at each mouth
      G[y][x]=1;                                         // SOLID tree wall
    }
  }
  // NORTH mouth: hollow + short approach stub up to Ironhold's road
  G[ENTER_Y][ROADx]=35; G[ENTER_Y][ROADx+1]=1;
  for(let y=ENTER_Y-1; y>=ENTER_Y-3; y--){ if(G[y]){ G[y][ROADx]=2; G[y][ROADx+1]=2; } }
  G[ENTER_Y-1][ROADx+2]=16;
  signs[(ROADx+2)+','+(ENTER_Y-1)]="THE FOREST OF DISILLUSIONMENT\\nA fog-bound wood swallows the road south.\\nThere is no way around. Step in.";
  // SOUTH mouth: hollow + short 3-wide approach stub down to Saltmere's road
  G[EXIT_Y][ROADx]=35; G[EXIT_Y][ROADx+1]=1;
  for(let y=EXIT_Y+1; y<=EXIT_Y+3; y++){ if(G[y]){ G[y][ROADx-1]=2; G[y][ROADx]=2; G[y][ROADx+1]=2; } }
})();

// ── STORMGATE REWORK v2: the capital gets ONE grand approach. All side gates
// are sealed; Ashfield's orphan east road is erased; the surviving road wraps
// the western flank to the single SOUTH front gate, which opens directly onto
// the Royal Harbor — quay at the walls, piers in the swell, and His Majesty's
// Fleet riding at anchor. The city itself rises in two clean tiers: the lower
// town (1) and the high Citadel terrace (2) holding keep, cathedral & garrison.
(function stormgateRework(){
  const G=WORLD;
  // 1) SEAL the old north gates and clear their approach stubs
  for(const x of [168,169,180,181,182]){ G[197][x]=0; setElev(x,197,0); G[198][x]=5; }
  for(let y=164;y<=196;y++) for(const x of [180,181,182]){ if(G[y][x]===2) G[y][x]=0; }
  for(let y=191;y<=196;y++) for(const x of [168,169]){ if(G[y][x]===2) G[y][x]=0; }
  // ASHFIELD's road to nowhere: the orphan x180-181 column dead-ending at y163
  for(let y=152;y<=163;y++) for(const x of [180,181]){ if(G[y][x]===2) G[y][x]=0; }
  for(const y of [150,151]) for(const x of [180,181]){ if(G[y][x]===2) G[y][x]=0; }
  // 2) SEAL the west postern and the east gate; interior stubs become plaza
  G[212][150]=5; setElev(150,212,1); G[213][150]=5; setElev(150,213,1);
  for(const y of [212,213]) for(let x=151;x<=157;x++){ if(G[y][x]===2) G[y][x]=6; }
  G[213][186]=5; setElev(186,213,1); G[214][186]=5; setElev(186,214,1);
  for(const y of [213,214]) for(let x=179;x<=185;x++){ if(G[y][x]===2) G[y][x]=6; }
  // the dead nub of the east highway at the sealed wall
  for(const y of [213,214]) for(let x=187;x<=189;x++){ if(G[y][x]===2) G[y][x]=0; }
  // the east (Shadowmere) highway bends south well clear of the walls…
  for(let y=215;y<=230;y++){ G[y][190]=2; G[y][191]=2; }
  // 3) WEST WRAP: Ashfield's road bends west at y189-190, down the flank, to the front
  for(let y=189;y<=190;y++) for(let x=147;x<=169;x++) G[y][x]=2;
  for(let y=191;y<=230;y++){ G[y][146]=2; G[y][147]=2; }
  // 4) ROYAL HARBOR: quay esplanade at the walls, then open water — no beach strip
  for(let y=229;y<=230;y++) for(let x=146;x<=191;x++) G[y][x]=2;
  for(let y=231;y<=237;y++) for(let x=146;x<=194;x++){
    if([0,1,4,7,15,16,18,19].includes(G[y][x])) G[y][x]=3;
  }
  // NAVY PIERS from the quay into the swell, breakwater boulders beyond
  for(const [a,b] of [[156,157],[170,171],[184,185]]){
    for(let y=231;y<=237;y++){ G[y][a]=12; G[y][b]=12; }
  }
  for(const x of [150,163,177,192]){ if(G[238][x]===3) G[238][x]=32; }
  // HIS MAJESTY'S FLEET — three warships riding at anchor between the piers
  G[233][151]=36; G[233][152]=37; G[233][153]=38;
  G[234][165]=36; G[234][166]=37; G[234][167]=38;
  G[233][178]=36; G[233][179]=37; G[233][180]=38;
  // the harbor sign moves onto the quay
  delete signs['173,231'];
  G[229][173]=16; signs['173,229']="STORMGATE HARBOR\nHome of His Majesty's Fleet.\nThe Navy watches the southern sea.";
  // 🏟 the GRAND PET TOURNAMENT banner in the lower-town market plaza
  G[222][155]=16; signs['155,222']="🏟 GRAND PET TOURNAMENT\nThree rounds — rising purses!\nPress Ⓐ to enter your companion.";
  // 💈 the PET STYLIST's striped pole beside it
  G[222][153]=16; signs['153,222']="💈 PET STYLIST\nRibbons & flair for fine companions.\nPress Ⓐ to step inside.";
  // 5) THE FRONT GATE: the south wall parts for a grand stair (quay → city)
  for(const x of [167,168]){
    G[228][x]=10; setElev(x,228,1);
    G[229][x]=10; setElev(x,229,0);
  }
  // 6) THE CITADEL TERRACE: the whole inner-city north block rises a full tier —
  // keep, cathedral, and garrison stand above the lower town behind a clean cliff.
  for(let y=199;y<=211;y++) for(let x=151;x<=185;x++) setElev(x,y,2);
  for(let x=150;x<=186;x++){ setElev(x,198,3); }                       // north battlement
  for(let y=198;y<=211;y++){ setElev(150,y,3); setElev(186,y,3); }     // flank walls
  // the old mid-terrace stairs become open arches in the inner wall (flat terrace now)
  for(const x of [153,154,181,182]){ if(G[201][x]===10){ G[201][x]=6; } setElev(x,201,2); }
  // grand stairways down from the terrace: west service stair, the CENTERED
  // main flight on the front-gate axis, and an east flight carved through the
  // old wall block to serve the townhouse below.
  if(G[211][168]===16){ G[211][168]=6; G[211][166]=16; signs['166,211']=signs['168,211']; delete signs['168,211']; }
  const flights=[[154,155],[167,168],[180,181]];
  flights.forEach(p=>p.forEach(x=>{ G[211][x]=10; setElev(x,211,2); G[212][x]=10; setElev(x,212,1); }));
  // landing pads below the east flight (clear any wall stubs in the way)
  for(const y of [213,214]) for(const x of [180,181]){ if(G[y][x]===5){ G[y][x]=6; setElev(x,y,1); } }
  // open the terrace around the townhouse so the stairs climb straight to its door
  for(let y=205;y<=211;y++) for(let x=178;x<=185;x++){ if(G[y][x]===5){ G[y][x]=6; setElev(x,y,2); } }
  // 7) CATHEDRAL APPROACH: the doorstep (163,211) sat in a sealed pocket on the
  //    terrace edge — a stray wall at (162,211) west, the INNER CITY sign at
  //    (166,211) east, and lower town (h1) below with no stair. Clear the wall,
  //    move the sign down beside the central flight, and lay a doorstep stair
  //    (163, rows 211/212) so the front door is climbable straight off the axis.
  if(G[211][162]===5){ G[211][162]=6; setElev(162,211,2); }
  if(G[211][166]===16){
    G[211][166]=6; setElev(166,211,2);
    if(G[212][166]!==undefined && G[212][166]!==5){ G[212][166]=16; signs['166,212']=signs['166,211']; }
    delete signs['166,211'];
  }
  G[211][163]=10; setElev(163,211,2);
  G[212][163]=10; setElev(163,212,1);
})();

// ── THE PILGRIM'S WAY & THE LONG STREAM ──
// The Homestead now lies deep in the eastern woods. The walk home from
// Hearthvale crosses a wooden bridge over a stream, winds through close
// forest, and opens at last into the farm's sunlit clearing. The stream
// itself rises at the northern hills and runs the length of the realm —
// through the forest pool — down to the southern sea, a road of water
// for any knight whose companion can swim.
// ── remove the two eastbound paths leaving Hearthvale (per design) ──
(function clearHearthvaleEastPaths(){
  const G=WORLD;
  const isRoad=(x,y)=>{ const t=G[y]&&G[y][x]; return t===2||t===10||t===11||t===12; };
  for(const rows of [[22,23],[32,33]]){
    // walk east from the town's east edge; clear contiguous road tiles
    for(let x=50; x<140; x++){
      let any=false;
      for(const y of rows){ if(isRoad(x,y)){ G[y][x]=0; setElev(x,y,0); any=true; } }
      if(!any) break;   // stop at the first column with no road (end of this path)
    }
  }
})();

// ── a clean, smooth Hearthvale → Ironhold connector ──
// (the east-path removal above clipped the old wrap route; rebuild it tidily:
//  drop south from the Hearthvale gate, then run east to the x58 wall-lane.)
// ── (removed) the old east-wall-wrap Hearthvale→Ironhold connector lived here.
//    It built a redundant second road down the east lane (col 58) that dead-ended
//    as an orphan stub. The clean west-flank highway in routeHearthvaleAroundIronhold
//    is now the single source of truth for this link, so this is gone.

(function pilgrimsWayAndStream(){
  const G=WORLD;
  const hash=(x,y)=>((x*374761393+y*668265263)>>>0);
  // 1) plant the WOODS along the walkway (trees crowd the road, a tile of
  //    breathing room each side), opening into the clearing near the farm
  for(let y=15;y<=33;y++)for(let x=56;x<=95;x++){
    if(G[y][x]!==0) continue;
    let nearRoad=false;
    for(let dy=-1;dy<=1&&!nearRoad;dy++)for(let dx=-1;dx<=1;dx++){ const t=G[y+dy]&&G[y+dy][x+dx]; if(t===2||t===12){ nearRoad=true; break; } }
    if(nearRoad) continue;
    const h=hash(x,y)%10;
    if(h<6) G[y][x]=1; else if(h<8) G[y][x]=7;     // dense pines with bushes between
  }
  // 2) carve the STREAM: north hills → under the walkway → past Ironhold's
  //    meadows → through the forest pool → the western wilds → the southern sea.
  //    Any road it meets becomes a wooden BRIDGE automatically.
  const pts=[[82,0],[82,12],[78,20],[72,30],[66,42],[63,58],[63,88],[66,114],[66,126],[63,142],[62,168],[63,196],[63,209],[64,233]];
  const KEEP=new Set([5,9,12,16,31,13,14,32]);
  for(let i=0;i<pts.length-1;i++){
    const [x0,y0]=pts[i], [x1,y1]=pts[i+1];
    for(let y=y0;y<=y1;y++){
      const f=(y-y0)/Math.max(1,(y1-y0));
      const cx=Math.round(x0+(x1-x0)*f + Math.sin(y*0.33)*1.4);
      for(let dx=0;dx<2;dx++){
        const x=cx+dx; if(x<1||x>=WORLD_W-1||!G[y]) continue;
        const t=G[y][x];
        if(t===2||t===10||t===11){ G[y][x]=12; setElev(x,y,0); }          // bridge!
        else if(!KEEP.has(t) && t!==3){ G[y][x]=3; setElev(x,y,0); }      // water
      }
    }
  }
  // tidy: prune any orphan road stubs left at the farm's corner by the relocation
  for(let pass=0; pass<4; pass++) for(let y=30;y<=38;y++) for(let x=114;x<=121;x++){
    if(G[y]&&G[y][x]===2){
      const n=[[1,0],[-1,0],[0,1],[0,-1]].filter(([dx,dy])=>{const t=G[y+dy]&&G[y+dy][x+dx];return t===2||t===12||t===10||t===11||t===6;}).length;
      if(n<=1) G[y][x]=0;
    }
  }
  // 3) signs along the way
  const roadRow=(x)=>{ for(let y=16;y<=32;y++){ if(G[y][x]===12) return y; } return -1; };
  let by=-1, bx=-1;
  for(let x=68;x<=86 && by<0; x++){ const y=roadRow(x); if(y>0){ by=y; bx=x; } }
  if(by>0){ for(const [ox,oy] of [[-2,-2],[3,-2],[-2,3],[3,3],[-3,-2]]){
    const sx2=bx+ox, sy2=by+oy; const t=G[sy2]&&G[sy2][sx2];
    if(t===0||t===1||t===7){ G[sy2][sx2]=16; signs[sx2+','+sy2]="PILGRIM'S CROSSING\nThe stream rises in the north hills\nand runs to the southern sea."; break; } } }
  if(G[24] && G[24][96]===0){ G[24][96]=16; signs['96,24']='THE CLEARING\nThe woods open — home at last.\nThe Homestead lies ahead. 🌾'; }
})();

// ── POSTGAME HOMESTEAD (expanded, river NW→SE) ──
// A roomy wood-ringed estate set in the northern meadows. A branch of the
// great northern stream enters at the NORTH-WEST corner and runs diagonally
// to a pond in the SOUTH-EAST. The family home and merchant's house sit on
// the upper-north bank; a footbridge crosses to the southern farmstead with
// several fields and the barn. One gate leads in from the south.
/* _legacy homesteadSanctuary (pre-redesign, in-place northern vale x95-123,y4-34):
   Relocated & redesigned into the southern Fog-Wood clearing. Original source archived below.
(function homesteadSanctuary(){
  const G=WORLD;
  const hash=(x,y)=>((x*374761393+y*668265263)>>>0);

  // expanded vale bounds (taller & wider; shifted ~9 rows north)
  const X0=95,X1=123,Y0=4,Y1=34;

  // 0) REPOSITION buildings into the new, larger layout, wipe to grass, re-stamp.
  //    NORTH bank: family home + merchant.  SOUTH bank: barn.
  const HB={ home_house:[107,6,110,11], dh_shop:[114,13,116,17], home_barn:[100,27,101,30] };
  for(const b of buildings){ const p=HB[b.id]; if(!p) continue; b.x=p[0]; b.y=p[1]; b.door={x:p[2], y:p[3]}; }
  for(let y=Y0;y<=Y1;y++) for(let x=X0;x<=X1;x++){ if(G[y]){ G[y][x]=0; setElev(x,y,0); } }
  for(const b of buildings){ if(HB[b.id]) stampBuilding(G,b); }

  const KEEP=new Set([5,9]);

  // 1) RING OF WOODS (2 deep) with ONE south gate
  const GATEx=104;
  for(let x=X0;x<=X1;x++) for(const y of [Y0,Y0+1,Y1-1,Y1]){
    if(y>=Y1-1 && Math.abs(x-GATEx)<=1) continue;
    if(G[y]&&!KEEP.has(G[y][x])) G[y][x]=hash(x,y)%5<4?1:7;
  }
  for(let y=Y0;y<=Y1;y++) for(const x of [X0,X0+1,X1-1,X1]){
    if(G[y]&&!KEEP.has(G[y][x])) G[y][x]=hash(x,y)%5<4?1:7;
  }

  // 2) THE RIVER — a branch off the great stream enters the NW corner and runs
  //    diagonally to the SE. First, carry a feeder from the great stream (~x82)
