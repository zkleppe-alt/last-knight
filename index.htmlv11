// ── MUSIC: a tiny chiptune sequencer ──────────────────────────────
//  Patterns are 32 sixteenth-steps. lead = pulse melody, bass = triangle,
//  drum = noise ('k' kick · 's' snare · 'h' hat · '.' rest). Scheduled a
//  quarter-second ahead off the game loop, so no stray timers.
const _=null;
const MUSIC = {
  // the open road: a wandering minstrel's lyre — plucked broken chords, no drums,
  // A minor → F → C → G, mixed low so it stays behind the game
  overworld:{ bpm:92, vol:0.55, pluck:true, wave:'triangle',
    lead:[57,_,60,_,64,_,69,_, 53,_,57,_,60,_,65,_, 60,_,64,_,67,_,72,_, 55,_,59,_,62,_,67,64],
    bass:[45,_,_,_,52,_,_,_, 41,_,_,_,48,_,_,_, 48,_,_,_,55,_,_,_, 43,_,_,_,50,_,_,_],
    drum:'................................' },
  // town: the same air, lighter on its feet
  town:{ bpm:112, lead:[79,_,81,_,83,_,81,_, 79,_,76,_,74,_,76,_, 77,_,79,_,81,_,79,_, 77,_,74,_,72,_,_,_],
    bass:[48,_,55,_,48,_,55,_, 53,_,48,_,53,_,48,_, 50,_,57,_,50,_,57,_, 55,_,43,_,55,_,_,_],
    drum:'k.h.s.h.k.h.s.h.k.h.s.h.k.h.s.hh', wave:'square' },
  // the crypts: slow, minor, a held breath
  dungeon:{ bpm:76, lead:[69,_,_,_,71,_,_,_, 72,_,_,_,_,_,_,_, 68,_,_,_,69,_,_,_, _,_,_,_,_,_,_,_],
    bass:[33,_,_,_,_,_,_,_, 33,_,_,_,_,_,_,_, 32,_,_,_,_,_,_,_, 32,_,_,_,31,_,_,_],
    drum:'k.......k.......k.......k......s', wave:'triangle' },
  // under the leaves: modal, curious, wandering
  forest:{ bpm:88, lead:[64,_,67,_,71,_,_,_, 69,_,67,_,64,_,_,_, 62,_,64,_,67,_,_,_, 66,_,_,_,_,_,_,_],
    bass:[40,_,_,_,47,_,_,_, 45,_,_,_,40,_,_,_, 38,_,_,_,45,_,_,_, 43,_,_,_,_,_,_,_],
    drum:'k...h...k...h...k...h...k...h.h.', wave:'triangle' },
  // the Great Sea: a rolling swell
  sail:{ bpm:96, lead:[74,_,_,78,_,_,81,_, _,_,78,_,74,_,_,_, 76,_,_,79,_,_,83,_, _,_,79,_,76,_,_,_],
    bass:[38,_,_,45,_,_,50,_, 45,_,_,38,_,_,_,_, 40,_,_,47,_,_,52,_, 47,_,_,40,_,_,_,_],
    drum:'k..h..h.k..h..h.k..h..h.k..h..h.', wave:'square' },
  // a guardian stirs: driving, chromatic, no rest
  boss:{ bpm:140, lead:[69,69,_,72,_,71,_,69, 68,_,69,_,_,_,_,_, 69,69,_,74,_,72,_,71, 69,_,68,_,69,_,_,_],
    bass:[33,33,_,33,_,33,_,33, 32,32,_,32,_,32,_,32, 33,33,_,33,_,33,_,33, 31,31,_,31,_,32,_,32],
    drum:'k.h.s.h.k.h.s.h.k.h.s.h.k.h.sshh', wave:'square' },
  // the Destroyer: the same engine, lower and meaner
  finale:{ bpm:152, lead:[68,68,_,71,_,70,_,68, 67,_,68,_,63,_,_,_, 68,68,_,73,_,71,_,70, 68,_,67,_,68,_,_,_],
    bass:[32,32,_,32,_,32,_,32, 31,31,_,31,_,31,_,31, 32,32,_,32,_,32,_,32, 30,30,_,30,_,31,_,31],
    drum:'ksh.s.h.ksh.s.h.ksh.s.h.ksh.sshh', wave:'sawtooth' },
};
function musicPlay(id){
  if(audio.trackId===id) return;
  audio.trackId=id; audio.track=MUSIC[id]||null; audio.step=0;
  const c=A(); if(!c || !audio.track) return;
  audio.stepDur = 60/audio.track.bpm/4;                 // sixteenth notes
  audio.nextTime = c.currentTime + 0.06;
}
function musicStop(){ audio.trackId=null; audio.track=null; }
function musicNote(t, n, wave, gain, dur, bus, pluck){
  const c=audio.ctx;
  const osc=c.createOscillator(); osc.type=wave;
  osc.frequency.setValueAtTime(hz(n), t);
  const g=c.createGain();
  g.gain.setValueAtTime(0.0001,t);
  g.gain.exponentialRampToValueAtTime(gain, t+(pluck?0.002:0.012));   // a pluck bites instantly
  g.gain.exponentialRampToValueAtTime(0.0001, t+dur);
  osc.connect(g); g.connect(bus);
  osc.start(t); osc.stop(t+dur+0.02);
  if(pluck){ // a faint octave shimmer, like the paired course of a lyre string
    const o2=c.createOscillator(); o2.type='triangle'; o2.frequency.setValueAtTime(hz(n+12), t);
    const g2=c.createGain(); g2.gain.setValueAtTime(0.0001,t);
    g2.gain.exponentialRampToValueAtTime(gain*0.25, t+0.002);
    g2.gain.exponentialRampToValueAtTime(0.0001, t+dur*0.6);
    o2.connect(g2); g2.connect(bus); o2.start(t); o2.stop(t+dur);
  }
}
function musicDrum(t, ch){
  const c=audio.ctx, bus=audio.musicBus;
  if(ch==='k'){ const o=c.createOscillator(); o.type='sine';
    o.frequency.setValueAtTime(150,t); o.frequency.exponentialRampToValueAtTime(45,t+0.11);
    const g=c.createGain(); g.gain.setValueAtTime(0.34,t); g.gain.exponentialRampToValueAtTime(0.0001,t+0.13);
    o.connect(g); g.connect(bus); o.start(t); o.stop(t+0.15); return; }
  const dur = ch==='s'?0.13:0.035;
  const src=c.createBufferSource(); src.buffer=noiseBuf(c,dur,ch==='s'?2:3);
  const f=c.createBiquadFilter(); f.type=ch==='s'?'bandpass':'highpass';
  f.frequency.value= ch==='s'?1500:7000; f.Q.value=ch==='s'?0.9:0.7;
  const g=c.createGain(); g.gain.setValueAtTime(ch==='s'?0.2:0.075,t);
  g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
  src.connect(f); f.connect(g); g.connect(bus); src.start(t);
}
function musicPump(){   // called once per frame from loop(); schedules ~250ms ahead
  const c=audio.ctx;
  if(!c || !audio.track || !audio.musicOn || c.state!=='running') return;
  // if the tab slept (phone lock), nextTime is far in the past — resync rather
  // than burst-playing every missed note at once on refocus
  if(audio.nextTime < c.currentTime) audio.nextTime = c.currentTime + 0.05;
  const tr=audio.track, bus=audio.musicBus;
  while(audio.nextTime < c.currentTime + 0.25){
    const s=audio.step % 32, t=audio.nextTime;
    const v=tr.vol||1;
    const ln=tr.lead[s]; if(ln!==null && ln!==undefined) musicNote(t, ln, tr.wave, 0.13*v, audio.stepDur*(tr.pluck?2.2:3.2), bus, tr.pluck);
    const bn=tr.bass[s]; if(bn!==null && bn!==undefined) musicNote(t, bn, 'triangle', 0.22*v, audio.stepDur*3.6, bus, tr.pluck);
    const dc=tr.drum[s]; if(dc && dc!=='.') musicDrum(t, dc);
    audio.nextTime += audio.stepDur; audio.step++;
  }
}
// which track belongs to where the knight is standing right now
function musicFor(){
  // the credits close on the homestead song — the knight is home
  if(typeof credits!=='undefined' && credits && !RTRACKS.home.dead) return 'rt:home';
  // the title screen and save-select carry it too: the knight under the tree
  if(!boot.done){
    const p=boot.phase;
    return ((p==='title'||p==='select'||p==='out') && !RTRACKS.home.dead) ? 'rt:home' : null;
  }
  if(place.kind==='abaddon') return 'finale';
  if(place.kind==='dungeon'){
    if(dungeon.forest||dungeon.disillusion||dungeon.inGlade) return !RTRACKS.forest.dead ? 'rt:forest' : 'forest';
    if(demons.some(d=>d.alive&&d.boss)) return 'boss';
    return !RTRACKS.dungeon.dead ? 'rt:dungeon' : 'dungeon';
  }
  if(place.kind==='interior'||place.kind==='keep'){
    // an inn hearth has its own song; a chapel/sanctuary has its own; everything
    // else keeps the town chiptune
    if(place.kind==='interior' && INTERIORS[place.id] && INTERIORS[place.id].theme==='inn' && !RTRACKS.inn.dead) return 'rt:inn';
    if(place.kind==='interior' && INTERIORS[place.id] && INTERIORS[place.id].theme==='sanctuary' && !RTRACKS.chapel.dead) return 'rt:chapel';
    return 'town';
  }
  if(place.kind==='boatrace'||place.kind==='surf') return 'sail';
  if(place.kind==='portalworld'){
    // once the sun is let go, Sunfall changes key
    if(portalWorld.id==='sunfall' && (portalWorld.dawn||sunfallProgress.dawn) && !RTRACKS.dawn.dead) return 'rt:dawn';
    // a thawed Tabor breathes out; the uncleansed loop stays short and anxious
    if(portalWorld.id==='tabor' && taborProgress.thawed && !RTRACKS.taborclean.dead) return 'rt:taborclean';
    const t=RTRACKS[portalWorld.id]; return (t && !t.dead) ? 'rt:'+portalWorld.id : null; }
  if(place.kind==='overworld'){
    if(player.boating) return 'sail';
    // your own land sings its own song
    const _htx=Math.floor((player.x+TILE/2)/TILE), _hty=Math.floor((player.y+TILE/2)/TILE);
    if(inHomesteadMusic(_htx,_hty) && !RTRACKS.home.dead) return 'rt:home';
    return 'overworld';
  }
  return null;
}
// _legacy musicFor (pre-v66 recordings): credits -> 'rt:dawn'; !boot.done -> null;
//   forest dungeons -> 'forest' chiptune; all interiors/keep -> 'town';
//   overworld -> player.boating?'sail':'overworld' (no homestead branch).
function musicUpdate(){
  const want=musicFor();
  // recorded tracks: the overworld's 'theme', or a portal world's 'rt:<id>'
  const rt = want==='overworld' ? 'theme' : ((want && (''+want).slice(0,3)==='rt:') ? want.slice(3) : null);
  if(rt && RTRACKS[rt] && !RTRACKS[rt].dead && audio.musicOn){
    const tid = rt==='theme' ? 'theme' : 'rt:'+rt;
    if(audio.trackId && audio.trackId!==tid) musicStop();     // silence the sequencer
    for(const k in RTRACKS){ if(k!==rt) rtPause(RTRACKS[k]); }
    if(rtStart(RTRACKS[rt])){ audio.trackId=tid; return; }
  }
  rtPauseAll();
  if(audio.trackId==='theme' || (''+audio.trackId).slice(0,3)==='rt:') audio.trackId=null;   // fall back if a file is missing
  const seq = (want && (''+want).slice(0,3)==='rt:') ? null : want;   // recordings never reach the sequencer
  if(seq!==audio.trackId){ if(seq) musicPlay(seq); else musicStop(); }
}
// _legacy musicUpdate (pre-registry): special-cased THEME then SUNTHEME —
//   if(want==='overworld' && !THEME.dead ...){ ...themeStart... }
//   if(want==='sunfall' && !SUNTHEME.dead ...){ ...sunThemeStart... }
// _legacy musicUpdate (pre-Sunfall): single recorded track —
//   if(want==='overworld' && !THEME.dead && audio.musicOn){ ... themeStart ... }
//   themePause(); if(audio.trackId==='theme') audio.trackId=null; ...

// ════════════════════════════════════════════════════════════════
//  GBA-STYLE BOOT SEQUENCE — splash → title → save select
//  Runs before gameplay. Draws in a virtual 240×160 GBA space,
//  uniformly scaled + letterboxed onto the main canvas. Reuses the
//  Stormgate palette, the knight sprite, and the slot save system.
// ════════════════════════════════════════════════════════════════
const boot = { done:false, phase:'splash', t:0, cursor:0, fade:0, fin:0, fading:null, slashed:false, confirmed:false };
const BOOT_W=240, BOOT_H=160;

// ── tiny Web Audio kit (game has no audio system yet; kept self-contained) ──
let bootAC=null;
function bootAudio(){
  try{
    if(!bootAC) bootAC=new (window.AudioContext||window.webkitAudioContext)();
    if(bootAC.state==='suspended') bootAC.resume();
  }catch(e){ bootAC=null; }
  return bootAC;
}
function sfxSlash(){ // metallic slash: filtered noise sweep + a falling saw "shing"
  const ac=bootAudio(); if(!ac||ac.state!=='running') return;
  const t0=ac.currentTime;
  const len=Math.floor(ac.sampleRate*0.28);
  const buf=ac.createBuffer(1,len,ac.sampleRate), d=buf.getChannelData(0);
  for(let i=0;i<len;i++) d[i]=(Math.random()*2-1)*(1-i/len);
  const src=ac.createBufferSource(); src.buffer=buf;
  const bp=ac.createBiquadFilter(); bp.type='bandpass'; bp.Q.value=1.2;
  bp.frequency.setValueAtTime(6200,t0); bp.frequency.exponentialRampToValueAtTime(900,t0+0.26);
  const g=ac.createGain(); g.gain.setValueAtTime(0.5,t0); g.gain.exponentialRampToValueAtTime(0.001,t0+0.28);
  src.connect(bp); bp.connect(g); g.connect(ac.destination); src.start(t0);
  const o=ac.createOscillator(); o.type='sawtooth';
  o.frequency.setValueAtTime(1800,t0); o.frequency.exponentialRampToValueAtTime(220,t0+0.22);
  const og=ac.createGain(); og.gain.setValueAtTime(0.12,t0); og.gain.exponentialRampToValueAtTime(0.001,t0+0.22);
  o.connect(og); og.connect(ac.destination); o.start(t0); o.stop(t0+0.24);
}
function sfxBlip(up){ // menu blip (up=confirm chirp, else move tick)
  const ac=bootAudio(); if(!ac||ac.state!=='running') return;
  const t0=ac.currentTime;
  const o=ac.createOscillator(); o.type='square';
  o.frequency.setValueAtTime(up?740:520,t0);
  if(up) o.frequency.setValueAtTime(1108,t0+0.06);
  const g=ac.createGain(); g.gain.setValueAtTime(0.08,t0); g.gain.exponentialRampToValueAtTime(0.001,t0+(up?0.14:0.06));
  o.connect(g); g.connect(ac.destination); o.start(t0); o.stop(t0+(up?0.15:0.07));
}

// ── helpers ──
function bootShade(hex,f){ // darken a #rrggbb toward black by factor f (0..1 kept)
  const n=parseInt(hex.slice(1),16);
  const r=Math.round(((n>>16)&255)*f), g=Math.round(((n>>8)&255)*f), b=Math.round((n&255)*f);
  return '#'+((1<<24)|(r<<16)|(g<<8)|b).toString(16).slice(1);
}
function bootEase(x){ x=Math.max(0,Math.min(1,x)); return 1-Math.pow(1-x,3); } // easeOutCubic
function bootScale(){ return Math.min(VW/BOOT_W, VH/BOOT_H); }
function bootPhase(p){ boot.fading=p; boot.fade=1; } // start a fade-out into phase p

// ── input ──
function bootA(){
  bootAudio();
  if(boot.fading) return;
  if(boot.phase==='splash'){ sfxBlip(false); bootPhase('title'); return; }
  if(boot.phase==='title'){
    if(boot.t<620){ boot.t=620; return; }  // still slashing → jump to settled, don't confirm yet
    sfxBlip(true); bootPhase('select'); return;
  }
  if(boot.phase==='select'){
    if(boot.confirmed) return;
    boot.confirmed=true; sfxBlip(true);
    bootPhase('out');
  }
}
function bootB(){
  bootAudio();
  if(boot.fading || boot.phase!=='select') return;
  sfxBlip(false); bootPhase('title');   // GBA touch: back out to the title
}
function bootDir(d){
  bootAudio();
  if(boot.fading || boot.phase!=='select') return;
  if(d==='up'){ boot.cursor=(boot.cursor+SLOTS-1)%SLOTS; sfxBlip(false); }
  else if(d==='down'){ boot.cursor=(boot.cursor+1)%SLOTS; sfxBlip(false); }
}
function bootKey(e){
  const lk=e.key.toLowerCase();
  if(lk==='arrowup'||lk==='arrowdown'||lk==='arrowleft'||lk==='arrowright'||e.key===' ') e.preventDefault();
  if(lk==='arrowup'||lk==='w') bootDir('up');
  else if(lk==='arrowdown'||lk==='s') bootDir('down');
  else if(lk==='j'||lk==='z'||e.key==='Enter'||e.key===' ') bootA();
  else if(lk==='k'||lk==='x'||e.key==='Escape') bootB();
}
function bootTap(clientX, clientY){
  bootAudio();
  const r=cv.getBoundingClientRect();
  const cx=(clientX-r.left)*VW/r.width, cy=(clientY-r.top)*VH/r.height;
  const s=bootScale(), ox=(VW-BOOT_W*s)/2, oy=(VH-BOOT_H*s)/2;
  const gx=(cx-ox)/s, gy=(cy-oy)/s;   // tap in 240×160 GBA space
  if(boot.phase!=='select'){ bootA(); return; }
  // select screen: tap a slot card — first tap moves the cursor, tap again confirms
  for(let i=0;i<SLOTS;i++){
    const y0=BOOT_SEL_Y0+i*BOOT_SEL_H;
    if(gx>=16&&gx<=BOOT_W-16&&gy>=y0&&gy<=y0+BOOT_SEL_H-4){
      if(boot.cursor===i) bootA();
      else { boot.cursor=i; sfxBlip(false); }
      return;
    }
  }
}
const BOOT_SEL_Y0=52, BOOT_SEL_H=30;

// ── finish: hand off to the real game ──
function bootFinish(){
  const n=boot.cursor+1, inf=slotInfo(n);
  boot.done=true;
  audioUnlock();
  const _st=document.getElementById('stage'); if(_st) _st.classList.remove('booting');  // reveal the in-game HUD/controls now that gameplay begins
  // ✦ test shortcut: open the game with #maxhero in the URL to drop a fully-maxed
  //   hero (all chapels, both trees, Sky Steed, best gear) at the base of Tabor.
  let _wantMax=false; try{ _wantMax=/(^|[#&?])maxhero(\b|$)/i.test(location.hash||''); }catch(e){}
  if(_wantMax){ if(loadMaxHero(boot.cursor+1)) return; }
  if(inf){
    setActiveSlot(n);
    const r=loadGame();
    if(r.ok) showBanner(`📂 Slot ${n} — welcome back, <b>${player.name||'Knight'}</b>!<br><span style="font-size:6px;color:#9a8ab8">(☰ → System to save, switch, or start new profiles.)</span>`, 3000);
    else { showBanner('⚠️ Load failed — starting fresh on this slot.', 2000); newGameOnSlot(n); }
  } else {
    newGameOnSlot(n);   // fresh journey — the story intro takes over
  }
  if(!storageWorks) setTimeout(()=>showBanner('\u26a0\ufe0f <b>This device isn\u2019t keeping saves.</b><br><span style="font-size:7px">Your progress won\u2019t stick when you reopen the game. Use <b>\u2630 \u2192 System \u2192 \ud83d\udce4 Export Save Code</b> to back up your hero, and \ud83d\udce5 Import to restore.</span>', 7000), 3600);
}

// ── tick ──
function bootTick(dt){
  boot.t+=dt;
  if(boot.fading){
    boot.fade-=dt/300;
    if(boot.fade<=0){
      const p=boot.fading; boot.fading=null; boot.fade=0; boot.fin=1;
      if(p==='out'){ bootFinish(); return; }
      boot.phase=p; boot.t=0; boot.slashed=false; boot.confirmed=false;
      if(p==='select') boot.cursor=Math.min(SLOTS-1, Math.max(0, activeSlot-1));
    }
    return;
  }
  if(boot.fin>0) boot.fin=Math.max(0, boot.fin-dt/300);
  if(boot.phase==='splash' && boot.t>=1900) bootPhase('title');
  if(boot.phase==='title' && !boot.slashed && boot.t>=90){ boot.slashed=true; sfxSlash(); }
}

// ── drawing ──
function drawBootScanlines(){ // full-canvas GBA scanline pass, drawn in device pixels
  ctx.fillStyle='rgba(0,0,0,0.14)';
  for(let y=0;y<VH;y+=3) ctx.fillRect(0,y,VW,1);
}
function drawBootSplash(){
  const t=boot.t;
  const a = t<450 ? t/450 : t<1350 ? 1 : Math.max(0,(1900-t)/550);   // fade in · hold · fade out
  ctx.save(); ctx.globalAlpha=a; ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.shadowColor='#8a6cff'; ctx.shadowBlur=12*bootScale();
  ctx.fillStyle='#d8ccf0'; ctx.font='9px "Press Start 2P"';
  ctx.fillText('kspearproductions', BOOT_W/2, BOOT_H/2-4);
  ctx.shadowBlur=0; ctx.globalAlpha=a*0.6;
  ctx.fillStyle='#7a6a9a'; ctx.font='6px "Press Start 2P"';
  ctx.fillText('presents', BOOT_W/2, BOOT_H/2+14);
  ctx.restore(); ctx.textBaseline='alphabetic';
}
function drawBootVillage(bx,by,sway){ // the valley village — Homestead thatch palette (continuity)
  const th=(TOWN_THEMES.homestead&&TOWN_THEMES.homestead.pal)||{};
  const WALL=th.wall||'#e6dcc6', WALLD=th.wallDark||'#b8ae98', ROOF=th.roof||'#c8a04a', ROOFL=th.roofLit||'#e0bc6a', ROOFD=th.roofDark||'#9a7a34';
  const house=(hx,hy,w)=>{
    px(hx,hy,w,5,WALL); px(hx+w-1,hy,1,5,WALLD);
    px(hx-1,hy-3,w+2,3,ROOF); px(hx-1,hy-3,w+2,1,ROOFL); px(hx-1,hy-1,w+2,1,ROOFD);
    px(hx+Math.floor(w/2)-1,hy+2,2,3,'#6a4e30');                    // door
    px(hx+1,hy+1,1,1,'#5a7a8a');                                    // window
  };
  house(bx,by,8); house(bx+14,by+2,7); house(bx+27,by,8); house(bx+42,by+3,6);
  // the village chapel — white walls, a cross on the steeple (cleansed-chapel continuity)
  px(bx+55,by-4,7,9,'#f0ece0'); px(bx+61,by-4,1,9,'#c8c2b0');
  px(bx+54,by-7,9,3,ROOFD); px(bx+54,by-7,9,1,ROOF);
  px(bx+58,by-12,1,5,'#f0ece0'); px(bx+57,by-10,3,1,'#e8b93a'); px(bx+58,by-12,1,4,'#e8b93a'); // gold cross
  px(bx+57,by+2,2,3,'#6a4e30');
  // little swaying trees among the houses
  for(let i=0;i<5;i++){
    const tx=bx-8+i*16, ty=by+6, s=Math.round(Math.sin(sway+i*1.9)*1.2);
    px(tx+2,ty-2,2,4,'#6a4e30');
    px(tx+s,ty-8,6,5,'#4e7a4a'); px(tx+s,ty-8,6,1,'#639659'); px(tx+1+s,ty-10,4,3,'#639659');
  }
}
function drawBootTree(sway){ // the great oak, bottom-left — the knight's resting place
  const TR='#6a4e30', TRD='#4a3420', TRL='#8a6a44';
  const L1='#3a6a3a', L2='#4e8a4a', L3='#66a85c', L4='#82c072';
  px(24,96,10,44,TR); px(24,96,3,44,TRL); px(31,96,3,44,TRD);         // trunk
  px(18,128,8,6,TR); px(18,128,8,2,TRL);                              // root flare left
  px(32,130,9,5,TR); px(38,130,3,5,TRD);                              // root flare right
  px(20,90,6,10,TR); px(34,88,6,12,TR); px(35,88,3,3,TRD);            // rising limbs
  const s1=Math.sin(sway)*2, s2=Math.sin(sway+1.3)*1.5;               // canopy sway (two layers)
  const blob=(cx,cy,r,c)=>{ ctx.fillStyle=c; ctx.beginPath(); ctx.arc(cx,cy,r,0,7); ctx.fill(); };
  blob(30+s1*0.5,66,30,L1);  blob(6+s1,74,22,L1);  blob(58+s1,72,24,L1);
  blob(24+s2,58,24,L2);      blob(52+s2,60,18,L2); blob(0+s2,62,16,L2);
  blob(36+s1,52,18,L3);      blob(12+s1,54,14,L3);
  blob(28+s2,46,12,L4);      blob(48+s2,50,9,L4);
  // a leaf or two drifting down on the breeze
  const lt=(sway*140)%260, lx=54+((sway*80)%30), ly=70+lt*0.5;
  if(ly<132){ px(Math.round(lx+Math.sin(lt/14)*6), Math.round(ly), 2,1,'#82c072'); }
}
function drawBootChampion(t){ // the Grand Champion at rest — silver plate, golden cape, open Bible
  // palette lifted from drawKnightBody's championRobe branch (continuity)
  const PL='#dfe4ee', PLH='#f7f9fd', PLD='#b6bccb', OL='#3a4252';
  const CAPE='#d8a828', CAPE_L='#f0c94a', CAPE_D='#a67e1e', RC='#c0392e';
  const SKIN='#e0b080', SKIND='#b98a5a', HAIR='#6a4a2a', HAIRL='#8a6a3a';
  const LEG='#2a4a8a', LEGD='#1f3a70';
  const kx=36, ky=110;                                  // back to the trunk, facing the valley
  const br=Math.sin(t/1500)>0.2?1:0;                    // a slow, gentle breath
  // golden cape spread beneath him on the grass, red cross showing
  px(kx-2,ky+14,22,3,CAPE); px(kx-2,ky+14,22,1,CAPE_L); px(kx+15,ky+15,5,2,CAPE_D);
  px(kx+2,ky+14,2,3,RC); px(kx+1,ky+15,4,1,RC);
  // legs stretched toward the valley, knees gently raised
  px(kx+5,ky+10,6,3,LEG); px(kx+5,ky+10,6,1,LEGD);                                    // thigh
  px(kx+9,ky+8,4,2,LEG); px(kx+9,ky+8,4,1,LEGD);                                      // raised knee
  px(kx+12,ky+9,3,5,LEG); px(kx+14,ky+9,1,5,LEGD);                                    // shin
  px(kx+14,ky+13,4,2,PLD); px(kx+14,ky+13,4,1,PL);                                    // sabatons
  // breastplate, reclined against the bark
  px(kx,ky+3-br,7,8+br,PL); px(kx,ky+3-br,2,8+br,PLH); px(kx+5,ky+3-br,2,8+br,PLD);
  px(kx,ky+3-br,7,1,PLH); px(kx-1,ky+3,1,9,OL);
  px(kx-1,ky+4,3,4,CAPE); px(kx-1,ky+4,1,4,CAPE_D); px(kx-1,ky+4,3,1,CAPE_L);         // cape over the near shoulder
  // bare head, at ease — eyes lowered to the page
  px(kx+1,ky-2+br,5,5,SKIN); px(kx+4,ky-2+br,2,5,SKIND);
  px(kx,ky-3+br,6,2,HAIR); px(kx,ky-3+br,6,1,HAIRL); px(kx,ky-2+br,1,3,HAIR);
  px(kx+4,ky+1+br,1,1,'#3a2a1a');
  // arms reaching to the open Bible on his knees
  px(kx+3,ky+6,2,3,PL); px(kx+3,ky+6,1,3,PLH);
  px(kx+6,ky+6,4,3,'#f7f4ea'); px(kx+11,ky+6,4,3,'#efe9da');                          // open pages
  px(kx+6,ky+5,4,1,'#fffdf6'); px(kx+11,ky+5,4,1,'#fffdf6');                          // page tops in the light
  px(kx+10,ky+5,1,4,'#7a4a24');                                                       // spine
  px(kx+7,ky+6,2,1,'#b8b0a0'); px(kx+12,ky+6,2,1,'#b8b0a0');                          // lines of scripture
  px(kx+7,ky+7,3,1,'#b8b0a0'); px(kx+12,ky+7,3,1,'#b8b0a0');
  px(kx+6,ky+9,9,1,'#c9a94a');                                                        // gilded page edges
  px(kx+5,ky+8,2,2,SKIN); px(kx+14,ky+7,2,2,SKIN);                                    // hands holding it open
  // his helm set on the grass beside him, plume stirring
  const pw=Math.sin(t/700)>0?1:0;
  px(kx+22,ky+11,6,4,PL); px(kx+22,ky+11,6,1,PLH); px(kx+27,ky+11,1,4,PLD);
  px(kx+22,ky+13,6,1,'#8a94a4');                                                      // visor slit
  px(kx+23,ky+9,4,1,'#e05a4a'); px(kx+24+pw,ky+8,2,1,'#c0392e'); px(kx+25,ky+10,2,1,'#c0392e');
}
function drawBootTitleScene(){
  const t=boot.t, sway=t/900;
  // a clear morning sky
  const sky=ctx.createLinearGradient(0,0,0,110);
  sky.addColorStop(0,'#6fb2e0'); sky.addColorStop(0.7,'#a8d4ee'); sky.addColorStop(1,'#d8ecf4');
  ctx.fillStyle=sky; ctx.fillRect(0,0,BOOT_W,110);
  // the sun, gentle glow
  ctx.fillStyle='rgba(255,240,190,0.35)'; ctx.beginPath(); ctx.arc(206,22,16,0,7); ctx.fill();
  ctx.fillStyle='#fff2c0'; ctx.beginPath(); ctx.arc(206,22,9,0,7); ctx.fill();
  ctx.fillStyle='#fffbe8'; ctx.beginPath(); ctx.arc(204,20,5,0,7); ctx.fill();
  // clouds drifting slowly on the breeze
  ctx.fillStyle='#fbfdff';
  const CLOUDS=[[38,6],[52,15],[30,86]];   // kept clear of the title band
  for(let i=0;i<CLOUDS.length;i++){
    const cw=CLOUDS[i][0], cy=CLOUDS[i][1];
    const cx=((i*83 + t*(0.0035+i*0.0012)) % (BOOT_W+cw+40))-cw-20;
    ctx.fillRect(cx,cy,cw,5); ctx.fillRect(cx+6,cy-3,cw-14,3); ctx.fillRect(cx+4,cy+5,cw-8,2);
  }
  // a far pair of birds gliding over the valley
  for(let i=0;i<2;i++){
    const bx2=((t*0.006)+i*70)%280-20, by2=66+i*8+Math.sin(t/500+i)*2, w=Math.sin(t/160+i*2)>0?1:0;
    px(Math.round(bx2),Math.round(by2),2,1,'#4a5a6a'); px(Math.round(bx2)+2,Math.round(by2)-w,2,1,'#4a5a6a');
  }
  // far hills, then the valley floor
  ctx.fillStyle='#9cc48e'; ctx.beginPath();
  ctx.moveTo(0,104); ctx.quadraticCurveTo(60,92,130,102); ctx.quadraticCurveTo(190,110,240,98);
  ctx.lineTo(240,160); ctx.lineTo(0,160); ctx.closePath(); ctx.fill();
  ctx.fillStyle='#8ab87c'; ctx.fillRect(0,112,BOOT_W,48);
  // hedgerow field lines give the valley its patchwork
  ctx.fillStyle='rgba(90,140,80,0.5)';
  ctx.fillRect(120,116,90,1); ctx.fillRect(150,124,80,1); ctx.fillRect(112,131,60,1);
  drawBootVillage(122,118,sway);
  // the foreground hill he rests on
  ctx.fillStyle='#6aa85c'; ctx.beginPath();
  ctx.moveTo(0,120); ctx.quadraticCurveTo(50,100,105,126); ctx.quadraticCurveTo(130,138,150,160);
  ctx.lineTo(0,160); ctx.closePath(); ctx.fill();
  ctx.fillStyle='#7cbc6a'; ctx.beginPath();
  ctx.moveTo(0,124); ctx.quadraticCurveTo(50,104,100,130); ctx.lineTo(70,160); ctx.lineTo(0,160);
  ctx.closePath(); ctx.fill();
  drawBootTree(sway);
  drawBootChampion(t);
  // grass tufts + wildflowers on the hillside
  const gr=[[8,126],[58,120],[76,128],[92,136],[40,132],[66,142],[16,140]];
  for(let i=0;i<gr.length;i++){ const b=Math.round(Math.sin(sway*2+i)*1);
    px(gr[i][0]+b,gr[i][1]-2,1,2,'#4e8a4a'); px(gr[i][0]+2,gr[i][1]-3,1,3,'#4e8a4a'); px(gr[i][0]+4-b,gr[i][1]-2,1,2,'#4e8a4a'); }
  px(84,124,1,1,'#e86a8a'); px(96,132,1,1,'#f0f0f8'); px(52,128,1,1,'#f2c14e'); px(30,142,1,1,'#e86a8a');
}
function drawBootSword(t){
  // sword pierces left→right along y=64, overshoots, settles centered — the knight's own steel
  const BLADE='#e8e8f0', BLADE_HI='#ffffff', BLADE_D='#9aa2b2', GUARD='#d8b24a', GUARD_D='#a8842a', GRIP='#7a4a24', POMMEL='#c9a94a';
  const dur=560, k=bootEase(t/dur);
  const over=t<dur ? Math.sin(Math.min(1,t/dur)*Math.PI)*10 : 0;
  const sx=-140 + k*(BOOT_W/2-70+140) + over;   // pommel x; settles so the 140px sword centers
  const y=64;
  if(t<dur){ // motion streak behind the tip
    const g=ctx.createLinearGradient(sx-70,0,sx+140,0);
    g.addColorStop(0,'rgba(232,232,240,0)'); g.addColorStop(1,'rgba(232,232,240,0.35)');
    ctx.fillStyle=g; ctx.fillRect(Math.max(0,sx-70),y-1,140+70,3);
  }
  px(sx,y-2,4,5,POMMEL);                       // pommel
  px(sx+4,y-1,12,3,GRIP);                      // grip
  px(sx+16,y-5,4,11,GUARD); px(sx+16,y+4,4,2,GUARD_D);   // crossguard
  px(sx+20,y-2,112,5,BLADE);                   // blade
  px(sx+20,y-2,112,1,BLADE_HI);
  px(sx+20,y+2,112,1,BLADE_D);
  px(sx+132,y-2,5,2,BLADE); px(sx+132,y,5,2,BLADE);      // tip taper
  px(sx+137,y-1,3,3,BLADE_HI);
  // impact flash as the blade crosses center
  if(t>300&&t<390){ ctx.fillStyle='rgba(255,255,255,'+(0.85*(1-(t-300)/90))+')'; ctx.fillRect(0,0,BOOT_W,BOOT_H); }
}
function bootOutlineText(txt,x,y,fill,outline){
  ctx.fillStyle=outline;
  ctx.fillText(txt,x-1,y); ctx.fillText(txt,x+1,y); ctx.fillText(txt,x,y-1); ctx.fillText(txt,x,y+1);
  ctx.fillText(txt,x+2,y+2);   // deeper corner shadow keeps the GBA weight
  ctx.fillStyle=fill; ctx.fillText(txt,x,y);
}
function drawBootTitleText(t){
  const k1=bootEase((t-360)/420);   // LAST KNIGHT slams in from the right as the sword passes
  const k2=bootEase((t-620)/360);   // KINGDOM'S settles in above
  ctx.textAlign='center';
  if(k2>0){
    ctx.globalAlpha=k2; ctx.font='8px "Press Start 2P"';
    bootOutlineText("KINGDOM'S", BOOT_W/2, 34+(1-k2)*-10, '#f2c14e', '#3a2a10');
  }
  if(k1>0){
    const x=BOOT_W/2+(1-k1)*160;
    ctx.globalAlpha=k1; ctx.font='16px "Press Start 2P"';
    bootOutlineText('LAST KNIGHT', x, 56, '#f7f9fd', '#141c2e');
  }
  ctx.globalAlpha=1;
  if(t>1150){
    if(Math.floor(t/480)%2===0){
      ctx.font='8px "Press Start 2P"';
      bootOutlineText('PRESS \u24b6', BOOT_W/2, 148, '#ffe9c0', '#1c2e1a');
    }
    ctx.font='5px "Press Start 2P"'; ctx.fillStyle='#2e4a2c';
    ctx.fillText('\u00a9 2026 kspearproductions', BOOT_W/2, 157);
  }
  ctx.textAlign='left';
}
function drawBootSelect(){
  drawBootTitleScene();
  ctx.fillStyle='rgba(8,5,16,0.72)'; ctx.fillRect(0,0,BOOT_W,BOOT_H);   // dim the scene behind the panel
  ctx.textAlign='center';
  ctx.fillStyle='#f2c14e'; ctx.font='9px "Press Start 2P"';
  ctx.fillText('CHOOSE YOUR KNIGHT', BOOT_W/2, 30);
  for(let i=0;i<SLOTS;i++){
    const y0=BOOT_SEL_Y0+i*BOOT_SEL_H, cur=i===boot.cursor, inf=slotInfo(i+1);
    ctx.fillStyle=cur?'rgba(60,40,90,0.9)':'rgba(24,18,40,0.9)';
    ctx.fillRect(16,y0,BOOT_W-32,BOOT_SEL_H-6);
    ctx.strokeStyle=cur?'#e94560':'#4a3e66'; ctx.lineWidth=2;
    ctx.strokeRect(17,y0+1,BOOT_W-34,BOOT_SEL_H-8);
    ctx.textAlign='left';
    if(cur){ ctx.fillStyle='#ffe9c0'; ctx.font='8px "Press Start 2P"'; ctx.fillText('\u25b6', 22, y0+15); }
    if(inf){
      ctx.fillStyle=cur?'#eef0f4':'#b8aed0'; ctx.font='7px "Press Start 2P"';
      ctx.fillText(`SLOT ${i+1}  ${inf.name.toUpperCase().slice(0,10)}`, 34, y0+11);
      ctx.fillStyle=cur?'#8fd692':'#6a8a6e'; ctx.font='6px "Press Start 2P"';
      ctx.fillText(`LV ${inf.level} \u00b7 ${inf.towns}/10${inf.won?' \u00b7 \ud83d\udc51':''} \u00b7 \u23f1${fmtPlay(inf.playMs)}`, 34, y0+20);
    } else {
      ctx.fillStyle=cur?'#c7a6ff':'#7a6a9a'; ctx.font='7px "Press Start 2P"';
      ctx.fillText(`SLOT ${i+1}  \u2014 NEW GAME \u2014`, 34, y0+15);
    }
    ctx.textAlign='center';
  }
  ctx.fillStyle='#7a6a9a'; ctx.font='6px "Press Start 2P"';
  ctx.fillText('\u25b2\u25bc choose \u00b7 \u24b6 confirm \u00b7 \u24b7 back', BOOT_W/2, 150);
  ctx.textAlign='left';
}
function drawBoot(){
  ctx.setTransform(RENDER_SCALE,0,0,RENDER_SCALE,0,0);
  ctx.fillStyle='#05030a'; ctx.fillRect(0,0,VW,VH);    // letterbox bed
  const s=bootScale();
  ctx.save();
  ctx.translate(Math.round((VW-BOOT_W*s)/2), Math.round((VH-BOOT_H*s)/2));
  ctx.scale(s,s);
  ctx.beginPath(); ctx.rect(0,0,BOOT_W,BOOT_H); ctx.clip();
  ctx.fillStyle='#0d0208'; ctx.fillRect(0,0,BOOT_W,BOOT_H);
  if(boot.phase==='splash') drawBootSplash();
  else if(boot.phase==='title'){ drawBootTitleScene(); drawBootSword(boot.t); drawBootTitleText(boot.t); }
  else if(boot.phase==='select') drawBootSelect();
  const veil=Math.max(boot.fading!==null?1-boot.fade:0, boot.fin);
  if(veil>0){ ctx.fillStyle='rgba(5,3,10,'+veil.toFixed(3)+')'; ctx.fillRect(0,0,BOOT_W,BOOT_H); }
  ctx.restore();
  drawBootScanlines();
  ctx.globalAlpha=1;
}
// boot-only canvas taps (advance / choose a slot) — gameplay taps are untouched

// ── OLD MAN ELIJAH: a retired knight of the shore, placed on the sand
//    nearest the surf break (tile 21), board planted beside him. ──
(function placeElijah(){
  let bx=-1, by=-1;
  outer: for(let y=0;y<WORLD_H;y++)for(let x=0;x<WORLD_W;x++){
    if(WORLD[y][x]===21){ bx=x; by=y; break outer; } }
  if(bx<0) return;
  for(let r=1;r<14;r++)for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++){
    const x=bx+dx, y=by+dy;
    if(x<1||y<1||x>=WORLD_W-1||y>=WORLD_H-1) continue;
    if(WORLD[y][x]!==19) continue;
    addVillager(x, y, 'peasant', [
      "The Lord walked on water, son. I just try to stand on it a little longer each day.",
      "Forty years I wore the armor. Now the tide does my sparring.",
      "Every wave ends on the shore, lad. Ride it anyway \u2014 that is faith." ]);
    const v=villagers[villagers.length-1];
    v.look='elijah'; v.vname='Old Man Elijah';
    return;
  }
})();

cv.addEventListener('touchstart', e=>{ if(boot.done) return; e.preventDefault(); const t=e.changedTouches[0]; bootTap(t.clientX,t.clientY); }, {passive:false});
cv.addEventListener('mousedown',  e=>{ if(boot.done) return; e.preventDefault(); bootTap(e.clientX,e.clientY); });
(function(){ const pe=document.getElementById('btnPot'); if(!pe) return;
  pe.addEventListener('touchstart', e=>{ e.preventDefault(); quickPotion(); }, {passive:false});
  pe.addEventListener('mousedown',  e=>{ e.preventDefault(); quickPotion(); });
})();
// keep the in-game HUD/minimap/controls hidden until the boot sequence hands off
// Snapshot every inventory key the game knows about, now that the whole file has
// run and they all exist. applySaveData lays these down before overlaying a save.
(function(){ for(const k in inventory) if(!(k in INVENTORY_DEFAULTS)) INVENTORY_DEFAULTS[k]=0; })();
(function(){ const _st=document.getElementById('stage'); if(_st) _st.classList.add('booting'); })();

// a pristine snapshot of the just-booted state — used to start clean new games
const FRESH_STATE = JSON.stringify(buildSaveData());
function newGameOnSlot(n){
  setActiveSlot(n);
  applySaveData(JSON.parse(FRESH_STATE));   // wipe to a fresh knight (slot stays empty until saved)
  if(menu.open) toggleMenu();
  startIntro();
}
// _legacy: returning players used to auto-load here; the GBA boot sequence
// (splash → title → save select) now decides via bootFinish() instead.
// if(hasSave()){ const r=loadGame(); ... } else startIntro();
boot.cursor=Math.min(SLOTS-1, Math.max(0, activeSlot-1));   // preselect the last-played slot
// (the storage warning banner also moved into bootFinish, so it lands after the intro)
requestAnimationFrame(loop);
</script>
</body>
</html>
