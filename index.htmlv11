      px(x+TILE-3,y,3,TILE,'#6b6275'); px(x+TILE-3,y,2,3,'#9b93a6');               // right stone post
      px(x+3,y+TILE-2,TILE-6,2,'#7a5a2a'); break; } // GATE (opening between posts)
    case 1: if(desert){ px(x,y,TILE,TILE,'#e8d6a0'); px(x+6,y+4,4,10,'#3f8a4e'); px(x+3,y+7,3,2,'#3f8a4e'); px(x+3,y+5,2,3,'#3f8a4e'); px(x+10,y+9,3,2,'#3f8a4e'); px(x+11,y+7,2,3,'#3f8a4e'); }
      else if(ashland){ px(x,y,TILE,TILE,'#5a4a42'); px(x+7,y+3,2,12,'#2a2018'); px(x+4,y+5,3,1,'#1a1410'); px(x+9,y+7,3,1,'#1a1410'); px(x+3,y+4,2,1,'#1a1410'); }
      else { // PINE TREE — layered triangular tiers, trunk, ground shadow (reference style)
        px(x,y,TILE,TILE,'#5fa860'); px(x+1+h4,y+2,1,1,'#6cbc6d');
        px(x+3,y+13,11,2,'rgba(16,40,20,0.35)');            // ground shadow
        px(x+7,y+10,3,5,'#5b3a1f'); px(x+7,y+10,1,5,'#7a5430'); // trunk (lit left)
        const dk=(h1<6)?'#1c5a2a':'#205e30', md=(h1<6)?'#2a6e38':'#2e7440';
        px(x+1,y+9,14,3,dk);                                  // bottom tier
        px(x+2,y+6,12,3,md);                                  // middle tier
        px(x+4,y+3,8,3,dk);                                   // upper tier
