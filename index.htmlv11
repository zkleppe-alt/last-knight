      let seen=reach(), guard=0;
      for(let x=1;x<MAZE_W-1;x++){
        if(g[3][x]===1 || seen.has(x+',3')) continue;
        for(let y=4;y<MAZE_H-1 && guard++<MAZE_W*MAZE_H;y++){
