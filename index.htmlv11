  barley:     { name:'Barley',         emoji:'🌾', value:3 },   // worth least by measure — but three to a plot
  grapes:     { name:'Grapes',         emoji:'🍇', value:22 },  // slow to come in; the vine keeps its own time
  perch:      { name:'Pond Perch',     emoji:'🐟', value:3 },
  trout:      { name:'Forest Trout',   emoji:'🐟', value:6 },
