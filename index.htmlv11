  const carve=(x,y)=>{ if(!G[y])return; const t=G[y][x];
    if(t===5||t===9) return; if(t===2||t===10||t===11){ G[y][x]=12; } else { G[y][x]=3; } setElev(x,y,0); };
  // feeder: from the great stream at (82,8) east to the vale NW (96,8)
  for(let x=82;x<=97;x++){ carve(x,8); carve(x,9); }
  // diagonal river NW(96,8) -> SE(120,30), 2 wide
  const rx0=96, ry0=8, rx1=120, ry1=30;
  const span=[];
  for(let t=0;t<=160;t++){ const f=t/160;
    const cx=Math.round(rx0+(rx1-rx0)*f), cy=Math.round(ry0+(ry1-ry0)*f);
    span.push([cx,cy]);
    for(let w=0;w<2;w++){ const x=cx+w,y=cy; if(G[y]&&!KEEP.has(G[y][x])){ G[y][x]=3; setElev(x,y,0); } }
  }

  // 3) THE POND — pools in the SE corner where the river arrives
  for(let y=26;y<=33;y++) for(let x=114;x<=122;x++){
    if((x-113)+(33-y)<=12 && G[y]&&!KEEP.has(G[y][x])){ G[y][x]=3; setElev(x,y,0); }
  }
  for(const k in FISH_SPOTS) if(FISH_SPOTS[k]==='pond') delete FISH_SPOTS[k];
  for(let y=26;y<=33;y++) for(let x=114;x<=122;x++){ if(G[y]&&G[y][x]===3) FISH_SPOTS[x+','+y]='pond'; }

  // 4) THE FOOTBRIDGE — single crossing, mid-vale
  let bridge=null;
  for(const [cx,cy] of span){ if(cy>=16&&cy<=20 && !bridge){
    for(let w=-1;w<3;w++){ const x=cx+w; if(G[cy]&&G[cy][x]===3){ G[cy][x]=12; setElev(x,cy,0); } }
    bridge=[cx,cy];
  } }

  // 5) FARM PLOTS — several tidy strips on the southern bank (roomy spread)
  const plots=[];
  const plot=(x,y)=>{ if(G[y]&&G[y][x]===0){ G[y][x]=31; plots.push([x,y]); } };
  for(let y=22;y<=24;y++) for(let x=104;x<=110;x++) plot(x,y);   // strip A
  for(let y=27;y<=29;y++) for(let x=104;x<=111;x++) plot(x,y);   // strip B
  for(let y=27;y<=29;y++) for(let x=98;x<=102;x++)  plot(x,y);   // strip C (by barn)
  FARM_PLOTS.length=0; plots.forEach(p=>FARM_PLOTS.push(p));

  // 6) PATHS — a single clean route in from the south gate, around the fields,
  //    across the bridge, to both homes. No dead-ends.
  const P=(x,y)=>{ if(G[y]&&G[y][x]===0) G[y][x]=2; };
  const link=(x0,y0,x1,y1)=>{ let x=x0,y=y0,g=0;
    while((x!==x1||y!==y1)&&g++<200){ P(x,y); if(x!==x1)x+=Math.sign(x1-x); else if(y!==y1)y+=Math.sign(y1-y); } P(x1,y1); };
  const bx = bridge?bridge[0]:105, by = bridge?bridge[1]:16;
  // straight helpers keep lanes clean (no zig-zag): a vertical run, then horizontal.
  const vrun=(x,y0,y1)=>{ for(let y=Math.min(y0,y1);y<=Math.max(y0,y1);y++) P(x,y); };
  const hrun=(y,x0,x1)=>{ for(let x=Math.min(x0,x1);x<=Math.max(x0,x1);x++) P(x,y); };
  const LANE=102;
  // SOUTH GATE: punch a clean opening through the tree ring and run a spur OUT
  // to the world road below, plus IN to the west lane.
  P(GATEx,Y1-1); P(GATEx,Y1); P(GATEx+1,Y1-1); P(GATEx+1,Y1);
  vrun(GATEx, 31, Y1+4);                 // spur down through the gate, out past the woods
  vrun(GATEx+1, Y1, Y1+4);
  hrun(31, LANE, GATEx);                 // gate -> west lane
  // WEST LANE up the vale to the bridge
  vrun(LANE, by+1, 31);
  hrun(30, 101, LANE);                   // -> barn door
  hrun(26, LANE, 108);                   // -> fields & farm stand
  hrun(by+1, LANE, bx);                  // lane -> bridge south end
  // NORTH BANK: straight up from the bridge, then to each home
  vrun(bx, 12, by-1);
  hrun(12, bx, 110); P(110,11);          // -> family home door
  vrun(116, 12, 17); hrun(12, bx, 116);  // -> merchant door

  // 7) farm stand by the south fields
  const stand=decorations.find(d=>d.kind==='farmStand'); if(stand){ stand.x=108; stand.y=25; }
  if(G[25]) { G[25][108]=5; G[25][109]=5; }
  SELL_SPOT='108,26';
  if(G[24]&&G[24][107]===0){ G[24][107]=16; signs['107,24']='FARM STAND\nStand below, face up, press Ⓐ\nto sell wheat & fish for gold!'; }

  // 8) relocate farmer villagers onto dry ground
  { let fi=0; const spots=[[103,31],[107,26]]; villagers.filter(v=>v.outfit==='farmer').forEach(farm=>{ const s=spots[fi++%spots.length]; farm.x=s[0]*TILE; farm.y=s[1]*TILE; farm.hx=s[0]; farm.hy=s[1]; farm.tx=s[0]; farm.ty=s[1]; }); }
  // Old Mule stands just east of the barn door (101,30) on open ground; make its tile solid + add its sign
  { const mx=104, my=31; decorations.push({x:mx,y:my,kind:'mule',w:1}); if(WORLD[my]) WORLD[my][mx]=5;
    signs[mx+','+my]="Old Mule\n(The mule regards you with mild interest,\nthen flicks an ear toward the empty cart-hitch.)"; }

  // 🐎 Homestead race booth — a tourney sign-post by the barn (player faces it to enter)
  { const bx=106, by=31; if(WORLD[by]) WORLD[by][bx]=16;
    signs[bx+','+by]="🐎 THE KING'S TOURNEY\nA travelling race-marshal's booth.\nFace it and press Ⓐ to ride."; 
    RACE_SPOTS.push(bx+','+by); }

  // 🐎 capital race booth — the grand tourney post in Stormgate's plaza (relocated coords)
  { const bx=172, by=207; if(WORLD[by]) WORLD[by][bx]=16;
    signs[bx+','+by]="🐎 THE KING'S TOURNEY\nThe royal racing grounds.\nFace it and press Ⓐ to ride.";
    RACE_SPOTS.push(bx+','+by);
    // a grassy racing-paddock plot around the post so it stands out on the grey plaza
    // (like the pet-tournament green), without covering the booth or its approaches.
    for(let yy=by-1; yy<=by+2; yy++) for(let xx=bx-2; xx<=bx+1; xx++){
      if(xx===bx && yy===by) continue;
      if(WORLD[yy] && WORLD[yy][xx]===6) WORLD[yy][xx]=18;
    }
    WORLD[by][bx]=16;
  }

  // 9) signs
  if(G[Y1-2]&&G[Y1-2][GATEx-2]===0){ G[Y1-2][GATEx-2]=16; signs[(GATEx-2)+','+(Y1-2)]='THE HOMESTEAD\nYour reward, brave knight.\nRest here a while. '+'🌾'; }
  if(G[22]&&G[22][103]===0){ G[22][103]=16; signs['103,22']='THE FIELDS\nFace a plot, press Ⓐ to plant.'; }
  if(G[27]&&G[27][116]===0){ G[27][116]=16; signs['116,27']='THE POND\nFace the water, press Ⓐ to fish.'; }

  // 9b) connect the south gate spur to the great east-west road (rows ~32-33)
  for(let y=Y1+1;y<=46;y++){ if(G[y]&&(G[y][GATEx]===0||G[y][GATEx]===1)){ G[y][GATEx]=2; }
    if(G[y]&&(G[y][GATEx+1]===0||G[y][GATEx+1]===1)){ G[y][GATEx+1]=2; }
    if(G[y]&&(G[y][GATEx]===2)&&(G[y][GATEx-1]===2||G[y][GATEx+2]===2)) break; }
  // ensure it physically meets a road tile: walk down until we hit one
  { let y=Y1+1, hit=false; while(y<60&&!hit){ for(let x=GATEx-2;x<=GATEx+3;x++){ if(G[y]&&G[y][x]===2&&y>Y1+2){ hit=true; } } if(!hit){ if(G[y]){G[y][GATEx]=2;G[y][GATEx+1]=2;} y++; } } }
  // weld any stray south-fringe fragment into the gate spur (kills dead-ends)
  { for(let y=34;y<=36;y++){ let has=false; for(let x=90;x<=GATEx;x++) if(G[y]&&G[y][x]===2) has=true;
      if(has){ for(let x=90;x<=GATEx;x++){ if(G[y]&&(G[y][x]===2||G[y][x]===0||G[y][x]===1)) G[y][x]=2; } break; } } }

  // clear a stray horizontal path fragment on the south fringe (old layout leftover)
  for(const [sx,sy] of [[94,35],[95,35],[96,35],[97,35],[98,35],[99,35],[100,35],[101,35],[102,35],[103,35]]){
    if(G[sy]&&G[sy][sx]===2 && sx!==GATEx && sx!==GATEx+1) G[sy][sx]=0;
  }
  // 9b) CONNECT the south gate cleanly to the world highway (which runs at row 35)
  //     and ERASE every orphan path tile south of it.
  // hard-clear the orphan column below the highway
  for(let y=36;y<=48;y++){ for(const x of [103,104,105,106]){ if(G[y]&&[2,10,11].includes(G[y][x])) G[y][x]=0; } }
  // open the gate (2 wide) and drop a tidy spur from the gate to the row-35 highway
  for(let y=Y1-1;y<=35;y++){ for(const x of [GATEx,GATEx+1]){ if(G[y]&&(G[y][x]===0||G[y][x]===1||G[y][x]===7)) G[y][x]=2; } }
  // weld the row-35 highway gap (x98) so the western road fragment joins the
