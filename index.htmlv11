        }
      }
      if(easyX!==null) break;
    }
    if(easyX===null){
      // the maze offered no pair far enough apart: take the widest span available
      // and open the cell beneath each. Opening a cell can only ADD a connection,
      // never sever one, so the maze stays whole.
      const all=[]; for(let x=3;x<=bx-2;x+=2) all.push(x);
      easyX=all[0]; hardX=all[all.length-1];
    }
    for(const cx2 of [easyX,hardX]){
      if(g[3][cx2]===1) g[3][cx2]=0;
      // and dig down until it meets corridor. Opening cells only ever ADDS
      // connections, so this cannot sever the maze — but without it a climb can
      // open onto a single walled-in cell and lead nowhere.
      // Dig FIRST, then test. Testing first breaks out while the current cell is
