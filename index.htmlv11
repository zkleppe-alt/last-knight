  ]},
  instinct: { name:'Instinct', icon:'👁', color:'#f5a623', nodes:[
    { id:'instinct0', tier:0, name:'Sharp Senses', cost:1, desc:"+5% Crit",                     bonus:{crit:0.05} },
    { id:'instinct1', tier:1, name:'Pounce',        cost:1, desc:"+3 Attack",                    bonus:{atk:3} },
    { id:'instinct2', tier:2, name:'Pack Tactics',  cost:2, desc:"+4 Attack (pet harries foes)", bonus:{atk:4} },
    { id:'instinct3', tier:3, name:'Wild Fury',     cost:3, desc:"ULT: +12 Atk, +12% Crit",      bonus:{atk:12,crit:0.12} },
  ]},
