    for(let i=0;i<4;i++){ const c=take(); if(c){ placed.push(c); g[c[1]][c[0]]=T_VERSE; } }
    // the wall: a stretch of rock beside a corridor, set well in from the door
    let wall=null, bestD=-1;
    for(let y=3;y<MAZE_H-1;y++)for(let x=1;x<MAZE_W-1;x++){
      if(g[y][x]!==1) continue;
      const touch=[[1,0],[-1,0],[0,1],[0,-1]].some(([dx,dy])=>g[y+dy]&&g[y+dy][x+dx]===0&&distm[(x+dx)+','+(y+dy)]!==undefined);
      if(!touch) continue;
      const d=distm[x+','+y]!==undefined?0:Math.abs(x-ex)+Math.abs(y-ey);
