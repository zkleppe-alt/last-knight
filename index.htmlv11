    // it — a chest, a demon, sometimes a climb — so every placement is checked
    // against the whole floor before it is accepted.
    const openCells=()=>{ const seen=new Set([ex+','+ey]), st=[[ex,ey]];
      while(st.length){ const [x,y]=st.pop();
        for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nx=x+dx, ny=y+dy, k=nx+','+ny;
          if(nx<1||ny<1||nx>=MAZE_W-1||ny>=MAZE_H-1||seen.has(k)) continue;
          const t=g[ny][nx];
          if(t===1||t===T_SEAL||t===T_CANDLE||t===T_CANDLE_LIT||t===T_TABLET) continue;
