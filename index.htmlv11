  buildings.push({ id:'sm_inn',    name:'The Salty Anchor',  style:'inn',    x:27, y:86, w:5, h:4, door:{x:29,y:90}, interior:'sm_inn' });
  buildings.push({ id:'sm_home1',  name:"Fisher's Cottage",  style:'cottage',x:5,  y:91, w:4, h:2, door:{x:6,y:93}, interior:'sm_home1' });
