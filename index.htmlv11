    const severs=(x,y)=>{ const before=open(); const was=g[y][x]; g[y][x]=T_VERSE;
      const after=open(); g[y][x]=was;
      for(const k of before){ if(k===x+','+y) continue; if(!after.has(k)) return true; }
      return false; };
    const take=()=>{ for(let n=0;n<cells.length;n++){
        const j=Math.floor(rnd()*cells.length); const [x,y]=cells[j]; cells.splice(j,1); n--;
        if(!far(x,y)) { if(!cells.length) break; continue; }
