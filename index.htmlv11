      const room=7-nC+i;                       // leave enough churches for the rest
      const j=from+Math.floor(rnd()*(room-from+1));
      pick.push(j); from=j+1;
    }
    // candidate cells: open maze floor, away from the entrance and each other,
    // and never at a climb's foot (a solid tile there bars the route it opens)
    const cells=[];
    for(let y=3;y<MAZE_H-1;y++)for(let x=1;x<MAZE_W-1;x++){
      if(g[y][x]!==0 || _footOfClimb(x,y)) continue;
