WORLD_READY=true;
// flush any decoration solids that were queued during world construction
pendingSolid.forEach(([x,y])=>{ if(WORLD[y]&&WORLD[y][x]!==undefined) WORLD[y][x]=5; });

// ════════════════════════════════════════════════════════════════
//  GRID RELOCATION PASS — move every town onto a clean grid, trace one
//  ordered H/V path, and lay the whole bottom edge as coastal sea.
//  Each town's interior design is preserved; only its position changes.
// ════════════════════════════════════════════════════════════════
(function relocateToGrid(){
  const OLD=WORLD;
  // town wall-boxes in the OLD world  ->  new top-left origin
  const PLAN = {
    Hearthvale:  [3,1,36,21,      16,12],
    Homestead:   [32,21,53,43,    98,14],
    Ironhold:    [3,50,46,73,     14,52],
    Saltmere:    [3,84,46,110,    12,198],
    Thornwood:   [45,69,72,91,    78,146],
    Dusthaven:   [47,29,72,51,    80,58],
    Crystalpeak: [59,99,85,116,   140,60],
    Ashfield:    [45,119,85,148,  138,136],
    Stormgate:   [100,118,136,148,150,198],
    Shadowmere:  [115,37,139,60,  205,136],
    Hellgate:    [113,0,139,14,   212,12],
  };
  const delta={};
  for(const t in PLAN){ const p=PLAN[t]; delta[t]=[p[4]-p[0], p[5]-p[1]]; }
  // which OLD-world town box contains tile (x,y)?
  function townAt(x,y){ for(const t in PLAN){ const[x0,y0,x1,y1]=PLAN[t]; if(x>=x0&&x<=x1&&y>=y0&&y<=y1) return t; } return null; }
  function shift(px,py){ const t=townAt(px,py); if(!t)return null; const[dx,dy]=delta[t]; return [px+dx,py+dy,t]; }

  // ---- build new grass world ----
  const NW=250, NH=300;   // +50 rows of southern ocean for the archipelago
  const G=Array.from({length:NH},()=>Array(NW).fill(0));
  // stamp each town block at its new origin
  for(const t in PLAN){ const[x0,y0,x1,y1,nx,ny]=PLAN[t];
    for(let y=y0;y<=y1;y++)for(let x=x0;x<=x1;x++){ const v=OLD[y]&&OLD[y][x]; if(v===undefined)continue;
      const gx=nx+(x-x0), gy=ny+(y-y0); if(G[gy]&&G[gy][gx]!==undefined) G[gy][gx]=v; } }

  // Erase a stamped building footprint back into whatever ground surrounds it.
  // Used when a building is relocated after the world has already been stamped —
  // without it the walls and the door tile stay behind as a structure the player
  // can walk up to, see a door on, and never enter.
  function clearFootprint(G,b){
    const counts={};
    const look=(x,y)=>{ const r=G[y]; if(!r) return; const v=r[x]; if(v===undefined) return;
                        if(WALK.has(v)) counts[v]=(counts[v]||0)+1; };
    for(let x=b.x-1;x<=b.x+b.w;x++){ look(x,b.y-1); look(x,b.y+b.h); }
    for(let y=b.y-1;y<=b.y+b.h;y++){ look(b.x-1,y); look(b.x+b.w,y); }
    let fill=0, best=-1;
    for(const k in counts) if(counts[k]>best){ best=counts[k]; fill=+k; }
    for(let y=b.y;y<b.y+b.h;y++) for(let x=b.x;x<b.x+b.w;x++)
      if(G[y]&&G[y][x]!==undefined) G[y][x]=fill;
    if(b.door&&G[b.door.y]&&G[b.door.y][b.door.x]!==undefined) G[b.door.y][b.door.x]=fill;
  }
  // ---- shift entities (capture town BEFORE mutating coords) ----
  for(const b of buildings){ const s=shift(b.x,b.y); if(!s){continue;} const[dx,dy]=delta[s[2]];
    b.x+=dx; b.y+=dy; if(b.door){ b.door.x+=dx; b.door.y+=dy; } }
  // Four PLAN boxes overlap in OLD-world space (Hearthvale/Homestead, Homestead/Dusthaven,
  // Ironhold/Thornwood, Saltmere/Thornwood). townAt() resolves overlapping tiles to whichever
  // town is declared FIRST — so the tile-copy loop above legitimately stamps a building's
  // walls at its OWN town's position even when that building's RECORD gets reassigned to a
  // neighbor by shift(). Only one casualty falls inside a building footprint: Dusthaven's
  // Caravan Bazaar (49,32) sits inside the Homestead/Dusthaven overlap, so its record follows
  // Homestead (where it's later repurposed as the postgame merchant) while its walls and door
  // are still correctly standing in Dusthaven. Give Dusthaven an explicit record pointing at
  // that already-well-formed structure — a new id, so the Homestead relocation tables (which
  // key off 'dh_shop') don't also grab this one. Same interior, so this restores the original
  // shop rather than inventing new content.
  { const dD = delta['Dusthaven'];
    buildings.push({ id:'dh_bazaar', name:'Caravan Bazaar', style:'shop',
      x:49+dD[0], y:32+dD[1], w:5, h:4,
      door:{x:51+dD[0], y:36+dD[1]}, interior:'dh_shop' }); }
  for(const d of decorations){ const s=shift(d.x,d.y); if(s){ const[dx,dy]=delta[s[2]]; d.x+=dx; d.y+=dy; } }
  for(const v of villagers){ const tx=Math.floor((v.x+TILE/2)/TILE), ty=Math.floor((v.y+TILE/2)/TILE);
    const s=shift(tx,ty); if(s){ const[dx,dy]=delta[s[2]]; v.x+=dx*TILE; v.y+=dy*TILE; v.hx+=dx; v.hy+=dy; v.tx+=dx; v.ty+=dy; } }
  const newSigns={};
  for(const k in signs){ const[sx,sy]=k.split(',').map(Number); const s=shift(sx,sy);
    if(s){ const[dx,dy]=delta[s[2]]; newSigns[(sx+dx)+','+(sy+dy)]=signs[k]; } }
  for(const k in signs) delete signs[k]; Object.assign(signs, newSigns);

  // ---- commit new world ----
  WORLD=G; WORLD_W=NW; WORLD_H=NH;

  // ---- helpers on the NEW grid ----
  function rectN(x0,y0,x1,y1,v){ for(let y=y0;y<=y1;y++)for(let x=x0;x<=x1;x++)if(G[y]&&G[y][x]!==undefined)G[y][x]=v; }
  // gate finder: scan a town's new box edges for gate tiles (8)
  function gates(t){ const[x0,y0,x1,y1,nx,ny]=PLAN[t]; const w=x1-x0,h=y1-y0; const bx0=nx,by0=ny,bx1=nx+w,by1=ny+h; const out=[];
    for(let x=bx0;x<=bx1;x++){ if(G[by0]&&G[by0][x]===8)out.push([x,by0,'N']); if(G[by1]&&G[by1][x]===8)out.push([x,by1,'S']); }
    for(let y=by0;y<=by1;y++){ if(G[y]&&G[y][bx0]===8)out.push([bx0,y,'W']); if(G[y]&&G[y][bx1]===8)out.push([bx1,y,'E']); }
    return {box:[bx0,by0,bx1,by1], out}; }
  // carve an L-shaped dirt road (tile 2) between two points, horizontal then vertical, 2 wide
  function road(ax,ay,bx,by){
    const x0=Math.min(ax,bx),x1=Math.max(ax,bx); for(let x=x0;x<=x1;x++){ if(G[ay])G[ay][x]=2; if(G[ay+1])G[ay+1][x]=2; }
    const y0=Math.min(ay,by),y1=Math.max(ay,by); for(let y=y0;y<=y1;y++){ if(G[y])G[y][bx]=2; if(G[y])G[y][bx+1]=2; }
  }
  // pick a usable gate (or a default edge midpoint) for a town on a given side preference
  function gateOf(t, prefer){ const g=gates(t); let pick=g.out.find(o=>o[2]===prefer)||g.out[0];
    if(!pick){ // no gate found; use box edge midpoint on prefer side
      const[bx0,by0,bx1,by1]=g.box; const mx=(bx0+bx1)>>1, my=(by0+by1)>>1;
      pick = prefer==='N'?[mx,by0,'N']:prefer==='S'?[mx,by1,'S']:prefer==='W'?[bx0,my,'W']:[bx1,my,'E']; }
    return pick; }

  // ---- trace the ordered path (clean H/V roads between consecutive towns) ----
  // each pair: [from, fromSide, to, toSide]
  const links=[
    ['Hearthvale','S','Ironhold','S'],
    ['Ironhold','S','Saltmere','N'],
    ['Saltmere','E','Thornwood','S'],
    ['Thornwood','N','Dusthaven','S'],
    ['Dusthaven','E','Crystalpeak','S'],
    ['Crystalpeak','S','Ashfield','N'],
    ['Ashfield','E','Stormgate','N'],
    ['Stormgate','E','Shadowmere','S'],
    ['Shadowmere','N','Hellgate','S'],
  ];
  for(const [fa,sa,fb,sb] of links){ if(fa==='Dusthaven'&&fb==='Crystalpeak') continue; if(fa==='Hearthvale'&&fb==='Ironhold') continue; if(fa==='Ironhold'&&fb==='Saltmere') continue; const ga=gateOf(fa,sa), gb=gateOf(fb,sb); road(ga[0],ga[1],gb[0],gb[1]); }

  // Hearthvale → Ironhold: the rear (north) gate is sealed, so the road wraps around the
  // EAST wall down to Ironhold's single SOUTH entrance (the front, shared with Saltmere).
  function routeHearthvaleAroundIronhold(){
    // ── MAIN HIGHWAY (3-wide): Hearthvale's south gate wraps the WEST flank of the
    //    Ironhold fortress down to its single front (south) gate. Clean, connected,
    //    collision-checked: descends the open corridor at cols 11-13 (clear of the
    //    fortress wall which begins at col 14), then east into the gate. ──
    const W=3;                                   // main-highway width
    function paintH(x0,x1,y){ for(let x=Math.min(x0,x1);x<=Math.max(x0,x1);x++) for(let w=0;w<W;w++){ if(G[y+w]&&G[y+w][x]!==undefined && G[y+w][x]!==5) G[y+w][x]=2; } }
    function paintV(y0,y1,x){ for(let y=Math.min(y0,y1);y<=Math.max(y0,y1);y++) for(let w=0;w<W;w++){ if(G[y]&&G[y][x+w]!==undefined && G[y][x+w]!==5) G[y][x+w]=2; } }
    paintV(33,35, 32);          // 1) drop out of Hearthvale's south gate (existing stub at cols 33-34)
    paintH(11,34, 33);          // 2) bend WEST along the clear rows to the west corridor
    paintV(34,77, 11);          // 3) straight DOWN the open west flank (cols 11-13, outside the wall)
    paintH(11,31, 77);          // 4) east along the southern approach toward the gate
    paintV(74,79, 29);          // 5) rise into Ironhold's south gate (cols 29-31)
  }
  routeHearthvaleAroundIronhold();

  // Dusthaven → Crystalpeak: the connecting road is now built as a SOUTH branch in a
  // post-remap pass (dusthavenCrystalpeakSouth) on the final WORLD grid. The old
  // east-side route is intentionally not built here.
  function routeDusthavenSouth(){ /* east route removed — see dusthavenCrystalpeakSouth() */ }
  routeDusthavenSouth();
  rectN(0, NH-12, NW-1, NH-1, 3);        // deep sea band
  rectN(0, NH-14, NW-1, NH-13, 19);      // sand strip (tile 19)

  // ════════════════════════════════════════════════════════════════
  //  BIOME APPROACHES — paint the land AROUND each themed town so the
  //  journey transitions into its environment. Only paints over grass(0)
  //  so roads, walls, and buildings are never disturbed.
  // ════════════════════════════════════════════════════════════════
  function paintBlob(cx,cy,rx,ry,tile,jitter){ // soft elliptical patch, grass-only, reliable fill
    for(let y=cy-ry;y<=cy+ry;y++)for(let x=cx-rx;x<=cx+rx;x++){
      if(!G[y]||G[y][x]===undefined||G[y][x]!==0) continue;
      const nx=(x-cx)/rx, ny=(y-cy)/ry; const d=nx*nx+ny*ny;
      const edge = ((((x*7+y*13)%10)/10)-0.5)*(jitter||0.3);   // ragged border
      if(d + edge <= 1.0) G[y][x]=tile;
    }
  }
  function scatter(cx,cy,rx,ry,tile,chance){ for(let y=cy-ry;y<=cy+ry;y++)for(let x=cx-rx;x<=cx+rx;x++){
    if(G[y]&&G[y][x]===0 && ((x*31+y*17)%100)/100 < chance) G[y][x]=tile; } }

  // town centers (new grid) for painting
  const C={}; for(const t in PLAN){ const[,,,,nx,ny]=PLAN[t]; const w=PLAN[t][2]-PLAN[t][0], h=PLAN[t][3]-PLAN[t][1]; C[t]=[nx+(w>>1), ny+(h>>1), w, h]; }

  // DUSTHAVEN — desert sand bleeding out into the surrounding meadow
  paintBlob(C.Dusthaven[0], C.Dusthaven[1], 26, 22, 19, 0.4);
  scatter(C.Dusthaven[0], C.Dusthaven[1], 24, 20, 1, 0.04);   // occasional cacti (rendered as cactus in desert region)

  // ASHFIELD — scorched ash spreading around the volcano town
  paintBlob(C.Ashfield[0], C.Ashfield[1], 30, 24, 25, 0.4);
  scatter(C.Ashfield[0], C.Ashfield[1], 28, 22, 27, 0.10);    // cracked-earth flecks
  scatter(C.Ashfield[0], C.Ashfield[1]-6, 20, 8, 1, 0.03);    // a few charred snags up top

  // SHADOWMERE — boggy mist creeping around the haunted town
  paintBlob(C.Shadowmere[0], C.Shadowmere[1], 24, 22, 28, 0.4);
  scatter(C.Shadowmere[0], C.Shadowmere[1], 22, 20, 30, 0.10);// mist patches
  scatter(C.Shadowmere[0], C.Shadowmere[1], 22, 20, 1, 0.03); // dead trees

  // HELLGATE — a ring of ash & lava around the corner citadel
  paintBlob(C.Hellgate[0], C.Hellgate[1], 22, 18, 25, 0.4);
  scatter(C.Hellgate[0], C.Hellgate[1], 20, 16, 27, 0.12);
  scatter(C.Hellgate[0], C.Hellgate[1], 20, 16, 26, 0.03);    // rare lava flecks (wall)

  // THORNWOOD — forest grass + trees thickening around the woods town
  paintBlob(C.Thornwood[0], C.Thornwood[1], 24, 22, 7, 0.4);
  scatter(C.Thornwood[0], C.Thornwood[1], 22, 20, 1, 0.06);   // scattered trees

  // ════════════════════════════════════════════════════════════════
  //  CRYSTALPEAK — a TIERED MOUNTAIN ASCENT on the western approach.
  //  Stacked snow-capped rock ledges climb toward the monastery, with a
  //  switchback trail zig-zagging up between them. Snow deepens with height.
  // ════════════════════════════════════════════════════════════════
  //  CRYSTALPEAK — a LAYERED MOUNTAIN of concentric tiers (à la the
  //  classic layered mountain map). From the base you climb ring by ring
  //  via stone stairs to the peak village + hot spring at the summit.
  //  Tiers (outer→inner): 0 base/outer slope (trees) · 1 outer ring ·
  //  2 middle ring (ledges) · 3 upper ring (narrow) · 4 PEAK village.
  // ════════════════════════════════════════════════════════════════
  {
    const cx=C.Crystalpeak[0], cy=C.Crystalpeak[1];   // village center (~153,68)
    // mountain radii per tier (elliptical; slightly wider than tall for the iso look)
    // index 0 = outermost edge of the mountain, last = peak plateau
    const RINGS=[                 // [rx, ry] outer boundary of each walkable tier
      [23,18],                    // tier 0  base/outer slope
      [19,15],                    // tier 1  outer ring (trees)
      [15,12],                    // tier 2  middle ring (ledges)
      [11,9],                     // tier 3  upper ring (narrow)
      [9,8],                      // tier 4  PEAK plateau (village + hot spring) — roomy
    ];
    function inEllipse(x,y,rx,ry){ const nx=(x-cx)/rx, ny=(y-cy)/ry; return nx*nx+ny*ny<=1; }
    function ringTile(x,y){ // which tier index a tile belongs to (0..n), -1 outside
      for(let i=0;i<RINGS.length;i++){ if(inEllipse(x,y,RINGS[i][0],RINGS[i][1])) {
        if(i===RINGS.length-1 || !inEllipse(x,y,RINGS[i+1][0],RINGS[i+1][1])) return i;
      } }
      return inEllipse(x,y,RINGS[RINGS.length-1][0],RINGS[RINGS.length-1][1])?RINGS.length-1:-1;
    }
    // 1) lay each tier's SURFACE: lush grass on the lower slopes, transitioning to
    //    snow at the top (matching the reference: green terraces, snowy peak).
    const R0=RINGS[0];
    for(let y=cy-R0[1]-1;y<=cy+R0[1]+1;y++)for(let x=cx-R0[0]-1;x<=cx+R0[0]+1;x++){
      if(!G[y]||G[y][x]===undefined) continue;
      const t=ringTile(x,y); if(t<0) continue;
      if(G[y][x]===5||G[y][x]===9) continue;
      // tier 0-1 grass, tier 2 grass with a little snow dusting, tier 3-4 snow
      if(t<=1) G[y][x]=0;                       // green grass slopes
      else if(t===2) G[y][x]=((x*7+y*5)%6===0)?22:0;  // patchy snow on the middle ring
      else G[y][x]=22;                          // snow up high
    }
    // 2) CLIFFS — a crisp 2-tile drop at each tier boundary: the OUTER edge of the
    //    drop is a grass/snow-capped lip (tile 32), the row below is the rock face (33).
    //    A tile is a "rim" if it's in tier t and the neighbor just OUTWARD is tier t-1.
    const rimTop=[], rockFace=[];
    for(let y=cy-R0[1]-1;y<=cy+R0[1]+1;y++)for(let x=cx-R0[0]-1;x<=cx+R0[0]+1;x++){
      if(!G[y]||G[y][x]===undefined) continue;
      const t=ringTile(x,y); if(t<0) continue;
      if(G[y][x]===5||G[y][x]===9) continue;
      // is this the inner-upper edge (a higher tile sits just inside/above)?
      let higherInside=false, lowerOutside=false;
      for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nt=ringTile(x+dx,y+dy); if(nt>t) higherInside=true; if(nt<t&&nt>=0) lowerOutside=true; }
      if(higherInside) rimTop.push([x,y,t]);     // top lip of a cliff (just below a higher tier)
    }
    // the rock face: the lip tile becomes capped stone; the tile just outward becomes rock
    for(const [x,y,t] of rimTop){
      if(G[y]&&G[y][x]!==5&&G[y][x]!==9) G[y][x]=32;     // snow/grass-capped cliff lip
    }
    // give each cliff lip a rock face on its downhill side (toward lower tier)
    for(const [x,y,t] of rimTop){
      for(const [dx,dy] of [[0,1],[0,-1],[1,0],[-1,0]]){ const nt=ringTile(x+dx,y+dy);
        if(nt>=0 && nt<t){ const fx=x+dx, fy=y+dy; if(G[fy]&&G[fy][fx]!==undefined && G[fy][fx]!==5 && G[fy][fx]!==9) G[fy][fx]=33; }
      }
    }
    // 3) STAIRS connecting tiers — alternate sides so you wind up the mountain.
    //    For each boundary between tier i and i+1, punch a 1-wide stair gap.
    const stairAngles=[Math.PI/2, -Math.PI/2*0.0, Math.PI, 0, Math.PI/2]; // S, S, W, E, S-ish
    function punchStair(i, ang){
      // walk from just inside ring i+1 outward to ring i along angle, laying stairs(10)
      const rOut=RINGS[i], rIn=RINGS[i+1];
      for(let r=0.6; r<=1.25; r+=0.06){
        const x=Math.round(cx + Math.cos(ang)*rIn[0]*r);
        const y=Math.round(cy + Math.sin(ang)*rIn[1]*r);
        if(G[y]&&G[y][x]!==undefined && G[y][x]!==5 && G[y][x]!==9) G[y][x]=10;   // stairs up
        // widen by one for a 2-tile stair
        const x2=x+(Math.abs(Math.cos(ang))>0.5?0:1), y2=y+(Math.abs(Math.cos(ang))>0.5?1:0);
        if(G[y2]&&G[y2][x2]!==undefined && G[y2][x2]!==5 && G[y2][x2]!==9 && G[y2][x2]===33) G[y2][x2]=10;
      }
    }
    // stair side per tier-gap: ALL on the SOUTH face, so the climb is one clean
    // straight switchback up the front of the mountain (simpler than zig-zagging sides).
    const sides=[Math.PI/2, Math.PI/2, Math.PI/2, Math.PI/2];   // S, S, S, S
    for(let i=0;i<RINGS.length-1;i++) punchStair(i, sides[i]);
    // 4) tier dressing: pines on the green lower slopes, ice flecks on the snowy top
    for(let y=cy-R0[1];y<=cy+R0[1];y++)for(let x=cx-R0[0];x<=cx+R0[0];x++){
      if(!G[y]) continue; const t=ringTile(x,y); const v=G[y][x];
      if(v!==0 && v!==22) continue;                          // only dress open surface
      if(t===0 && v===0 && ((x*13+y*7)%7===0)) G[y][x]=1;     // pines on base slope
      else if(t===1 && v===0 && ((x*11+y*5)%11===0)) G[y][x]=1; // sparse pines outer ring
      else if(t===2 && v===0 && ((x*5+y*9)%13===0)) G[y][x]=4;  // wildflowers on middle ring
      else if(t>=3 && v===22 && ((x*7+y*11)%12===0)) G[y][x]=23; // ice flecks near the top
    }
    // 5) BASE ENTRANCE: connect the south road up to the mountain foot — the ONE way in.
    for(let y=82;y>=cy+R0[1]-1;y--){ if(G[y]&&G[y][cx]!==undefined && G[y][cx]!==5){ G[y][cx]=2; if(G[y][cx+1]!==undefined&&G[y][cx+1]!==5)G[y][cx+1]=2; } }
    // 6) HOT SPRING crowns the peak (placed after, in the dedicated spring block)
    // 7) PEAK VILLAGE: clear the whole summit area to clean snow (wiping any old
    //    building footprints + stray cliffs), then arrange the 5 buildings tidily.
    const peakR=RINGS[RINGS.length-1];
    const clearR=[peakR[0]+2, peakR[1]+2];   // clear a bit beyond the plateau
    for(let y=cy-clearR[1];y<=cy+clearR[1];y++)for(let x=cx-clearR[0];x<=cx+clearR[0];x++){
      if(G[y]&&G[y][x]!==undefined && inEllipse(x,y,clearR[0],clearR[1])) G[y][x]=22;  // wipe to snow
    }
    const peakBuildings=[
      ['cp_chapel', cx-2, cy-6, 4,3],   // cathedral, north of spring
      ['cp_shop',   cx-8, cy-1, 3,3],   // far west
      ['cp_inn',    cx+5, cy-1, 3,3],   // far east
      ['cp_home1',  cx-8, cy+4, 3,2],   // SW
      ['cp_home2',  cx+5, cy+4, 3,2],   // SE
    ];
    for(const [id,bx,by,bw,bh] of peakBuildings){
      const b=buildings.find(z=>z.id===id); if(!b) continue;
      b.x=bx; b.y=by; b.w=bw; b.h=bh;
      for(let yy=by;yy<=by+bh-1;yy++)for(let xx=bx;xx<=bx+bw-1;xx++){ if(G[yy]&&G[yy][xx]!==undefined) G[yy][xx]=5; }
      const dx=bx+(bw>>1), dy=by+bh-1;
      b.door={x:dx,y:dy};
      if(G[dy]&&G[dy][dx]!==undefined) G[dy][dx]=9;
      if(G[dy+1]&&G[dy+1][dx]!==undefined && G[dy+1][dx]!==5) G[dy+1][dx]=22;
    }
    // move any Crystalpeak villagers onto safe plateau tiles (some old spots are now walls)
    const safeSpots=[[cx,cy+2],[cx-3,cy+1],[cx+3,cy+1],[cx-1,cy+3],[cx+1,cy+3]];
    let si=0;
    for(const v of villagers){ const vtx=Math.floor((v.x+8)/16), vty=Math.floor((v.y+8)/16);
      if(vtx>=cx-RINGS[0][0]&&vtx<=cx+RINGS[0][0]&&vty>=cy-RINGS[0][1]&&vty<=cy+RINGS[0][1]){
        const [sx,sy]=safeSpots[si%safeSpots.length]; si++;
        v.x=sx*TILE; v.y=sy*TILE; v.homeX=v.x; v.homeY=v.y;
      }
    }
  }

  // ════════════════════════════════════════════════════════════════
  //  SALTMERE — a TIERED descent from the town down to the beach.
  //  A low sea-cliff retaining wall separates the higher town from the
  //  lower sand, with stone stairways stepping down to the shore.
  // ════════════════════════════════════════════════════════════════
  {
    const sx0=PLAN.Saltmere[4];
    const sw=PLAN.Saltmere[2]-PLAN.Saltmere[0];
    const bx0=sx0-1, bx1=sx0+sw+1;
    // scan each column for the cobble(6)->sand(19) transition row; place a sea-cliff there
    let stairCols=[bx0+8, bx0+Math.floor((bx1-bx0)*0.6)];
    for(let x=bx0;x<=bx1;x++){
      for(let y=200;y<=214;y++){
        if(G[y]&&G[y][x]===6 && G[y+1]&&G[y+1][x]===19){
          // y is last town row, y+1 is first sand row -> drop a cliff edge on the sand side
          const isStair = stairCols.some(sc=>x>=sc&&x<=sc+1);
          if(!isStair){ G[y+1][x]=32; if(G[y+2]&&G[y+2][x]===19) G[y+2][x]=33; }   // lit ledge + rock face
          else { G[y+1][x]=2; G[y+2]&&(G[y+2][x]=2); }                              // stone stairs down
          break;
        }
      }
    }
  }

  // ════════════════════════════════════════════════════════════════
  //  IRONHOLD — a craggy MOUNTAIN FORTRESS. Bare rock and outcrops ring
  //  the stronghold, with tiered rock shelves stepping up the east & west
  //  flanks (north road approach and south exit kept clear).
  // ════════════════════════════════════════════════════════════════
  {
    const ix0=PLAN.Ironhold[4], iy0=PLAN.Ironhold[5];
    const iw=PLAN.Ironhold[2]-PLAN.Ironhold[0], ih=PLAN.Ironhold[3]-PLAN.Ironhold[1];
    const cx=ix0+(iw>>1), cy=iy0+(ih>>1);
    // CLEAN FORTRESS: instead of a ragged rock field, give Ironhold a tidy rocky apron
    // (a modest, even ring of mountain ground) — no scattered crags, no tiered rubble.
    // The crisp stone curtain wall + elevation are built later in buildElevation().
    paintBlob(cx, cy, (iw>>1)+5, (ih>>1)+4, 33, 0.18);   // a small, even rock apron around the walls
  }

  // ════════════════════════════════════════════════════════════════
  //  ASHFIELD — kept SIMPLE: a clean ash apron around the town. The gentle
  //  crater tier (town sits one step down) is handled in buildElevation().
  // ════════════════════════════════════════════════════════════════
  {
    const ax0=PLAN.Ashfield[4], ay0=PLAN.Ashfield[5];
    const aw=PLAN.Ashfield[2]-PLAN.Ashfield[0], ah=PLAN.Ashfield[3]-PLAN.Ashfield[1];
    const cx=ax0+(aw>>1), cy=ay0+(ah>>1);
    // one even ash field around the town — no rock rings, no scattered crags
    paintBlob(cx, cy, (aw>>1)+8, (ah>>1)+6, 25, 0.22);
  }

  // (Stormgate keeps its grand tiered walls right at the waterline — its
  //  coastal feature will be docks/navy later, not a beach descent.)

  // ════════════════════════════════════════════════════════════════
  //  THORNWOOD — a forested HILLSIDE: dense forest-grass and trees on
  //  low tiered rock shelves wrapping the woods town.
  // ════════════════════════════════════════════════════════════════
  {
    const tx0=PLAN.Thornwood[4], ty0=PLAN.Thornwood[5];
    const tw=PLAN.Thornwood[2]-PLAN.Thornwood[0], th=PLAN.Thornwood[3]-PLAN.Thornwood[1];
    const cx=tx0+(tw>>1), cy=ty0+(th>>1);
    paintBlob(cx, cy, (tw>>1)+12, (th>>1)+10, 7, 0.5);        // forest-grass apron
    scatter(cx, cy, (tw>>1)+11, (th>>1)+9, 1, 0.10);          // scattered trees (wall)
    // low rocky shelves on the west & east edges (a hillside feel)
    for(let side of [-1,1]){
      for(let tier=0;tier<2;tier++){
        const band = side<0 ? (tx0-3 - tier*4) : (tx0+tw+3 + tier*4);
        for(let y=ty0-1;y<=ty0+th+1;y++){ const x=band; if(G[y]&&(G[y][x]===7||G[y][x]===0||G[y][x]===1)){ G[y][x]=33; if(y%3===0)G[y][x]=32; } }
      }
    }
  }

  // ════════════════════════════════════════════════════════════════
  //  HOMESTEAD farm terrain — REMOVED. The Homestead was relocated & redesigned
  //  into an instanced-feel clearing in the Forest of Disillusionment's footprint
  //  (see the homesteadSanctuary IIFE below, which is the sole authority now).
  //  The old in-place vale terrain that used to live here painted fields/pond/
  //  stand at x99-118,y22-36 — all vacated. Preserved as _legacy for reference:
  // ════════════════════════════════════════════════════════════════
  /* _legacy old-vale homestead terrain (pre-redesign):
    for(let y=22;y<=36;y++)for(let x=99;x<=118;x++){ if(G[y]&&G[y][x]!==undefined){ const t=G[y][x]; if(t!==5&&t!==9&&t!==2) G[y][x]=0; } }
    for(let y=26;y<=29;y++)for(let x=101;x<=106;x++) if(G[y])G[y][x]=31;   // west field
    for(let y=26;y<=29;y++)for(let x=109;x<=114;x++) if(G[y])G[y][x]=31;   // east field
    ... fields, pond (110-115,y32-35), farm stand (102/104), SELL_SPOT '104,33' ...
    (full block removed; homesteadSanctuary now builds fields/pond/stand/FARM_PLOTS/SELL_SPOT) */

  // ════════════════════════════════════════════════════════════════
  //  MORE FISHING SPOTS — register water in other towns so fishing
  //  works realm-wide. Each spot also gets a small "cast a line" sign.
  // ════════════════════════════════════════════════════════════════
  {
    // SALTMERE — ocean fishing off the surf spot — zone 'sea'
    for(let y=215;y<=223;y++)for(let x=10;x<=56;x++){ if(G[y]&&(G[y][x]===21||G[y][x]===20)) FISH_SPOTS[x+','+y]='sea'; }
    if(G[218]&&G[218][20]!==undefined){ G[218][20]=16; signs['20,218']='THE SHORE\nFace the surf, press Ⓐ to fish\nthe open sea! (Sea Bass, Kingfish)'; }
    // DUSTHAVEN — the oasis pool — zone 'oasis' (clear spot in the NW of town)
    for(let y=60;y<=62;y++)for(let x=96;x<=98;x++){ if(G[y]&&G[y][x]!==undefined && (G[y][x]===0||G[y][x]===19||G[y][x]===25)){ G[y][x]=3; FISH_SPOTS[x+','+y]='oasis'; } }
    for(let x=95;x<=99;x++){ if(G[59]&&G[59][x]!==5)G[59][x]=19; if(G[63]&&G[63][x]!==5)G[63][x]=19; }
    const oas=decorations.find(d=>d.kind==='oasis'); if(oas){ oas.x=96; oas.y=60; }
    if(G[59]&&G[59][95]!==undefined && G[59][95]!==5){ G[59][95]=16; signs['95,59']='THE OASIS\nEven the desert hides fish.\nFace the water, press Ⓐ.'; }
    // THORNWOOD — a forest pond just SOUTH of the woods town, in the forest biome
    for(let y=170;y<=172;y++)for(let x=88;x<=91;x++){ if(G[y]&&G[y][x]!==undefined && (G[y][x]===0||G[y][x]===7)){ G[y][x]=3; FISH_SPOTS[x+','+y]='forest'; } }
    for(let x=87;x<=92;x++){ if(G[169]&&G[169][x]===0)G[169][x]=7; if(G[173]&&G[173][x]===0)G[173][x]=7; }
    for(let y=170;y<=172;y++){ if(G[y]){ if(G[y][87]===0)G[y][87]=7; if(G[y][92]===0)G[y][92]=7; } }
    if(G[169]&&G[169][87]!==undefined){ G[169][87]=16; signs['87,169']='FOREST POOL\nQuiet waters. Face it and\npress Ⓐ to cast.'; }
  }

  // re-lay the inter-town roads ON TOP so biome paint never severs a path
  for(const [fa,sa,fb,sb] of links){ if(fa==='Dusthaven'&&fb==='Crystalpeak') continue; if(fa==='Hearthvale'&&fb==='Ironhold') continue; if(fa==='Ironhold'&&fb==='Saltmere') continue; const ga=gateOf(fa,sa), gb=gateOf(fb,sb); road(ga[0],ga[1],gb[0],gb[1]); }
  routeDusthavenSouth();
  routeHearthvaleAroundIronhold();

  // ── IRONHOLD entrance fix: the keep sits behind the north gate, so route the
  //    entrance ALONG the north wall line to the open east lane, then down ──
  {
    // open a walkable lane along row 52 (the north wall) from the gate east to col 40
    for(let x=35;x<=40;x++){ if(G[52]) G[52][x]=6; }
    // east-side vertical corridor (cols 39-40) from the wall down into the open plaza
    for(let y=52;y<=58;y++){ if(G[y]){ G[y][39]=6; G[y][40]=6; } }
    // keep the actual gate tiles as gates
    if(G[52]){ G[52][35]=8; G[52][36]=8; }
  }

  // ── THORNWOOD entrance fix: the chapel sat squarely on the north road, so
  //    move the chapel one tile west and re-route the north path into the OPEN
  //    gap between the chapel and the inn (cols ~95-97), giving a clear approach ──
  {
    const ch = buildings.find(b=>b.id==='tw_chapel');
    if(ch){
      // clear the chapel's current footprint + door back to forest grass
      for(let y=ch.y-1;y<=ch.y+ch.h;y++)for(let x=ch.x-1;x<=ch.x+ch.w;x++){ if(G[y]&&G[y][x]!==undefined && (G[y][x]===5||G[y][x]===9)) G[y][x]=7; }
      // shift the chapel 2 tiles west so the north road clears its east wall
      ch.x -= 2; ch.door.x -= 2;
      // stamp the moved chapel footprint (walls) + door
      for(let y=ch.y;y<=ch.y+ch.h-1;y++)for(let x=ch.x;x<=ch.x+ch.w-1;x++){ if(G[y]) G[y][x]=5; }
      if(G[ch.door.y]) G[ch.door.y][ch.door.x]=9;
      // open ground in front of the door
      if(G[ch.door.y+1]&&G[ch.door.y+1][ch.door.x]!==undefined && G[ch.door.y+1][ch.door.x]!==5) G[ch.door.y+1][ch.door.x]=2;
    }
    // re-route the north entrance road: bring it down cols 95-96 into the plaza
    for(let y=146;y<=154;y++){ if(G[y]){ if(G[y][95]!==5)G[y][95]=2; if(G[y][96]!==5)G[y][96]=2; } }
    // connect the old north road stub (cols 92-93) across to the new lane at row 146-147
    for(let x=92;x<=96;x++){ if(G[146]&&G[146][x]!==5)G[146][x]=2; }
  }

  // ── CRYSTALPEAK hot spring: crown the mountain village with a steaming
  //    spring (tile 24 heals you), set in the open plaza between the buildings ──
  {
    // a rounded spring pool in the central clearing; overwrite any non-wall ground
    const ok=t=>t!==undefined && t!==5 && t!==9 && t!==1;   // not wall/door/tree
    const pool=[[153,69],[154,69],[155,69],[152,70],[153,70],[154,70],[155,70],[156,70],[153,71],[154,71],[155,71]];
    for(const [x,y] of pool){ if(G[y]&&ok(G[y][x])) G[y][x]=24; }
    // snowy rim around the pool for contrast
    for(const [x,y] of [[151,69],[152,69],[156,69],[151,70],[157,70],[152,71],[156,71],[153,72],[154,72],[155,72]]){ if(G[y]&&G[y][x]===25) G[y][x]=22; }
  }

  return null;
})();

// ════════════════════════════════════════════════════════════════
//  SECRET AREAS & EASTER EGGS — hidden treasures rewarding exploration.
//  Some are tucked in far corners; others are gated behind Fly/Swim steeds.
// ════════════════════════════════════════════════════════════════
const SECRETS = [];   // {x,y, gate:'none'|'swim'|'fly', reward:{...}, hint, found}
const secretsFound = {};   // id -> true (saved)
(function carveSecrets(){
  const G=WORLD;
  const set=(x,y,t)=>{ if(G[y]&&G[y][x]!==undefined) G[y][x]=t; };
  const blob=(cx,cy,r,t)=>{ for(let y=cy-r;y<=cy+r;y++)for(let x=cx-r;x<=cx+r;x++) if(Math.hypot(x-cx,y-cy)<=r+0.3) set(x,y,t); };

  // 1) SWIM SECRET — a tiny grass island ringed by sea in the southern waters.
  //    Build a water moat then a grass island at its center (only reachable swimming).
  blob(60,234,4,3); blob(60,234,2,0); set(60,234,4);   // flowers center
  SECRETS.push({ id:'isle', x:60, y:234, gate:'swim', hint:'a lonely island in the southern sea',
    reward:{ kind:'gear', id:'holyblade', text:'🏝️ On the hidden island rests the <b>Holy Avenger</b> — a blade of pure light!' } });

  // 2) FLY SECRET — a clearing ringed tight by forest in the eastern wilds (only reachable flying over the trees).
  blob(205,110,3,1); blob(205,110,1,0); set(205,110,4);
  SECRETS.push({ id:'grove', x:205, y:110, gate:'fly', hint:'a clearing walled by ancient trees',
    reward:{ kind:'gold', amount:500, text:'🌳 In the tree-walled grove, a forgotten chest holds <b>500 gold</b>!' } });

  // 3) SWIM SECRET — a second island, far southeast, holding the best armor.
  blob(195,236,4,3); blob(195,236,2,0); set(195,236,4);
  SECRETS.push({ id:'isle2', x:195, y:236, gate:'swim', hint:'a distant island off the southeast coast',
    reward:{ kind:'gear', id:'platemail', text:'🏝️ Buried on the far island: a suit of <b>Plate Armor</b>!' } });

  // 4) HIDDEN CORNER — far NW corner, reachable on foot but easy to miss (rewards roaming).
  set(4,4,4); set(5,4,4); set(4,5,4);
  SECRETS.push({ id:'nw', x:4, y:4, gate:'none', hint:'the forgotten northwest corner',
    reward:{ kind:'gold', amount:200, text:'🗺️ Tucked in the kingdom\'s lonely northwest corner — <b>200 gold</b> and a fine view.' } });

  // 5) EASTER EGG — a quiet spot honoring the maker (no reward, just a wink).
  set(7,120,4); set(8,120,4); set(7,121,4);
  SECRETS.push({ id:'egg', x:7, y:120, gate:'none', hint:'a curious patch of flowers by the western edge',
    reward:{ kind:'lore', text:'📖 A weathered stone reads: <i>"Built with love, tile by tile. — for the kingdom\'s last knight."</i><br><span style="font-size:6px">✦ You found a secret! ✦</span>' } });

  // 6) FLY SECRET — perched in the ashy highlands near Hellgate, a treasure for the bold.
  blob(232,28,2,33); blob(232,28,1,25); set(232,28,4);
  SECRETS.push({ id:'ash', x:232, y:28, gate:'fly', hint:'a rocky perch in the ashen north',
    reward:{ kind:'gear', id:'greatsword', text:'⛰️ On a rocky perch above the ash: the mighty <b>Greatsword</b>!' } });
})();



function inWorld(tx,ty){ return tx>=0&&ty>=0&&tx<WORLD_W&&ty<WORLD_H; }

// ════════════════════════════════════════════════════════════════
//  INTERIORS — each building's inside (own grid + floors).
//  Proven loop from the demo: door -> interior -> stairs/floors -> exit.
// ════════════════════════════════════════════════════════════════
function room(w,h, build){ const g=makeGrid(w,h,5); for(let y=1;y<=h-2;y++)for(let x=1;x<=w-2;x++)g[y][x]=12; build(g,w,h); return {w,h,g}; }
// gridRows: author an interior floor as a readable tile map (v1 furnishing pass).
// Legend: 5 wall · 9 door · 10/11 stairs · 12 plank floor · 13 rug · 40 table ·
// 41 chair · 42/43 bed head/foot · 44 bookshelf · 45 fireplace · 46 counter ·
// 47 cabinet · 48 barrel · 49 plant · 50 dresser · 51 window wall · 52 bottle shelf
// Codes 40+ are outside WALK, so all furniture is SOLID with no collision changes.
function gridRows(s){ const g=s.trim().split('\n').map(r=>r.trim().split(/\s+/).map(Number)); return {w:g[0].length,h:g.length,g}; }
