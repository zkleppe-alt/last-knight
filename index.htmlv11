  px(x+10,y+18,3,2,'#e8892a');
  px(x+6,y+19,3,1,'#f4e8d0');
  px(x+10,y+19,3,1,'#f4e8d0');
}

function drawWagon(x,y,driving,dir){
  // a wooden supply cart with a golden load; when driving, the Old Mule pulls it
  // in the facing direction and the knight rides the bench in plain view.
  const bodyC='#7a4f2a', bodyD='#5e3c1f', bodyL='#946232', ironC='#3a2a1a', wheelC='#4a3420', wheelR='#7a5836';
  // ground shadow
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,7,2.5,0,0,7); ctx.fill();
  // cart bed
  px(x+2,y+7,12,5,bodyC); px(x+2,y+7,12,1,bodyL); px(x+2,y+11,12,1,bodyD);
  px(x+2,y+7,1,5,bodyD); px(x+13,y+7,1,5,bodyD);
  for(let i=0;i<4;i++) px(x+3+i*3,y+8,1,3,bodyD);   // side slats
  // golden cargo (sacks) mounded in the bed
  px(x+3,y+4,6,4,'#e0b84a'); px(x+3,y+4,6,1,'#f2d074'); px(x+4,y+5,1,1,'#c99a2e'); px(x+7,y+6,1,1,'#c99a2e');
  // two spoked wheels (alternate the spoke each frame for a faint rolling cue)
  const spin=driving && (((Date.now()/90)|0)%2===0);
  for(const wx of [x+3,x+11]){ px(wx,y+11,4,4,wheelC); px(wx+1,y+11,1,4,wheelR); px(wx,y+12,4,1,wheelR); if(spin){ px(wx+1,y+12,2,1,ironC); } else { px(wx,y+13,4,1,ironC); } }
  px(x+4,y+12,8,1,ironC);   // axle
  if(driving){
    const [dx,dy]={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]}[dir||'down'];
    // hitch pole toward the mule
    px(x+TILE/2-1+dx*3, y+9+dy*3, 2, 3, '#5e3c1f');
    // the Old Mule out front (offset in facing dir)
    const mx=x+TILE/2-4+dx*8, my=y+5+dy*8;
    px(mx+2,my+3,7,4,'#8a8076'); px(mx+2,my+3,7,1,'#9a9088'); px(mx+2,my+6,2,2,'#6e655c'); px(mx+7,my+6,2,2,'#6e655c');
    px(mx+8,my+1,3,4,'#8a8076'); px(mx+9,my,1,2,'#9a9088'); px(mx+10,my+3,1,1,'#2a221c');
    // the KNIGHT driving — head + shoulders clearly above the load
    px(x+5,y+1,5,3,'#d8c49a'); px(x+5,y,5,1,'#8a6a3a');           // helm
    px(x+6,y+3,3,2,'#3a5a8a'); px(x+6,y+3,3,1,'#4a6a9a');          // shoulders/tabard
    px(x+7,y+2,1,1,'#2a221c');                                     // visor slit
    // reins from the driver to the mule
    px(x+TILE/2-1+dx*2, y+6+dy*2, 1, 2, '#4a3a2a');
  }
}
function drawDecor(d,x,y){
  switch(d.kind){
    case 'crossSword': {   // ✝ a great blade planted as a cross-shaped monument
      px(x,y,TILE,TILE,'#5fa860');
      px(x+2,y+3,2,2,'#6cbc6d'); px(x+11,y+12,2,2,'#54a258');
      ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,6,2,0,0,7); ctx.fill();
      // stone pedestal
      px(x+4,y+12,8,3,'#8a8478'); px(x+4,y+12,8,1,'#a6a094'); px(x+4,y+14,8,1,'#6a6458'); px(x+5,y+13,1,1,'#726c60');
      // the great blade, planted point-down (long vertical)
      px(x+7,y+2,2,11,'#dfe3ea'); px(x+7,y+2,1,11,'#ffffff'); px(x+8,y+3,1,9,'#aab0bc');   // blade + edge highlight + shadow
      px(x+7,y+12,2,1,'#9aa2b2');
      // golden crossguard (the arms of the cross)
      px(x+3,y+4,10,2,'#e8b93a'); px(x+3,y+4,10,1,'#ffd968'); px(x+3,y+5,10,1,'#b8902a');
      px(x+3,y+4,1,2,'#d8a828'); px(x+12,y+4,1,2,'#d8a828');
      // grip + pommel above the guard (top of the cross)
      px(x+7,y+1,2,3,'#7a4a24'); px(x+7,y+1,1,3,'#8f5a2c');
      px(x+7,y,2,1,'#e8b93a'); px(x+7,y-1,2,1,'#c9a94a');
      // faint holy glint
      px(x+8,y+7,1,1,'#ffffff');
      return; }
    case 'mule': {   // a stout grey mule
      px(x,y,TILE,TILE,'#5fa860');         // grass base (hides the solid-collision tile)
      px(x+2,y+3,2,2,'#6cbc6d'); px(x+11,y+11,2,2,'#54a258');  // a little grass texture
      ctx.fillStyle='rgba(0,0,0,.20)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,6,2,0,0,7); ctx.fill();
      px(x+3,y+7,10,5,'#8a8076');         // body
      px(x+3,y+11,2,3,'#6e655c'); px(x+11,y+11,2,3,'#6e655c');  // legs
      px(x+10,y+4,4,5,'#8a8076');         // head/neck
      px(x+12,y+3,2,2,'#6e655c'); px(x+10,y+2,2,3,'#9a9088'); px(x+13,y+2,1,3,'#9a9088'); // ears
      px(x+13,y+6,1,1,'#2a221c');         // eye
      px(x+2,y+7,1,5,'#6e655c');          // tail
      return; }
    case 'horse': {   // a grazing tourney horse — d.c = coat, d.m = mane (see corral)
      const C=d.c||'#7a5a3a', M=d.m||'#3a2a1a';
      px(x,y,TILE,TILE,'#5fa860');         // grass base (hides the solid-collision tile)
      px(x+2,y+3,2,2,'#6cbc6d'); px(x+11,y+12,2,2,'#54a258');  // grass texture
      ctx.fillStyle='rgba(0,0,0,.20)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,6,2,0,0,7); ctx.fill();
      px(x+2,y+6,10,5,C);                  // body
      px(x+2,y+5,7,1,C);                   // withers/back curve
      px(x+2,y+11,2,4,C); px(x+10,y+11,2,4,C);   // legs
      px(x+2,y+14,2,1,'#2a201a'); px(x+10,y+14,2,1,'#2a201a'); // hooves
      px(x+10,y+2,4,6,C);                  // neck + head raised
      px(x+9,y+1,2,6,M); px(x+11,y+1,2,2,M);     // mane + forelock
      px(x+13,y+4,1,1,'#1a140e');          // eye
      px(x+13,y+7,1,1,'#2a201a');          // muzzle
      px(x+1,y+6,1,6,M);                   // tail
      return; }
    case 'fountain': { const W=d.w*TILE; // stone basin + water + spout
      ctx.fillStyle='rgba(0,0,0,.18)'; ctx.beginPath(); ctx.ellipse(x+W/2+4,y+W-2,W/2,5,0,0,7); ctx.fill();
      px(x+2,y+6,W-4,W-8,'#8a8496'); px(x+2,y+6,W-4,2,'#a8a2b8');           // basin rim
      px(x+5,y+9,W-10,W-14,'#3f7ec0'); px(x+6,y+10,W-12,3,'#6aa6e0');        // water
      px(x+W/2-1,y,2,12,'#9a94a8'); px(x+W/2-3,y-2,6,3,'#b0aabe');           // spout
      px(x+W/2-1,y+2,2,8,'#bfe0ff'); break; }                                // water jet
    case 'planter': px(x+2,y+6,12,8,'#7a4f2a'); px(x+2,y+6,12,2,'#946232'); // wood box
      px(x+3,y+2,3,4,'#e85d8a'); px(x+7,y+1,3,5,'#f2c14e'); px(x+10,y+3,3,3,'#c45ad8'); break; // blooms
    case 'marketStall': { const W=d.w*TILE; px(x+1,y+8,W-2,7,'#8a6a3a'); // counter
      px(x,y+1,W,5,'#c0432f'); for(let i=0;i<W/4;i++) if(i%2) px(x+i*4,y+1,4,5,'#e8d0a0'); // striped awning
      px(x+1,y+1,2,9,'#6f5128'); px(x+W-3,y+1,2,9,'#6f5128');               // posts
      px(x+4,y+9,3,3,'#e85d8a'); px(x+9,y+9,3,2,'#f2c14e'); break; }          // goods
    case 'lantern': px(x+6,y+4,4,11,'#5b3a1f'); px(x+5,y+1,6,4,'#f2c14e'); px(x+6,y+2,4,2,'#fff0a0'); break; // post + glow
    case 'scarecrow': // pole + cross-arm, straw head, floppy hat
      ctx.fillStyle='rgba(0,0,0,.18)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,5,2,0,0,7); ctx.fill();
      px(x+7,y+4,2,11,'#5b3a1f'); px(x+2,y+6,12,2,'#6f4a26');            // pole + arms
      px(x+3,y+5,3,4,'#8a6a3a'); px(x+10,y+5,3,4,'#8a6a3a');             // sleeve stubs
      px(x+5,y+1,6,5,'#e8d878'); px(x+6,y+3,1,1,'#2a221c'); px(x+9,y+3,1,1,'#2a221c'); // straw head + eyes
      px(x+4,y,8,2,'#5b3a1f'); px(x+6,y-1,4,2,'#6f4a26'); break;         // hat brim + crown
    case 'angelStatue': // stone plinth, robed figure, wings, gilt halo
      ctx.fillStyle='rgba(0,0,0,.2)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,6,2,0,0,7); ctx.fill();
      px(x+3,y+12,10,3,'#8a8496'); px(x+3,y+12,10,1,'#a8a2b8');          // plinth
      px(x+6,y+5,4,7,'#b8b2c4'); px(x+6,y+11,4,1,'#9a94a8');             // robe
      px(x+2,y+4,4,5,'#e8e4f0'); px(x+10,y+4,4,5,'#e8e4f0');             // wings
      px(x+3,y+5,1,3,'#c8c4d4'); px(x+12,y+5,1,3,'#c8c4d4');             // wing shading
      px(x+7,y+2,2,3,'#c8c2d4'); px(x+6,y,4,1,'#f2c14e'); break;         // head + halo
    case 'sapling': // young apple tree: slim trunk, leafy crown, two apples
      ctx.fillStyle='rgba(0,0,0,.18)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,5,2,0,0,7); ctx.fill();
      px(x+7,y+9,2,6,'#7a4f2a');                                          // trunk
      px(x+4,y+2,8,8,'#4f9a54'); px(x+3,y+4,10,4,'#4f9a54');              // crown
      px(x+5,y+3,3,2,'#63b168'); px(x+9,y+5,2,2,'#63b168');               // leaf light
      px(x+5,y+6,1,1,'#d24545'); px(x+10,y+4,1,1,'#d24545'); break;       // apples
    case 'haycart': { const W=d.w*TILE; px(x+1,y+7,W-2,6,'#8a6a3a'); // cart bed
      px(x+2,y+3,W-6,5,'#d8c060'); px(x+4,y+2,W-10,3,'#e8d878');             // hay pile
      px(x+3,y+12,4,4,'#5b3a1f'); px(x+W-7,y+12,4,4,'#5b3a1f'); break; }      // wheels
    case 'barrel': px(x+4,y+5,8,10,'#7a4f2a'); px(x+4,y+5,8,2,'#946232'); px(x+4,y+9,8,1,'#5b3a1f'); px(x+4,y+12,8,1,'#5b3a1f'); break;
    // ── Ironhold (martial/forge) props ──
    case 'anvilMonument': { const W=d.w*TILE; // stone plinth + iron anvil centerpiece
      ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+W/2+4,y+W-2,W/2,6,0,0,7); ctx.fill();
      px(x+3,y+W-8,W-6,8,'#7a7484'); px(x+3,y+W-8,W-6,2,'#948ea0');         // stone plinth
      px(x+6,y+W-12,W-12,5,'#3a3a44'); px(x+4,y+W-9,W-8,3,'#2a2a32');        // anvil body
      px(x+W-9,y+W-15,7,4,'#46464f'); px(x+W-8,y+W-16,3,2,'#56565f');        // anvil horn
      px(x+8,y+W-18,2,6,'#2a2a32'); px(x+7,y+W-20,4,3,'#1a1a22'); break; }   // hammer leaning
    case 'brazier': px(x+6,y+8,4,7,'#3a3a44'); px(x+4,y+11,8,3,'#2a2a32'); // iron stand
      px(x+5,y+3,6,5,'#ff6a2a'); px(x+6,y+1,4,4,'#ffb02a'); px(x+7,y,2,3,'#ffe08a'); break; // flames
    case 'weaponRack': px(x+2,y+12,12,3,'#5b3a1f'); px(x+3,y+2,1,11,'#9a9aa8'); px(x+6,y+1,1,12,'#c0c0cc'); // sword
      px(x+9,y+2,2,11,'#8a6a3a'); px(x+10,y+1,1,4,'#b0b0bc'); px(x+12,y+3,1,10,'#9a9aa8'); break; // spear/axe
    case 'crate': px(x+3,y+5,10,10,'#8a6a3a'); px(x+3,y+5,10,2,'#a07f48'); px(x+3,y+5,2,10,'#a07f48'); px(x+3,y+9,10,1,'#6f5128'); px(x+8,y+5,1,10,'#6f5128'); break;
    case 'banner2': px(x+7,y,2,15,'#3a3a44'); px(x+3,y+1,8,8,'#3a4a8a'); px(x+3,y+1,8,1,'#5a6aaa'); px(x+6,y+3,2,4,'#c0c0cc'); break; // blue war banner w/ emblem
    // ── Saltmere (seaside) props ──
    case 'lighthouse': { const W=d.w*TILE; // tall striped tower + lamp
      ctx.fillStyle='rgba(0,0,0,.2)'; ctx.beginPath(); ctx.ellipse(x+W/2+3,y+W-2,W/2,5,0,0,7); ctx.fill();
      px(x+5,y+4,W-10,W-4,'#e8e4dc');                                   // white tower
      px(x+5,y+8,W-10,3,'#c0392b'); px(x+5,y+14,W-10,3,'#c0392b');      // red stripes
      px(x+5,y+4,2,W-4,'#cfcabf'); px(x+W-7,y+4,2,W-4,'#b8b3a8');       // shading
      px(x+4,y,W-8,5,'#3a3a44'); px(x+6,y-3,W-12,4,'#ffe08a'); px(x+7,y-2,W-14,2,'#fff6c8'); break; } // lamp room + glow
    case 'boat': { const W=d.w*TILE; // little wooden fishing boat
      px(x+1,y+6,W-2,6,'#8a5a32'); px(x+3,y+4,W-6,3,'#a06a3a');         // hull
      px(x+1,y+11,W-2,1,'#5a3a1f'); px(x+W/2-1,y-2,2,8,'#6f5128');      // mast
      px(x+W/2,y-2,5,5,'#e8e0d0'); break; }                             // sail
    case 'regatta': { // 🏁 checkered-flag race buoy bobbing on the water
      const bob=Math.round(Math.sin(performance.now()*0.003+x*0.1)*1.5);
      px(x+6,y+8+bob,4,6,'#c23b22'); px(x+6,y+8+bob,4,2,'#e0563a');     // red float
      ctx.fillStyle='rgba(207,238,238,0.5)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,5,2,0,0,7); ctx.fill(); // ripple
      px(x+7,y-4+bob,1,12,'#3a2e22');                                   // pole
      // checkered flag
      for(let r=0;r<3;r++)for(let c=0;c<3;c++){ const on=(r+c)%2===0; px(x+8+c*2,y-4+r*2+bob,2,2,on?'#f4eede':'#1a1320'); }
      break; }
    case 'fishBarrel': px(x+4,y+5,8,10,'#5a7a6a'); px(x+4,y+5,8,2,'#6a8a7a'); px(x+4,y+9,8,1,'#3a5a4a');
      px(x+6,y+3,2,3,'#b0c0c8'); px(x+8,y+2,2,3,'#c8d4d8'); break;       // barrel w/ fish poking out
    case 'netRack': px(x+2,y+2,1,12,'#6f5128'); px(x+13,y+2,1,12,'#6f5128'); px(x+2,y+2,12,1,'#6f5128'); // frame
      for(let i=3;i<13;i+=3){ px(x+i,y+3,1,9,'#c8c0a0'); } for(let j=4;j<12;j+=3){ px(x+2,y+j,12,1,'#c8c0a0'); } break; // net mesh
    // ── beach props ──
    case 'umbrella': px(x+7,y+6,2,9,'#8a6a3a'); // pole
      px(x+2,y+2,12,5,'#e0556a'); px(x+2,y+2,12,2,'#f07a8a'); for(let i=0;i<12;i+=4)px(x+2+i,y+2,2,5,'#f0e0d0'); break; // red/white canopy
    case 'sandcastle': px(x+3,y+8,10,6,'#d8be84'); px(x+3,y+6,3,8,'#e8ce94'); px(x+11,y+6,3,8,'#e8ce94'); px(x+7,y+5,3,9,'#e8ce94');
      px(x+4,y+4,1,3,'#c0a868'); px(x+12,y+4,1,3,'#c0a868'); break; // turreted sandcastle
    case 'palm': ctx.fillStyle='rgba(0,0,0,.18)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,5,2,0,0,7); ctx.fill();
      px(x+7,y+6,2,9,'#8a5a32'); px(x+7,y+7,1,8,'#6f4422'); // curved trunk
      px(x+2,y+3,6,3,'#3fa050'); px(x+9,y+3,6,3,'#3fa050'); px(x+4,y+1,8,3,'#52b863'); px(x+6,y,4,2,'#62c873'); // fronds
      px(x+7,y+5,3,2,'#8a6a2a'); break; // coconuts
    case 'tidepool': px(x+2,y+5,12,8,'#e8d6a0'); // sand ring
      px(x+4,y+7,8,5,'#4fa0c0'); px(x+5,y+8,6,3,'#7fc0d8'); px(x+6,y+9,2,1,'#bfe8f0');
      px(x+10,y+6,1,1,'#e0709a'); px(x+5,y+11,1,1,'#9a70e0'); break; // little pool + starfish/shell dots
    // ── Thornwood (forest) props ──
    case 'greatTree': { const W=d.w*TILE; // huge ancient tree centerpiece
      ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+W/2,y+W-2,W/2,7,0,0,7); ctx.fill();
      px(x+W/2-5,y+W-16,10,16,'#5b3a1f'); px(x+W/2-5,y+W-16,3,16,'#6f4a28'); px(x+W/2+2,y+W-16,3,16,'#4a2f18'); // massive trunk
      // big layered canopy
      ctx.fillStyle='#2f7d3a'; ctx.beginPath(); ctx.ellipse(x+W/2,y+W-26,W/2+2,W/2-2,0,0,7); ctx.fill();
      ctx.fillStyle='#3fa050'; ctx.beginPath(); ctx.ellipse(x+W/2-4,y+W-30,W/3,W/3,0,0,7); ctx.fill();
      ctx.fillStyle='#52b863'; ctx.beginPath(); ctx.ellipse(x+W/2+6,y+W-24,W/4,W/4,0,0,7); ctx.fill();
      px(x+W/2-2,y+W-10,3,2,'#2a1a0e'); break; } // hollow knot
    case 'logpile': px(x+2,y+7,12,3,'#7a4f2a'); px(x+2,y+10,12,3,'#6f4422'); // stacked logs (side)
      px(x+2,y+7,3,6,'#9a6a3a'); px(x+3,y+8,1,1,'#c8a060'); px(x+10,y+8,1,1,'#c8a060'); break; // log ends
    case 'campfire': px(x+3,y+11,10,3,'#5b3a1f'); px(x+5,y+11,2,3,'#6f4422'); px(x+9,y+10,2,4,'#6f4422'); // logs
      px(x+5,y+5,6,6,'#ff6a2a'); px(x+6,y+3,4,4,'#ffb02a'); px(x+7,y+2,2,3,'#ffe08a'); break; // flames
    case 'stump': px(x+3,y+8,10,6,'#6f4a28'); px(x+3,y+8,10,2,'#8a6038'); // stump side
      px(x+4,y+6,8,3,'#a07a48'); px(x+6,y+7,4,1,'#7a5530'); break; // top rings
    case 'mushroom': px(x+5,y+9,2,5,'#e8e0d0'); px(x+7,y+10,2,4,'#e8e0d0'); // stalks
      px(x+3,y+6,6,4,'#c0392b'); px(x+3,y+6,6,1,'#e0594b'); px(x+5,y+7,1,1,'#fff'); px(x+6,y+8,2,3,'#d04030'); break; // red caps
    // ── Dusthaven (desert/oasis) props ──
    case 'oasis': { const W=d.w*TILE; // pool of water ringed by sand + palms
      ctx.fillStyle='rgba(0,0,0,.15)'; ctx.beginPath(); ctx.ellipse(x+W/2,y+W-2,W/2,6,0,0,7); ctx.fill();
      px(x+2,y+4,W-4,W-8,'#d8c088');                                  // damp sand ring
      ctx.fillStyle='#2f8ec0'; ctx.beginPath(); ctx.ellipse(x+W/2,y+W/2,W/3,W/4,0,0,7); ctx.fill(); // water
      ctx.fillStyle='#5fb0d8'; ctx.beginPath(); ctx.ellipse(x+W/2-2,y+W/2-2,W/5,W/7,0,0,7); ctx.fill();
      // two palms flanking
      px(x+4,y+2,2,8,'#8a5a32'); px(x+1,y,5,3,'#3fa050'); px(x+3,y-1,5,3,'#52b863');
      px(x+W-6,y+3,2,8,'#8a5a32'); px(x+W-9,y+1,5,3,'#3fa050'); px(x+W-7,y,5,3,'#52b863'); break; }
    case 'tent': { const W=d.w*TILE; // striped sun-shade market tent
      px(x+2,y+8,W-4,6,'#c8a060'); px(x+1,y+3,W-2,6,'#d86a4a'); // canopy
      for(let i=0;i<W/4;i++) if(i%2) px(x+1+i*4,y+3,4,6,'#e8d8b0');
      px(x+2,y+8,2,7,'#8a6038'); px(x+W-4,y+8,2,7,'#8a6038'); break; } // poles
    case 'cactus': px(x+6,y+3,4,12,'#3f8a4e'); px(x+6,y+3,1,12,'#52a05e'); // trunk
      px(x+2,y+6,4,2,'#3f8a4e'); px(x+2,y+4,2,4,'#3f8a4e'); px(x+10,y+8,4,2,'#3f8a4e'); px(x+12,y+6,2,4,'#3f8a4e'); // arms
      px(x+7,y+5,1,1,'#e0d060'); px(x+8,y+9,1,1,'#e0d060'); break; // flower buds
    case 'waterjug': px(x+5,y+6,6,8,'#b5703a'); px(x+5,y+6,6,2,'#c8854a'); px(x+6,y+4,4,3,'#a05f2e'); px(x+7,y+3,2,2,'#8a4f24'); break; // clay jar
    case 'palmDesert': ctx.fillStyle='rgba(0,0,0,.18)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,4,2,0,0,7); ctx.fill();
      px(x+7,y+5,2,10,'#8a5a32'); px(x+7,y+6,1,9,'#6f4422'); // trunk
      px(x+2,y+2,6,3,'#3fa050'); px(x+9,y+2,6,3,'#3fa050'); px(x+4,y,8,3,'#52b863'); px(x+6,y+4,3,2,'#8a6a2a'); break;
    // ── Crystalpeak (frozen monastery) props ──
    case 'snowman': px(x+4,y+9,8,6,'#f4fafe'); px(x+5,y+4,6,6,'#f4fafe'); // body + head
      px(x+6,y+6,1,1,'#333'); px(x+9,y+6,1,1,'#333'); px(x+7,y+7,2,1,'#e0902a'); // face + carrot
      px(x+3,y+11,1,1,'#333'); px(x+11,y+11,1,1,'#333'); px(x+2,y+8,3,1,'#5b3a1f'); px(x+11,y+8,3,1,'#5b3a1f'); break; // buttons + stick arms
    case 'icePillar': px(x+5,y+2,6,13,'#bfe8f4'); px(x+5,y+2,2,13,'#dff4fa'); px(x+9,y+2,2,13,'#9fd0e0'); px(x+6,y+1,4,2,'#eaffff'); break; // glittering ice column
    case 'pineSnow': ctx.fillStyle='rgba(0,0,0,.18)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,4,2,0,0,7); ctx.fill();
      px(x+7,y+12,2,3,'#5b3a1f'); // trunk
      px(x+3,y+8,10,4,'#2f6a44'); px(x+4,y+5,8,4,'#357a4e'); px(x+5,y+2,6,4,'#3c8a56'); // green tiers
      px(x+4,y+8,10,1,'#f4fafe'); px(x+5,y+5,8,1,'#f4fafe'); px(x+6,y+2,6,1,'#f4fafe'); break; // snow caps
    case 'prayerFlag': px(x+1,y+2,1,12,'#8a8a96'); px(x+14,y+2,1,12,'#8a8a96'); px(x+1,y+3,13,1,'#cfc8d0'); // string
      px(x+2,y+3,3,3,'#d05a5a'); px(x+6,y+3,3,3,'#5ad0a0'); px(x+10,y+3,3,3,'#5a80d0'); break; // colored flags
    // ── Ashfield (volcanic ruins) props ──
    case 'lavaAltar': { const W=d.w*TILE; // dark stone altar with a glowing lava bowl
      ctx.fillStyle='rgba(0,0,0,.25)'; ctx.beginPath(); ctx.ellipse(x+W/2,y+W-2,W/2,5,0,0,7); ctx.fill();
      px(x+3,y+W-10,W-6,10,'#2e2620'); px(x+3,y+W-10,W-6,2,'#3e342c');      // altar base
      px(x+5,y+W-16,W-10,7,'#1e1812');                                       // bowl rim
      ctx.fillStyle='#ff6a1a'; ctx.beginPath(); ctx.ellipse(x+W/2,y+W-13,W/4,W/8,0,0,7); ctx.fill(); // lava pool
      ctx.fillStyle='#ffd060'; ctx.beginPath(); ctx.ellipse(x+W/2,y+W-13,W/7,W/14,0,0,7); ctx.fill();
      const gp=(Math.floor(Date.now()/240))%4; px(x+W/2-1,y+W-20-gp,2,3,'#ff9a3a'); break; } // ember rising
    case 'brokenPillar': px(x+5,y+6,6,9,'#7a7068'); px(x+5,y+6,6,2,'#8a8078'); px(x+5,y+10,6,1,'#5a5048'); // stump of pillar
      px(x+4,y+13,8,2,'#6a6058'); px(x+11,y+8,3,2,'#6a6058'); break; // toppled top piece beside it
    case 'emberPit': px(x+3,y+8,10,5,'#2a1a12'); px(x+4,y+9,8,3,'#6a2a12'); // charred pit
      px(x+5,y+9,2,2,'#ff6a1a'); px(x+9,y+10,2,2,'#ff8a2a'); px(x+7,y+8,1,1,'#ffd060'); break; // glowing embers
    case 'charredTree': ctx.fillStyle='rgba(0,0,0,.2)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,4,2,0,0,7); ctx.fill();
      px(x+7,y+4,2,11,'#2a2018'); px(x+4,y+6,3,1,'#1a1410'); px(x+9,y+8,4,1,'#1a1410'); px(x+5,y+9,2,1,'#1a1410'); break; // dead black snag
    // ── Shadowmere (haunted bog) props ──
    case 'deadTree': { const W=d.w*TILE; // big gnarled leafless tree centerpiece
      ctx.fillStyle='rgba(0,0,0,.28)'; ctx.beginPath(); ctx.ellipse(x+W/2,y+W-2,W/2,6,0,0,7); ctx.fill();
      px(x+W/2-3,y+W-18,6,18,'#2e2a28'); px(x+W/2-3,y+W-18,2,18,'#3a3634');                  // trunk
      px(x+W/2-10,y+W-22,9,2,'#2e2a28'); px(x+W/2+2,y+W-26,9,2,'#2e2a28');                    // boughs
      px(x+W/2-13,y+W-28,5,2,'#262220'); px(x+W/2+8,y+W-30,5,2,'#262220');                    // upper branches
      px(x+W/2-2,y+W-30,2,8,'#262220'); break; }                                              // top limb
    case 'tombstone': px(x+4,y+5,8,10,'#6a6e72'); px(x+4,y+5,8,2,'#7e8286'); px(x+4,y+4,8,2,'#5a5e62'); // rounded-top stone
      px(x+6,y+8,4,1,'#4a4e52'); px(x+6,y+10,4,1,'#4a4e52'); px(x+3,y+14,10,1,'#3a3e42'); break; // engraving lines
    case 'mistWisp': { const mp=(Math.floor(Date.now()/300))%4;
      px(x+2,y+6-mp,8,2,'#c0ccd055'); px(x+5,y+3-mp,6,2,'#c0ccd044'); px(x+3,y+9-mp,9,2,'#c0ccd033'); break; } // faint drifting wisp
    // ── Homestead (farm) props ──
    case 'farmStand': { const W=d.w*TILE; // a wooden market stand with a striped awning + produce
      px(x+1,y+8,W-2,7,'#8a6a3a'); px(x+1,y+8,W-2,2,'#a07f48');                 // counter
      px(x,y+1,W,5,'#3a8a4a'); for(let i=0;i<W/4;i++) if(i%2) px(x+i*4,y+1,4,5,'#e8d8b0'); // green-striped awning
      px(x+1,y+1,2,9,'#6f5128'); px(x+W-3,y+1,2,9,'#6f5128');                    // posts
      px(x+4,y+9,3,3,'#e0603a'); px(x+9,y+9,3,2,'#f2c14e'); px(x+13,y+9,3,2,'#7ac24a'); break; } // produce: tomato/squash/greens
    case 'scarecrow': px(x+7,y+3,2,11,'#8a6a3a'); px(x+3,y+6,10,2,'#9a7a48'); // cross frame
      px(x+5,y,6,5,'#d8b870'); px(x+6,y+1,1,1,'#3a2a1a'); px(x+9,y+1,1,1,'#3a2a1a'); px(x+6,y+3,4,1,'#3a2a1a'); // burlap head
      px(x+3,y+5,2,4,'#c8a860'); px(x+11,y+5,2,4,'#c8a860'); break; // straw arms
    case 'haystack': { const W=d.w*TILE; px(x+1,y+6,W-2,8,'#d8c060'); px(x+2,y+3,W-4,4,'#e8d878'); px(x+4,y+1,W-8,3,'#f0e088');
      px(x+3,y+9,2,1,'#b8a040'); px(x+W-6,y+10,2,1,'#b8a040'); break; } // rounded hay bale
    case 'bucket': px(x+5,y+7,6,7,'#7a6a5a'); px(x+5,y+7,6,2,'#8a7a6a'); px(x+5,y+6,6,1,'#5a4a3a'); px(x+6,y+9,4,3,'#4a82b8'); break; // wood bucket w/ water
    default: break;
  }
}

