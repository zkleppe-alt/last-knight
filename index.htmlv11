// ══ THE LIBRARY — every scripture the knight has actually stood and read is kept
//    here, in the order it was met. Nothing is listed that has not been earned. ══
const codex = { seen:[] };
// ══ The scriptures of worlds one and two are spoken inside their dialogue, not
//    stored as data. These tables name them so the library can hold them too;
//    they are synced (idempotently) whenever a fold is cleansed or a heart warmed. ══
const CHAPEL_VERSES = {
  fold:    { ref:'Luke 15:4',      text:'What man of you, having an hundred sheep, if he lose one, doth not leave the ninety and nine, and go after that which is lost, until he find it?' },
  brook:   { ref:'John 4:14',      text:'Whosoever drinketh of the water that I shall give him shall never thirst.' },
  meadowe: { ref:'Psalm 23:2',     text:'He maketh me to lie down in green pastures: he leadeth me beside the still waters.' },
  millford:{ ref:'Matthew 11:28',  text:'Come unto me, all ye that labour and are heavy laden, and I will give you rest.' },
  downs:   { ref:'Isaiah 40:11',   text:'He shall feed his flock like a shepherd: he shall gather the lambs with his arm, and carry them in his bosom.' },
};
const TABOR_VERSES = {
  beset:  { ref:'Psalm 34:6',      text:'This poor man cried, and the LORD heard him, and saved him out of all his troubles.' },
  buried: { ref:'Romans 15:13',    text:'Now the God of hope fill you with all joy and peace in believing, that ye may abound in hope.' },
  hearth: { ref:'Isaiah 42:3',     text:'A bruised reed shall he not break, and the smoking flax shall he not quench.' },
  ledge:  { ref:'Psalm 121:3',     text:'He will not suffer thy foot to be moved: he that keepeth thee will not slumber.' },
  eden:   { ref:'Isaiah 35:1',     text:'The wilderness and the solitary place shall be glad for them; and the desert shall rejoice, and blossom as the rose.' },
};
function codexSyncMistral(vid){
  const V=CHAPEL_VERSES[vid]; if(!V) return;
  const nm=(vid.charAt(0).toUpperCase()+vid.slice(1));
  codexAdd(nm+'\u2019s chapel, Mistral Isle', V.ref, V.text);
}
function codexSyncTabor(){
  ['beset','buried','hearth','ledge','eden'].forEach(k=>{
    if(!tabRescue(k).done) return;
    const V=TABOR_VERSES[k]; if(V) codexAdd('A hope beat, Mount Tabor', V.ref, V.text);
  });
  if(taborProgress.bossDown) codexAdd('Eden\u2019s spring, Mount Tabor', 'John 1:5', 'And the light shineth in darkness; and the darkness comprehended it not.');
}
function codexAdd(where, ref, text){
  if(!ref) return;
  if(codex.seen.some(e=>e.ref===ref)) return;
  codex.seen.push({ where:where||'', ref:ref, text:text||'' });
  if(typeof saveGame==='function') saveGame();
}
function codexPages(){
  if(!codex.seen.length) return [{speaker:'The Library', text:'Empty shelves, and a good lamp. Every scripture you stand and read on the road will be written up here, in the order you met it.'}];
  const per=3, pages=[];
  for(let i=0;i<codex.seen.length;i+=per){
    const chunk=codex.seen.slice(i,i+per);
    const body=chunk.map(e=>'\u2727 <b>'+e.ref+'</b> — '+(e.where?('<i>'+e.where+'</i><br>'):'')+'\u201c'+e.text+'\u201d').join('<br><br>');
    pages.push({ speaker:'The Library ('+(Math.floor(i/per)+1)+'/'+Math.ceil(codex.seen.length/per)+')', text:body });
  }
  return pages;
}
// ══ AFTER THE WEDDING — the princess is not a trophy in a keep somewhere; she is
//    at your family's table, and the house talks about it. ══
function ensureMadisonAtHome(){
  if(!sunfallProgress.homecoming) return;
  const it=(typeof INTERIORS!=='undefined') && INTERIORS.home_house;
  if(!it || !it.npcs || it.npcs.some(n=>n.madisonHome)) return;
  it.npcs.push({ floor:0, x:9, y:5, name:'Princess Madison', madisonHome:true, lines:[
    'Your mother has asked me four times whether the palace fed me properly. I have stopped saying yes; she does not believe it.',
    'I like it here. There is a window in your top room that faces east — I have watched the sun come up from it eleven mornings running, and it has not once failed.',
    'Sunfall is keeping its own watch now. The lamps are theirs again. The boy with the kite writes to me, if you can believe it.',
  ] });
  it.npcs.push({ floor:0, x:3, y:5, name:'Sir Aldric', aldricAfter:true, lines:[
    'A princess at my table and a knight for a child. I was a soldier, boy. I do not have words for days like this.',
    'You went out to three worlds and came back with the morning. Sit down. Eat something.',
  ] });
}
function liveryUnlocked(id){
  const L=LIVERIES[id]; if(!L) return false;
  if(L.flag==='homecoming') return !!sunfallProgress.homecoming;
  return trade.sold >= (L.req||0);
}
function liveryList(){ return Object.keys(LIVERIES); }
function currentLivery(){ const id=player.livery||'azure'; return liveryUnlocked(id)?id:'azure'; }
// ── ELDAN'S QUESTS (the Sage of the wood) ──
// each quest: 'unstarted' -> 'active' -> 'done'
const quests = { goldenFish:'unstarted', kindness:'unstarted' };
// ── TOBIAS TEACHES YOU ── A new knight used to wake on the road knowing nothing:
// no one had ever told him what Ⓑ did, where his pack was, or what the whole
// thing was FOR. He wakes at Tobias's hearth now. Three short lessons, each a
// conversation he taps through, and the door holds until the old man is done.
const tutorial = { step:0, done:false };
const TUTORIAL_STEPS = 3;
const TOBIAS_LESSONS = [
  ["You're awake. Good. Sit a moment — the road will keep.",
   "Your legs first. That <b>joystick</b> at the bottom left: lean it and you walk. Lean it hard and you walk quicker.",
   "And <b>Ⓐ</b> is your hand. It talks to folk, opens what's shut, and swings your blade at what won't be reasoned with. One button, three good manners."],
  ["Now the one that keeps you breathing. <b>Ⓑ</b>.",
   "Tap it and you <b>dash</b> — out of the way of a thing that's already committed. A demon that's begun its lunge cannot call it back. That's your moment.",
   "Hold it and you <b>guard</b>. Raise it as the blow lands and you'll turn it aside altogether. Late, and you'll only blunt it. Timing, boy. Not courage."],
  ["Last thing, and then I'll let you go.",
   "The <b>☰</b> at the top opens your pack — your gear, your skills, your companion, and every task you've taken on. When you're lost, look there first.",
   "And the charge itself. <b>Ten chapels</b> stand unclean across this kingdom. A demon holds each one, and in each a <b>general</b> lies bound, waiting on a knight who can answer for what he believes.",
   "That's the work. Go and do it — and come back and tell me how it went."]
];
// Afterwards he is just a man who is glad to see you.
const TOBIAS_AFTER = [
  ["Back already? Sit, then. The fire's still in.",
   "Ten chapels, mind. And keep that shield up."],
  ["You've the look of your mother about you today.",
   "Go on. The kingdom won't cleanse itself."]
];
// ── THE FIRST MORNING ── The old man is standing over the bed when you wake.
// He says his piece, then walks out and down the stairs, and you are free. He
// is a real NPC pushed onto the floor for the length of the scene, so he draws,
// blocks and can be spoken to like anyone else — then removed when he is gone.
const escort = { on:false, x:0, y:0, t:0, phase:'idle' };
function startTobiasScene(){
  const IN=INTERIORS.tobias; if(!IN) return;
  IN.npcs = (IN.npcs||[]).filter(n=>!n._escort);
  const f=IN.floors[1];
  let bx=1, by=1;
  for(let y=0;y<f.h;y++)for(let x=0;x<f.w;x++) if(f.g[y][x]===42){ bx=x; by=y; }
  // where the stairs are — he comes UP them and goes back down them
  escort.sx=7; escort.sy=1;
  for(let y=0;y<f.h;y++)for(let x=0;x<f.w;x++) if(f.g[y][x]===11){ escort.sx=x; escort.sy=y; }
  // At the bedside, on actual open floor — the cell straight off the foot of the
  // bed is the dresser, and a man standing inside a dresser is not the scene.
  const open=(x,y)=>f.g[y] && f.g[y][x]===12;
  let ex2=bx+1, ey2=by+1;
  const px2=Math.round(player.x/TILE), py2=Math.round(player.y/TILE);
  const tries=[[bx+1,by+1],[bx+1,by],[bx+1,by+2],[bx,by+2],[bx+2,by+1]];
  for(const [tx2,ty2] of tries){ if(open(tx2,ty2) && !(tx2===px2 && ty2===py2)){ ex2=tx2; ey2=ty2; break; } }
  // He is not standing over you when the light comes up — he COMES UP the stairs
  // while the night lifts, crosses to the bedside, and only then speaks.
  escort.bedX=ex2; escort.bedY=ey2;
  escort.x=escort.sx; escort.y=escort.sy;
  escort.t=0; escort.phase='enter'; escort.on=true;
  escort.dawn=1;                                   // night → morning over the first moments
  IN.npcs.push({ floor:1, x:escort.x, y:escort.y, name:'Tobias', _escort:true,
    lines:["Take your time. I\'ll be downstairs by the fire."] });
}
function escortStep(dt){
  if(!escort.on) return;
  if(escort.dawn>0) escort.dawn=Math.max(0, escort.dawn - dt/2600);   // the night lifts
  if(escort.phase!=='enter' && escort.phase!=='walk') return;
  const IN=INTERIORS.tobias; const n=(IN.npcs||[]).find(q=>q._escort); if(!n){ escort.on=false; return; }
  escort.t+=dt;
  if(escort.t<170) return;                       // one step every so often — he is old
  escort.t=0;
  const tx3 = escort.phase==='enter' ? escort.bedX : escort.sx;
  const ty3 = escort.phase==='enter' ? escort.bedY : escort.sy;
  if(n.x!==tx3) n.x += Math.sign(tx3-n.x);
  else if(n.y!==ty3) n.y += Math.sign(ty3-n.y);
  else if(escort.phase==='enter'){
    escort.phase='talk';
    if(typeof escort.onArrive==='function'){ const f2=escort.onArrive; escort.onArrive=null; f2(); }
  } else {
    IN.npcs=IN.npcs.filter(q=>!q._escort); escort.on=false; escort.phase='gone';
    sfxDoor(false); showBanner("\u{1F6AA} Tobias goes down to the fire. Follow when you\'re ready.", 2200);
  }
}
// ── NAMING THE COMPANION ── Tobias asks what you call it. Built the same way
// the intro takes your own name, so it looks and behaves like the rest of the
// game rather than a browser prompt.
const petName = { open:false };
function openPetName(){
  const pt=player.pet; if(!pt) return;
  const p=PETS[pt.id]; if(!p) return;
  petName.open=true;
  const gm=document.getElementById('gamemenu');
  gm.innerHTML = `<div class="gm-tabs"><div class="gm-tab sel">Name Your Companion</div></div>`
    + `<div class="gm-body" style="min-height:40vh">`
    + `<div style="text-align:center;font-size:30px;margin:14px 0 4px">${p.forms[0].emoji}</div>`
    + `<div style="font-size:8px;color:#cbb8e0;line-height:1.9;margin:6px 4px;text-align:center">`
    + `A ${p.forms[0].name}, and it has decided on you.<br>What will you call it?</div>`
    + `<input id="petNick" maxlength="14" placeholder="${p.forms[0].name}" value="${(pt.nick||'').replace(/"/g,'')}" `
    + `style="width:100%;background:#1a1330;border:1px solid #5a4a7a;color:#fff;font-family:inherit;font-size:11px;padding:8px;border-radius:4px;text-align:center;letter-spacing:1px">`
    + `<div class="gm-hint" style="margin-top:16px">Type a name · Ⓐ / Enter to keep it</div></div>`;
  gm.classList.add('open');
  const inp=document.getElementById('petNick'); if(inp) setTimeout(()=>inp.focus(),50);
}
function closePetName(){
  const pt=player.pet;
  const inp=document.getElementById('petNick');
  const v=inp?inp.value.trim():'';
  if(pt) pt.nick = v || PETS[pt.id].forms[0].name;
  petName.open=false;
  document.getElementById('gamemenu').classList.remove('open');
  saveGame();
  if(pt) sayAs('Tobias', [`<b>${pt.nick}</b>. Aye, that suits it.`,
    'Mind it, and it will mind you. They grow into something worth riding, given time and kindness.']);
}
// what to call the companion anywhere it is spoken of
function petLabel(){
  const pt=player.pet; if(!pt) return 'your companion';
  return pt.nick || (PETS[pt.id] && PETS[pt.id].forms[pt.form||0].name) || 'your companion';
}
function tobiasTalk(){
  // the first thing downstairs: the creature by the fire, and what you call it
  if(!tutorial.done && tutorial.step===0 && player.pet && !player.pet.nick){
    sayAs('Tobias', ['There it is — hasn\'t moved from that fire since the storm.',
      'It came in out of the wet and refused every attempt to put it back out. I think that settles whose it is.'],
      ()=> openPetName());
    return;
  }
  if(!tutorial.done){
    const i=Math.min(tutorial.step, TOBIAS_LESSONS.length-1);
    sayAs('Tobias', TOBIAS_LESSONS[i], ()=>{
      tutorial.step++;
      if(tutorial.step>=TUTORIAL_STEPS){ tutorial.done=true; saveGame();
        showBanner('🚪 The door is open. Hearthvale waits.', 1800); }
      else saveGame();
    });
    return;
  }
  sayAs('Tobias', TOBIAS_AFTER[(tutorial.step++)%TOBIAS_AFTER.length]);
}
