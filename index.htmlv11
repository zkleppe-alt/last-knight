  ]},
};
// ── PET skill tree (ported from legacy: Bond / Instinct / Devotion) ──
const PET_TREE = {
  bond: { name:'Bond', icon:'🐾', color:'#6fdf8a', nodes:[
    { id:'bond0', tier:0, name:'Closer Bond',     cost:1, desc:"+3 pet stat bonus",            bonus:{petBonus:3} },
