      px(x+10,y+9,1,3,'#3a7a42'); px(x+9,y+7,3,3,'#f2c14e'); px(x+10,y+8,1,1,'#fff0c0'); // gold bloom
      if(h1<6) px(x+11,y+3,2,2,'#e0e060');
      */
      break; }
    case 6: { // COBBLESTONE — offset stone courses with worn-stone variation
