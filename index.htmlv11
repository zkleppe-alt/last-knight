    // so which road is the long one has to be decided against the finished floor,
    // not the one we were part-way through building.
    { const d2={}; const q2=[[ex,ey]]; d2[ex+','+ey]=0;
      while(q2.length){ const [x,y]=q2.shift();
        for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nx=x+dx, ny=y+dy, k=nx+','+ny;
          if(nx<1||ny<3||nx>=MAZE_W-1||ny>=MAZE_H-1) continue;
          if(g[ny][nx]===1 || d2[k]!==undefined) continue;
          d2[k]=d2[x+','+y]+1; q2.push([nx,ny]); } }
      const de=d2[easyX+',3'], dh=d2[hardX+',3'];
