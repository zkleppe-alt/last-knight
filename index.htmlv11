      break; }
    case 20: { px(x,y,TILE,TILE,'#5fb0c8'); // SHALLOW surf (lighter, wadeable)
      px(x,y+((y+x)%4)*3,TILE,1,'#8fd0e0'); px(x+2,y+8,6,1,'#bfe8f0');
      // foam line where the surf laps against sand or grass
      const land20=(t2)=>t2!==undefined&&t2!==3&&t2!==20&&t2!==21&&t2!==29;
      if(land20(NG[ty-1]&&NG[ty-1][tx])){ px(x,y,TILE,2,'#dff4fa'); px(x,y+2,TILE,1,'#9fd8e8'); }
      if(land20(NG[ty+1]&&NG[ty+1][tx])){ px(x,y+TILE-2,TILE,2,'#dff4fa'); }
      if(land20(NG[ty]&&NG[ty][tx-1])){ px(x,y,2,TILE,'#cfeef6'); }
      if(land20(NG[ty]&&NG[ty][tx+1])){ px(x+TILE-2,y,2,TILE,'#cfeef6'); }
      break; }
    case 21: { px(x,y,TILE,TILE,'#3f8ec0'); // SURF SPOT (deeper swell, reserved minigame)
      px(x,y+4,TILE,2,'#6ab0e0'); px(x+1,y+10,TILE-2,2,'#bfe8f0'); px(x+4,y+1,6,1,'#9fd8ee'); break; }
    case 75: { // FROZEN POND — the basin beneath the falls, locked in ice
      px(x,y,TILE,TILE,'#a8d0e4');
      px(x,y,TILE,1,'#cfe8f4');
      px(x+1+h1%9,y+3+h2%8,5,1,'#8fbdd6');      // pressure cracks
      px(x+3+h3,y+9-h4,4,1,'#8fbdd6');
      if(h2<3) px(x+5+h1,y+5+h3,2,2,'#eaf7ff'); // a glint of trapped air
      break; }
    case 68: { // PIER — snow-dusted planks over dark water
      px(x,y,TILE,TILE,'#6b4f36');
      for(let i=0;i<TILE;i+=5){ px(x,y+i,TILE,3,'#8a6844'); px(x,y+i+3,TILE,1,'#4a3524'); }
      px(x,y,1,TILE,'#4a3524'); px(x+TILE-1,y,1,TILE,'#4a3524');
      if(h1<4) px(x+2+h2,y+3+h3,3,1,'#e8f2fa');      // wind-blown snow on the boards
      break; }
    case 69: { // HUT WALL — dark timber under snow
      px(x,y,TILE,TILE,'#5a4636'); px(x,y,TILE,2,'#6d5642');
      for(let i=3;i<TILE;i+=4) px(x,y+i,TILE,1,'#42322612');
      px(x,y,1,TILE,'#6d5642'); px(x+TILE-1,y,1,TILE,'#3c2c20');
      break; }
    case 70: { // HUT ROOF — ridge, shingle courses, and an icicled eave
      const roofUp=(NG[ty-1]&&NG[ty-1][tx]===70), roofDn=(NG[ty+1]&&NG[ty+1][tx]===70);
      px(x,y,TILE,TILE,'#7a3a32');
      for(let i=0;i<TILE;i+=4){ px(x,y+i,TILE,1,'#95463c'); px(x,y+i+2,TILE,1,'#5f2d27'); }  // shingle courses
      if(!roofUp){ px(x,y,TILE,5,'#f2f8fc'); px(x,y+5,TILE,1,'#d8e6f0'); px(x,y,TILE,1,'#ffffff'); }  // snow-capped ridge
      if(!roofDn){ px(x,y+TILE-3,TILE,3,'#4a221e');                       // eave shadow
        px(x+2,y+TILE-2,1,2,'#cfe4f0'); px(x+7,y+TILE-2,1,3,'#cfe4f0'); px(x+12,y+TILE-2,1,2,'#cfe4f0'); }  // icicles
      break; }
    case 71: { // LIT WINDOW — the one warm thing in a frozen town
      px(x,y,TILE,TILE,'#5a4636');
      px(x+3,y+3,TILE-6,TILE-7,'#3a2c22');
      px(x+4,y+4,TILE-8,TILE-9,'#ffc961'); px(x+4,y+4,TILE-8,2,'#ffe6a8');
      px(x+Math.floor(TILE/2)-1,y+3,1,TILE-7,'#3a2c22');       // the mullion
      break; }
    case 72: { // MARKET STALL — shuttered counter under a snow-laden awning
      px(x,y+2,TILE,2,'#eef6fb'); px(x,y+4,TILE,3,'#9a4a42'); px(x,y+6,TILE,1,'#6e332e');  // awning
      px(x+1,y+7,TILE-2,4,'#8a6844'); px(x+1,y+7,TILE-2,1,'#a87f4c');    // counter top
      px(x+2,y+8,TILE-4,2,'#54402c');                                     // shutter board
      px(x+1,y+11,2,5,'#4a3524'); px(x+TILE-3,y+11,2,5,'#4a3524');        // legs
      break; }
    case 73: { // ICE FLOE — a slab of ice adrift in the harbour
      px(x,y,TILE,TILE,'#2f6ea8');
      px(x+1,y+2,TILE-3,TILE-5,'#dbeef8'); px(x+2,y+3,TILE-5,3,'#ffffff');
      px(x+1,y+TILE-4,TILE-3,1,'#a8cbe0');
      break; }
    case 74: { // CRATES — cargo left where it was dropped
      px(x,y,TILE,TILE,'#19406e');
      px(x+1,y+4,9,10,'#8a6238'); px(x+1,y+4,9,1,'#a87f4c'); px(x+1,y+8,9,1,'#5e4227');
      px(x+5,y+4,1,10,'#5e4227');
      px(x+2,y+1,6,4,'#f2f8fc');                                // snow cap
      break; }
    case 77: { // HUT DOOR — a recessed timber door with a step. A home, plainly.
      px(x,y,TILE,TILE,'#5a4636'); px(x,y,TILE,2,'#6d5642');
      px(x+3,y+3,TILE-6,TILE-4,'#2e2118');                               // the recess
      px(x+4,y+4,TILE-8,TILE-5,'#7a5430');                               // the door itself
      for(let i=5;i<TILE-4;i+=3) px(x+i,y+4,1,TILE-5,'#5e4227');         // planks
      px(x+TILE-7,y+9,2,2,'#c9a44a');                                    // the latch
      px(x+2,y+TILE-2,TILE-4,2,'#8a94a4');                               // the step
      break; }
    case 61: { // TABOR ICE SHELF — hard blue-white plate, wind-scoured
      px(x,y,TILE,TILE,'#cfe6f2'); px(x,y,TILE,1,'#e8f5fb');
      px(x+1+h1%10,y+3+h2%9,4,1,'#b6d6e8'); px(x+2+h3,y+11-h4,3,1,'#b6d6e8');
      if(h2<3) px(x+6+h1,y+5+h3,1,1,'#ffffff');
      break; }
    case 62: { // FROZEN FALLS — a solid ribbon of ice, vertical flutes
      px(x,y,TILE,TILE,'#9fd0e8');
      for(let i=1;i<TILE;i+=4) px(x+i,y,1,TILE,'#bfe4f4');
      px(x+2,y,1,TILE,'#8ab8d4'); px(x+TILE-3,y,1,TILE,'#8ab8d4');
      if(h1<3) px(x+4+h2,y+3+h3,2,2,'#e8f8ff');
      break; }
    case 63: { // EDEN GROUND — frozen garden turf, faintly green beneath the rime
      px(x,y,TILE,TILE,'#a8cfc4'); px(x,y,TILE,1,'#c4e4da');
      px(x+2+h1%8,y+5+h2%7,2,2,'#93bfb2'); px(x+9-h3,y+3+h4,2,1,'#bcdcd0');
      if(h3<2) px(x+5+h1,y+9,1,1,'#e0f4ec');
      break; }
    case 64: { // SNOWDRIFT — a heaped bank that blocks the way until cleared
      px(x,y,TILE,TILE,'#eef6fb');
      px(x,y+4,TILE,TILE-4,'#dceaf4'); px(x+1,y+2,TILE-2,4,'#f6fbfe');
      px(x+3,y+7,4,2,'#cbdfec'); px(x+9,y+9,3,2,'#cbdfec');
      break; }
    case 65: { // FROZEN VILLAGER — a person locked in ice, waiting for the thaw
      px(x,y,TILE,TILE,'#cfe6f2');
      px(x+4,y+3,8,12,'#9cc4dc'); px(x+5,y+4,6,10,'#b8d8ea');
      px(x+6,y+5,4,4,'#cfe4f0');
      px(x+4,y+3,1,12,'#e8f6ff'); px(x+11,y+3,1,12,'#7fa8c4');
      break; }
    case 22: { // SNOW — bright with blue-shadow dapples and a rare sparkle
      px(x,y,TILE,TILE,'#f0f6fa');
      px(x+2+h1%9,y+4+h2%8,2,2,'#dde9f2'); px(x+9-h3,y+10-h4,2,2,'#dde9f2');
      px(x+5+h4,y+2+h3,2,1,'#e6eff6');
      if(h1<2) px(x+3+h2,y+6+h3,1,1,'#ffffff');
      break; }
    case 23: { // ICE — pale sheet with diagonal gleam + hairline crack
      px(x,y,TILE,TILE,'#bfe0ec'); px(x,y,TILE,1,'#dff1f8');
      px(x+2+h1%6,y+2,1,4,'#eaf8fc'); px(x+3+h1%6,y+5,1,3,'#eaf8fc');
      px(x+2,y+4+h2%6,7,1,'#a8d0e0'); px(x+6+h3,y+10,6,1,'#a8d0e0');
      break; }
    case 24: { px(x,y,TILE,TILE,'#7fcad8'); // HOT SPRING (heals) — warm water + steam wisps
      px(x+1,y+1,TILE-2,TILE-2,'#5fb8c8'); px(x+3,y+5,5,2,'#9fe0ea'); px(x+8,y+9,4,2,'#9fe0ea');
      const ph=(Math.floor(Date.now()/260)+x)%6; px(x+4,y-2+ph,2,2,'#ffffffcc'); px(x+9,y-1+((ph+3)%6),2,2,'#ffffffaa'); break; } // rising steam
    case 25: { // ASH — soft dapples with the rare glowing ember
      px(x,y,TILE,TILE,'#6a6258');
      px(x+2+h1%9,y+3+h2%8,2,2,'#766e63'); px(x+9-h3,y+10-h4,2,2,'#5c554c');
      px(x+5+h4,y+7+h3%4,1,1,'#837b6f');
      if(h1===0) px(x+4+h2%7,y+5+h3,1,1,'#c96a30');
      break; }
    case 26: { px(x,y,TILE,TILE,'#3a1a12'); px(x+2,y+3,5,3,'#ff6a1a'); px(x+8,y+8,5,3,'#ff8a2a'); // LAVA
      const lp=(Math.floor(Date.now()/200)+x*3)%4; px(x+4+lp,y+6,2,2,'#ffd060'); px(x+9,y+2+lp,1,1,'#ffe890'); break; }
    case 27: { // CRACKED EARTH — hash-varied crack lines
      px(x,y,TILE,TILE,'#5a4a42');
      px(x,y+6+((h1&1)?2:0),TILE,1,'#3a2a22'); px(x+6+((h2&1)?3:0),y,1,TILE,'#3a2a22');
      px(x+3,y+9+h3%3,4,1,'#48382f'); px(x+2+h4,y+3,1,1,'#6a584c');
      break; }
    case 28: px(x,y,TILE,TILE,'#3a4038'); px(x+3,y+5,3,2,'#454d42'); px(x+9,y+10,3,2,'#313630'); break; // BOG ground (murky green-grey)
    case 29: { px(x,y,TILE,TILE,'#1e2a2a'); px(x+2,y+4,6,2,'#33474a'); px(x+8,y+9,5,2,'#33474a'); px(x+4,y+8,2,1,'#4a6266'); break; } // SWAMP water (dark)
    case 30: { px(x,y,TILE,TILE,'#3a4038'); // MIST patch (hazy overlay on bog)
      const mp=(Math.floor(Date.now()/400)+x)%TILE; px(x,y+4,TILE,3,'#8a96964d'); px(x,y+9,TILE,2,'#8a969633'); px(x+mp%TILE,y+1,5,1,'#aab4b466'); break; }
    case 31: px(x,y,TILE,TILE,'#6b4a2e'); px(x,y+2,TILE,1,'#5a3e26'); px(x,y+6,TILE,1,'#5a3e26'); px(x,y+10,TILE,1,'#5a3e26'); px(x,y+14,TILE,1,'#5a3e26'); px(x+4,y+4,1,1,'#7c5836'); break; // TILLED soil (furrow rows)
    case 32: { // CLIFF LEDGE — warm chunky boulder; snow-dusted only in snowy areas
      const rk=(t2)=>t2===32||t2===33;
      const rN=NG[ty-1]&&rk(NG[ty-1][tx]), rS=NG[ty+1]&&rk(NG[ty+1][tx]);
      const snowNear=[[0,-1],[0,1],[-1,0],[1,0]].some(([dx,dy])=>{ const t2=NG[ty+dy]&&NG[ty+dy][tx+dx]; return t2===22||t2===34||t2===23; });
      const backEdge = !rN && elevAt(tx,ty-1)<=elevAt(tx,ty);
      if(backEdge){
        // BACK RIM: the surface runs smoothly to a crisp edge — no rocky body on the
        // far side of a mountain, so the back never reads like another front.
        if(snowNear){ px(x,y,TILE,TILE,'#f0f6fa');
          px(x+2+h1%9,y+5+h2%7,2,2,'#dde9f2'); px(x+9-h3,y+10-h4,2,2,'#dde9f2'); }
        else { px(x,y,TILE,TILE,'#5fa860');
          px(x+2+h1%9,y+4+h2%7,2,2,'#6cbc6d'); px(x+8-h3,y+9+h4%4,2,2,'#549a55'); }
        px(x,y,TILE,1,'#2e2216');
        px(x,y+1,TILE,1, snowNear?'#ffffff':'#cfe2c8');
      } else {
        px(x,y,TILE,TILE,'#7a5c40');
        if(!rN){ px(x,y,TILE,1,'#2e2216'); px(x,y+1,TILE,1, snowNear?'#eef4f8':'#a07f5c'); px(x,y+2,TILE,2,'#6a4f36'); }
        else if(snowNear){ px(x,y,TILE,3,'#eef4f8'); px(x,y+3,TILE,1,'#cfdce4'); }
        else { px(x,y,TILE,2,'#9c7752'); px(x,y+2,TILE,1,'#8a6a4a'); }
        px(x+1+h1%8,y+6+h2%6,3,2,'#8d6c4c'); px(x+1+h1%8,y+6+h2%6,3,1,'#a07a56');
        px(x+8-h3,y+10-h4,3,2,'#8d6c4c'); px(x+8-h3,y+10-h4,3,1,'#a07a56');
        px(x+4+h4,y+12-h3,2,1,'#523c28');
      }
      if(!rS && elevAt(tx,ty+1)<=elevAt(tx,ty)){ px(x,y+13,TILE,2,'#4a3624'); px(x,y+15,TILE,1,'#2e2216'); }
      /* OLD (revert):
      px(x,y,TILE,TILE,'#7a5c40');
      const snowNear=[[0,-1],[0,1],[-1,0],[1,0]].some(([dx,dy])=>{ const t2=NG[ty+dy]&&NG[ty+dy][tx+dx]; return t2===22||t2===34||t2===23; });
      if(snowNear){ px(x,y,TILE,3,'#eef4f8'); px(x,y+3,TILE,1,'#cfdce4'); }
      else { px(x,y,TILE,2,'#9c7752'); px(x,y+2,TILE,1,'#8a6a4a'); }
      px(x+1+h1%8,y+6+h2%6,3,2,'#8d6c4c'); px(x+1+h1%8,y+6+h2%6,3,1,'#a07a56');
      px(x+8-h3,y+10-h4,3,2,'#8d6c4c'); px(x+8-h3,y+10-h4,3,1,'#a07a56');
      px(x+4+h4,y+12-h3,2,1,'#523c28');
      */
      break; }
    case 33: { // MOUNTAIN ROCK — warm brown chunky stone (reference style)
      const rk=(t2)=>t2===32||t2===33;
      const rN=NG[ty-1]&&rk(NG[ty-1][tx]), rS=NG[ty+1]&&rk(NG[ty+1][tx]);
      // elevation-aware: a FACE only makes sense if the open south side is not uphill
      // (on the north arcs of terraced mountains like Crystalpeak, the open side is the
      //  higher tier — those tiles must read as plateau/back, never as a front face)
      const e33=elevAt(tx,ty), eS33=elevAt(tx,ty+1), eN33=elevAt(tx,ty-1);
      if(!rS && eS33<=e33){
        // FRONT FACE: vertical strata + boulders + heavy under-shadow
        px(x,y,TILE,TILE,'#6b4f38'); px(x,y,TILE,1,'#96714e');
        px(x+3+h1%3,y+2,1,12,'#4e3826'); px(x+8+h2%3,y+2,1,12,'#4e3826'); px(x+13-h3%3,y+2,1,12,'#4e3826');
        px(x+1+h1%6,y+3+h2%4,4,3,'#7d5e44'); px(x+1+h1%6,y+3+h2%4,4,1,'#96714e');
        px(x+8-h3,y+8+h4%3,4,3,'#7d5e44'); px(x+8-h3,y+8+h4%3,4,1,'#96714e');
        px(x,y+13,TILE,2,'#3a2a1c'); px(x,y+15,TILE,1,'#241a10');
        if(!rN) px(x,y,TILE,1,'#2e2216');
      } else if(!rN && eN33<=e33){
        // BACK RIDGE: the mass's top surface runs to a crisp edge (plateau tone)
        px(x,y,TILE,TILE,'#75593f');
        px(x,y,TILE,1,'#2e2216'); px(x,y+1,TILE,1,'#8d6c4c');
        px(x+2+h1%7,y+5+h2%5,4,2,'#7d5e44'); px(x+2+h1%7,y+5+h2%5,4,1,'#8d6c4c');
        px(x+9-h3,y+10,3,2,'#6a4e36');
      } else {
        // PLATEAU TOP: calmer interior
        px(x,y,TILE,TILE,'#75593f');
        px(x+1+h1%8,y+3+h2%6,4,2,'#7d5e44'); px(x+1+h1%8,y+3+h2%6,4,1,'#8d6c4c');
        px(x+9-h3,y+9+h4%3,3,2,'#6a4e36');
        if(h4<2) px(x+4+h2%7,y+12,2,1,'#523c28');
      }
      /* OLD (revert):
      px(x,y,TILE,TILE,'#6b4f38');
      px(x,y,TILE,1,'#876649');
      px(x+1+h1%8,y+2+h2%6,4,3,'#7d5e44'); px(x+1+h1%8,y+2+h2%6,4,1,'#96714e');   // chunk + lit top
      px(x+8-h3,y+8+h4%4,4,3,'#7d5e44'); px(x+8-h3,y+8+h4%4,4,1,'#96714e');
      px(x+3+h4,y+12-h3,3,2,'#4e3826'); px(x+10-h2%5,y+5+h3,2,2,'#4e3826');       // deep cracks
      */
      break; }
    case 34: { // PACKED-SNOW TRAIL — trodden bands with bootprint dimples
      px(x,y,TILE,TILE,'#dfeaf2');
      px(x+2,y+3,TILE-4,2,'#c4d2dc'); px(x+1,y+9,TILE-2,2,'#c4d2dc');
      px(x+3+h1%7,y+6,2,1,'#b2c2ce'); px(x+8-h3,y+12,2,1,'#b2c2ce');
      if(h2<4) px(x+4+h4,y+1,1,1,'#f2f8fc');
      break; }
    case 87: { // FALLEN RUBBLE — a shoulder-high block of dressed masonry, shovable
      px(x,y,TILE,TILE,'#8a7a6a');
      px(x,y,TILE,2,'#a89380'); px(x,y+TILE-2,TILE,2,'#5f5148');
      px(x,y+6,TILE,1,'#6d5f52');
      px(x+5,y+1,1,5,'#6d5f52'); px(x+9,y+7,1,7,'#6d5f52');          // block joints
      px(x+1,y+2,3,3,'#98836f'); px(x+11,y+9,3,3,'#7d6d5f');         // chipped faces
      if(h1<5) px(x+6+h2%4,y+10,2,2,'#6a5c50');
      px(x,y,1,TILE,'#a89380'); px(x+TILE-1,y,1,TILE,'#5f5148');     // lit + shaded edge
      break; }
    case 86: { // SKIFF MOORING — a light glider tethered at the brink, sail luffing
      px(x,y,TILE,TILE,'#6f5f52');
      px(x+1,y+11,14,2,'#5a4c42');                                    // stone bollard row
      px(x+2,y+9,12,3,'#7a5f42'); px(x+2,y+9,12,1,'#96764f');         // the hull
      px(x+3,y+12,10,1,'#5f4832');
      { const lf=(Date.now()>>8)&3;                                    // sail in the updraft
        px(x+7,y+2,1,8,'#8a7659');                                     // mast
        px(x+8,y+3+(lf&1),5,5,'#d8c3a0'); px(x+8,y+3+(lf&1),5,1,'#eeddbb');
        px(x+4-(lf>>1),y+5,3,1,'#b9a37a'); }                           // tether rope
      break; }
    case 85: { // WAYSTATION BRAZIER — a watchman's fire on a carved plinth, still lit
      px(x,y,TILE,TILE,'#6f5f52');
      px(x+3,y+10,10,5,'#5a4c42'); px(x+3,y+10,10,1,'#7b6a5c');      // plinth
      px(x+4,y+13,8,1,'#4a3e36');
      px(x+5,y+7,6,4,'#4a4038'); px(x+5,y+7,6,1,'#6a5c50');          // iron bowl
      { const fl=(Date.now()>>7)&3;                                   // the fire
        px(x+6,y+4-(fl&1),4,4,'#f0a050');
        px(x+7,y+2-(fl>>1),2,3,'#ffd08a');
        px(x+6+(fl&1),y+1,1,2,'#fff0c0');
        if(fl===2) px(x+9,y+2,1,1,'#ffd08a'); }
      break; }
    case 83: { // TIMBER CACHE — planks and coiled rope left for a repair never made
      px(x,y,TILE,TILE,'#6f5b47');
      px(x+1,y+9,14,3,'#8a6a45'); px(x+1,y+9,14,1,'#a5825a');       // bottom plank
      px(x+2,y+5,12,3,'#7d6040'); px(x+2,y+5,12,1,'#98764f');       // middle plank
      px(x+3,y+2,10,2,'#8a6a45'); px(x+3,y+2,10,1,'#a5825a');       // top plank
      px(x+4,y+3,1,9,'#5a4430'); px(x+11,y+3,1,9,'#5a4430');        // end grain
      { const r=(h1&1)?0:1;                                          // coil of rope
        px(x+11,y+12,4,1,'#b9a37a'); px(x+10+r,y+13,5,1,'#a8926c'); }
      break; }
    case 84: { // MENDED SPAN — fresh planking laid over the drop, rope rails strung
      px(x,y,TILE,TILE,'#7a5f42');
      px(x,y+2,TILE,1,'#5f4832'); px(x,y+7,TILE,1,'#5f4832'); px(x,y+12,TILE,1,'#5f4832');
      px(x,y,TILE,1,'#9a7a52');                                      // new timber, still pale
      if(h2<5) px(x+3+h1%8,y+4,3,2,'#8a6c4a');
      { const sw=((Date.now()>>9)+tx)&1;                             // rope rail, swaying
        px(x,y+14+sw,TILE,1,'#b9a37a'); px(x+4,y+13+sw,1,2,'#8a7659'); px(x+12,y+13+sw,1,2,'#8a7659'); }
      break; }
    case 82: { // SKY-FERRY DECK — a raft of timber and iron hung from chains,
      //  drifting the gulf between isles. Boards run across the line of travel.
      px(x,y,TILE,TILE,'#6b4f34');
      px(x,y,TILE,1,'#8a6a45'); px(x,y+TILE-1,TILE,1,'#4a3524');
      px(x,y+5,TILE,1,'#553c28'); px(x,y+10,TILE,1,'#553c28');       // plank seams
      px(x+3,y,1,TILE,'#5d4230'); px(x+12,y,1,TILE,'#5d4230');       // iron straps
      if(h1<4) px(x+6+h2%5,y+2,2,2,'#7d5c3e');                       // worn timber
      { const sw=((Date.now()>>8)+tx+ty)&1;                          // chain sway
        px(x+1,y+1+sw,1,3,'#9aa0aa'); px(x+TILE-2,y+1+(1-sw),1,3,'#9aa0aa'); }
      break; }
    case 81: { // SUNFALL SKY — the drop. Open air beneath the floating isles, with
      //  the land of Luminar a long way down: haze, slow cloud banks drifting the
      //  wrong way for parallax, and the faint green-brown of a continent below.
      const DAWN = portalWorld.dawn || sunfallProgress.dawn;
      px(x,y,TILE,TILE, DAWN ? '#8a5a70' : '#6a4a62');                 // haze: first light / held evening
      { // the world below — low-frequency blobs so land reads as land, not noise
        const bx=(tx>>3), by=(ty>>3), bh=((bx*73856093 ^ by*19349663)>>>0);
        if(bh%5<2){ px(x,y,TILE,TILE,'#5e4a55'); if((bh>>4)%3===0) px(x+2,y+3,10,7,'#57505a'); }
        if(bh%7===0) px(x+3,y+6,9,5,'#4e5a4a');                      // distant forest
        if(bh%11===0) px(x+5,y+2,5,4,'#6a5a4a');                     // distant fields
      }
      { // cloud banks, drifting slowly across the gulf
        const dr=Math.floor(Date.now()/260);
        const c1=((tx*7+ty*13+dr)>>>0)%23, c2=((tx*11+ty*5+(dr>>1))>>>0)%29;
        if(c1<4) px(x,y+4+(c1&3),TILE,2, DAWN?'rgba(255,224,200,0.42)':'rgba(232,214,232,0.30)');
        if(c2<3) px(x,y+9+(c2&3),TILE,1, DAWN?'rgba(255,238,214,0.30)':'rgba(240,226,240,0.22)');
      }
      // the brink: rock still catching light where an isle overhangs this tile
      { const above=NG[ty-1]&&NG[ty-1][tx];
        if(above!==undefined && above!==81){
          px(x,y,TILE,4,'#4a3a34'); px(x,y,TILE,1,'#6b5346');        // underside of the isle
          px(x,y+4,TILE,2,'#3e3230');
          if(h1<6) px(x+2+h2%9,y+5,2,3,'#352b2a');                   // hanging rock
          px(x,y+6,TILE,1,'rgba(200,170,190,0.16)');                 // haze eating the base
        } }
      break; }
    case 80: { // SUNFALL SEA WALL — dressed masonry standing out of the channel.
      //  Drawn per-edge: a face, a batter and a foam line appear only on the sides
      //  that actually meet water, so long octagon runs read as a true rampart
      //  rather than a stair-stepped outline. Lit warm by the held sunset.
      const wet=(t2)=>t2===3||t2===20||t2===21||t2===81;   // 81 = open sky (Sunfall)
      const wN=!!(NG[ty-1]&&wet(NG[ty-1][tx])), wS=!!(NG[ty+1]&&wet(NG[ty+1][tx]));
      const wW=!!(NG[ty]&&wet(NG[ty][tx-1])), wE=!!(NG[ty]&&wet(NG[ty][tx+1]));
      const swell=((Date.now()>>9)+tx+ty)&1;                     // slow foam shimmer
      px(x,y,TILE,TILE,'#8a7a6a');                               // ashlar body
      px(x,y,TILE,3,'#c8a878'); px(x,y,TILE,1,'#e0be8c');        // sun-struck top cap
      px(x,y+3,TILE,1,'#6d5f52');
      px(x,y+7,TILE,1,'#6d5f52'); px(x,y+11,TILE,1,'#6d5f52');   // ashlar courses
      { const off=(h1&1)?3:0;                                    // staggered joints
        px(x+4+off,y+4,1,3,'#6d5f52'); px(x+11-off,y+4,1,3,'#6d5f52');
        px(x+2+off,y+8,1,3,'#6d5f52'); px(x+9+off,y+8,1,3,'#6d5f52');
        px(x+6-off,y+12,1,3,'#6d5f52'); }
      if(h2<5) px(x+2+h3%9,y+5,3,2,'#948374');
      if(h1<3) px(x+10,y+9,2,2,'#7d6d5f');
      if(wS){                                                     // face toward the water
        px(x,y+10,TILE,4,'#6b5c50');                              // battered face in shade
        px(x,y+13,TILE,2,'#4a3d35');                              // waterline
        px(x+1+swell,y+15,3,1,'#bfe0ea'); px(x+8-swell,y+15,4,1,'#bfe0ea');   // foam
      }
      if(wN){ px(x,y,TILE,1,'#4a3d35'); px(x,y+1,TILE,1,'#e0be8c');           // crisp back rim
        px(x+3+swell,y,3,1,'#bfe0ea'); }
      if(wW){ px(x,y+3,2,TILE-3,'#6b5c50'); px(x,y+3,1,TILE-3,'#4a3d35');
        px(x,y+9+swell,1,3,'#bfe0ea'); }
      if(wE){ px(x+TILE-2,y+3,2,TILE-3,'#6b5c50'); px(x+TILE-1,y+3,1,TILE-3,'#4a3d35');
        px(x+TILE-1,y+7+swell,1,3,'#bfe0ea'); }
      break; }
    case 5: { // 3D STONE RAMPART — lit top cap, stone body, shadowed base + block seams
      const wl=(t2)=>t2===5||t2===9;
      const wN=NG[ty-1]&&wl(NG[ty-1][tx]), wS=NG[ty+1]&&wl(NG[ty+1][tx]);
      const wW=NG[ty]&&wl(NG[ty][tx-1]), wE=NG[ty]&&wl(NG[ty][tx+1]);
      if(!wS){
        // FRONT FACE: crenellated cap + brick face + deep base shadow
        px(x,y,TILE,5,'#9b93a6'); px(x,y,TILE,1,'#b3abbd');
        for(let i=0;i<TILE;i+=4){ px(x+i,y,2,2,'#b3abbd'); px(x+i+2,y,2,2,'#7a7388'); }
        px(x,y+4,TILE,1,'#544c60');
        px(x,y+5,TILE,9,'#6b6275');
        px(x,y+8,TILE,1,'#544c60'); px(x,y+11,TILE,1,'#544c60');
        const off=(h1&1)?2:0;
        px(x+3+off,y+5,1,3,'#544c60'); px(x+9+off,y+5,1,3,'#544c60');
        px(x+5-off,y+9,1,2,'#544c60'); px(x+11-off,y+9,1,2,'#544c60');
        px(x+6+off,y+12,1,2,'#544c60');
        if(h2<4) px(x+2+h3%8,y+6,3,2,'#767083');
        if(h1<2) px(x+7,y+6,1,4,'#2e2938');
        px(x,y+14,TILE,2,'#3a3444'); px(x,y+15,TILE,1,'#241f2e');
        if(!wN) px(x,y,TILE,1,'#3a3444');
        if(!wW) px(x,y,1,TILE,'#4a4456');
        if(!wE) px(x+TILE-1,y,1,TILE,'#3f394d');
      } else if(!wN){
        // BACK EDGE: far-side silhouette + rim light, cooler cap
        px(x,y,TILE,TILE,'#847e92');
        px(x,y,TILE,1,'#3a3444'); px(x,y+1,TILE,1,'#b3abbd');
        px(x,y+7,TILE,1,'#6e6880'); px(x+5+(h1&3),y+2,1,5,'#6e6880'); px(x+11-(h2&3),y+8,1,7,'#6e6880');
        px(x,y+TILE-1,TILE,1,'#6e6880');
        if(h3<3) px(x+2+h1%9,y+3+h2%4,3,2,'#908aa0');
        if(!wW) px(x,y,1,TILE,'#5a5468');
        if(!wE) px(x+TILE-1,y,1,TILE,'#5a5468');
      } else {
        // INTERIOR: wall-top walkway with large slabs
        px(x,y,TILE,TILE,'#918ba0');
        px(x,y,TILE,1,'#a49eb2'); px(x,y+7,TILE,1,'#6e6880');
        const off=(h1&1)?3:0;
        px(x+4+off,y,1,7,'#6e6880'); px(x+10-off,y+8,1,8,'#6e6880');
        if(h2<4) px(x+1+h3%9,y+2+h4%3,4,3,'#9b95aa');
        if(h4<2) px(x+2+h1%9,y+10,3,2,'#847e92');
        if(!wW){ px(x,y,1,TILE,'#6e6880'); px(x+1,y,1,TILE,'#a49eb2'); }
        if(!wE) px(x+TILE-1,y,1,TILE,'#5a5468');
      }
      /* OLD (revert):
      px(x,y,TILE,TILE,'#6b6275');                 // body
      px(x,y,TILE,4,'#9b93a6');                     // lit top cap (sunlit)
      px(x,y,TILE,2,'#b3abbd');                     // bright cap highlight
      px(x,y+TILE-3,TILE,3,'#473f52');              // shadowed base
      px(x+TILE-3,y+4,3,TILE-4,'#544c60');          // shaded right face
      // mortar seams (offset brick courses)
      px(x,y+8,TILE,1,'#544c60'); px(x+7,y+4,1,4,'#544c60'); px(x+3,y+9,1,5,'#544c60'); px(x+11,y+9,1,5,'#544c60');
      */
      break; }
    default: px(x,y,TILE,TILE,'#5fa860');
  }
  // ── LEDGE/WALL CONTACT: ground tiles seat against adjacent cliffs & ramparts ──
  {
    const GROUND=(g)=>g===0||g===2||g===4||g===6||g===7||g===8||g===14||g===15||g===18||g===19||g===22||g===23||g===25||g===27||g===28||g===31||g===34;
    if(GROUND(t)){
      const gN=NG[ty-1]&&NG[ty-1][tx], gS=NG[ty+1]&&NG[ty+1][tx];
      const gW=NG[ty]&&NG[ty][tx-1], gE=NG[ty]&&NG[ty][tx+1];
      const rock=(g)=>g===32||g===33, caster=(g)=>g===32||g===33||g===5;
      if(caster(gN) && elevAt(tx,ty)<=elevAt(tx,ty-1)){
        px(x,y,TILE,3,'#140f0a58'); px(x,y+3,TILE,2,'#140f0a30'); px(x,y+5,TILE,1,'#140f0a16');
        if(rock(gN)){ px(x+2+h1%9,y+2,2,1,'#8a7458'); px(x+3+h1%9,y+3,1,1,'#5a4834');
          if(h2<5) px(x+10-h3%6,y+4,2,1,'#8a7458'); }
      }
      if(rock(gS)) px(x,y+TILE-1,TILE,1,'#140f0a2e');
      if(caster(gW)) px(x,y,1,TILE,'#140f0a26');
      if(caster(gE)) px(x+TILE-1,y,1,TILE,'#140f0a26');
    }
  }
}

// ── FAKED-3D BUILDINGS ───────────────────────────────────────
// Each building footprint is W×H tiles. We paint: ground shadow, front wall
// face (lit top/left, shaded bott/right), a peeked side, a roof slab/pitch on
// top, plus door/windows. Anchored so the door tile aligns with the grid door.

// ── TOWN THEMES: material + palette identity per town, resolved from building id ──
const TOWN_THEMES = {
 hearthvale: { pal:{}, roofTex:'shingle' },
 homestead:  { pal:{wall:'#e6dcc6',wallLit:'#f4eee0',wallDark:'#b8ae98',side:'#c4baa4',
               roof:'#c8a04a',roofLit:'#e0bc6a',roofDark:'#9a7a34',roofEave:'#7e6228',roofRidge:'#ecd28a'},
               beam:'#6a4e30', wallTex:'timber', roofTex:'thatch' },
 saltmere:   { pal:{wall:'#e8e2d4',wallLit:'#f6f2e8',wallDark:'#c0baac',side:'#ccc6b8',
               roof:'#5a7a8a',roofLit:'#729aa8',roofDark:'#46626f',roofEave:'#3a505c',roofRidge:'#8ab4c2'},
               beam:'#5a6a74', wallTex:'plank', roofTex:'slate' },
 thornwood:  { pal:{wall:'#8a6a44',wallLit:'#a68354',wallDark:'#6a4e30',side:'#755838',
               roof:'#4e7a4a',roofLit:'#639659',roofDark:'#3a5c38',roofEave:'#2e4a2c',roofRidge:'#7ab074'},
               beam:'#4a3420', wallTex:'timber', roofTex:'shingle' },
 dusthaven:  { pal:{wall:'#d8b988',wallLit:'#ecd2a4',wallDark:'#b09260',side:'#bc9c6c',
               roof:'#b56a3f',roofLit:'#cf8455',roofDark:'#8f4e2c',roofEave:'#7a3f22',roofRidge:'#e09a6a'},
               wallTex:'plain', roofTex:'shingle' },
 crystalpeak:{ pal:{wall:'#9a94a8',wallLit:'#b4aec2',wallDark:'#726c84',side:'#7e788e',
               roof:'#6a7080',roofLit:'#8490a0',roofDark:'#4e5462',roofEave:'#3e4450',roofRidge:'#a0acc0'},
               wallTex:'stone', roofTex:'slate', snowRidge:true },
 ironhold:   { pal:{wall:'#8a8a92',wallLit:'#a4a4ac',wallDark:'#68686f',side:'#727279',
               roof:'#5a5e6a',roofLit:'#727888',roofDark:'#42454e',roofEave:'#33363e',roofRidge:'#8890a2'},
               wallTex:'stone', roofTex:'slate' },
 stormgate:  { pal:{wall:'#7e8290',wallLit:'#98a0b0',wallDark:'#5c626e',side:'#686e7a',
               roof:'#4e5a74',roofLit:'#66748e',roofDark:'#3a4458',roofEave:'#2e3646',roofRidge:'#7c8caa'},
               wallTex:'stone', roofTex:'slate' },
 ashfield:   { pal:{wall:'#7a7068',wallLit:'#948a80',wallDark:'#5a524c',side:'#645c54',
               roof:'#4a4442',roofLit:'#5e5856',roofDark:'#383432',roofEave:'#2a2624',roofRidge:'#6e6864'},
               beam:'#2e2a28', wallTex:'timber', roofTex:'shingle' },
 shadowmere: { pal:{wall:'#6e6a80',wallLit:'#868298',wallDark:'#525064',side:'#5c5870',
               roof:'#4a3e5e',roofLit:'#5e5076',roofDark:'#382e48',roofEave:'#2c2438',roofRidge:'#6e5e8a'},
               wallTex:'stone', roofTex:'slate' },
 hellgate:   { pal:{wall:'#3a3440',wallLit:'#4e4856',wallDark:'#28242e',side:'#2e2a36',
               roof:'#5a2430',roofLit:'#742e3e',roofDark:'#421a24',roofEave:'#32141c',roofRidge:'#8a3e50',
               glass:'#ff8040'},
               wallTex:'stone', roofTex:'slate' },
};
const TOWN_PREFIX = {dh:'dusthaven',cp:'crystalpeak',ih:'ironhold',tw:'thornwood',af:'ashfield',sg:'stormgate',sh:'shadowmere',hg:'hellgate',sm:'saltmere'};
function townOf(b){
  const id=b.id||'';
  if(id.indexOf('home_')===0) return 'homestead';
  const p=id.split('_')[0];
  return TOWN_PREFIX[p]||'hearthvale';
}

// ── THE ANCIENT PORTAL: a weathered stone arch framing a violet/teal swirling
//    void (active) or dark, iron-barred stone (sealed). ox,oy = screen px of the
//    summit tile; the arch is drawn centered above it. t = Date.now() for the swirl. ──
function drawPortal(p, ox, oy, t){
  const stone='#6b6470', stoneL='#8b8494', stoneD='#4a4550', moss='#4a6b3a';
  // the arch straddles a 3-tile span centered on the summit tile
  const bx=ox-TILE, by=oy-TILE*2;   // top-left of the ~3x3 arch footprint (px)
  const P=(x,y,w,h,c)=>px(bx+x,by+y,w,h,c);
  // pillars
  for(const pxl of [4,36]){
    P(pxl,10,8,34,stone); P(pxl,10,3,34,stoneL); P(pxl+5,10,3,34,stoneD);
    for(let sy=14; sy<44; sy+=6) P(pxl,sy,8,1,stoneD);
    P(pxl,40,8,4,moss); P(pxl+1,42,2,1,'#5c7d4a');
  }
  // the swirling void (drawn BEFORE the lintel so the arch frames it)
  const cx=bx+24, cy=by+26, R=13;
  if(p.unlocked){
    for(let r=R;r>0;r--){ const tt=r/R;
      const vi=[0x7a,0x3e,0xa8], te=[0x2f,0xb0,0xa8];
      const cc=vi.map((v,i)=>Math.round(v*tt+te[i]*(1-tt)));
      ctx.fillStyle='rgb('+cc[0]+','+cc[1]+','+cc[2]+')';
      ctx.beginPath(); ctx.arc(cx,cy,r,0,Math.PI*2); ctx.fill(); }
    const ph=(t||0)*0.004;
    for(let a=0;a<2;a++) for(let s=0;s<22;s++){
      const ang=ph*0.9 + a*Math.PI + s*0.5, rr=1.2+s*0.55; if(rr>R-1) break;
      const x=cx+Math.cos(ang)*rr, y=cy+Math.sin(ang)*rr*0.92;
      px(Math.round(x),Math.round(y),2,2, s%2===0?'#bfeee8':'#c9a8f0'); }
    const pulse=2+Math.sin(ph*1.6)*1.2;
    ctx.fillStyle='#e8fbf6'; ctx.beginPath(); ctx.arc(cx,cy,pulse,0,Math.PI*2); ctx.fill();
  } else {
    ctx.fillStyle='#241c30'; ctx.beginPath(); ctx.arc(cx,cy,R,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#1a1424'; ctx.beginPath(); ctx.arc(cx,cy,R-4,0,Math.PI*2); ctx.fill();
    P(6,24,36,4,'#3a3540'); P(6,24,36,1,'#55505c');
    P(22,12,4,28,'#3a3540'); P(22,12,1,28,'#55505c');
    px(cx-1,cy-1,2,2,'#2a4a48');
  }
  // lintel + keystone (on top of the void)
  P(4,4,40,8,stone); P(4,4,40,3,stoneL); P(4,10,40,2,stoneD);
  P(21,2,6,10,stoneL); P(22,2,4,2,'#a49cb0'); P(21,10,6,2,stoneD);
  for(const rx of [10,18,26,34]){ const rc=p.unlocked?'#3fb8b0':'#2a4a48'; P(rx,6,2,3,rc); if(p.unlocked) P(rx,6,2,1,'#7fe8e0'); }
}
// ── CHAPEL EXTERIOR — the Mistral Isle chapel, rebuilt to scale to any footprint.
//    Steeple tower + short spire + large cross, pitched shingle roof, arched door in a
//    stone surround, and two arched side windows. Uses the town palette so each village
//    chapel still themes, and honours th.snowRidge / roof texture like other buildings.
//    Draws its own ground shadow, so drawBuilding returns immediately after calling it.
function drawChapelExterior(b, ox, oy, pal, th, OL){
  const P=(x,y,w,h,c)=>px(x,y,w,h,c);
  const W=b.w*TILE, H=b.h*TILE;
  const roofRidge = pal.roofRidge || pal.roofLit;
  const roofEave  = pal.roofEave  || pal.roofDark;
  const glass  = pal.glass  || '#8fc0e0';
  const glassL = '#cfe6f5';
  const stoneTrim = pal.wallLit;

  // ground shadow (matches drawBuilding's footprint shadow)
  ctx.fillStyle='rgba(0,0,0,0.20)';
  ctx.beginPath(); ctx.ellipse(ox+W/2+6, oy+H-2, W/2, TILE*0.5, 0,0,7); ctx.fill();

  const wallTop = oy + Math.round(H*0.46);
  const wallH   = (oy+H) - wallTop;

  // ── body ──
  P(ox, wallTop, W, wallH, pal.wall);
  P(ox, wallTop, W, 2, pal.wallLit);
  P(ox, wallTop, 2, wallH, pal.wallLit);
  P(ox+W-2, wallTop, 2, wallH, pal.wallDark);
  P(ox, oy+H-2, W, 2, pal.wallDark);
  P(ox+W, wallTop+3, 3, wallH-3, pal.side);
  P(ox+W, oy+H-2, 3, 2, pal.wallDark);
  // stone coursing
  for(let cy=wallTop+5; cy<oy+H-2; cy+=5) P(ox+2, cy, W-4, 1, pal.wallDark);
  let i2=0; for(let cx=ox+5; cx<ox+W-4; cx+=7){ P(cx+(i2%2)*3, wallTop+6, 1, 4, pal.wallDark); i2++; }

  // ── pitched roof (scales with W) ──
  const rTop=oy+2, rBot=wallTop+2, rH=rBot-rTop, inW=W*0.10;
  for(let i=0;i<rH;i++){ const inset=Math.round((rH-i)/rH*inW);
    P(ox+inset, rTop+i, W-inset*2+1, 1, i<rH*0.35?pal.roofLit:pal.roof); }
  P(ox+Math.round(W/2)-1, rTop, 2, 2, roofRidge);
  P(ox, rBot-1, W, 1, roofEave);
  // shingle courses (or thatch/slate when the town theme asks)
  const rtex = (th && th.roofTex) || 'shingle';
  if(rtex==='thatch'){
    for(let i=2;i<rH-1;i+=2){ const inset=Math.round((rH-i)/rH*inW); P(ox+inset, rTop+i, W-inset*2+1, 1, pal.roofDark); }
    P(ox-1, rBot-3, W+2, 2, pal.roofLit);
  } else {
    for(let i=4;i<rH-1;i+=4){ const inset=Math.round((rH-i)/rH*inW); P(ox+inset, rTop+i, W-inset*2+1, 1, pal.roofDark); }
  }
  if(th && th.snowRidge) P(ox+Math.round(inW), rTop+1, W-Math.round(inW)*2, 2, '#f0f6fa');
  // eave overhang + outline
  P(ox-1, rBot-2, W+2, 2, pal.roof);
  P(ox-1, rBot, W+2, 1, '#00000038');
  for(let i=0;i<rH;i++){ const inset=Math.round((rH-i)/rH*inW);
    P(ox+inset-1, rTop+i, 1, 1, OL); P(ox+W-inset+1, rTop+i, 1, 1, OL); }

  // ── steeple tower rising from the ridge (scales with H) ──
  const stW = Math.max(9, Math.round(W*0.24));
  const stX = ox + Math.round(W/2) - Math.round(stW/2);
  const stTop = oy - Math.round(H*0.20);
  const stH = (rTop+4) - stTop;
  P(stX, stTop, stW, stH, pal.wall);
  P(stX, stTop, stW, 2, pal.wallLit);
  P(stX, stTop, 2, stH, pal.wallLit);
  P(stX+stW-2, stTop, 2, stH, pal.wallDark);
  P(stX+stW, stTop+3, 3, stH-3, pal.side);
  P(stX-1, stTop-1, stW+2, 1, OL);
  P(stX-1, stTop-1, 1, stH+1, OL); P(stX+stW, stTop-1, 1, stH+1, OL);
  for(let cy=stTop+4; cy<stTop+stH; cy+=5) P(stX+1, cy, stW-2, 1, pal.wallDark);
  // louvred belfry opening
  const byO=stTop+4, bhO=Math.min(stH-6, Math.round(stH*0.5));
  P(stX+3, byO, stW-6, bhO, '#241c30');
  for(let i=1;i<bhO;i+=2) P(stX+3, byO+i, stW-6, 1, pal.wallLit);
  P(stX+3, byO, stW-6, 1, OL);

  // ── short spire ──
  const spBot=stTop+2, spTop=stTop-Math.round(H*0.08), spH=spBot-spTop;
  for(let i=0;i<spH;i++){ const inset=Math.round(i/spH*(stW/2-1));
    P(stX+inset, spBot-i, stW-inset*2, 1, i>spH-3?pal.roofLit:pal.roof); }
  P(stX-1, spBot, stW+2, 1, OL);
  P(stX+Math.round(stW/2)-1, spTop, 2, 1, pal.roofLit);

  // ── the cross, centred above the spire ──
  const cross=pal.cross||'#f4ecd2', crossHi='#fffdf0', crossSh=pal.wallDark;
  const cxc=stX+Math.round(stW/2), cTop=spTop-Math.round(H*0.12), shaftH=Math.round(H*0.15), barY=cTop+Math.round(shaftH*0.30), barHalf=Math.max(3,Math.round(stW*0.30));
  P(cxc-1, cTop, 3, shaftH, cross); P(cxc-1, cTop, 1, shaftH, crossHi); P(cxc+1, cTop, 1, shaftH, crossSh);
  P(cxc-barHalf, barY, barHalf*2+1, 3, cross); P(cxc-barHalf, barY, barHalf*2+1, 1, crossHi); P(cxc-barHalf, barY+2, barHalf*2+1, 1, crossSh);
  P(cxc-1, cTop, 3, 1, crossHi);

  // ── arched door, centred, with a stone surround ──
  const dW=Math.max(8, Math.round(W*0.16)), dX=ox+Math.round(W/2)-Math.round(dW/2);
  const dTop=wallTop+Math.round(wallH*0.30), dBot=oy+H-2;
  P(dX, dTop, dW, dBot-dTop, pal.door);
  P(dX, dTop-2, dW, 3, pal.doorL||pal.roofLit);
  P(dX+Math.round(dW/2)-1, dTop-3, 2, 2, pal.doorL||pal.roofLit);
  P(dX+Math.round(dW/2), dTop+2, 1, dBot-dTop-2, '#2a1e12');
  P(dX, dTop, 1, dBot-dTop, pal.doorL||pal.wallLit);
  P(dX-1, dTop-2, 1, (oy+H)-dTop, stoneTrim);
  P(dX+dW, dTop-2, 1, (oy+H)-dTop, stoneTrim);
  P(dX+dW-4, dTop+Math.round((dBot-dTop)*0.5), 2, 2, '#f2c14e');   // handle

  // ── two arched side windows ──
  const wy=wallTop+6, ww=Math.max(5, Math.round(W*0.11)), wh=Math.max(8, Math.round(wallH*0.5));
  [ox+Math.round(W*0.12), ox+W-Math.round(W*0.12)-ww].forEach(wx=>{
    P(wx-1, wy-1, ww+2, wh+2, '#241a10');
    P(wx, wy, ww, wh, glass);
    P(wx, wy, ww, 1, glassL);
    P(wx+Math.round(ww/2), wy, 1, wh, pal.wallDark);
    P(wx, wy+Math.round(wh/2), ww, 1, pal.wallDark);
    P(wx+Math.round(ww/2)-1, wy-2, 3, 2, glass);                    // arched top
    P(wx-1, wy-1, ww+2, 1, OL);
  });
}

// ── INN EXTERIOR — a two-storey coaching inn: gambrel roof, a railed second-floor
//    balcony, and a covered porch across the ground floor. Warm light from every
//    window and a lantern by the door. Scales to the building's footprint, themes
//    with the town palette, draws its own shadow (drawBuilding returns after it).
function drawInnExterior(b, ox, oy, pal, th, OL){
  const P=(x,y,w,h,c)=>px(x,y,w,h,c);
  const W=b.w*TILE, H=b.h*TILE;
  const roofRidge=pal.roofRidge||pal.roofLit, roofDark=pal.roofDark||pal.roofEave;
  const wood='#7a5228', woodL='#9a6c38', woodD='#553618', post='#6a4a24', beam='#5a3c1c';
  const T=performance.now()/1000;

  ctx.fillStyle='rgba(0,0,0,0.20)';
  ctx.beginPath(); ctx.ellipse(ox+W/2+6, oy+H-2, W/2, TILE*0.5, 0,0,7); ctx.fill();

  const wallTop = oy + Math.round(H*0.30);        // taller wall zone: two storeys
  const wallH   = (oy+H) - wallTop;

  // ── body ──
  P(ox, wallTop, W, wallH, pal.wall);
  P(ox, wallTop, W, 2, pal.wallLit);
  P(ox, wallTop, 2, wallH, pal.wallLit);
  P(ox+W-2, wallTop, 2, wallH, pal.wallDark);
  P(ox, oy+H-2, W, 2, pal.wallDark);
  P(ox+W, wallTop+3, 3, wallH-3, pal.side);
  P(ox+W, oy+H-2, 3, 2, pal.wallDark);
  // half-timbering
  for(let cx=ox+6; cx<ox+W-4; cx+=8) P(cx, wallTop+2, 1, wallH-4, pal.wallDark);

  // ── GAMBREL ROOF (two slopes) ──
  const rTop=oy+2, rBreak=oy+Math.round(H*0.16), rBot=wallTop+2;
  const upIn=Math.round(W*0.30), loIn=Math.round(W*0.10), inWid=W;
  for(let yy=rTop; yy<rBreak; yy++){ const t=(yy-rTop)/Math.max(1,(rBreak-rTop));
    const inset=Math.round(upIn*(1-t)+loIn*t*0.4)+Math.round((1-t)*4);
    P(ox+inset, yy, inWid-inset*2, 1, (yy-rTop)<3?pal.roofLit:pal.roof); }
  for(let yy=rBreak; yy<rBot; yy++){ const t=(yy-rBreak)/Math.max(1,(rBot-rBreak));
    const inset=Math.round(loIn*(1-t));
    P(ox+inset, yy, inWid-inset*2, 1, pal.roof);
    if((yy-rBreak)%3===0) P(ox+inset, yy, inWid-inset*2, 1, roofDark); }
  P(ox+upIn-1, rTop-1, inWid-upIn*2+2, 1, OL);          // ridge silhouette
  P(ox-1, rBreak, inWid+2, 1, roofDark);                // the break line
  P(ox-2, rBot-2, inWid+4, 2, pal.roof); P(ox-2, rBot, inWid+4, 1, '#00000038');
  for(let yy=rTop; yy<rBot; yy++){ const t=yy<rBreak?(yy-rTop)/Math.max(1,(rBreak-rTop)):1;
    const inset=yy<rBreak?Math.round(upIn*(1-t)+loIn*t*0.4)+Math.round((1-t)*4):Math.round(loIn*(1-((yy-rBreak)/Math.max(1,(rBot-rBreak)))));
    P(ox+inset-1, yy, 1, 1, OL); P(ox+inWid-inset+1, yy, 1, 1, OL); }

  // ── stone chimney with ember + smoke ──
  const chx=ox+W-Math.round(W*0.22);
  P(chx-1, rTop-8, 10, (rBreak-rTop)+10, '#6e6a80'); P(chx, rTop-8, 8, (rBreak-rTop)+9, '#8a8496');
  P(chx, rTop-8, 8, 2, '#a8a4b6'); for(let i=0;i<3;i++) P(chx, rTop-5+i*5, 8, 1, '#6e6a80');
  P(chx+2, rTop-7, 4, 3, '#3a2418'); P(chx+2, rTop-7, 4, 1, '#e08a3a');
  const pf=((Date.now()>>9)+(b.x*31+b.y*17))&3;
  P(chx+2, rTop-11-pf, 3, 2, '#e8e8f0aa'); P(chx+3, rTop-14-pf, 2, 2, '#e8e8f077');

  // ── SECOND-FLOOR BALCONY across the upper wall ──
  const balY = wallTop + Math.round(wallH*0.34);
  P(ox-3, balY, W+6, 3, wood); P(ox-3, balY, W+6, 1, woodL); P(ox-3, balY+3, W+6, 1, '#00000044');
  for(let bx=ox-2; bx<ox+W+3; bx+=4) P(bx, balY-7, 1, 7, post);          // balusters
  P(ox-3, balY-8, W+6, 2, wood); P(ox-3, balY-8, W+6, 1, woodL);         // top rail
  // balcony door + flanking upper windows (warm)
  const udx=ox+Math.round(W/2)-3;
  P(udx-1, balY-13, 8, 14, OL); P(udx, balY-12, 6, 12, pal.door);
  P(udx+3, balY-12, 1, 12, '#2a1c10'); P(udx, balY-12, 1, 12, pal.wallLit);
  for(const fx of [ox+Math.round(W*0.13), ox+W-Math.round(W*0.13)-7]){ const wy=balY-11;
    P(fx-1, wy-1, 9, 8, OL); P(fx, wy, 7, 6, '#f0d080'); P(fx, wy, 7, 2, '#fff0c0');
    P(fx+3, wy, 1, 6, '#8a6438'); P(fx, wy+3, 7, 1, '#8a6438');
    const wg=ctx.createRadialGradient(fx+3,wy+3,0,fx+3,wy+3,12);
    wg.addColorStop(0,'rgba(255,214,130,0.20)'); wg.addColorStop(1,'rgba(255,214,130,0)');
    ctx.fillStyle=wg; ctx.fillRect(fx-9,wy-7,25,22); }

  // ── COVERED PORCH across the ground floor ──
  const porchTop = balY + Math.round((oy+H-balY)*0.30);
  const px0=ox-4, pw=W+8, base=oy+H;
  P(px0, porchTop-2, pw, 2, pal.roof); P(px0, porchTop-2, pw, 1, pal.roofLit);   // porch shed roof
  P(px0, porchTop, pw, 1, '#00000040');
  for(const pxp of [px0+1, ox+Math.round(W/2)-1, px0+pw-3]){                       // posts
    P(pxp, porchTop, 2, base-porchTop, post); P(pxp, porchTop, 1, base-porchTop, woodL); }
  P(px0+1, porchTop+2, 6, 1, beam); P(px0+pw-7, porchTop+2, 6, 1, beam);          // corner braces
  P(px0, base-2, pw, 3, wood); P(px0, base-2, pw, 1, woodL); P(px0, base+1, pw, 1, '#00000038'); // deck/step
  // ground-floor doorway (warm, recessed under the porch)
  const ddx=ox+Math.round(W/2)-5, ddy=porchTop+3;
  const dg=ctx.createRadialGradient(ddx+5,ddy+7,0,ddx+5,ddy+7,15);
  dg.addColorStop(0,'rgba(255,206,120,0.30)'); dg.addColorStop(1,'rgba(255,206,120,0)');
  ctx.fillStyle=dg; ctx.fillRect(ddx-10,ddy-4,30,26);
  P(ddx-1, ddy, 12, (base-2)-ddy, OL); P(ddx, ddy+1, 10, (base-3)-ddy, pal.door);
  P(ddx+4, ddy+1, 2, (base-3)-ddy, '#2a1c10'); P(ddx+1, ddy+1, 3, 1, '#8a6a3a');
  // lantern on a porch post
  const lx=px0+2, ly=porchTop+4;
  P(lx, ly-3, 2, 3, '#3a3040'); P(lx-2, ly, 6, 7, '#4a3a2a'); P(lx-1, ly+1, 4, 5, '#ffd472'); P(lx-1, ly+1, 4, 1, '#fff0c0');
  const gl=ctx.createRadialGradient(lx+1,ly+4,0,lx+1,ly+4,18);
  gl.addColorStop(0,'rgba(255,200,110,0.30)'); gl.addColorStop(1,'rgba(255,190,90,0)');
  ctx.fillStyle=gl; ctx.fillRect(lx-16,ly-12,36,34);
  // bench + barrels on the porch
  P(ox+W-13, base-6, 11, 2, wood); P(ox+W-13, base-6, 11, 1, woodL);
  P(ox+W-12, base-4, 2, 4, beam); P(ox+W-4, base-4, 2, 4, beam);
  for(const [bxx,byy] of [[px0+pw-7, base-8]]){
    P(bxx,byy,6,6,'#7a5228'); P(bxx,byy,6,1,'#9a6c38'); P(bxx,byy+2,6,1,'#5a3c1c'); P(bxx,byy+4,6,1,'#5a3c1c'); }
  // swinging sign from the porch beam
  const sgx=px0+2, sgy=porchTop+1;
  P(sgx, sgy-1, 4, 2, '#3a3040');
  P(sgx+1, sgy+1, 11, 8, OL); P(sgx+2, sgy+2, 9, 6, '#6a4a28'); P(sgx+2, sgy+2, 9, 1, '#8a6438');
  P(sgx+3, sgy+3, 7, 4, '#c9a45c'); P(sgx+4, sgy+5, 5, 1, '#5a3c1c');
}

function drawBuilding(b, ox, oy){
  const W=b.w*TILE, H=b.h*TILE;
  const th=TOWN_THEMES[townOf(b)]||{};
  const pal=Object.assign({}, BSTYLE[b.style]||BSTYLE.house, th.pal||{});
  if(b.style==='chapel'){ drawChapelExterior(b, ox, oy, pal, th, '#1a141c'); return; }
  if(b.style==='inn'){ drawInnExterior(b, ox, oy, pal, th, '#1a141c'); return; }
  const wallTex = th.wallTex==='plain' ? null
                : th.wallTex ? th.wallTex
                : (b.style==='cottage' ? 'timber' : (b.style==='keep'||b.style==='chapel') ? 'stone' : null);
  const roofTex = th.roofTex||'shingle';
  const beam = th.beam||'#5a4028';
  const OL='#1a141c';
  ctx.fillStyle='rgba(0,0,0,0.20)'; ctx.beginPath();
  ctx.ellipse(ox+W/2+6, oy+H-2, W/2, TILE*0.5, 0,0,7); ctx.fill();
  const wallTop = oy + Math.round(H*0.42);
  const wallH = (oy+H) - wallTop;
  px(ox, wallTop, W, wallH, pal.wall);
  px(ox, wallTop, W, 2, pal.wallLit);
  px(ox, wallTop, 2, wallH, pal.wallLit);
  px(ox+W-2, wallTop, 2, wallH, pal.wallDark);
  px(ox, oy+H-2, W, 2, pal.wallDark);
  px(ox+W, wallTop+3, 3, wallH-3, pal.side);
  px(ox+W, oy+H-2, 3, 2, pal.wallDark);
  if(wallTex==='timber'){
    px(ox+2,wallTop+2,2,wallH-4,beam); px(ox+W-4,wallTop+2,2,wallH-4,beam);
    px(ox+2,wallTop+2,W-4,2,beam);
  } else if(wallTex==='stone' && pal.roofType!=='crenel'){
    for(let cy2=wallTop+5; cy2<oy+H-2; cy2+=5) px(ox+2,cy2,W-4,1,pal.wallDark);
    let i2=0; for(let cx2=ox+5; cx2<ox+W-4; cx2+=7){ px(cx2+(i2%2)*3,wallTop+6,1,4,pal.wallDark); i2++; }
  } else if(wallTex==='plank'){
    for(let cx2=ox+5; cx2<ox+W-3; cx2+=5) px(cx2,wallTop+3,1,wallH-5,pal.wallDark);
  }
  if(pal.roofType==='pitch'){
    const rTop=oy, rBot=wallTop+2, rH=rBot-rTop;
    for(let i=0;i<rH;i++){ const inset=Math.round((rH-i)/rH*(W*0.12));
      px(ox+inset, rTop+i, W-inset*2+1, 1, i<rH*0.35?pal.roofLit:pal.roof); }
    px(ox+Math.round(W/2)-1, rTop, 2, 2, pal.roofRidge);
    px(ox, rBot-1, W, 1, pal.roofEave);
    // themed roof texture
    if(roofTex==='thatch'){
      for(let i=2;i<rH-1;i+=2){ const inset=Math.round((rH-i)/rH*(W*0.12));
        px(ox+inset, rTop+i, W-inset*2+1, 1, pal.roofDark); }
      px(ox+Math.round(W/2)-2, rTop, 4, 2, pal.roofRidge);
      px(ox-1, rBot-3, W+2, 2, pal.roofLit);
    } else if(roofTex==='slate'){
      for(let i=3;i<rH-1;i+=3){ const inset=Math.round((rH-i)/rH*(W*0.12));
        px(ox+inset, rTop+i, W-inset*2+1, 1, pal.roofDark);
        for(let cx2=ox+inset+3; cx2<ox+W-inset-2; cx2+=5) px(cx2+(i%2)*2, rTop+i-2, 1, 2, pal.roofDark); }
    } else {
      for(let i=4;i<rH-1;i+=4){ const inset=Math.round((rH-i)/rH*(W*0.12));
        px(ox+inset, rTop+i, W-inset*2+1, 1, pal.roofDark); }
    }
    if(th.snowRidge) px(ox+Math.round(W*0.12), rTop+1, W-Math.round(W*0.12)*2, 2, '#f0f6fa');
    // eave overhang + shadow, roof outline
    px(ox-1, rBot-2, W+2, 2, pal.roof);
    px(ox-1, rBot, W+2, 1, '#00000038');
    for(let i=0;i<rH;i++){ const inset=Math.round((rH-i)/rH*(W*0.12));
      px(ox+inset-1, rTop+i, 1, 1, OL); px(ox+W-inset+1, rTop+i, 1, 1, OL); }
    px(ox+Math.round(W*0.12)-1, rTop-1, W-Math.round(W*0.12)*2+3, 1, OL);
    // chimney + drifting smoke
    const chx=ox+W-8;
    px(chx, rTop+2, 4, 6, '#8a8496'); px(chx, rTop+2, 4, 1, '#a8a4b6'); px(chx-1, rTop+1, 6, 2, '#6e6a80');
    const puff=((Date.now()>>9)+(b.x*31+b.y*17))&3;
    px(chx+1, rTop-2-puff, 2, 2, '#e8e8f0aa'); px(chx+2, rTop-5-puff, 2, 2, '#e8e8f066'); px(chx, rTop-8-puff, 2, 2, '#e8e8f033');
  } else if(pal.roofType==='crenel'){
    const rH=wallTop-oy; px(ox-2, oy+4, W+4, rH+(wallTop-(oy+4)), pal.wall);
    for(let i=0;i<b.w*2;i++){ const bx=ox+i*(TILE/2); const tall=(i%2===0);
      px(bx, oy+(tall?2:6), TILE/2-1, (tall?wallTop-oy-2:wallTop-oy-6)+2, pal.roof);
      px(bx, oy+(tall?2:6), TILE/2-1, 1, pal.roofLit); }
    px(ox, wallTop, W, 1, pal.roofEave);
    for(let i=0;i<b.w*2;i++){ const bx=ox+i*(TILE/2); const tall=(i%2===0); const ty2=oy+(tall?2:6);
      px(bx-1, ty2, 1, 3, OL); px(bx+TILE/2-1, ty2, 1, 3, OL); px(bx, ty2-1, TILE/2-1, 1, OL); }
    for(let cy2=oy+9; cy2<oy+H-3; cy2+=6) px(ox-2, cy2, W+4, 1, pal.wallDark);
    let i3=0; for(let cx2=ox+4; cx2<ox+W-3; cx2+=7){ px(cx2+(i3%2)*3, oy+11, 1, 3, pal.wallDark); i3++; }
    px(ox+Math.round(W*0.3), oy+13, 1, 5, '#2e2938'); px(ox+Math.round(W*0.7), oy+13, 1, 5, '#2e2938');
  } else {
    const rH=wallTop-oy; px(ox-1, oy, W+2, rH, pal.roof);
    px(ox-1, oy, W+2, 2, pal.roofLit); px(ox-1, oy, 2, rH, pal.roofLit);
    px(ox+W-1, oy, 2, rH, pal.roofEave); px(ox-1, wallTop-1, W+2, 1, pal.roofEave);
    px(ox-2, oy-1, W+4, 1, OL); px(ox-2, oy, 1, rH, OL); px(ox+W+1, oy, 1, rH, OL);
    for(let cy2=oy+3; cy2<wallTop-2; cy2+=4) px(ox, cy2, W, 1, pal.roofEave);
    if(pal.awning){ px(ox, wallTop, W, 3, pal.awning);
      for(let i=0;i<b.w*2;i++) if(i%2) px(ox+i*(TILE/2), wallTop, TILE/2, 3, '#fff2');
      px(ox, wallTop+3, W, 1, '#00000040');
      for(let i=0;i<b.w*2;i++) px(ox+i*(TILE/2)+2, wallTop+3, 1, 2, pal.awning); }
  }
  if(b.door){
    const dx = ox + (b.door.x-b.x)*TILE, dy = oy+H-TILE;
    px(dx+2, dy, TILE-4, TILE, '#3a2410');
    px(dx+3, dy+1, TILE-6, TILE-1, pal.door);
    px(dx+TILE-5, dy+7, 2, 2, '#f2c14e');
    if(pal.roofType==='crenel'){ px(dx+2, dy-2, TILE-4, 2, '#181018'); }
    px(dx+1, dy+TILE-1, TILE-2, 1, '#00000045');
    px(dx+2, dy, 1, TILE, OL); px(dx+TILE-3, dy, 1, TILE, OL);
  }
  if(b.style!=='chapel'){
    const wy=wallTop+Math.round(wallH*0.3);
    [ox+5, ox+W-9].forEach(wx=>{ px(wx, wy, 4, 4, '#241a10'); px(wx, wy, 4, 4, pal.glass); px(wx, wy, 4, 1, '#cfe6f5');
      px(wx+1, wy, 1, 4, pal.wallDark); px(wx, wy+2, 4, 1, pal.wallDark);
      px(wx-1, wy-1, 6, 1, OL); px(wx-1, wy+4, 6, 1, '#00000045'); });
  } else {
    const cx=ox+Math.round(W/2);
    px(cx-3, wallTop+4, 6, 10, '#241a10'); px(cx-2, wallTop+5, 4, 8, '#8fc0e0'); px(cx-2,wallTop+5,4,1,'#cfe6f5');
    px(cx-1, oy+2, 2, 8, '#f2e6b0'); px(cx-3, oy+4, 6, 2, '#f2e6b0');
    px(cx-1, wallTop+5, 1, 8, pal.wallDark);
    px(cx-4, wallTop+3, 8, 1, OL); px(cx-4, wallTop+4, 1, 10, OL); px(cx+3, wallTop+4, 1, 10, OL);
    px(cx-1, oy+1, 2, 1, '#fff8d0'); px(cx-3, oy+3, 6, 1, '#fff8d0');
  }
  px(ox-1, wallTop, 1, wallH, OL); px(ox+W+3, wallTop+3, 1, wallH-3, OL);
  px(ox-1, oy+H-1, W+4, 1, '#14101466'); px(ox, oy+H, W+2, 1, '#00000038');
}

function drawBuilding_legacy(b, ox, oy){
  const W=b.w*TILE, H=b.h*TILE;
  // ground shadow (offset lower-right)
  ctx.fillStyle='rgba(0,0,0,0.20)'; ctx.beginPath();
  ctx.ellipse(ox+W/2+6, oy+H-2, W/2, TILE*0.5, 0,0,7); ctx.fill();
  const pal = BSTYLE[b.style] || BSTYLE.house;
  const wallTop = oy + Math.round(H*0.42);     // wall starts below the roof
  const wallH = (oy+H) - wallTop;
  // front wall face
  px(ox, wallTop, W, wallH, pal.wall);
  px(ox, wallTop, W, 2, pal.wallLit);           // lit top edge
  px(ox, wallTop, 2, wallH, pal.wallLit);       // lit left edge
  px(ox+W-2, wallTop, 2, wallH, pal.wallDark);  // shaded right edge
  px(ox, oy+H-2, W, 2, pal.wallDark);           // base shadow
  // peeked right side face (depth)
  px(ox+W, wallTop+3, 3, wallH-3, pal.side);
  px(ox+W, oy+H-2, 3, 2, pal.wallDark);
  // ─ roof ─
  if(pal.roofType==='pitch'){
    const rTop=oy, rBot=wallTop+2, rH=rBot-rTop;
    for(let i=0;i<rH;i++){ const inset=Math.round((rH-i)/rH * (W*0.12)); 
      px(ox+inset, rTop+i, W-inset*2+1, 1, i<rH*0.35?pal.roofLit:pal.roof); }
    px(ox+Math.round(W/2)-1, rTop, 2, 2, pal.roofRidge);   // ridge highlight
    px(ox, rBot-1, W, 1, pal.roofEave);                     // eave shadow
  } else if(pal.roofType==='crenel'){   // castle battlements
    const rH=wallTop-oy; px(ox-2, oy+4, W+4, rH+ (wallTop-(oy+4)), pal.wall); // tower body base hint
    for(let i=0;i<b.w*2;i++){ const bx=ox+i*(TILE/2); const tall=(i%2===0); 
      px(bx, oy+(tall?2:6), TILE/2-1, (tall?wallTop-oy-2:wallTop-oy-6)+2, pal.roof);
      px(bx, oy+(tall?2:6), TILE/2-1, 1, pal.roofLit); }
    px(ox, wallTop, W, 1, pal.roofEave);
  } else { // flat slab roof (shop/inn)
    const rH=wallTop-oy; px(ox-1, oy, W+2, rH, pal.roof);
    px(ox-1, oy, W+2, 2, pal.roofLit); px(ox-1, oy, 2, rH, pal.roofLit);
    px(ox+W-1, oy, 2, rH, pal.roofEave); px(ox-1, wallTop-1, W+2, 1, pal.roofEave);
    if(pal.awning){ px(ox, wallTop, W, 3, pal.awning); for(let i=0;i<b.w*2;i++) if(i%2) px(ox+i*(TILE/2), wallTop, TILE/2, 3, '#fff2'); }
  }
  // ─ door (aligned to grid door tile) ─
  if(b.door){
    const dx = ox + (b.door.x-b.x)*TILE, dy = oy+H-TILE;
    px(dx+2, dy, TILE-4, TILE, '#3a2410');
    px(dx+3, dy+1, TILE-6, TILE-1, pal.door);
    px(dx+TILE-5, dy+7, 2, 2, '#f2c14e'); // knob
    if(pal.roofType==='crenel'){ px(dx+2, dy-2, TILE-4, 2, '#181018'); } // arch
  }
  // ─ windows (lit, inset) ─
  if(b.style!=='chapel'){
    const wy=wallTop+Math.round(wallH*0.3);
    [ox+5, ox+W-9].forEach(wx=>{ px(wx, wy, 4, 4, '#241a10'); px(wx, wy, 4, 4, pal.glass); px(wx, wy, 4, 1, '#cfe6f5'); });
  } else {
    // chapel: tall arched window + cross on roof
    const cx=ox+Math.round(W/2);
    px(cx-3, wallTop+4, 6, 10, '#241a10'); px(cx-2, wallTop+5, 4, 8, '#8fc0e0'); px(cx-2,wallTop+5,4,1,'#cfe6f5');
    px(cx-1, oy+2, 2, 8, '#f2e6b0'); px(cx-3, oy+4, 6, 2, '#f2e6b0');
  }
}

// building palettes — distinct per style; per-town variants later
const BSTYLE = {
  cottage: { wall:'#c9a878', wallLit:'#e0c79a', wallDark:'#9c7c50', side:'#a3814f', glass:'#7fb0d0', door:'#74492a',
             roof:'#b5462f', roofLit:'#cf5a40', roofDark:'#8f3422', roofEave:'#7a2c1c', roofRidge:'#e87a55', roofType:'pitch' },
  house:   { wall:'#bfa9c0', wallLit:'#d8c4d9', wallDark:'#8f7a90', side:'#9a849b', glass:'#7fb0d0', door:'#5a3a6a',
             roof:'#5a6e9a', roofLit:'#7088b8', roofDark:'#3f527a', roofEave:'#33446a', roofRidge:'#8ba0d0', roofType:'pitch' },
  shop:    { wall:'#caa15a', wallLit:'#e0bd78', wallDark:'#9c7838', side:'#a37c40', glass:'#9fd0c0', door:'#6a4420',
             roof:'#3f7a6a', roofLit:'#56998a', roofEave:'#2c5a4c', roofType:'flat', awning:'#b53b3b' },
  inn:     { wall:'#b88a5a', wallLit:'#d6a878', wallDark:'#8c6438', side:'#9a7240', glass:'#f0d080', door:'#5a3818',
             roof:'#7a5230', roofLit:'#9a7048', roofDark:'#5c3c1e', roofEave:'#5a3c20', roofRidge:'#b47a48', roofType:'inn', awning:'#3b6ab5' },
  chapel:  { wall:'#cdbfa0', wallLit:'#e6dcc2', wallDark:'#9c8e70', side:'#a89a7c', glass:'#8fc0e0', door:'#6a5230',
             roof:'#8a4a6a', roofLit:'#a86288', roofDark:'#6a3450', roofEave:'#52283e', roofRidge:'#c080a0', roofType:'pitch' },
  keep:    { wall:'#74708a', wallLit:'#928fb0', wallDark:'#54506a', side:'#5e5a76', glass:'#8fa0d0', door:'#2a2430',
             roof:'#8b87a4', roofLit:'#a6a2c0', roofEave:'#605c78', roofType:'crenel' },
};

// ── SPRITES ──────────────────────────────────────────────────

// ── STEEDS: pixel sprites for the three final-form mounts (War/Sky/Tide Steed).
//    view: 'profile'|'front'|'back'; mirror=true flips profile for right-facing.
//    Composite is 24x24; mounted anchor offsets are handled by drawSteedMounted. ──
function drawSteedSprite(ox,oy,id,view,frame,rider,mirror){
  const Q=(lx,ly,w,h,c)=>{ if(mirror) px(ox+(24-lx-w),oy+ly,w,h,c); else px(ox+lx,oy+ly,w,h,c); };
  const OL='#141c2e',TUNIC='#3b6fd4',TUNIC_L='#5a8ae8',TUNIC_D='#2a52aa',HELM='#c9cdd6',HELM_HI='#eef0f4',HELM_D='#9096a2';
  const VISOR='#1a2740',LEG='#2a4a8a',BELT='#c9a94a',PLUME='#c0392e',PLUME_HI='#e05a4a',PLUME_D='#8a241c';
  const PAUL='#c9cdd6',PAUL_HI='#eef0f4',SKIN='#e0b080',SHIELD='#b8c0d0',SHIELD_D='#8890a0',REIN='#7a4a24';
  const SADDLE='#3b6fd4',SADDLE_T='#c9a94a';
  const shadow=(cx,cy,rx,ry,a)=>{ ctx.fillStyle='rgba(0,0,0,'+a+')'; ctx.beginPath();
    ctx.ellipse(ox+(mirror?24-cx:cx),oy+cy,rx,ry,0,0,7); ctx.fill(); };
  const riderProfile=()=>{
    Q(12,10,3,4,LEG); Q(12,14,3,1,OL);
    Q(11,5,6,5,TUNIC); Q(11,5,2,5,TUNIC_L); Q(15,5,2,5,TUNIC_D); Q(11,5,6,1,'#6a98f0'); Q(12,8,4,1,BELT);
    Q(10,5,3,2,PAUL); Q(10,5,3,1,PAUL_HI); Q(9,7,2,2,TUNIC); Q(8,8,2,1,SKIN); Q(5,8,3,1,REIN);
    Q(11,1,6,4,HELM); Q(11,1,6,1,HELM_HI); Q(16,1,1,4,HELM_D);
    Q(10,1,1,4,OL); Q(17,1,1,4,OL); Q(11,0,6,1,OL); Q(11,3,2,2,VISOR);
    Q(12,0,2,1,PLUME_HI); Q(14,0,2,1,PLUME); Q(16,1,1,1,PLUME_D); };
  const riderFront=()=>{
    Q(3,11,2,3,LEG); Q(11,11,2,3,LEG);
    Q(5,5,6,5,TUNIC); Q(5,5,2,5,TUNIC_L); Q(9,5,2,5,TUNIC_D); Q(5,5,6,1,'#6a98f0');
    Q(4,5,2,2,PAUL); Q(10,5,2,2,PAUL);
    Q(5,1,6,4,HELM); Q(5,1,6,1,HELM_HI); Q(10,1,1,4,HELM_D);
    Q(4,1,1,4,OL); Q(11,1,1,4,OL); Q(5,0,6,1,OL); Q(6,3,4,2,VISOR);
    Q(6,0,2,1,PLUME_HI); Q(8,0,2,1,PLUME); };
  const riderBack=()=>{
    Q(3,11,2,3,LEG); Q(11,11,2,3,LEG);
    Q(11,6,2,4,SHIELD_D); Q(12,6,1,4,SHIELD);
    Q(5,5,6,5,TUNIC); Q(5,5,2,5,TUNIC_L); Q(9,5,2,5,TUNIC_D); Q(7,5,1,5,TUNIC_D);
    Q(4,5,2,2,PAUL); Q(10,5,2,2,PAUL);
    Q(5,1,6,4,HELM); Q(5,1,6,1,HELM_HI); Q(10,1,1,4,HELM_D);
    Q(4,1,1,4,OL); Q(11,1,1,4,OL); Q(5,0,6,1,OL);
    Q(7,0,2,2,PLUME); Q(7,2,2,2,PLUME_HI); };

  if(id==='faithful'){
    // ── LION — the Faithful line's final form, on the War Steed's armature.
    // Body block Q(5,10,15,6) and saddle row Q(11,9,7,2) are unchanged, so the
    // rider pose carries over untouched. HOOF keeps its name and becomes a paw.
    const HB='#e3a844',HB_L='#ffd47e',HB_D='#a87424',MANE='#b06428',MANE_D='#6e3812',HOOF='#2a1408';
    if(view==='profile'){
      shadow(12,22.5,8,2,0.25);
      if(frame===0){ Q(9,16,2,5,HB_D); Q(14,16,2,5,HB_D); } else { Q(8,16,2,5,HB_D); Q(15,16,2,5,HB_D); }
      Q(5,10,15,6,HB); Q(5,10,15,2,HB_L); Q(5,15,15,1,HB_D);
      Q(5,6,4,5,HB); Q(5,6,2,5,HB_L);
      Q(0,2,10,3,MANE); Q(0,2,10,1,MANE_D); Q(0,4,2,9,MANE); Q(8,4,3,9,MANE);
      Q(0,12,10,2,MANE); Q(0,13,10,1,MANE_D);
      Q(1,5,6,5,HB); Q(1,5,6,1,HB_L); Q(0,7,2,2,HB_D);
      Q(2,6,1,1,OL); Q(5,6,1,1,OL); Q(1,9,4,1,MANE_D);
      Q(3,3,1,1,HB_D); Q(6,3,1,1,HB_D);
      Q(20,11,2,2,HB); Q(21,13,1,3,HB_D); Q(20,15,3,2,MANE);
      if(frame===0){ Q(5,16,2,4,HB); Q(4,19,2,2,HB); Q(4,20,2,1,HOOF);
        Q(17,16,2,4,HB); Q(18,19,2,2,HB); Q(18,20,2,1,HOOF); }
      else { Q(7,16,2,5,HB); Q(7,20,2,1,HOOF); Q(16,16,2,5,HB); Q(16,20,2,1,HOOF); }
      if(rider){ Q(11,9,7,2,SADDLE); Q(11,9,7,1,SADDLE_T); riderProfile(); }
    } else if(view==='front'){
      shadow(8,22.5,6,2,0.25);
      Q(3,12,10,6,HB); Q(3,12,10,1,HB_L);
      Q(4,18,2,4,HB); Q(4,21,2,1,HOOF); Q(10,18,2,4,HB); Q(10,21,2,1,HOOF);
      Q(1,6,14,11,MANE); Q(1,6,14,1,MANE_D); Q(1,16,14,1,MANE_D);
      Q(5,10,6,7,HB); Q(5,10,6,1,HB_L);
      Q(6,15,4,2,HB_L); Q(6,16,1,1,HB_D); Q(9,16,1,1,HB_D);
      Q(4,8,2,2,HB_D); Q(10,8,2,2,HB_D); Q(6,12,1,1,OL); Q(9,12,1,1,OL);
      if(rider) riderFront();
    } else {
      shadow(8,22.5,6,2,0.25);
      Q(3,11,10,7,HB); Q(3,11,10,1,HB_L); Q(3,17,10,1,HB_D);
      Q(4,18,2,4,HB); Q(4,21,2,1,HOOF); Q(10,18,2,4,HB); Q(10,21,2,1,HOOF);
      Q(2,8,12,5,MANE); Q(2,8,12,1,MANE_D);
      Q(7,13,2,6,HB_D); Q(6,19,4,3,MANE); Q(6,20,4,1,MANE_D);
      if(rider) riderBack();
    }
  } else if(id==='unicorn'){
    // ── UNICORN — the original Sky Steed art, reused whole. It is now its own
    // earned companion rather than a form of grace, so nothing here changed but
    // the branch condition. mountSkin ('spectral') still layers on top.
    const UB='#eceef4',UB_L='#ffffff',UB_D='#c4c8d6',UMANE='#e8c85a',HORN='#f2c14e',WING='#f4f6fa',WING_D='#b8bece';
    if(view==='profile'){
      shadow(12,22.5,6,1.6,0.16);
      const hv=(frame===1)?-1:0;
      Q(7,15+hv,2,3,UB_D); Q(16,15+hv,2,3,UB_D);
      Q(5,9+hv,15,6,UB); Q(5,9+hv,15,2,UB_L); Q(5,14+hv,15,1,UB_D);
      Q(5,5+hv,4,5,UB); Q(1,4+hv,5,4,UB); Q(1,4+hv,5,1,UB_L);
      Q(0,6+hv,2,2,UB_D); Q(2,5+hv,1,1,OL);
      Q(2,2+hv,1,2,HORN); Q(1,1+hv,1,1,HORN);
      Q(7,3+hv,2,2,UMANE); Q(8,5+hv,2,2,UMANE); Q(9,7+hv,2,2,UMANE);
      Q(20,9+hv,2,2,UMANE); Q(21,11+hv,1,3,UMANE);
      if(frame===0){ Q(14,7+hv,2,3,WING_D);
        Q(15,4+hv,3,4,WING); Q(17,2+hv,4,3,WING); Q(19,0+hv,4,3,WING);
        Q(17,4+hv,4,1,WING_D); Q(19,2+hv,4,1,WING_D); }
      else { Q(14,8+hv,2,2,WING_D);
        Q(15,6+hv,4,3,WING); Q(18,5+hv,5,3,WING);
        Q(15,8+hv,4,1,WING_D); Q(18,7+hv,5,1,WING_D); }
      if(rider){ Q(11,8+hv,7,2,SADDLE); Q(11,8+hv,7,1,SADDLE_T); riderProfile(); }
    } else if(view==='front'){
      shadow(8,22.5,4.5,1.4,0.16);
      Q(3,11,10,6,UB); Q(3,11,10,1,UB_L);
      Q(1,9,3,5,WING); Q(12,9,3,5,WING); Q(1,13,3,1,WING_D); Q(12,13,3,1,WING_D);
      Q(5,9,6,7,UB); Q(5,9,6,1,UB_L); Q(6,14,4,2,UB_D);
      Q(4,7,2,2,UB_D); Q(10,7,2,2,UB_D); Q(6,11,1,1,OL); Q(9,11,1,1,OL);
      Q(7,6,2,3,HORN); Q(7,5,1,1,HORN);
      if(rider) riderFront();
    } else {
      shadow(8,22.5,4.5,1.4,0.16);
      Q(3,10,10,7,UB); Q(3,10,10,1,UB_L); Q(3,16,10,1,UB_D);
      Q(1,8,3,6,WING); Q(12,8,3,6,WING); Q(1,13,3,1,WING_D); Q(12,13,3,1,WING_D);
      Q(7,12,2,6,UMANE); Q(7,18,2,2,UMANE);
      if(rider) riderBack();
    }
  } else if(id==='grace'){
    // ── GREAT DOVE — built on the unicorn's armature deliberately. The body
    // block Q(5,9+hv,15,6), the leg anchors and the saddle row are IDENTICAL,
    // so riderProfile/riderFront/riderBack need no per-form offset and ground
    // contact survives a form swap mid-stride.
    const DB='#f0f3f9',DB_L='#ffffff',DB_D='#c6cedd',CREST='#f6dc92',BEAK='#e8b850';
    const WING='#ffffff',WING_D='#c8d2e2',WING_G='#f0d68a';
    if(view==='profile'){
      shadow(12,22.5,6,1.6,0.16);
      const hv=(frame===1)?-1:0;
      Q(7,15+hv,2,3,BEAK); Q(16,15+hv,2,3,BEAK);              // talons where the hooves were
      Q(5,9+hv,15,6,DB); Q(5,9+hv,15,2,DB_L); Q(5,14+hv,15,1,DB_D);
      Q(5,5+hv,4,5,DB); Q(2,4+hv,4,4,DB); Q(2,4+hv,4,1,DB_L); // shorter, rounder than a muzzle
      Q(0,6+hv,3,2,BEAK); Q(3,5+hv,1,1,OL);
      Q(3,2+hv,2,2,CREST); Q(4,1+hv,1,1,CREST);               // crest where the horn was
      Q(6,7+hv,2,2,DB_D); Q(20,9+hv,2,2,DB_D); Q(21,11+hv,1,3,WING_G);
      if(frame===0){ Q(13,7+hv,3,3,WING_D);
        Q(14,3+hv,4,5,WING); Q(16,1+hv,5,3,WING); Q(18,0+hv,5,3,WING);
        Q(16,3+hv,5,1,WING_G); Q(18,2+hv,5,1,WING_G); }
      else { Q(13,8+hv,3,2,WING_D);
        Q(14,5+hv,5,4,WING); Q(17,4+hv,6,3,WING);
        Q(14,8+hv,5,1,WING_G); Q(17,6+hv,6,1,WING_G); }
      if(rider){ Q(11,8+hv,7,2,SADDLE); Q(11,8+hv,7,1,SADDLE_T); riderProfile(); }
    } else if(view==='front'){
      shadow(8,22.5,4.5,1.4,0.16);
      Q(3,11,10,6,DB); Q(3,11,10,1,DB_L);
      Q(0,8,4,6,WING); Q(12,8,4,6,WING); Q(0,13,4,1,WING_G); Q(12,13,4,1,WING_G);
      Q(5,9,6,7,DB); Q(5,9,6,1,DB_L); Q(6,14,4,2,DB_D);
      Q(6,11,1,1,OL); Q(9,11,1,1,OL); Q(7,12,2,2,BEAK);
      Q(7,6,2,3,CREST); Q(7,5,1,1,CREST);
      if(rider) riderFront();
    } else {
      shadow(8,22.5,4.5,1.4,0.16);
      Q(3,10,10,7,DB); Q(3,10,10,1,DB_L); Q(3,16,10,1,DB_D);
      Q(0,8,4,7,WING); Q(12,8,4,7,WING); Q(0,14,4,1,WING_G); Q(12,14,4,1,WING_G);
      Q(7,12,2,6,DB_D); Q(7,18,2,2,WING_G);
      if(rider) riderBack();
    }
  } else {
    // ── SEA DRAGON — the Steadfast line's final form. Already a dragon, so this
    // is a refinement, not a new creature: teal instead of land-green to match
    // the River Turtle it grows out of, a dorsal fin ridge in place of the four
    // lone spikes, and a real tail fluke. Armature untouched — body Q(4,11,17,5)
    // and saddle Q(10,10,7,2) are the same, so the rider does not move.
    const DB='#1f7a80',DB_L='#4fbcb2',DB_D='#124a54',BELLY='#a8e6dc',SPIKE='#0e5a62',DEYE='#ffe870',FIN='#8ceadc',HORN='#f2d060';
    if(view==='profile'){
      shadow(12,22.5,8,2,0.25);
      const sw=(frame===1)?1:0;
      Q(8,16,3,4,DB_D); Q(16,16,3,4,DB_D);
      Q(4,11,17,5,DB); Q(4,11,17,2,DB_L); Q(4,15,17,1,BELLY);
      Q(4,8,4,4,DB); Q(0,6,6,4,DB); Q(0,6,6,1,DB_L);
      Q(0,8,2,2,DB_D); Q(3,4,2,2,HORN); Q(5,5,1,1,HORN); Q(2,7,1,1,DEYE);
      Q(8,10,12,1,FIN); Q(9,9,2,1,FIN); Q(13,9,2,1,FIN); Q(17,9,2,1,FIN);
      Q(9,10,1,1,SPIKE); Q(12,10,1,1,SPIKE); Q(15,10,1,1,SPIKE); Q(18,10,1,1,SPIKE);
      if(frame===0){ Q(15,9,2,2,DB_D); Q(16,6,3,3,DB_L); Q(18,4,4,3,DB_L); Q(18,6,4,1,DB_D); }
      else { Q(15,10,2,1,DB_D); Q(16,8,4,2,DB_L); Q(19,7,4,2,DB_L); Q(19,8,4,1,DB_D); }
      Q(21,12+sw,2,2,DB); Q(22,13+sw,2,2,DB_D);
      Q(21,9+sw,1,4,FIN); Q(22,10+sw,2,6,FIN); Q(23,11+sw,1,4,FIN);
      Q(6,16,3,4,DB); Q(6,19,3,1,SPIKE); Q(15,16,3,4,DB); Q(15,19,3,1,SPIKE);
      if(rider){ Q(10,10,7,2,SADDLE); Q(10,10,7,1,SADDLE_T); riderProfile(); }
    } else if(view==='front'){
      shadow(8,22.5,6,2,0.25);
      Q(3,12,10,6,DB); Q(3,12,10,1,DB_L); Q(3,17,10,1,BELLY);
      Q(4,18,3,4,DB); Q(4,21,3,1,SPIKE); Q(9,18,3,4,DB); Q(9,21,3,1,SPIKE);
      Q(5,10,6,7,DB); Q(5,10,6,1,DB_L); Q(6,15,4,2,DB_D);
      Q(5,8,1,2,HORN); Q(10,8,1,2,HORN); Q(6,12,1,1,DEYE); Q(9,12,1,1,DEYE);
      if(rider) riderFront();
    } else {
      shadow(8,22.5,6,2,0.25);
      Q(3,11,10,7,DB); Q(3,11,10,1,DB_L); Q(3,17,10,1,DB_D);
      Q(4,18,3,4,DB); Q(9,18,3,4,DB);
      Q(7,13,2,6,DB_D); Q(5,17,2,4,FIN); Q(9,17,2,4,FIN); Q(6,19,4,3,FIN);
      Q(6,11,1,1,SPIKE); Q(9,11,1,1,SPIKE);
      if(rider) riderBack();
    }
  }
}
// mounted composite: anchored so the steed sits on the player tile (hitbox unchanged)
function drawSteedMounted(x,y,id,dir,frame){
  if(player.mountSkin==='spectral'){ ctx.globalAlpha=0.82;
    const oc=drawSteedSpectral((cx,cy)=>{
      if(dir==='left') drawSteedSprite(cx-4,cy-8,id,'profile',frame,true,false);
      else if(dir==='right') drawSteedSprite(cx-4,cy-8,id,'profile',frame,true,true);
      else if(dir==='up') drawSteedSprite(cx,cy-8,id,'back',frame,true,false);
      else drawSteedSprite(cx,cy-8,id,'front',frame,true,false); });
    ctx.drawImage(oc,x-24,y-24); ctx.globalAlpha=1; return; }
  if(dir==='left')       drawSteedSprite(x-4,y-8,id,'profile',frame,true,false);
  else if(dir==='right') drawSteedSprite(x-4,y-8,id,'profile',frame,true,true);
  else if(dir==='up')    drawSteedSprite(x,  y-8,id,'back',   frame,true,false);
  else                   drawSteedSprite(x,  y-8,id,'front',  frame,true,false);
}
// following (unmounted) steed: profile, no rider, faces its heading
function drawSteedFollow(x,y,id,face,frame){
  drawSteedSprite(x-4,y-8,id,'profile',frame,false,face==='right');
}

// apply the spectral barding: a cold blue-white, semi-translucent recolor of the
// steed, drawn via an offscreen tint so we don't touch the sprite internals. ──
let _spectralBuf=null;
function drawSteedSpectral(drawFn){
  if(!_spectralBuf){ _spectralBuf=document.createElement('canvas'); _spectralBuf.width=48; _spectralBuf.height=48; }
  const oc=_spectralBuf, octx=oc.getContext('2d'); octx.clearRect(0,0,48,48);
  // redirect px() into the offscreen buffer (px is the reassignable global)
  const _px=px; try{ px=function(ax,ay,w,h,c){ octx.fillStyle=c; octx.fillRect(ax,ay,w,h); }; drawFn(24,24); } finally { px=_px; }
  // tint: multiply toward cold blue, then lighten; draw translucent
  octx.globalCompositeOperation='source-atop';
  octx.fillStyle='rgba(120,180,255,0.55)'; octx.fillRect(0,0,48,48);
  octx.globalCompositeOperation='lighter';
  octx.fillStyle='rgba(40,70,120,0.25)'; octx.fillRect(0,0,48,48);
  octx.globalCompositeOperation='source-over';
  return oc;
}
// ══════════════════════════════════════════════════════════════════════
//  COMPANION SPRITES — the pre-steed forms.
//
//  Authored on a HALF-PIXEL grid (1 art unit = 0.5 game px), the same idiom
//  as the weapon art: RENDER_SCALE=2 resolves it exactly, and anything finer
//  would not survive the backing store. 48x48 art units sit inside the same
//  24x24 game-px footprint the steeds use, drawn at (x-4, y-8), so a
//  companion keeps its ground contact and draw order through evolution.
//
//  Rows are strings, one char per art unit, '.' transparent. Each sprite is
//  baked ONCE into an offscreen canvas and blitted thereafter — drawing 2304
//  cells with px() every frame would cost 20-40x what a steed costs.
// ══════════════════════════════════════════════════════════════════════
