      px(x+1+h1%10,y+2+h2%9,2,2,'#6cbc6d'); px(x+3+h2%9,y+8+h3%5,2,2,'#6cbc6d');
      px(x+9-h3,y+3+h4,1,2,'#549a55'); px(x+5+h4,y+12-h3,2,1,'#54a258');
      { const swg=(((Date.now()>>9)&1) && ((hsh>>4)%3===0))?1:0;
