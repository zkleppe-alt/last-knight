    }
    if(easyX!==null){ g[CEIL][easyX]=0; }
    if(hardX!==null && hardX!==easyX){ g[CEIL][hardX]=0; }
    g[WROW][stairX]=2;                                            // the stair, at the far end
    g[WROW][bx]=T_SEAL;                                           // the stone, barring the way
    // the long way round earns the chest: remember which side of the maze it is
    dungeon._hardX = hardX; dungeon._easyX = easyX;
  }
  // The seal has changed what is reachable, so re-walk the floor from the
  // entrance over the SEALED grid. Chests and demons placed against the old
  // distances could land inside the sealed chamber, where the player cannot
  // get at them and the floor can never be cleared.
  for(const k in distm) delete distm[k];
  { const q2=[[ex,ey,0]]; distm[ex+','+ey]=0;
    while(q2.length){ const [x,y,dd]=q2.shift();
      [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dx,dy])=>{ const nx2=x+dx, ny2=y+dy, k=nx2+','+ny2;
        if(nx2<0||ny2<0||nx2>=MAZE_W||ny2>=MAZE_H) return;
        if(g[ny2][nx2]===1 || g[ny2][nx2]===T_SEAL || distm[k]!==undefined) return;
        distm[k]=dd+1; q2.push([nx2,ny2,dd+1]); }); } }
  // Which half of the maze belongs to the hard climb? A cell belongs to whichever
  // way up is nearer, so the chest can be put where the long route earns it.
  const _side=(fromX)=>{ const d={}; if(fromX===null||fromX===undefined) return d;
    const q=[[fromX,3]]; d[fromX+',3']=0;
    while(q.length){ const [x,y]=q.shift();
      for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nx=x+dx, ny=y+dy, k=nx+','+ny;
        if(nx<1||ny<3||nx>=MAZE_W-1||ny>=MAZE_H-1) continue;
        if(g[ny][nx]===1 || d[k]!==undefined) continue;
        d[k]=d[x+','+y]+1; q.push([nx,ny]); } }
    return d; };
  const _dHard=_side(dungeon._hardX), _dEasy=_side(dungeon._easyX);
  const _inHardHalf=(x,y)=>{ const h=_dHard[x+','+y], e=_dEasy[x+','+y];
    if(h===undefined) return false; if(e===undefined) return true; return h<e; };
  // CHESTS: 1-2 dead-end cells well away from the entrance
  // rows 0-2 are the walkway, its ceiling and the border — nothing is placed
  // up there. A chest on the walkway sits past the stone, where the floor's
  // whole point is that you cannot reach it yet.
  // A chest is SOLID in a dungeon. One standing at the foot of a climb blocks
  // the very route it is meant to reward.
  const _footOfClimb=(x,y)=>y<=4 && (x===dungeon._hardX || x===dungeon._easyX);
  const deadEnds=[];
  for(let y=3;y<MAZE_H-1;y++)for(let x=1;x<MAZE_W-1;x++){
    if(_footOfClimb(x,y)) continue;
    if(g[y][x]!==0 || distm[x+','+y]===undefined) continue;
    const n=[[1,0],[-1,0],[0,1],[0,-1]].filter(([dx,dy])=>g[y+dy][x+dx]!==1&&g[y+dy][x+dx]!==T_SEAL).length;
    if(n===1 && (distm[x+','+y]||0)>=5) deadEnds.push([x,y]);
    // (filtered to the hard climb's half below — the long way round earns it)
  }
