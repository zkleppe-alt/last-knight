  const spots=[];
  for(let y=3;y<MAZE_H-1;y++)for(let x=1;x<MAZE_W-1;x++){
    if(_footOfClimb(x,y)) continue;
    if(g[y][x]!==0 || distm[x+','+y]===undefined) continue;
    if(distm[x+','+y] < SPAWN_CLEAR) continue;                       // clear of the way in
    if(_distStair[x+','+y]!==undefined && _distStair[x+','+y] < SPAWN_CLEAR) continue;  // and of the stair
    // and clear AS THE CROW FLIES too: a demon eight steps away round a corner
    // can still be three tiles from your face when the floor draws
    { let tooNear=false;
      for(let y4=0;y4<MAZE_H&&!tooNear;y4++)for(let x4=0;x4<MAZE_W;x4++){
        if(g[y4][x4]!==8 && g[y4][x4]!==2) continue;
