    for(const c of dungeon._candles) g[c.y][c.x]=T_CANDLE;
    // the tablet, set by the way in
    let tab=null, bestD=99;
    for(let y=3;y<MAZE_H-1;y++)for(let x=1;x<MAZE_W-1;x++){
      if(g[y][x]!==1) continue;
      const touches=[[1,0],[-1,0],[0,1],[0,-1]].some(([dx,dy])=>g[y+dy]&&g[y+dy][x+dx]===0&&(distm[(x+dx)+','+(y+dy)]||99)<=6);
      if(!touches) continue;
