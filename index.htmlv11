  px(x+5,y+4+fr,6,4-fr,'#e85a1a'); px(x+6,y+3+fr,4,3,'#ff8a2a'); px(x+7,y+4,2,2,'#ffd060');
}
function drawIntCrate(x,y,tx,ty){
  drawIntFloor(x,y,tx,ty);
  const h=_inHash(tx,ty);
  px(x+2,y+14,12,2,'rgba(20,10,4,0.3)');
  px(x+2,y+4,12,11,'#96683a'); px(x+2,y+4,12,1,'#b8895a');
  px(x+2,y+4,1,11,'#7a4e28'); px(x+13,y+4,1,11,'#7a4e28');
  px(x+2,y+9,12,1,'#7a4e28'); px(x+7,y+4,1,11,'#7a4e28');
  if((h&1)===0){ px(x+4,y,8,5,'#8a5c32'); px(x+4,y,8,1,'#a06c3c'); px(x+4,y+2,8,1,'#6a4222'); }
}
function drawIntGoodsShelf(x,y,tx,ty,f){
  drawIntWall(x,y,tx,ty,f);
  px(x+1,y+11,14,1,'#5e4630');
  const h=_inHash(tx,ty);
  if(h%3===0){ px(x+2,y+7,4,4,'#d8c890'); px(x+3,y+6,2,1,'#b8a468'); }
  else { px(x+2,y+8,3,3,'#8a8274'); px(x+3,y+7,1,1,'#6a6458'); }
  px(x+7,y+7,3,4,'#9a5c3a'); px(x+8,y+6,1,1,'#7a4222');
  px(x+11,y+8,3,3,'#3a6a4a'); px(x+12,y+7,1,1,'#2a5a3a');
}
function drawIntFootlocker(x,y,tx,ty){
  drawIntStone(x,y,tx,ty);
  px(x+3,y+13,10,2,'rgba(10,8,4,0.3)');
  px(x+3,y+6,10,7,'#6a4222'); px(x+3,y+6,10,1,'#8a5c32');
  px(x+3,y+9,10,1,'#4a2e14');
  px(x+5,y+6,1,7,'#8a929a'); px(x+10,y+6,1,7,'#8a929a');
