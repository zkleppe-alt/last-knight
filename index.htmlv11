  }
  function playerOf(R) {
    for (var i = 0; i < R.racers.length; i++) if (R.racers[i].isPlayer) return R.racers[i];
    return R.racers[0];
  }
  function updateRacer(r, dt, input, R) {
    var stats = r.stats;
    var accel, left, right;
    if (input) { accel = input.accel; left = input.left; right = input.right; }
    else {
      var myAng = Math.atan2(r.y - CY, r.x - CX);
      var aimAng = myAng + 0.35;
      var tx = CX + Math.cos(aimAng) * (RX_MID + r.aiLane * 80);
      var ty = CY + Math.sin(aimAng) * (RY_MID + r.aiLane * 55);
      var desired = Math.atan2(ty - r.y, tx - r.x);
      var diff = norm(desired - r.heading);
      left = diff < -0.05; right = diff > 0.05; accel = true;
      if (Math.random() > r.aiSkill) accel = Math.random() > 0.3;
    }
    // ── KART HANDLING ────────────────────────────────────────────────────────
    // _legacy: turn = handling * (0.6 + min(1, speed/topSpeed))
    //   Turn rate GREW with speed, so a full gallop whipped you round on a normal
    //   input and you spun out constantly. Karts do the reverse: fast is WIDE.
    //   Below TURN_FULL_AT of top speed you get the whole turning circle; above
    //   it the circle opens out, never below TURN_AT_SPEED of it.
    var _sp = stats.topSpeed>0 ? Math.min(1, r.speed / stats.topSpeed) : 0;
    var _ease = _sp<=TURN_FULL_AT ? 1
              : 1 - (1-TURN_AT_SPEED) * ((_sp-TURN_FULL_AT)/(1-TURN_FULL_AT));
    var turn = stats.handling * 1.35 * _ease * (r.air > 0 ? 0.35 : 1);
    if (left) r.heading -= turn * dt;
    if (right) r.heading += turn * dt;
    var leanTarget = (right ? 1 : 0) - (left ? 1 : 0);
    r._lean = (r._lean || 0) + (leanTarget * 8 - (r._lean || 0)) * 0.15 * dt;
    var top = stats.topSpeed * (1 + r.boost * 0.45);
    if (accel) r.speed += stats.accel * dt;
    r.speed -= r.speed * 0.02 * dt;
    r.speed = Math.max(0, Math.min(top, r.speed));
    if (r.air > 0) r.air -= dt;
    if (r.hitCooldown > 0) r.hitCooldown -= dt;
    r.boost = Math.max(0, r.boost - 0.018 * dt);
    // ── GRIP ── The horse used to move exactly along `heading`, so every turn was
    //    instant and total: point sideways and you were sideways. It now carries a
    //    direction of travel that CHASES the heading, which is what gives a kart
    //    its weight and lets you correct a slide instead of being thrown by it.
    // heading is left UNWRAPPED by the turn above (it can run to -12 rad after a
    // few seconds of holding left), so normalise it before comparing — otherwise
    // the travel direction chases a number that keeps running away and the horse
    // ends up pointing one way while moving another, permanently.
    r.heading = norm(r.heading);
    if (r._dir === undefined) r._dir = r.heading;
    var _d = norm(r.heading - r._dir);
    r._dir = norm(r._dir + _d * Math.min(1, GRIP * dt));
    var nx = r.x + Math.cos(r._dir) * r.speed * dt * 1.8;
    var ny = r.y + Math.sin(r._dir) * r.speed * dt * 1.8;
    r.x = nx; r.y = ny;
    if (!(r.air > 0 || onTrack(nx, ny))) r.speed *= Math.pow(0.9, dt);
    var curAng = Math.atan2(r.y - CY, r.x - CX);
    var dA = curAng - r.prevAng;
    while (dA > Math.PI) dA -= Math.PI * 2;
    while (dA < -Math.PI) dA += Math.PI * 2;
    r.progress += dA;
    r.prevAng = curAng;
    var lapsDone = Math.floor(r.progress / (Math.PI * 2));
    if (lapsDone > r.lap) {
      r.lap = lapsDone;
      if (r.lap >= LAPS && !r.finished) {
        r.finished = true; r.finishTime = R.elapsed;
        R.places += 1; r.place = R.places;
      }
    }
    if (r.hitCooldown <= 0 && r.air <= 0) {
      for (var k = 0; k < FEATURES.length; k++) {
        var p = featurePos(FEATURES[k]);
        if (Math.hypot(r.x - p.x, r.y - p.y) < 20) {
          if (FEATURES[k].type === "ramp") { r.air = 16; r.boost = Math.min(1, r.boost + 0.4); r.hitCooldown = 16; }
          else { r.speed *= 0.4; r.hitCooldown = 20; }
          break;
        }
      }
    }
  }
  function finishTheRace(R, me) {
    var timeMs = Math.round(me.finishTime);
    var placed = me.place;
    var beatRecord = timeMs < global.raceRecordMs;
    var goldByPlace = { 1: 250, 2: 140, 3: 75, 4: 0 };
    var gold = (placed in goldByPlace) ? goldByPlace[placed] : 0;
    var item = beatRecord ? RECORD_ITEM : null;
    if (beatRecord) global.raceRecordMs = timeMs;
    R.result = { finished: true, placed: placed, timeMs: timeMs, beatRecord: beatRecord, gold: gold, item: item, horse: HORSES[R.chosenIdx].id };
    R.phase = "finish";
  }
  function render(ctx, R) {
    var chosen = HORSES[R.chosenIdx].id;
    ctx.fillStyle = C.grassDark; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = C.grass;
    for (var i = 0; i < 60; i++) { var gx = (i * 137) % W, gy = (i * 211) % H; if (!onTrack(gx, gy)) ctx.fillRect(gx, gy, 6, 4); }
    ctx.save(); ctx.beginPath();
    ctx.ellipse(CX, CY, RX_OUT, RY_OUT, 0, 0, Math.PI * 2);
    ctx.ellipse(CX, CY, RX_IN, RY_IN, 0, 0, Math.PI * 2);
    ctx.fillStyle = C.track; ctx.fill("evenodd"); ctx.restore();
    ctx.lineWidth = 8; ctx.strokeStyle = C.trackEdge;
    ctx.beginPath(); ctx.ellipse(CX, CY, RX_OUT, RY_OUT, 0, 0, Math.PI * 2); ctx.stroke();
    ctx.beginPath(); ctx.ellipse(CX, CY, RX_IN, RY_IN, 0, 0, Math.PI * 2); ctx.stroke();
    for (var j = 0; j < 48; j++) { var a = (j / 48) * Math.PI * 2; ctx.fillStyle = j % 2 ? C.blood : C.white; ctx.fillRect(CX + Math.cos(a) * RX_IN - 5, CY + Math.sin(a) * RY_IN - 5, 10, 10); }
    drawStartLine(ctx);
    for (var f = 0; f < FEATURES.length; f++) { var p = featurePos(FEATURES[f]); if (FEATURES[f].type === "rock") drawRock(ctx, p.x, p.y); else drawRamp(ctx, p.x, p.y); }
    drawCastle(ctx, CX, CY);
    var ordered = R.racers.slice().sort(function (a, b) { return (a.isPlayer ? 1 : 0) - (b.isPlayer ? 1 : 0); });
    for (var m = 0; m < ordered.length; m++) drawHorse(ctx, ordered[m], R.anim);
  }
  function renderChase(ctx, R) {
    var chosen = HORSES[R.chosenIdx].id;
    var me = playerOf(R);
    var hx = Math.cos(me.heading), hy = Math.sin(me.heading);
    var camX = me.x - hx * CAM_BACK; var camY = me.y - hy * CAM_BACK;
    var cam = { x: camX, y: camY, fx: hx, fy: hy, h: CAM_HEIGHT };
    if(!renderChase._sky || renderChase._skyH!==HORIZON){ renderChase._skyH=HORIZON;
      renderChase._sky=ctx.createLinearGradient(0, 0, 0, HORIZON);
      renderChase._sky.addColorStop(0, "#241a30"); renderChase._sky.addColorStop(1, "#4a3a5a"); }
    var sky = renderChase._sky;
    ctx.fillStyle = sky; ctx.fillRect(0, 0, W, HORIZON);
    drawHorizonCastle(ctx, me.heading);
    ctx.fillStyle = C.grassDark; ctx.fillRect(0, HORIZON, W, H - HORIZON);
    function project(wx, wy) {
      var dx = wx - cam.x, dy = wy - cam.y;
      var fwd = dx * cam.fx + dy * cam.fy;
      if (fwd < 6) return null;
      var right = dx * (-cam.fy) + dy * (cam.fx);
      var sx = W / 2 + (right / fwd) * FOCAL;
      var sy = HORIZON + (cam.h / fwd) * FOCAL;
      var scale = FOCAL / fwd;
      return { sx: sx, sy: sy, scale: scale, fwd: fwd };
    }
    var SEG = 120; var pts = [];
    for (var i = 0; i <= SEG; i++) {
      var a = (i / SEG) * Math.PI * 2;
      pts.push({ o: project(CX + Math.cos(a) * RX_OUT, CY + Math.sin(a) * RY_OUT), iN: project(CX + Math.cos(a) * RX_IN, CY + Math.sin(a) * RY_IN), a: a });
    }
    var A, B;
    for (i = 0; i < SEG; i++) {
      A = pts[i]; B = pts[i + 1];
      if (!A.o || !B.o || !A.iN || !B.iN) continue;
      ctx.fillStyle = (i % 2 === 0) ? C.track : "#5e4c36";
      ctx.beginPath(); ctx.moveTo(A.o.sx, A.o.sy); ctx.lineTo(B.o.sx, B.o.sy); ctx.lineTo(B.iN.sx, B.iN.sy); ctx.lineTo(A.iN.sx, A.iN.sy); ctx.closePath(); ctx.fill();
    }
    for (i = 0; i < SEG; i++) {
      A = pts[i]; B = pts[i + 1];
      if (!A.iN || !B.iN) continue;
      ctx.strokeStyle = i % 2 ? C.blood : C.white; ctx.lineWidth = Math.max(1, A.iN.scale * 8);
      ctx.beginPath(); ctx.moveTo(A.iN.sx, A.iN.sy); ctx.lineTo(B.iN.sx, B.iN.sy); ctx.stroke();
    }
    ctx.strokeStyle = C.trackEdge;
    for (i = 0; i < SEG; i++) {
      A = pts[i]; B = pts[i + 1];
      if (!A.o || !B.o) continue;
      ctx.lineWidth = Math.max(1, A.o.scale * 8);
      ctx.beginPath(); ctx.moveTo(A.o.sx, A.o.sy); ctx.lineTo(B.o.sx, B.o.sy); ctx.stroke();
    }
    drawChaseStartLine(ctx, project);
    var feats = [];
    for (i = 0; i < FEATURES.length; i++) { var fp = featurePos(FEATURES[i]); var pr = project(fp.x, fp.y); if (pr) feats.push({ f: FEATURES[i], pr: pr }); }
    feats.sort(function (x, y) { return y.pr.fwd - x.pr.fwd; });
    for (i = 0; i < feats.length; i++) { if (feats[i].f.type === "rock") drawRockBillboard(ctx, feats[i].pr); else drawRampBillboard(ctx, feats[i].pr); }
    var others = [];
    for (i = 0; i < R.racers.length; i++) { if (R.racers[i].isPlayer) continue; var opr = project(R.racers[i].x, R.racers[i].y); if (opr) others.push({ r: R.racers[i], pr: opr }); }
    others.sort(function (x, y) { return y.pr.fwd - x.pr.fwd; });
    for (i = 0; i < others.length; i++) drawHorseBillboard(ctx, others[i].pr, others[i].r);
    drawPlayerChase(ctx, me, chosen, R.anim);
  }
  function drawChaseStartLine(ctx, project) {
    var a = -Math.PI / 2;
    var ox = CX + Math.cos(a) * RX_OUT, oy = CY + Math.sin(a) * RY_OUT;
    var ix = CX + Math.cos(a) * RX_IN, iy = CY + Math.sin(a) * RY_IN;
    var a2 = a + 0.05;
    var o2x = CX + Math.cos(a2) * RX_OUT, o2y = CY + Math.sin(a2) * RY_OUT;
    var i2x = CX + Math.cos(a2) * RX_IN, i2y = CY + Math.sin(a2) * RY_IN;
    var P = [project(ox, oy), project(ix, iy), project(i2x, i2y), project(o2x, o2y)];
    if (!P[0] || !P[1] || !P[2] || !P[3]) return;
    var steps = 8;
    function lerp(Aa, Bb, t) { return { sx: Aa.sx + (Bb.sx - Aa.sx) * t, sy: Aa.sy + (Bb.sy - Aa.sy) * t }; }
    for (var k = 0; k < steps; k++) {
      var t0 = k / steps, t1 = (k + 1) / steps;
      var f0 = lerp(P[0], P[1], t0), f1 = lerp(P[0], P[1], t1);
      var b0 = lerp(P[3], P[2], t0), b1 = lerp(P[3], P[2], t1);
      ctx.fillStyle = k % 2 ? C.white : C.shadow;
      ctx.beginPath(); ctx.moveTo(f0.sx, f0.sy); ctx.lineTo(f1.sx, f1.sy); ctx.lineTo(b1.sx, b1.sy); ctx.lineTo(b0.sx, b0.sy); ctx.closePath(); ctx.fill();
    }
  }
  function drawRockBillboard(ctx, pr) {
    var s = pr.scale; var w = 40 * s, h = 34 * s; var x = pr.sx, y = pr.sy;
    ctx.fillStyle = "rgba(0,0,0,0.3)"; ctx.beginPath(); ctx.ellipse(x, y, w * 0.5, h * 0.18, 0, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = C.rock; ctx.beginPath();
    ctx.moveTo(x - w * 0.5, y); ctx.lineTo(x - w * 0.25, y - h * 0.9); ctx.lineTo(x + w * 0.28, y - h * 0.85); ctx.lineTo(x + w * 0.5, y - h * 0.1); ctx.lineTo(x + w * 0.15, y); ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#7a7484"; ctx.fillRect(x - w * 0.15, y - h * 0.55, w * 0.22, h * 0.18);
  }
  function drawRampBillboard(ctx, pr) {
    var s = pr.scale; var w = 56 * s, h = 26 * s; var x = pr.sx, y = pr.sy;
    ctx.fillStyle = C.goldDim; ctx.beginPath();
    ctx.moveTo(x - w * 0.5, y); ctx.lineTo(x + w * 0.5, y); ctx.lineTo(x + w * 0.35, y - h); ctx.lineTo(x - w * 0.35, y - h); ctx.closePath(); ctx.fill();
    ctx.fillStyle = C.gold; ctx.fillRect(x - w * 0.35, y - h, w * 0.7, Math.max(2, 4 * s));
    ctx.fillStyle = C.white;
    for (var i = 0; i < 2; i++) { var yy = y - h * (0.35 + i * 0.3); ctx.beginPath(); ctx.moveTo(x, yy - 4 * s); ctx.lineTo(x - 6 * s, yy + 2 * s); ctx.lineTo(x + 6 * s, yy + 2 * s); ctx.closePath(); ctx.fill(); }
  }
  function drawHorseBillboard(ctx, pr, r) {
    var s = pr.scale * 1.5; var x = pr.sx, y = pr.sy;
    if (s < 0.05) return;
    ctx.fillStyle = "rgba(0,0,0,0.3)"; ctx.beginPath(); ctx.ellipse(x, y, 18 * s, 6 * s, 0, 0, Math.PI * 2); ctx.fill();
    function px(bx, by, bw, bh, col) { ctx.fillStyle = col; ctx.fillRect(x + bx * s, y + by * s, bw * s, bh * s); }
    px(-12, -22, 24, 18, r.color); px(-6, -34, 12, 14, r.color); px(-7, -22, 14, 5, r.mane);
    px(-10, -4, 5, 6, r.mane); px(5, -4, 5, 6, r.mane); px(-5, -40, 10, 10, C.blood); px(-3, -46, 6, 6, "#e0c8a0");
  }
  function drawPlayerChase(ctx, me, chosen, anim) {
    var baseX = W / 2; var baseY = H - 56;
    var gallop = Math.sin(anim / 80) * 3;
    var lift = me.air > 0 ? me.air * 2.2 : 0;
    var y = baseY - lift - Math.abs(gallop);
    var turnLean = clamp((me._lean || 0), -10, 10);
    var s = 2.0;
    ctx.fillStyle = "rgba(0,0,0,0.35)"; ctx.beginPath(); ctx.ellipse(baseX, baseY + 6, 40 - lift * 0.3, 12 - lift * 0.1, 0, 0, Math.PI * 2); ctx.fill();
    var h = horseById(chosen);
    function px(bx, by, bw, bh, col) { ctx.fillStyle = col; ctx.fillRect(baseX + (bx + turnLean) * s, y + by * s, bw * s, bh * s); }
    px(-16, -10, 32, 22, h.color); px(-12, 12, 9, 12, h.mane); px(3, 12, 9, 12, h.mane);
    px(-10, -14, 20, 6, h.mane); px(-3, -20, 6, 14, h.mane); px(-7, -30, 14, 14, h.color);
    px(-9, -30, 4, 16, h.mane); px(5, -30, 4, 16, h.mane); px(-7, -40, 14, 16, C.blood);
    px(-4, -50, 8, 10, "#e0c8a0"); px(-5, -54, 10, 5, C.gold);
    if (me.boost > 0.15) { ctx.save(); ctx.globalAlpha = me.boost * 0.5; ctx.fillStyle = C.gold; ctx.beginPath(); ctx.ellipse(baseX, y + 20, 30, 10, 0, 0, Math.PI * 2); ctx.fill(); ctx.restore(); }
  }
  function drawHorizonCastle(ctx, heading) {
    var shift = (Math.cos(heading) * 0.5 + 0.5) * 200 - 100;
    var cx = W * 0.5 + shift; var base = HORIZON;
    ctx.fillStyle = "#1d1528"; ctx.beginPath();
    ctx.moveTo(0, base); ctx.quadraticCurveTo(W * 0.3, base - 30, W * 0.6, base - 8); ctx.quadraticCurveTo(W * 0.85, base - 36, W, base - 6);
    ctx.lineTo(W, base); ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#241a30"; ctx.fillRect(cx - 40, base - 46, 80, 46);
    for (var i = -2; i <= 2; i++) ctx.fillRect(cx + i * 16 - 5, base - 56, 10, 12);
    ctx.fillRect(cx - 56, base - 60, 18, 60); ctx.fillRect(cx + 40, base - 60, 18, 60);
    ctx.fillStyle = C.blood; ctx.fillRect(cx - 1, base - 74, 3, 16); ctx.fillRect(cx + 2, base - 74, 12, 8);
  }
  function drawStartLine(ctx) {
    var x = CX, yTop = CY - RY_OUT, yBot = CY - RY_IN;
    var cols = 6, rows = 5; var w = 70, h = (yBot - yTop);
    for (var cI = 0; cI < cols; cI++) for (var rI = 0; rI < rows; rI++) { ctx.fillStyle = (cI + rI) % 2 ? C.white : C.shadow; ctx.fillRect(x - w / 2 + (cI * w) / cols, yTop + (rI * h) / rows, w / cols, h / rows); }
    ctx.fillStyle = C.gold; ctx.fillRect(x - w / 2 - 10, yTop - 14, 8, h + 28); ctx.fillRect(x + w / 2 + 2, yTop - 14, 8, h + 28);
    ctx.fillStyle = C.blood; ctx.fillRect(x - 86, yTop - 34, 172, 22);
    ctx.fillStyle = C.gold; ctx.fillRect(x - 86, yTop - 34, 172, 3);
    ctx.fillStyle = C.white; ctx.font = "bold 15px Georgia"; ctx.textAlign = "center"; ctx.fillText("START / FINISH", x, yTop - 18);
  }
  function drawHorse(ctx, r, anim) {
    ctx.save(); ctx.translate(r.x, r.y - r.air * 1.5); ctx.rotate(r.heading);
    var s = r.isPlayer ? 1.15 : 1.0;
    ctx.save(); ctx.rotate(-r.heading); ctx.translate(0, r.air * 1.5);
    ctx.fillStyle = "rgba(0,0,0,0.3)"; ctx.beginPath(); ctx.ellipse(0, 8 * s, 16 * s, 7 * s, 0, 0, Math.PI * 2); ctx.fill(); ctx.restore();
    function px(x, y, w, h, col) { ctx.fillStyle = col; ctx.fillRect(x * s, y * s, w * s, h * s); }
    px(-14, -7, 24, 14, r.color); px(8, -6, 12, 12, r.color); px(16, -5, 9, 9, r.color);
    px(6, -8, 6, 16, r.mane); px(-16, -8, 5, 5, r.mane); px(-12, 6, 4, 6, r.mane); px(4, 6, 4, 6, r.mane);
    px(-12, -12, 4, 6, r.mane); px(4, -12, 4, 6, r.mane);
    // ── THE RIDER ── _legacy: px(-6,-6,10,12,C.blood); px(-3,-4,6,6,"#e0c8a0");
    //   px(-4,-8,8,4,C.gold);  — a rectangle rider: a body, a face square and a
    //   gold hat. The game has a full character renderer with facing, walk frames
    //   and your equipped weapon, and the race never referenced it. It is YOUR
    //   knight in the saddle now, with the blade you are actually carrying.
    if (r.isPlayer) {
      ctx.save();
      ctx.rotate(-r.heading);                       // he sits upright, the horse turns
      ctx.translate(-8*s, -22*s);
      ctx.scale(s*0.95, s*0.95);
      var _wp = (player.equip && player.equip.weapon) || null;
      var _fr = (Math.floor(anim*2)%4);             // his legs move with the gallop
      try { drawKnightBody(0, 0, 'right', _fr, 0, 0, false, _wp); }
      catch(e){ px(-6,-6,10,12,C.blood); px(-3,-4,6,6,"#e0c8a0"); }
      ctx.restore();
    }
    ctx.fillStyle = r.boost > 0.1 ? C.gold : "#120c10"; ctx.fillRect(20 * s, -3 * s, 3 * s, 3 * s); ctx.restore();
    if (r.boost > 0.15) { ctx.save(); ctx.globalAlpha = r.boost * 0.5; ctx.fillStyle = C.gold; ctx.beginPath(); ctx.arc(r.x - Math.cos(r.heading) * 22, r.y - Math.sin(r.heading) * 22, 6, 0, Math.PI * 2); ctx.fill(); ctx.restore(); }
  }
  function drawRock(ctx, x, y) {
    ctx.fillStyle = C.rock; ctx.beginPath();
    ctx.moveTo(x - 18, y + 6); ctx.lineTo(x - 8, y - 14); ctx.lineTo(x + 9, y - 12); ctx.lineTo(x + 18, y + 2); ctx.lineTo(x + 6, y + 12); ctx.lineTo(x - 10, y + 12); ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#7a7484"; ctx.fillRect(x - 6, y - 8, 8, 5);
  }
  function drawRamp(ctx, x, y) {
    ctx.fillStyle = C.goldDim; ctx.beginPath(); ctx.ellipse(x, y, 24, 16, 0, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = C.gold; for (var i = -2; i <= 2; i++) ctx.fillRect(x - 18, y + i * 6 - 2, 36, 3);
    ctx.fillStyle = C.white; ctx.font = "bold 14px Georgia"; ctx.textAlign = "center"; ctx.fillText("\u2934", x, y + 5);
  }
  function drawCastle(ctx, x, y) {
    ctx.fillStyle = "#1d1528"; ctx.fillRect(x - 70, y - 35, 140, 70);
    ctx.fillStyle = "#241a30"; for (var i = -3; i <= 3; i++) ctx.fillRect(x + i * 20 - 7, y - 48, 14, 16);
    ctx.fillRect(x - 90, y - 50, 30, 100); ctx.fillRect(x + 60, y - 50, 30, 100);
    ctx.fillStyle = C.blood; ctx.fillRect(x - 2, y - 75, 4, 22); ctx.fillRect(x + 2, y - 75, 20, 12);
  }
  function drawHeader(ctx) {
    ctx.fillStyle = C.panelLight; ctx.fillRect(0, 0, W, 64);
    ctx.fillStyle = C.goldDim; ctx.fillRect(0, 64, W, 2);
    ctx.textAlign = "left"; ctx.fillStyle = C.gold; ctx.font = "bold 26px Georgia"; ctx.fillText("The King's Tourney", 24, 34);
    ctx.fillStyle = C.inkDim; ctx.font = "13px Georgia"; ctx.fillText("Ride for crown and glory  \u00b7  " + LAPS + " laps", 24, 54);
    ctx.textAlign = "right"; ctx.fillStyle = C.inkDim; ctx.font = "11px Georgia"; ctx.fillText("COURSE RECORD", W - 24, 28);
    ctx.fillStyle = C.ink; ctx.font = "bold 20px Georgia"; ctx.fillText(fmt(global.raceRecordMs), W - 24, 52);
    ctx.textAlign = "left";
  }
  function drawSelect(ctx, R) {
    ctx.fillStyle = C.panel; ctx.fillRect(0, 0, W, H); drawHeader(ctx);
    ctx.textAlign = "center"; ctx.fillStyle = C.gold; ctx.font = "bold 18px Georgia"; ctx.fillText("CHOOSE YOUR STEED", CX, 104);
    var cardW = 430, cardH = 210, gap = 24;
    var gridW = cardW * 2 + gap, gridH = cardH * 2 + gap;
    var ox = CX - gridW / 2, oy = 130;
    for (var idx = 0; idx < HORSES.length; idx++) {
      var col = idx % 2, row = Math.floor(idx / 2);
      var cx = ox + col * (cardW + gap); var cy = oy + row * (cardH + gap);
      var active = idx === R.chosenIdx;
      drawHorseCard(ctx, HORSES[idx], cx, cy, cardW, cardH, active, R.anim);
    }
    drawButton(ctx, CX - 220, oy + gridH + 24, 200, 50, "\u25c0  \u25b6  Change", false);
    drawButton(ctx, CX + 20, oy + gridH + 24, 200, 50, "A  Take to the Gate", true);
    ctx.textAlign = "center"; ctx.fillStyle = C.inkDim; ctx.font = "12px Georgia"; ctx.fillText("B  \u00b7  Leave the tourney", CX, oy + gridH + 96);
    ctx.textAlign = "left";
  }
  function drawHorseCard(ctx, h, x, y, w, hgt, active, anim) {
    ctx.fillStyle = active ? C.panelLight : C.bg; roundRect(ctx, x, y, w, hgt, 6); ctx.fill();
    ctx.lineWidth = active ? 3 : 1; ctx.strokeStyle = active ? C.gold : C.trackEdge; roundRect(ctx, x, y, w, hgt, 6); ctx.stroke();
    ctx.save(); ctx.translate(x + 70, y + 60);
    (function () {
      var s = 1.6;
      function px(bx, by, bw, bh, col) { ctx.fillStyle = col; ctx.fillRect(bx * s, by * s, bw * s, bh * s); }
      ctx.fillStyle = "rgba(0,0,0,0.25)"; ctx.beginPath(); ctx.ellipse(0, 10 * s, 16 * s, 6 * s, 0, 0, Math.PI * 2); ctx.fill();
      px(-14, -7, 24, 14, h.color); px(8, -6, 12, 12, h.color); px(16, -5, 9, 9, h.color);
      px(6, -8, 6, 16, h.mane); px(-16, -8, 5, 5, h.mane); px(-12, 6, 4, 6, h.mane); px(4, 6, 4, 6, h.mane);
      ctx.fillStyle = "#120c10"; ctx.fillRect(20 * s, -3 * s, 3 * s, 3 * s);
    })();
    ctx.restore();
    ctx.textAlign = "left"; ctx.fillStyle = C.gold; ctx.font = "bold 22px Georgia"; ctx.fillText(h.name, x + 130, y + 44);
    ctx.fillStyle = C.inkDim; ctx.font = "13px Georgia"; wrapText(ctx, h.blurb, x + 130, y + 68, w - 150, 17);
    var rows = [ { label: "SPD", v: (h.topSpeed - 3.1) / 0.5 }, { label: "ACC", v: (h.accel - 0.05) / 0.025 }, { label: "HND", v: (h.handling - 0.065) / 0.03 } ];
    var by = y + 110;
    for (var i = 0; i < rows.length; i++) {
      var ry = by + i * 28;
      ctx.fillStyle = C.inkDim; ctx.font = "12px Georgia"; ctx.fillText(rows[i].label, x + 20, ry + 12);
      var tx = x + 64, tw = w - 90, th = 10;
      ctx.fillStyle = C.trackEdge; roundRect(ctx, tx, ry + 2, tw, th, 5); ctx.fill();
      var fillW = Math.max(8, Math.min(1, rows[i].v) * tw);
      var grad = ctx.createLinearGradient(tx, 0, tx + tw, 0); grad.addColorStop(0, C.goldDim); grad.addColorStop(1, C.gold);
      ctx.fillStyle = grad; roundRect(ctx, tx, ry + 2, fillW, th, 5); ctx.fill();
    }
  }
  function drawHud(ctx, R) {
    var me = playerOf(R);
    var myProg = me.progress; var pos = 1;
    for (var i = 0; i < R.racers.length; i++) if (R.racers[i].progress > myProg) pos++;
    var ordWords = ["", "1st", "2nd", "3rd", "4th"]; var ord = ordWords[pos] || (pos + "th");
    ctx.textAlign = "left"; ctx.fillStyle = C.gold; ctx.font = "bold 44px Georgia"; ctx.strokeStyle = C.shadow; ctx.lineWidth = 3;
    ctx.strokeText(ord, 20, 54); ctx.fillText(ord, 20, 54);
    ctx.fillStyle = C.white; ctx.font = "bold 22px Georgia";
    var lapTxt = "LAP " + Math.min(LAPS, me.lap + 1) + "/" + LAPS;
    ctx.strokeText(lapTxt, 120, 50); ctx.fillText(lapTxt, 120, 50);
    ctx.textAlign = "right"; ctx.fillStyle = C.ink; ctx.font = "bold 24px Georgia";
    ctx.strokeText(fmt(R.elapsed), W - 20, 50); ctx.fillText(fmt(R.elapsed), W - 20, 50);
    ctx.fillStyle = C.gold; ctx.font = "bold 14px Georgia"; ctx.fillText(R.view === "chase" ? "A \u00b7 Top View" : "A \u00b7 Chase View", W - 20, 80);
    ctx.textAlign = "left";
  }
  function drawCountdown(ctx, R) {
    ctx.textAlign = "center"; ctx.fillStyle = C.gold; ctx.font = "bold 160px Georgia"; ctx.strokeStyle = C.shadow; ctx.lineWidth = 6;
    var txt = R.countdown > 0 ? String(R.countdown) : "RIDE!";
    ctx.strokeText(txt, CX, CY + 40); ctx.fillText(txt, CX, CY + 40); ctx.textAlign = "left";
  }
  function drawFinish(ctx, R) {
    var res = R.result;
    ctx.fillStyle = C.panel; ctx.fillRect(0, 0, W, H); drawHeader(ctx);
    ctx.textAlign = "center"; ctx.font = "70px Georgia"; ctx.fillStyle = C.ink; ctx.fillText(res.placed <= 3 ? "\ud83c\udfc6" : "\ud83d\udc0e", CX, 150);
    var placeStr = res.placed <= 3 ? (["", "1st", "2nd", "3rd"][res.placed] + " Place") : "Finished";
    ctx.fillStyle = C.gold; ctx.font = "bold 40px Georgia"; ctx.fillText(placeStr, CX, 210);
    var placeWord = ["", "Champion", "Second", "Third", "Also-ran"][res.placed] || "Unplaced";
    ctx.fillStyle = C.ink; ctx.font = "italic 18px Georgia"; ctx.fillText(placeWord, CX, 240);
    ctx.fillStyle = C.inkDim; ctx.font = "16px Georgia"; ctx.fillText("Time  \u00b7  " + fmt(res.timeMs), CX, 274);
    var bx = CX - 230, by = 300, bw = 460, bh = 150;
    ctx.fillStyle = C.bg; roundRect(ctx, bx, by, bw, bh, 6); ctx.fill();
    ctx.strokeStyle = C.goldDim; ctx.lineWidth = 1; roundRect(ctx, bx, by, bw, bh, 6); ctx.stroke();
    ctx.textAlign = "left"; ctx.fillStyle = C.ink; ctx.font = "17px Georgia"; ctx.fillText("Prize purse", bx + 24, by + 38);
    ctx.textAlign = "right"; ctx.fillStyle = C.gold; ctx.font = "bold 17px Georgia"; ctx.fillText(res.gold + " gold", bx + bw - 24, by + 38);
    ctx.textAlign = "center";
    if (res.beatRecord) {
      ctx.fillStyle = C.gold; ctx.font = "bold 18px Georgia"; ctx.fillText("\u2726  NEW COURSE RECORD  \u2726", CX, by + 84);
      ctx.fillStyle = C.white; ctx.font = "italic 16px Georgia"; ctx.fillText("Reward: " + res.item, CX, by + 112);
    } else {
      ctx.fillStyle = C.inkDim; ctx.font = "italic 14px Georgia"; ctx.fillText("Course record stands. Ride faster for the", CX, by + 86);
      ctx.fillStyle = C.gold; ctx.font = "italic 14px Georgia"; ctx.fillText(RECORD_ITEM + ".", CX, by + 108);
    }
    ctx.textAlign = "left";
    drawButton(ctx, CX - 230, 478, 220, 56, "A  Claim & Return", true);
    drawButton(ctx, CX + 10, 478, 220, 56, "B  Race Again", false);
  }
  function drawButton(ctx, x, y, w, h, label, primary) {
    ctx.fillStyle = primary ? C.blood : "rgba(36,26,46,0.6)"; roundRect(ctx, x, y, w, h, 5); ctx.fill();
    ctx.lineWidth = 1; ctx.strokeStyle = primary ? C.bloodLit : C.goldDim; roundRect(ctx, x, y, w, h, 5); ctx.stroke();
    ctx.textAlign = "center"; ctx.fillStyle = primary ? C.white : C.ink; ctx.font = "bold 16px Georgia"; ctx.fillText(label, x + w / 2, y + h / 2 + 6); ctx.textAlign = "left";
  }
  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath(); ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r); ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
  }
  function wrapText(ctx, text, x, y, maxW, lh) {
    var words = text.split(" "); var line = "", yy = y;
    for (var n = 0; n < words.length; n++) {
      var test = line + words[n] + " ";
      if (ctx.measureText(test).width > maxW && n > 0) { ctx.fillText(line, x, yy); line = words[n] + " "; yy += lh; }
      else line = test;
    }
    ctx.fillText(line, x, yy);
  }
  function drawRace(ctx, canvasW, canvasH) {
    var R = global.race;
    if (!R) return;
    if (typeof canvasW !== "number") canvasW = W;
    if (typeof canvasH !== "number") canvasH = H;
    var scale = Math.min(canvasW / W, canvasH / H);
    var dx = (canvasW - W * scale) / 2; var dy = (canvasH - H * scale) / 2;
    ctx.save();
    ctx.fillStyle = "#000"; ctx.fillRect(0, 0, canvasW, canvasH);
    ctx.translate(dx, dy); ctx.scale(scale, scale);
    ctx.beginPath(); ctx.rect(0, 0, W, H); ctx.clip();
    if (R.phase === "select") { drawSelect(ctx, R); }
    else if (R.phase === "finish") { drawFinish(ctx, R); }
    else {
      if (R.view === "chase") renderChase(ctx, R); else render(ctx, R);
      if (R.phase === "race") drawHud(ctx, R);
      if (R.phase === "countdown") drawCountdown(ctx, R);
    }
    ctx.restore();
  }
  global.startRace = startRace;
  global.raceTick = raceTick;
  global.drawRace = drawRace;
  global.racePress = racePress;
  global.raceHold = raceHold;
  global.exitRace = exitRace;
})(typeof window !== "undefined" ? window : this);

// ════ THE REGATTA — boat race minigame module (vanilla-JS port) ════
/* =====================================================================
 * THE REGATTA — Boat Race minigame (vanilla-JS port of BoatRaceMinigame.jsx)
 * Full 5-screen port: DOCK -> SHOP -> SEA MAP -> 3rd-person RACE -> RESULTS.
 *
 * INTEGRATION CONTRACT (mirrors the horse-race port):
 *   openBoatRace({ gold, inv, onClose })   // gold = KLK's main gold (number)
 *     inv  : persisted boat parts  { owned:[ids], equipped:{slot:id}, difficulty, course }
 *     onClose(payload): called when the player leaves the dock; payload = {
 *        goldDelta,        // net change to apply to KLK gold (winnings - purchases)
 *        inv,             // updated boat-parts inventory to persist on player.boatInv
 *     }
 *   Globals exposed: openBoatRace, boatTick, drawBoat, boatPress, boatPointer, boat
 *
 * Render: fixed virtual canvas BW x BH, letterboxed by drawBoat(ctx,cw,ch) exactly
 * like drawRace. All screens draw into the same virtual space. Pointer/keys are
 * mapped back into virtual coordinates so on-canvas buttons work on touch.
 * ===================================================================== */
(function (global) {
  'use strict';

  // ---- gothic palette (from the JSX) ----
  var PAL = {
    sky: "#13243a", skyLow: "#27506b", sun: "#d9a531",
    deepSea: "#0b1a2b", sea: "#143a52", seaLight: "#1d5a73", foam: "#cfeeee",
    hull: "#6b3a23", hullDark: "#3f2113", sail: "#e8e0cf", sailShade: "#c9bfa6",
    gold: "#d9a531", goldDark: "#8a6418", blood: "#7a1f1f", ink: "#06101c",
    parchment: "#e8e0cf", buoy: "#c23b22", panel: "#0e2032", panelEdge: "#274a63",
    rival: ["#5a7a8a", "#7a5a8a", "#8a7a5a", "#5a8a6a"]
  };

  // ---- customization catalog ----
  var CATALOG = [
    { id: "hull_oak",     slot: "hull",   name: "Oak Hull",         cost: 0,   source: "shop", color: "#6b3a23", stats: {},                desc: "Standard fisher's hull." },
    { id: "hull_pitch",   slot: "hull",   name: "Pitch-Black Hull", cost: 220, source: "shop", color: "#2a2a30", stats: { handling: 0.1 }, desc: "Tarred and trim." },
    { id: "hull_ivory",   slot: "hull",   name: "Ivory Hull",       cost: 480, source: "shop", color: "#d8cdab", stats: { handling: 0.2 }, desc: "Carved bone-white planking." },
    { id: "hull_crimson", slot: "hull",   name: "Crimson Reaver",   cost: 0,   source: "race", color: "#7a1f1f", stats: { handling: 0.25 },desc: "Won, not bought." },

    { id: "sail_plain",   slot: "sail",   name: "Plain Canvas",     cost: 0,   source: "shop", color: "#e8e0cf",               stats: {},            desc: "Honest linen." },
    { id: "sail_cross",   slot: "sail",   name: "Crusader Cross",   cost: 180, source: "shop", color: "#e8e0cf", mark: "cross",stats: { speed: 4 },  desc: "Blood cross on white." },
    { id: "sail_gold",    slot: "sail",   name: "Gilded Sail",      cost: 520, source: "shop", color: "#e8d08a",               stats: { speed: 9 },  desc: "Threaded with gold." },
    { id: "sail_storm",   slot: "sail",   name: "Stormcaller",      cost: 0,   source: "race", color: "#3a4a66", mark: "bolt", stats: { speed: 14 }, desc: "Catches wind others can't." },

    { id: "fig_none",     slot: "figure", name: "No Figurehead",    cost: 0,   source: "shop", stats: {},            desc: "Bare prow." },
    { id: "fig_lamb",     slot: "figure", name: "Lamb of Light",    cost: 260, source: "shop", stats: { accel: 8 },  desc: "Carved white lamb." },
    { id: "fig_lion",     slot: "figure", name: "Lion of Judah",    cost: 0,   source: "race", stats: { accel: 16 }, desc: "Roaring gilded lion." },
    { id: "fig_dove",     slot: "figure", name: "Descending Dove",  cost: 0,   source: "race", stats: { accel: 13, handling: 0.15 }, desc: "Won at Mistral Isle." },

    { id: "eng_oar",      slot: "engine", name: "Twin Oars",        cost: 0,   source: "shop", stats: {},                       desc: "Just muscle." },
    { id: "eng_lateen",   slot: "engine", name: "Lateen Rig",       cost: 340, source: "shop", stats: { speed: 10, accel: 10 }, desc: "Better wind angles." },
    { id: "eng_double",   slot: "engine", name: "Double Mast",      cost: 700, source: "shop", stats: { speed: 22, accel: 14 }, desc: "Twice the canvas." },
    { id: "eng_galley",   slot: "engine", name: "Pilgrim Galley",   cost: 0,   source: "race", stats: { speed: 26, accel: 20 }, desc: "Won at Mount Tabor." },

    { id: "keel_flat",    slot: "keel",   name: "Flat Keel",        cost: 0,   source: "shop", stats: {},                 desc: "Stable, sluggish turns." },
    { id: "keel_fin",     slot: "keel",   name: "Fin Keel",         cost: 300, source: "shop", stats: { handling: 0.45 }, desc: "Bites the water." },
    { id: "keel_blade",   slot: "keel",   name: "Bladed Keel",      cost: 0,   source: "race", stats: { handling: 0.7 },  desc: "Turns on a coin." }
  ];

  var SLOTS = ["hull", "sail", "figure", "engine", "keel"];
  var DEFAULT_EQUIP = { hull: "hull_oak", sail: "sail_plain", figure: "fig_none", engine: "eng_oar", keel: "keel_flat" };
  var STARTERS = ["hull_oak", "sail_plain", "fig_none", "eng_oar", "keel_flat"];

  var HARBORS = {
    saltmere: {
      key:"saltmere", name: "Saltmere Harbor Run", laps: 2, length: 2600, wind: 0.0, feel: "easy bends", tier: 1,
      pos: { x: 500, y: 180 },
      curve: { amp: 0.55, waves: [{ a: 0.7, f: 0.0015 }, { a: 0.4, f: 0.0008, p: 1.2 }] },
      tint: { sky: "#13243a", skyLow: "#27506b", sea: "#1d5a73", deep: "#0b1a2b", sun: "#d9a531" },
      reward: ["sail_storm"]
    },
    capital: {
      key:"capital", name: "Capital Regatta", laps: 3, length: 3400, wind: 0.12, feel: "grand figure-eight", tier: 2,
      pos: { x: 470, y: 470 },
      curve: { amp: 0.8, waves: [{ a: 1.0, f: 0.0011, p: 0.4 }, { a: 0.45, f: 0.0026, p: 2.0 }] },
      tint: { sky: "#1a2238", skyLow: "#3a4a72", sea: "#2a4a6a", deep: "#10203a", sun: "#e8c860" },
      reward: ["fig_lion", "keel_blade"]
    },
    mistral: {
      key:"mistral", name: "Mistral Isle Dash", laps: 2, length: 2800, wind: 0.22, feel: "tight switchbacks", tier: 3,
      pos: { x: 230, y: 760 },
      curve: { amp: 1.05, waves: [{ a: 0.8, f: 0.0030, p: 0.5 }, { a: 0.6, f: 0.0014, p: 1.0 }] },
      tint: { sky: "#16323a", skyLow: "#2f6f73", sea: "#1d6b6b", deep: "#0b2424", sun: "#cfe0a0" },
      reward: ["fig_dove"]
    },
    tabor: {
      key:"tabor", name: "Mount Tabor Sweep", laps: 2, length: 3200, wind: 0.08, feel: "long sweeping arcs", tier: 4,
      pos: { x: 520, y: 820 },
      curve: { amp: 0.9, waves: [{ a: 1.2, f: 0.0009, p: 0.0 }, { a: 0.3, f: 0.0042, p: 1.5 }] },
      tint: { sky: "#2a2440", skyLow: "#5a4a78", sea: "#3a3a66", deep: "#161228", sun: "#e8d0a0" },
      reward: ["eng_galley"]
    },
    sunfall: {
      key:"sunfall", name: "Sunfall Atoll Spiral", laps: 2, length: 3000, wind: 0.18, feel: "technical spiral", tier: 5,
      pos: { x: 800, y: 780 },
      curve: { amp: 1.2, waves: [{ a: 0.9, f: 0.0022, p: 2.2 }, { a: 0.7, f: 0.0038, p: 0.3 }] },
      tint: { sky: "#3a2438", skyLow: "#8a4a5a", sea: "#7a4a52", deep: "#2a1420", sun: "#f0a050" },
      reward: ["hull_crimson"]
    }
  };
  var HARBOR_ORDER = ["saltmere", "capital", "mistral", "tabor", "sunfall"];

  var DIFFICULTY = {
    calm:      { key:"calm",      label: "Calm",      lo: 0.72, step: 0.035, goldMul: 0.8 },
    rough:     { key:"rough",     label: "Rough",     lo: 0.80, step: 0.040, goldMul: 1.0 },
    cutthroat: { key:"cutthroat", label: "Cutthroat", lo: 0.86, step: 0.045, goldMul: 1.5 }
  };
  var DIFF_ORDER = ["calm","rough","cutthroat"];

  // ---- virtual canvas ----
  var BW = 520, BH = 680;
  var TWO_PI = Math.PI * 2;
  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
  function byId(id) { for (var i=0;i<CATALOG.length;i++) if (CATALOG[i].id===id) return CATALOG[i]; return null; }
  function ordinal(n){ return n===1?"1st":n===2?"2nd":n===3?"3rd":n+"th"; }

  function curveAt(dist, spec) {
    if (!spec || !spec.waves) return 0;
    var v = 0;
    for (var i=0;i<spec.waves.length;i++){ var w=spec.waves[i]; v += Math.sin(dist*w.f + (w.p||0)) * w.a; }
    return v * spec.amp;
  }
  function buildTrackPath(length, spec) {
    var N = 240, stepD = length / N, raw = [];
    var x = 0, y = 0, heading = -Math.PI/2;
    for (var i=0;i<=N;i++){
      var d = i*stepD;
      heading += curveAt(d, spec) * 0.006 * stepD;
      x += Math.cos(heading)*stepD; y += Math.sin(heading)*stepD;
      raw.push({x:x,y:y});
    }
    var minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
    for (i=0;i<raw.length;i++){ var p=raw[i]; if(p.x<minX)minX=p.x; if(p.x>maxX)maxX=p.x; if(p.y<minY)minY=p.y; if(p.y>maxY)maxY=p.y; }
    var w=(maxX-minX)||1, h=(maxY-minY)||1;
    var scale=1/Math.max(w,h), pad=0.08, mx=Math.max(w,h);
    var pts = raw.map(function(p){
      return {
        nx: pad + (1-2*pad)*((p.x-minX)*scale + (mx-w)*scale/2),
        ny: pad + (1-2*pad)*((p.y-minY)*scale + (mx-h)*scale/2)
      };
    });
    return { pts: pts, N: N };
  }

  function deriveStats(equipped) {
    var base = { speed: 150, accel: 90, handling: 2.0 };
    for (var i=0;i<SLOTS.length;i++){
      var item = byId(equipped[SLOTS[i]]);
      if (item && item.stats){
        base.speed += item.stats.speed||0;
        base.accel += item.stats.accel||0;
        base.handling += item.stats.handling||0;
      }
    }
    return base;
  }

  // ---- shared boat sprite ----
  function drawBoatSprite(ctx, x, y, s, equipped, lean) {
    lean = lean || 0;
    var hull = byId(equipped.hull) || byId("hull_oak");
    var sail = byId(equipped.sail) || byId("sail_plain");
    var fig = byId(equipped.figure);
    ctx.save(); ctx.translate(x, y); ctx.rotate(lean);
    ctx.fillStyle = hull.color;
    ctx.beginPath();
    ctx.moveTo(0,-22*s); ctx.lineTo(11*s,8*s); ctx.lineTo(7*s,20*s);
    ctx.lineTo(-7*s,20*s); ctx.lineTo(-11*s,8*s); ctx.closePath(); ctx.fill();
    ctx.fillStyle = PAL.hullDark; ctx.fillRect(-11*s,8*s,22*s,4*s);
    ctx.fillStyle = "rgba(0,0,0,0.18)"; ctx.fillRect(-3*s,-10*s,6*s,28*s);
    if (fig && fig.id==="fig_lamb"){ ctx.fillStyle="#e8e0cf"; ctx.beginPath(); ctx.arc(0,-24*s,3.2*s,0,TWO_PI); ctx.fill(); }
    if (fig && fig.id==="fig_lion"){ ctx.fillStyle=PAL.gold; ctx.beginPath(); ctx.arc(0,-24*s,3.6*s,0,TWO_PI); ctx.fill(); ctx.fillStyle=PAL.goldDark; ctx.fillRect(-3.6*s,-26*s,7.2*s,2*s); }
    ctx.fillStyle = PAL.hullDark; ctx.fillRect(-1.2*s,-6*s,2.4*s,14*s);
    ctx.fillStyle = sail.color;
    ctx.beginPath(); ctx.moveTo(0,-16*s); ctx.lineTo(12*s,4*s); ctx.lineTo(-12*s,4*s); ctx.closePath(); ctx.fill();
    ctx.strokeStyle = "rgba(0,0,0,0.15)"; ctx.stroke();
    if (sail.mark==="cross"){ ctx.fillStyle=PAL.blood; ctx.fillRect(-1*s,-12*s,2*s,12*s); ctx.fillRect(-4*s,-8*s,8*s,2*s); }
    if (sail.mark==="bolt"){ ctx.strokeStyle=PAL.gold; ctx.lineWidth=1.6*s; ctx.beginPath(); ctx.moveTo(2*s,-12*s); ctx.lineTo(-2*s,-4*s); ctx.lineTo(2*s,-4*s); ctx.lineTo(-2*s,2*s); ctx.stroke(); }
    if (equipped.engine==="eng_double"){ ctx.fillStyle=sail.color; ctx.globalAlpha=0.85; ctx.beginPath(); ctx.moveTo(0,-4*s); ctx.lineTo(8*s,12*s); ctx.lineTo(-8*s,12*s); ctx.closePath(); ctx.fill(); ctx.globalAlpha=1; }
    ctx.restore();
  }
  function drawRivalBoat(ctx, x, y, s, color) {
    ctx.save(); ctx.translate(x, y);
    ctx.fillStyle = color;
    ctx.beginPath(); ctx.moveTo(0,-16*s); ctx.lineTo(9*s,10*s); ctx.lineTo(-9*s,10*s); ctx.closePath(); ctx.fill();
    ctx.fillStyle = PAL.sailShade;
    ctx.beginPath(); ctx.moveTo(0,-14*s); ctx.lineTo(8*s,0); ctx.lineTo(-8*s,0); ctx.closePath(); ctx.fill();
    ctx.restore();
  }

  // ===================================================================
  //  STATE
  // ===================================================================
  global.boat = null;
  var onCloseCb = null;

  function openBoatRace(opts) {
    opts = opts || {};
    var inv = opts.inv || {};
    onCloseCb = opts.onClose || function(){};
    var owned = [];
    var seen = {};
    STARTERS.concat(inv.owned || []).forEach(function(id){ if(!seen[id]){ seen[id]=1; owned.push(id); } });
    global.boat = {
      screen: "dock",
      // economy: we track spent/won against KLK gold; goldAvail mirrors live spendable gold
      goldStart: (typeof opts.gold==="number") ? opts.gold : 200,
      goldAvail: (typeof opts.gold==="number") ? opts.gold : 200,
      goldWon: 0,
      goldSpent: 0,
      owned: owned,
      equipped: Object.assign({}, DEFAULT_EQUIP, inv.equipped || {}),
      course: HARBORS[inv.course] ? inv.course : "saltmere",
      difficulty: DIFFICULTY[inv.difficulty] ? inv.difficulty : "rough",
      result: null,
      toast: null, toastT: 0,
      shopSlot: "hull",
      // sub-states for sea + race built lazily
      sea: null, race: null,
      // pointer hitboxes registered each draw: {x,y,w,h,fn}
      hits: [],
      t: 0
    };
  }

  function exportInv(){
    var b = global.boat;
    return { owned: b.owned.slice(), equipped: Object.assign({}, b.equipped), difficulty: b.difficulty, course: b.course };
  }
  function leaveDock(){
    var b = global.boat;
    var delta = b.goldWon - b.goldSpent; // winnings minus spend
    var payload = { goldDelta: delta, inv: exportInv() };
    var cb = onCloseCb; global.boat = null; onCloseCb = null;
    cb(payload);
  }
  function flash(msg){ var b=global.boat; b.toast=msg; b.toastT=1800; }

  function buy(item){
    var b=global.boat;
    if (b.owned.indexOf(item.id)>=0) return;
    if (item.source==="race"){ flash("Win this in a race."); return; }
    if (b.goldAvail < item.cost){ flash("Not enough gold."); return; }
    b.goldAvail -= item.cost;
    b.goldSpent += item.cost;
    b.owned.push(item.id);
    flash("Bought "+item.name+".");
  }
  function equip(item){
    var b=global.boat;
    if (b.owned.indexOf(item.id)<0) return;
    b.equipped[item.slot] = item.id;
  }

  // ===================================================================
  //  RACE SUB-STATE
  // ===================================================================
  function makeBuoys(total){
    var arr=[];
    for (var d=300; d<total; d += 260 + Math.random()*180){
      arr.push({ dist:d, x:(Math.random()*1.4-0.7), hit:false });
    }
    return arr;
  }
  function startRace(){
    var b=global.boat, HARBOR=HARBORS[b.course], stats=deriveStats(b.equipped);
    var total = HARBOR.length * HARBOR.laps;
    var D = DIFFICULTY[b.difficulty] || DIFFICULTY.rough;
    var tierBump = ((HARBOR.tier||1)-1)*0.018;
    var rivals=[];
    var RIVALS=3;
    for (var i=0;i<RIVALS;i++){
      var bs = stats.speed * (D.lo + tierBump + i*D.step + Math.random()*0.03);
      rivals.push({ x:(i-1)*0.5+0.25, dist:0, speed:bs, baseSpeed:bs,
        color: PAL.rival[i % PAL.rival.length], finished:false, place:0, lap:1 });
    }
    b.race = {
      phase:"count", count:3, countT:0,
      stats:stats, harbor:HARBOR,
      player:{ x:0, dist:0, speed:stats.speed*0.78, lean:0, finished:false, place:0, livePlace:1,
               lap:1, splits:[], lastSplit:0, bumpFlash:0 },
      rivals:rivals, buoys:makeBuoys(total), finishOrder:[],
      total:total, lapLen:HARBOR.length, laps:HARBOR.laps,
      path:buildTrackPath(HARBOR.length, HARBOR.curve),
      t:0, RIVALS:RIVALS,
      keys:{ left:false, right:false, throttle:false }
    };
    b.screen="race";
  }

  function endRace(){
    var b=global.boat, R=b.race, HARBOR=R.harbor;
    var rem = R.rivals.filter(function(r){ return !r.finished; }).sort(function(a,c){ return c.dist-a.dist; });
    for (var i=0;i<rem.length;i++){ rem[i].finished=true; R.finishOrder.push(rem[i]); rem[i].place=R.finishOrder.length; }
    var place = R.player.place;
    var time = Math.round(R.t*10)/10;
    var D = DIFFICULTY[b.difficulty] || DIFFICULTY.rough;
    var tierMul = 1 + ((HARBOR.tier||1)-1)*0.45;
    var baseGold = [0,150,90,45][Math.min(place,3)] || 0;
    var gold = Math.round(baseGold * D.goldMul * tierMul);
    var unlocked = null;
    if (place===1){
      var pool = (HARBOR.reward||[]).filter(function(id){ return b.owned.indexOf(id)<0; });
      if (pool.length){ unlocked = pool[0]; b.owned.push(unlocked); }
    }
    b.goldWon += gold; b.goldAvail += gold;
    b.result = { completed:true, place:place, time:time, gold:gold, splits:R.player.splits||[], laps:R.laps, unlocked:unlocked };
    b.screen="results";
    b.race=null;
  }

  function raceStep(dt){
    var b=global.boat, R=b.race; if(!R) return;
    var stats=R.stats, HARBOR=R.harbor;
    if (R.phase==="count"){
      R.countT += dt;
      if (R.countT>=0.75){ R.countT=0; R.count--; if(R.count<=0) R.phase="racing"; }
      return;
    }
    if (R.phase!=="racing") return;
    R.t += dt;
    var p=R.player, k=R.keys;
    var steer=0;
    if (k.left) steer-=1;
    if (k.right) steer+=1;
    var boosting = k.throttle;
    p.x = clamp(p.x + steer*stats.handling*dt, -1.15, 1.15);
    p.lean += ((steer*0.32) - p.lean) * Math.min(1, dt*8);
    if (HARBOR.wind>0) p.x = clamp(p.x + HARBOR.wind*0.25*dt, -1.15, 1.15);
    var curve = curveAt(p.dist, HARBOR.curve);
    var speedFrac = p.speed / Math.max(1, stats.speed);
    p.x = clamp(p.x - curve*speedFrac*0.85*dt, -1.3, 1.3);
    R.curveNow = curve;
    var target = stats.speed * (boosting ? 1.0 : 0.88);
    p.speed += (target - p.speed) * Math.min(1, dt*(stats.accel/60));
    p.dist += p.speed*dt;
    if (p.bumpFlash>0) p.bumpFlash -= dt;
    if (Math.abs(p.x)>1.15){ p.speed*=0.985; if(p.bumpFlash<=0) p.bumpFlash=0.12; }
    var curLap = Math.min(R.laps, Math.floor(p.dist/R.lapLen)+1);
    if (curLap>p.lap && !p.finished){
      var split = Math.round((R.t - p.lastSplit)*100)/100;
      p.splits.push(split); p.lastSplit=R.t; p.lap=curLap;
    }
    var i;
    for (i=0;i<R.buoys.length;i++){
      var bu=R.buoys[i];
      if (!bu.hit && Math.abs(bu.dist-p.dist)<16 && Math.abs(bu.x-p.x)<0.22){
        bu.hit=true; p.speed*=0.5; p.bumpFlash=0.3; p.lean += (bu.x>p.x?-0.1:0.1);
      }
    }
    for (i=0;i<R.rivals.length;i++){
      var r=R.rivals[i]; if(r.finished) continue;
      var lead = r.dist - p.dist;
      var band = clamp(1 - lead/1200, 0.92, 1.03);
      r.speed += (r.baseSpeed*band - r.speed) * Math.min(1, dt*1.5);
      r.dist += r.speed*dt;
      r.x = clamp(r.x + Math.sin(R.t*0.8 + r.dist*0.01)*0.2*dt, -1.0, 1.0);
      r.lap = Math.min(R.laps, Math.floor(r.dist/R.lapLen)+1);
      var dDist = r.dist - p.dist, dLane = r.x - p.x;
      if (Math.abs(dDist)<22 && Math.abs(dLane)<0.32){
        var push = (0.34 - Math.abs(dLane))*2.2;
        var dir = dLane>=0 ? -1 : 1;
        p.x = clamp(p.x + dir*push*dt*6, -1.15, 1.15);
        r.x = clamp(r.x - dir*push*dt*6, -1.0, 1.0);
        p.speed*=0.985; r.speed*=0.985;
        if (p.bumpFlash<=0) p.bumpFlash=0.18;
        p.lean += dir*0.04;
      }
      if (r.dist>=R.total && !r.finished){ r.finished=true; R.finishOrder.push(r); r.place=R.finishOrder.length; }
    }
    for (var a=0;a<R.rivals.length;a++){
      for (var c=a+1;c<R.rivals.length;c++){
        var r1=R.rivals[a], r2=R.rivals[c];
        if (r1.finished||r2.finished) continue;
        if (Math.abs(r1.dist-r2.dist)<20 && Math.abs(r1.x-r2.x)<0.30){
          var dl=r2.x-r1.x, pu=(0.32-Math.abs(dl))*1.8, di=dl>=0?1:-1;
          r2.x=clamp(r2.x+di*pu*dt*6,-1.0,1.0); r1.x=clamp(r1.x-di*pu*dt*6,-1.0,1.0);
          r1.speed*=0.99; r2.speed*=0.99;
        }
      }
    }
    if (p.dist>=R.total && !p.finished){
      p.splits.push(Math.round((R.t-p.lastSplit)*100)/100);
      p.finished=true; R.finishOrder.push(p); p.place=R.finishOrder.length;
      endRace(); return;
    }
    var ahead=0;
    for (i=0;i<R.rivals.length;i++){ var rr=R.rivals[i]; if((rr.finished?rr.dist+99999:rr.dist)>p.dist) ahead++; }
    p.livePlace = ahead+1;
  }

  // ===================================================================
  //  SEA MAP SUB-STATE
  // ===================================================================
  function startSea(){
    var b=global.boat;
    var start = HARBORS[b.course] || HARBORS.saltmere;
    b.sea = {
      boat:{ x:start.pos.x, y:start.pos.y+90, heading:-Math.PI/2, speed:0 },
      t:0, wake:[], nearDock:null,
      keys:{ left:false, right:false, throttle:false }
    };
    b.screen="sea";
  }
  function seaStep(dt){
    var b=global.boat, S=b.sea; if(!S) return;
    S.t += dt;
    var bt=S.boat, k=S.keys, steer=0;
    if (k.left) steer-=1; if (k.right) steer+=1;
    var thrust = k.throttle ? 1 : 0;
    bt.heading += steer*2.2*dt;
    var target = thrust*220;
    bt.speed += (target-bt.speed)*Math.min(1,dt*2);
    bt.x += Math.cos(bt.heading)*bt.speed*dt;
    bt.y += Math.sin(bt.heading)*bt.speed*dt;
    bt.x = clamp(bt.x,20,980); bt.y = clamp(bt.y,20,980);
    if (bt.speed>20 && Math.random()<0.4) S.wake.push({ x:bt.x-Math.cos(bt.heading)*12, y:bt.y-Math.sin(bt.heading)*12, life:0.7 });
    for (var i=0;i<S.wake.length;i++) S.wake[i].life -= dt;
    S.wake = S.wake.filter(function(w){ return w.life>0; });
    var found=null, DOCK_R=70;
    for (i=0;i<HARBOR_ORDER.length;i++){ var h=HARBORS[HARBOR_ORDER[i]];
      if (Math.hypot(h.pos.x-bt.x, h.pos.y-bt.y)<DOCK_R){ found=HARBOR_ORDER[i]; break; } }
    S.nearDock = found;
  }

  // ===================================================================
  //  TICK (called from KLK loop, dt in seconds)
  // ===================================================================
  function boatTick(dt){
    var b=global.boat; if(!b) return;
    if (dt>0.05) dt=0.05;
    b.t += dt;
    if (b.toastT>0){ b.toastT-=dt*1000; if(b.toastT<=0) b.toast=null; }
    if (b.screen==="race") raceStep(dt);
    else if (b.screen==="sea") seaStep(dt);
  }

  // ===================================================================
  //  UI HELPERS (register clickable rects in virtual space)
  // ===================================================================
  function hit(x,y,w,h,fn){ global.boat.hits.push({x:x,y:y,w:w,h:h,fn:fn}); }
  function btn(ctx, x, y, w, h, label, opts){
    opts = opts || {};
    var fill = opts.ghost ? "transparent" : (opts.alt ? PAL.panel : PAL.gold);
    var fg = opts.ghost ? PAL.parchment : (opts.alt ? PAL.parchment : PAL.ink);
    ctx.fillStyle = fill; ctx.fillRect(x,y,w,h);
    ctx.strokeStyle = PAL.goldDark; ctx.lineWidth=2; ctx.strokeRect(x,y,w,h);
    ctx.fillStyle = fg; ctx.font = (opts.size||15)+"px 'Courier New', monospace"; ctx.textAlign="center"; ctx.textBaseline="middle";
    ctx.fillText(label, x+w/2, y+h/2+1);
    ctx.textAlign="left"; ctx.textBaseline="alphabetic";
  }
  function txt(ctx, s, x, y, color, size, align){
    ctx.fillStyle=color||PAL.parchment; ctx.font=(size||13)+"px 'Courier New', monospace";
    ctx.textAlign=align||"left"; ctx.textBaseline="alphabetic"; ctx.fillText(s,x,y); ctx.textAlign="left";
  }

  function statBar(ctx, x, y, w, label, v, max){
    txt(ctx, label, x, y-4, PAL.parchment, 9, "left");
    ctx.fillStyle=PAL.panel; ctx.fillRect(x,y,w,8);
    ctx.strokeStyle=PAL.panelEdge; ctx.lineWidth=1; ctx.strokeRect(x,y,w,8);
    ctx.fillStyle=PAL.gold; ctx.fillRect(x,y,w*clamp(v/max,0,1),8);
  }

  // ===================================================================
  //  DRAW SCREENS
  // ===================================================================
  function drawDock(ctx){
    var b=global.boat, HARBOR=HARBORS[b.course], stats=deriveStats(b.equipped);
    txt(ctx, "DOCKED AT · TIER "+HARBOR.tier, BW/2, 34, "rgba(232,224,207,0.7)", 10, "center");
    txt(ctx, HARBOR.name, BW/2, 56, PAL.gold, 19, "center");
    txt(ctx, HARBOR.laps+" laps · "+(HARBOR.wind>0?"winds rising":"calm waters")+" · "+HARBOR.feel, BW/2, 74, "rgba(232,224,207,0.8)", 11, "center");

    // mini track shape
    var path = buildTrackPath(HARBOR.length, HARBOR.curve), ts=96, tx=BW/2-ts/2, ty=86;
    ctx.strokeStyle=PAL.foam; ctx.lineWidth=2.5; ctx.lineJoin="round"; ctx.beginPath();
    for (var i=0;i<path.pts.length;i++){ var px=tx+path.pts[i].nx*ts, py=ty+path.pts[i].ny*ts; i?ctx.lineTo(px,py):ctx.moveTo(px,py); }
    ctx.stroke();
    ctx.fillStyle=PAL.gold; ctx.beginPath(); ctx.arc(tx+path.pts[0].nx*ts, ty+path.pts[0].ny*ts, 4, 0, TWO_PI); ctx.fill();

    // boat preview
    var by=200, bpx=BW/2, bps=110;
    var g=ctx.createRadialGradient(bpx,by+bps/2,10,bpx,by+bps/2,bps/2);
    g.addColorStop(0,PAL.seaLight); g.addColorStop(1,PAL.deepSea);
    ctx.fillStyle=g; ctx.fillRect(bpx-bps/2,by,bps,bps);
    ctx.strokeStyle=PAL.goldDark; ctx.lineWidth=2; ctx.strokeRect(bpx-bps/2,by,bps,bps);
    drawBoatSprite(ctx, bpx, by+bps/2+bps*0.06, bps/90, b.equipped, 0);

    // stats
    var sy=330;
    statBar(ctx, BW/2-150, sy, 86, "SPEED", stats.speed, 260);
    statBar(ctx, BW/2-43, sy, 86, "ACCEL", stats.accel, 150);
    statBar(ctx, BW/2+64, sy, 86, "HANDLING", stats.handling*50, 150);

    // difficulty
    txt(ctx, "RIVAL DIFFICULTY", BW/2, 372, "rgba(232,224,207,0.7)", 10, "center");
    var dw=92, gap=6, totw=dw*3+gap*2, dx0=BW/2-totw/2, dyB=380;
    for (i=0;i<DIFF_ORDER.length;i++){
      (function(dk,dx){
        var sel = b.difficulty===dk;
        ctx.fillStyle = sel?PAL.gold:"transparent"; ctx.fillRect(dx,dyB,dw,24);
        ctx.strokeStyle=PAL.panelEdge; ctx.lineWidth=1; ctx.strokeRect(dx,dyB,dw,24);
        txt(ctx, DIFFICULTY[dk].label.toUpperCase(), dx+dw/2, dyB+16, sel?PAL.ink:PAL.parchment, 11, "center");
        hit(dx,dyB,dw,24,function(){ b.difficulty=dk; });
      })(DIFF_ORDER[i], dx0+i*(dw+gap));
    }
    var dnote = b.difficulty==="cutthroat" ? "1.5× gold — fast rivals" : b.difficulty==="calm" ? "0.8× gold — relaxed" : "standard payout";
    txt(ctx, dnote, BW/2, 420, "rgba(232,224,207,0.6)", 10, "center");

    var tierMul = Math.round((1 + (HARBOR.tier-1)*0.45)*10)/10;
    txt(ctx, "\u26C3 "+b.goldAvail+" gold · tier prize "+tierMul+"\u00D7", BW/2, 444, PAL.gold, 13, "center");

    // buttons
    var bw2=240, bx=BW/2-bw2/2, byy=460;
    btn(ctx, bx, byy, bw2, 38, "ENTER RACE"); hit(bx,byy,bw2,38,startRace);
    btn(ctx, bx, byy+46, bw2, 38, "CUSTOMIZE / SHOP", {alt:true}); hit(bx,byy+46,bw2,38,function(){ b.screen="shop"; });
    btn(ctx, bx, byy+92, bw2, 38, "\u2693 SET SAIL", {alt:true}); hit(bx,byy+92,bw2,38,startSea);
    btn(ctx, bx, byy+138, bw2, 38, "LEAVE TO SHORE", {ghost:true}); hit(bx,byy+138,bw2,38,leaveDock);
  }

  function drawShop(ctx){
    var b=global.boat;
    txt(ctx, "Shipwright", 18, 32, PAL.gold, 20, "left");
    txt(ctx, "\u26C3 "+b.goldAvail, BW-18, 32, PAL.gold, 15, "right");

    // boat preview
    var bps=100, bpx=BW/2, by=44;
    var g=ctx.createRadialGradient(bpx,by+bps/2,10,bpx,by+bps/2,bps/2);
    g.addColorStop(0,PAL.seaLight); g.addColorStop(1,PAL.deepSea);
    ctx.fillStyle=g; ctx.fillRect(bpx-bps/2,by,bps,bps);
    ctx.strokeStyle=PAL.goldDark; ctx.lineWidth=2; ctx.strokeRect(bpx-bps/2,by,bps,bps);
    drawBoatSprite(ctx, bpx, by+bps/2+bps*0.06, bps/90, b.equipped, 0);

    // slot tabs
    var tw=92, gap=6, totw=tw*SLOTS.length+gap*(SLOTS.length-1), tx0=BW/2-totw/2, ty=156;
    for (var i=0;i<SLOTS.length;i++){
      (function(slot,tx){
        var sel=b.shopSlot===slot;
        ctx.fillStyle=sel?PAL.gold:"transparent"; ctx.fillRect(tx,ty,tw,22);
        ctx.strokeStyle=PAL.panelEdge; ctx.lineWidth=1; ctx.strokeRect(tx,ty,tw,22);
        txt(ctx, slot.toUpperCase(), tx+tw/2, ty+15, sel?PAL.ink:PAL.parchment, 10, "center");
        hit(tx,ty,tw,22,function(){ b.shopSlot=slot; });
      })(SLOTS[i], tx0+i*(tw+gap));
    }

    // item list
    var items = CATALOG.filter(function(c){ return c.slot===b.shopSlot; });
    var iy=190, rowH=52;
    for (i=0;i<items.length;i++){
      (function(it,ry){
        var isOwned = b.owned.indexOf(it.id)>=0;
        var isEq = b.equipped[it.slot]===it.id;
        var raceLocked = it.source==="race" && !isOwned;
        ctx.fillStyle=PAL.panel; ctx.fillRect(20,ry,BW-40,rowH-6);
        ctx.strokeStyle=isEq?PAL.gold:PAL.panelEdge; ctx.lineWidth=1; ctx.strokeRect(20,ry,BW-40,rowH-6);
        txt(ctx, it.name+(raceLocked?" \uD83D\uDD12":""), 30, ry+18, raceLocked?PAL.buoy:PAL.parchment, 14, "left");
        txt(ctx, it.desc+statLine(it), 30, ry+34, "rgba(232,224,207,0.7)", 10, "left");
        // action
        var aw=80, ax=BW-40-aw, ay=ry+10, ah=rowH-26;
        if (isEq){ txt(ctx, "EQUIPPED", BW-30, ry+28, PAL.gold, 11, "right"); }
        else if (isOwned){ btn(ctx, ax, ay, aw, ah, "Equip", {size:12}); hit(ax,ay,aw,ah,function(){ equip(it); }); }
        else if (raceLocked){ txt(ctx, "Win it", BW-30, ry+28, PAL.buoy, 11, "right"); }
        else { btn(ctx, ax, ay, aw, ah, "\u26C3 "+it.cost, {size:12}); hit(ax,ay,aw,ah,function(){ buy(it); }); }
      })(items[i], iy+i*rowH);
    }
    // back
    var bw2=200, bx=BW/2-bw2/2, byy=BH-50;
    btn(ctx, bx, byy, bw2, 36, "BACK TO DOCK", {ghost:true}); hit(bx,byy,bw2,36,function(){ b.screen="dock"; });
  }
  function statLine(it){
    var s=it.stats||{}, p=[];
    if (s.speed) p.push("+"+s.speed+" spd");
    if (s.accel) p.push("+"+s.accel+" acc");
    if (s.handling) p.push("+"+s.handling+" hdl");
    return p.length? " · "+p.join(" ") : "";
  }

  function drawSea(ctx){
    var b=global.boat, S=b.sea; if(!S){ startSea(); S=b.sea; }
    // square sea area, centered
    var SZ = Math.min(BW, BH-150);
    var ox=(BW-SZ)/2, oy=70;
    var sc = SZ/1000;
    var X=function(x){ return ox + x*sc; }, Y=function(y){ return oy + y*sc; };

    var g=ctx.createLinearGradient(0,oy,0,oy+SZ);
    g.addColorStop(0,"#0e2c44"); g.addColorStop(1,"#071a2b");
    ctx.fillStyle=g; ctx.fillRect(ox,oy,SZ,SZ);
    ctx.strokeStyle=PAL.goldDark; ctx.lineWidth=3; ctx.strokeRect(ox,oy,SZ,SZ);
    ctx.save(); ctx.beginPath(); ctx.rect(ox,oy,SZ,SZ); ctx.clip();
    ctx.strokeStyle="rgba(207,238,238,0.06)"; ctx.lineWidth=2;
    for (var i=0;i<18;i++){ var yy=((i*60 + S.t*12)%1080)-40; ctx.beginPath(); ctx.moveTo(ox,Y(yy)); ctx.lineTo(ox+SZ,Y(yy)); ctx.stroke(); }

    for (i=0;i<HARBOR_ORDER.length;i++){
      var h=HARBORS[HARBOR_ORDER[i]], hx=X(h.pos.x), hy=Y(h.pos.y);
      ctx.fillStyle="#2a3a2a"; ctx.beginPath(); ctx.ellipse(hx,hy,34*sc,26*sc,0,0,TWO_PI); ctx.fill();
      ctx.fillStyle="#3f5a3a"; ctx.beginPath(); ctx.ellipse(hx,hy-4*sc,24*sc,16*sc,0,0,TWO_PI); ctx.fill();
      ctx.fillStyle="#6b4a2a"; ctx.fillRect(hx-3*sc,hy+18*sc,6*sc,20*sc);
      ctx.fillStyle=h.tint.sun; ctx.beginPath(); ctx.arc(hx,hy-22*sc,7*sc,0,TWO_PI); ctx.fill();
      ctx.fillStyle=PAL.ink; ctx.font=(11*sc|0)+"px 'Courier New',monospace"; ctx.textAlign="center";
      ctx.fillText(String(h.tier), hx, hy-18*sc);
      ctx.fillStyle = HARBOR_ORDER[i]===b.course?PAL.gold:PAL.parchment;
      ctx.font=(12*sc|0)+"px 'Courier New',monospace";
      ctx.fillText(h.name.split(" ")[0], hx, hy+50*sc);
    }
    ctx.textAlign="left";

    for (i=0;i<S.wake.length;i++){ var w=S.wake[i]; ctx.globalAlpha=Math.max(0,w.life)*0.5; ctx.fillStyle=PAL.foam;
      ctx.beginPath(); ctx.arc(X(w.x),Y(w.y),2.5*sc,0,TWO_PI); ctx.fill(); }
    ctx.globalAlpha=1;

    var bt=S.boat;
    ctx.save(); ctx.translate(X(bt.x),Y(bt.y)); ctx.rotate(bt.heading+Math.PI/2);
    drawBoatSprite(ctx,0,0,sc*1.1,b.equipped,0); ctx.restore();
    ctx.restore();

    txt(ctx, "Sail to a harbor · numbers show tier", BW/2, 50, PAL.parchment, 11, "center");

    if (S.nearDock){
      var label = "\u2693 DOCK AT "+HARBORS[S.nearDock].name.split(" ")[0].toUpperCase();
      var bw2=Math.min(BW-40, 280), bx=BW/2-bw2/2, byy=oy+40;
      btn(ctx, bx, byy, bw2, 34, label);
      hit(bx,byy,bw2,34,(function(key){ return function(){ b.course=key; b.screen="dock"; b.sea=null; }; })(S.nearDock));
      txt(ctx, "(or press Ⓐ)", BW/2, byy+50, PAL.parchment, 9, "center");
    }

    // controls (left/right + throttle) at bottom
    drawSeaRaceControls(ctx, S.keys);

    // exit
    btn(ctx, BW-44, oy-2, 0, 0, ""); // noop spacing
    txt(ctx, "\u2715", BW-24, oy-6, PAL.parchment, 18, "center");
    hit(BW-40, oy-26, 36, 30, leaveDock);
  }

  function drawSeaRaceControls(ctx, keys){
    var sz=66, y=BH-sz-18;
    drawCtl(ctx, 18, y, sz, "\u25C0", keys.left, "left");
    drawCtl(ctx, 18+sz+10, y, sz, "\u25B6", keys.right, "right");
    drawCtl(ctx, BW-sz-18, y, sz, "\u26F5", keys.throttle, "throttle");
  }
  function drawCtl(ctx, x, y, sz, glyph, active, pad){
    ctx.fillStyle = active?PAL.gold:"rgba(217,165,49,0.22)";
    ctx.fillRect(x,y,sz,sz);
    ctx.strokeStyle=PAL.goldDark; ctx.lineWidth=2; ctx.strokeRect(x,y,sz,sz);
    ctx.fillStyle=PAL.ink; ctx.font="24px 'Courier New',monospace"; ctx.textAlign="center"; ctx.textBaseline="middle";
    ctx.fillText(glyph, x+sz/2, y+sz/2+1);
    ctx.textAlign="left"; ctx.textBaseline="alphabetic";
    global.boat.hits.push({ x:x, y:y, w:sz, h:sz, pad:pad });
  }

  function drawRaceScreen(ctx){
    var b=global.boat, R=b.race; if(!R) return;
    var W=BW, H=BH-110; var oy=0; // race fills most of the canvas; leave room for controls
    var horizon = H*0.42;
    var T = R.harbor.tint;
    var _bc=(drawBoat._c=drawBoat._c||{});             // gradient cache per harbor/canvas
    if(_bc.T!==T || _bc.h!==horizon || _bc.H!==H){ _bc.T=T; _bc.h=horizon; _bc.H=H;
      _bc.sky=ctx.createLinearGradient(0,0,0,horizon);
      _bc.sky.addColorStop(0,T.sky); _bc.sky.addColorStop(1,T.skyLow);
      _bc.sea=ctx.createLinearGradient(0,horizon,0,H);
      _bc.sea.addColorStop(0,T.sea); _bc.sea.addColorStop(1,T.deep); }
    var sky=_bc.sky;
    ctx.fillStyle=sky; ctx.fillRect(0,0,W,horizon);
    ctx.fillStyle=T.sun; ctx.globalAlpha=0.85; ctx.beginPath(); ctx.arc(W*0.5,horizon-26,22,0,TWO_PI); ctx.fill(); ctx.globalAlpha=1;
    var seaG=_bc.sea;
    ctx.fillStyle=seaG; ctx.fillRect(0,horizon,W,H-horizon);

    var p=R.player, cx=W/2;
    function project(laneX, depth){
      var persp = 1-depth;
      var scale = 0.12 + persp*0.9;
      var sy = horizon + (H-horizon)*(1-depth*depth);
      var roadHalf = (W*0.08) + (W*0.42)*persp;
      var bend = curveAt(p.dist + depth*650, R.harbor.curve) * depth*depth * (W*1.25);
      var sx = cx + bend + laneX*roadHalf - (p.x*roadHalf*0.55);
      return { sx:sx, sy:sy, scale:scale };
    }
    var slices=24, i;
    for (i=0;i<slices;i++){
      var d0=i/slices, d1=(i+1)/slices;
      var aL=project(-1.18,d0), aR=project(1.18,d0), bL=project(-1.18,d1), bR=project(1.18,d1);
      ctx.fillStyle = i%2===0 ? "rgba(29,90,115,0.55)" : "rgba(20,58,82,0.55)";
      ctx.beginPath(); ctx.moveTo(aL.sx,aL.sy); ctx.lineTo(aR.sx,aR.sy); ctx.lineTo(bR.sx,bR.sy); ctx.lineTo(bL.sx,bL.sy); ctx.closePath(); ctx.fill();
    }
    function drawRail(laneX,color){
      ctx.strokeStyle=color; ctx.lineWidth=3; ctx.beginPath();
      for (var j=0;j<=slices;j++){ var pr=project(laneX,j/slices); j?ctx.lineTo(pr.sx,pr.sy):ctx.moveTo(pr.sx,pr.sy); }
      ctx.stroke();
    }
    drawRail(-1.18,"rgba(207,238,238,0.7)"); drawRail(1.18,"rgba(207,238,238,0.7)");
    ctx.strokeStyle="rgba(217,165,49,0.45)"; ctx.lineWidth=2;
    for (i=0;i<14;i++){ var phase=((i/14)+((p.dist*0.015)%(1/14)))%1; var a=project(0,phase), b2=project(0,Math.min(1,phase+0.025));
      ctx.beginPath(); ctx.moveTo(a.sx,a.sy); ctx.lineTo(b2.sx,b2.sy); ctx.stroke(); }
    for (i=0;i<10;i++){ var depth=((i/10)+((p.dist*0.02)%(1/10)))%1; var L=project(-1.18,depth), Rr=project(1.18,depth); var r=Math.max(1,4*L.scale);
      ctx.fillStyle=PAL.foam; ctx.globalAlpha=0.6;
      ctx.beginPath(); ctx.arc(L.sx,L.sy,r,0,TWO_PI); ctx.fill();
      ctx.beginPath(); ctx.arc(Rr.sx,Rr.sy,r,0,TWO_PI); ctx.fill(); ctx.globalAlpha=1; }

    for (i=0;i<R.buoys.length;i++){
      var bu=R.buoys[i]; var rel=bu.dist-p.dist;
      if (rel<-10||rel>700) continue;
      var dep=clamp(rel/700,0,1), pr=project(bu.x,dep), rr=Math.max(3,15*pr.scale);
      var inLane=Math.abs(bu.x-p.x)<0.30, near=rel>0&&rel<260;
      if (!bu.hit && inLane && near){ var pulse=0.4+0.4*Math.sin(R.t*10); ctx.strokeStyle="rgba(217,165,49,"+pulse.toFixed(2)+")"; ctx.lineWidth=2; ctx.beginPath(); ctx.arc(pr.sx,pr.sy-rr,rr*1.9,0,TWO_PI); ctx.stroke(); }
      ctx.fillStyle=bu.hit?"#3a3a3a":"#7a3a18"; ctx.fillRect(pr.sx-rr*0.18,pr.sy-rr*2.4,rr*0.36,rr*2.4);
      if (!bu.hit){ ctx.fillStyle="#e8e0cf"; ctx.beginPath(); ctx.moveTo(pr.sx+rr*0.18,pr.sy-rr*2.4); ctx.lineTo(pr.sx+rr*1.1,pr.sy-rr*2.05); ctx.lineTo(pr.sx+rr*0.18,pr.sy-rr*1.7); ctx.closePath(); ctx.fill(); }
      ctx.fillStyle=bu.hit?"#555":PAL.buoy; ctx.beginPath(); ctx.arc(pr.sx,pr.sy,rr,0,TWO_PI); ctx.fill();
      if (!bu.hit){ ctx.fillStyle="rgba(255,255,255,0.35)"; ctx.beginPath(); ctx.arc(pr.sx-rr*0.3,pr.sy-rr*0.3,rr*0.35,0,TWO_PI); ctx.fill();
        ctx.strokeStyle="rgba(207,238,238,0.5)"; ctx.lineWidth=1.5; ctx.beginPath(); ctx.ellipse(pr.sx,pr.sy+rr*0.7,rr*1.3,rr*0.4,0,0,TWO_PI); ctx.stroke(); }
    }

    var rs = R.rivals.slice().sort(function(a,c){ return (c.dist-p.dist)-(a.dist-p.dist); });
    for (i=0;i<rs.length;i++){ var rv=rs[i], rel2=rv.dist-p.dist; if (rel2<-40||rel2>720) continue;
      var dep2=clamp(rel2/720,0,1), pr2=project(rv.x,dep2); drawRivalBoat(ctx,pr2.sx,pr2.sy,Math.max(0.25,pr2.scale*0.9),rv.color); }

    drawBoatSprite(ctx, cx, H*0.84, 1.5, b.equipped, p.lean);
    ctx.fillStyle="rgba(207,238,238,0.5)"; ctx.beginPath(); ctx.ellipse(cx,H*0.84+26,30,8,0,0,TWO_PI); ctx.fill();

    if (p.bumpFlash>0){ var al=clamp(p.bumpFlash/0.18,0,1)*0.4; var vg=ctx.createRadialGradient(cx,H*0.7,H*0.2,cx,H*0.7,H*0.7);
      vg.addColorStop(0,"rgba(122,31,31,0)"); vg.addColorStop(1,"rgba(122,31,31,"+al+")"); ctx.fillStyle=vg; ctx.fillRect(0,0,W,H); }

    drawRaceMinimap(ctx, W, H, R, p);

    // HUD
    if (R.phase==="racing"){
      txt(ctx, "PLACE "+p.livePlace+"/"+(R.RIVALS+1), 10, 22, PAL.gold, 13, "left");
      txt(ctx, "LAP "+p.lap+"/"+R.laps, W/2, 18, PAL.parchment, 13, "center");
      txt(ctx, (R.t - p.lastSplit).toFixed(2)+"s", W/2, 34, "rgba(232,224,207,0.85)", 12, "center");
      var last = p.splits[p.splits.length-1]||0;
      if (last) txt(ctx, "last "+last.toFixed(2)+"s", W/2, 48, PAL.foam, 11, "center");
      txt(ctx, Math.round(clamp(p.dist/R.total,0,1)*100)+"%", W-10, 22, PAL.parchment, 13, "right");
      var turn = curveAt(p.dist+420, R.harbor.curve);
      if (Math.abs(turn)>0.15){
        txt(ctx, turn>0?"BEND \u25B6\u25B6":"\u25C0\u25C0 BEND", W/2, H*0.28, PAL.gold, 30, "center");
      }
      drawSeaRaceControls(ctx, R.keys);
    }
    if (R.phase==="count" && R.count>0){
      txt(ctx, String(R.count), W/2, H/2+24, PAL.gold, 80, "center");
    }
    // exit
    txt(ctx, "\u2715", W-24, 22, PAL.parchment, 18, "center");
    hit(W-40, 4, 36, 30, function(){ b.screen="dock"; b.race=null; });
  }

  function drawRaceMinimap(ctx, W, H, R, p){
    if (!R.path) return;
    var box=Math.min(W*0.30,120), ox=W-box-10, oy=58, pts=R.path.pts;
    ctx.fillStyle="rgba(6,16,28,0.6)"; ctx.strokeStyle=PAL.goldDark; ctx.lineWidth=1.5;
    ctx.fillRect(ox,oy,box,box); ctx.strokeRect(ox,oy,box,box);
    var X=function(n){ return ox+n*box; }, Y=function(n){ return oy+n*box; };
    ctx.strokeStyle="rgba(207,238,238,0.55)"; ctx.lineWidth=2.5; ctx.beginPath();
    for (var i=0;i<pts.length;i++){ i?ctx.lineTo(X(pts[i].nx),Y(pts[i].ny)):ctx.moveTo(X(pts[i].nx),Y(pts[i].ny)); }
    ctx.stroke();
    ctx.fillStyle=PAL.gold; ctx.beginPath(); ctx.arc(X(pts[0].nx),Y(pts[0].ny),3,0,TWO_PI); ctx.fill();
    function dot(dist,color,r){ var frac=(((dist%R.lapLen)+R.lapLen)%R.lapLen)/R.lapLen; var idx=clamp(Math.round(frac*R.path.N),0,R.path.N); var pt=pts[idx];
      ctx.fillStyle=color; ctx.beginPath(); ctx.arc(X(pt.nx),Y(pt.ny),r,0,TWO_PI); ctx.fill(); }
    for (i=0;i<R.rivals.length;i++) dot(R.rivals[i].dist,R.rivals[i].color,2.5);
    dot(p.dist,PAL.gold,3.5);
    ctx.fillStyle=PAL.parchment; ctx.font="10px 'Courier New',monospace"; ctx.textAlign="center";
    ctx.fillText("LAP "+p.lap+"/"+R.laps, ox+box/2, oy+box-5); ctx.textAlign="left";
  }

  function drawResults(ctx){
    var b=global.boat, res=b.result; if(!res){ b.screen="dock"; return; }
    var win=res.place===1, splits=res.splits||[];
    var best = splits.length ? Math.min.apply(null,splits) : null;
    txt(ctx, win?"Victory at Sea":(ordinal(res.place)+" Place"), BW/2, 120, win?PAL.gold:PAL.parchment, 30, "center");
    txt(ctx, "Total "+res.time+"s", BW/2, 150, PAL.parchment, 14, "center");
    var sy=180;
    if (splits.length){
      var bw2=200, bx=BW/2-bw2/2;
      ctx.fillStyle=PAL.panel; ctx.fillRect(bx,sy,bw2,splits.length*22+14);
      ctx.strokeStyle=PAL.panelEdge; ctx.lineWidth=1; ctx.strokeRect(bx,sy,bw2,splits.length*22+14);
      for (var i=0;i<splits.length;i++){
        var col = splits[i]===best?PAL.gold:PAL.parchment;
        txt(ctx, "Lap "+(i+1), bx+14, sy+24+i*22, col, 13, "left");
        txt(ctx, splits[i].toFixed(2)+"s"+(splits[i]===best&&splits.length>1?"  \u2605":""), bx+bw2-14, sy+24+i*22, col, 13, "right");
      }
      sy += splits.length*22+24;
    }
    txt(ctx, "+"+res.gold+" gold", BW/2, sy+24, PAL.gold, 22, "center");
    if (res.unlocked){ var ui=byId(res.unlocked); txt(ctx, "Unlocked: "+(ui?ui.name:res.unlocked)+" \uD83C\uDFC6", BW/2, sy+50, PAL.buoy, 14, "center"); sy+=26; }
    var bw3=200, bx3=BW/2-bw3/2;
    btn(ctx, bx3, sy+60, bw3, 38, "BACK TO DOCK");
    hit(bx3, sy+60, bw3, 38, function(){ b.result=null; b.screen="dock"; });
  }

  // ===================================================================
  //  TOP-LEVEL DRAW (letterboxed like drawRace)
  // ===================================================================
  function drawBoat(ctx, cw, ch){
    var b=global.boat; if(!b) return;
    if (typeof cw!=="number") cw=BW;
    if (typeof ch!=="number") ch=BH;
    var scale=Math.min(cw/BW, ch/BH);
    var dx=(cw-BW*scale)/2, dy=(ch-BH*scale)/2;
    b.hits = [];
    b._xf = { scale:scale, dx:dx, dy:dy };
    ctx.save();
    ctx.fillStyle=PAL.ink; ctx.fillRect(0,0,cw,ch);
    ctx.translate(dx,dy); ctx.scale(scale,scale);
    ctx.beginPath(); ctx.rect(0,0,BW,BH); ctx.clip();
    ctx.fillStyle=PAL.ink; ctx.fillRect(0,0,BW,BH);

    if (b.screen==="dock") drawDock(ctx);
    else if (b.screen==="shop") drawShop(ctx);
    else if (b.screen==="sea") drawSea(ctx);
    else if (b.screen==="race") drawRaceScreen(ctx);
    else if (b.screen==="results") drawResults(ctx);

    if (b.toast){
      var tw=ctx.measureText?0:0;
      ctx.fillStyle=PAL.panel; ctx.strokeStyle=PAL.goldDark; ctx.lineWidth=2;
      var w=240, x=BW/2-w/2, y=BH-44;
      ctx.fillRect(x,y,w,30); ctx.strokeRect(x,y,w,30);
      txt(ctx, b.toast, BW/2, y+20, PAL.gold, 12, "center");
    }
    ctx.restore();
  }

  // ===================================================================
  //  INPUT
  // ===================================================================
  // discrete press: 'A' confirm (dock prompt), 'B' back/quit, arrows steer
  function boatPress(code){
    var b=global.boat; if(!b) return;
    if (b.screen==="sea"){
      if (code==="A" && b.sea && b.sea.nearDock){ b.course=b.sea.nearDock; b.screen="dock"; b.sea=null; return; }
      if (code==="B"){ leaveDock(); return; }
    } else if (b.screen==="race" && b.race){
      if (code==="B"){ b.screen="dock"; b.race=null; return; }
    } else if (b.screen==="results"){
      if (code==="A"||code==="B"){ b.result=null; b.screen="dock"; return; }
    } else if (b.screen==="shop"){
      if (code==="B"){ b.screen="dock"; return; }
    } else if (b.screen==="dock"){
