  const _walk=Object.keys(distm).length;
  const nDem=Math.max(6, Math.round(_walk/DEMON_DENSITY)) + (floorIdx>0?2:0);
  // The long way round is GUARDED, not merely longer. Two thirds of the floor's
  // demons stand on the hard climb's side — that, plus the chest, is what makes
  // the choice between the two routes a real one rather than a coin toss.
  // Rank every spot by how far it lies down the LONG road rather than the short
