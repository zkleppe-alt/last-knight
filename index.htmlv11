  // distances from the STAIR, with the stone treated as rolled: that is where
  // the knight lands when he comes back down from the floor above.
  const _distStair={};
  { let sx3=null, sy3=null;
    for(let y=0;y<MAZE_H;y++)for(let x=0;x<MAZE_W;x++) if(g[y][x]===2){ sx3=x; sy3=y; }
    if(sx3!==null){ const q3=[[sx3,sy3]]; _distStair[sx3+','+sy3]=0;
      while(q3.length){ const [x,y]=q3.shift();
        for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ const nx3=x+dx, ny3=y+dy, k=nx3+','+ny3;
          if(nx3<1||ny3<1||nx3>=MAZE_W-1||ny3>=MAZE_H-1) continue;
          if(g[ny3][nx3]===1 || _distStair[k]!==undefined) continue;
