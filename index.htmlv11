  global.boatTick = boatTick;
  global.drawBoat = drawBoat;
  global.boatPress = boatPress;
  global.boatHold = boatHold;
  global.boatPointer = boatPointer;
  global.boatPadAt = boatPadAt;
  global.boatSetPads = boatSetPads;
