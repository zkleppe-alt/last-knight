      if(h4<2){ px(x+2+h2%6,y+5,2,1,'#4c7a52'); px(x+3+h2%6,y+6,1,1,'#5c8a5e'); }
      if(h1<2) px(x+9+h3%4,y+11,2,1,'#4c7a52');
      if(h3<2) px(x+2+h1%8,y+2,2,2,'#c6bfb1');
