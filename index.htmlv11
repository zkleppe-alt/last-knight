      px(x+4+h2%7,y+6+h3,1,1,'#d4b276'); px(x+10-h4,y+4+h1%6,1,1,'#8f7344');
      */
      break; }
    case 4: { // FLOWERS — blooms with stems on speckled grass
      px(x,y,TILE,TILE,'#5fa860');
