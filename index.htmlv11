// ── DUNGEON FLOORS — procedurally generated mazes + an open boss arena ──
// Floor type 0/1 = a seeded MAZE (navigate corridors, fight wandering demons,
// find the stairs). Type 2 = the open-arena SANCTUM where the boss + general wait.
// Every floor is 15×11 (exactly one screen). Tiles: 0 floor, 1 wall, 2 stairs-up,
// 5 chest, 6 demon spawn, 7 general, 8 entrance.

// ════════════════════════════════════════════════════════════════
//  🏄 THE KNIGHT'S WAVE — surf minigame (ported from SurfMinigame.tsx)
//  Ride a 5-wave session at Saltmere's surf spot. D-pad moves on the
//  face · Ⓑ cutback · Ⓐ air at the lip · tuck high-left into open
//  barrels ("The Narrow Way"). GRACE earned across all five waves is
//  scored against tiered awards when the set ends.
// ════════════════════════════════════════════════════════════════
const SURF_TRICKS = { drop:'DROP OF FAITH', cutback:'TURN OF REPENTANCE', air:'ASCENSION AIR',
  land:'STEADFAST LANDING', barrel:'THE NARROW WAY', missLip:'SEEK THE HEIGHTS' };
const SURF_TIERS = [
  { min:5200, name:'✝ THE NARROW WAY',  gold:400, sp:1, xp:120, col:'#8ef0ff', line:'You walked where few dare ride.' },
  { min:3500, name:'🏆 GOLDEN BARREL',  gold:250, sp:1, xp:80,  col:'#ffe04a', line:'The sea itself applauds.' },
  { min:2200, name:'🥈 SILVER CURL',    gold:120, sp:0, xp:50,  col:'#cfd8e6', line:'A rider of real grace.' },
  { min:1200, name:'🥉 BRONZE CONCH',   gold:60,  sp:0, xp:30,  col:'#d89a5e', line:'The fishermen nod approvingly.' },
  { min:0,    name:'🪵 DRIFTWOOD',      gold:25,  sp:0, xp:12,  col:'#9a8a78', line:'Even falling is practice.' },
];
const SURF_WAVES_PER_SESSION = 5;
let surf=null;
function startSurf(){
  surf = {
    phase:'lineup', return:{x:player.x, y:player.y},
    score:0, combo:0, wavesRidden:0, bestTrick:0, barrelsMade:0,
    surferX:0.5, surferY:0.55, dir:1, inAir:false, airT:0, cutFlash:0,
    waveLife:0, waveDur:12000, buildT:0, fadeT:0, riding:false, foam:[],
    isBarrelWave:false, barrelOpen:0, tucked:false, tuckT:0, barrelScored:false,
    trick:null, awarded:false, tier:null, newBest:false,
  };
  place = { kind:'surf' };
  showBanner(`🏄 <b>The Knight's Wave</b> — a ${SURF_WAVES_PER_SESSION}-wave set rolls in!`, 1800);
}
function surfFlash(text, pts){ surf.trick={ text, pts, t:1000 }; }
function surfAdd(pts, name){ surf.score+=pts; if(pts>surf.bestTrick) surf.bestTrick=pts; if(name) surfFlash(name, pts); }
function surfStartWave(){
  const g=surf;
  g.surferX=0.5; g.surferY=0.55; g.dir=1; g.inAir=false; g.airT=0; g.cutFlash=0;
  g.waveLife=0; g.waveDur=10000+Math.random()*10000; g.buildT=0; g.fadeT=0;
  g.riding=false; g.combo=0; g.foam=[];
  g.isBarrelWave=Math.random()<0.55; g.barrelOpen=0; g.tucked=false; g.tuckT=0; g.barrelScored=false;
  g.phase='building';
}
function surfPress(k){
  const g=surf; if(!g) return;
  if(g.phase==='lineup'){
    if(k==='A'){ surfStartWave(); }
    else if(k==='B'){ surfResults(); }
    return;
  }
  if(g.phase==='results'){ exitSurf(); return; }
  if(g.phase==='building'){ if(k==='A'||k==='B'){ g.riding=true; g.phase='drop'; surfAdd(50, SURF_TRICKS.drop); } return; }
  if(g.phase!=='drop' || g.inAir) return;
  if(k==='B'){
    g.dir=-g.dir; g.cutFlash=220; g.combo+=1;
    surfAdd(30+g.combo*10, SURF_TRICKS.cutback+' ×'+g.combo);
  }
  if(k==='A'){
    if(g.tucked) return;                       // no airs from inside the tube
    if(g.surferY<0.22){ g.inAir=true; g.airT=0; g.combo+=1; surfAdd(100+g.combo*25, SURF_TRICKS.air); }
    else surfFlash(SURF_TRICKS.missLip, 0);
  }
}
function surfResults(){
  const g=surf; g.phase='results';
  g.tier = SURF_TIERS.find(t=>g.score>=t.min);
  if(!g.awarded){
    g.awarded=true;
    gold += g.tier.gold; gainXp(g.tier.xp); if(g.tier.sp) player.skillPoints += g.tier.sp;
    g.newBest = g.score > (player.surfBest||0);
    if(g.newBest) player.surfBest = g.score;
  }
}
function exitSurf(){
  const g=surf;
  place = { kind:'overworld' };
  player.x=g.return.x; player.y=g.return.y; player.dir='up';
  const t=g.tier||SURF_TIERS[SURF_TIERS.length-1];
  showBanner(`🏄 <b style="color:${t.col}">${t.name}</b> — ${g.score} GRACE<br><span style="font-size:7px">+${t.gold}g · +${t.xp} XP${t.sp?` · ⭐ +${t.sp} skill point`:''}${g.newBest?' · <b style="color:#ffe04a">NEW BEST!</b>':''}</span>`, 3400);
  surf=null; saveGame();
}
function updateSurf(dt){
  const g=surf; if(!g) return;
  const t=performance.now();
  if(g.phase==='building'){ g.buildT+=dt; if(g.buildT>4500){ g.riding=true; g.phase='drop'; } }
  if(g.phase==='drop'){
    g.waveLife+=dt;
    if(g.isBarrelWave){ const cyc=(Math.sin(g.waveLife*0.0013)*0.5+0.5); g.barrelOpen=Math.max(0,cyc-0.35)/0.65; }
    else g.barrelOpen=0;
    if(g.inAir){
      g.airT+=dt;
      if(g.airT>=700){ g.inAir=false; g.surferY=0.3; surfAdd(40, SURF_TRICKS.land); }
    } else {
      const sp=0.0011*dt;
      if(held.up) g.surferY-=sp;
      if(held.down) g.surferY+=sp;
      if(held.left) g.surferX-=sp*1.1;
      if(held.right) g.surferX+=sp*1.1;
      if(g.cutFlash>0){ g.cutFlash-=dt; g.surferX+=g.dir*0.0016*dt; }
      else g.surferX+=g.dir*0.00018*dt;
      g.surferX=Math.max(0.06,Math.min(0.94,g.surferX));
      g.surferY=Math.max(0.05,Math.min(0.92,g.surferY));
      // tuck into the barrel: tube open, high on the face, in the pocket
      const inPocket = g.surferY<0.34 && g.surferX<0.5;
      const tubeOpen = g.barrelOpen>0.35;
      const was=g.tucked;
      g.tucked = tubeOpen && inPocket;
      if(g.tucked){
        g.tuckT+=dt;
        if(!g.barrelScored && g.tuckT>250){ g.barrelScored=true; g.combo+=1; g.barrelsMade+=1; surfAdd(150+g.combo*20, SURF_TRICKS.barrel); }
        if(Math.random()<0.06) surfAdd(3);
      } else {
        if(was && g.barrelScored && g.tuckT>250) surfAdd(60, 'MADE IT OUT!');
        g.tuckT=0; g.barrelScored=false;
      }
      if(g.surferY<0.3 && Math.random()<0.04) surfAdd(2);
    }
    if(Math.random()<0.5) g.foam.push({x:g.surferX, y:g.surferY, vx:-g.dir*(0.4+Math.random()), life:1});
    if(g.waveLife>g.waveDur){ g.fadeT=0; g.tucked=false; g.phase='fade'; }
  }
  if(g.phase==='fade'){
    g.fadeT+=dt;
    if(g.fadeT>1600){
      g.wavesRidden+=1;
      if(g.wavesRidden>=SURF_WAVES_PER_SESSION) surfResults();
      else g.phase='lineup';
    }
  }
  g.foam.forEach(f=>{ f.x+=f.vx*0.004; f.life-=dt/700; });
  g.foam=g.foam.filter(f=>f.life>0).slice(-60);
  if(g.trick){ g.trick.t-=dt; if(g.trick.t<=0) g.trick=null; }
}
function surfShade(hex,f){
  if(f>=1) return hex;
  const c=parseInt(hex.slice(1),16);
  const r=Math.round(((c>>16)&255)*(0.4+0.6*f)), gg=Math.round(((c>>8)&255)*(0.4+0.6*f)), b=Math.round((c&255)*(0.4+0.6*f));
  return `rgb(${r},${gg},${b})`;
}
function drawSurf(){
  const g=surf; if(!g) return;
  const t=performance.now();
  const SW=VW, SH=VH;
  const mapY=(y01,waveTop)=>{ const top=waveTop+SH*0.05, bot=SH-SH*0.075; return top+(bot-top)*y01; };
  // sky
  const _sc=(drawSurf._c=drawSurf._c||{});           // gradient cache: no per-frame allocs
  if(_sc.k!==SW+'x'+SH){ _sc.k=SW+'x'+SH;
    _sc.sky=ctx.createLinearGradient(0,0,0,SH);
    _sc.sky.addColorStop(0,'#2a1a4a'); _sc.sky.addColorStop(0.5,'#5a3a7a'); _sc.sky.addColorStop(1,'#c98a6a');
    _sc.vg=ctx.createRadialGradient(SW/2,SH/2,SH*0.3,SW/2,SH/2,SH*0.75);
    _sc.vg.addColorStop(0,'rgba(0,0,0,0)'); _sc.vg.addColorStop(1,'rgba(10,0,30,0.45)');
  }
  const sky=_sc.sky;
  ctx.fillStyle=sky; ctx.fillRect(0,0,SW,SH);
  ctx.fillStyle='#f4c87a'; ctx.beginPath(); ctx.arc(SW*0.72,SH*0.36,SH*0.07,0,7); ctx.fill();
  const horizon=SH*0.42;
  let build=1;
  if(g.phase==='building') build=0.45+Math.min(0.55,g.buildT/4500*0.55);
  if(g.phase==='lineup'||g.phase==='results') build=0.4;
  let fade=1;
  if(g.phase==='fade') fade=Math.max(0,1-g.fadeT/1600);
  const waveTop=horizon-SH*0.094*build;
  // back wall
  ctx.fillStyle=surfShade('#1e5a8a',fade); ctx.beginPath(); ctx.moveTo(0,SH);
  for(let x=0;x<=SW;x+=8){ const p=x/SW; const roll=Math.sin(p*Math.PI*1.1-t*0.0016)*SH*0.031*build; const lift=(1-p)*SH*0.081*build;
    ctx.lineTo(x, waveTop+roll-lift+SH*0.125*(1-build)); }
  ctx.lineTo(SW,SH); ctx.closePath(); ctx.fill();
  // face
  const fg=ctx.createLinearGradient(0,waveTop,0,SH);
  fg.addColorStop(0,surfShade('#3aa0c8',fade)); fg.addColorStop(0.5,surfShade('#1d6fa0',fade)); fg.addColorStop(1,surfShade('#0c3a60',fade));
  ctx.fillStyle=fg; ctx.beginPath(); ctx.moveTo(0,SH);
  for(let x=0;x<=SW;x+=8){ const p=x/SW; const roll=Math.sin(p*Math.PI*1.1-t*0.0016)*SH*0.025*build; const lift=(1-p)*SH*0.056*build;
    ctx.lineTo(x, waveTop+SH*0.056+roll-lift+SH*0.125*(1-build)); }
  ctx.lineTo(SW,SH); ctx.closePath(); ctx.fill();
  // barrel tube
  if(g.phase==='drop' && g.isBarrelWave && g.barrelOpen>0.1){
    const open=g.barrelOpen, tcx=SW*0.30, tcy=waveTop+SH*0.106, tw=SW*0.25*open, th=SH*0.219*open;
    ctx.fillStyle=`rgba(6,26,46,${0.85*fade})`;
    ctx.beginPath(); ctx.ellipse(tcx,tcy,tw*0.55,th*0.6,0,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle=surfShade('#eaf6ff',fade); ctx.lineWidth=6*open;
    ctx.beginPath(); ctx.ellipse(tcx,tcy,tw*0.62,th*0.7,0,Math.PI*1.05,Math.PI*2.05); ctx.stroke();
    ctx.fillStyle=surfShade('#cfe6ff',fade);
    for(let i=0;i<8;i++){ const a=Math.PI*1.1+(i/8)*Math.PI*0.9;
      const bx=tcx+Math.cos(a)*tw*0.6, by=tcy+Math.sin(a)*th*0.68+((t*0.05+i*9)%20);
      ctx.beginPath(); ctx.arc(Math.round(bx),Math.round(by),2,0,7); ctx.fill(); }
  }
  // crashing foam lip
  const curlX=(Math.sin(t*0.0011)*0.5+0.5)*SW*0.5;
  ctx.fillStyle=surfShade('#eaf6ff',fade);
  for(let i=0;i<26;i++){ const x=curlX-i*5+Math.sin(t*0.004+i)*3; const p=Math.max(0,Math.min(1,x/SW));
    const lift=(1-p)*SH*0.081*build; const y=waveTop-lift+SH*0.125*(1-build)+Math.sin(i*1.3+t*0.005)*4;
    if(x>0){ ctx.beginPath(); ctx.arc(Math.round(x),Math.round(y),4-(i%3),0,7); ctx.fill(); } }
  // foam trail
  g.foam.forEach(f=>{ const fx=f.x*SW, fy=mapY(f.y,waveTop);
    ctx.fillStyle=`rgba(235,246,255,${f.life*0.8*fade})`;
    ctx.beginPath(); ctx.arc(Math.round(fx),Math.round(fy),2+f.life*2,0,7); ctx.fill(); });
  // surfer
  const drawRider=(x,y,dir,inAir,airT,f)=>{
    ctx.save(); ctx.translate(x,y); ctx.scale(dir,1);
    if(inAir) ctx.rotate(-Math.sin((airT/700)*Math.PI)*0.5);
    ctx.fillStyle=surfShade('#e0b050',f); ctx.fillRect(-12,8,24,4);
    ctx.fillStyle=surfShade('#2a2050',f); ctx.fillRect(-6,0,5,9); ctx.fillRect(2,0,5,9);
    ctx.fillStyle=surfShade('#4a3a8a',f); ctx.fillRect(-5,-10,10,12);
    ctx.fillStyle=surfShade('#f0c89a',f); ctx.fillRect(-3,-16,6,6);
    ctx.fillStyle=surfShade('#e8e0d0',f); ctx.fillRect(4,-8,9,3);
    ctx.restore();
  };
  if(g.phase==='building'||g.phase==='lineup'||g.phase==='results'){
    const sx=SW*0.5, sy=(g.phase==='building')?waveTop+14+Math.sin(t*0.004)*2:horizon+30+Math.sin(t*0.004)*3;
    ctx.fillStyle=surfShade('#d8a04a',fade); ctx.fillRect(sx-10,sy+10,20,4);
    ctx.fillStyle=surfShade('#3a2a6a',fade); ctx.fillRect(sx-4,sy-6,8,16);
    ctx.fillStyle=surfShade('#f0c89a',fade); ctx.fillRect(sx-3,sy-12,6,6);
  } else {
    const sx=g.surferX*SW; let sy=mapY(g.surferY,waveTop);
    if(g.inAir) sy-=Math.sin((g.airT/700)*Math.PI)*SH*0.144;
    drawRider(sx,sy,g.dir,g.inAir,g.airT,fade*(g.tucked?0.7:1));
  }
  // vignette
  const vg=_sc.vg;
  ctx.fillStyle=vg; ctx.fillRect(0,0,SW,SH);
  // ── HUD ──
  ctx.textAlign='left'; ctx.font='7px "Press Start 2P"'; ctx.fillStyle='#eaf6ff';
  ctx.fillText('GRACE '+String(g.score).padStart(5,'0'), 8, 14);
  ctx.textAlign='right';
  ctx.fillText('WAVE '+Math.min(g.wavesRidden+1,SURF_WAVES_PER_SESSION)+'/'+SURF_WAVES_PER_SESSION, SW-8, 14);
  if(player.surfBest){ ctx.fillStyle='#9a8ab8'; ctx.fillText('BEST '+player.surfBest, SW-8, 26); }
  if(g.combo>1){ ctx.textAlign='center'; ctx.fillStyle='#f4c87a'; ctx.fillText('COMBO ×'+g.combo, SW/2, 14); }
  if(g.tucked){ ctx.textAlign='center'; ctx.fillStyle=(Math.floor(t/350)%2)?'#8ef0ff':'#cfe6ff'; ctx.fillText('✝ IN THE NARROW WAY ✝', SW/2, 28); }
  if(g.trick){ ctx.textAlign='center'; const a=Math.min(1,g.trick.t/300);
    ctx.globalAlpha=a; ctx.fillStyle='#f4c87a'; ctx.font='9px "Press Start 2P"';
    ctx.fillText(g.trick.text+(g.trick.pts>0?' +'+g.trick.pts:''), SW/2, SH*0.34); ctx.globalAlpha=1; }
  // phase overlays
  ctx.textAlign='center';
  if(g.phase==='lineup'){
    ctx.fillStyle='rgba(10,5,30,0.45)'; ctx.fillRect(0,0,SW,SH);
    ctx.fillStyle='#eaf6ff'; ctx.font='11px "Press Start 2P"'; ctx.fillText('IN THE LINEUP', SW/2, SH*0.42);
    ctx.fillStyle='#c8b8d8'; ctx.font='7px "Press Start 2P"'; ctx.fillText('a set is rolling in…', SW/2, SH*0.50);
    ctx.fillStyle='#f4c87a'; ctx.fillText('Ⓐ paddle out  ·  Ⓑ back to shore', SW/2, SH*0.62);
  }
  if(g.phase==='building'){
    ctx.fillStyle=(Math.floor(t/450)%2)?'#f4c87a':'#ffe9c0'; ctx.font='7px "Press Start 2P"';
    ctx.fillText((g.isBarrelWave?'A BARREL IS FORMING — ':'WAVE BUILDING — ')+'Ⓐ DROP IN', SW/2, SH-12);
  }
  if(g.phase==='fade'){
    ctx.fillStyle='#eaf6ff'; ctx.font='10px "Press Start 2P"'; ctx.fillText('WAVE CLOSED OUT', SW/2, SH*0.44);
    ctx.fillStyle='#c8b8d8'; ctx.font='7px "Press Start 2P"'; ctx.fillText('paddling back…', SW/2, SH*0.52);
  }
  if(g.phase==='results' && g.tier){
    ctx.fillStyle='rgba(8,4,18,0.82)'; ctx.fillRect(0,0,SW,SH);
    ctx.fillStyle='#9a8ab8'; ctx.font='7px "Press Start 2P"'; ctx.fillText('THE SET ENDS — '+g.wavesRidden+' WAVE'+(g.wavesRidden===1?'':'S')+' RIDDEN', SW/2, SH*0.24);
    ctx.fillStyle='#eaf6ff'; ctx.font='9px "Press Start 2P"'; ctx.fillText(String(g.score)+' GRACE', SW/2, SH*0.34);
    ctx.fillStyle=g.tier.col; ctx.font='11px "Press Start 2P"'; ctx.fillText(g.tier.name, SW/2, SH*0.46);
    ctx.fillStyle='#c8b8d8'; ctx.font='6px "Press Start 2P"'; ctx.fillText(g.tier.line, SW/2, SH*0.54);
    ctx.fillStyle='#ffe04a'; ctx.font='7px "Press Start 2P"';
    ctx.fillText('+'+g.tier.gold+'g  ·  +'+g.tier.xp+' XP'+(g.tier.sp?'  ·  ⭐+'+g.tier.sp+' SKILL PT':''), SW/2, SH*0.64);
    if(g.newBest){ ctx.fillStyle=(Math.floor(t/350)%2)?'#ffe04a':'#fff'; ctx.fillText('★ NEW PERSONAL BEST ★', SW/2, SH*0.72); }
    ctx.fillStyle='#f4c87a'; ctx.fillText('Ⓐ collect & return to shore', SW/2, SH*0.84);
  }
}

// ════════════════════════════════════════════════════════════════
//  🐎 THE KING'S TOURNEY — horse race minigame (vanilla-JS port)
// ════════════════════════════════════════════════════════════════
/* =====================================================================
 * THE KING'S TOURNEY — Horse Race minigame (vanilla-JS port)
 * ===================================================================== */
(function (global) {
  'use strict';
  var C = {
    bg: "#0e0b14", panel: "#1a1320", panelLight: "#241a2e",
    ink: "#e8e0d0", inkDim: "#9a8fa6",
    gold: "#d4af37", goldDim: "#8a7228",
    blood: "#7a1f2b", bloodLit: "#b8323f",
    track: "#6b5740", trackEdge: "#3a2e22",
    grass: "#243018", grassDark: "#1a2410",
    white: "#f4eede", shadow: "#06040a",
    rock: "#5a5460"
  };
  var HORSES = [
    { id: "tempest", name: "Tempest", color: "#4a5a7a", mane: "#1f2a40", topSpeed: 3.5,  accel: 0.055, handling: 0.072, blurb: "Swift as the north wind." },
    { id: "ember",   name: "Ember",   color: "#9a4528", mane: "#4a1f10", topSpeed: 3.2,  accel: 0.070, handling: 0.082, blurb: "Quick off the gate, sure-footed." },
    { id: "psalm",   name: "Psalm",   color: "#d8d0c0", mane: "#a89878", topSpeed: 3.35, accel: 0.060, handling: 0.092, blurb: "Turns like a prayer." },
    { id: "raven",   name: "Raven",   color: "#3a3040", mane: "#15101a", topSpeed: 3.45, accel: 0.052, handling: 0.068, blurb: "Dark and relentless." }
  ];
  var LAPS = 3;
  var DEFAULT_RECORD_MS = 60000;
  var RECORD_ITEM = "Seraph's Pet Barding";
  var W = 1000, H = 700;
  var CX = W / 2, CY = H / 2;
  // _legacy: RX_OUT=450, RY_OUT=300, RX_IN=170, RY_IN=110 — a 280x190 lane that
  //   punished the smallest wobble. Wider oval, and a much broader lane to ride in.
  //   The world is 1000x700 with the centre at 500,350 — an outer radius of 560
  //   ran the track off the right-hand edge, which is why a wide line still put
  //   you on the grass. 470x330 fills the field with a margin.
  var RX_OUT = 470, RY_OUT = 330;
  var RX_IN = 150, RY_IN = 95;
  // Kart feel: full turning circle up to TURN_FULL_AT of top speed, opening out
  // to TURN_AT_SPEED of it at a flat gallop. GRIP is how fast the direction of
  // travel chases the heading — lower is looser, higher is on rails.
  var TURN_FULL_AT = 0.45, TURN_AT_SPEED = 0.55, GRIP = 7.0;
  var RX_MID = (RX_OUT + RX_IN) / 2;
  var RY_MID = (RY_OUT + RY_IN) / 2;
  var FEATURES = [
    { type: "ramp", a: 0.5, lane: 0 },
    { type: "rock", a: 1.4, lane: -0.5 },
    { type: "ramp", a: 2.5, lane: 0.3 },
    { type: "rock", a: 3.3, lane: 0.4 },
    { type: "rock", a: 4.1, lane: -0.4 },
    { type: "ramp", a: 5.0, lane: -0.2 }
  ];
  var HORIZON = H * 0.40;
  var CAM_HEIGHT = 46;
  var CAM_BACK = 70;
  var FOCAL = 480;
  if (typeof global.raceRecordMs !== "number") global.raceRecordMs = DEFAULT_RECORD_MS;
  global.race = null;
  function featurePos(f) {
    var rx = RX_MID + f.lane * ((RX_OUT - RX_IN) / 2 - 30);
    var ry = RY_MID + f.lane * ((RY_OUT - RY_IN) / 2 - 30);
    return { x: CX + Math.cos(f.a) * rx, y: CY + Math.sin(f.a) * ry };
  }
  function onTrack(x, y) {
    var ox = (x - CX) / RX_OUT, oy = (y - CY) / RY_OUT;
    var ix = (x - CX) / RX_IN, iy = (y - CY) / RY_IN;
    return (ox * ox + oy * oy) <= 1 && (ix * ix + iy * iy) >= 1;
  }
  // exposed so the gate can MEASURE the handling curve rather than read the source
  global.__raceTurn = function(spdFrac){
    var _e = spdFrac<=TURN_FULL_AT ? 1
           : 1 - (1-TURN_AT_SPEED) * ((spdFrac-TURN_FULL_AT)/(1-TURN_FULL_AT));
    return 1.35 * _e;
  };
  global.__raceTrack = { out:RX_OUT, in:RX_IN, outY:RY_OUT, inY:RY_IN, grip:GRIP };
  function norm(a) { while (a > Math.PI) a -= Math.PI * 2; while (a < -Math.PI) a += Math.PI * 2; return a; }
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
  function fmt(ms) {
    var s = ms / 1000;
    var mm = Math.floor(s / 60);
    var ss = (s % 60).toFixed(2);
    if (ss.length < 5) ss = "0" + ss;
    return mm + ":" + ss;
  }
  function horseById(id) {
    for (var i = 0; i < HORSES.length; i++) if (HORSES[i].id === id) return HORSES[i];
    return HORSES[0];
  }
  function startRace(opts) {
    opts = opts || {};
    if (typeof opts.record === "number") global.raceRecordMs = opts.record;
    if (typeof global.raceRecordMs !== "number") global.raceRecordMs = DEFAULT_RECORD_MS;
    global.race = {
      phase: "select", chosenIdx: 1, countdown: 3, countdownTimer: 0,
      elapsed: 0, anim: 0, racers: null, places: 0, result: null,
      input: { up: false, left: false, right: false, upRelease: 0 },
      view: "chase"
    };
  }
  function exitRace() {
    var payload = { finished: false, placed: 0, gold: 0, item: null };
    if (typeof global.finishRace === "function") global.finishRace(payload);
    global.race = null;
  }
  function buildRacers(chosenId) {
    var startAngle = -Math.PI / 2;
    var racers = [];
    for (var idx = 0; idx < HORSES.length; idx++) {
      var h = HORSES[idx];
      var isPlayer = h.id === chosenId;
      var lane = -0.45 + idx * 0.3;
      var rx = RX_MID + lane * ((RX_OUT - RX_IN) / 2 - 20);
      var ry = RY_MID + lane * ((RY_OUT - RY_IN) / 2 - 20);
      var a = startAngle - 0.04 * idx;
      var px = CX + Math.cos(a) * rx;
      var py = CY + Math.sin(a) * ry;
      racers.push({
        id: h.id, name: h.name, color: h.color, mane: h.mane, isPlayer: isPlayer, stats: h,
        x: px, y: py, heading: a + Math.PI / 2,
        speed: 0, lap: 0, progress: 0, prevAng: Math.atan2(py - CY, px - CX),
        air: 0, boost: 0, hitCooldown: 0, _lean: 0,
        finished: false, finishTime: 0, place: 0,
        aiSkill: isPlayer ? 0 : 0.86 + 0.035 * idx,
        aiLane: isPlayer ? 0 : (Math.random() * 2 - 1) * 0.5
      });
    }
    return racers;
  }
  function beginCountdown() {
    var R = global.race;
    R.racers = buildRacers(HORSES[R.chosenIdx].id);
    R.places = 0; R.elapsed = 0; R.countdown = 3; R.countdownTimer = 0; R.phase = "countdown";
  }
  // True press-and-hold for racing: keydown/touchstart → on, keyup/touchend → off.
  // Holding UP keeps the throttle on (no more tapping). Steering holds too.
  function raceHold(dir, on) {
    var R = global.race;
    if (!R || R.phase !== "race") return;
    // Set the held state directly and clear the auto-release timer so it never decays
    // out from under a held button (that was the "burst then stop" bug).
    if (dir === "UP")        { R.input.up = on;    R.input.upRelease = 0; }
    else if (dir === "LEFT") { R.input.left = on;  R.input.leftRelease = 0; }
    else if (dir === "RIGHT"){ R.input.right = on; R.input.rightRelease = 0; }
  }
  function racePress(key) {
    var R = global.race;
    if (!R) return;
    if (R.phase === "select") {
      if (key === "LEFT")  R.chosenIdx = (R.chosenIdx + HORSES.length - 1) % HORSES.length;
      else if (key === "RIGHT") R.chosenIdx = (R.chosenIdx + 1) % HORSES.length;
      else if (key === "A") beginCountdown();
      else if (key === "B") exitRace();
      return;
    }
    if (R.phase === "countdown") return;
    if (R.phase === "race") {
      // UP/LEFT/RIGHT during the race are handled by raceHold (true press-and-hold);
      // racePress only toggles the camera (A) or quits (B) here.
      if (key === "A")      { R.view = (R.view === "chase") ? "top" : "chase"; }
      else if (key === "B") { exitRace(); }
      return;
    }
    if (R.phase === "finish") {
      if (key === "A") {
        if (typeof global.finishRace === "function") global.finishRace(R.result);
        global.race = null;
      } else if (key === "B") { R.result = null; R.phase = "select"; }
      return;
    }
  }
  function raceTick(dt) {
    var R = global.race;
    if (!R) return;
    if (!dt || dt <= 0) dt = 1;
    if (dt > 2.4) dt = 2.4;
    var dtMs = dt * 16.6667;
    R.anim += dtMs;
    var inp = R.input;
    if (inp.upRelease > 0)   { inp.upRelease   -= dtMs; if (inp.upRelease   <= 0) inp.up = false; }
    if (inp.leftRelease > 0) { inp.leftRelease -= dtMs; if (inp.leftRelease <= 0) inp.left = false; }
    if (inp.rightRelease > 0){ inp.rightRelease-= dtMs; if (inp.rightRelease<= 0) inp.right = false; }
    if (R.phase === "countdown") {
      R.countdownTimer += dtMs;
      if (R.countdownTimer >= 800) {
        R.countdownTimer -= 800; R.countdown -= 1;
        if (R.countdown <= 0) { R.phase = "race"; R.elapsed = 0; }
      }
      return;
    }
    if (R.phase !== "race") return;
