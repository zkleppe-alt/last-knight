// baked sprites, keyed id+form+frame+facing. Built lazily; the cache survives
// resize() because it lives on its own canvases, not on the main context.
const PET_SPRITE_CACHE = {};
function petSprite(key, frame, mirror){
  const ck = key + frame + (mirror ? 'R' : 'L');
  if(PET_SPRITE_CACHE[ck]) return PET_SPRITE_CACHE[ck];
  const art = PET_ART[key]; if(!art) return null;
  const pal = PET_PAL[art.pal], rows = art.f[frame] || art.f[0];
  const W = PET_ART_W;
  const oc = document.createElement('canvas'); oc.width = W; oc.height = W;
  const oct = oc.getContext('2d');
  for(let ry=0; ry<W; ry++){
    const row = rows[ry]; if(!row) continue;
    // horizontal run-length: one fillRect per run of equal tone, not per unit
    let rx = 0;
    while(rx < W){
      const c = row[rx];
      if(!c || c === '.'){ rx++; continue; }
      let end = rx; while(end+1 < W && row[end+1] === c) end++;
      const col = pal[c];
      if(col){ oct.fillStyle = col;
        const lx = mirror ? (W - 1 - end) : rx;
        oct.fillRect(lx, ry, end - rx + 1, 1); }
      rx = end + 1;
    }
  }
  PET_SPRITE_CACHE[ck] = oc;
  return oc;
}

// Draws into the SAME 24x24 game-px footprint as drawSteedFollow, at (x-4,y-8).
function drawPetSprite(x, y, key, frame, mirror, bob){
  const oc = petSprite(key, frame, mirror); if(!oc) return false;
  ctx.drawImage(oc, x-4, y-8+(bob||0), 24, 24);
  return true;
}

function drawPet(x,y){
  const f=petForm(); if(!f) return;
  // face and frame are needed by BOTH branches now: the pre-steed forms have
  // real pixel art too, so these are hoisted above the ability fork. They used
  // to live inside it, which is why forms 0-1 never had a facing or a walk cycle.
  const face=(player.x < player.petX)?'left':'right';
  const frm=(f.ability==='fly') ? ((Date.now()>>8)&1)
           : (player.petMoving ? ((Date.now()>>7)&1) : 1);   // gathered legs at rest
  if(f.ability){ // final-form steeds get pixel sprites
    if(player.mountSkin==='spectral'){ ctx.globalAlpha=0.82;
      const oc=drawSteedSpectral((cx,cy)=>drawSteedFollow(cx,cy,player.pet.id,face,frm)); ctx.drawImage(oc,x-24,y-24); ctx.globalAlpha=1; }
    else drawSteedFollow(x,y,player.pet.id,face,frm);
    return;
  }
  const bob=player.petMoving?Math.round(Math.sin(Date.now()*0.012)*1.5):0;
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,5,2,0,0,7); ctx.fill();
  // _legacy: this branch was ctx.fillText(f.emoji,…) with no facing and no walk
  // cycle. Pixel art now, keyed id+form; the emoji stays as a live fallback for
  // any form that has no art yet rather than drawing nothing.
  const petKey=(player.pet&&player.pet.id)+((player.pet&&player.pet.form)|0);
  if(drawPetSprite(x,y,petKey,frm,face==='right',bob)) return;
  ctx.font='14px serif'; ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.fillText(f.emoji, x+TILE/2, y+TILE/2+bob);
  ctx.textAlign='left'; ctx.textBaseline='alphabetic';
}

// ══════════════════════════════════════════════════════════════════════
//  VISIBLE WEAPONS — the equipped weapon is drawn on the knight.
//
//  Seven silhouette FAMILIES; the palette varies per item within a family.
//  Art is authored on a HALF-PIXEL grid (1 art unit = 0.5 game px), which
//  RENDER_SCALE=2 resolves exactly — anything finer would not survive the
//  backing store. All of it lands inside the sprite's existing footprint
//  except the long weapons, which overhang to the right by design.
//
//  Poses: down (3/4, hand at game 13,10) · left profile (hand at 1,9) ·
//  up (back — differentiated by the TERMINAL shape above the shoulder,
//  since the body occludes everything below it). Right is the left pose
//  mirrored by drawKnightBodyR, which works on fractional coords too.
// ══════════════════════════════════════════════════════════════════════
const WEAPON_ART = {
  none_w:      { fam:'fist',   bulk:0, pal:{ B:'#c9cdd6', H:'#eef0f4', D:'#9096a2', E:'#6d7280' } },
  ring_lydia:  { fam:'fist',   bulk:1, gem:'#8ad8ea',
                 pal:{ B:'#e8b93a', H:'#ffe89a', D:'#a8842a', E:'#7a5c18' } },
  gaunt_caleb: { fam:'fist',   bulk:2,
                 pal:{ B:'#5aa8c8', H:'#a6e6f4', D:'#2f6a88', E:'#1d4a62' } },

  // the starting blade — pitted, dull, barely serviceable
  rusty:       { fam:'light',  len:9,  w0:4,
                 pal:{ B:'#8f8578', H:'#b6ab99', D:'#5f5648', E:'#3d372c',
                       G:'#7a6a4a', GD:'#4e4230', GR:'#5a4028', GRD:'#33230f', P:'#8a7a58' } },
  shortsword:  { fam:'light',  len:11, w0:5,
                 pal:{ B:'#d8dce6', H:'#ffffff', D:'#8a92a2', E:'#5f6674',
                       G:'#b8b0a0', GD:'#7d7668', GR:'#6a4a2a', GRD:'#432c17', P:'#c4bcac' } },
  ironsword:   { fam:'light',  len:14, w0:5,
                 pal:{ B:'#e8e8f0', H:'#ffffff', D:'#9aa2b2', E:'#666e7e',
                       G:'#d8b24a', GD:'#9a7622', GR:'#7a4a24', GRD:'#4b2c13', P:'#c9a94a' } },

  greatsword:  { fam:'heavy',  len:15, w0:10, step:1.0, lenL:16, w0L:7,
                 pal:{ B:'#eceef6', H:'#ffffff', D:'#8f97a8', E:'#5a6272',
                       G:'#c8b060', GD:'#8a7128', GR:'#5a3a1e', GRD:'#38220f', P:'#d8c070' } },
  sword_gideon:{ fam:'heavy',  len:9,  w0:7,  step:1.7, lenL:12, w0L:6, flare:true,
                 pal:{ B:'#f4e6ba', H:'#fffbe8', D:'#c0a050', E:'#8a6f2c',
                       G:'#e8b93a', GD:'#a8842a', GR:'#6a4a2a', GRD:'#42290f', P:'#f2c14e' } },

  warhammer:   { fam:'hammer',
                 pal:{ B:'#9aa0ac', H:'#ccd2da', D:'#6a7080', E:'#454b58',
                       G:'#8a5a2c', GD:'#5a3418', GR:'#7a4a24', GRD:'#4a2c12', P:'#9aa0ac' } },

  staff_aiden: { fam:'haft',
                 pal:{ B:'#a87a44', H:'#d0a066', D:'#7a5428', E:'#4e3416',
                       G:'#c8b090', GD:'#8a7458', GR:'#a87a44', GRD:'#7a5428', P:'#c89a60' } },

  holyblade:   { fam:'radiant', len:15, w0:6, glow:'#ffd86a',
                 pal:{ B:'#fff8dc', H:'#ffffff', D:'#e8cc78', E:'#b9973a',
                       G:'#ffd86a', GD:'#c8a02a', GR:'#8a6a2a', GRD:'#5a4418', P:'#ffe89a' } },

  bow_samuel:  { fam:'bow',
                 pal:{ B:'#a87a44', H:'#d8b070', D:'#6a4a24', E:'#412a12',
                       ST:'#e8e8f0', G:'#c8b090', GR:'#6a4a24', GRD:'#412a12' } },
};
function weaponArtFor(id){ return WEAPON_ART[id] || WEAPON_ART.rusty; }

// ── primitives, all in HALF-PIXEL units ──
function _wq(P){ return (ax,ay,aw,ah,c)=>P(ax/2,ay/2,aw/2,ah/2,c); }

// tapered blade walking a diagonal, with a fuller groove and a lit edge
function _wBlade(Q,p,x0,y0,stepx,len,w0,w1,opt){
  opt=opt||{};
  for(let i=0;i<len;i++){
    const t=i/(len-1), w=Math.max(1,Math.round(w0+(w1-w0)*t));
    const x=x0+Math.round(i*stepx), y=y0-i;
    Q(x,y,w,1,p.B); Q(x,y,1,1,p.H);
    if(w>=3) Q(x+w-1,y,1,1,p.D);
    if(opt.fuller && w>=4 && i>1 && i<len-3) Q(x+((w/2)|0),y,1,1,p.D);
    if(opt.ricasso && i<2 && w>=4) Q(x+1,y,w-2,1,p.E);
  }
  const tx=x0+Math.round(len*stepx), ty=y0-len;
  Q(tx,ty,2,1,p.B); Q(tx,ty,1,1,p.H); Q(tx+(stepx>=2?1:0),ty-1,1,1,p.H);
}
function _wGuard(Q,p,cx,cy,span,sweep){
  Q(cx-span,cy,span*2+2,1,p.G); Q(cx-span,cy+1,span*2+2,1,p.GD);
  if(sweep){ Q(cx-span-1,cy-1,2,2,p.G); Q(cx-span-1,cy-1,1,1,p.GD);
             Q(cx+span+1,cy-1,2,2,p.G); Q(cx+span+1,cy,1,1,p.GD); }
  Q(cx,cy-1,2,1,p.G);
}
function _wGrip(Q,p,x,y,len){ for(let i=0;i<len;i++) Q(x,y+i,2,1,i%2?p.GRD:p.GR); }
function _wPommel(Q,p,x,y){
  Q(x,y,2,2,p.P); Q(x,y,1,1,p.G); Q(x+1,y+1,1,1,p.GD);
  Q(x-1,y,1,1,p.GD); Q(x+2,y,1,1,p.GD);
}
function _wShaft(Q,p,x0,y0,stepx,len,w){
  for(let i=0;i<len;i++){
    const x=x0+Math.round(i*stepx), y=y0-i;
    Q(x,y,w,1,p.GR); Q(x,y,1,1,p.H); Q(x+w-1,y,1,1,p.GRD);
    if(i%4===2 && w>=3) Q(x+1,y,1,1,p.D);
  }
}

// ── DOWN (3/4). hand at game (13,10) => art (26,20) ──
function drawWeaponDown(P,w){
  const Q=_wq(P), p=w.pal, F=w.fam, hx=26, hy=20;
  if(F==='fist'){
    if(w.bulk===0) return;
    if(w.bulk===1){ Q(hx-2,hy,5,1,p.B); Q(hx-2,hy,1,1,p.H); Q(hx+2,hy,1,1,p.E);
                    Q(hx,hy-2,2,2,w.gem); Q(hx,hy-2,1,1,'#ffffff'); Q(hx+2,hy-3,1,1,'#ffffff'); return; }
    Q(hx-3,hy-4,8,8,p.B); Q(hx-3,hy-4,8,1,p.H); Q(hx-3,hy+3,8,1,p.E); Q(hx-3,hy-4,1,8,p.D);
    for(let k=0;k<3;k++){ Q(hx+1,hy-3+k*3,4,2,p.D); Q(hx+1,hy-3+k*3,4,1,p.H); }
    Q(hx+5,hy-6,2,5,p.H); Q(hx+5,hy-1,2,1,p.D); return;
  }
  if(F==='bow'){
    const bx=hx+2;
    const limb=[[-11,1],[-9,2],[-7,3],[-5,3],[-3,3],[-1,2],[1,2],[3,3],[5,3],[7,3],[9,2],[11,1]];
    for(const L of limb){ Q(bx+L[1],hy+L[0],2,1,p.B); Q(bx+L[1],hy+L[0],1,1,p.H); Q(bx+L[1]+1,hy+L[0],1,1,p.D); }
    Q(bx,hy-13,2,1,p.E); Q(bx,hy+12,2,1,p.E);
    for(let y=hy-12;y<=hy+11;y++) Q(bx-1,y,1,1,p.ST);
    Q(bx+1,hy-2,3,5,p.GR); Q(bx+1,hy-2,1,5,p.H); Q(bx+1,hy,3,1,p.G); return;
  }
  _wGrip(Q,p,hx,hy,5); _wPommel(Q,p,hx,hy+5);
  if(F==='haft'){
    _wShaft(Q,p,hx,hy-2,1,13,3);
    const tx=hx+13, ty=hy-15;
    Q(tx,ty,4,2,p.GR); Q(tx,ty,4,1,p.H);
    Q(tx+3,ty-2,2,3,p.GR); Q(tx+3,ty-2,1,3,p.H); Q(tx+1,ty+2,3,1,p.G); return;
  }
  if(F==='hammer'){
    _wShaft(Q,p,hx,hy-2,1,12,3); Q(hx+3,hy-9,4,1,p.G);
    const tx=hx+8, ty=hy-20;
    Q(tx,ty,10,7,p.B); Q(tx,ty,10,1,p.H); Q(tx,ty+6,10,1,p.E); Q(tx,ty,1,7,p.D);
    Q(tx+1,ty+1,3,5,p.H); Q(tx+1,ty+2,3,3,p.D); Q(tx+8,ty+1,2,5,p.D); Q(tx+4,ty,1,7,p.E); return;
  }
  _wGuard(Q,p,hx,hy-3,F==='heavy'?5:3,true);
  if(F==='radiant'){ Q(hx-6,hy-3,14,1,p.G); Q(hx-6,hy-4,1,2,p.H); Q(hx+7,hy-4,1,2,p.H); }
  const stepx=w.step||(F==='heavy'?1.5:1), tipw=F==='heavy'?3:2;
  _wBlade(Q,p,hx-1,hy-5,stepx,w.len,w.w0,tipw,{fuller:true,ricasso:F==='heavy'});
  if(w.flare){
    const bx=hx-1+Math.round(w.len*stepx), by=hy-5-w.len;
    Q(bx-1,by-2,5,3,p.B); Q(bx-1,by-2,5,1,p.H); Q(bx+3,by-1,1,2,p.D);
  }
}

// ── LEFT profile. hand at game (1,9) => art (2,18) ──
function drawWeaponLeft(P,w){
  const Q=_wq(P), p=w.pal, F=w.fam, hx=2, hy=18;
  if(F==='fist'){
    if(w.bulk===0) return;
    if(w.bulk===1){ Q(hx+2,hy,3,1,p.B); Q(hx+2,hy-2,2,2,w.gem); Q(hx+2,hy-2,1,1,'#ffffff'); return; }
    Q(hx,hy-3,8,6,p.B); Q(hx,hy-3,8,1,p.H); Q(hx,hy+2,8,1,p.E);
    for(let k=0;k<3;k++){ Q(hx+k*3,hy-2,2,4,p.D); Q(hx+k*3,hy-2,2,1,p.H); }
    Q(hx,hy-5,2,3,p.H); return;
  }
  if(F==='bow'){
    const limb=[[-11,2],[-9,1],[-7,0],[-5,-1],[-3,-1],[-1,-1],[1,-1],[3,-1],[5,-1],[7,0],[9,1],[11,2]];
    for(const L of limb){ Q(hx+L[1],hy+L[0],2,1,p.B); Q(hx+L[1],hy+L[0],1,1,p.H); }
    Q(hx+2,hy-13,2,1,p.E); Q(hx+2,hy+12,2,1,p.E);
    for(let y=hy-12;y<=hy+11;y++) Q(hx+3,y,1,1,p.ST);
    Q(hx-1,hy-2,3,5,p.GR); Q(hx-1,hy-2,1,5,p.H); return;
  }
  _wGrip(Q,p,hx+4,hy,4); _wPommel(Q,p,hx+4,hy+4); _wGuard(Q,p,hx+4,hy-2,3,false);
  if(F==='haft'){
    for(let i=0;i<15;i++){ const x=hx+3-i, y=hy-4-((i*0.55)|0);
      Q(x,y,2,2,p.GR); Q(x,y,2,1,p.H); if(i%4===2) Q(x,y+1,1,1,p.D); }
    Q(hx-12,hy-12,4,2,p.GR); Q(hx-12,hy-12,4,1,p.H);
    Q(hx-13,hy-14,2,3,p.GR); Q(hx-13,hy-14,1,3,p.H); return;
  }
  if(F==='hammer'){
    for(let i=0;i<8;i++){ const x=hx+3-i, y=hy-4-i; Q(x,y,2,2,p.GR); Q(x,y,2,1,p.H); }
    Q(hx-12,hy-17,10,7,p.B); Q(hx-12,hy-17,10,1,p.H); Q(hx-12,hy-11,10,1,p.E);
    Q(hx-12,hy-16,3,5,p.H); Q(hx-11,hy-15,2,3,p.D);
    Q(hx-4,hy-16,2,5,p.D); Q(hx-8,hy-17,1,7,p.E); return;
  }
  const len = F==='heavy'?(w.lenL||14):(F==='radiant'?13:(w.len>=11?12:9));
  const w0  = F==='heavy'?(w.w0L||6):4;
  for(let i=0;i<len;i++){
    const t=i/(len-1), wd=Math.max(1,Math.round(w0+(2-w0)*t));
    const x=hx+3-i, y=hy-4-((i*0.5)|0);
    Q(x,y,2,wd,p.B); Q(x,y,2,1,p.H);
    if(wd>=3) Q(x,y+wd-1,2,1,p.D);
    if(wd>=4 && i>1 && i<len-3) Q(x,y+((wd/2)|0),2,1,p.D);
  }
  if(F==='radiant'){ Q(hx+4,hy-6,2,6,p.G); Q(hx+4,hy-6,2,1,p.H); }
  if(w.flare){ const ty=hy-4-((len*0.5)|0);
    Q(hx+2-len,ty-1,3,5,p.B); Q(hx+2-len,ty-1,3,1,p.H); }
}

// ── UP (back). The body occludes the lower blade, so the TERMINAL carries the read. ──
function drawWeaponUp(P,w){
  const Q=_wq(P), p=w.pal, F=w.fam, cx=5;
  if(F==='fist'){
    if(w.bulk===0) return;
    if(w.bulk===1){ Q(cx+1,14,2,1,p.B); Q(cx+1,12,2,2,w.gem); return; }
    Q(cx-1,9,6,7,p.B); Q(cx-1,9,6,1,p.H); Q(cx-1,15,6,1,p.E);
    Q(cx+1,10,3,2,p.D); Q(cx+1,13,3,2,p.D); return;
  }
  if(F==='bow'){
    const limb=[[2,2],[3,1],[4,0],[5,0],[6,0],[7,0],[8,0],[9,0],[10,0],[11,1],[12,2],[13,3]];
    for(const L of limb){ Q(cx-L[1],L[0],2,1,p.B); Q(cx-L[1],L[0],1,1,p.H); }
    Q(cx+1,1,2,1,p.E); Q(cx+1,14,2,1,p.E);
    for(let y=2;y<=13;y++) Q(cx+2,y,1,1,p.ST);
    Q(cx-1,6,2,4,p.GR); return;
  }
  if(F==='hammer'){
    _wShaft(Q,p,cx,16,0,9,2); Q(cx-1,6,3,1,p.G);
    Q(cx-2,1,7,5,p.B); Q(cx-2,1,7,1,p.H); Q(cx-2,5,7,1,p.E);
    Q(cx-1,2,2,3,p.H); Q(cx+3,2,2,3,p.D); return;
  }
  if(F==='haft'){
    _wShaft(Q,p,cx,16,0,14,2);
    Q(cx+1,2,3,2,p.GR); Q(cx+1,2,3,1,p.H);
    Q(cx+3,0,2,3,p.GR); Q(cx+3,0,1,3,p.H); Q(cx,5,3,1,p.G); return;
  }
  if(F==='heavy'){
    for(let i=0;i<15;i++){ const t=i/14, wd=Math.max(2,Math.round(6+(3-6)*t));
      Q(cx-1,16-i,wd,1,p.B); Q(cx-1,16-i,1,1,p.H); Q(cx-2+wd,16-i,1,1,p.D);
      if(wd>=4 && i>2 && i<12) Q(cx-1+((wd/2)|0),16-i,1,1,p.D); }
    Q(cx-1,1,3,1,p.H); Q(cx-3,17,9,1,p.G); return;
  }
  if(F==='radiant'){
    for(let i=0;i<13;i++){ Q(cx-1,16-i,i>10?2:4,1,p.B); Q(cx-1,16-i,1,1,p.H); }
    Q(cx-4,9,11,2,p.G); Q(cx-4,9,11,1,p.H); Q(cx-1,3,2,1,p.H); return;
  }
  const len = w.len>=14?11:(w.len>=11?9:7);
  for(let i=0;i<len;i++){ const t=i/(len-1), wd=Math.max(1,Math.round(4+(2-4)*t));
    Q(cx,16-i,wd,1,p.B); Q(cx,16-i,1,1,p.H);
    if(wd>=3) Q(cx+wd-1,16-i,1,1,p.D); }
  Q(cx-2,17,7,1,p.G);
}

// ── KNIGHT BODY (directional sprite: buff arms, kite shield w/ Jerusalem cross,
//    swept-back crest, sword 1). Pure draw code; positions relative to (x,y). ──
// wpnId is optional: the player's equipped weapon by default, but the fallen-knight
// tile cache passes a fixed one so its cached tiles never depend on player loadout.
function drawKnightBody(x,y,dir,f,bob,mb,swinging,wpnId){
  const o=bob+mb;
  const WPN=weaponArtFor(wpnId || (player.equip && player.equip.weapon) || 'rusty');
  const OL='#141c2e';
  let TUNIC='#3b6fd4',TUNIC_L='#5a8ae8',TUNIC_D='#2a52aa',TUNIC_RIM='#6a98f0',TUNIC_SH='#22346a';
  let HELM='#c9cdd6',HELM_HI='#eef0f4',HELM_L='#e2e5ea',HELM_D='#9096a2';
  const VISOR='#1a2740',VISOR_D='#0e1626';
  let LEG='#2a4a8a',LEG_D='#1f3a70';
  const BELT='#c9a94a',BUCKLE='#f2c14e';
  let PLUME='#c0392e',PLUME_HI='#e05a4a',PLUME_D='#8a241c';
  const SHIELD='#b8c0d0',SHIELD_D='#8890a0',SHIELD_FIELD='#e8ecf2',STEEL_D='#aab0bc';
  const CROSSG='#e8b93a',CROSSG_D='#b8902a';
  const BLADE='#e8e8f0',BLADE_HI='#ffffff',BLADE_D='#9aa2b2',GUARD='#d8b24a',GUARD_D='#a8842a',GRIP='#7a4a24',POMMEL='#c9a94a';
  let PAUL='#c9cdd6',PAUL_HI='#eef0f4',PAUL_D='#9096a2';
  let ARM='#3b6fd4',ARM_HI='#5a8ae8',ARM_D='#2a52aa';
  { // ✦ earned livery — applied before the Champion's plate, which still overrides
    const L=LIVERIES[currentLivery()];
    if(L && currentLivery()!=='azure'){
      TUNIC=L.TUNIC; TUNIC_L=L.TUNIC_L; TUNIC_D=L.TUNIC_D; TUNIC_RIM=L.TUNIC_RIM; TUNIC_SH=L.TUNIC_SH;
      ARM=L.TUNIC; ARM_HI=L.TUNIC_L; ARM_D=L.TUNIC_D;
      LEG=L.LEG; LEG_D=L.LEG_D; PLUME=L.PLUME; PLUME_HI=L.PLUME_HI; PLUME_D=L.PLUME_D;
      if(L.HELM){ HELM=L.HELM; HELM_HI=L.HELM_HI; HELM_L=L.HELM_L; HELM_D=L.HELM_D;
        PAUL=L.HELM; PAUL_HI=L.HELM_HI; PAUL_D=L.HELM_D; }
    }
  }
  if(player.championRobe){   // 🏆 the Grand Champion: brightened silver plate (the cape is drawn separately)
    TUNIC='#dfe4ee'; TUNIC_L='#f7f9fd'; TUNIC_D='#b6bccb'; TUNIC_RIM='#ffffff'; TUNIC_SH='#98a0b0';
    ARM='#dfe4ee'; ARM_HI='#f7f9fd'; ARM_D='#b6bccb';
    HELM='#eaeef6'; HELM_HI='#ffffff'; HELM_L='#f5f8fd'; HELM_D='#aab2c0';
    PAUL='#eaeef6'; PAUL_HI='#ffffff'; PAUL_D='#aab2c0';
  }
  const SKIN='#e0b080',SKIN_HI='#f0c8a0',SKIN_D='#b98a5a';
  const P=(lx,ly,w,h,c)=>px(x+lx,y+ly+o,w,h,c);
  const legsFront=()=>{
    let lx=4,rx=9;
    if(f===1){ P(lx,12,3,4,LEG);P(lx,15,3,1,OL);P(lx,12,1,4,LEG_D); P(rx,12,3,2,LEG);P(rx,13,3,1,OL);P(rx,12,1,2,LEG_D); }
    else if(f===3){ P(lx,12,3,2,LEG);P(lx,13,3,1,OL);P(lx,12,1,2,LEG_D); P(rx,12,3,4,LEG);P(rx,15,3,1,OL);P(rx,12,1,4,LEG_D); }
    else { P(lx,12,3,3,LEG);P(lx,14,3,1,OL);P(lx,12,1,3,LEG_D); P(rx,12,3,3,LEG);P(rx,14,3,1,OL);P(rx,12,1,3,LEG_D); }
  };
  const legsProfile=()=>{
    if(f===1){ P(4,12,3,4,LEG);P(4,15,3,1,OL);P(4,12,1,4,LEG_D); P(8,12,3,2,LEG);P(8,13,3,1,OL); }
    else if(f===3){ P(5,12,3,2,LEG);P(5,13,3,1,OL);P(5,12,1,2,LEG_D); P(8,12,3,4,LEG);P(8,15,3,1,OL); }
    else { P(5,12,3,3,LEG);P(5,14,3,1,OL);P(5,12,1,3,LEG_D); P(8,12,3,3,LEG);P(8,14,3,1,OL); }
  };
  const crest=(mode)=>{
    if(mode==='back'){ P(7,0,2,2,PLUME);P(7,2,2,2,PLUME_HI);P(7,4,2,2,PLUME_D);P(7,0,1,6,PLUME_HI); }
    else if(mode==='profile'){ P(6,0,2,1,PLUME_HI);P(8,0,2,1,PLUME);P(10,1,2,1,PLUME_D);P(6,-1,1,2,PLUME_HI); }
    else { P(6,-1,2,2,PLUME_HI);P(7,0,3,1,PLUME);P(9,0,3,1,PLUME);P(11,1,2,1,PLUME_D);P(6,0,1,1,PLUME_HI); }
  };
  const tunicFront=()=>{ P(4,5,8,7,TUNIC);P(4,5,2,7,TUNIC_L);P(10,5,2,7,TUNIC_D);P(4,11,8,1,TUNIC_SH);P(4,5,8,1,TUNIC_RIM);P(3,5,1,7,OL);P(12,5,1,7,OL);P(6,9,4,1,BELT);P(7,9,2,1,BUCKLE); };
  const helmFront=(vx,vw)=>{ P(4,2,8,5,HELM);P(4,2,8,1,HELM_HI);P(4,2,1,5,HELM_L);P(11,2,1,5,HELM_D);P(3,2,1,5,OL);P(12,2,1,5,OL);P(4,1,8,1,OL);P(vx,4,vw,2,VISOR);P(vx,4,vw,1,VISOR_D); };
  const shield=(ox,oy)=>{ P(ox,oy,7,1,'#dfe4ea');P(ox,oy,1,6,STEEL_D);P(ox+6,oy,1,6,STEEL_D);P(ox,oy,7,7,SHIELD);P(ox+1,oy+7,5,1,SHIELD);P(ox+2,oy+8,3,1,SHIELD);P(ox+3,oy+9,1,1,SHIELD_D);P(ox+1,oy+1,5,6,SHIELD_FIELD);P(ox+1,oy+1,1,6,SHIELD_D);const cx=ox+3;P(cx,oy+1,1,6,CROSSG);P(ox+1,oy+3,5,1,CROSSG);P(cx,oy+6,1,1,CROSSG_D);P(ox+1,oy+1,1,1,CROSSG);P(ox+5,oy+1,1,1,CROSSG);P(ox+1,oy+5,1,1,CROSSG);P(ox+5,oy+5,1,1,CROSSG);P(ox,oy,1,7,OL); };
  const armFront=(side,skinFore)=>{
    if(side==='L'){ const b=1; P(b,5,3,2,PAUL);P(b,5,3,1,PAUL_HI);P(b,6,1,1,PAUL_D);P(b,7,3,3,ARM);P(b,7,1,3,ARM_HI);P(b+2,7,1,3,ARM_D);P(b,7,3,1,ARM_HI);
      if(skinFore){P(b+1,10,2,2,SKIN);P(b+1,10,1,2,SKIN_HI);P(b+2,10,1,1,SKIN_D);}else{P(b+1,10,2,2,PAUL);P(b+1,10,1,2,PAUL_HI);} P(b,4,3,1,OL); }
    else { const b=12; P(b,5,3,2,PAUL);P(b,5,3,1,PAUL_HI);P(b+2,6,1,1,PAUL_D);P(b,7,3,3,ARM);P(b,7,1,3,ARM_HI);P(b+2,7,1,3,ARM_D);P(b,7,3,1,ARM_HI);
      if(skinFore){P(b,10,2,2,SKIN);P(b,10,1,2,SKIN_HI);P(b+1,10,1,1,SKIN_D);}else{P(b,10,2,2,PAUL);P(b,10,1,2,PAUL_HI);} P(b,4,3,1,OL); }
  };
  const armProfile=()=>{ P(2,5,3,2,PAUL);P(2,5,3,1,PAUL_HI);P(2,7,3,3,ARM);P(2,7,1,3,ARM_HI);P(4,7,1,3,ARM_D);P(2,7,3,1,ARM_HI);P(1,9,2,2,SKIN);P(1,9,1,2,SKIN_HI);P(2,4,3,1,OL); };
  const sword=(hx,hy)=>{ P(hx,hy,1,2,GRIP);P(hx,hy+1,1,1,POMMEL);P(hx-1,hy-1,3,1,GUARD);P(hx-1,hy-1,1,1,GUARD_D);P(hx,hy-3,2,2,BLADE);P(hx+1,hy-5,2,2,BLADE);P(hx+2,hy-7,2,2,BLADE);P(hx,hy-3,1,2,BLADE_HI);P(hx+1,hy-5,1,2,BLADE_HI);P(hx+2,hy-7,1,2,BLADE_HI);P(hx+1,hy-2,1,1,BLADE_D);P(hx+2,hy-4,1,1,BLADE_D);P(hx+3,hy-7,1,1,'#ffffff'); };
  const swordFlat=(hx,hy)=>{ P(hx+2,hy,1,2,GRIP);P(hx+1,hy-1,3,1,GUARD);P(hx+1,hy-1,1,1,BLADE);P(hx,hy-2,2,1,BLADE_HI);P(hx,hy-3,1,1,BLADE);P(hx-1,hy-4,2,1,BLADE_HI);P(hx-1,hy-4,1,1,'#ffffff'); };
  const CAPE='#d8a828', CAPE_L='#f0c94a', CAPE_D='#a67e1e', CAPE_LN='#7e5e16';
  const RC='#c0392e', RC_HI='#e05a4a';
  const capeMantle=(mode)=>{   // the cape's collar, worn OVER the shoulders (drawn on top of the plate)
    if(mode==='profile'){
      P(4,5,8,2,CAPE); P(4,5,8,1,CAPE_L); P(4,6,8,1,CAPE_D);            // drapes over the shoulder (x4-11)
      P(11,6,3,3,CAPE); P(11,6,1,3,CAPE_L);                            // curls back to meet the flowing cape
      P(4,5,1,2,CAPE_LN);                                             // near clasp
    } else if(mode==='front'){
      P(1,5,4,2,CAPE); P(11,5,4,2,CAPE);                              // mantle over both shoulders
      P(1,5,4,1,CAPE_L); P(11,5,4,1,CAPE_L); P(1,6,4,1,CAPE_D); P(11,6,4,1,CAPE_D);
      P(4,4,8,1,CAPE_D);                                             // collar behind the neck
    }
  };
  const cape=(mode)=>{   // a golden cape that flows behind — cross on the back, gentle idle billow
    const wave = Math.round((f===1?-1:f===3?1:0) + Math.sin(Date.now()*0.004));   // walk sway + slow idle billow
    if(mode==='back'){
      P(3,5,10,8,CAPE); P(3,5,2,8,CAPE_L); P(11,5,2,8,CAPE_D);            // cloak over the back
      P(2,12,12,3,CAPE); P(2,12,1,3,CAPE_L); P(13,12,1,3,CAPE_D);          // widening hem
      P(2+wave,15,4,1,CAPE_D); P(10-wave,15,4,1,CAPE_D);                   // wavy tail
      P(3,5,10,1,CAPE_LN);                                                // shoulder line
      P(2,12,1,3,CAPE_L); P(13,12,1,3,CAPE_L);                            // gold trim, hem corners
      P(7,6,2,7,RC); P(5,8,6,2,RC); P(7,6,1,7,RC_HI); P(5,8,6,1,RC_HI);   // the red cross
    } else if(mode==='front'){
      P(2,5,2,2,CAPE_D); P(12,5,2,2,CAPE_D);                              // cape clasps at the shoulders
      P(3,13,10,3,CAPE_D); P(3,13,10,1,CAPE);                             // hem flows out below
      P(2+wave,14,2,2,CAPE_D); P(12-wave,14,2,2,CAPE_D);                  // side flares billow
      P(3,15,3,1,CAPE_LN); P(10,15,3,1,CAPE_LN);
      P(3,13,1,3,CAPE_L); P(12,13,1,3,CAPE_L);                            // gold trim on the hem sides
    } else {   // profile — emerges broad at the shoulder, drapes down the back (shoulder-attached)
      P(10,4,4,2,CAPE); P(10,4,4,1,CAPE_LN);                             // clasped at the shoulder/neck (top)
      P(11,6,4,4,CAPE); P(11,6,1,4,CAPE_L);                              // broad upper back
      P(11,10,4,3,CAPE);                                                // mid drape
      P(12,13,4,2,CAPE); P(15,9,1,5,CAPE_D);                             // hem + far-edge shadow
      P(11+wave,15,4,1,CAPE_D); P(12-wave,16,3,1,CAPE_LN);              // billowing hem tail
      P(14,6,1,7,CAPE_L);                                               // gold trim down the trailing edge
    }
  };

  if(dir==='down'){
    if(player.championRobe) cape('front');
    legsFront(); tunicFront();
    armFront('L',false); armFront('R',true);
    if(player.championRobe) capeMantle('front');
    helmFront(5,6); crest('front');
    shield(0,6);
    if(!swinging) drawWeaponDown(P, WPN);   /* _legacy: sword(13,10); */
  } else if(dir==='up'){
    legsFront();
    P(12,6,2,6,SHIELD_D);P(13,6,1,6,SHIELD);P(12,6,2,1,'#dfe4ea');
    if(!swinging) drawWeaponUp(P, WPN);   /* _legacy: P(3,4,1,4,BLADE);P(3,4,1,2,BLADE_HI); */
    P(4,5,8,7,TUNIC);P(4,5,2,7,TUNIC_L);P(10,5,2,7,TUNIC_D);P(4,11,8,1,TUNIC_SH);P(4,5,8,1,TUNIC_RIM);P(3,5,1,7,OL);P(12,5,1,7,OL);P(7,5,1,7,TUNIC_D);
    if(player.championRobe) cape('back');
    P(2,5,3,2,PAUL);P(2,5,3,1,PAUL_HI);P(2,7,3,3,ARM);P(2,7,1,3,ARM_HI);P(2,7,3,1,ARM_HI);P(2,4,3,1,OL);
    P(11,5,3,2,PAUL);P(11,5,3,1,PAUL_HI);P(11,7,3,3,ARM);P(13,7,1,3,ARM_D);P(11,7,3,1,ARM_HI);P(11,4,3,1,OL);
    P(4,2,8,5,HELM);P(4,2,8,1,HELM_HI);P(4,2,1,5,HELM_L);P(11,2,1,5,HELM_D);P(3,2,1,5,OL);P(12,2,1,5,OL);P(4,1,8,1,OL);P(6,4,4,2,'#b7bcc6');
    crest('back');
  } else { // left / right (right handled by caller via flip)
    if(player.championRobe) cape('profile');
    legsProfile();
    P(10,6,2,6,SHIELD_D);P(11,6,1,6,SHIELD);P(10,6,2,1,'#dfe4ea');
    P(4,5,7,7,TUNIC);P(4,5,2,7,TUNIC_L);P(9,5,2,7,TUNIC_D);P(4,5,7,1,TUNIC_RIM);P(4,11,7,1,TUNIC_SH);P(3,5,1,7,OL);P(11,5,1,7,OL);P(5,9,4,1,BELT);P(6,9,1,1,BUCKLE);
    armProfile();
    if(player.championRobe) capeMantle('profile');
    P(4,2,7,5,HELM);P(4,2,7,1,HELM_HI);P(10,2,1,5,HELM_D);P(3,2,1,5,OL);P(11,2,1,5,OL);P(4,1,7,1,OL);P(3,3,1,3,HELM_L);P(3,4,2,2,VISOR);P(3,4,2,1,VISOR_D);
    crest('profile');
    if(!swinging) drawWeaponLeft(P, WPN);   /* _legacy: swordFlat(1,9); */
  }
}


// Mirror wrapper: draws the LEFT profile flipped to make the RIGHT profile,
// by reflecting local x within the 16px tile. Used only for dir==='right'.
function drawKnightBodyR(x,y,dir,f,bob,mb,swinging,wpnId){
  const _px=px; // shadow the global px with a horizontally-mirrored version
  try{
    px=function(ax,ay,w,h,c){ const lx=ax-x; const mx=x+(16-lx-w); _px(mx,ay,w,h,c); };
    drawKnightBody(x,y,'left',f,bob,mb,swinging,wpnId);   // wpnId must be forwarded, or
                                                          // right-facing silently falls back
  } finally { px=_px; }
}

// ══════════════════════════════════════════════════════════════════════
//  SWING ARC — the equipped weapon sweeps through the hit cone.
//  The cone is real: resolveSwing() tests SWING[type].half either side of
//  swingDir, so unlike the old rectangle this actually shows what connects.
//  Rotation is fine here because RENDER_SCALE=2 gives the sub-pixel headroom.
// ══════════════════════════════════════════════════════════════════════
const _SWING_BASE = { left:0, right:Math.PI, up:Math.PI/2, down:-Math.PI/2 };
function drawSwingArc(x,y,o){
  const cfg = SWING[player.swingType] || SWING.light;
  const dur = Math.max(1, cfg.dur);
  // player.swing counts DOWN from windup+dur; above dur we are still winding up,
  // so the blade holds at the start of the arc instead of jumping into it.
  const raw = player.swing > dur ? 0 : 1 - (player.swing / dur);
  // Damage lands at the START of the sweep (resolveSwing fires at windup end), so the
  // blade is fastest there and follows through slower — a strike, not a constant spin.
  const t = 1 - Math.pow(1 - raw, 2.2);
  const base = _SWING_BASE[player.swingDir || player.dir || 'down'] || 0;
  const WPN = weaponArtFor(player.equip && player.equip.weapon);
  // The arc is drawn a little tighter than the hit cone: heavy's cone is 223 degrees,
  // and swinging that far visually carries the blade behind the knight's own back.
  const vHalf = cfg.half * 0.72;
  // PIVOT AT THE SHOULDER, not the grip. The hand travels the arc at ARM_R and the
  // blade extends outward from it — rotating about the grip reads as twirling.
  const ARM_R = 5;
  const cx = x + 8, cy = y + 8 + o;
  const sweep = u => base + (-vHalf + 2 * vHalf * u);
  if(WPN.fam === 'bow'){                       // a bow is drawn and loosed, not swung
    const recoil = (1 - t) * 2;
    const fv = _SWING_BASE[player.swingDir||player.dir||'down'];
    ctx.save();
    // forward is (-cos,-sin) of the base angle, so +(cos,sin) kicks the bow BACK
    ctx.translate(x + 8 + Math.cos(fv)*recoil, y + 8 + o + Math.sin(fv)*recoil);
    const P = (lx,ly,w2,h2,c) => { ctx.fillStyle = c; ctx.fillRect(lx-1, ly-9, w2, h2); };
    drawWeaponLeft(P, WPN);
    ctx.restore();
    return;
  }
  const bare = WPN.fam === 'fist';
  // oldest ghost first, live blade last
  for(const [lag, alpha] of [[0.30,0.12],[0.15,0.26],[0,1]]){
    const u = t - lag;
    if(u < 0) continue;
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.translate(cx, cy);
    ctx.rotate(sweep(u));
    ctx.translate(-ARM_R, 0);        // out to the hand, along the swing direction
    if(bare){
      // no blade to swing — a short knuckle streak so the punch still reads
      const p = WPN.pal;
      ctx.fillStyle = p.H; ctx.fillRect(-7, -1.5, 5, 3);
      ctx.fillStyle = p.B; ctx.fillRect(-9.5, -1, 3, 2);
      ctx.fillStyle = p.D; ctx.fillRect(-4, -0.5, 3, 1);
    } else {
      const P = (lx,ly,w,h,c) => { ctx.fillStyle = c; ctx.fillRect(lx-1, ly-9, w, h); };
      drawWeaponLeft(P, WPN);
    }
    ctx.restore();
  }
  ctx.globalAlpha = 1;
}

function drawKnight(x,y){
  if(player.boating){
    // a little wooden boat carrying the knight
    ctx.fillStyle='#7a4a24'; ctx.fillRect(x-2, y+8, TILE+4, 7);
    ctx.fillStyle='#94612f'; ctx.fillRect(x-1, y+9, TILE+2, 2);
    ctx.fillStyle='#b8b8c8'; ctx.fillRect(x+TILE/2-1, y-2, 2, 11);     // mast
    ctx.fillStyle='#e8e8f0'; ctx.fillRect(x+TILE/2+1, y, 5, 7);        // sail
    ctx.fillStyle='#c8a060'; ctx.fillRect(x+5, y+3, 6, 6);             // the knight, seated
    return;
  }
  const f=player.moving?player.frame:0; const bob=(f===1?-1:f===3?1:0);
  // signature special: expanding burst ring around the knight
  if(player.specialFx>0){ const p=1-player.specialFx/22; const rad=TILE*0.6+p*TILE*2.0;
    ctx.globalAlpha=0.5*(1-p); ctx.strokeStyle=player.specialColor; ctx.lineWidth=3;
    ctx.beginPath(); ctx.arc(x+TILE/2,y+TILE/2,rad,0,7); ctx.stroke();
    ctx.globalAlpha=0.22*(1-p); ctx.fillStyle=player.specialColor; ctx.beginPath(); ctx.arc(x+TILE/2,y+TILE/2,rad,0,7); ctx.fill();
    ctx.globalAlpha=1; }
  ctx.fillStyle='rgba(0,0,0,.25)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,5,2,0,0,7); ctx.fill();
  if(player.blocking){
    const t2=performance.now();
    ctx.strokeStyle = player.blockFlash>0 ? '#fff' : 'rgba(250,204,21,.85)';
    ctx.lineWidth = player.blockFlash>0 ? 3 : 2;
    ctx.beginPath(); ctx.arc(x+TILE/2, y+TILE/2, TILE*0.78+Math.sin(t2/120), 0, Math.PI*2); ctx.stroke();
    if(player.blockFlash>0) player.blockFlash--;
  }
  if(blockSparkT>0){
    ctx.fillStyle='#fff'; ctx.font='6px "Press Start 2P"'; ctx.textAlign='center';
    ctx.fillText('BLOCK!', x+TILE/2, y-4-(14-blockSparkT)); blockSparkT--;
  }
  if(player.iframes>0 && Math.floor(player.iframes/4)%2) return; // blink when hit
  // MOUNTED: draw the steed beneath the knight (the pet's final-form emoji), knight raised
  let mb=0;
  if(player.mounted){
    const ab=petAbility();
    const sfrm=(ab==='fly') ? ((Date.now()>>8)&1)
             : (player.moving ? ((Date.now()>>7)&1) : 1);      // gathered legs at rest
    drawSteedMounted(x, y, player.pet.id, player.dir||'down', sfrm);
    /* OLD emoji mount (revert):
    const f=petForm();
    if(ab==='fly'){ ctx.font='15px serif'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(f.emoji, x+TILE/2, y+TILE/2+3); ctx.textAlign='left'; ctx.textBaseline='alphabetic'; mb=-6; }
    else { ctx.font='15px serif'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(f.emoji, x+TILE/2, y+TILE/2+5); ctx.textAlign='left'; ctx.textBaseline='alphabetic'; mb=-4; }
    */
  }
  // --- NEW directional knight sprite (buff arms, kite shield, crest, sword1) ---
  const _dir = player.dir || 'down';
  const _swinging = (player.swing>0 && player.swingType!=='special');
  // ── radiant weapons cast light. Drawn UNDER the sprite so it haloes the knight
  //    instead of washing him out. Lives here rather than in drawKnightBody because
  //    that function is also rendered into the fallen-knight offscreen buffer with a
  //    swapped px — a raw ctx call inside it would leak onto the main canvas.
  {
    const _wg = weaponArtFor(player.equip && player.equip.weapon).glow;
    if(_wg && !player.mounted){
      const gx = x + (_dir==='left'?4:_dir==='right'?12:_dir==='up'?4:13);
      const gy = y + (_dir==='up'?6:7) + bob + mb;
      const pulse = 8.5 + Math.sin(Date.now()/260) * 1.4;      // slow breathing halo
      const g = ctx.createRadialGradient(gx,gy,0,gx,gy,pulse);
      g.addColorStop(0,   'rgba(255,236,170,0.50)');
      g.addColorStop(0.42,'rgba(255,216,106,0.20)');
      g.addColorStop(1,   'rgba(255,216,106,0)');
      ctx.fillStyle=g; ctx.fillRect(x-12,y-12,TILE+24,TILE+24);
    }
  }
  if(!player.mounted){
    if(_dir==='right') drawKnightBodyR(x,y,_dir,f,bob,mb,_swinging);
    else drawKnightBody(x,y,_dir,f,bob,mb,_swinging);
  }
  /* OLD flat body (kept for instant revert):
  px(x+4,y+5+bob+mb,8,7,'#3b6fd4'); px(x+4,y+2+bob+mb,8,5,'#c9cdd6'); px(x+5,y+4+bob+mb,6,2,'#1a2740');
  px(x+4,y+12+bob+mb,3,3,'#2a4a8a'); px(x+9,y+12+bob+mb,3,3,'#2a4a8a');
  */
  // the weapon itself sweeps the hit cone (replaces the old light rectangle)
  if(player.swing>0 && player.swingType!=='special' && !player.mounted) drawSwingArc(x,y,bob+mb);
  /* _legacy light-rectangle flash (instant revert):
     const d=player.swingDir, hv=player.swingType==='heavy';
     ctx.fillStyle = hv ? '#fff0b0' : '#f2e2a0';
     const len = hv?13:10, wide = hv?6:4; ... */
  /* OLD resting sword now handled inside drawKnightBody:
  else if(player.swing<=0){ const d=player.dir; px(x + (d==='left'?2:d==='right'?12:11), y+(d==='up'?2:9)+bob, 2,5,'#f2c14e'); }
  */
}
function drawDemon_legacy(x,y,d){
  // dying animation: fade + shrink
  if(d.dying>0){ const a=d.dying/18; ctx.globalAlpha=a;
    px(x+5,y+5,6,6,'#9a3aaa'); ctx.globalAlpha=1;
    if(d.pop) drawDmgPop(x,y,d.pop);
    return;
  }
  const bob=Math.round(Math.sin(d.t*0.12)*1.4);
  const big=d.boss?1.4:1;
  ctx.fillStyle='rgba(0,0,0,.25)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,5*big,2*big,0,0,7); ctx.fill();
  const body = d.hurt>0 ? '#ff9aa8' : (d.boss?'#a82a6a':'#7a2a8a');
  if(d.boss){ // larger, horned boss with a glow
    ctx.save(); ctx.shadowColor='#ff4a6a'; ctx.shadowBlur=6;
    px(x+1,y+2+bob,14,12,body); px(x,y-1+bob,4,5,'#c83a7a'); px(x+12,y-1+bob,4,5,'#c83a7a');
    px(x+4,y+6+bob,3,3,'#ffd05a'); px(x+9,y+6+bob,3,3,'#ffd05a'); ctx.restore();
  } else {
    px(x+3,y+4+bob,10,9,body); px(x+2,y+2+bob,3,4,'#9a3aaa'); px(x+11,y+2+bob,3,4,'#9a3aaa');
    px(x+5,y+7+bob,2,2,'#ff5a5a'); px(x+9,y+7+bob,2,2,'#ff5a5a');
  }
  // HP bar
  if(d.hp<d.maxHp){ const w=d.boss?16:12; px(x-1,y-3,w,2,'#3a1018'); px(x-1,y-3,Math.max(0,Math.round(w*d.hp/d.maxHp)),2,d.boss?'#ff3a5a':'#ff5a6a'); }
  // label
  ctx.fillStyle=d.boss?'#ffd05a':'#ffd0d8'; ctx.font='6px monospace'; ctx.fillText(d.boss?(d.name||'BOSS'):('L'+d.level), x+(d.boss?-2:1), y-5);
  if(d.pop) drawDmgPop(x,y,d.pop);
}
function drawDmgPop(x,y,pop){
  const rise=Math.round((26-pop.t)*0.5);
  ctx.font=(pop.crit?'bold 9px':'7px')+' monospace'; ctx.textAlign='center';
  ctx.fillStyle = pop.crit ? '#ffe04a' : '#fff';
  ctx.fillText((pop.crit?'✦':'')+pop.dmg, x+TILE/2, y-6-rise); ctx.textAlign='left';
}

function _famInit(){ if(OUTFITS.elara) return;
  OUTFITS.elara={skin:'#f0c8a0',hair:'#c8a860',top:'#3a8a8a',bottom:'#2a5a6a',hat:null};
  OUTFITS.elder={skin:'#dcb088',hair:'#c8c8c8',top:'#7a5a3a',bottom:'#4a3a2a',hat:null};
  OUTFITS.gmara={skin:'#f0c8a0',hair:'#8a4a2a',top:'#c86a8a',bottom:'#5a6a8a'};
  OUTFITS.gtobiah={skin:'#e8bc90',hair:'#5a3a1a',top:'#5a8ac8',bottom:'#4a5a3a'}; }
const FAMILY_LOOK={'Lady Elara':'elara','Tobias':'elder','Mara':'gmara','Tobiah':'gtobiah'};

// ── SANCTUARY BEAUTY OVERLAY: repaints a sanctuary interior over the base tiles —
//    dressed stone walls, tall stained-glass windows (grapevine · pomegranate ·
//    cross), a crimson runner up the aisle, an altar cloth, and flickering
//    candles. Purely visual, drawn each frame before the NPCs. ──
function drawKeepThroneOverlay(camX, camY){
  // dress Stormgate Keep's upper hall (where the King sits) as a throne room
  if(place.kind!=='interior' || place.id!=='sg_keep' || place.floor!==1) return;
  const T=(tx)=>Math.round(tx*TILE-camX), Y=(ty)=>Math.round(ty*TILE-camY);
  const gold='#e8c766', goldL='#f8e29a', goldD='#a8842e', blue='#2f4a8f', blueL='#5a78c0', blueD='#1c2c58', red='#8f2f2f', redL='#b04a4a';
  // red carpet up the centre (cols 3-5), throne at top → entrance at bottom
  for(let ty=2; ty<=7; ty++){ px(T(3),Y(ty),TILE*3,TILE,red); px(T(3),Y(ty),TILE*3,1,redL);
    px(T(3),Y(ty),2,TILE,gold); px(T(5)+TILE-2,Y(ty),2,TILE,gold); }
  // banners with gold crown on the back wall, flanking the throne
  for(const bx of [1, 7]){ px(T(bx)+3,Y(0),10,TILE*2+4,blue); px(T(bx)+3,Y(0),10,1,blueL); px(T(bx)+11,Y(0),1,TILE*2,blueD);
    px(T(bx)+5,Y(0)+5,6,3,gold); px(T(bx)+6,Y(0)+4,1,2,goldL); px(T(bx)+8,Y(0)+3,1,2,goldL); }
  // the GRAND THRONE behind the King (King NPC sits at tile 4,3)
  const cx=T(4), cy=Y(1);
  px(cx-TILE+2, cy+6, TILE*3-4, TILE*2, goldD); px(cx-TILE+2, cy+6, TILE*3-4, 2, gold);   // gold frame
  px(cx-TILE+5, cy+9, TILE*3-10, TILE*2-8, '#3a4e86');                                      // blue inlay back
  px(cx-TILE+2, cy+6, 3, TILE*2, gold); px(cx+TILE*2-5, cy+6, 3, TILE*2, gold);            // side posts
  px(cx-2, cy+2, TILE+4, 5, gold); px(cx+2, cy+3, TILE-4, 2, goldL);                        // crown block
  px(cx+TILE/2-1, cy-2, 3, 8, goldL); px(cx+TILE/2-3, cy, 7, 3, goldL);                     // gold cross crest
  px(cx-TILE-1, cy+TILE, 4, TILE, goldD); px(cx+TILE*2-3, cy+TILE, 4, TILE, goldD);          // armrests
  px(cx-TILE-1, cy+TILE-2, 4, 3, goldL); px(cx+TILE*2-3, cy+TILE-2, 4, 3, goldL);            // finials
  px(cx-2, cy+TILE+4, TILE+4, TILE-4, red); px(cx-2, cy+TILE+4, TILE+4, 2, redL);           // red cushion
}
function drawSanctuaryOverlay(camX, camY){
  const it=INTERIORS[place.id]; if(!it||it.theme!=='sanctuary') return;
  const f=it.floors[0], G=f.g, W=f.w, H=f.h, T=performance.now()/1000;
  const P=(gx,gy,ox,oy,w,h,c)=>{ px(Math.round(gx*TILE-camX)+ox, Math.round(gy*TILE-camY)+oy, w,h,c); };
  // window slots on the two long walls (skip corners), themed in a fixed cycle
  const MOTIF=['vine','pom','cross'];
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const t=G[y][x];
    const sx=Math.round(x*TILE-camX), sy=Math.round(y*TILE-camY);
    if(sx<-TILE||sy<-TILE||sx>VW||sy>VH) continue;
    if(t===5){ // WALL: dressed ashlar with mortar lines
      // A wall whose southern neighbour is open floor is FRONT-FACING — the player
      // stands just below it. Drawn flat, its top-lit edge reads as a ledge you could
      // stand on (the same fault fixed for dungeon walls in v87). Give those a lit cap,
      // a hard drop edge, then a face that darkens downward so it reads as vertical mass.
      // Back and side walls (another wall below) stay flat ashlar.
      const belowT=(G[y+1]&&G[y+1][x]!==undefined)?G[y+1][x]:5;
      const frontFacing=(belowT!==5);
      const hsh=((x*374761393+y*668265263)>>>0);
      if(frontFacing){
        px(sx,sy,TILE,TILE,'#565060');                                 // face (mid)
        px(sx,sy,TILE,3,'#6b6470');                                    // top surface
        px(sx,sy,TILE,1,'#847d8e');                                    // lamplit crown
        px(sx,sy+3,TILE,1,'#2a2632');                                  // hard drop edge
        px(sx,sy+4,TILE,4,'#605a6a'); px(sx,sy+4,TILE,1,'#6b6470');    // upper course (lit)
        px(sx,sy+8,TILE,1,'#4a4552');                                  // mortar
        px(sx,sy+9,TILE,5,'#4e4956'); px(sx,sy+9,TILE,1,'#565060');    // lower course (darker)
        px(sx,sy+TILE-2,TILE,2,'#3a3642');                             // deep base
        px(sx+2,sy+6,1,2,'#413c48'); px(sx+9,sy+11,1,2,'#413c48');     // sparse joints
        px(sx,sy,1,TILE,'#413c48'); px(sx+TILE-1,sy,1,TILE,'#413c48'); // side outlines
      } else {
      px(sx,sy,TILE,TILE,'#6b6470'); px(sx,sy,TILE,1,'#7d7684'); px(sx,sy,1,TILE,'#7d7684');
      px(sx,sy+TILE-1,TILE,1,'#524c5c'); px(sx+TILE-1,sy,1,TILE,'#524c5c');
      px(sx+2,sy+ (hsh%2?6:9),TILE-4,1,'#5a5464');                     // staggered mortar course
      }
      // STAINED GLASS on side walls (x=0 or x=W-1), interior rows only
      const side=(x===0||x===W-1), midRows=(y>=2&&y<=H-3);
      if(side && midRows && (y%2===0)){
        const motif=MOTIF[((y>>1)+ (x===0?0:1))%3];
        const inner=(x===0);                                          // which way the glass faces
        const gx=sx+(inner?4:2), gw=TILE-6;                           // WIDE lancet across most of the wall face
        const lit=0.55+0.45*Math.sin(T*1.3+y*1.7);
        // stone lancet frame with arched top
        px(gx-2,sy+1,gw+4,TILE-2,'#241c30'); px(gx-1,sy,gw+2,1,'#241c30');
        px(gx-1,sy+2,gw+2,TILE-4,'#0e0a18');                          // dark leading behind glass
        ctx.globalAlpha=0.72+0.22*lit;
        if(motif==='vine'){                                           // GRAPEVINE: green field, gold border, purple grape cluster
          px(gx,sy+2,gw,TILE-4,'#2f7a46'); px(gx,sy+2,gw,1,'#e8b93a'); px(gx,sy+TILE-3,gw,1,'#e8b93a');
          px(gx+gw-2,sy+3,1,TILE-6,'#7ec98a');                        // vine cane
          const cx=gx+2; [[0,4],[2,4],[1,6],[0,8],[2,8],[1,10]].forEach(([dx,dy])=>px(cx+dx,sy+dy,2,2,'#6a3aa8'));
          px(cx+1,sy+3,2,1,'#4f8a3a');                                // leaf
        } else if(motif==='pom'){                                     // POMEGRANATE: crimson field, split fruit, gold seeds
          px(gx,sy+2,gw,TILE-4,'#8a1f2a'); px(gx,sy+2,gw,1,'#e8b93a'); px(gx,sy+TILE-3,gw,1,'#e8b93a');
          const cx=gx+Math.floor(gw/2)-2;
          px(cx,sy+5,4,5,'#c0402f'); px(cx+1,sy+4,2,1,'#5a8a3a');     // fruit body + crown
          px(cx+1,sy+6,1,1,'#ffd27a'); px(cx+2,sy+7,1,1,'#ffd27a'); px(cx+1,sy+8,1,1,'#ffd27a'); // seeds
        } else {                                                      // CROSS: gold field, deep-red cross
          px(gx,sy+2,gw,TILE-4,'#f2d38a'); px(gx,sy+2,gw,1,'#c8a040'); px(gx,sy+TILE-3,gw,1,'#c8a040');
          const cx=gx+Math.floor(gw/2);
          px(cx-1,sy+3,2,TILE-6,'#7a2a24'); px(gx+1,sy+6,gw-2,2,'#7a2a24');
        }
        ctx.globalAlpha=1;
        // colored light spilling onto the floor inward
        ctx.globalAlpha=0.12+0.08*lit; ctx.fillStyle= motif==='vine'?'#3fa060':motif==='pom'?'#d0404a':'#f2c14e';
        ctx.fillRect(inner?sx+TILE:sx-TILE, sy+3, TILE, TILE-4); ctx.globalAlpha=1;
      }
    } else if(t===12){ // FLOOR: warm flagstone; crimson runner up the central aisle
      px(sx,sy,TILE,TILE,'#b79a68'); px(sx,sy,TILE,1,'#c8ab78');
      const hsh=((x*911+y*373)>>>0); if(hsh%4===0) px(sx+3+(hsh%6),sy+4+(hsh%5),2,2,'#a98a58');
      if(x===((W-1)>>1)){ px(sx+2,sy,TILE-4,TILE,'#7a1f2a'); px(sx+2,sy,1,TILE,'#a03444'); px(sx+TILE-3,sy,1,TILE,'#5a141d');
        if(y%2===0) px(sx+5,sy+5,TILE-10,TILE-10,'#e8b93a'); }         // gold motif on the runner
    } else if(t===13){ // PEW: wooden bench with a 3D seat + back + shadowed legs
      px(sx,sy+2,TILE,1,'#3a2410');                                   // cast shadow under the pew
      px(sx,sy+3,TILE,4,'#6e4a24'); px(sx,sy+3,TILE,1,'#8a5e30');      // seat plank (lit top)
      px(sx,sy+1,TILE,2,'#553618'); px(sx,sy+1,TILE,1,'#6e4a24');      // backrest
      px(sx+1,sy+7,2,3,'#3a2410'); px(sx+TILE-3,sy+7,2,3,'#3a2410');   // legs
    } else if(t===15){ // RAISED CHANCEL FLOOR: pale stone, brighter than the nave
      px(sx,sy,TILE,TILE,'#cabfa0'); px(sx,sy,TILE,1,'#ded4b6');
      const hsh=((x*733+y*191)>>>0); if(hsh%3===0) px(sx+4+(hsh%6),sy+5+(hsh%4),2,1,'#b6ab8c');
    } else if(t===14){ // STEP RISER down to the nave: a lit tread + dark riser face (3D lip)
      px(sx,sy,TILE,TILE,'#b79a68');                                   // nave-level flag under it
      px(sx,sy,TILE,3,'#cabfa0'); px(sx,sy,TILE,1,'#e2d8ba');          // bright tread on the chancel edge
      px(sx,sy+3,TILE,2,'#7a6038'); px(sx,sy+4,TILE,1,'#5e4a2a');      // shadowed riser face → reads as a raised lip
    } else if(t===17){ // ALTAR BLOCK: tall carved stone with a lit face and gold trim
      px(sx,sy+1,TILE,TILE-1,'#8f8674'); px(sx,sy+1,TILE,2,'#a8a08c');  // stone body + lit top
      px(sx,sy+TILE-3,TILE,2,'#6a6252');                               // shadowed base
      px(sx,sy+3,TILE,1,'#e8b93a'); px(sx+1,sy+6,TILE-2,1,'#d8c9a0');  // gold band + inscription line
    } else if(t===18){ // PULPIT: raised lectern the priest teaches from — book + gilt edge
      px(sx,sy+2,TILE,TILE-2,'#6a4a26'); px(sx,sy+2,TILE,2,'#875a2c');  // wooden stand
      px(sx+2,sy,TILE-4,4,'#e9e3d4'); px(sx+2,sy,TILE-4,1,'#fffaf0');   // slanted open book
      px(sx+TILE/2-1,sy,1,4,'#b0a68a'); px(sx+2,sy+3,TILE-4,1,'#e8b93a'); // spine + gilt edge
    }
  }
  // ALTAR CANDLES: two flames on the chancel flanking the pulpit, animated flicker
  const cxs=[ (((W-1)>>1)-2), (((W-1)>>1)+2) ];
  cxs.forEach((cx,i)=>{ const gy=2;                                   // on the raised chancel row
    const bx=Math.round(cx*TILE-camX)+TILE/2, by=Math.round(gy*TILE-camY)+TILE-3;
    px(bx-1,by-7,2,7,'#efe6d0');                                       // tall taper
    const fl=Math.sin(T*9+i*2.1), h=3+ (fl>0?1:0);
    ctx.fillStyle='#ffcf5a'; ctx.fillRect(bx-1,by-7-h,2,h);
    ctx.fillStyle='#fff2c0'; ctx.fillRect(bx,by-7-h+1,1,Math.max(1,h-1));
    ctx.globalAlpha=0.14+0.06*(fl+1); ctx.fillStyle='#ffdd88';
    ctx.beginPath(); ctx.arc(bx,by-8,6,0,7); ctx.fill(); ctx.globalAlpha=1;
  });
}


// ════════════════════════════════════════════════════════════════
//  NPC SPRITE ROSTER (rollout) — accents, keep knights, the named cast
// ════════════════════════════════════════════════════════════════
const _NPC_OL='#1a141c';
function _accTowel(x,y){ px(x+2,y+6,2,5,'#f0ece0'); px(x+2,y+6,1,5,'#d8d0c0'); }
function _accMug(x,y){ px(x+12,y+9,3,3,'#8a5c32'); px(x+12,y+9,3,1,'#e8d8a8'); px(x+15,y+10,1,1,'#8a5c32'); }
function _accPack(x,y){ px(x+1,y+5,3,6,'#6f5436'); px(x+1,y+5,3,1,'#8a6a44'); px(x+2,y+7,1,3,'#c8a038'); }
function _accPouch(x,y){ px(x+11,y+10,3,3,'#c8a038'); px(x+11,y+10,3,1,'#e8d074'); }
function _accFish(x,y){ px(x+12,y+8,1,4,'#7ab0c0'); px(x+11,y+9,3,2,'#8fc4d4'); px(x+13,y+12,2,2,'#7ab0c0'); px(x+12,y+9,1,1,_NPC_OL); }
function _accTongs(x,y){ px(x+12,y+8,1,5,'#5a5a64'); px(x+11,y+7,3,1,'#5a5a64'); px(x+11,y+6,1,1,'#5a5a64'); px(x+13,y+6,1,1,'#5a5a64'); }
function _accLedger(x,y){ px(x+11,y+9,4,3,'#8a3a4a'); px(x+11,y+9,4,1,'#b8505f'); px(x+12,y+10,2,1,'#e8e0d0'); }
function drawKeepKnight(x,y,her){
  const armor='#9aa0b0', armorL='#c8ccd8', armorD='#6a707e', OL=_NPC_OL;
  her = her || {main:'#2f4a8f',trim:'#e8c766'};
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,4,2,0,0,7); ctx.fill();
  px(x+4,y+12,3,3,armorD); px(x+4,y+14,3,1,OL); px(x+9,y+12,3,3,armorD); px(x+9,y+14,3,1,OL);
  px(x+4,y+6,8,6,armor); px(x+4,y+6,2,6,armorL); px(x+10,y+6,2,6,armorD);
  px(x+3,y+6,1,6,OL); px(x+12,y+6,1,6,OL);
  px(x+3,y+6,2,2,armorL); px(x+11,y+6,2,2,armorL);
  px(x+6,y+6,4,6,her.main); px(x+6,y+6,4,1,_shadeHex(her.main,1.3));
  px(x+7,y+7,2,3,her.trim); px(x+6,y+8,4,1,her.trim);
  px(x+5,y+2,6,5,'#d8a878'); px(x+10,y+2,1,5,'#b08858');
  px(x+6,y+4,1,1,'#2a1c10'); px(x+9,y+4,1,1,'#2a1c10');
  px(x+4,y+1,8,3,armor); px(x+4,y+1,8,1,armorL); px(x+4,y+3,8,1,'#00000028');
  px(x+7,y+0,2,1,her.trim);
  px(x+4,y+2,1,5,OL); px(x+11,y+2,1,5,OL); px(x+5,y+1,6,1,OL);
}
function drawSirJoshua(x,y){
  // broad AND tall (20x20): swamp-green tabard, gold cross, easy smile.
  const armor='#9aa0b0', armorL='#c8ccd8', armorD='#6a707e', tab='#4a7a3a', tabL='#68a052', OL=_NPC_OL;
  ctx.fillStyle='rgba(0,0,0,.25)'; ctx.beginPath(); ctx.ellipse(x+10,y+19,6,2.4,0,0,7); ctx.fill();
  px(x+4,y+15,4,4,armorD); px(x+4,y+18,4,1,OL); px(x+12,y+15,4,4,armorD); px(x+12,y+18,4,1,OL);
  px(x+3,y+7,14,8,armor); px(x+3,y+7,3,8,armorL); px(x+14,y+7,3,8,armorD);
  px(x+2,y+7,1,8,OL); px(x+17,y+7,1,8,OL);
  px(x+1,y+6,4,3,armorL); px(x+1,y+6,4,1,'#e8ecf4'); px(x+15,y+6,4,3,armorL); px(x+15,y+6,4,1,'#e8ecf4');
  px(x+0,y+6,1,3,OL); px(x+19,y+6,1,3,OL);
  px(x+7,y+7,6,8,tab); px(x+7,y+7,6,1,tabL);
  px(x+9,y+8,2,4,'#e8c766'); px(x+8,y+9,4,1,'#e8c766');
  px(x+6,y+2,8,5,'#d8a878'); px(x+6,y+2,1,5,'#e8bc92'); px(x+13,y+2,1,5,'#b08858');
  px(x+8,y+4,1,1,'#2a1c10'); px(x+11,y+4,1,1,'#2a1c10'); px(x+8,y+6,4,1,'#b08858');
  px(x+5,y+0,10,3,armor); px(x+5,y+0,10,1,armorL); px(x+5,y+2,10,1,'#00000028');
  px(x+9,y-1,2,1,tab);
  px(x+5,y+1,1,6,OL); px(x+14,y+1,1,6,OL); px(x+6,y+0,8,1,OL);
}
function drawElijah(x,y,withBoard){
  const skin='#c08858', shirt='#e07a4a', board='#f0e8d0', OL=_NPC_OL;
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+7,y+15,4,2,0,0,7); ctx.fill();
  if(withBoard!==false){
    px(x+12,y+0,3,15,board); px(x+12,y+0,1,15,'#ffffff'); px(x+13,y+1,1,13,'#3a8a9a');
    px(x+12,y+15,3,1,'#c8b890'); px(x+11,y+2,1,12,OL); px(x+15,y+2,1,12,OL); px(x+12,y-1,3,1,OL);
    px(x+13,y+4,1,3,'#e8c766');
  }
  px(x+3,y+12,3,3,'#d8c8a0'); px(x+3,y+14,3,1,OL); px(x+7,y+12,3,3,'#d8c8a0'); px(x+7,y+14,3,1,OL);
  px(x+3,y+6,8,6,shirt); px(x+3,y+6,2,6,_shadeHex(shirt,1.25)); px(x+9,y+6,2,6,_shadeHex(shirt,0.72));
  px(x+5,y+7,1,2,'#3a7a42'); px(x+7,y+9,1,2,'#3a7a42'); px(x+8,y+7,1,1,'#3a7a42');
  px(x+2,y+6,1,6,OL); px(x+11,y+6,1,6,OL);
  px(x+4,y+2,6,5,skin); px(x+9,y+2,1,5,_shadeHex(skin,0.8));
  px(x+5,y+4,1,1,'#2a1c10'); px(x+8,y+4,1,1,'#2a1c10');
  px(x+4,y+5,6,3,'#f0ece0'); px(x+4,y+5,6,1,'#ffffff'); px(x+5,y+8,4,1,'#f0ece0');
  px(x+3,y+3,1,2,'#e8e8e8'); px(x+10,y+3,1,2,'#e8e8e8');
  px(x+3,y+2,1,5,OL); px(x+10,y+2,1,5,OL); px(x+4,y+1,6,1,OL);
}
function drawSquireMatthew(x,y){
  const o={skin:'#f0c8a0',hair:'#b8862a',top:'#5a6a8a',bottom:'#4a4a3a'}, OL=_NPC_OL;
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+8,y+15,4,2,0,0,7); ctx.fill();
  px(x+5,y+12,2,3,o.bottom); px(x+5,y+14,2,1,OL); px(x+9,y+12,2,3,o.bottom); px(x+9,y+14,2,1,OL);
  px(x+4,y+7,8,5,o.top); px(x+4,y+7,2,5,_shadeHex(o.top,1.28)); px(x+10,y+7,2,5,_shadeHex(o.top,0.72));
  px(x+6,y+7,4,6,'#8a8f9e'); px(x+6,y+12,4,1,'#6a707e');
  px(x+7,y+8,2,2,'#e8c766');
  px(x+3,y+7,1,5,OL); px(x+12,y+7,1,5,OL);
  px(x+13,y+8,1,5,'#8a5c32'); px(x+12,y+7,3,1,'#c8ccd8'); px(x+13,y+6,1,1,'#c8ccd8');
  px(x+5,y+3,6,5,o.skin); px(x+10,y+3,1,5,_shadeHex(o.skin,0.8));
  px(x+6,y+5,1,1,'#2a1c10'); px(x+9,y+5,1,1,'#2a1c10'); px(x+7,y+7,2,1,_shadeHex(o.skin,0.8));
  px(x+5,y+3,6,2,o.hair); px(x+5,y+3,2,1,_shadeHex(o.hair,1.3));
  px(x+8,y+1,2,2,o.hair); px(x+9,y+0,1,2,_shadeHex(o.hair,1.3));
  px(x+4,y+3,1,5,OL); px(x+11,y+3,1,5,OL); px(x+5,y+2,6,1,OL);
}
function drawPrincessMadison(x,y){
  const gown='#c85a7a', gownL='#e88aa4', gownD='#9a3a5a', gold='#e8c766', skin='#f0c8a0', hair='#e8c05a', OL=_NPC_OL;
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+8,y+16,5,2,0,0,7); ctx.fill();
  px(x+3,y+11,10,5,gown); px(x+2,y+14,12,2,gown);
  px(x+3,y+11,2,5,gownL); px(x+11,y+11,2,5,gownD); px(x+2,y+14,2,2,gownL); px(x+12,y+14,2,2,gownD);
  px(x+2,y+15,12,1,gownD); px(x+1,y+14,1,2,OL); px(x+14,y+14,1,2,OL);
  px(x+5,y+7,6,4,gown); px(x+5,y+7,2,4,gownL); px(x+9,y+7,2,4,gownD);
  px(x+7,y+7,2,4,gold); px(x+5,y+7,6,1,gold);
  px(x+4,y+7,1,4,OL); px(x+11,y+7,1,4,OL);
  px(x+5,y+2,6,5,skin); px(x+10,y+2,1,5,_shadeHex(skin,0.86));
  px(x+6,y+4,1,1,'#2a1c10'); px(x+9,y+4,1,1,'#2a1c10'); px(x+7,y+5,2,1,'#d88a8a');
  px(x+5,y+2,6,2,hair); px(x+5,y+2,2,1,_shadeHex(hair,1.25));
  px(x+3,y+3,2,8,hair); px(x+11,y+3,2,8,hair); px(x+3,y+10,2,1,_shadeHex(hair,0.8)); px(x+11,y+10,2,1,_shadeHex(hair,0.8));
  px(x+6,y+1,4,1,gold); px(x+7,y+0,1,1,gold); px(x+8,y+0,1,1,'#fff8d0');
  px(x+4,y+2,1,5,OL); px(x+11,y+2,1,5,OL); px(x+5,y+1,6,1,OL);
}
// ── EZRA THE SCRIBE: keeper of the sanctuary libraries (green robe, gold stole) ──
function drawLibrarian(x,y){
  const robe='#2f5a3a', stole='#c8a038', OL=_NPC_OL;
  const robeL=_shadeHex(robe,1.3), robeD=_shadeHex(robe,0.68);
  const skin='#e0c09a', beard='#e8e4da', beardD='#c8c2b4';
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+8,y+17,5,2,0,0,7); ctx.fill();
  px(x+4,y+7,8,8,robe); px(x+3,y+12,10,4,robe);                       // robe body + flared hem
  px(x+4,y+7,2,8,robeL); px(x+3,y+12,2,4,robeL);
  px(x+10,y+7,2,8,robeD); px(x+11,y+12,2,4,robeD);
  px(x+3,y+15,10,1,robeD);
  px(x+2,y+14,1,2,OL); px(x+13,y+14,1,2,OL);
  px(x+3,y+7,1,7,OL); px(x+12,y+7,1,7,OL);
  px(x+2,y+9,2,3,robe); px(x+2,y+9,1,3,robeL); px(x+12,y+9,2,3,robeD);  // wide sleeves
  px(x+5,y+7,2,8,stole); px(x+9,y+7,2,8,stole);                        // stole bands
  px(x+5,y+7,2,1,_shadeHex(stole,1.25)); px(x+9,y+7,2,1,_shadeHex(stole,1.25));
  px(x+5,y+9,2,1,'#e8c766'); px(x+9,y+9,2,1,'#e8c766');
  px(x+5,y+12,2,1,'#e8c766'); px(x+9,y+12,2,1,'#e8c766');
  px(x+6,y+10,4,3,'#7a3a2a'); px(x+6,y+10,4,1,'#9a4e38');              // the clasped tome
  px(x+7,y+10,1,3,'#e8c766');                                          // gilt spine
  px(x+5,y+2,6,5,skin); px(x+10,y+2,1,5,_shadeHex(skin,0.84));         // head
  px(x+6,y+4,1,1,'#2a1c10'); px(x+9,y+4,1,1,'#2a1c10');
  px(x+5,y+3,1,1,beardD); px(x+10,y+3,1,1,beardD);                     // bushy brows
  px(x+4,y+3,1,4,beard); px(x+11,y+3,1,4,beard);                       // side hair
  px(x+5,y+5,6,3,beard); px(x+5,y+5,6,1,'#f4f2ec');                    // the GREAT beard
  px(x+5,y+8,6,3,beard); px(x+6,y+11,4,2,beard); px(x+7,y+13,2,1,beardD);
  px(x+5,y+8,1,3,beardD); px(x+10,y+8,1,3,beardD);
  px(x+4,y+2,1,5,OL); px(x+11,y+2,1,5,OL); px(x+5,y+1,6,1,OL);
  px(x+5,y+1,6,1,skin); px(x+6,y+0,4,1,OL); px(x+6,y+1,4,1,_shadeHex(skin,1.12));  // shining crown
}
// look dispatcher: villager-palette looks get the shared body + an accent;
// the named cast get their bespoke sprites.
function drawLookNpc(x,y,n){
  const L=n.look;
  if(L==='joshua'){ drawSirJoshua(x-2,y-4); return; }
  if(L==='elijah'){ drawElijah(x,y,true); return; }
  if(L==='matthew'){ drawSquireMatthew(x,y); return; }
  if(L==='madison'){ drawPrincessMadison(x,y-1); return; }
  if(L==='knight'){ drawKeepKnight(x,y,n.her); return; }
  const OUT={ innkeep:'innkeep', patronA:'patronA', patronB:'patronB', guest:'guest',
    merchant:'merchant', mastersmith:'smith', fishmong:'fishmong', caravan:'caravanM',
    shadeTr:'shadeTr', qmaster:'qmaster', vill:n.voutfit||'peasant' };
  const outfit=OUT[L]||'peasant';
  drawVillager(x,y,{outfit:outfit, dir:n.dir||'down', moving:false, frame:0});
  if(L==='innkeep') _accTowel(x,y);
  else if(L==='patronA'||L==='patronB') _accMug(x,y);
  else if(L==='guest') _accPack(x,y);
  else if(L==='merchant'||L==='caravan') _accPouch(x,y);
  else if(L==='mastersmith') _accTongs(x,y);
  else if(L==='fishmong') _accFish(x,y);
  else if(L==='qmaster') _accLedger(x,y);
}
function drawNpc(x,y,n){
  if(n.look){ drawLookNpc(x,y,n); return; }
  if(n.librarian){ drawLibrarian(x,y); return; }
  if(n.king){ drawKingLuminar(x,y); return; }
  if(n.royalguard){ drawRoyalGuard(x,y,n.dir||'down'); return; }
  if(n.name==='Sir Aldric'){ drawAldric(x,y,{dir:n.dir||'down',moving:false,frame:0}); return; }
  if(n.priest){ drawPriest(x,y,n); return; }
  if(n.rgeneral){ drawRGeneral(x,y,n); return; }
  const fo=FAMILY_LOOK[n.name];
  if(fo){ _famInit(); const kid=(fo==='gmara'||fo==='gtobiah');
    drawVillager(x,y,{outfit:fo,dir:n.dir||'down',moving:false,frame:0, _kid:kid}); return; }

  ctx.fillStyle='rgba(0,0,0,.25)'; ctx.beginPath(); ctx.ellipse(x+TILE/2,y+TILE-1,5,2,0,0,7); ctx.fill();
  px(x+4,y+5,8,8,'#d8b070'); px(x+4,y+2,8,4,'#8a5a2a'); px(x+5,y+13,2,2,'#5a3a18'); px(x+9,y+13,2,2,'#5a3a18');
  ctx.fillStyle='#ffe9a8'; ctx.font='6px monospace'; ctx.textAlign='center'; ctx.fillText('!', x+TILE/2, y-2); ctx.textAlign='left';
}

// ── THEMED DECORATIONS ───────────────────────────────────────
// ── THE ROYALS (recreated from Zak's references, adapted to KLK): the fish motif
//    is an ORIGINAL goldfish tied to the golden-fish quest line, and the Demon
//    King bears a golden trident. Drawers are staged here UNWIRED — integration
//    (throne NPC / bounty boss) lands as its own change after the look is approved.
function drawTrumpeter(x,y,dir){
  // a royal herald sounding a golden trumpet toward the centre of the hall (14x16)
  dir = dir==='left' ? 'left' : 'right';
  const f = dir==='right' ? 1 : -1;
  const blue='#2f4a8f', blueL='#4a68b8', gold='#e8c766', goldL='#f2d074', skin='#e8b88a', cap='#7a2a2a';
  ctx.fillStyle='rgba(0,0,0,.2)'; ctx.beginPath(); ctx.ellipse(x+7,y+15,4,1.6,0,0,7); ctx.fill();
  // legs + herald tunic
  px(x+5,y+12,2,3,'#3a2f4a'); px(x+8,y+12,2,3,'#3a2f4a');
  px(x+4,y+6,6,6,blue); px(x+4,y+6,6,1,blueL); px(x+6,y+7,2,4,gold);        // tabard + gold stripe
  // head + herald cap
  px(x+5,y+2,4,4,skin); px(x+4,y+1,6,2,cap); px(x+4,y+1,6,1,'#9a3a3a');
  px(x+ (f>0?8:5), y+3,1,1,'#2a221c');                                        // eye
  // the golden trumpet, raised toward the centre
  const bx = f>0 ? x+9 : x+5;    // bell end (points toward centre)
  const mx = f>0 ? x+7 : x+7;    // mouth end (at the face)
  px(mx, y+4, 1, 1, gold);
  for(let i=0;i<4;i++) px(mx + f*(2+i), y+3-i, 2, 1, i%2?goldL:gold);          // rising tube
  px(bx + f*4, y-2, 3, 3, gold); px(bx + f*4, y-2, 3, 1, goldL);               // flared bell
  // a little pennant on the trumpet
  px(bx + f*3, y+1, 3, 2, '#c0392b');
}
function drawRoyalGuard(x,y,dir){
  // The King's own guard — polished steel with gold trim, a crimson plume, a royal
  // blue tabard bearing the golden-fish, and a tall halberd. (16x22)
  dir=dir||'down';
  const steel='#c2cad6', steelD='#828a98', steelL='#e6ecf4', gold='#e8c766', goldD='#b8912e',
        blue='#2f4a8f', blueL='#4a68b8', plume='#c0392b', plumeD='#8f2a20', skin='#e8b88a';
  const face = dir==='left' ? -1 : dir==='right' ? 1 : 0;   // slight lean of the halberd
  // ground shadow
  ctx.fillStyle='rgba(0,0,0,.22)'; ctx.beginPath(); ctx.ellipse(x+8,y+21,6,2,0,0,7); ctx.fill();
  // halberd (held at the guard's right side)
  const hx = x + (face>=0? 13 : 1);
  px(hx, y+1, 1, 19, '#6a4a2a'); px(hx, y+1, 1, 12, '#7a5a34');   // shaft
  px(hx-1, y+0, 3, 3, steelL); px(hx-1, y+1, 1, 4, steel); px(hx+1, y+2, 1, 2, steelD);  // axe head
  px(hx, y-2, 1, 3, steel);   // spear tip
  // crimson plume + steel helm
  px(x+6, y-1, 4, 2, plume); px(x+6, y-1, 2, 1, '#d9564a'); px(x+7, y+0, 2, 1, plumeD);
  px(x+4, y+1, 8, 3, steel); px(x+4, y+1, 8, 1, steelL);          // helm dome
  px(x+4, y+3, 8, 1, gold);                                        // gold brow band
  px(x+5, y+4, 6, 2, steel); px(x+6, y+4, 4, 2, '#22262e');        // visor slit
  px(x+7, y+5, 2, 1, skin);
  // pauldrons + breastplate
  px(x+3, y+6, 10, 5, steel); px(x+3, y+6, 10, 1, steelL);
  px(x+3, y+6, 2, 3, gold); px(x+11, y+6, 2, 3, gold);            // gold pauldrons
  px(x+6, y+7, 4, 3, blue); px(x+6, y+7, 4, 1, blueL);            // royal tabard panel
  px(x+7, y+8, 2, 1, gold);                                        // golden-fish emblem hint
  // tabard skirt + greaves
  px(x+5, y+11, 6, 4, blue); px(x+5, y+11, 6, 1, blueL); px(x+7, y+12, 2, 2, gold);  // hanging tabard
  px(x+4, y+11, 1, 4, steelD); px(x+11, y+11, 1, 4, steelD);      // hip plates
  px(x+5, y+15, 2, 4, steel); px(x+9, y+15, 2, 4, steel);         // greaves
  px(x+5, y+18, 2, 1, steelD); px(x+9, y+18, 2, 1, steelD);       // boots
}
function drawKingLuminar(x,y){  // 16x20 — the King of Luminar (golden-fish tunic, circlet, man-bun)
  // hair — crown of brown hair + man-bun, with a lighter highlight
  px(x+9,y+0,3,2,'#8a5a30'); px(x+9,y+0,3,1,'#a8703c');        // top bun + highlight
  px(x+9,y+2,1,1,'#c0432f');                                    // bun tie
  px(x+4,y+2,8,2,'#8a5a30'); px(x+4,y+2,8,1,'#a8703c');        // hair mass + highlight
  px(x+3,y+4,2,4,'#8a5a30');  px(x+11,y+4,2,4,'#8a5a30');       // side hair
  px(x+4,y+3,8,1,'#f2c14e');                                    // gold circlet
  px(x+7,y+3,2,1,'#c0432f');                                    // circlet gem
  px(x+5,y+4,6,4,'#e8b88a');                                    // face
  px(x+6,y+4,1,1,'#5a3a20'); px(x+9,y+4,1,1,'#5a3a20');         // brows
  px(x+6,y+5,1,1,'#2a221c'); px(x+9,y+5,1,1,'#2a221c');         // eyes
  // full brown beard — a darker tone than the hair so it reads as its own feature
  px(x+4,y+6,1,3,'#6f4522');  px(x+11,y+6,1,3,'#6f4522');       // sideburns into the beard
  px(x+6,y+6,4,1,'#6f4522');                                    // mustache
  px(x+5,y+7,6,3,'#6f4522');                                    // beard body
  px(x+6,y+8,1,1,'#8a5a30'); px(x+9,y+8,1,1,'#8a5a30');         // beard texture
  px(x+6,y+9,4,1,'#5c3a1d');                                    // beard shadow / chin
  px(x+7,y+7,2,1,'#c88a6a');                                    // mouth (over the beard)
  px(x+4,y+10,8,6,'#f0ead8');
  px(x+4,y+10,8,1,'#f2c14e');
  px(x+5,y+12,2,1,'#f2c14e');
  px(x+4,y+12,1,1,'#e8a83e');
  px(x+9,y+13,2,1,'#f2c14e');
  px(x+11,y+13,1,1,'#e8a83e');
  px(x+6,y+14,2,1,'#f2c14e');
  px(x+5,y+14,1,1,'#e8a83e');
  px(x+3,y+10,1,3,'#f0ead8');
  px(x+12,y+10,1,3,'#f0ead8');
  px(x+3,y+13,1,2,'#e8b88a');
  px(x+12,y+13,1,2,'#e8b88a');
  px(x+12,y+12,1,2,'#5b3a1f');
  px(x+4,y+16,8,1,'#5b3a1f');
  px(x+7,y+16,2,1,'#f2c14e');
  px(x+5,y+17,2,2,'#3a4a8a');
  px(x+9,y+17,2,2,'#3a4a8a');
  px(x+5,y+19,2,1,'#5b3a1f');
  px(x+9,y+19,2,1,'#5b3a1f');
}
// ════════════════════════════════════════════════════════════════
//  👑 THE THRONE HALL — the grand scene for the endgame cutscene.
//  A long royal walkway up to the King of Luminar, lined with a cheering
//  crowd, torches, banners, and the King's own halberd guards.
// ════════════════════════════════════════════════════════════════
const THALL = { W:17, H:30, cx:8 };            // hall size (tiles) + centre column
const THRONE_ENTRY = { x:8, y:27 };            // where the knight + father begin
const THRONE_TOP = { x:8, y:10 };              // where the knight halts, just below the dais
let _confetti=null, _crowdSeed=null, _band=null;
function initThroneScene(){
  _confetti=[];
  for(let i=0;i<90;i++) _confetti.push({ x:Math.random()*THALL.W*TILE, y:Math.random()*THALL.H*TILE,
    vy:8+Math.random()*14, sw:Math.random()*7, sz:1+((Math.random()*2)|0),
    c:['#e8c766','#c0392b','#4a68b8','#e6ecf4','#7ad07a','#e0885a'][(Math.random()*6)|0] });
  // fixed crowd: three rows deep of citizens lining both sides (clear of the guard lane)
  _crowdSeed=[];
  const outfits=['peasant','peasantF','farmer','fisher','fisherF','merchantD','monk','monkF','child','smith','nomad','hunter','pilgrim','sailor','woodcutter','survivor'];
  let ci=0;
  for(let ty=10; ty<=THALL.H-3; ty+=2){
    for(const cx of [3,4,5,11,12,13]){          // carpet is 7-9, guards run in 6 & 10 — no overlap
      _crowdSeed.push({ tx:cx, ty, outfit:outfits[(ci*7+cx)%outfits.length], face: cx<THALL.cx?'right':'left', ph:(ci%3) });
      ci++;
    }
  }
  // royal fanfare: heralds with trumpets flanking the throne up near the dais
  _band=[];
  for(const [tx,ty,dir] of [[4,4,'right'],[4,6,'right'],[5,8,'right'],[12,4,'left'],[12,6,'left'],[11,8,'left']])
    _band.push({tx,ty,dir});
}
function updateThroneScene(dt){
  if(!_confetti) return;
  for(const p of _confetti){ p.y += p.vy*dt/16; p.x += Math.sin((p.y+p.sw)*0.12)*0.7;
    if(p.y > THALL.H*TILE){ p.y=-4; p.x=Math.random()*THALL.W*TILE; } }
}
function drawThroneScene(camX, camY, t, quiet){
  const W=THALL.W, H=THALL.H, cx=THALL.cx;
  const sx=(tx)=>tx*TILE-camX, sy=(ty)=>ty*TILE-camY;
  const P=(a,b,w,h,c)=>px(Math.round(a),Math.round(b),w,h,c);
  // palette
  const stoneL='#c3baa8', stone='#a49a8a', stoneD='#7a7264', stoneDD='#565044';
  const gold='#e8c766', goldL='#f8e29a', goldD='#a8842e';
  const blue='#2f4a8f', blueL='#5a78c0', blueD='#1c2c58';
  const red='#8f2f2f', redL='#b04a4a', redD='#5c1c1c';

  // ── stone-tile floor with grout ──
  P(-camX,-camY,W*TILE,H*TILE,'#241f1a');
  for(let ty=0;ty<H;ty++)for(let tx=0;tx<W;tx++){
    const v=((tx*3+ty*5)%7); const base=v<2?'#c6b9a2':(v<4?'#bfb199':'#b8aa92');
    P(sx(tx),sy(ty),TILE,TILE,base);
    P(sx(tx),sy(ty),TILE,1,'#00000012'); P(sx(tx),sy(ty),1,TILE,'#00000012');
    P(sx(tx),sy(ty)+TILE-1,TILE,1,'#ffffff0a');
  }

  // ── ornate rounded PILLARS down both sides, draped with blue crown-banners ──
  function pillar(colx){
    for(let ty=0;ty<H;ty++){
      P(sx(colx),sy(ty),TILE*2,TILE,stone);
      P(sx(colx),sy(ty),3,TILE,stoneL);                 // left highlight (roundness)
      P(sx(colx)+TILE*2-4,sy(ty),4,TILE,stoneD);        // right shadow
      P(sx(colx)+TILE*2-2,sy(ty),2,TILE,stoneDD);
    }
    for(let ty=2;ty<H;ty+=4){ P(sx(colx)-1,sy(ty),TILE*2+2,3,stoneL); P(sx(colx)-1,sy(ty)+2,TILE*2+2,1,stoneDD); } // rings
    // blue banner with repeating gold crowns
    const bx=sx(colx)+TILE-3;
    for(let ty=1;ty<H;ty++){ P(bx,sy(ty),7,TILE,blue); P(bx,sy(ty),1,TILE,blueL); P(bx+6,sy(ty),1,TILE,blueD); }
    for(let ty=4;ty<H;ty+=6){ // gold crown emblem
      P(bx+1,sy(ty)+1,5,3,gold); P(bx+1,sy(ty),1,2,goldL); P(bx+3,sy(ty)-1,1,2,goldL); P(bx+5,sy(ty),1,2,goldL);
      P(bx+1,sy(ty)+4,5,1,goldD);
    }
  }
  pillar(1); pillar(W-3);

  // ── top-corner ALCOVES with a lit statue (blue niche + pale figure) ──
  function alcove(colx){
    P(sx(colx),sy(1),TILE*2,TILE*4,blueD); P(sx(colx),sy(1),TILE*2,1,blueL);
    P(sx(colx)+4,sy(1)+3,TILE*2-8,TILE*4-6,'#24356a');
    // pale statue
    const mx=sx(colx)+TILE-3;
    P(mx,sy(2),6,4,'#d9d2c4'); P(mx+1,sy(1)+3,4,3,'#eae3d6');   // head/shoulders
    P(mx,sy(3)+2,6,TILE+2,'#cfc7b8'); P(mx+2,sy(3)+2,2,TILE,'#eae3d6');
    P(sx(colx),sy(5),TILE*2,3,stoneL); P(sx(colx),sy(5)+2,TILE*2,1,stoneDD);  // niche shelf
  }
  alcove(1); alcove(W-3);

  // ── royal CARPET up the centre: gold trim + patterned runner ──
  for(let ty=5;ty<H;ty++){
    P(sx(cx-1),sy(ty),TILE*3,TILE,red); P(sx(cx-1),sy(ty),TILE*3,1,redL);
    P(sx(cx-1),sy(ty),2,TILE,gold); P(sx(cx+1)+TILE-2,sy(ty),2,TILE,gold); P(sx(cx-1)+2,sy(ty),1,TILE,goldD); P(sx(cx+1)+TILE-3,sy(ty),1,TILE,goldD);
    P(sx(cx),sy(ty)+2,TILE-4,TILE-4,redD);                                   // centre panel
    if(ty%2===0){ P(sx(cx)+TILE/2-3,sy(ty)+TILE/2-3,6,6,redL); P(sx(cx)+TILE/2-1,sy(ty)+TILE/2-1,2,2,gold); } // diamond motif
  }

  // ── the DAIS: three broadening tiers with red-carpeted steps ──
  for(let s=0;s<3;s++){ const ty=3+s; const wid=5+s*2; const half=(wid/2)|0;
    P(sx(cx-half),sy(ty),wid*TILE,TILE, s%2?'#b6a890':'#a89a82'); P(sx(cx-half),sy(ty),wid*TILE,1,'#cabfa8'); P(sx(cx-half),sy(ty)+TILE-1,wid*TILE,1,stoneDD);
    P(sx(cx-1),sy(ty),TILE*3,TILE,red); P(sx(cx-1),sy(ty),TILE*3,1,redL);     // carpet runs up the steps
    P(sx(cx-1),sy(ty),2,TILE,gold); P(sx(cx+1)+TILE-2,sy(ty),2,TILE,gold);
  }

  // ── the GRAND GOLDEN THRONE (rows 0-4) with a cross crest + red cushion ──
  const T=sx(cx);
  // central blue banner backdrop with a big gold crown (behind the throne)
  P(sx(cx-1),sy(0),TILE*3,TILE*2+6,blue); P(sx(cx-1),sy(0),TILE*3,1,blueL); P(sx(cx+1)+TILE-1,sy(0),1,TILE*2,blueD);
  P(T-2,sy(0)+3,TILE+4,5,gold); P(T-1,sy(0)+2,1,2,goldL); P(T+TILE/2-1,sy(0)+1,2,3,goldL); P(T+TILE,sy(0)+2,1,2,goldL); P(T-2,sy(0)+8,TILE+4,1,goldD); // crown
  P(T-TILE+2,sy(1)+6,TILE*3-4,TILE*3-4,goldD); P(T-TILE+2,sy(1)+6,TILE*3-4,2,gold);   // gold frame mass
  P(T-TILE+5,sy(1)+9,TILE*3-10,TILE*3-12,'#3a4e86');                                    // blue inlay back
  P(T-TILE+2,sy(1)+6,3,TILE*3-4,gold); P(T+TILE*2-5,sy(1)+6,3,TILE*3-4,gold);          // side posts
  P(T-TILE-1,sy(3)+2,4,TILE,goldD); P(T+TILE*2-3,sy(3)+2,4,TILE,goldD);                 // armrests
  P(T-TILE-1,sy(3),4,3,goldL); P(T+TILE*2-3,sy(3),4,3,goldL);                           // finials
  P(T-1,sy(2)+8,TILE+2,TILE-2,red); P(T-1,sy(2)+8,TILE+2,2,redL);                       // red cushion
  drawKingLuminar(T-4, sy(1)+10);                                                        // the King, seated
  // gold cross crowning the throne (kept within the top row so it never clips)
  P(T+TILE/2-1,sy(0)+1,3,9,goldL); P(T+TILE/2-3,sy(0)+3,7,3,goldL); P(T+TILE/2-1,sy(0)+1,3,1,'#fff0b0');

  // ── heraldic banners behind/beside the throne: blue crown centre + red shields ──
  P(sx(cx-1),sy(0),TILE*3,3,blueD);
  for(const rx of [3, W-5]){ P(sx(rx),sy(1),TILE,TILE*2,red); P(sx(rx),sy(1),TILE,1,redL);
    P(sx(rx)+4,sy(1)+3,TILE-8,5,'#e8e2d0'); P(sx(rx)+5,sy(1)+4,TILE-10,2,stone);   // shield blazon
    P(sx(rx)+3,sy(1)+TILE*2,3,3,red); P(sx(rx)+TILE-6,sy(1)+TILE*2,3,3,red); }

  // ── brazier TORCHES on gold stands lining the walkway ──
  function brazier(colx, ty){
    const bx=sx(colx)+4, by=sy(ty);
    P(bx+1,by+4,3,TILE-2,goldD); P(bx,by+TILE+1,5,2,goldD);        // stand
    P(bx-1,by+1,7,4,gold); P(bx-1,by+1,7,1,goldL);                 // bowl
    const fl=(Math.sin(t*0.03+ty)+1)*0.5;
    P(bx,by-4,5,5,'#e0662f'); P(bx+1,by-6,3,4,'#f2a83a'); P(bx+2,by-8,1,3,'#ffe08a');
    if(fl>0.5) P(bx+1,by-9,2,2,'#fff0b0');
  }
  // ── standing BANNER-POLES (blue with gold emblem) ──
  function bannerPole(colx, ty){ const bx=sx(colx)+6, by=sy(ty);
    P(bx,by,2,TILE*2,'#6a4a2a'); P(bx-4,by,10,TILE+3,blue); P(bx-4,by,10,1,blueL);
    P(bx-2,by+3,6,4,gold); P(bx-1,by+2,4,1,goldL); P(bx-4,by+TILE+3,10,2,blueD); }
  // ── the King's halberd GUARDS (lane at cols 6 & 10) ──
  // interleave furniture down the walkway so nothing stacks: guard · brazier · pole · repeat
  drawRoyalGuard(sx(cx-2), sy(8), 'right'); drawRoyalGuard(sx(cx+2), sy(8), 'left');
  if(!quiet){
    let slot=0;
    for(let ty=11; ty<=H-3; ty+=3){
      const kind = slot%3;
      if(kind===0){ drawRoyalGuard(sx(cx-2), sy(ty), 'right'); drawRoyalGuard(sx(cx+2), sy(ty), 'left'); }
      else if(kind===1){ brazier(cx-2, ty); brazier(cx+2, ty); }
      else { bannerPole(cx-2, ty); bannerPole(cx+2, ty); }
      slot++;
    }
  } else {
    // quiet hall (the standing keep): a couple of guards partway down + wall braziers, walkway kept clear
    drawRoyalGuard(sx(cx-2), sy(14), 'right'); drawRoyalGuard(sx(cx+2), sy(14), 'left');
    brazier(2, 12); brazier(W-3, 12); brazier(2, 20); brazier(W-3, 20);
  }
  brazier(cx-3,4); brazier(cx+2,4);   // flank the dais top
  if(!quiet){
    // ── trumpet HERALDS flanking the throne ──
    if(_band) for(const b of _band){ const lift=Math.sin(t*0.03+b.tx)>0?-1:0; drawTrumpeter(sx(b.tx), sy(b.ty)+lift, b.dir); }
    // ── the cheering CROWD (three deep each side) ──
    if(_crowdSeed) for(const c of _crowdSeed){ const bob=Math.sin(t*0.02+c.ph*2)>0?-1:0;
      drawVillager(sx(c.tx), sy(c.ty)+bob, {outfit:c.outfit, dir:c.face, moving:true, frame:(bob?1:3)});
      if(bob) P(sx(c.tx)+7, sy(c.ty)-4, 1,2,gold); }
    // ── confetti over everything ──
    if(_confetti) for(const p of _confetti){ P(p.x-camX, p.y-camY, p.sz, p.sz, p.c); }
  }
}
// ── the STORMGATE KEEP as a walkable throne hall (the same room as the cutscene) ──
let keepGrid=null;
function buildKeepGrid(){
  const W=THALL.W, H=THALL.H, g=[];
  for(let y=0;y<H;y++){ g[y]=[]; for(let x=0;x<W;x++){
    let t=0;                                   // floor (walkable)
    if(x<=2 || x>=W-3) t=5;                    // side pillars + wall block the edges
    if(y<=7) t=5;                              // throne, dais and back wall block
    g[y][x]=t;
  }}
  keepGrid=g;
}
function enterKeep(b){
  if(!keepGrid) buildKeepGrid();
  returnStack.push({ x:167*TILE, y:203*TILE, dir:'down' });
  place={kind:'keep'};
  player.mounted=false; player.boating=false; player.driving=false; player.moving=false;
  player.x=THALL.cx*TILE; player.y=(THALL.H-3)*TILE; player.dir='up';
  showBanner('👑 <b>The Throne Hall of Luminar</b><br><span style="font-size:7px">Walk up to the throne to speak with the King. Head back down the hall to leave.</span>', 2600);
}
function exitKeep(){
  place={kind:'overworld'}; player.x=167*TILE; player.y=203*TILE; player.dir='down'; player.moving=false;
}
// tournament champions who loiter in the hall once the Demon Hunt is done — each starts a keep's tourney
const KEEP_KNIGHTS = [
  { tx:5,  ty:13, dir:'right', keep:'ih_keep', name:'Ser Roland',  line:'Well met, knight. The Ironhold lists are open — what contest suits you today?' },
  { tx:11, ty:16, dir:'left',  keep:'hg_keep', name:'Ser Gideon',  line:'They hold the games at the Redeemed Throne now, where Abaddon once sat. Name your challenge.' },
  { tx:5,  ty:19, dir:'right', keep:'sg_keep', name:'Dame Miriam',  line:'Stormgate’s champions await. Choose how you’ll prove your blade.' },
]
const PMADISON = { tx: THALL.cx+3, ty: 8 };   // Princess Madison's place beside the dais
function keepKnightNear(){
  const ptx=Math.floor((player.x+TILE/2)/TILE), pty=Math.floor((player.y+TILE/2)/TILE);
  return KEEP_KNIGHTS.find(k=>Math.abs(k.tx-ptx)<=1 && Math.abs(k.ty-pty)<=1);
}
function kingSpeak(){
  if(bounties.madisonTaken && !bounties.madisonRescued){
    sayAs('The King of Luminar', ['You still stand here, knight? My daughter is stolen away beyond the world and the pretender laughs in some far country.','Go south. The portals wait. I will not know peace until Madison is returned to this hall.']);
    return;
  }
  if(homesteadGranted || hunt.won){
    sayAs('The King of Luminar', ['Champion of Luminar \u2014 the realm still sings your name.','May the Lord who steadied your hand keep you on the roads ahead.']);
  } else if(cleansedCount()>=10){
    sayAs('The King of Luminar', ['Abaddon festers at Hellgate, yet every chapel of the realm is cleansed by your hand.','Go, knight \u2014 end the long night, and return to me crowned in victory.']);
  } else {
    sayAs('The King of Luminar', ['You have come far, knight of Luminar.','The realm\u2019s hope rests on your blade \u2014 and on the God who guides it.']);
  }
}
// ════════════════════════════════════════════════════════════════
//  👑 THE ENDGAME CUTSCENE — the royal audience after Abaddon falls.
//  Fade in on the throne hall → auto-walk up the carpet with Sir Aldric as the
//  crowd cheers → the King's Psalm-touched blessing → fade out to Stormgate.
// ════════════════════════════════════════════════════════════════
let homesteadGranted=false;   // the King's grant of the Homestead (narrative; locked in the final game later)
const cutscene = { active:false, phase:'', t:0, fade:1, spoke:false };
const cutAldric = { x:0, y:0, dir:'up', frame:0 };
const KING_LINES = [
  {speaker:'The King of Luminar', text:'Rise, knight of Luminar. You have done what no other could \u2014 Abaddon is cast down, and the long night is broken.'},
  {speaker:'The King of Luminar', text:'As the psalm sings: <i>\u201cPraise be to the Lord my Rock, who trains my hands for war, my fingers for battle.\u201d</i> It was His strength in your arm this day.'},
  {speaker:'The King of Luminar', text:'The realm owes you a debt beyond repaying. Take this by royal grant: the old family homestead \u2014 its fields, its farmhouse \u2014 is yours, and your father\u2019s.'},
  {speaker:'The King of Luminar', text:'Yet the work is not finished. Though their king has fallen, his demons still scatter across the roads. <i>\u201cThe Lord is my light and my salvation \u2014 whom shall I fear?\u201d</i> Go now, and fear nothing.'},
  {speaker:'The King of Luminar', text:'Your father waits at the Homestead. He will tell you what must be done.'},
  {speaker:'Sir Aldric', text:'Come, my child. There is a hunt yet to ride \u2014 together, this time.'},
];
// ══ THE WEDDING — staged in Luminar's own throne hall, with the whole capital
//    lining the carpet. It reuses the knighting cutscene wholesale: the walk up
//    the aisle, the crowd, the heralds, the confetti. Madison walks the aisle
//    beside you instead of your father, and it lets out into the capital. ══
const WEDDING_LINES = [
  {speaker:'', text:'(The hall is full to the walls. The five shepherds of Mistral stand with the five rescued of Tabor — and behind them, shy in travelling clothes, a lamplighter\u2019s widow, a boy with a kite, an almoner, an old mason, and a girl who got her sister back.)'},
  {speaker:'The King of Luminar', text:'Three gates opened, and three worlds came back into the light. My daughter walked out of a city of false gold on the arm of the knight I sent for her. Rise, both of you.'},
  {speaker:'The King of Luminar', text:'\u201cLet us be glad and rejoice, and give honour to him: for the marriage of the Lamb is come, and his wife hath made herself ready.\u201d — Revelation 19:7. Bring the crowns.'},
  {speaker:'Princess Madison', text:'(quietly, taking your hand) I counted five lamps across a dark gulf, and every one of them was you deciding not to stop. Whatever else a marriage is — I think it is that, kept up for a lifetime.'},
  {speaker:'Sir Aldric', text:'(from the front row, not even pretending his eyes are dry) That is my child. That one. There.'},
  {speaker:'The King of Luminar', text:'\u201cAnd God shall wipe away all tears from their eyes; and there shall be no more death, neither sorrow, nor crying.\u201d — Revelation 21:4. The old order has had its long evening. Sit down at the table, all of you — the morning is ours.'},
];
let _weddingCine=false;
function startWeddingCutscene(){
  _weddingCine=true;
  startThroneCutscene();
}
function startThroneCutscene(){
  place={kind:'throne'}; initThroneScene();
  cutscene.active=true; cutscene.phase='fadein'; cutscene.t=0; cutscene.fade=1; cutscene.spoke=false;
  player.mounted=false; player.boating=false; player.driving=false; player.moving=false;
  player.x=THRONE_ENTRY.x*TILE; player.y=THRONE_ENTRY.y*TILE; player.dir='up'; player.frame=0; player.ftick=0;
  cutAldric.x=(THRONE_ENTRY.x-1)*TILE; cutAldric.y=THRONE_ENTRY.y*TILE+3; cutAldric.dir='up'; cutAldric.frame=0;
}
function throneTick(dt){
  cutscene.t+=dt; updateThroneScene(dt);
  if(cutscene.phase==='fadein'){
    cutscene.fade=Math.max(0, 1-cutscene.t/800);
    if(cutscene.t>=800){ cutscene.phase='walk'; cutscene.t=0; }
  } else if(cutscene.phase==='walk'){
    const targetY=THRONE_TOP.y*TILE, spd=SPEED*0.7*(dt/16);
    if(player.y>targetY){ player.y-=spd; player.dir='up';
      player.ftick++; if(player.ftick%8===0) player.frame=(player.frame+1)%4;
      cutAldric.x += (((THRONE_ENTRY.x-1)*TILE)-cutAldric.x)*0.12;   // trail just behind-left
      cutAldric.y += ((player.y+12)-cutAldric.y)*0.2; cutAldric.dir='up'; cutAldric.frame=player.frame;
    } else { player.y=targetY; player.moving=false; player.frame=0; cutscene.phase='speak'; cutscene.t=0; }
  } else if(cutscene.phase==='speak'){
    if(!cutscene.spoke){ cutscene.spoke=true; player.dir='up';
      say(_weddingCine?WEDDING_LINES:KING_LINES, ()=>{ cutscene.phase='fadeout'; cutscene.t=0; }); }
  } else if(cutscene.phase==='fadeout'){
    cutscene.fade=Math.min(1, cutscene.t/800);
    if(cutscene.t>=800) endThroneCutscene();
  }
}
function cutsceneSkip(){
  if(!cutscene.active) return;
  if(dialogue.open) closeDialogue();
  cutscene.phase='fadeout'; cutscene.t=0;
}
function endThroneCutscene(){
  cutscene.active=false; cutscene.phase='done';
  place={kind:'overworld'}; demons=[]; spawnDemons();
  player.x=167*TILE; player.y=203*TILE; player.dir='down'; player.moving=false;   // outside the keep, in the capital
  cutscene.fade=0;
  if(_weddingCine){                       // ★ the wedding: close the story out here
    _weddingCine=false;
    sunfallProgress.homecoming=true;
    const sf=portalById('sunfall'); if(sf) sf.cleared=true;
    bounties.pretenderDefeated=true;
    player.skillPoints=(player.skillPoints||0)+5;
    madison=null;
    ensureMadisonAtHome();
    codexAdd('The gate of Sunfall', 'Malachi 4:2', 'But unto you that fear my name shall the Sun of righteousness arise with healing in his wings.');
    codexAdd("Luminar's keep", 'Revelation 19:7', 'Let us be glad and rejoice, and give honour to him: for the marriage of the Lamb is come.');
    lastOverworld.x=player.x; lastOverworld.y=player.y;
    saveGame();
    credits={ t0:performance.now() };
    return;
  }
  homesteadGranted=true;
  saveGame();
  setTimeout(()=>showBanner('\ud83c\udff0 <b>You step from the keep into the capital.</b><br><span style="font-size:7px">Return to your <b>Homestead</b> and speak with your father \u2014 the Demon Hunt awaits.</span>', 5200), 400);
}
// ── the on-field VICTORY BEAT: Abaddon's death throe, then Sir Aldric's thanksgiving ──
const ALDRIC_VICTORY_LINES = [
  {speaker:'Sir Aldric', text:'My child\u2026 it is done. The Destroyer is fallen, and the long night with him.'},
  {speaker:'Sir Aldric', text:'Blessed be the Lord my Rock! <i>\u201cThis is the Lord\u2019s doing; it is marvelous in our eyes.\u201d</i>'},
  {speaker:'Sir Aldric', text:'Through your hand He has delivered us \u2014 Luminar is free. Come; the King himself would honor you.'},
];
function startAbaddonVictory(){
  abaddon.victory={ phase:'death', t:0, spoke:false, fade:0 };
  abaddon.deathMotes=[];
  for(let i=0;i<26;i++) abaddon.deathMotes.push({ x:abaddon.x+Math.random()*TILE, y:abaddon.y+Math.random()*TILE, vy:0.4+Math.random()*0.9, sway:Math.random()*6, life:1 });
  cutAldric.x=(ABADDON_W/2|0)*TILE; cutAldric.y=(ABADDON_H)*TILE+6; cutAldric.dir='up'; cutAldric.frame=0;
  player.moving=false; player.dir='up';
}
function abaddonVictoryTick(dt){
  const v=abaddon.victory; if(!v) return; v.t+=dt;
  if(v.phase==='death'){
    for(const m of abaddon.deathMotes){ m.y-=m.vy*dt/16; m.x+=Math.sin((m.y+m.sway)*0.1)*0.4; m.life=Math.max(0,1-v.t/2600); }
    if(v.t>=2600){ v.phase='father'; v.t=0; }
  } else if(v.phase==='father'){
    const targetY=(ABADDON_H-2)*TILE, targetX=(ABADDON_W/2-1)*TILE;
    if(cutAldric.y>targetY+1){ cutAldric.y-=SPEED*0.7*dt/16; cutAldric.x+=(targetX-cutAldric.x)*0.1; cutAldric.dir='up'; cutAldric.frame=(Math.floor(v.t/120)%4); }
    else { cutAldric.y=targetY; cutAldric.frame=0;
      if(!v.spoke){ v.spoke=true; player.dir='down';   // the knight turns to his father
        say(ALDRIC_VICTORY_LINES, ()=>{ v.phase='transition'; v.t=0; }); } }
  } else if(v.phase==='transition'){
    v.fade=Math.min(1, v.t/700);
    if(v.t>=700){ abaddon.victory=null; startThroneCutscene(); }
  }
}
function drawThrone(){
  const vw=VIEW_TW*TILE, vh=VIEW_TH*TILE, hallW=THALL.W*TILE, hallH=THALL.H*TILE;
  let camX=(hallW-vw)/2;                                   // centre the hall horizontally
  let camY=player.y-vh*0.6; camY=Math.max(0, Math.min(camY, hallH-vh));
  ctx.clearRect(0,0,VW,VH);
  const now=Date.now();
  drawThroneScene(camX, camY, now);
  // the knight + Sir Aldric, depth-sorted
  const kx=Math.round(player.x-camX), ky=Math.round(player.y-camY);
  const ax=Math.round(cutAldric.x-camX), ay=Math.round(cutAldric.y-camY);
  const walking=cutscene.phase==='walk';
  const drawK=()=>drawKnight(kx,ky), drawA=()=>drawAldric(ax,ay,{dir:cutAldric.dir,moving:walking,frame:cutAldric.frame});
  if(cutAldric.y<player.y){ drawA(); drawK(); } else { drawK(); drawA(); }
  // fade overlay
  if(cutscene.fade>0){ ctx.fillStyle=`rgba(0,0,0,${cutscene.fade})`; ctx.fillRect(0,0,VW,VH); }
  // skip hint (during the silent phases)
  if(cutscene.phase==='fadein'||cutscene.phase==='walk'){ ctx.fillStyle='rgba(255,255,255,.75)'; ctx.font='8px sans-serif'; ctx.textAlign='right'; ctx.fillText('\u24b7 / tap Skip \u25b6', VW-6, 13); ctx.textAlign='left'; }
}
function drawDemonKing(x,y){  // 16x20 — the Demon King (armored goldfish monarch, eyepatch, golden trident)
  px(x+1,y+0,1,2,'#f2c14e');
  px(x+3,y+0,1,2,'#f2c14e');
  px(x+2,y+0,1,2,'#f2c14e');
  px(x+1,y+2,3,1,'#e8a83e');
  px(x+2,y+3,1,14,'#b8912a');
  px(x+6,y+0,1,2,'#f2c14e');
  px(x+9,y+0,1,2,'#f2c14e');
  px(x+12,y+0,1,2,'#f2c14e');
  px(x+6,y+2,7,1,'#f2c14e');
  px(x+6,y+3,7,1,'#e8a83e');
  px(x+5,y+4,9,6,'#e8892a');
  px(x+6,y+4,7,1,'#f2a94e');
  px(x+5,y+9,9,1,'#c86a1e');
  px(x+5,y+5,4,1,'#2a2230');
  px(x+6,y+5,2,2,'#2a2230');
  px(x+10,y+5,3,2,'#f4f0e8');
  px(x+11,y+6,1,1,'#1a1a22');
  px(x+8,y+8,3,1,'#e8a0b8');
  px(x+8,y+9,3,1,'#c87898');
  px(x+13,y+6,1,3,'#c86a1e');
  px(x+6,y+10,7,2,'#e8d8a8');
  px(x+7,y+12,5,1,'#d8c088');
  px(x+3,y+9,3,3,'#3a3a44');
  px(x+3,y+9,3,1,'#f2c14e');
  px(x+13,y+9,3,3,'#3a3a44');
  px(x+13,y+9,3,1,'#f2c14e');
  px(x+1,y+12,3,3,'#a8402a');
  px(x+1,y+12,3,1,'#c8563a');
  px(x+5,y+13,9,4,'#2a2a32');
