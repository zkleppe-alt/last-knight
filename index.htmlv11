      // keep the gate spur column intact (it leaves the vale southward)
      if((x===GATEx||x===GATEx+1) && y>=Y1-1) continue;
      let n=0; for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]) if(isRoad(x+dx,y+dy)) n++;
      if(n<=1 && !hasDest(x,y)) G[y][x]=0;
