        px(tx0,ty0+1,1,2,'#3f7a46'); px(tx0+2,ty0,1,3,'#3f7a46'); px(tx0+4,ty0+1,1,2,'#3f7a46');
        px(tx0+swg,ty0,1,1,'#8fd692'); px(tx0+2+swg,ty0-1,1,1,'#8fd692'); px(tx0+4+swg,ty0,1,1,'#8fd692'); }
      if(h1<3) px(x+2+h2,y+1+h3,1,1,'#7fd083');
      if(h4===0) px(x+11-h2%4,y+12,2,1,'#9a9484');
      if(((hsh>>7)%9)===0) px(x+12-h1%6,y+3+h2%4,1,1,'#f0e6a0');
      { const swf=((Date.now()>>9)+(hsh>>5))&1;
        px(x+4,y+6,1,3,'#3a7a42'); px(x+5,y+7,1,1,'#3a7a42');
        px(x+3+swf,y+4,3,3,'#e85d8a'); px(x+4+swf,y+5,1,1,'#ffd2e0');
