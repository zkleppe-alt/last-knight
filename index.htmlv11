  for(let x=94;x<=106;x++){ if(G[35]&&(G[35][x]===0||G[35][x]===4||G[35][x]===1||G[35][x]===7)) G[35][x]=2; }

  // 10) prune orphan path stubs (degree<=1 road tiles with no destination nearby)
  const isRoad=(x,y)=>{ const t=G[y]&&G[y][x]; return t===2||t===12; };
  const hasDest=(x,y)=>{ for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){ const t=G[y+dy]&&G[y+dy][x+dx]; if([9,16,31,12,19,3].includes(t)) return true; } return false; };
  for(let pass=0; pass<8; pass++){
    for(let y=Y0;y<=Y1+4;y++) for(let x=X0;x<=X1;x++){
