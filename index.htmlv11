  return g;
}
function genForestMaze(W, H, seed){
  // A LARGE parameterized maze (default 21×41) for the Forest of Disillusionment.
  // Independent of the shared MAZE_W/MAZE_H globals so the small mazes are untouched.
  // Entrance (8) forced at TOP-center, exit stairs (2) forced near the BOTTOM, so the
  // player always traverses north→south to match the overworld mouths.
  W = W||21; H = H||41;
  if(W%2===0) W++; if(H%2===0) H++;                  // odd dims for the cell lattice
  const rnd=mulberry((seed||97)*7919 + 104729);
  const g=Array.from({length:H},()=>Array(W).fill(1));
  const CX=(W-1)/2, CY=(H-1)/2;                      // cell-lattice size
  const cx2=(c)=>c*2+1, cy2=(c)=>c*2+1;
  const seen=Array.from({length:CY},()=>Array(CX).fill(false));
  // start carving from the TOP-center cell so the trunk path tends downward
  const startC=[Math.floor(CX/2), 0];
  const stack=[startC]; seen[0][startC[0]]=true; g[cy2(0)][cx2(startC[0])]=0;
  while(stack.length){
    const [cx,cy]=stack[stack.length-1];
    const nbrs=[[1,0],[-1,0],[0,1],[0,-1]].map(([dx,dy])=>[cx+dx,cy+dy,dx,dy])
      .filter(([nx,ny])=>nx>=0&&nx<CX&&ny>=0&&ny<CY&&!seen[ny][nx]);
    if(!nbrs.length){ stack.pop(); continue; }
    const [nx,ny,dx,dy]=nbrs[Math.floor(rnd()*nbrs.length)];
    g[cy2(cy)+dy][cx2(cx)+dx]=0; g[cy2(ny)][cx2(nx)]=0;
    seen[ny][nx]=true; stack.push([nx,ny]);
  }
  // braid: open extra walls so corridors loop (fewer frustrating dead-ends in a big maze)
  for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){
    if(g[y][x]!==1) continue;
    const open=(g[y-1][x]===0&&g[y+1][x]===0&&g[y][x-1]===1&&g[y][x+1]===1)||
               (g[y][x-1]===0&&g[y][x+1]===0&&g[y-1][x]===1&&g[y+1][x]===1);
    if(open && rnd()<0.16) g[y][x]=0;
  }
  // ENTRANCE at top-center cell
  const ex=cx2(Math.floor(CX/2)), ey=cy2(0); g[ey][ex]=8;
  // carve a small CLEARING around the entrance so the player spawns in open ground
  // (not a 1-tile pocket hemmed in by trees) — open the 8 cells around it that aren't
  // the maze's outer border.
  for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){
    const nx=ex+dx, ny=ey+dy;
    if(nx<=0||ny<=0||nx>=W-1||ny>=H-1) continue;   // keep the outer border intact
    if(g[ny][nx]===1) g[ny][nx]=0;                   // clear trees into a glade
  }
  g[ey][ex]=8;                                       // restore the entrance marker
  // BFS distances from entrance
  const distm={}; const q=[[ex,ey,0]]; distm[ex+','+ey]=0;
  while(q.length){ const [x,y,dd]=q.shift();
    [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dx,dy])=>{ const nx2=x+dx, ny2=y+dy, k=nx2+','+ny2;
      if(nx2<0||ny2<0||nx2>=W||ny2>=H) return;
      if(g[ny2][nx2]===1 || distm[k]!==undefined) return; distm[k]=dd+1; q.push([nx2,ny2,dd+1]); }); }
  // EXIT stairs: the farthest reachable cell in the BOTTOM third of the maze (so you
  // genuinely cross the whole wood). Fall back to overall-farthest if none qualifies.
  let far=null, fd=-1, farBottom=null, fdB=-1;
  for(const k in distm){ const [kx,ky]=k.split(',').map(Number);
    if(distm[k]>fd){ fd=distm[k]; far=k; }
    if(ky>=Math.floor(H*0.66) && distm[k]>fdB){ fdB=distm[k]; farBottom=k; } }
  const exitK=farBottom||far; const [sx2,sy2]=exitK.split(',').map(Number); g[sy2][sx2]=2;
  // CHESTS: up to 4 dead-ends well away from the entrance (bigger maze → more loot)
  const deadEnds=[];
  for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){
    if(g[y][x]!==0) continue;
    const n=[[1,0],[-1,0],[0,1],[0,-1]].filter(([dx,dy])=>g[y+dy][x+dx]!==1).length;
    if(n===1 && (distm[x+','+y]||0)>=8) deadEnds.push([x,y]);
  }
  for(let i=0;i<Math.min(4,deadEnds.length);i++){
    const j=Math.floor(rnd()*deadEnds.length); const [x,y]=deadEnds.splice(j,1)[0];
    if(g[y][x]===0) g[y][x]=5;
    for(let k=deadEnds.length-1;k>=0;k--){ if(Math.abs(deadEnds[k][0]-x)+Math.abs(deadEnds[k][1]-y)<5) deadEnds.splice(k,1); }
  }
  // WANDERING DEMONS: more of them, spread through the maze (dist ≥ 5 from entrance)
  const spots=[];
  for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){
    if(g[y][x]===0 && (distm[x+','+y]||0)>=5) spots.push([x,y]);
  }
  const nDem=7;
  for(let i=0;i<nDem && spots.length;i++){
    const j=Math.floor(rnd()*spots.length); const [x,y]=spots.splice(j,1)[0]; g[y][x]=6;
    for(let k=spots.length-1;k>=0;k--){ if(Math.abs(spots[k][0]-x)+Math.abs(spots[k][1]-y)<5) spots.splice(k,1); }
  }
  // HIDDEN SAGE HOLLOW: a concealed mouth (tile 35) in a DEEP dead-end, far from the
  // entrance — Eldan dwells beyond it. Pick the farthest remaining dead-end so it's a
  // genuine "you stumbled on something" discovery.
  {
    const dd2=[];
    for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){
      if(g[y][x]!==0) continue;
      const n=[[1,0],[-1,0],[0,1],[0,-1]].filter(([dx,dy])=>g[y+dy][x+dx]!==1).length;
      if(n===1 && (distm[x+','+y]||0)>=10) dd2.push([x,y,distm[x+','+y]||0]);
    }
    dd2.sort((a,b)=>b[2]-a[2]);
    if(dd2.length){ const [hx,hy]=dd2[0]; g[hy][hx]=35; }
  }
  return g;
}
function genMonkCave(){
  const rnd=mulberry(424242);
  // _legacy: Array.from({length:MAZE_H},()=>Array(MAZE_W)…) with const CX=7, CY=5;
  const g=Array.from({length:CAVE_H},()=>Array(CAVE_W).fill(1));
  const CX=CAVE_CX, CY=CAVE_CY; const cx2=(c)=>c*2+1, cy2=(c)=>c*2+1;
  const seen=Array.from({length:CY},()=>Array(CX).fill(false));
  const stack=[[Math.floor(rnd()*CX), CY-1]]; seen[CY-1][stack[0][0]]=true;
  g[cy2(CY-1)][cx2(stack[0][0])]=0;
  while(stack.length){
    const [cx,cy]=stack[stack.length-1];
    const nbrs=[[1,0],[-1,0],[0,1],[0,-1]].map(([dx,dy])=>[cx+dx,cy+dy,dx,dy])
      .filter(([nx,ny])=>nx>=0&&nx<CX&&ny>=0&&ny<CY&&!seen[ny][nx]);
    if(!nbrs.length){ stack.pop(); continue; }
    const [nx,ny,dx,dy]=nbrs[Math.floor(rnd()*nbrs.length)];
    g[cy2(cy)+dy][cx2(cx)+dx]=0; g[cy2(ny)][cx2(nx)]=0;
    seen[ny][nx]=true; stack.push([nx,ny]);
  }
  // braid a little so it isn't all dead-ends
  for(let y=1;y<CAVE_H-1;y++)for(let x=1;x<CAVE_W-1;x++){
    if(g[y][x]!==1) continue;
    const open=(g[y-1][x]===0&&g[y+1][x]===0)||(g[y][x-1]===0&&g[y][x+1]===0);
    if(open && rnd()<0.18) g[y][x]=0;
  }
  // entrance at bottom-center; the monk's hearth at the FARTHEST cell (BFS)
  const ex=cx2(Math.floor(CX/2)), ey=cy2(CY-1); g[ey][ex]=8;
  const distm={}; const q=[[ex,ey]]; distm[ex+','+ey]=0;
  while(q.length){ const [x,y]=q.shift();
    [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dx,dy])=>{ const nx=x+dx, ny=y+dy, k=nx+','+ny;
      if(nx<0||ny<0||nx>=CAVE_W||ny>=CAVE_H) return;
      if(g[ny][nx]===1 || distm[k]!==undefined) return; distm[k]=distm[x+','+y]+1; q.push([nx,ny]); }); }
  let far=null, fd=-1; for(const k in distm){ if(distm[k]>fd){ fd=distm[k]; far=k; } }
  const [mx,my]=far.split(',').map(Number);
  // open a hearth-chamber around the far cell, and ensure a clear 2-wide mouth back
  // toward the maze so the approach can never be a single blockable chokepoint.
  for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){ const x=mx+dx,y=my+dy; if(x>0&&x<CAVE_W-1&&y>0&&y<CAVE_H-1) g[y][x]=0; }
  // carve two steps of corridor outward toward maze-centre from the chamber edge
  { const tox=Math.sign((CAVE_W>>1)-mx)||1, toy=Math.sign((CAVE_H>>1)-my)||0;
    for(let s=2;s<=3;s++){ const x=mx+tox*s, y=my+toy*s;
      if(x>0&&x<CAVE_W-1&&y>0&&y<CAVE_H-1) g[y][x]=0;
      // also open one tile beside it for a 2-wide mouth
      const sx=mx+tox*s+(toy?1:0), sy=my+toy*s+(tox?1:0);
      if(sx>0&&sx<CAVE_W-1&&sy>0&&sy<CAVE_H-1) g[sy][sx]=0;
    } }
  g[my][mx]=9;                                  // the monk (talk tile)
  // his open neighbours: KEEP at least one as a clear approach, then dress the rest
  // with bed + fire so the monk is always reachable to talk to.
  const openN=[[-1,0],[1,0],[0,-1],[0,1]].filter(([dx,dy])=>g[my+dy] && g[my+dy][mx+dx]===0);
  const dress=openN.slice(1);                   // openN[0] stays a walkable approach
  if(dress[0]){ const [dx,dy]=dress[0]; g[my+dy][mx+dx]=26; }   // bed
  if(dress[1]){ const [dx,dy]=dress[1]; g[my+dy][mx+dx]=17; }   // fire
  // a couple of wandering demons between the door and the hearth
  const spots=[]; for(let y=1;y<CAVE_H-1;y++)for(let x=1;x<CAVE_W-1;x++){ if(g[y][x]===0 && (distm[x+','+y]||0)>=3 && (Math.abs(x-mx)+Math.abs(y-my))>=6) spots.push([x,y]); }
  for(let i=0;i<2 && spots.length;i++){ const j=Math.floor(rnd()*spots.length); const [x,y]=spots.splice(j,1)[0]; g[y][x]=6;
    for(let k=spots.length-1;k>=0;k--){ if(Math.abs(spots[k][0]-x)+Math.abs(spots[k][1]-y)<4) spots.splice(k,1); } }
  return g;
}
function genGladeFloor(){
  // ELDAN'S GLADE: a hushed ruin at the heart of the wood. No demons — just the
  // sage at the old altar, a gift-chest, and shafts of light through the canopy.
  const g=Array.from({length:MAZE_H},(_,y)=>Array.from({length:MAZE_W},(_,x)=>(x===0||y===0||x===MAZE_W-1||y===MAZE_H-1)?1:0));
  g[3][4]=1; g[3][10]=1; g[6][4]=1; g[6][10]=1;     // mossy standing stones
  g[2][7]=9;                                          // Eldan the Sage at his altar
  g[2][12]=5;                                         // his welcome-gift chest
  g[9][7]=8;                                          // the way back down
  return g;
}
// The library floor. Deliberately hand-laid rather than generated: it is the one
// floor the player is meant to slow down in, and a room you can read at a glance
// does that better than anything a seed would produce.
// ── HOW EACH GENERAL FELL ────────────────────────────────────────────────────
// Every chapel tests one discipline of systematic theology, in order — Aiden
// asks after Scripture, Michael after last things. So each general fell by
// failing the very doctrine he now sets before you. The lesson is not decoration
// on the fight; it is the reason there was a fight.
const GENERAL_FALLS = [
  "General Aiden held the wall at Hearthvale for nine years and never once opened the book he swore by. He had it all by heart, he said, and the heart is a warm place to keep a thing. When the Shadow Imp came it asked him only what it had asked in the garden — yea, hath God said? — and he reached for the page and found he had only ever had the memory of it.",
  "General Miriam of Ironhold forged her own armour and would take no gift she had not earned. She prayed as a soldier reports: stating her position, requesting nothing. The Iron Wraith did not break her guard. It simply stood, and let her swing, and waited for the end of a strength that had never come from anywhere but herself.",
  "General Caleb kept the ledgers of Saltmere and came, by degrees, to read his people as tonnage. Souls became hands, hands became numbers, numbers became acceptable losses. The Tide Specter took the ones he had stopped counting first, and he did not know they were gone until the column would not balance.",
  "General Deborah burned the rot out of Thornwood twice and both times looked outward for the root. She was certain the corruption came in over the wall, because she had examined the wall and not herself. The Root Fiend had been under her own floor since the first spring, and it grew, as such things do, in the dark she never brought a lamp to.",
  "General Josiah of Dusthaven preached a Christ he found easier to carry: a fine teacher, a brave man, a lamp for the road — and nothing that a man might need saving by. His people loved the sermons. When the Ember Hollow came through the grain it burned everything that could not save them, and there was a great deal of it.",
  "General Lydia of Crystalpeak was pardoned and could not believe it, so she set out to deserve it. Every night she rose to pay down a debt that had been torn up years before. The Frost Revenant never struck her once. It only let her work, out in the cold, until she had earned everything and could no longer feel her hands.",
  "General Gideon of Ashfield mistook the heat of his own zeal for the fire that fell at Pentecost. He was loud, and tireless, and certain, and he called all of it the Spirit because it felt like power. The Char Demon gave him every bit of the fire he had been asking for, and Ashfield burned for eleven days.",
  "General Ruth of Stormgate kept the finest walls in the realm and lost the flock inside them. She counted stones and not sheep; she mended gates while the word went unpreached and the table went unset. When the Thunder Lord struck, it struck a building, and a building was all that was there to fall.",
  "General Samuel of Shadowmere studied the enemy longer than any man living, and study became familiarity, and familiarity became a kind of respect. He could name every rank of them and admired the discipline of several. The Dark Paladin came to him wearing the shape he had learned to admire, and he lowered his sword to look closer.",
  "General Michael of Hellgate fought as though the last day hung on the strength of his arm, and so he had no rest in him and no joy either. Hope, for him, was a thing he was holding up. The Void Champion offered to take the weight, and showed him an ending with nothing on the other side of it, and for one moment he was grateful.",
];
// What each of the boss's moves actually is, and what to do about it. Written
// against the MOVE KINDS, then read off BOSS_PATTERNS — so retuning a guardian
// updates its own book and the shelf can never quietly go out of date.
const MOVE_TIPS = {
  volley: "looses a volley of bolts straight down its facing — step out of the line, do not back away along it",
  charge: "lowers itself and charges — it cannot turn once committed, so break sideways at the last moment",
  slam:   "raises up and slams the ground, throwing a ring outward — put distance between you before it lands, or be moving through the gap",
  spread: "throws a ring of bolts in every direction at once — there is no outrunning it, so close the distance and be inside the ring when it opens",
  summon: "calls lesser things up out of the floor — kill them quickly or they will pin you when the next telegraph comes",
};
function bookText(townId, i){
  const td=TOWN_DATA[townId];
  if(i===0){
    const pat=BOSS_PATTERNS[townId]||{moves:[]};
    const seen=[]; const lines=[
      `<b>Of the guardian of this place</b><br>They set down here what was learned of <b>${td.boss}</b>, at the cost you would expect.`
    ];
    for(const m of pat.moves){
      if(seen.includes(m.kind)) continue;
      seen.push(m.kind);
      const tell = m.telegraph>=40 ? 'It tells you plainly, and you have a moment'
                 : m.telegraph>=34 ? 'The tell is short' : 'The tell is very short — watch for it';
      lines.push(`<b>The ${m.kind}</b><br>It ${MOVE_TIPS[m.kind]||'strikes'}. ${tell}.`);
    }
    lines.push('<b>In all of it</b><br>Read the tell, not the blow. Ⓑ to dodge; strike after it has committed, never before.');
    return { title:'Of the guardian of this place', lines };
  }
  if(i===1){
    const t=THEOLOGY_TESTS[townId];
    return { title:`The doctrine ${td.general} kept`, lines:[
      `<b>${td.general} will ask you what you know.</b><br>He will not ask it kindly, and he will not ask it twice. Read, then.`,
      t.ex,
      '<b>Learn it, do not memorise it.</b><br>He can tell the difference. He died for the difference.'
    ] };
  }
  return { title:`How ${td.general} fell`, lines:[
    `<b>How ${td.general} fell</b>`,
    GENERAL_FALLS[townId],
    `<b>And so the chapel is unclean</b><br>and <b>${td.boss}</b> keeps the sanctum, and ${td.general} waits bound above it for a knight who will answer better than he did.`
  ] };
}
// which shelf is which — the room is hand-laid, so the answer is its geometry
function libraryBookAt(x,y){ return (y===7) ? 2 : (x<(LIB_W>>1) ? 0 : 1); }
function readFalseWall(){
  const d=FALSE_DOCTRINES[dungeon.townId];
  const held=player.verse;
  const lines=[
    '<b style="color:#c85a4a">Cut deep into the rock, and filled with something dark</b>',
    `<i>"${d.claim}"</i>`,
    held ? `You are carrying <b>${held.ref}</b>. Press \u24b6 here again to set it against the lie.`
         : 'A shelf is cut beneath it, the size of a stone. Somewhere in this maze there is a word that answers this.'
  ];
  say(lines);
}
function takeVerse(tx,ty){
  const d=FALSE_DOCTRINES[dungeon.townId];
  // which stone is this? the floor's stones are dealt in the doctrine's own order
  dungeon._verseAt=dungeon._verseAt||{};
  const key=dungeon.floorIdx+':'+tx+','+ty;
  if(dungeon._verseAt[key]===undefined){
    const used=Object.values(dungeon._verseAt);
    const free=d.verses.map((v,i)=>i).filter(i=>!used.includes(i));
    dungeon._verseAt[key]=free.length?free[0]:0;
  }
  const v=d.verses[dungeon._verseAt[key]];
  // you can carry only one: setting down what you held puts it back where it lay
  if(player.verse && player.verseFrom){
    const [ox,oy]=player.verseFrom;
    if(dungeon.grid[oy]) dungeon.grid[oy][ox]=T_VERSE;
  }
  player.verse=v; player.verseFrom=[tx,ty];
  dungeon.grid[ty][tx]=0;
  sfxCoin();
  say([`<b>A verse-stone, worn smooth by handling</b>`, `<b>${v.ref}</b><br>${v.text}`,
       'You take it up. There is a shelf cut beneath the lie, the size of this stone.']);
  return true;
}
function setVerse(){
  if(!player.verse){ readFalseWall(); return true; }
  const v=player.verse;
  if(!v.right){
    say(['<b>You set the stone in the shelf.</b>',
         `<b>${v.ref}</b> is true, and it is good, and it does not answer this.`,
         'The lie stands. You take the stone up again and go looking for the word that fits.']);
    return true;
  }
  dungeon.doctrineDone=dungeon.doctrineDone||{};
  dungeon.doctrineDone[dungeon.floorIdx]=true;
  player.verse=null; player.verseFrom=null;
  say([`<b>You set ${v.ref} against the lie.</b>`, v.text,
       'The dark in the letters dries and flakes, and the rock beneath is only rock.'], ()=>{ openSeal(); });
  return true;
}
function readBook(i){
  const b=bookText(dungeon.townId, i);
  say(b.lines);
}
// The chair by the fire. Rest restores you, saves, and marks this floor — so a
// death below sends you back to the fire rather than out of the building.
function restInChair(){
  if(player.libSit){ player.libSit=null; showBanner('🪑 You rise from the chair.', 1200); return true; }
  player.libSit=true;
  player.hp=player.maxHp;
  dungeon.checkpoint={ townId:dungeon.townId, floorIdx:dungeon.floorIdx };
  saveGame();
  showBanner('🔥 <b>You sink into the chair by the fire.</b><br><span style="font-size:7px">Your strength returns, and you fix this place in mind. Should you fall below, you will wake here. (Ⓐ to rise)</span>', 2800);
  return true;
}
function genLibraryFloor(townId){
  const g=Array.from({length:LIB_H},(_,y)=>Array.from({length:LIB_W},(_,x)=>
    (x===0||y===0||x===LIB_W-1||y===LIB_H-1)?1:0));
  const mid=LIB_W>>1;
  g[LIB_H-1][mid]=8;                       // the way in, at the foot
  g[0][mid]=2;                             // the way on, at the head — never sealed
  g[5][7]=T_HEARTH;                        // the fire at the centre of the room
  g[5][8]=T_CHAIR;                         // and the chair beside it
  g[3][3]=T_LECTERN;                       // tips: what the guardian does
  g[3][11]=T_LECTERN;                      // the doctrine the general will test
  g[7][7]=T_LECTERN;                       // how that general fell
  g[2][2]=1; g[2][12]=1; g[8][2]=1; g[8][12]=1;   // shelves in the corners
  g[4][1]=1; g[6][1]=1; g[4][13]=1; g[6][13]=1;   // and along the walls
  return g;
}
function genArenaFloor(){
  // the SANCTUM: an open 15×11 arena — pillars in the quarters, the bound general at
  // the top, the boss in the middle, the way in at the bottom.
  // _legacy: Array.from({length:MAZE_H} … MAZE_W …) — the arena tracked the maze size.
  const g=Array.from({length:ARENA_H},(_,y)=>Array.from({length:ARENA_W},(_,x)=>(x===0||y===0||x===ARENA_W-1||y===ARENA_H-1)?1:0));
  g[3][3]=1; g[3][11]=1; g[7][3]=1; g[7][11]=1;     // four pillars
  g[1][7]=7;                                          // the trapped general
  g[5][7]=6;                                          // the boss
  // _legacy: g[9][7]=8;  — an entrance tile, and therefore a working walk-out.
  //   The sanctum emitted no stair, so you couldn't climb past the boss, but you
  //   could still stroll back out of the building from his floor. You clear the
  //   sanctum by beating him. Arrival is ARENA_ENTRY, declared, not scanned for.
  g[2][2]=5;                                          // one reward chest
  return g;
}
// Each tier introduces exactly ONE new beat, so nothing arrives before the
// player has been taught it — which matters when death costs the whole
// expedition. _legacy: return townId>=5 ? [0,1,1,2] : [0,1,2];
function getChapelFloors(townId){
  if(townId<=2) return [FLOOR.maze, FLOOR.library, FLOOR.sanctum];                              // early
  if(townId<=6) return [FLOOR.maze, FLOOR.library, FLOOR.doctrine, FLOOR.sanctum];              // mid
  return [FLOOR.maze, FLOOR.maze2, FLOOR.library, FLOOR.doctrine, FLOOR.sanctum];               // late
}
// ── BOSS ATTACK PATTERNS (telegraph → strike, ported & expanded from legacy) ──
// move kinds: volley (aimed shots), spread (ring of shots), charge (dash), slam (shockwave ring), summon (adds)
const BOSS_PATTERNS = [
  { color:'#a78bfa', moves:[ {kind:'volley',count:1,telegraph:40,speed:3.0},{kind:'charge',telegraph:46,speed:6.5},{kind:'volley',count:2,telegraph:38,speed:3.2} ] }, // Shadow Imp
  { color:'#60a5fa', moves:[ {kind:'charge',telegraph:42,speed:7},{kind:'slam',telegraph:44,ringSpeed:4.2,ringMax:120},{kind:'volley',count:2,telegraph:36,speed:3.3} ] }, // Iron Wraith
  { color:'#22d3ee', moves:[ {kind:'spread',count:8,telegraph:42,speed:3.0},{kind:'volley',count:3,telegraph:34,speed:3.4},{kind:'charge',telegraph:40,speed:7} ] }, // Tide Specter
  { color:'#84cc16', moves:[ {kind:'summon',telegraph:40},{kind:'spread',count:8,telegraph:38,speed:3.2},{kind:'charge',telegraph:38,speed:7.5} ] }, // Root Fiend
  { color:'#fb923c', moves:[ {kind:'volley',count:3,telegraph:32,speed:3.6},{kind:'slam',telegraph:40,ringSpeed:4.6,ringMax:130},{kind:'charge',telegraph:36,speed:8} ] }, // Ember Hollow
  { color:'#67e8f9', moves:[ {kind:'spread',count:10,telegraph:36,speed:3.3},{kind:'volley',count:3,telegraph:30,speed:3.8},{kind:'slam',telegraph:38,ringSpeed:5,ringMax:140} ] }, // Frost Revenant
  { color:'#f87171', moves:[ {kind:'charge',telegraph:32,speed:8.5},{kind:'summon',telegraph:36},{kind:'spread',count:12,telegraph:34,speed:3.5},{kind:'volley',count:4,telegraph:28,speed:4} ] }, // Char Demon
  { color:'#fbbf24', moves:[ {kind:'slam',telegraph:34,ringSpeed:5.4,ringMax:150},{kind:'volley',count:4,telegraph:28,speed:4.2},{kind:'charge',telegraph:30,speed:9},{kind:'spread',count:12,telegraph:32,speed:3.6} ] }, // Thunder Lord
  { color:'#a78bfa', moves:[ {kind:'summon',telegraph:32},{kind:'charge',telegraph:28,speed:9},{kind:'spread',count:14,telegraph:30,speed:3.8},{kind:'volley',count:5,telegraph:26,speed:4.4} ] }, // Dark Paladin
  { color:'#f472b6', moves:[ {kind:'spread',count:14,telegraph:28,speed:4},{kind:'charge',telegraph:26,speed:9.5},{kind:'slam',telegraph:32,ringSpeed:5.6,ringMax:160},{kind:'volley',count:5,telegraph:24,speed:4.6},{kind:'summon',telegraph:30} ] }, // Void Champion
];
function bossPattern(townId){ return BOSS_PATTERNS[townId] || BOSS_PATTERNS[0]; }
// ── BOSS CHALLENGE RULES ──
// _legacy: the cap used to be 18% of max HP with a 420ms gate. That was the bug
// behind "every boss dies while standing still": a PERCENTAGE cap makes a boss's
// health pool irrelevant — 100/18 meant EVERY boss died in exactly 6 landed hits,
// lv3 imp and lv35 archfiend alike, in ~4s. The boss never got to fight back.
// Now: the cap is a burst safety for over-levelled knights (BOSS_CAP), boss HP is
// what actually sets the fight length, and the gate is looser so combat still
// feels responsive. A level-appropriate knight lands ~25 blows to win.
const BOSS_CAP=0.08, BOSS_GATE=300;
// the finale (Abaddon / the Pretender) lives outside demons[], so it needs the same
// rules applied explicitly. Both the normal swing AND the combo special route through
// here — the special used to bypass every rule and gut the fight in ~6 blows.
function abaddonHitGate(dmg){
  const now=performance.now();
  if(abaddon.lastHitAt && now-abaddon.lastHitAt<BOSS_GATE) return -1;   // gate between landed blows
  abaddon.lastHitAt=now;
  dmg=Math.min(dmg, Math.ceil(abaddon.maxHp*BOSS_CAP));                // burst safety
  if(abaddon.state==='telegraph') dmg*=0.3;                            // braced mid-wind-up
  return Math.max(1,Math.round(dmg));
}
function bossHitGate(d, dmg){
  if(!d.boss) return dmg;
  const now=performance.now();
  if(d.guardUntil && now<d.guardUntil) return -1;            // still awakening — blade glances off
  const braced = d.state==='telegraph';                       // BRACED: it plants itself to strike —
                                                             // hack at it mid-wind-up and most of the
                                                             // blow turns aside. Hit it in the openings.
  
  if(d.lastHitAt && now-d.lastHitAt<BOSS_GATE) return -1;    // gate between landed hits
  d.lastHitAt=now;
  if(!d.enraged && d.hp-dmg < d.maxHp*0.35){ d.enraged=true; d.timer=Math.min(d.timer||99,5); }
  return Math.min(dmg, Math.ceil(d.maxHp*BOSS_CAP)) * (braced?0.3:1);
}

// ── ABADDON — the final three-phase battle (Deceiver → Destroyer → Desperate) ──
const ABADDON = {
  name:'Abaddon, the Destroyer', maxHp:3600, color:'#b026ff',   // _legacy 600 — ~6 blows at endgame
  phases:[
    { name:'The Deceiver',  hpFrom:1.00, color:'#b026ff', taunt:'"I am the morning star. Did your God not also fall?"',
      moves:[ {kind:'volley',count:3,telegraph:38,speed:3.2},{kind:'spread',count:10,telegraph:38,speed:3.0},{kind:'volley',count:4,telegraph:34,speed:3.4} ] },
    { name:'The Destroyer', hpFrom:0.66, color:'#ff2a6a', taunt:'"Every kingdom I have laid waste. Yours is no different."',
      moves:[ {kind:'charge',telegraph:32,speed:8.5},{kind:'shield',telegraph:30},{kind:'slam',telegraph:34,ringSpeed:5,ringMax:150},{kind:'spread',count:12,telegraph:32,speed:3.4} ] },
    { name:'The Desperate', hpFrom:0.33, color:'#ff6a1a', taunt:'"NO! I will not be cast down by a child of dust!"',
      moves:[ {kind:'spread',count:14,telegraph:26,speed:3.8},{kind:'charge',telegraph:24,speed:9.5},{kind:'volley',count:5,telegraph:22,speed:4.4},{kind:'shield',telegraph:26},{kind:'slam',telegraph:28,ringSpeed:5.6,ringMax:170} ] },
  ],
};
// Abaddon arena is its own place.kind==='abaddon' — a single large room
const ABADDON_W=15, ABADDON_H=11;
// ── THE PRETENDER KING — the usurper who takes Abaddon's empty throne. Reuses the
//    Abaddon arena + fight loop with tougher tuning, his own taunts, and the Demon
//    King sprite. Defeating him doesn't kill him — he FLEES, opening the portals. ──
const PRETENDER = {
  name:'The Pretender King', maxHp:3000, color:'#e0885a',       // _legacy 820 — he must outlast Abaddon
  phases:[
    { name:'The Usurper',  hpFrom:1.00, color:'#e0885a', taunt:'"Abaddon\'s throne sat empty. A crown abhors an empty head."',
      moves:[ {kind:'volley',count:4,telegraph:34,speed:3.6},{kind:'spread',count:12,telegraph:34,speed:3.3},{kind:'charge',telegraph:30,speed:9},{kind:'volley',count:5,telegraph:30,speed:3.8} ] },
    { name:'The Tyrant',   hpFrom:0.66, color:'#d0503a', taunt:'"I am no fallen angel, knight. I am a fisher of men — and you are hooked."',
      moves:[ {kind:'charge',telegraph:28,speed:10},{kind:'shield',telegraph:28},{kind:'slam',telegraph:30,ringSpeed:5.6,ringMax:165},{kind:'spread',count:14,telegraph:28,speed:3.8},{kind:'volley',count:5,telegraph:26,speed:4.2} ] },
    { name:'The Cornered',  hpFrom:0.33, color:'#ff6a1a', taunt:'"Then I will not hold this throne — I will flee to a world where you cannot follow!"',
      moves:[ {kind:'spread',count:16,telegraph:24,speed:4.2},{kind:'charge',telegraph:22,speed:11},{kind:'volley',count:6,telegraph:20,speed:4.8},{kind:'shield',telegraph:24},{kind:'slam',telegraph:26,ringSpeed:6,ringMax:185} ] },
  ],
};
function bossCfg(){ return abaddon.who==='pretender' ? PRETENDER : ABADDON; }
let DW=15, DH=11;     // current dungeon floor size (set per floor on load)
const chapelProgress = {};   // townId -> true once the general is freed
// ── FOG OF WAR: the world map only shows where you have walked. Exploration is
// tracked in 10×10-tile chunks; defeating Abaddon reveals the whole of Luminar.
// ── TOWN GATING: Abaddon's dark barriers. Every town beyond your next objective
// is sealed inside a dome of demonic power; cleansing a town shatters the next
// dome. Towns fall in TOWN_DATA order (the ten Heads of Systematic Theology).
const BARRIER_GEO = [            // townIdx → dome ellipse (cx,cy,rx,ry); town 0 is always open
  null,
  [35,63,27,17],   // 1 Ironhold
  [28,207,24,14],  // 2 Saltmere
  [91,157,21,16],  // 3 Thornwood
  [92,69,23,18],   // 4 Dusthaven
  [153,68,28,23],  // 5 Crystalpeak
  [158,150,26,19], // 6 Ashfield
  [168,213,24,18], // 7 Stormgate
  [217,147,21,16], // 8 Shadowmere
  [225,19,21,16],  // 9 Hellgate
];
const BARRIERS = BARRIER_GEO.map(g=>{
  if(!g) return null;
  const [cx,cy,rx,ry]=g, set=new Set();
  for(let y=Math.max(0,cy-ry);y<=Math.min(WORLD_H-1,cy+ry);y++)
    for(let x=Math.max(0,cx-rx);x<=Math.min(WORLD_W-1,cx+rx);x++){
      const n=((x-cx)/rx)**2 + ((y-cy)/ry)**2;
      if(n<=1 && n>=0.80) set.add(x+','+y);      // a 2-3 tile thick ring of dark power
    }
  return { set, cx, cy };
});
let _barrierNoticeT=0;
function barrierNotice(tx,ty){
  if(place.kind!=='overworld') return;
  const bi=barrierAt(tx,ty); if(bi===-1) return;
  const now=performance.now(); if(now-_barrierNoticeT<2600) return; _barrierNoticeT=now;
  showBanner(`⛔ <b style="color:#c06aff">Abaddon's barrier</b> seals ${TOWN_DATA[bi].name}.<br><span style="font-size:7px">Cleanse <b>${TOWN_DATA[bi-1].name}</b> to shatter this dome — the chain of doctrine must be restored in order.</span>`, 2400);
}
function barrierAt(x,y){
  for(let i=1;i<BARRIERS.length;i++){
    if(chapelProgress[i-1]) continue;            // the chain has reached past this dome
    if(BARRIERS[i].set.has(x+','+y)) return i;
  }
  return -1;
}
const CHUNK=10;
let explored = new Set();            // 'cx,cy' chunk keys the knight has seen
function revealAround(){
  const pcx=Math.floor(player.x/TILE/CHUNK), pcy=Math.floor(player.y/TILE/CHUNK);
  const CW=Math.ceil(WORLD_W/CHUNK), CH=Math.ceil(WORLD_H/CHUNK);
  for(let dy=-2;dy<=2;dy++)for(let dx=-2;dx<=2;dx++){
    if(dx*dx+dy*dy>5) continue;                       // rounded reveal patch (~25 tiles wide)
    const cx=pcx+dx, cy=pcy+dy;
    if(cx>=0&&cy>=0&&cx<CW&&cy<CH) explored.add(cx+','+cy);
  }
}
const player = { x:32*TILE, y:24*TILE, dir:'down', moving:false, frame:0, ftick:0,
  hp:100, maxHp:100, level:1, xp:0, xpNext:20, atk:12, def:0, crit:0.06, weaponType:'light',
  baseMaxHp:100, baseAtk:12, baseDef:0, baseCrit:0.06,   // base values before level/skill/gear
  skillPoints:0, skills:{}, healMult:1, goldMult:1, dmgReduce:0,
  equip:{ weapon:'rusty', armor:'none_a' }, ownedGear:{ rusty:true, none_w:true, none_a:true },
  name:'Knight', pet:null, mounted:false, petX:0, petY:0,
  swing:0, swingDir:'down', swingType:'light', swingHit:false, dodgeCd:0, dashing:0, dashx:0, dashy:0, iframes:0,
  combo:0, comboT:0, specialFx:0, specialColor:'#fff' };

// ── KNIGHT SKILL TREE (ported from legacy spec) ──
// 3 branches × 4 tiers. Each node: id, branch, tier, name, cost, desc, bonus{}.
// Buying requires the previous tier in the same branch (tier 0 has no prereq).
const SKILL_TREE = {
  valor: { name:'Valor', icon:'⚔', color:'#e0556a', nodes:[
